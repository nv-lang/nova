# База стража долга охоты (план 278 Ф.5, страж check-hunter-debt.sh).
# budget_<трек> = сколько added-строк поверхности трека можно накопить с
# последней охоты, прежде чем гейт покраснеет. ЧИСЛО ВЛАДЕЛЬЦА: правится только
# его словом, с хроникой здесь. anchor = часы трека, у которого ещё нет ни
# одного отчёта охоты (когда отчёт появится, часы выводятся из git и якорь
# для этого трека перестаёт использоваться).
#
# ЗАСЕВ 2026-08-30 (интегратор, ОЖИДАЕТ слова владельца — вопрос в плане 278):
# budget_novac=1500 — novac растёт ~1200 строк/день, порог заставляет охоту
# примерно раз в день-полтора активной работы; budget_oracle=3000 — оракул
# заморожен до тега (только блокеры), долг копится медленно, и это правильно:
# нет нового кода — нет принуждения. Якорь = HEAD дня заведения механизма.
budget_novac=1500
budget_oracle=3000
# ЗАСЕВ 2026-09-04 (окно 274, ОЖИДАЕТ слова владельца — вопрос 3 плана 278, Ф.8):
# budget_guards=3000 — стражи растут ~1180 added-строк/день (git log --numstat
# по scripts/guards за 14 дней: 16 504), порог даёт охоту раз в два-три дня.
# Трек заведён по слову владельца «добавь в охотника искать ошибки в твоих
# стражах». Поверхность — scripts/guards/* без *.baseline/*.list, самотесты
# ВКЛЮЧЕНЫ (лгут так же, как стражи — замер того же дня). Якорь общий: до первого
# отчёта трек стоит в долгу (4503 на момент заведения) — намеренно.
budget_guards=3000
