# База храповика check-expect-cc-error-ratchet.sh — реестр 221.1 №966.
#
# Считаются файлы `spec_tests/**/*.nv`, у которых СТРОКА НАЧИНАЕТСЯ маркером
# `// EXPECT_CC_ERROR`, то есть приёмка формы отдана сишному компилятору.
# Амендмент D405 от 2026-09-04, п. 4: «чекер, не Си».
#
# ПРАВИЛО СЧЁТА: по строкам-маркерам, НЕ по вхождениям имени. Наивный греп
# даёт 10 — у `d128_char_distinct_from_int` и
# `plan103_2_atomic_i32_no_such_static_neg` старое имя маркера живёт в ПРОЗЕ
# комментария как запись об истории; обе давно переведены на диагностику
# чекера (вторая — 2026-08-19).
#
# Число ходит только ВНИЗ. Рост — красный: новая фикстура, просящая Си быть
# нашим чекером, красит гейт немедленно. Снижение — свободно, но базу
# опускает ТА ЖЕ правка, что перевела фикстуру, строкой-летописью ниже.
#
# ЛЕТОПИСЬ
# 2026-09-05 — база заведена значением 8 (интегратор, вместе со строкой №966).
#   Замер того же дня: было 9, стало 8 — фикстура
#   `neg/f2_negative_match_arm_type_mismatch` переведена на
#   `EXPECT_COMPILE_ERROR E7301`, потому что после фикса №959 несовпадение
#   типов ветвей `match` ловит Nova, а не Си. Это первый перевод, сделанный
#   не правкой маркера, а починкой компилятора, — и других переводов иначе
#   быть не должно.
#
#   Из восьми две — `neg_sort_no_compare` и
#   `plan103_1_ordering_construct_with_payload_neg` — не задают подстроку
#   вовсе и зеленеют на ЛЮБОМ отказе Си. Их стоит брать первыми: они не
#   слабее прочих, они не утверждают ничего.
cc_error_fixtures=8
