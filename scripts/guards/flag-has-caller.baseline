# База 2026-08-11: флаги NOVA_*, которые читает компилятор, но которые
# не взводит и не описывает ничто вне Rust-исходников.
#
# Семь имён на момент заведения стража: NOVA_BAIL_GAPLOG, NOVA_CALL_TRACE,
# NOVA_DOC_GENERATED_AT, NOVA_ID_TRACE, NOVA_RL_TRACE, NOVA_RTBUF_PTR_TRACE,
# NOVA_STRICT_EFFECTS. Первые шесть похожи на отладочные следы, оставленные
# после разбора; седьмой подозрителен отдельно — строгие эффекты у нас флаг
# командной строки, и переменная рядом с ним требует объяснения.
#
# Разбирать каждый — отдельная работа (реестр №578). Отсюда только вниз.
# 8 -> 2 (2026-08-23, замер прогоном): страж сам просил опустить — «долг
# СНИЗИЛСЯ (2 < базы 8)». Сужение делала не эта ветка, но храповик, который
# просят опустить и не опускают, перестаёт быть храповиком: следующий рост
# до восьми прошёл бы молча.
silent_flags=2
