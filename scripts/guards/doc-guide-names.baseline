# База стража check-doc-guide-names: имена, названные в `docs/guide/**` со
# скобками, которых НЕТ среди объявлений `fn` в `std/src` и ключевых слов
# лексера, и это ЗАКОННО. Одно имя в строке; после `#` — причина.
#
# ПОЧЕМУ СПИСОК, А НЕ ЧИСЛО: предмет здесь — само имя. Счётчик разрешил бы
# заменить одно чужое имя другим молча, а именно имя и читает пользователь.
#
# ПОЧЕМУ СПЕКА НЕ СЛУЖИТ ИСТОЧНИКОМ ИСТИНЫ — замер 2026-09-17, и он решил
# устройство стража: если добавить объявления `fn` из `spec/**`, множество
# известных имён растёт на 362 и туда попадает `debug_assert` — потому что блок
# D81 ДОКУМЕНТИРУЕТ его ретракцию и приводит объявление. То есть источник,
# выглядящий самым авторитетным, СНЯЛ БЫ ровно тот дефект, ради которого страж
# заведён. Спека говорит, что форма ОБСУЖДАЛАСЬ; существует она или нет —
# знают лексер и `std/src`.
#
# КАК ПОПОЛНЯТЬ: имя попадает сюда, только если оно ЧУЖОЕ (функция C,
# внутренность CLI, интринсик компилятора) либо объявлено у ВСТРОЕННОГО типа
# вне `std/src`. Если имя — настоящая форма Nova, которой нет, то чинится ДОКА,
# а не база.
#
# База снята 2026-09-17 замером; каждое имя проверено по файлу, где названо.

# --- функции C и FFI-примеры (чужой язык по построению) ---
_alloc            # C-API в ffi-cookbook: пример чужой библиотеки
_close            # то же
_destroy          # то же
_free             # то же
_init             # то же
ffi_write         # C-сторона примера в typed-pointers
uv_hrtime         # libuv, вызывается через FFI (time.md)
nova_chan_reader_close_after_ns  # C-функция рантайма каналов

# --- интринсики компилятора: живут строковыми литералами в кодогене ---
size_of           # emit_c.rs:37338, не объявление `fn`
align_of          # там же
addr_of           # интринсик указателей
addr_of_mut       # интринсик указателей
embed             # директива компилятора (embed.md)
embed_dir         # то же
embed_str         # то же
old               # оператор контрактов внутри `ensures`, не функция
struct            # слово C в прозе про раскладку (field-visibility-guide)
main              # точка входа, не объявление в std

# --- методы ВСТРОЕННЫХ типов: объявлены в спеке, реализованы в компиляторе ---
as_bytes          # str: `fn str @as_bytes() -> ro []u8` (02-types.md:3656)
as_chars          # str, та же семья
as_graphemes      # str
as_sentences      # str
as_words          # str
from_utf16        # str
parse_int         # str
nth               # str
from              # конструктор-«из», у встроенных типов
to_vec            # у представлений
step              # ленивые представления (vec-lazy)
zcollect_into     # ленивые представления
max_value         # предел типа (datetime)
timestamp         # время
monotonic         # время
from_nanos        # длительность
tick_every        # каналы
close_at          # каналы
mem_fs            # файловая система в памяти (io-fs)

# --- внутренности CLI на Rust: названы в доке инструмента, не формы языка ---
compile_c_to_exe  # nova-cli.md
detect_toolchain  # nova-cli.md
detect_or_build_libuv  # nova-cli.md
detect_boehm      # linux-build.md
get_item          # nova-cli.md
list_modules      # nova-cli.md
query_items       # nova-cli.md
