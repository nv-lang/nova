# База стража scripts/guards/check-retracted-try-semantics.sh.
# Числа по зонам — осадок СНЯТОЙ трактовки оператора `?` (D85). ТОЛЬКО ВНИЗ.
#
# ЛЕТОПИСЬ (менять числа можно только с записью строки сюда):
#
# 2026-08-17, заведение. Повод — вопрос владельца «дозакрыть галочки можешь?»
# по аудиту самосогласованности 2026-08-16. Ответ оказался не «дописать
# пометки», а «поставить измеритель»: ручная разметка группы A промахнулась
# ДВАЖДЫ ИЗ ЧЕТЫРЁХ (у D86 маркера в файле не было вовсе; у D158 помечен один
# носитель из восьми). Пометка руками не закрывает даже носителя — потому что
# руками же и промахивается.
#
#   guide=0   — базы НЕТ и не будет: публикуемая зона держится на нуле без
#               храповика, как в check-retracted-param-form. Достигнут в тот же
#               день волной №713: 14 мест в tutorial-cleanup.{md,ru.md}
#               переведены с `?` на `!!`, обе страницы получили врезку про
#               разницу форм. Обе страницы cleanup-cookbook были чисты изначально.
#   spec=35   — 8 лексических (проза «`?` — сахар над `throw`», в основном
#               04-effects.md вокруг D4/D67) + 27 структурных (примеры с `?`
#               внутри Fail-функций). Это ИСТОРИЯ решений, а не ложь читателю:
#               spec/decisions хранит в том числе снятые ветки. Снимать их
#               надо, но волной и с пометками, а не под красным гейтом.
#   plans=12  — 5 лексических + 7 структурных. Планы — рабочие записи; тут
#               осадок законнее всего.
#   dev=60    — 2 лексических + 58 структурных, почти всё в docs/dev/idioms/.
#               Самая толстая зона и первый кандидат на следующую волну:
#               идиомы читаются как образец для подражания.
#
# ПОЧЕМУ НЕ НОЛЬ СРАЗУ. Обнулить всё одним махом — значит переписать 107 мест
# без проверки компилятором (№442 открыт: примеры спеки не собираются). Тогда
# правки будут такими же непроверенными, как то, что они чинят. Храповик
# фиксирует достигнутое и не даёт добавлять новое, пока волны идут по зонам.
#
# ЧТО СЧИТАЕТСЯ ЗАКОННЫМ И НЕ ПОПАДАЕТ В ЧИСЛА: форма D196
# `consume X = expr? { body }`; оператор `??`; слово `desugar`; строки,
# которые сами помечают форму снятой (ссылки на D85/D196, «СНЯТО», «amend»).
spec=35
plans=12
dev=60
