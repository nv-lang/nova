# scripts/guards/novac-iteration-cost.baseline — бюджеты цены цикла novac
# (конвенция П14; план 274.2). Миллисекунды, с запасом x2 на шум машины.
# Судья: check-novac-iteration-cost.sh — в ОБЕ стороны: факт > бюджет — просадка,
# красный; факт < бюджет/2 (ускорение) без поднятия базы тем же коммитом — тоже
# красный (база обязана отражать реальность, иначе просадку не увидеть).
#
# 2026-08-15: факты — смоук 1.7с, check 120–180мс, фаззер 16.5с, дифф-раннер 68с.
smoke-warm-ms 4000
check-one-ms 400
fuzz-ms 40000
diff-corpus-ms 140000
