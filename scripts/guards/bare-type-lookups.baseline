# База check-bare-type-lookups: чтения карты типов чекера ГОЛЫМ именем.
#
# Карта `TypeCheckCtx.types` ключуется ПРОСТЫМ именем и коллидирует между
# модулями last-write-wins. Это источник истины чекера, и он разрешает имя
# неверно всякий раз, когда два модуля объявили одноимённый тип.
#
# ЧИСЛО ОБЯЗАНО ТОЛЬКО УБЫВАТЬ. Разом его не снять — окно W6 (план 196)
# переводит потребителей на `types_get_for_file` (разрешение по file_id места
# ИСПОЛЬЗОВАНИЯ) и снимает обходы. До тех пор новый голый читатель заводит
# новую грань класса, который возвращался ЧЕТЫРЕЖДЫ: 196.7, №696, №705 и
# №729 (починка последнего разбилась о два ложных отказа ровно на этой
# коллизии).
#
# ЛЕТОПИСЬ
# 2026-08-18  bare=72, routed=7 — первый замер. Поверхность коллизий тогда же:
#             conformance 1073 CU, коллизии в 39 (3.6%), максимум два имени на
#             модуль, различных имён в корпусе ШЕСТЬ — Kind, Node, Rect,
#             SignedInts, Widget, Write (`NOVA_TYPE_COLLISION_REPORT`).
#             Перечислимость и есть довод: фикс проверяется исчерпывающе.

bare=72
