#!/bin/sh
# pre-commit — общий git-хук пяти реп (nova/nova-http/nova-tls/nova-polaris/
# nova-compress), запускается на КАЖДЫЙ `git commit` во всех них разом.
#
# ПОЧЕМУ. Конфликт-маркеры и чужое авторство коммита раньше были правилами
# только в тексте (памяти/CLAUDE.md) — соблюдение зависело от того, помнит
# ли агент. Цена промаха измерена: 349 коммитов ушли под авторством
# «Claude Haiku» через общий .git нескольких worktree (инцидент 2026-07-25).
# План 231 трек Д п.2 (docs/plans/231-bug-cycle-exit.md, «Git-хуки в репе»)
# + исполнительный дом docs/plans/231.2-enforcement-infra.md §1.
#
# КАК ПОДКЛЮЧЁН. `core.hooksPath` в git-конфиге репы указывает на этот
# каталог (`scripts/githooks`) вместо стандартного `.git/hooks` — так один
# файл в главной репе nova обслуживает git-операции во всех пяти пакетных
# репах без копирования. Проверено 2026-07-27: nova/nova-http/nova-tls/
# nova-polaris реально указывают сюда (`git config --get core.hooksPath`);
# nova-compress — по описанию плана 231.2, доступа для проверки не было.
#
# ЧТО ПРОВЕРЯЕТ (падает с exit 1 = коммит заблокирован):
#   1) Конфликт-маркеры в staged-диффе (`<<<<<<<`/`=======`/`>>>>>>>` —
#      только ДОБАВЛЕННЫЕ строки, `^\+`, т.к. staged-контекст с уже
#      существующими маркерами в НЕизменённых строках — не наша забота).
#   2) Авторство: `git config user.name`/`user.email` не должны содержать
#      «Claude»/«claude»/«anthropic» (урок 349 коммитов выше).
#   3) План 232 Ф.3: правка `spec/decisions/*.md` в staged без правки
#      обзорного `spec/<тема>.md` в том же коммите — блок, если только не
#      выставлена переменная `NOVA_OVERVIEW_NA=1` (единственный штатный
#      обход в этом скрипте; см. ниже — обход только для ЭТОГО правила,
#      правила 1 и 2 такого клапана не имеют).
#   4) 274.3/F13: правка `spec/decisions/*.md` в staged без синхронного
#      счётчика `spec-queue` в `novac/nova.toml` — блок, клапан
#      `NOVA_SPECQUEUE_NA=1`. Заведено 2026-09-02 после ВОСЬМОГО срабатывания
#      класса (реестр 221.1 №846) и ДВУХ за один вечер: счётчик протухает на
#      КАЖДОМ спек-коммите, CI ловит это через час, и красный CI по правилу
#      pre-push блокирует СЛЕДУЮЩИЙ пуш во все три зеркала — то есть цена
#      забытой строки бухгалтерии есть остановленная выкладка чужой работы.
#      Здесь та же проверка стоит секунду и на месте.
#
# ИСПОЛЬЗОВАНИЕ. Автоматический — не запускается руками. Аварийный обход
# ЖЁСТКО не рекомендован (`--no-verify` запрещён CLAUDE.md/dev-workflow.md
# кроме явного разрешения владельца); единственный предусмотренный В САМОМ
# СКРИПТЕ обход — `NOVA_OVERVIEW_NA=1 git commit ...` для правила 3
# (осознанный пропуск обзорной правки).
# 1) Конфликт-маркеры в staged.
if git diff --cached | grep -E '^\+(<<<<<<<|>>>>>>>|=======$)' >/dev/null 2>&1; then
  echo "pre-commit: conflict markers in staged — commit blocked." >&2
  exit 1
fi
# 2) Авторство: не Claude/anthropic (урок 2026-07-25, 349 коммитов).
AN=$(git config user.name)
AE=$(git config user.email)
case "$AN $AE" in
  *[Cc]laude*|*anthropic*)
    echo "pre-commit: author '$AN <$AE>' blocked — restore owner git identity." >&2
    exit 1;;
esac
# 3) 232 Ф.3: амендмент decisions без касания обзорных spec/*.md и без маркера [overview: n/a].
if git diff --cached --name-only | grep -q '^spec/decisions/'; then
  if ! git diff --cached --name-only | grep -qE '^spec/[^/]+\.md$'; then
    MSG_FILE="$1"
    if [ -z "${1:-}" ] || ! grep -q '\[overview: n/a\]' "${MSG_FILE:-/dev/null}" 2>/dev/null; then
      # pre-commit не видит сообщение — проверка маркера в commit-msg невозможна здесь;
      # мягкий блок с подсказкой обхода через env-переменную.
      if [ -z "${NOVA_OVERVIEW_NA:-}" ]; then
        echo "pre-commit(232): staged menyaet spec/decisions/, no ne trogaet obzornye spec/*.md." >&2
        echo "  Libo obnovi zatronutyi spec/<tema>.md v etom zhe kommite," >&2
        echo "  libo osoznanno propusti: NOVA_OVERVIEW_NA=1 git commit ..." >&2
        exit 1
      fi
    fi
  fi
fi
# 4) 274.3/F13: schetchik spec-queue dolzhen uchityvat ETOT kommit.
# Formula ta zhe, chto u strazha novac-diff-corpus.sh, no s popravkoy na to,
# chto kommita eshche NET: schitaem HEAD i pribavlyaem edinicu. Merge propuskaem
# (merge ne schitaetsya resheniem: u strazha stoit --no-merges).
NOVA_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
NOVA_TOML="$NOVA_ROOT/novac/nova.toml"
# GITDIR SPRASHIVAEM U GIT, a ne sobiraem kak "$NOVA_ROOT/.git": v worktree
# `.git` -- eto FAYL so ssylkoy, a MERGE_HEAD lezhit v
# <repo>/.git/worktrees/<imya>/. Poetomu propusk sliyaniy nizhe ne srabatyval
# NIKOGDA imenno tam, gde sliyaniya i proishodyat: main prinadlezhit
# integratoru, i kazhdoe okno slivaet ego v SVOYOM worktree.
# Zamereno 2026-09-03 (okno 274): hook potreboval opustit schetchik 47 -> 39,
# potomu chto SQ_HAVE schitaet HEAD DO sliyaniya. Poslushatsya znachilo by
# otkatit schetchik integratora na vosem i pokrasnit CI -- rovno tot vred,
# radi kotorogo pravilo zavedeno (reestr 846).
# IMENNO --absolute-git-dir: obychnyy --git-dir pechataet OTNOSITELNYY `.git`
# iz glavnoy kopii (urok uzhe zapisan v check-commit-language.sh, stroka 147).
NOVA_GITDIR="$(git rev-parse --absolute-git-dir 2>/dev/null)"
if [ -f "$NOVA_TOML" ] && [ ! -f "$NOVA_GITDIR/MERGE_HEAD" ] \
   && git diff --cached --name-only | grep -q '^spec/decisions/'; then
  SQ_POINT=$(tr -d '\r' < "$NOVA_TOML" \
             | sed -n 's/^#[[:space:]]*spec-point:[[:space:]]*\([0-9-]*\)$/\1/p')
  if [ -n "$SQ_POINT" ]; then
    SQ_HAVE=$(git log --since="$SQ_POINT 23:59:59" --no-merges --format=%h HEAD \
              -- spec/decisions 2>/dev/null | wc -l | tr -d ' ')
    SQ_WANT=$((SQ_HAVE + 1))
    # Znachenie beryom iz INDEKSA (git show :path), a ne iz rabochego dereva:
    # sudim to, chto realno uedet v kommit.
    SQ_GOT=$( { git show :novac/nova.toml 2>/dev/null || cat "$NOVA_TOML"; } \
             | tr -d '\r' \
             | sed -n 's/^#[[:space:]]*spec-queue:[[:space:]]*\([0-9][0-9]*\)$/\1/p')
    if [ "$SQ_GOT" != "$SQ_WANT" ]; then
      if [ -z "${NOVA_SPECQUEUE_NA:-}" ]; then
        echo "pre-commit(274.3/F13): spec-queue = ${SQ_GOT:-<net stroki>}, a etot kommit delaet $SQ_WANT." >&2
        echo "  Kommit trogaet spec/decisions/, znachit schetchik otstayot na yedinicu." >&2
        echo "  Ispravit: postav '#   spec-queue: $SQ_WANT' v novac/nova.toml i vklyuchi ego v ETOT kommit." >&2
        echo "  Osoznanno propustit: NOVA_SPECQUEUE_NA=1 git commit ..." >&2
        echo "  Zachem blok zdes: inache eto naydyot CI cherez chas i zablokiruet sleduyushchiy push (reestr 846)." >&2
        exit 1
      fi
    fi
  fi
fi

# --- sekrety v staged (2026-08-12, perenesen iz sosednego proekta) --------
# Sekret vreden samim faktom popadaniya v istoriyu: v URL zerkala sourcecraft
# lezhit token, i perepisyvat istoriyu na tryokh zerkalakh dorozhe, chem
# ostanovitsya zdes. Lozhnoe srabatyvanie obkhoditsya OSOZNANNO:
# git commit --no-verify + stroka ob etom v soobshchenii kommita.
GUARD="$(git rev-parse --show-toplevel 2>/dev/null)/scripts/guards/check-staged-secrets.sh"
if [ -f "$GUARD" ]; then
  sh "$GUARD" >/dev/null 2>&1 || {
    sh "$GUARD" >&2
    exit 1
  }
fi

exit 0
