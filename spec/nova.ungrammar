// nova.ungrammar -- ФОРМА языка Nova как ДАННЫЕ. Нормативен по решению Р.2
// плана 274.13: в вопросах ФОРМЫ этот файл равен D-блокам по старшинству;
// СЕМАНТИКА остаётся за D-блоками, и ни одно правило здесь её не задаёт.
//
// ИМЕНА ПРАВИЛ == ВАРИАНТЫ `NodeKind` (`novac/src/tree/tree.nv`), пофамильно и
// в обе стороны. Это судит `check-novac-grammar-kinds.py`; исключения не
// подразумеваются, а названы в разделе «Исключения» ниже.
//
// ЧТО ЭТО ЗА ВЕРСИЯ. v0 списана С ПАРСЕРА, а не со спеки, и это решение, а не
// небрежность (274.13 Ш.2): так страж зелен с первого дня, а расхождение
// парсера со спекой становится ДИФФОМ ДВУХ ФАЙЛОВ вместо чьей-то памяти.
// Значит: правило, описывающее сегодняшнее поведение, здесь стоит даже тогда,
// когда спека требует иного, — и такое место помечено словом РАСХОЖДЕНИЕ.
//
// ЗАПИСЬ (формат ungrammar, как в rust-analyzer):
//   'kw'          -- токен, в одинарных кавычках;
//   Node          -- дочерний узел, PascalCase, имя правила;
//   label:Node    -- дочерний узел под меткой поля;
//   A?  A*  A+    -- ноль-или-один, ноль-или-больше, один-или-больше;
//   (A | B)       -- одно из.
//
// ДВЕ ЗАПИСИ, КОТОРЫЕ ЧИТАЮТСЯ КАК ПРАВИЛА, НО ИМИ НЕ ЯВЛЯЮТСЯ:
//   TypeRefLeaves -- НЕ узел. `@type_ref()` (`parse/type_ref.nv:35`) своего
//                    узла не строит, а кладёт прогон листьев и подузлов прямо
//                    в детей родителя. Здесь это имя означает ровно такой
//                    прогон; в `NodeKind` его нет и быть не должно.
//   BalancedRun   -- НЕ узел: сбалансированный прогон сырых токенов, который
//                    парсер переносит «как есть», не разбирая (списки типовых
//                    параметров, аргументы атрибутов, хвост импорта).
//
// ИСКЛЮЧЕНИЯ ИЗ РАВЕНСТВА МНОЖЕСТВ -- ровно одно, и оно названо:
//   LeafNode -- вид ЛИСТА, а не форма ветви (`tree.nv:33`: «LeafNode is the
//               leaf's own kind -- a leaf is NOT an error»). Правила у него нет
//               и быть не может: грамматика описывает ветви. Страж обязан
//               исключать его ПОИМЕННО и печатать, что исключил, — молчаливое
//               исключение неотличимо от дыры.
//
// ЧЕМ ПОЛУЧЕНО КАЖДОЕ ЧИСЛО ЗДЕСЬ, и почему это записано.
// Замер 2026-09-18: первый разбор перечисления дал **37** видов вместо 59 —
// он спотыкался на обычных `//`-комментариях между вариантами. 37 выглядит
// ровно так же разумно, как 59, поэтому проверка «похоже ли на правду» его
// не ловит вовсе; поймало НЕЗАВИСИМОЕ число из плана 274.13. Отсюда
// правило для этого файла: у каждой величины, входящей в норму, держи
// ВТОРОЙ источник, посчитанный ИНАЧЕ. Здесь это сделано МЕХАНИЗМОМ, а не
// вниманием: `check-novac-grammar-kinds.py` считает правила из ЭТОГО файла,
// а виды — из `tree.nv`, и сводит два множества пофамильно в обе стороны.
//
// ПЕРВАЯ НАХОДКА ЭТОГО ФАЙЛА, и она закрыта ТОЙ ЖЕ ВОЛНОЙ (2026-09-18).
// Вариант `Args` перечисления `NodeKind` НЕ СТРОИЛСЯ ПАРСЕРОМ НИ РАЗУ:
// греп по всему `novac/` давал его в ДВУХ местах -- объявление и ПУСТАЯ ветка
// исчерпывающего разбора в `check/check.nv`, где он нужен был лишь для полноты
// (прочие попадания -- проза комментариев про `Name[Args]`). Аргументы вызова
// парсер кладёт ПРЯМО в детей `Call`/`MethodCall` (`@call_args`,
// `parse/parse.nv:528`), узла-обёртки не создавая. Вид снят из перечисления
// вместе с той пустой веткой; `nova check novac/src` после снятия 16/0, сборка
// зелёная. Зачем это здесь написано: перечисление обещало форму узла,
// которой в дереве нет, и каждый исчерпывающий `match` обязан был нести ложный
// случай. Расхождение жило тихо именно потому, что перечень видов и описание
// их формы жили в РАЗНЫХ местах; теперь они сводятся стражем на каждом ярусе.

//==========================================================================
// Файл и декларации верхнего уровня
//==========================================================================

File =
  ModuleDecl?
  Item*

ModuleDecl =
  'module' 'ident' ('.' 'ident')*

ImportDecl =
  ('import' | 'use') ('ident' | '.' | '..' | '/')* Err? BalancedRun?

// поправка 2026-09-22 (окно nova-6e, тот же аудит): не несла LetDecl.
// `export ro NAME = expr` (D184's Item::Let) читалось `@let_decl()` без
// обёртки с самого начала (df13dff0d), но обёртка `ExportDecl` учила слово
// `ro` отдельно, позже (комментарий decls.nv:47-53) -- снимок не подтянулся.
ExportDecl =
  'export' (FnDecl | TypeDecl | SumDecl | ImportDecl | ConstDecl | LetDecl | Err)

AttrDecl =
  '#' 'ident'* BalancedRun?

ConstDecl =
  'const' 'ident' TypeRefLeaves? '=' Expr

// Module-level `ro NAME [Type] = expr` (D184's Item::Let) — same shape as
// ConstDecl, `ro` in place of `const`.
LetDecl =
  'ro' 'ident' TypeRefLeaves? '=' Expr

TestDecl =
  'test' 'string' (Block | Err)

//==========================================================================
// Функции
//==========================================================================

FnDecl =
  'extern'? 'string'? 'unsafe'?
  'fn' Recv? Generics? TypeRefLeaves
  '(' Param* ')'
  RetType?
  Requires*
  (Block | FnExprBody)?

Recv =
  Generics? TypeRefLeaves mode:'ident'? ('@' | '.')

// поправка 2026-09-23 (E4 wave, 274.11): тип необязателен. Правило
// утверждало обязательный TypeRefLeaves, а дерево с лета 2026 строит
// параметр с ГОЛЫМ именем (`fn f(v)` — `type_slot_after` в slots.nv читает
// отсутствие типа как данность), и хендлер-литерал измерен на оракуле с
// голыми параметрами (`effect Fs { read(p) -> []u8 => ... }`, 2026-09-22).
// Снимок догоняет форму, а не наоборот.
Param =
  '...'? mode:'ident'? 'ident' TypeRefLeaves? ('=' Expr)? ','?

RetType =
  '->' TypeRefLeaves

// One effect in a signature's effect_list (D3/D209): zero or more, written
// as bare type references between `)` and `->` (or the body, when the
// return type is the omittable `()`), no separator between them.
EffectItem =
  TypeRefLeaves

Requires =
  'requires' Expr (',' 'string')?

FnExprBody =
  '=>' Expr

Block =
  '{' Stmt* '}'

//==========================================================================
// Объявления типов
//==========================================================================

// поправка 2026-09-22 (окно nova-6e, тот же аудит): не несла EFFECT-форму.
// `type Counter effect { fn log(msg str) -> () }` (D459) читается парсером
// с 2026-09-21 (type_decl.nv:100-116, комментарий там же цитирует
// "registry TBD" -- эта строка её и закрывает) тем же приёмом, что
// 'protocol' в 2026-08-23; EffectOp — уже своё правило ниже, просто не было
// на кого сослаться.
TypeDecl =
  'type' 'ident' Generics? 'value'? 'consume'? ('priv' BalancedRun?)?
  (
      'protocol' ('{' ProtoMethod* '}')?
    | 'effect' ('{' EffectOp* '}')?
    | '{' Field* '}'
    | '(' Field* ')'
    | 'alias'? TypeRefLeaves
  )?

SumDecl =
  'type' 'ident' Generics? 'value'? 'consume'? ('priv' BalancedRun?)?
  ('enum' Variant* | Variant+)

Variant =
  '|'? 'ident' BalancedRun? ('(' 'ident' (',' 'ident')* ')')?

Field =
  mode:'ident'? 'ident' TypeRefLeaves ('=' Expr)?

ProtoMethod =
  '@' 'ident' ('(' Param* ')')? RetType?

// One operation signature inside `type X effect { ... }` (D459): `fn NAME(params) -> T`.
// `check` refuses the whole declaration by name (no effect-system semantics
// yet) -- this shape only keeps the reader from turning the body into junk.
EffectOp =
  'fn' 'ident' ('(' Param* ')')? RetType?

Generics =
  '[' BalancedRun ']'

//==========================================================================
// Инструкции
//==========================================================================

IfStmt =
  'if' cond:Expr (Block | Err) ('else' (Block | IfStmt | Err))?

// поправка 2026-09-21 (окно nova-6e, аудит по заданию интегратора): голова
// была написана только для ГОЛОЙ формы. Реестр #1259 расширил парсер до
// КВАЛИФИЦИРОВАННОЙ формы `if Sum.Variant(binder) = expr` (`parse.nv:624-665`,
// `iflet_qualified`) -- снимок ниже ловит обе.
IfLet =
  'if' 'ident' ('.' 'ident')? '(' binder:'ident' ')' '=' scrutinee:Expr Block
  ('else' (Block | IfStmt | Err))?

WhileStmt =
  'while' cond:Expr (Block | Err)

ForStmt =
  'for' binder:'ident' 'in' iter:Expr (Block | Err)

RetStmt =
  'return' Expr?

BindStmt =
  ('mut' | 'ro' | 'consume') 'ident' TypeRefLeaves? '=' Expr

DestructureBind =
  ('mut' | 'ro' | 'consume')
  ( '(' Name (',' Name)* ')' | '{' Name (',' (Name | '..'))* '}' )
  '=' Expr

AssignStmt =
  lhs:Expr op:'assign_op' rhs:Expr

// поправка 2026-09-23: вид стоял в перечислении с 2026-09-21 (волна Э.4,
// коммит f9872694a) без правила — страж видов кинул это красным на той же
// неделе, строка его и закрывает. Контекстное слово, не лексема (D61): дверь
// — spelling + форма (`with` Ident `=` на местах 0..2), см. parse.nv:842.
WithStmt =
  'with' 'ident' '=' handler:Expr (',' 'ident' '=' handler:Expr)* (Block | Err)

//==========================================================================
// Выражения
//==========================================================================

Bin =
  lhs:Expr op:'bin_op' rhs:Expr

Unary =
  op:'un_op' Expr

Cast =
  Expr 'as' TypeRefLeaves

Coalesce =
  lhs:Expr '??' (rhs:Expr | 'return' Expr?)

Try =
  Expr '?'

Paren =
  '(' Expr ')'

TupleExpr =
  '(' Expr (',' Expr)+ ')'

// поправка 2026-09-21 (окно nova-6e, тот же аудит): else-ветка не несла
// само-рекурсию, хотя сосед-IfStmt её уже несёт. Реестр #1243 научил парсер
// строить `else if` в позиции значения как вложенный IfExpr (`expr.nv:645-660`,
// комментарий "nests as IfExpr(..., KwElse, IfExpr(...))") -- снимок был
// написан до этой правки и не подхватил новую ветку.
IfExpr =
  'if' cond:Expr (Block | Err) ('else' (Block | IfExpr | Err))?

MatchExpr =
  'match' scrutinee:Expr '{' MatchArm* '}'

MatchArm =
  Pattern Guard? '=>' (Block | Expr) ','?

Pattern =
  ( 'int'
  | '[]'
  | '[' ('ident' | '..' | Err)* ']'
  | 'ident' BalancedRun? ('(' 'ident' (',' 'ident')* ')')?
      ('|' 'ident' ('(' 'ident' (',' 'ident')* ')')?)*
  )

Guard =
  'if' Expr

Call =
  'ident' Generics? '(' Arg* ')'

MethodCall =
  ( recv:Expr '.' 'ident' '(' Arg* ')'
  | SelfExpr '@' 'ident' '(' Arg* ')'
  )

NamedArg =
  'ident' ':' Expr

FieldAccess =
  recv:Expr '.' ('ident' | 'int')

Index =
  ( recv:Expr '[' Expr ']'
  | Name '[' Expr (',' Expr)* ']'
  )

SelfExpr =
  '@'

SelfField =
  '@' 'ident'

Name =
  'ident'

Lit =
  '-'? 'literal'

InterpStr =
  'str_frag' ('{' Expr '}' 'str_frag')*

ArrayLit =
  ( '[]' ('ident' '.' 'ident' ('(' Arg* ')')?)?
  | '[' (Expr | ArraySpread)* ']'
  )

ArraySpread =
  '...' Expr

RecordCtor =
  Name? '{' (CtorField | CtorSpread | Err)* '}'

CtorField =
  'ident' (':' Expr)?

CtorSpread =
  '...' Expr

Unsafe =
  'unsafe' Block

// A HANDLER LITERAL (D61), измерен на оракуле 2026-09-22: `effect Fs {
// read(p str) -> []u8 => []u8.new() }`. Контекстное `effect` + имя + `{`
// (дверь в parse/expr.nv); обычное выражение такой тройки дать не может —
// два имени подряд не разбираются как одно выражение. `-> T` ОБЯЗАТЕЛЕН
// (отсутствие — E_INCOMPLETE_HANDLER_OP_DECL оракула), тело — выражение
// после `=>` ИЛИ блок. `fn` перед именем операции — ошибка разбора оракула
// ("expected identifier"), поэтому ключевого слова в форме нет.
HandlerLit =
  'effect' 'ident' '{' HandlerOp* '}'

// ОДНА реализация операции внутри литерала. Параметры — голые имена или
// `имя Тип` (аннотация НЕ сверяется со схемой этой волной — позиционное
// связывание, названный долг); режим (`mut p []u8`) — форма оракула
// (фикстура E_HANDLER_OP_PARAM_MUT_WITHOUT_TYPE), проверка «режим без типа»
// этой волной не читается. Отсутствующий RetType — ВИДИМО: чекер называет
// его сам (E_INCOMPLETE_HANDLER_OP_DECL), а не угадывает тип.
HandlerOp =
  'ident' '(' Param* ')' RetType? ('=>' (Expr | Block) | Block)

//==========================================================================
// Узлы ошибок -- часть формы, а не её отсутствие
//==========================================================================

// Восстановление после ошибки: прогон токенов, который парсер не смог отнести
// ни к одной форме. Длина и смысл детей зависят от МЕСТА восстановления
// (мусор верхнего уровня, мусор сигнатуры, пустой путь импорта, битое поле);
// форма узла при этом одна.
Err =
  Any*

// Отказ по ГЛУБИНЕ вложенности: сбалансированный прогон, снятый целиком,
// чтобы разбор не уходил в рекурсию. Отдельный вид, а не `Err`, потому что
// причина названа и диагностика у него своя.
DepthErr =
  Any*
