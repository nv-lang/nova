__pycache__/
*.pyc
.venv/
venv/

# Локальные настройки Claude Code (вся папка — личная оснастка сессий)
.claude/

# Личные рабочие материалы
docs/.sessions/

# D420 (Plan 204) / Plan 233 §2а (renamed): machine-local [replace] +
# [net] proxy overrides — never committed (dev-only overrides on top of a
# package's release git+version dep / env proxy). nova.override.toml is
# the current canonical name; nova.local.toml kept for the transitional
# period (old name still read by the tooling with a deprecation warning).
nova.override.toml
nova.local.toml

# Артефакты компиляции примеров
*.asm
*.obj
*.exe
*.pdb
*.ilk
# Сгенерированный C ложится РЯДОМ с .nv, поэтому правило перевёрнуто: игнорируем
# весь *.c и возвращаем два каталога, где C — настоящий исходник. Прежде здесь
# шло перечисление каталогов (examples/nova_tests/std/bench/detect172), и оно
# протекало при каждом новом каталоге: spec_tests добавили только 2026-07-14,
# nova_tests.old не добавили вовсе — 172 файла копились неотслеживаемыми.
# Инвариант «список каталогов полон» держался памятью; теперь его нет.
*.c
!compiler-codegen/nova_rt/**/*.c
!scripts/tools/**/*.c

# Plan 156 (rev-3): full Unicode conformance corpora are regenerated on-demand
# from pinned UCD into the slow-lane, NOT committed (only the fast *_conformance.nv
# sample is committed). See docs/dev/research/10-unicode-test-data-storage.md.
nova_tests/**/*_conformance_slow.nv
test_out.txt

*.ilk
scratch38/

# Local secrets for the manual smoke test of examples/flagship/http_proxy_chain
# (plan 249 §5). The committed template is `.env.example`.
.env

# сгенерированный C рядом с исходниками novac — артефакт сборки, не источник
# (shell.tpl.c — настоящий источник, поэтому исключение)
novac/src/**/*.c
!novac/src/emit_c/shell.tpl.c
