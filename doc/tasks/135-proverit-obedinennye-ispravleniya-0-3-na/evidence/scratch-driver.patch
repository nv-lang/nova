+        // task 135, LOCAL scratch driver only: the seed compiler's own
+        // emit_c/shell.nv embeds shell.tpl.c (D412) and staging carried only
+        // .nv files, so building Carina itself met E_EMBED_NOT_FOUND. Stage
+        // the non-.nv siblings of every staged source too; the seed reads
+        // them only when a source embeds them. RECURSIVE (second pass, after
+        // the tls examples met the same gap one directory down: stream.nv
+        // embeds certs/localhost_cert.pem): descend into subdirectories,
+        // still non-.nv files only (a peer directory's .nv files are NOT the
+        // program's), never into build/VCS/dependency dirs.
+        fn stage_sidecars(src_dir: &Path, stage_dir: &Path) {
+            let Ok(rd) = std::fs::read_dir(src_dir) else { return };
+            for e in rd.flatten() {
+                let p = e.path();
+                if p.is_file() {
+                    if p.extension().is_some_and(|x| x == "nv") {
+                        continue;
+                    }
+                    let side = stage_dir.join(p.file_name().unwrap());
+                    if !side.exists() {
+                        std::fs::copy(&p, &side).ok();
+                    }
+                } else if p.is_dir() {
+                    let name = p.file_name().unwrap_or_default();
+                    if name == "target" || name == ".git" || name == "node_modules" {
+                        continue;
+                    }
+                    let sub = stage_dir.join(name);
+                    if std::fs::create_dir_all(&sub).is_ok() {
+                        stage_sidecars(&p, &sub);
+                    }
+                }
+            }
+        }
+        if let Some(src_dir) = source.parent() {
+            if let Some(stage_dir_of_file) = target.parent() {
+                stage_sidecars(src_dir, stage_dir_of_file);
+            }
+        }
         if normalize_path(source) == normalize_path(entry) {
             staged_entry = target;
