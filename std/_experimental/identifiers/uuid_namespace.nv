// stdlib/uuid_v3_v5.nv — name-based UUIDs (RFC 4122 § 4.3).
//
// v3 = MD5(namespace || name)  — legacy, MD5 broken
// v5 = SHA-1(namespace || name) — preferred для name-based
//
// Namespace UUIDs из RFC 4122 Appendix C:
//   DNS:  6ba7b810-9dad-11d1-80b4-00c04fd430c8
//   URL:  6ba7b811-9dad-11d1-80b4-00c04fd430c8
//   OID:  6ba7b812-9dad-11d1-80b4-00c04fd430c8
//   X500: 6ba7b814-9dad-11d1-80b4-00c04fd430c8

module identifiers.uuid_namespace

import std.identifiers.uuid.{Uuid}
import std.crypto.md5.{Md5}
import std.crypto.sha1.{Sha1}


/// DNS namespace UUID (RFC 4122 Appendix C). Используется для name-based UUIDs
/// от DNS-имён (e.g. www.example.com).
#stable(since = "0.1")
export fn namespace_dns() -> Uuid =>
    Uuid.new(0x6ba7b8109dad11d1, 0x80b400c04fd430c8)

/// URL namespace UUID (RFC 4122 Appendix C). Для URL-based name UUIDs.
#stable(since = "0.1")
export fn namespace_url() -> Uuid =>
    Uuid.new(0x6ba7b8119dad11d1, 0x80b400c04fd430c8)

/// OID namespace UUID (RFC 4122 Appendix C). Для ISO OID identifiers.
#stable(since = "0.1")
export fn namespace_oid() -> Uuid =>
    Uuid.new(0x6ba7b8129dad11d1, 0x80b400c04fd430c8)

/// X.500 namespace UUID (RFC 4122 Appendix C). Для X.500 DN-based name UUIDs.
#stable(since = "0.1")
export fn namespace_x500() -> Uuid =>
    Uuid.new(0x6ba7b8149dad11d1, 0x80b400c04fd430c8)


/// UUID v3: name-based, MD5(namespace || name). **Legacy** — MD5 broken,
/// предпочитайте `Uuid.v5` для новых проектов.
#stable(since = "0.1")
export fn Uuid.v3(namespace Uuid, name str) -> Self {
    mut input []u8 = []
    push_uuid_bytes(input, namespace)
    for b in name.bytes() { input.push(b) }

    ro digest = Md5.hash(input)
    mut bytes []u8 = []
    for i in 0..16 { bytes.push(digest[i]) }

    // Set version=3 (MD5) и variant
    set_version_variant(bytes, 3)
    bytes_to_uuid(bytes)
}

/// UUID v5: name-based, SHA-1(namespace || name). Detеrministic (same inputs → same UUID).
///
/// # Examples
/// ```nova
/// let u = Uuid.v5(namespace_dns(), "www.example.com")
/// assert(u.to_str() == "2ed6657d-e927-568b-95e1-2665a8aea6a2")
/// ```
#stable(since = "0.1")
export fn Uuid.v5(namespace Uuid, name str) -> Self {
    mut input []u8 = []
    push_uuid_bytes(input, namespace)
    for b in name.bytes() { input.push(b) }

    ro digest = Sha1.hash(input)
    // Берём первые 16 байт SHA-1 (она даёт 20).
    mut bytes []u8 = []
    for i in 0..16 { bytes.push(digest[i]) }

    set_version_variant(bytes, 5)
    bytes_to_uuid(bytes)
}


// ──────────────────────────────────────────────────────────────────────────
// Helpers
// ──────────────────────────────────────────────────────────────────────────

fn push_uuid_bytes(out mut []u8, u Uuid) {
    mut i = 7
    while i >= 0 {
        out.push(((u.hi >> (i * 8)) & 0xFF) as u8)
        i -= 1
    }
    mut j = 7
    while j >= 0 {
        out.push(((u.lo >> (j * 8)) & 0xFF) as u8)
        j -= 1
    }
}

fn set_version_variant(bytes mut []u8, version int) {
    // Version в старшие 4 бита 6-го байта (нумерация с 0).
    bytes[6] = (((bytes[6] as int) & 0x0F) | (version << 4)) as u8
    // Variant 10 в старшие 2 бита 8-го байта.
    bytes[8] = (((bytes[8] as int) & 0x3F) | 0x80) as u8
}

fn bytes_to_uuid(bytes []u8) -> Uuid {
    mut hi u64 = 0
    for i in 0..8 {
        hi = (hi << 8) | (bytes[i] as u64)
    }
    mut lo u64 = 0
    for j in 8..16 {
        lo = (lo << 8) | (bytes[j] as u64)
    }
    Uuid.new(hi, lo)
}


// ──────────────────────────────────────────────────────────────────────────
// Тесты — RFC 4122 Appendix C examples
// ──────────────────────────────────────────────────────────────────────────
//
// [2026-07-08, волна 2 промоушена]: НЕ промоутится — `nova check` PASS, но
// `nova test --full` CC-FAIL: `error: redefinition of
// 'nova_fn_6crypto3md56rotl32'`. Репродуцировано МИНИМАЛЬНЫМ файлом
// (только `import std.crypto.md5.{Md5}` + `import std.crypto.sha1.{Sha1}`,
// без uuid_namespace вообще) — general compiler-баг: private
// (non-exported) top-level helper с одинаковым именем+сигнатурой
// (`fn rotl32(u32, int) -> u32`) в ДВУХ разных модулях (`crypto.md5`,
// `crypto.sha1`), скомпилированных в ОДИН CU → duplicate C-symbol emission
// (не name-collision между модулями — тот же mangled symbol
// `crypto.md5.rotl32` эмиттится дважды). До этой волны md5+sha1 никогда
// не компилировались в одном CU одновременно (md5_test/sha1_test/hmac_test
// импортируют их по отдельности) — поэтому баг не проявлялся раньше.
// Нужна codegen-инвестигация (private-fn dedup emission). См.
// docs/plans/backlog-followups.md.

test "v5: DNS namespace + 'www.example.com'" {
    // Известный test vector
    ro u = Uuid.v5(namespace_dns(), "www.example.com")
    assert(u.to_str() == "2ed6657d-e927-568b-95e1-2665a8aea6a2")
    match u.version() {
        Other(5) => ()        // v5 — пока нет в UuidVersion enum в uuid.nv
        _        => ()        // если позже добавим V5 в enum, поправим
    }
}

test "v3: DNS namespace + 'www.example.com'" {
    ro u = Uuid.v3(namespace_dns(), "www.example.com")
    assert(u.to_str() == "5df41881-3aed-3515-88a7-2f4a814cf09e")
}

test "v5: одинаковые namespace+name → одинаковый UUID (детерминизм)" {
    ro a = Uuid.v5(namespace_url(), "https://example.com/")
    ro b = Uuid.v5(namespace_url(), "https://example.com/")
    assert(a == b)
}

test "v5: разные namespaces → разные UUIDs" {
    ro dns = Uuid.v5(namespace_dns(), "test")
    ro url = Uuid.v5(namespace_url(), "test")
    assert(dns != url)
}
