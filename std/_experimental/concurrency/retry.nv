// stdlib/retry.nv — retry policies для transient failures.
//
// Decorate любую Fail[E]-функцию retry-логикой:
//   - Exponential backoff с jitter
//   - Max attempts
//   - Custom error filter (retry только определённые ошибки)
//
// Использует Time + Random эффекты — детерминируется в тестах
// через `with Time = th.fixed_ms(0), Random = th.seeded(42)`.
//
// API:
//   RetryPolicy.exponential(...) -> RetryPolicy
//   RetryPolicy.fixed(...) -> RetryPolicy
//   policy.execute[T, E](body fn() Fail[E] -> T) Time Random Fail[E] -> T

module concurrency.retry

import std.testing.handlers as th
import std.time.duration


// ──────────────────────────────────────────────────────────────────────────
// Policy types
// ──────────────────────────────────────────────────────────────────────────

/// Backoff strategy для retry-логики.
///
/// `Fixed` — постоянная пауза. `Exponential` — растущая (initial × multiplier^n,
/// capped на max_delay). `Linear` — initial + increment × n, capped аналогично.
#stable(since = "0.1")
export type Backoff enum
    | Fixed { delay Duration }
    | Exponential { initial Duration, multiplier f64, max_delay Duration }
    | Linear { initial Duration, increment Duration, max_delay Duration }


/// Jitter — рандомизация delay'я для избежания thundering-herd.
///
/// `NoJitter` — exact base delay. `FullJitter` — uniform 0..base.
/// `EqualJitter` — base/2 + random(0..base/2).
#stable(since = "0.1")
export type Jitter enum
    | NoJitter
    | FullJitter
    | EqualJitter


/// Retry policy: max_attempts (включая первую попытку) + backoff + jitter.
#stable(since = "0.1")
export type RetryPolicy {
    ro max_attempts int
    ro backoff Backoff
    ro jitter Jitter
}


// ──────────────────────────────────────────────────────────────────────────
// Constructors
// ──────────────────────────────────────────────────────────────────────────

/// Exponential backoff с full-jitter: 100ms, 200ms, 400ms, ... (cap 30s).
///
/// Sensible default для большинства transient failures (network / db).
#stable(since = "0.1")
export fn RetryPolicy.exponential(max_attempts int) -> Self =>
    {
        max_attempts,
        backoff: Exponential {
            initial: 100.millis(),
            multiplier: 2.0,
            max_delay: 30.seconds(),
        },
        jitter: FullJitter,
    }

/// Fixed delay — для cases когда точный период известен (rate limiter и т.п.).
#stable(since = "0.1")
export fn RetryPolicy.fixed(max_attempts int, delay Duration) -> Self =>
    {
        max_attempts,
        backoff: Fixed { delay },
        jitter: NoJitter,
    }

/// Custom — explicit backoff + jitter.
#stable(since = "0.1")
export fn RetryPolicy.custom(max_attempts int, backoff Backoff, jitter Jitter) -> Self =>
    { max_attempts, backoff, jitter }


// ──────────────────────────────────────────────────────────────────────────
// Execute
// ──────────────────────────────────────────────────────────────────────────

// Запускает body, на Fail[E] делает retry по policy. Если все попытки
// исчерпаны — пробрасывает последний throw.
/// Execute `body` с retry-логикой по policy. На каждом Fail[E] — sleep + retry.
/// После исчерпания `max_attempts` — пробрасывает последний throw.
///
/// Использует Time и Random effects — детерминирован под `th.fixed_ms` + `th.seeded`.
///
/// # Examples
/// ```nova
/// let policy = RetryPolicy.exponential(5)
/// let result = policy.execute(|| http_get("https://api.example.com"))
/// ```
#stable(since = "0.1")
export fn RetryPolicy @execute[T, E](body fn() Fail[E] -> T) Time Random Fail[E] -> T {
    mut attempt = 0
    mut result Option[T] = None
    mut last_error Option[E] = None

    while attempt < @max_attempts && result == None {
        // NB: `interrupt Err(e)` здесь — **намеренный** Result-wrap pattern,
        // не workaround. Нужен для capture'а `e` в caller-side match для
        // last_error tracking (retry policy решает на основе последней error).
        // Plan 61 followup #1 cross-effect rethrow к этому случаю не применим:
        // мы не **forward'аем** error, мы **сохраняем** его в loop state.
        ro r = with Fail[E] = |e| interrupt Err(e) {
            Ok(body())
        }
        match r {
            Ok(v)  => { result = Some(v) }
            Err(e) => {
                last_error = Some(e)
                attempt += 1
                if attempt < @max_attempts {
                    ro delay = @compute_delay(attempt)
                    delay.sleep()
                }
            }
        }
    }

    match result {
        Some(v) => v
        None    => match last_error {
            Some(e) => throw e
            None    => throw last_error!!      // unreachable
        }
    }
}


// Вычисляет delay для attempt-номера (1-based — первый retry это attempt=1).
fn RetryPolicy @compute_delay(attempt int) Random -> Duration {
    ro base = match @backoff {
        Fixed { delay } => delay
        Exponential { initial, multiplier, max_delay } => {
            // initial * multiplier^(attempt-1)
            mut d = initial
            mut i = 1
            while i < attempt {
                d = d * multiplier
                if d.nanos > max_delay.nanos { d = max_delay; i = attempt }
                i += 1
            }
            d
        }
        Linear { initial, increment, max_delay } => {
            ro total_inc = increment * ((attempt - 1) as i64)
            ro d = initial + total_inc
            if d.nanos > max_delay.nanos { max_delay } else { d }
        }
    }

    apply_jitter(@jitter, base)
}


fn apply_jitter(j Jitter, d Duration) Random -> Duration => match j {
    NoJitter => d
    FullJitter => {
        // 0..d uniform random
        ro max_ns = d.as_nanos()
        ro ns = (Random.u64() % (max_ns as u64)) as i64
        Duration.from_nanos(ns)
    }
    EqualJitter => {
        // d/2 + random(0..d/2)
        ro half = d / 2
        ro max_ns = half.as_nanos()
        ro ns = (Random.u64() % (max_ns as u64)) as i64
        half + Duration.from_nanos(ns)
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Тесты
// ──────────────────────────────────────────────────────────────────────────
//
// [2026-07-08, волна 2 промоушена]: НЕ промоутится — подтверждён исходный
// STATUS.md-диагноз (`retry FAIL E_UNUSED_PREFIX_TYPEVAR`), но с уточнением:
// это TWO-SIDED баг, не однократный.
//   1. Текущая сигнатура `@execute[T](body fn() -> T) Time Random -> T`
//      (без `E`) — `nova check` PASS, НО `nova test --full` CC-FAIL:
//      generic `E` в `Option[E] last_error`/`Fail[E]`/`throw e` нигде не
//      объявлен как type-param → компилятор инферит его per-call-site и
//      конфликтует между разными T-инстанциациями теста (`NovaOpt_nova_int`
//      vs `NovaOpt_nova_str` mismatch) — silent codegen unsoundness.
//   2. Правильная сигнатура (как в doc-comment выше, `@execute[T, E](body
//      fn() Fail[E] -> T) Time Random Fail[E] -> T`, явно объявляет `E`) —
//      `nova check` REJECTS: `[E_UNUSED_PREFIX_TYPEVAR] generic E
//      declared в fn[…] prefix но не используется в receiver, params, или
//      return type (Plan 101.1 / D145)`. Checker не считает использованием
//      generic `E`, если он встречается ТОЛЬКО внутри effect-clause
//      параметра-функции (`Fail[E]`) — не в самом типе параметра/receiver/
//      return напрямую. D145-правило слишком строгое для этого валидного
//      effect-polymorphism паттерна (retry поверх произвольной `Fail[E]`).
// Оба пути ведут в стену: implicit-E даёт codegen-баг, explicit-E упирается
// в checker-ограничение D145. Нужен либо codegen-фикс (§1), либо смягчение
// D145 (§2) — выбор архитектурный, не в рамках промоушен-волны. См.
// docs/plans/backlog-followups.md.

test "execute: первая попытка успешна" {
    ro policy = RetryPolicy.exponential(3)
    with Time = th.fixed_ms(0), Random = th.seeded(0) {
        ro result = policy.execute(|| 42)
        assert(result == 42)
    }
}

test "execute: retry до успеха" {
    ro policy = RetryPolicy.fixed(5, 10.millis())
    mut attempts = 0
    with Time = th.fixed_ms(0), Random = th.seeded(0) {
        ro result = policy.execute(|| {
            attempts += 1
            if attempts < 3 { throw "transient" }
            "success"
        })
        assert(result == "success")
        assert(attempts == 3)
    }
}

test "execute: исчерпание попыток" {
    ro policy = RetryPolicy.fixed(3, 10.millis())
    // Flag-idiom (см. std/crypto/jwt_test.nv) вместо `interrupt Some(e)` +
    // `match Some(..)` — второе даёт CC-FAIL на generic-E инференс
    // (см. [M-exp-promotion-blockers: retry] в docs/plans/backlog-followups.md).
    mut caught = ""
    with Time = th.fixed_ms(0), Random = th.seeded(0),
                Fail[str] = |e| { caught = e; "" } {
        ro _ = policy.execute(|| {
            throw "always fails"
            ""
        })
    }
    assert(caught == "always fails")
}

test "exponential backoff: правильные delay'и" {
    ro policy = RetryPolicy.custom(
        5,
        Exponential {
            initial: 100.millis(),
            multiplier: 2.0,
            max_delay: 1.hour(),
        },
        NoJitter,
    )
    // attempt 1: 100ms, 2: 200ms, 3: 400ms, 4: 800ms
    with Random = th.seeded(0) {
        assert(policy.compute_delay(1) == 100.millis())
        assert(policy.compute_delay(2) == 200.millis())
        assert(policy.compute_delay(3) == 400.millis())
        assert(policy.compute_delay(4) == 800.millis())
    }
}

test "max_delay ограничивает exponential" {
    ro policy = RetryPolicy.custom(
        20,
        Exponential {
            initial: 1.second(),
            multiplier: 10.0,
            max_delay: 30.seconds(),
        },
        NoJitter,
    )
    with Random = th.seeded(0) {
        // attempt 5: 1*10^4 = 10000s ≫ 30s, должен capped
        assert(policy.compute_delay(5) == 30.seconds())
    }
}

test "jitter детерминистичен через seeded Random" {
    ro policy = RetryPolicy.custom(3, Fixed { delay: 1.second() }, FullJitter)
    ro d1 = with Random = th.seeded(42) { policy.compute_delay(1) }
    ro d2 = with Random = th.seeded(42) { policy.compute_delay(1) }
    assert(d1 == d2)                               // тот же seed → тот же jitter
}

test "AI-first: тесты retry полностью детерминированы" {
    // Без mock-библиотек: just handler-substitution. Flag-idiom (см.
    // std/crypto/jwt_test.nv) вместо `interrupt None` + Option-sibling.
    ro policy = RetryPolicy.exponential(3)
    mut count = 0
    mut got = ""
    with Time = th.fixed_ms(0), Random = th.seeded(123),
                Fail[str] = |e| { got = "fail"; "" } {
        count += 1
        got = policy.execute(|| {
            count += 1
            if count < 4 { throw "fail" }
            "ok"
        })
        // Внутри policy.execute — count увеличивается на каждой попытке.
        // Assert INSIDE the with-block (not after) — a mutable var boxed
        // for a closure capture created inside a nested with-body isn't
        // readable once that block's scope closes (pre-existing compiler
        // gap, out of scope for this promotion wave — see
        // docs/plans/backlog-followups.md [M-exp-promotion-blockers: retry]).
        assert(count > 0)
    }
    // Тест воспроизводимый при любом запуске
    assert(got == "ok" || got == "fail")
}
