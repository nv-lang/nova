// stdlib/priority_queue.nv — binary min-heap.
//
// API:
//   PriorityQueue[T Ord].new() -> PriorityQueue[T]
//   pq.push(item T)
//   pq.pop() -> Option[T]      // min element
//   pq.peek() -> Option[T]
//   pq.len -> int
//   pq.is_empty() -> bool

module collections.priority_queue


/// Приоритетная очередь (binary min-heap). Всегда извлекает минимальный элемент.
///
/// Требует `T: Ord` — тип должен поддерживать оператор `<`.
/// `push` и `pop` работают за O(log n).
///
/// # Examples
///
/// ```nova
/// let mut pq = PriorityQueue[int].new()
/// pq.push(5)
/// pq.push(1)
/// pq.push(3)
/// assert(pq.pop() == Some(1))
/// assert(pq.pop() == Some(3))
/// ```
#stable(since = "0.1")
export type PriorityQueue[T Ord] {
    mut items []T              // internal: heap-ordered, _items[0] = min
}


/// Создать пустую `PriorityQueue`.
#stable(since = "0.1")
export fn PriorityQueue[T].new() -> Self =>
    { _items: [] }

/// Число элементов в очереди.
#stable(since = "0.1")
export fn PriorityQueue[T] @len() -> int => @items.len()

/// Возвращает `true` если очередь пуста.
#stable(since = "0.1")
export fn PriorityQueue[T] @is_empty() -> bool => @items.len() == 0


/// Посмотреть минимальный элемент без удаления.
#stable(since = "0.1")
export fn PriorityQueue[T] @peek() -> Option[T] {
    if @items.len() == 0 { None } else { Some(@items[0]) }
}


/// Добавить элемент в очередь. O(log n).
#stable(since = "0.1")
export fn PriorityQueue[T] mut @push(item T) -> () {
    @items.push(item)
    @sift_up(@items.len() - 1)
}


/// Удалить и вернуть минимальный элемент. O(log n). `None` если пусто.
#stable(since = "0.1")
export fn PriorityQueue[T] mut @pop() -> Option[T] {
    if @items.len() == 0 { return None }
    ro top = @items[0]
    ro last = @items.len() - 1
    if last > 0 {
        @items[0] = @items[last]
    }
    // Удаляем последний элемент (используем вспомогательный массив).
    mut new_items []T = []
    for i in 0..last {
        new_items.push(@items[i])
    }
    @items = new_items
    if @items.len() > 0 {
        @sift_down(0)
    }
    Some(top)
}


// ──────────────────────────────────────────────────────────────────────────
// Heap operations
// ──────────────────────────────────────────────────────────────────────────

fn PriorityQueue[T] mut @sift_up(idx int) -> () {
    mut i = idx
    while i > 0 {
        ro parent = (i - 1) / 2
        if @items[i] < @items[parent] {
            // swap
            ro tmp = @items[i]
            @items[i] = @items[parent]
            @items[parent] = tmp
            i = parent
        } else {
            return ()
        }
    }
}


fn PriorityQueue[T] mut @sift_down(idx int) -> () {
    mut i = idx
    ro n = @items.len()
    loop {
        ro left = 2 * i + 1
        ro right = 2 * i + 2
        mut smallest = i
        if left < n && @items[left] < @items[smallest] {
            smallest = left
        }
        if right < n && @items[right] < @items[smallest] {
            smallest = right
        }
        if smallest == i { return () }
        ro tmp = @items[i]
        @items[i] = @items[smallest]
        @items[smallest] = tmp
        i = smallest
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Тесты
// ──────────────────────────────────────────────────────────────────────────

test "empty queue" {
    ro pq = PriorityQueue[int].new()
    assert(pq.is_empty())
    assert(pq.peek() == None)
    // pop из пустой — None
    mut pq2 = pq
    assert(pq2.pop() == None)
}

test "push / pop порядок" {
    mut pq = PriorityQueue[int].new()
    pq.push(5)
    pq.push(1)
    pq.push(3)
    pq.push(8)
    pq.push(2)

    assert(pq.len() == 5)
    assert(pq.pop() == Some(1))
    assert(pq.pop() == Some(2))
    assert(pq.pop() == Some(3))
    assert(pq.pop() == Some(5))
    assert(pq.pop() == Some(8))
    assert(pq.pop() == None)
}

test "peek не удаляет" {
    mut pq = PriorityQueue[int].new()
    pq.push(5)
    pq.push(1)
    assert(pq.peek() == Some(1))
    assert(pq.peek() == Some(1))
    assert(pq.len() == 2)
}
