// stdlib_queue.nv — FIFO-очередь через два массива.
//
// Демонстрирует **composability** базовых контейнеров: Queue не имеет
// собственной структуры данных, она составлена из двух массивов
// ([stdlib_vec.nv](stdlib_vec.nv)) — `in` (вход) и `out` (выход).
//
// Алгоритм классический ("amortized O(1) queue из двух стеков"):
// push кладёт в `in`. pop забирает из `out`; если `out` пуст —
// разворачивает `in` в `out` (O(n) реверс, но амортизированно
// каждая операция O(1)).
//
// Без специальной поддержки циркулярного буфера, без unsafe — просто
// два массива и pattern-match на пустоту.

module collections.queue


// ──────────────────────────────────────────────────────────────────────────
// Тип
// ──────────────────────────────────────────────────────────────────────────

/// FIFO-очередь через два массива с O(1) amortized push/pop.
///
/// Алгоритм: `push` кладёт в inbox, `pop` берёт из outbox.
/// Когда outbox пуст — inbox переливается в outbox в обратном порядке (O(n), но O(1) amortized).
///
/// # Examples
///
/// ```nova
/// let mut q = Queue[int].new()
/// q.push(1)
/// q.push(2)
/// q.push(3)
/// assert(q.pop() == Some(1))
/// assert(q.pop() == Some(2))
/// ```
///
/// # See Also
///
/// - `[Deque]` — двусторонняя очередь
#stable(since = "0.1")
export type Queue[T] {
    mut inbox  []T   // internal: входная сторона FIFO
    mut outbox []T   // internal: выходная сторона FIFO (reversed in)
}


// ──────────────────────────────────────────────────────────────────────────
// Конструкторы
// ──────────────────────────────────────────────────────────────────────────

/// Создать пустую очередь.
#stable(since = "0.1")
export fn Queue[T].new() -> Self =>
    { _inbox: [], _outbox: [] }



// ──────────────────────────────────────────────────────────────────────────
// Базовые операции
// ──────────────────────────────────────────────────────────────────────────

/// Число элементов в очереди.
#stable(since = "0.1")
export fn Queue[T] @len() -> int =>
    @inbox.len() + @outbox.len()

/// Возвращает `true` если очередь пуста.
#stable(since = "0.1")
export fn Queue[T] @is_empty() -> bool =>
    @inbox.is_empty() && @outbox.is_empty()

// D117 AMEND accessor-pair (vec-sweep, 2026-07-06): 0-arg getter half of the
// `cap`/`cap(n)` property pair. Reports the inbox side's capacity (the two
// backing arrays are sized identically by `cap(n)` below).
#stable(since = "0.1")
export fn Queue[T] @cap() -> int => @inbox.cap()

/// Reserve capacity `n` on BOTH backing arrays (replacement for the removed
/// `Queue[T].with_capacity` static constructor: `Queue[T].new().cap(n)`).
#stable(since = "0.1")
export fn Queue[T] mut @cap(n int) -> @
    requires n >= 0
{
    @inbox.cap(n)
    @outbox.cap(n)
}


// ──────────────────────────────────────────────────────────────────────────
// FIFO-операции
// ──────────────────────────────────────────────────────────────────────────

/// Добавить элемент в конец очереди. O(1).
#stable(since = "0.1")
export fn Queue[T] mut @push(item T) -> () =>
    @inbox.push(item)

/// Извлечь элемент из начала очереди (FIFO). O(1) amortized.
///
/// # Examples
///
/// ```nova
/// let mut q = Queue[str].new()
/// q.push("first")
/// q.push("second")
/// assert(q.pop() == Some("first"))
/// ```
#stable(since = "0.1")
export fn Queue[T] mut @pop() -> Option[T] {
    if @outbox.is_empty() {
        // Перелить `in` в `out` в обратном порядке.
        loop {
            match @inbox.pop() {
                Some(x) => @outbox.push(x)
                None    => break
            }
        }
    }
    @outbox.pop()
}

/// Посмотреть первый элемент без удаления. `None` если пусто.
#stable(since = "0.1")
export fn Queue[T] @peek() -> Option[T] {
    if !@outbox.is_empty() {
        // Голова outbox — последний элемент (pop забирает с конца).
        @outbox.get(@outbox.len() - 1)
    } else if !@inbox.is_empty() {
        // Голова находится в `in[0]` (она «дальше всего» от выхода
        // тоже, но ещё не перелита).
        @inbox.get(0)
    } else {
        None
    }
}

/// Очистить очередь.
#stable(since = "0.1")
export fn Queue[T] mut @clear() -> () {
    @inbox.clear()
    @outbox.clear()
}


// ──────────────────────────────────────────────────────────────────────────
// Тесты
// ──────────────────────────────────────────────────────────────────────────

test "FIFO order" {
    mut q = Queue[int].new()
    q.push(1)
    q.push(2)
    q.push(3)
    assert(q.pop() == Some(1))
    assert(q.pop() == Some(2))
    assert(q.pop() == Some(3))
    assert(q.pop() == None)
}

test "interleaved push/pop" {
    mut q = Queue[int].new()
    q.push(1)
    q.push(2)
    assert(q.pop() == Some(1))
    q.push(3)
    q.push(4)
    assert(q.pop() == Some(2))
    assert(q.pop() == Some(3))
    q.push(5)
    assert(q.pop() == Some(4))
    assert(q.pop() == Some(5))
    assert(q.is_empty())
}

test "peek doesn't remove" {
    mut q = Queue[int].new()
    q.push(42)
    assert(q.peek() == Some(42))
    assert(q.peek() == Some(42))             // повторно — то же значение
    assert(q.len() == 1)
    assert(q.pop() == Some(42))
    assert(q.peek() == None)
}

test "empty queue" {
    mut q Queue[int] = Queue[int].new()
    assert(q.is_empty())
    assert(q.len() == 0)
    assert(q.pop() == None)
    assert(q.peek() == None)
}
