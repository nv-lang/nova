// std/crypto/bcrypt_test.nv — публичный контракт Bcrypt (hash/verify).
// Детерминизм через th.seeded (Random handler substitution).

module crypto.bcrypt_test

import std.crypto.bcrypt.{Bcrypt, BcryptError}
import std.testing.handlers as th

test "hash + verify round-trip" {
    ro h = with Random = th.seeded(42) {
        Bcrypt.hash("my-password", 4)!!        // cost=4 для скорости тестов
    }
    assert(Bcrypt.verify("my-password", h))
    assert(!Bcrypt.verify("wrong-password", h))
}

test "детерминизм через seeded Random (тестовый сценарий)" {
    ro h1 = with Random = th.seeded(42) { Bcrypt.hash("password", 4)!! }
    ro h2 = with Random = th.seeded(42) { Bcrypt.hash("password", 4)!! }
    // Тот же seed → тот же salt → тот же hash
    assert(h1 == h2)
}

test "разные salts → разные hashes" {
    ro h1 = with Random = th.seeded(1) { Bcrypt.hash("password", 4)!! }
    ro h2 = with Random = th.seeded(2) { Bcrypt.hash("password", 4)!! }
    assert(h1 != h2)
    // Но оба verify правильным паролем
    assert(Bcrypt.verify("password", h1))
    assert(Bcrypt.verify("password", h2))
}

test "формат hash правильный" {
    ro h = with Random = th.seeded(0) { Bcrypt.hash("test", 4)!! }
    assert(h.starts_with("$2b$04$"))
}

test "ошибка: cost вне диапазона" {
    ro r = with Random = th.seeded(0) { Bcrypt.hash("x", 1) }
    match r {
        Ok(_)  => assert(false)
        Err(e) => assert(e is InvalidCost)
    }
}

test "ошибка: пароль > 72 байта" {
    // [M-c-keyword-ident-collision]: `long` — зарезервированное C-слово,
    // ломает codegen как имя переменной — используем доменное имя `long_pw`.
    mut long_pw = ""
    for i in 0..100 { long_pw = long_pw + "a" }
    ro r = with Random = th.seeded(0) { Bcrypt.hash(long_pw, 4) }
    match r {
        Ok(_)  => assert(false)
        Err(e) => assert(e is PasswordTooLong)
    }
}

test "verify: malformed hash → false (не throws)" {
    assert(!Bcrypt.verify("password", "not-a-bcrypt-hash"))
    assert(!Bcrypt.verify("password", "$2b$10$short"))
    assert(!Bcrypt.verify("password", ""))
}
