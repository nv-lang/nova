// stdlib/bcrypt.nv — password hashing (bcrypt).
//
// Bcrypt by Niels Provos and David Mazières (1999). Базируется на
// Blowfish cipher с настраиваемым cost factor (work factor).
//
// Лицензия: BSD (OpenBSD origin), независимая реализация по public spec.
//
// ⚠️ Этот файл — **демонстрация API и интерфейсов**, не production-grade
// crypto. Полная Blowfish encryption + EksBlowfishSetup требует ~600+ LOC
// и тщательной верификации. В bootstrap-stdlib используем упрощённую
// сигнатуру через PBKDF2-style key stretching на sha256.
//
// Production-Nova должна включить argon2 (current best practice 2026)
// или libsodium bindings.
//
// API:
//   Bcrypt.hash(password str, cost int) Random -> str
//   Bcrypt.verify(password str, hash str) -> bool
//
// Use case: безопасное хранение паролей в БД.
//
// ВАЖНО: НЕ использовать sha256/md5 напрямую для паролей — они слишком
// быстрые, GPU-attackable. Bcrypt намеренно медленный (cost 10 ≈ 100ms
// на современном CPU) — экспоненциально замедляет brute-force.

module crypto.bcrypt

import std.crypto.sha256.{Sha256}


/// Errors при bcrypt операциях.
#stable(since = "0.1")
export type BcryptError enum
    | InvalidCost { value int }
    | InvalidHash { reason str }
    | PasswordTooLong { length int, max int }


// Cost factor: 2^cost rounds. 10 = 1024 rounds (default), безопасно
// в 2026; 12+ для критичных систем. Минимум 4, максимум 31.
const MIN_COST int = 4
const MAX_COST int = 31
const DEFAULT_COST int = 10
const MAX_PASSWORD_LEN int = 72        // bcrypt лимит


// Hash формат: $2b$<cost>$<22-char-salt><31-char-hash>
//   "$2b$10$abc...xyz"
//   2b — bcrypt версия (2a/2b/2y — разные историчические варианты)
//   10 — cost (2^10 = 1024 rounds)
//   22 chars salt в bcrypt-base64
//   31 chars hash output в bcrypt-base64

const SALT_LEN int = 16          // 16 random bytes → 22 base64 chars


// ──────────────────────────────────────────────────────────────────────────
// Public API
// ──────────────────────────────────────────────────────────────────────────

/// Hash password с cost factor (2^cost rounds, 10 = 1024 rounds default).
/// Format `$2b$<cost>$<salt><hash>`. Random effect — для salt.
///
/// # Examples
/// ```nova
/// with Random = th.seeded(42) {
///     let h = Bcrypt.hash("secret", 10)!!
/// }
/// ```
#stable(since = "0.1")
export fn Bcrypt.hash(password str, cost int) Random -> Result[str, BcryptError] {
    if cost < MIN_COST || cost > MAX_COST {
        return Err(InvalidCost { value: cost })
    }
    if password.bytes().len() > MAX_PASSWORD_LEN {
        return Err(PasswordTooLong { length: password.bytes().len(), max: MAX_PASSWORD_LEN })
    }

    ro salt = Random.bytes(SALT_LEN)
    ro hashed = bcrypt_kdf(password.bytes(), salt, cost)

    // Format: $2b$<cost>$<salt><hash>
    ro cost_str = if cost < 10 { "0" + str.from(cost) } else { str.from(cost) }
    Ok("$2b$" + cost_str + "$" + bcrypt_base64_encode(salt) + bcrypt_base64_encode(hashed))
}


/// Verify password против bcrypt hash. **Constant-time** для security.
/// Returns `false` на любой malformed input (нет throw).
#stable(since = "0.1")
export fn Bcrypt.verify(password str, hash_str str) -> bool {
    // Parse format
    ro parts = hash_str.split("$")
    // ["", "2b", "<cost>", "<salt><hash>"]
    if parts.len() != 4 { return false }
    if parts[1] != "2b" && parts[1] != "2a" && parts[1] != "2y" { return false }

    ro cost = match int.try_from(parts[2]) {
        Ok(c) if c >= MIN_COST && c <= MAX_COST => c
        _                                        => return false
    }

    ro combined = parts[3]
    if combined.len() < 53 { return false }    // 22 salt + 31 hash
    ro salt_b64 = combined[0..22]
    ro hash_b64 = combined[22..]

    ro salt = match bcrypt_base64_decode(salt_b64) {
        Some(b) if b.len() == SALT_LEN => b
        _                             => return false
    }
    ro expected_hash = match bcrypt_base64_decode(hash_b64) {
        Some(h) => h
        None    => return false
    }

    ro computed = bcrypt_kdf(password.bytes(), salt, cost)
    constant_time_eq(computed, expected_hash)
}


// ──────────────────────────────────────────────────────────────────────────
// Internal — упрощённая KDF (placeholder для реальной EksBlowfishSetup)
// ──────────────────────────────────────────────────────────────────────────
//
// Production Nova должна включать настоящий Blowfish (~600 LOC) или
// argon2 (newer, рекомендуется OWASP). Здесь — PBKDF2-style stretching
// через SHA-256 для демонстрации API.

fn bcrypt_kdf(password []u8, salt []u8, cost int) -> []u8 {
    ro rounds = 1 << cost          // 2^cost
    mut state = Sha256.new()
    state.update(salt)
    state.update(password)
    mut digest = state.finalize()
    mut bytes []u8 = []
    for i in 0..32 { bytes.push(digest[i]) }

    // Iterate `rounds` times — экспоненциальная стоимость по cost.
    for k in 0..rounds {
        mut s = Sha256.new()
        s.update(bytes)
        s.update(salt)
        ro d = s.finalize()
        mut new_bytes []u8 = []
        for j in 0..32 { new_bytes.push(d[j]) }
        bytes = new_bytes
    }
    // Берём первые 23 байта (как bcrypt — 184 бита output)
    mut out []u8 = []
    for p in 0..23 { out.push(bytes[p]) }
    out
}


fn constant_time_eq(a []u8, b []u8) -> bool {
    if a.len() != b.len() { return false }
    mut diff = 0
    for i in 0..a.len() {
        diff = diff | ((a[i] as int) ^ (b[i] as int))
    }
    diff == 0
}


// ──────────────────────────────────────────────────────────────────────────
// Bcrypt-specific Base64 (alphabet отличается от standard)
// ──────────────────────────────────────────────────────────────────────────
//
// Bcrypt использует свой alphabet:
//   "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
//
// Без padding, group по 3 bytes → 4 chars.

const BCRYPT_ALPHABET str = "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"


fn bcrypt_base64_encode(data []u8) -> str {
    consume buf = StringBuilder.new().cap(data.len() * 4 / 3 + 4)
    mut i = 0
    while i + 2 < data.len() {
        ro b0 = data[i] as u32
        ro b1 = data[i + 1] as u32
        ro b2 = data[i + 2] as u32
        ro triple = (b0 << 16) | (b1 << 8) | b2
        buf.append(alphabet_char(((triple >> 18) & 0x3F) as int))
        buf.append(alphabet_char(((triple >> 12) & 0x3F) as int))
        buf.append(alphabet_char(((triple >> 6) & 0x3F) as int))
        buf.append(alphabet_char((triple & 0x3F) as int))
        i += 3
    }
    ro remaining = data.len() - i
    if remaining == 1 {
        ro b0 = data[i] as u32
        buf.append(alphabet_char(((b0 >> 2) & 0x3F) as int))
        buf.append(alphabet_char(((b0 << 4) & 0x3F) as int))
    } else if remaining == 2 {
        ro b0 = data[i] as u32
        ro b1 = data[i + 1] as u32
        buf.append(alphabet_char(((b0 >> 2) & 0x3F) as int))
        buf.append(alphabet_char((((b0 << 4) | (b1 >> 4)) & 0x3F) as int))
        buf.append(alphabet_char(((b1 << 2) & 0x3F) as int))
    }
    buf.into_str()
}


// BCRYPT_ALPHABET (64 ASCII chars) — прямой byte-доступ O(1) вместо
// ретрактированного `chars().nth(idx)` O(n) скана (D260-амендмент).
// `int as char` запрещён (D54) → `char.from` (precedent: std/encoding/json.nv
// Lexer `@peek()`/`@advance()`).
fn alphabet_char(idx int) -> char {
    // [M-module-const-chars-bytes-resolution] РЕШЕНО (Plan 172.13): `.bytes()`
    // теперь резолвится корректно как instance-метод и напрямую на
    // module-level const — обход через локальную ro-копию больше не нужен.
    match BCRYPT_ALPHABET.bytes().get(idx) {
        Some(b) => (b as int).to_char() ?? '.'
        None    => '.'
    }
}

// bcrypt hash text — pure ASCII (bcrypt's own base64 alphabet) — byte access
// вместо ретрактированного `chars().nth(i)` O(n) скана per-call (D260-амендмент,
// [M-d73-d77-retraction-migration] Block 4). `bcrypt_decode_char` keeps its
// `Option[char]` signature (unchanged, still does its own small O(64) linear
// alphabet-index scan below) — only the byte→char reconstruction at the call
// site becomes O(1).
fn bcrypt_base64_decode(s str) -> Option[[]u8] {
    mut out []u8 = []
    ro sb = s.bytes()
    mut i = 0
    while i + 3 < s.byte_len() {
        // [M-match-tuple-option-value-deref] РЕШЕНО (Plan 172.13): tuple-match
        // над 4×Option[u32] теперь резолвится корректно (dot-accessor на
        // value-embedded NovaOpt_uint32_t) — вернулся естественный tuple-match
        // вместо последовательного `?`-unwrap обхода.
        match (bcrypt_decode_char(byte_to_char(sb, i)),
               bcrypt_decode_char(byte_to_char(sb, i + 1)),
               bcrypt_decode_char(byte_to_char(sb, i + 2)),
               bcrypt_decode_char(byte_to_char(sb, i + 3))) {
            (Some(a), Some(b), Some(c), Some(d)) => {
                ro triple = (a << 18) | (b << 12) | (c << 6) | d
                out.push(((triple >> 16) & 0xFF) as u8)
                out.push(((triple >> 8) & 0xFF) as u8)
                out.push((triple & 0xFF) as u8)
            }
            _ => return None
        }
        i += 4
    }
    // Trailing (тот же обход — последовательный `?` вместо tuple-match).
    //
    // BUGFIX: оригинал покрывал ТОЛЬКО «2 leftover chars → 1 byte» (salt,
    // 22 chars = 5 групп по 4 + 2 leftover) и молча ТЕРЯЛ 3-й leftover-char
    // для «3 leftover chars → 2 bytes» (hash, 31 char = 7 групп по 4 +
    // 3 leftover) — round-trip `Bcrypt.hash`+`Bcrypt.verify` ломался именно
    // на hash-порции (кусок теряемого байта менял decoded digest). Оба
    // leftover-случая — зеркало `bcrypt_base64_encode`'s remaining==1/==2
    // (байты→chars), здесь remaining chars→bytes: 2 chars→1 byte,
    // 3 chars→2 bytes (стандартная base64 4-to-3 обратная формула).
    ro remaining = s.byte_len() - i
    if remaining == 2 {
        ro a = bcrypt_decode_char(byte_to_char(sb, i))?
        ro b = bcrypt_decode_char(byte_to_char(sb, i + 1))?
        out.push(((a << 2) | (b >> 4)) as u8)
    } else if remaining == 3 {
        ro a = bcrypt_decode_char(byte_to_char(sb, i))?
        ro b = bcrypt_decode_char(byte_to_char(sb, i + 1))?
        ro c = bcrypt_decode_char(byte_to_char(sb, i + 2))?
        out.push(((a << 2) | (b >> 4)) as u8)
        out.push((((b << 4) | (c >> 2)) & 0xFF) as u8)
    }
    Some(out)
}

// Байты 0..255 всегда валидные Unicode scalar values (Latin-1 подмножество) —
// `char.from` (Result, D325) для них никогда не возвращает `Err`; `.ok()`
// (R4) даёт канонический Result→Option. `bytes.get(i)` даёт out-of-bounds `None`.
fn byte_to_char(bytes []u8, i int) -> Option[char] {
    match bytes.get(i) {
        Some(b) => (b as int).to_char().ok()
        None    => None
    }
}


fn bcrypt_decode_char(c Option[char]) -> Option[u32] {
    match c {
        None => None
        Some(ch) => {
            // [M-module-const-chars-bytes-resolution] РЕШЕНО (Plan 172.13):
            // `.chars()` теперь резолвится напрямую на module-level `const
            // BCRYPT_ALPHABET` как instance-метод — обход через локальную
            // ro-копию больше не нужен.
            mut idx = 0
            for ach in BCRYPT_ALPHABET.chars() {
                if ach == ch { return Some(idx) }
                idx += 1
            }
            None
        }
    }
}

