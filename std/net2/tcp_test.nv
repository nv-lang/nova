// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 183 Ф.1 — TCP loopback echo on the NEW net2 C substrate (D407).
//
// This is the exact two-fiber live-socket scenario that deterministically
// segfaulted on the old net.c layer ([M-178-servernet-live-net-substrate-
// segfault]): the old layer hands read results through __thread slots, and
// fibers migrating between OS threads under M:N work-stealing read the wrong
// thread's slot.
//
// The net2 layer has NO static result slots: read writes the network bytes
// straight into the caller's []u8 buffer (alloc_cb = slice of that very
// buffer — zero-copy), write sends straight from the caller's bytes, results
// travel in the parked fiber's own handle struct guarded by per-op completion
// latches (lost-wake-free park_until discipline — see net2.c header).
//
// Calls go directly to the module-private extern "C" surface (ffi.nv); the
// public value-typed API over it arrives with Plan 183 Ф.2.
//
// Pattern: listener created OUTSIDE supervised (bind does not park); ALL
// parking ops (accept/connect/read/write) in spawn fibers — the supervised
// body runs at slot=-1 and must not park.

module std.net2

test "net2: loopback echo round-trip, two fibers, zero static slots" {
    ro addr0 = unsafe { nova_net_addr_loopback(0) }
    ro lst = unsafe { nova_net_tcp_listen(addr0, 128, 0 as *()) }
    assert(!((0 as *()) == lst))
    ro port = unsafe { nova_net_listener_local_port(lst) }
    assert(port > 0)

    supervised {
        // Client fiber: connect, write, read echo reply from OUR OWN buffer.
        spawn {
            ro caddr = unsafe { nova_net_addr_loopback(port) }
            ro conn = unsafe { nova_net_tcp_connect(caddr, 0 as *()) }
            assert(!((0 as *()) == conn))

            ro msg = "hello net2"
            ro wn = unsafe { nova_net_tcp_write(conn, msg.as_ptr(), msg.byte_len()) }
            assert(wn == 10)

            mut buf []u8 = []u8.new()
            buf.resize(64, 0 as u8)
            ro rn = unsafe { nova_net_tcp_read(conn, buf.as_ptr(), 64) }
            assert(rn == 16)
            ro reply = str.from_bytes_unchecked(buf[0..rn])
            assert(reply == "echo: hello net2")

            unsafe { nova_net_tcp_close(conn) }
        }

        // Server fiber: accept, read client's bytes into OUR buffer, echo back.
        spawn {
            ro srv = unsafe { nova_net_tcp_accept(lst, 0 as *()) }
            assert(!((0 as *()) == srv))

            mut buf []u8 = []u8.new()
            buf.resize(64, 0 as u8)
            ro rn = unsafe { nova_net_tcp_read(srv, buf.as_ptr(), 64) }
            assert(rn == 10)
            ro msg = str.from_bytes_unchecked(buf[0..rn])
            assert(msg == "hello net2")

            ro reply = "echo: " + msg
            ro wn = unsafe { nova_net_tcp_write(srv, reply.as_ptr(), reply.byte_len()) }
            assert(wn == 16)

            unsafe { nova_net_tcp_close(srv) }
        }
    }

    unsafe { nova_net_listener_close(lst) }
}

test "net2: read returns 0 on clean EOF (peer close)" {
    ro addr0 = unsafe { nova_net_addr_loopback(0) }
    ro lst = unsafe { nova_net_tcp_listen(addr0, 128, 0 as *()) }
    assert(!((0 as *()) == lst))
    ro port = unsafe { nova_net_listener_local_port(lst) }

    supervised {
        // Client: connect and immediately close (clean FIN).
        spawn {
            ro caddr = unsafe { nova_net_addr_loopback(port) }
            ro conn = unsafe { nova_net_tcp_connect(caddr, 0 as *()) }
            assert(!((0 as *()) == conn))
            unsafe { nova_net_tcp_close(conn) }
        }

        // Server: accept, read → must observe EOF as 0 (not garbage, not hang).
        spawn {
            ro srv = unsafe { nova_net_tcp_accept(lst, 0 as *()) }
            assert(!((0 as *()) == srv))
            mut buf []u8 = []u8.new()
            buf.resize(16, 0 as u8)
            ro rn = unsafe { nova_net_tcp_read(srv, buf.as_ptr(), 16) }
            assert(rn == 0)
            unsafe { nova_net_tcp_close(srv) }
        }
    }

    unsafe { nova_net_listener_close(lst) }
}
