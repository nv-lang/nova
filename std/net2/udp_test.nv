// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 183 Ф.2 — UDP over the public net2 API. recv_from writes the datagram
// straight into the caller's []u8 (zero-copy) and returns the sender as a value
// SocketAddr filled via out-param (no _net_recv_data / _net_recv_sender TLS).
// `_must` (typed-Result extractor) is shared from tcp_test.nv (same module).
//
// Sockets are closed AFTER the supervised block (not inside the spawn, right on
// the heels of recv/send) so a pending overlapped request has fully drained
// before uv_close — closing mid-flight trips a libuv-Windows req assertion.

module std.net2

test "net2/udp: loopback datagram + value-SocketAddr sender via out-param" {
    with Net = real_net() {
        mut a = _must(UdpSocket.bind(SocketAddr.loopback(0)))
        mut b = _must(UdpSocket.bind(SocketAddr.loopback(0)))
        ro a_port = a.local_port()
        ro b_port = b.local_port()
        assert(a_port > 0)
        assert(b_port > 0)

        supervised {
            spawn {
                mut buf []u8 = []u8.new()
                buf.resize(64, 0 as u8)
                // Tuple carrying a value SocketAddr → direct match (see dns_test.nv).
                match a.recv_from(buf) {
                    Ok((n, sender)) => {
                        assert(n == 9)
                        assert(str.from_bytes_unchecked(buf[0..n]) == "ping net2")
                        // The out-param sender must carry b's real port.
                        assert(sender.port() == b_port)
                        assert(sender.is_v4())
                    }
                    Err(_) => assert(false)
                }
            }
            spawn {
                assert(_must(b.send_to("ping net2".as_bytes(), SocketAddr.loopback(a_port))) == 9)
            }
        }

        a.close()
        b.close()
    }
}

test "net2/udp: recv_from_vec returns owned bytes + sender" {
    with Net = real_net() {
        mut a = _must(UdpSocket.bind(SocketAddr.loopback(0)))
        mut b = _must(UdpSocket.bind(SocketAddr.loopback(0)))
        ro a_port = a.local_port()

        supervised {
            spawn {
                match a.recv_from_vec(64) {
                    Ok((data, sender)) => {
                        assert(data.len() == 5)
                        assert(str.from_bytes_unchecked(data) == "hello")
                        assert(sender.port() > 0)
                    }
                    Err(_) => assert(false)
                }
            }
            spawn {
                assert(_must(b.send_str("hello", SocketAddr.loopback(a_port))) == 5)
            }
        }

        a.close()
        b.close()
    }
}
