// Plan 183 Ф.2 — value SocketAddr: pure construction / inspection / formatting
// (no effect, no I/O). Pins the value-record rep ([M-net-socketaddr-value-record]).

module std.net2

test "net2/addr: v4 construction, inspection, formatting" {
    ro a = SocketAddr.v4(192, 168, 1, 1, 8080)
    assert(a.is_v4())
    assert(!a.is_v6())
    assert(a.port() == 8080)
    assert(a.ip() == "192.168.1.1")
    assert(a.to_str() == "192.168.1.1:8080")
}

test "net2/addr: loopback v4 / v6" {
    ro lo = SocketAddr.loopback(0)
    assert(lo.is_v4())
    assert(lo.port() == 0)
    assert(lo.ip() == "127.0.0.1")

    ro v6 = SocketAddr.loopback_v6(443)
    assert(v6.is_v6())
    assert(v6.port() == 443)
    assert(v6.to_str() == "[::1]:443")
}

test "net2/addr: value semantics — a copy is independent data" {
    ro a = SocketAddr.v4(10, 0, 0, 5, 25)
    ro b = a
    assert(b.port() == 25)
    assert(b.ip() == "10.0.0.5")
    assert(a.port() == 25)
}

test "net2/addr: from_str rejects out-of-range port" {
    match SocketAddr.from_str("127.0.0.1:70000") {
        Ok(_)  => assert(false)
        Err(e) => assert(e.to_str().contains("invalid port"))
    }
}

test "net2/addr: from_str parses a v6 literal" {
    ro a = _must(SocketAddr.from_str("[::1]:8443"))
    assert(a.is_v6())
    assert(a.port() == 8443)
}
