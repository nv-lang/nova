// std.collections.vec (slice) — zero-copy sub-range views, `Index[Range]`.
//
// `v[a..b]` returns a view of the SAME type `[]T` ≡ `Vec[T]` (Plan 96
// D-single-type — NOT a separate `Slice` type) sharing the parent buffer
// (interior pointer at `data + start`, `cap == len`). The GC keeps the parent
// buffer alive while the view is reachable (`GC_all_interior_pointers`, Plan
// 138 Ф.2). A subsequent reallocating mutation on the view (`push` at
// `cap == len`) detaches it into a fresh buffer, so it never mutates the parent
// (Go-model detach, GC-safe).
//
// `slice()` (a copying view whose name lied) was REMOVED in Plan 138.1; an
// owning copy is `clone()`. Plan 153.4 adds split_at/chunks/windows on this
// same view model.
#prelude(core, runtime, collections, protocols)
module collections.vec

import std.collections.range.{Range}

// ──────────────────────────────────────────────────────────────────────────
// Range views (zero-copy slices) — `Index[Range]`
// ──────────────────────────────────────────────────────────────────────────

/// Zero-copy sub-range view — the slice `[r.start, r.end)` over the same
/// backing buffer. Powers `v[a..b]` once range-slice dispatch routes here.
///
/// Panics on out-of-bounds (`start < 0`, `end < start`, or `end > len`).
///
/// NOTE (wiring deferred — [M-172.14-vrange-nv-route], PARTIAL 2026-07-10):
/// `v[a..b]` is currently intercepted by codegen range-slice magic (emit_c.rs
/// `ExprKind::Index` + `Range`) which builds the identical view struct inline
/// and never dispatches to this method. The method is present (and overloads
/// with `@index(i int)`) so the `Index[Range, Vec[T]]` contract is satisfied as
/// a real Nova body.
///
/// Full routing through this body is BLOCKED on an owner language-semantics
/// decision (D-amendment), NOT mechanical work — three concrete blockers:
///   (1) this method's bounds-check is a `requires` precondition → elided under
///       `--contracts=off`, whereas `nova_vec_slice_chk` (array.h) panics
///       always-on regardless of contract policy → routing weakens slice
///       bounds-safety under contracts=off;
///   (2) the OOB panic message differs (`nova_contract_violation` vs the pinned
///       `Vec: slice … out of bounds` — nova_tests/plan96/neg_slice_*), a
///       byte-parity break;
///   (3) codegen's verifier-proven `_nochk` elision (hot-loop slices) is lost —
///       this body always checks.
/// The perf goal (0-alloc view descriptor placement) is ALREADY met via the
/// sret `_out` mechanism (view_descriptor_stack.nv, δ alloc=0). See
/// docs/plans/172.14-value-abi-perf-placement.md § [M-172.14-vrange-nv-route].
export fn Vec[T] @index(r Range) -> Self
    requires r.start >= 0 && r.end >= r.start && r.end <= @len
{
    ro n = r.end - r.start
    Self { data: unsafe { @data.offset(r.start) }, len: n, cap: n }
}

/// Safe zero-copy sub-range view — `Some(view)` when `[r.start, r.end)` is in
/// bounds, `None` otherwise. The non-panicking counterpart of `@index(Range)`.
export fn Vec[T] @get(r Range) -> Option[Self] {
    if r.start < 0 || r.end < r.start || r.end > @len {
        return None
    }
    ro n = r.end - r.start
    Some(Self { data: unsafe { @data.offset(r.start) }, len: n, cap: n })
}
