// ENV NOVA_MAXPROCS=1
// ENV NOVA_AUTOARM=0
// std/testing/handlers.nv — детерминированные handler-фабрики для
// `Random` и `Time` эффектов. Главный инструмент для тестов, которые
// зависят от случайности или времени.
//
// `mut_clock` (ниже) — STATEFUL handler (мутирует захваченный
// `current_ms`, Plan 175 auto-idle-advance добавляет non-atomic
// per-scope registry, nova_rt/fibers.h `NovaVClockEntry`) — под
// конкурентным M:N (>1 worker-поток) это гонка данных (docs/time.md
// "M:N-контракт"). `NOVA_MAXPROCS=1` форсирует single-thread для ВСЕГО
// файла — тесты этого модуля намеренно однопоточны относительно
// mut_clock (нет реальной M:N-нагрузки поверх одного handler'а).
//
// `NOVA_AUTOARM=0` (Plan 175, owner TODO closure, 2026-07-10,
// `[M-175-vclock-armed-mn-scope-identity]`): auto-idle-advance
// (`nova_vclock_park_until`, nova_rt/fibers.h) anchors its per-scope
// registry on `_nova_active_scope` as read from INSIDE the fiber body.
// Under the DEFAULT armed M:N runtime (auto-armed on the first `spawn`),
// that TLS var is the WORKER's own private home scope
// (`_worker_run_one_fiber`: `_nova_active_scope = &w->scope`) — NOT the
// shared parent `supervised{}` scope object — so siblings spawned
// together do NOT reliably share one registry (each may see only
// itself as "alive", firing immediately in spawn order rather than
// waiting for the deadline order). `NOVA_AUTOARM=0` routes `spawn`
// through the cooperative/local path (`nova_fiber_spawn_into` —
// `_nova_active_scope` stays the real shared scope for the whole
// drain), where the deadline-order guarantee holds. Under the default
// armed path the mechanism still degrades SAFELY (no hang/crash — each
// virtual sleep still resolves, just without the ordering guarantee);
// fixing the general M:N case needs a different anchor (e.g. resolving
// back through `NovaSpawnCtxBase._nova_parent_scope`) — out of scope
// for this pass, tracked by the marker above.
// AI-first идея: вместо mock-библиотек и monkey-patching — handler
// substitution через `with` (D11/D61). Та же функция `Bcrypt.hash` в
// production видит CSPRNG, в тестах — детерминированный PRNG, без
// какого-либо изменения сигнатуры.
//
// API:
//
//   // PRNG с фиксированным seed — xoshiro256++ quality.
//   fn seeded(seed u64) -> Effect[Random]
//
//   // Time зафиксирован на одном моменте; sleep — no-op.
//   fn fixed_ms(ms u64) -> Effect[Time]
//
//   // Mutable test clock: sleep(d) продвигает время на d.
//   // Полезно для rate_limiter/retry/cron тестов где нужно advance.
//   fn mut_clock(start_ms u64) -> Effect[Time]
//
// Использование:
//
//   import std.testing.handlers as th
//
//   test "uuid v4 детерминирован под seeded" {
//       let u1 = with Random = th.seeded(42) { Uuid.v4() }
//       let u2 = with Random = th.seeded(42) { Uuid.v4() }
//       assert(u1 == u2)
//   }
//
//   test "rate_limiter: refill после 1s" {
//       with Time = th.mut_clock(0), Random = th.seeded(7) {
//           let bucket = TokenBucket.new(10, 1.0)
//           bucket.try_acquire()         // 9 tokens left
//           Time.sleep(1.second())       // virtual clock advance
//           bucket.try_acquire()         // refilled to 10, теперь 9
//       }
//   }
//
// Composability:
//   with Random = th.seeded(42), Time = th.fixed_ms(0) { ... }
//
// PRNG: xoshiro256++ by Sebastiano Vigna (public domain, CC0).
//   https://prng.di.unimi.it/xoshiro256plusplus.c
// State init: splitmix64 для расширения 64-bit seed → 4×u64 state.
//   https://prng.di.unimi.it/splitmix64.c
//
// Не для production: `seeded` — НЕ криптографически стойкий.
// Для production используется встроенный `Random` handler (CSPRNG via
// runtime), который и активен по-умолчанию. См. spec/open-questions.md
// → `secure()` будущая фабрика для CSPRNG.

module testing.handlers

import std.runtime.vclock

// Random — effect-тип для PRNG. [M-random-u64-path-return-ice]
// (Plan 172.13 батч 3): декларация ПЕРЕЕХАЛА в std/prelude/effects.nv —
// Random используется как ambient-эффект модулями, которые НЕ импортируют
// testing.handlers (identifiers/uuid, identifiers/ulid, concurrency/retry);
// когда декларация жила здесь, такой CU не имел effect_schemas["Random"]
// и codegen падал ICE «Path call return type unknown» на `Random.u64()`.
// Здесь остаются только handler-фабрики (`seeded`).


// ──────────────────────────────────────────────────────────────────────────
// Random — xoshiro256++ handler-фабрика
// ──────────────────────────────────────────────────────────────────────────
//
// xoshiro256++ — современный PRNG с отличной statistical quality
// (passes BigCrush и PractRand), периодом 2^256 - 1 и быстрой
// генерацией (≈ 1.36ns/operation на современных x86).
//
// State — 4×u64 = 256 bits. Init через splitmix64: 64-bit seed
// расширяется до 4 хороших начальных u64 без correlation между ними.
//
// Алгоритм:
//   result = rotl(s[0] + s[3], 23) + s[0]
//   t = s[1] << 17
//   s[2] ^= s[0]
//   s[3] ^= s[1]
//   s[1] ^= s[2]
//   s[0] ^= s[3]
//   s[2] ^= t
//   s[3] = rotl(s[3], 45)
//   return result

// splitmix64 для seed init — гарантирует non-zero state даже при seed=0.
// Note: `mut`-параметр не поддержан парсером (Plan 34 Ф.2), поэтому
// явная локальная mut переменная.
fn splitmix64_step(seed u64) -> u64 {
    mut z = seed + 0x9E3779B97F4A7C15
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB
    z ^ (z >> 31)
}

fn rotl64(x u64, k int) -> u64 =>
    (x << k) | (x >> (64 - k))


/// xoshiro256++ Random handler, детерминированный по `seed`. Same seed → same sequence.
/// Works for seed=0 (splitmix64 гарантирует non-zero state).
///
/// # Examples
/// ```nova
/// with Random = th.seeded(42) {
///     let u = Uuid.v4()  // deterministic
/// }
/// ```
#stable(since = "0.1")
export fn seeded(seed u64) -> Effect[Random] {
    // Расширяем 64-bit seed → 4×u64 state через splitmix64.
    mut z = seed
    z = splitmix64_step(z); mut s0 = z
    z = splitmix64_step(z); mut s1 = z
    z = splitmix64_step(z); mut s2 = z
    z = splitmix64_step(z); mut s3 = z

    // Cached extra bytes из последнего u64() — для bytes(n) perf.
    mut buf_remaining = 0
    mut buf u64 = 0

    effect Random {
        u64() {
            // xoshiro256++ step.
            ro result = rotl64(s0 + s3, 23) + s0
            ro t = s1 << 17
            s2 = s2 ^ s0
            s3 = s3 ^ s1
            s1 = s1 ^ s2
            s0 = s0 ^ s3
            s2 = s2 ^ t
            s3 = rotl64(s3, 45)
            // Invalidate u8 cache — следующий bytes() возьмёт fresh state.
            buf_remaining = 0
            return result
        }
        bytes(n) {
            // Production: 8 байт за один advance state.
            mut out []u8 = []
            mut i = 0
            while i < n {
                if buf_remaining == 0 {
                    // Direct xoshiro256++ step (inlined, без invalidate).
                    ro result = rotl64(s0 + s3, 23) + s0
                    ro t = s1 << 17
                    s2 = s2 ^ s0
                    s3 = s3 ^ s1
                    s1 = s1 ^ s2
                    s0 = s0 ^ s3
                    s2 = s2 ^ t
                    s3 = rotl64(s3, 45)
                    buf = result
                    buf_remaining = 8
                }
                out.push((buf & 0xFF) as u8)
                buf = buf >> 8
                buf_remaining = buf_remaining - 1
                i = i + 1
            }
            out
        }
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Time — handler-фабрики
// ──────────────────────────────────────────────────────────────────────────


/// `Time` handler с fixed timestamp. `sleep(d)` — no-op. Для тестов где
/// продвижение времени не нужно (uuid v7, jwt exp checks).
#stable(since = "0.1")
export fn fixed_ms(ms u64) -> Effect[Time] {
    effect Time {
        // Plan 175 Ф.1b/Ф.4: int-провод — `now_unix_ms()` отдаёт int ms
        // (wire); Nova-сторона оборачивает в `Timestamp` через
        // `Timestamp.now()`-сахар.
        now_unix_ms() => ms as int
        // Plan 175 Ф.3/Ф.5(b) (D316): `now_monotonic_ns()` — мок monotonic
        // часов, когерентный с wall (та же `ms`, в ns). Nova-сторона
        // оборачивает в `Monotonic` через `Monotonic.now()`-сахар — теперь
        // мокабельно (closes [M-monotonic-mock-support]).
        now_monotonic_ns() => (ms * 1_000_000) as int
        // Plan 175.1 (D316 amend + D321, 2026-07-10): mock-coherence с
        // now_unix_ms/now_monotonic_ns выше — фиксированные часы означают
        // фиксированную (UTC) зону, детерминизм важнее реалистичности.
        // closes [M-175.1-local-offset-effect-op] slot-coherence.
        local_offset_sec() => 0
        sleep(d) => ()
    }
}


/// `Time` handler с virtual mutable clock. `sleep(d)` продвигает время на d (no real wait).
/// Для rate_limiter/retry/cron тестов — точная имитация прошедшего времени.
///
/// Sub-ms durations округляются floor.
#stable(since = "0.1")
export fn mut_clock(start_ms u64) -> Effect[Time] {
    mut current_ms = start_ms
    effect Time {
        // Plan 175 Ф.1b/Ф.4: int-провод — `now_unix_ms()` отдаёт int ms (wire).
        now_unix_ms() => current_ms as int
        // Plan 175 Ф.3/Ф.5(b) (D316) — mock-coherence (Ред. 2 / Swift TestClock-
        // паритет): ОДИН handler двигает И wall (`now_unix_ms`), И monotonic
        // (`now_monotonic_ns`) когерентно — оба читают ИЗ ОДНОГО `current_ms`.
        // `advance`/`sleep` сдвигает оба чтения на одинаковую дельту.
        now_monotonic_ns() => (current_ms * 1_000_000) as int
        // Plan 175.1 (D316 amend + D321, 2026-07-10): mock-coherence,
        // фиксированная (UTC) зона — closes [M-175.1-local-offset-effect-op]
        // slot-coherence (симметрично fixed_ms выше).
        local_offset_sec() => 0
        // int-провод: `sleep(ms int)` — аргумент миллисекунды (schema
        // `sleep(ms int)`). Value-`Duration` НЕ пересекает границу эффекта
        // (mock оперирует int ms — Plan 175 option C). Виртуальные часы
        // продвигаются на переданные ms.
        //
        // Plan 175 (owner TODO closure, 2026-07-10): auto-idle-advance —
        // раньше эта строка была ОДНА (`current_ms += delta_ms`, синхронно,
        // без приостановки фибра). Это ломало порядок дедлайнов между
        // конкурентными `spawn`-фибрами: ничего не yield'ило внутри mock
        // sleep, поэтому какой фибр планировщик резюмировал первым — тот и
        // отрабатывал целиком (включая свой "sleep") до следующего,
        // независимо от длины запрошенного сна (tokio/Kotlin
        // TestCoroutineScheduler паритет требует обратного: короткий
        // виртуальный сон должен наблюдаемо "проснуться" раньше длинного).
        //
        // Фикс: дедлайн — АБСОЛЮТНОЕ значение, вычисленное ДО парковки
        // (`current_ms` на момент вызова, не после); `vclock.park_until`
        // (nova_rt/fibers.h `nova_vclock_park_until`) паркует текущий фибр
        // (если он вообще фибр — для плоского sequential-потока это no-op,
        // возвращается немедленно, ПОВЕДЕНИЕ НЕ МЕНЯЕТСЯ), пока ВСЕ живые
        // фибры scope'а тоже не окажутся виртуально запаркованы (idle) —
        // тогда просыпается ближайший по дедлайну (может быть другой
        // фибр, не этот). Bump — `current_ms = deadline_ms` (МАКСИМУМ, не
        // `+=`): конкурентный sibling с меньшим дедлайном мог уже продвинуть
        // `current_ms` пока этот фибр был запаркован — абсолютный
        // `deadline_ms`, посчитанный ДО парковки, остаётся корректной
        // целью; наивный `+=` ПОСЛЕ пробуждения задвоил бы уже добавленное
        // sibling'ом.
        sleep(dur_ms) {
            ro delta_ms = if dur_ms > 0 { dur_ms as u64 } else { 0 as u64 }
            ro deadline_ms = current_ms + delta_ms
            vclock.park_until(deadline_ms as int)
            if deadline_ms > current_ms { current_ms = deadline_ms }
        }
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Self-tests
// ──────────────────────────────────────────────────────────────────────────

// ── Sanity ────────────────────────────────────────────────────────────────

test "seeded даёт детерминированную последовательность" {
    ro (a, b) = with Random = seeded(42 as u64) {
        (Random.u64(), Random.u64())
    }
    ro (a2, b2) = with Random = seeded(42 as u64) {
        (Random.u64(), Random.u64())
    }
    assert(a == a2)
    assert(b == b2)
    assert(a != b)
}

test "seeded — разные seed дают разные последовательности" {
    ro v1 = with Random = seeded(1 as u64) { Random.u64() }
    ro v2 = with Random = seeded(2 as u64) { Random.u64() }
    assert(v1 != v2)
}

test "seeded(0) работает (splitmix64 init гарантирует non-zero state)" {
    ro v = with Random = seeded(0 as u64) { Random.u64() }
    // xoshiro256++ из splitmix64-инициализированного state не даёт 0
    // на первом шаге для seed=0.
    assert(v != 0 as u64)
}

test "seeded.bytes возвращает запрошенную длину" {
    ro bs = with Random = seeded(0 as u64) { Random.bytes(16) }
    assert(bs.len() == 16)
}

test "seeded.bytes — детерминизм между запусками" {
    ro bs1 = with Random = seeded(99 as u64) { Random.bytes(32) }
    ro bs2 = with Random = seeded(99 as u64) { Random.bytes(32) }
    assert(bs1.len() == bs2.len())
    mut all_eq = true
    for i in 0..bs1.len() {
        if bs1[i] != bs2[i] { all_eq = false }
    }
    assert(all_eq)
}

// ── Distribution quality smoke tests ──────────────────────────────────────

test "PRNG: 1000 значений — non-trivial period (> 2^32)" {
    // xoshiro256++ имеет period 2^256-1. На 1000 итерациях не должно
    // быть повторений. Проверяем через простой check: первое и
    // последнее значение не равны, и среднее значение не близко к 0
    // или u64::MAX.
    with Random = seeded(12345 as u64) {
        ro first = Random.u64()
        mut last u64 = 0
        for _ in 0..999 {
            last = Random.u64()
        }
        assert(first != last)
    }
}

test "PRNG: uniform-byte distribution (no obvious bias)" {
    // Генерируем 256 байт, смотрим что нет очевидного bias:
    // каждый bucket [0..32, 32..64, ...] получил хотя бы 1 значение.
    // Это не строгий chi-square, но catches LCG-style low-bit bias.
    with Random = seeded(7 as u64) {
        ro bs = Random.bytes(256)
        mut buckets [8]int = [0, 0, 0, 0, 0, 0, 0, 0]
        for i in 0..bs.len() {
            ro b = bs[i] as int
            ro bucket = b / 32                 // 0..7
            buckets[bucket] = buckets[bucket] + 1
        }
        // Все 8 buckets должны иметь хотя бы 1 hit на 256 sample'ах.
        // LCG обычно проваливает этот тест из-за low-bit pattern.
        mut filled = 0
        for i in 0..8 {
            if buckets[i] > 0 { filled = filled + 1 }
        }
        assert(filled == 8)
    }
}

test "PRNG: non-correlation между последовательными вызовами" {
    // Простой sanity — последовательные значения не должны быть
    // равны или отличаться на константу (что было бы у broken LCG).
    with Random = seeded(31337 as u64) {
        ro a = Random.u64()
        ro b = Random.u64()
        ro c = Random.u64()
        assert(a != b)
        assert(b != c)
        // Разница a→b и b→c не должна быть равна (linear-recurrence).
        ro d1 = if a > b { a - b } else { b - a }
        ro d2 = if b > c { b - c } else { c - b }
        assert(d1 != d2)
    }
}

// ── Time handlers (Plan 175 D316 amend, 2026-07-06: int-провод — `now_unix_ms()->int` ms,
//    `sleep(ms int)`. Retired `now_ms()`/`now_ns()` НЕ в схеме → не зовём;
//    аргумент sleep — миллисекунды как int, не `Duration`). ────────────────

test "fixed_ms.now_unix_ms() возвращает заданное значение (ms)" {
    ro ms = with Time = fixed_ms(12345 as u64) { Time.now_unix_ms() }
    assert(ms == 12345)
}

test "fixed_ms.sleep — no-op (время не двигается)" {
    with Time = fixed_ms(1000 as u64) {
        Time.sleep(100)
        Time.sleep(1000)
        assert(Time.now_unix_ms() == 1000)
    }
}

test "mut_clock — sleep продвигает виртуальное время (ms)" {
    with Time = mut_clock(0 as u64) {
        assert(Time.now_unix_ms() == 0)
        Time.sleep(500)
        assert(Time.now_unix_ms() == 500)
        Time.sleep(2000)
        assert(Time.now_unix_ms() == 2500)
    }
}

test "mut_clock — independent instances между with-блоками" {
    ro m1 = with Time = mut_clock(1000 as u64) {
        Time.sleep(1000)
        Time.now_unix_ms()
    }
    ro m2 = with Time = mut_clock(1000 as u64) {
        Time.sleep(5000)
        Time.now_unix_ms()
    }
    assert(m1 == 2000)
    assert(m2 == 6000)
}

test "seeded + fixed_ms композируются" {
    ro r = with Random = seeded(42 as u64), Time = fixed_ms(5000 as u64) {
        Random.u64() + (Time.now_unix_ms() as u64)
    }
    assert(r != 0 as u64)
}

test "seeded + mut_clock композируются" {
    with Random = seeded(99 as u64), Time = mut_clock(0 as u64) {
        ro v1 = Random.u64()
        Time.sleep(1000)
        ro v2 = Random.u64()
        assert(v1 != v2)
        assert(Time.now_unix_ms() == 1000)
    }
}

// ── mut_clock: auto-idle-advance (Plan 175, owner TODO closure, 2026-07-10) ──
// tokio `time::pause()` / Kotlin `TestCoroutineScheduler.advanceUntilIdle()`
// parity — см. docs/time.md "Мокабельность" + nova_vclock_park_until
// (nova_rt/fibers.h). Единственный явный `Time.sleep`/`sleep()`-вызов больше
// не требуется на КАЖДЫЙ шаг — конкурентные виртуальные сны сами будятся в
// порядке дедлайна, когда весь scope идёт idle.

test "mut_clock auto-idle-advance: sleep(10_000) в одиночном spawn завершается мгновенно" {
    // Tokio-style пример из задачи: без auto-advance этот тест реально ждал
    // бы 10 секунд (mut_clock раньше был чисто синхронным — работало и без
    // фикса для ОДНОГО фибра; фикс подтверждает, что паркующий путь
    // (nova_vclock_park_until) НЕ вносит реальную задержку для тривиального
    // случая «единственный alive фибр scope'а». `AtomicInt` (не голый
    // `mut`) — spawn-тело мутирует захваченную переменную, компилятор
    // требует internally-synchronized `#share`-тип (D415 §2,
    // E_CONCURRENT_MUT_CAPTURE).
    mut woke = AtomicInt.new(0)
    with Time = mut_clock(0 as u64) {
        supervised {
            spawn { Time.sleep(10_000); woke.fetch_add(1) }
        }
    }
    assert(woke.load() == 1)
}

test "mut_clock auto-idle-advance: конкурентные sleep будятся в порядке дедлайна" {
    // Три spawn с РАЗНОЙ длиной сна, порядок spawn НЕ совпадает с порядком
    // дедлайна (100 первый, 10 последний) — без auto-advance (старое
    // синхронное поведение) фибры отрабатывали бы целиком в порядке spawn
    // (100, 10, 50), а не в порядке дедлайна. `seq.fetch_add(1)` возвращает
    // значение ДО инкремента (0-indexed) — первым проснувшийся получает 0.
    mut seq = AtomicInt.new(0)
    mut order_10 = AtomicInt.new(-1)
    mut order_50 = AtomicInt.new(-1)
    mut order_100 = AtomicInt.new(-1)
    with Time = mut_clock(0 as u64) {
        supervised {
            spawn { Time.sleep(100); order_100.store(seq.fetch_add(1)) }
            spawn { Time.sleep(10);  order_10.store(seq.fetch_add(1)) }
            spawn { Time.sleep(50);  order_50.store(seq.fetch_add(1)) }
        }
    }
    assert(order_10.load() == 0)
    assert(order_50.load() == 1)
    assert(order_100.load() == 2)
}

test "mut_clock auto-idle-advance: часы после конкурентных sleep равны максимальному дедлайну" {
    with Time = mut_clock(0 as u64) {
        supervised {
            spawn { Time.sleep(100) }
            spawn { Time.sleep(10) }
            spawn { Time.sleep(50) }
        }
        // Все три виртуальных сна разрешились — часы продвинуты РОВНО до
        // максимального дедлайна (100), не до суммы (160) — доказывает, что
        // bump — `current_ms = max(current_ms, deadline)`, не `+=` (что
        // задвоило бы вклад уже сработавших siblings).
        assert(Time.now_unix_ms() == 100)
    }
}

// ── local_offset_sec (Plan 175.1, D316 amend + D321, 2026-07-10) ──────────
// closes [M-175.1-local-offset-effect-op].

test "fixed_ms.local_offset_sec() — mock-coherence, фиксированный UTC (0)" {
    ro off = with Time = fixed_ms(0 as u64) { Time.local_offset_sec() }
    assert(off == 0)
}

test "mut_clock.local_offset_sec() — mock-coherence, фиксированный UTC (0)" {
    ro off = with Time = mut_clock(0 as u64) { Time.local_offset_sec() }
    assert(off == 0)
}

test "local_offset_sec() мокабелен произвольным handler-литералом" {
    // Демонстрирует полную мокабельность нового опа (не только через
    // fixed_ms/mut_clock helper'ы) — произвольный `effect Time { ... }`
    // литерал волен вернуть любое значение (здесь: MSK, UTC+3 = 10800s).
    ro off = with Time = effect Time {
        sleep(ms) => ()
        now_unix_ms() => 0
        now_monotonic_ns() => 0
        local_offset_sec() => 10_800
    } {
        Time.local_offset_sec()
    }
    assert(off == 10_800)
}
