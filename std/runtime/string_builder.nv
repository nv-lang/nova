// Plan 109 (D179): StringBuilder реализован полностью на Nova.
// Тип: consume record с полем `mut buf []u8`.
// Ранее: external type + C runtime (Nova_StringBuilder / Rust String).
// Теперь: Nova record; все методы на Nova-body.
//
// API-изменения (Plan 109 / D179):
//   @byte_len() → bytes (O(1)), как str (D249-канон: строкоподобное — только
//     byte_len(); [M-unwrap-twins-retraction] 2026-07-07 откатил прежнее
//     «@byte_len удалён, используйте @len()» — D249 требует обратное)
//   - @char_len() удалён (счёт codepoint — линза+терминатор через
//     `.clone().into_str().chars().count()`, не выделенное свойство; 0
//     usages в std/, [M-unwrap-twins-retraction] 2026-07-07)
//   - @peek() удалён (unsound: pointer aliasing с realloc)
//   @into() переименован → @as_str() (consume)
//   @append_bytes(arr) удалён → @append(readonly arr []u8) overload
//   @plus(s) / @plus(c) удалены — используйте @append напрямую
//   type StringBuilder consume  — тип требует явного consume

// #no_prelude — break import cycle (prelude → collections → string_builder).
// Explicit imports cover only what we need.
#no_prelude
module runtime.string_builder

// no explicit imports — #no_prelude breaks all auto-injection.

// ─── Type ───

export type StringBuilder consume {
    mut buf []u8
}

// ─── Constructors ───

// Default capacity для StringBuilder.new() — 16 bytes (1-line string).
const INITIAL_CAPACITY = 16

// [M-vec-spelling-array-value-position-cap-collision] (vec-sweep,
// 2026-07-06): same workaround as std/runtime/write_buffer.nv — binding the
// `[]u8` constructor result to an explicitly-typed local FIRST, then calling
// `.cap(n)` as a SEPARATE statement (not chained in the same expression),
// avoids a NAME+ARITY dispatch collision with other co-compiled types' own
// `cap` methods (reproduced standalone; see write_buffer.nv's comment for
// the full writeup).
//
// [M-vec-spelling-consume-block-body-untyped] (vec-sweep, 2026-07-06,
// RESOLVED by workaround): giving `StringBuilder.new()`/`@clone()` a
// multi-statement BLOCK body (`{ mut _buf ...; ...; { buf: _buf } }`) broke
// D133 consume-tracking for every OTHER file's `consume sb = StringBuilder.new()`
// call site in the same CU — `[D133-not-consumed] переменная sb (тип \`\`)`
// (empty resolved type — the consume-checker's own type-resolution pass
// didn't see through the block body, unlike the main type-checker). Kept as
// a private helper returning plain `[]u8` (no consume concerns there) so the
// constructor itself stays the single-expression `=> { buf: … }` bare-literal
// arrow-body shape the consume-checker expects.
fn sb_init_buf(cap int) -> []u8 {
    mut b []u8 = []u8.new()
    b.cap(cap)
    b
}

// Deep-copy helper for `@clone`: fresh exact-capacity buffer + one bulk
// `append` (RawMem.copy). Free fn on `[]u8` (NOT a StringBuilder method) so
// `@clone`'s own body stays a single `=> { buf: … }` expression (same
// consume-checker shape constraint as `new()`/sb_init_buf above), AND so the
// `append` here dispatches on a plainly-typed `[]u8` local — calling
// `.append(@buf)` on a `{ buf: … }` record-literal receiver mis-dispatched to
// StringBuilder's own `@append(s str)` overload (generated C passed a
// `Nova_Vec____nova_byte*` where `nova_str` was expected) — this was the root
// of the `vec_of_empty_panic` CC-FAIL ([M-vec-neg-panic-cascaded-cc-fail]).
fn sb_clone_buf(src []u8) -> []u8 {
    mut b []u8 = sb_init_buf(src.len())
    b.append(src)
    b
}

// Пустой StringBuilder с pre-allocated capacity 16.
export fn StringBuilder.new() -> Self => { buf: sb_init_buf(INITIAL_CAPACITY) }

// StringBuilder из существующей строки (copy UTF-8 bytes).
export fn StringBuilder.from(s str) -> Self => StringBuilder.new().append(s)

// StringBuilder из одного codepoint (UTF-8 encode).
// Plan 73.1 D180: delegate to from(str) — старый pattern `let mut sb = StringBuilder.new()
// + sb.append(c)` нарушал D180 (sb consume-obligation не satisfied при
// implicit fluent-return). [M-91.11-from-char-direct] ✅ RESOLVED/verified:
// `new().append(c)` fluent chain совместим с D180 — реализован
// строкой ниже (StringBuilder.from(c char)), str.from(c) не нужен.
export fn StringBuilder.from(c char) -> Self => StringBuilder.new().append(c)

// ─── Query methods ───

// Длина буфера в байтах. O(1). D249-канон: строкоподобная поверхность
// (как str) — только byte_len(), не len().
export fn StringBuilder @byte_len() -> int => @buf.len()

// Allocated capacity в байтах.
//
// [M-unwrap-twins-retraction] (2026-07-07): `@capacity()` alias
// РЕТРАКТИРОВАН (дублировал канонический `@cap()`, D9) — `@cap()` теперь
// единственный 0-arg getter половины `cap`/`cap(n)` property-пары
// (ex-`with_capacity`, D372 amend — with_capacity removed).
export fn StringBuilder @cap() -> int => @buf.cap()

// Set capacity to exactly `n` bytes (delegates to the underlying `[]u8`'s
// own exact `mut @cap(n)` — no rounding). Replacement for the removed
// `StringBuilder.with_capacity` static constructor: `StringBuilder.new().cap(n)`.
// Same same-name dispatch-collision workaround as WriteBuffer's `mut @cap(n)`
// (bind `@buf` to an explicitly `[]u8`-typed local first — `b`/`@buf` alias
// the same heap-allocated buffer, so the mutation is visible through `@buf`).
export fn StringBuilder mut @cap(n int) -> @
    requires n >= @byte_len()
{
    mut b []u8 = @buf
    b.cap(n)
}

// true если буфер пуст.
export fn StringBuilder @is_empty() -> bool => @buf.is_empty()

// Независимая копия (deep copy buffer). Нужен для consume-типа при разветвлении.
export fn StringBuilder @clone() -> Self => { buf: sb_clone_buf(@buf) }

// Проверить prefix буфера. Slice-view + memcmp (zero-copy).
export fn StringBuilder @starts_with(prefix str) -> bool {
    ro pbytes = prefix.bytes()
    ro plen = pbytes.len()
    plen <= @buf.len() && @buf[0..plen].compare(pbytes) == 0
}

// Проверить suffix буфера. Slice-view + memcmp (zero-copy).
export fn StringBuilder @ends_with(suffix str) -> bool {
    ro sbytes = suffix.bytes()
    ro slen = sbytes.len()
    ro blen = @buf.len()
    slen <= blen && @buf[blen - slen..blen].compare(sbytes) == 0
}

// ─── Mutating (-> @) ───

// Append UTF-8 bytes из str. Zero-copy view (as_bytes).
export fn StringBuilder mut @append(s str) -> @ { @buf.append(s.bytes()) }

// Append codepoint как UTF-8 (1-4 байта). Fluent push chain (D181)
// + multi-line continuation (Plan 91 followup parser fix).
export fn StringBuilder mut @append(c char) -> @ {
    ro cp = c as int
    if cp < 0x80 {
        @buf.push(cp as u8)
    } else if cp < 0x800 {
        @buf.push((0xC0 | (cp >> 6)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        @buf.push((0xE0 | (cp >> 12)) as u8)
            .push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    } else {
        @buf.push((0xF0 | (cp >> 18)) as u8)
            .push((0x80 | ((cp >> 12) & 0x3F)) as u8)
            .push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    }
}

// Append raw []u8 bytes. Caller отвечает за UTF-8 validity.
export fn StringBuilder mut @append(ro arr []u8) -> @ { @buf.append(arr) }

// Plan 154.1 (D269): typed scalar overloads so `sb.append(x)` dispatches on
// the value's type uniformly — no `append_int`-style names, no caller-side
// `str.from`. Used by the primitive Display impls in std/prelude/protocols.nv
// (`fn int @display(mut sb StringBuilder) { sb.append(@) }`), and convenient
// for users directly. `bool` appends the literal "true"/"false" with no
// intermediate; `int`/`f64` route through `str.from` (the same conv.h
// formatters the interp path uses), avoiding the temp StringBuilder an
// interp-string body would otherwise allocate.
export fn StringBuilder mut @append(n int) -> @ { @append(str.from(n)) }
export fn StringBuilder mut @append(x f64) -> @ { @append(str.from(x)) }
export fn StringBuilder mut @append(b bool) -> @ { if b { @append("true") } else { @append("false") } }
// Plan 154.1 [M-154.1-f32-display-debug] + Plan 180: f32 via `str.from(x)` →
// the f32-precise shortest-round-trip formatter (nova_f32_to_str). Widening to
// f64 first would surface the f32→f64 mantissa tail now that str.from(f64) is
// faithful (0.1f → "0.10000000149011612"); the direct f32 path keeps "0.1".
export fn StringBuilder mut @append(x f32) -> @ { @append(str.from(x)) }

// Append строку s ровно n раз. n <= 0 → no-op.
// Single reserve(total) → один realloc вместо n× амортизированного doubling.
// `bytes()` — zero-copy view; `append` в loop без indirection.
export fn StringBuilder mut @append_repeat(s str, n int) -> @
    requires n >= 0
{
    if n <= 0 { return }
    ro bytes = s.bytes()
    @buf.reserve(bytes.len() * n)
    for _ in 0..n {
        @buf.append(bytes)
    }
}

// Обрезать буфер до len байт. len >= @byte_len() → no-op. Caller отвечает за UTF-8 границы.
export fn StringBuilder mut @truncate(len int) -> @
    requires len >= 0
{ @buf.truncate(len) }

// Plan 152.7.1 (D374 AMEND, ex-D374) — Write protocol implementation.
// Delegates to @buf.append directly (same UTF-8 bytes path as @append(s str)).
// Returns () — satisfies Write protocol contract.
export fn StringBuilder mut @write(s str) -> () { @buf.append(s.bytes()) }

// ─── Consume ───

// Финализировать в str. После @into_str() StringBuilder consumed.
// Zero-copy steal: reuse @buf data ptr напрямую (writes '\0' in-place
// если cap > len, иначе alloc+copy fallback).
// Infallible: UTF-8 invariant поддерживается append-методами.
// Renamed as_str → into_str (Plan 91.18 Ф.2; D77: into_* = consuming).
export fn StringBuilder consume @into_str() -> str => str.from_bytes_unchecked_steal(@buf)
