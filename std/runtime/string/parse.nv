// AUTO-SPLIT from std/runtime/string.nv (Plan 152.0 Ф.2). Bodies byte-identical.
// Co-equal file of module `runtime.string` (folder = one module, AMEND F4).
// Role: parse_int (Result-form, D325).
//
// Plan 91 Ф.2.5/2.6 (D177/D178): str Nova-body methods. #no_prelude breaks the
// prelude->string->prelude import cycle.

#no_prelude
module runtime.string

import std.prelude.core.{Option, Some, None, Result, Ok, Err}


/// Error variants for @parse_int. Exported so callers can match on them.
export type ParseIntError enum Empty | InvalidDigit | Overflow | InvalidRadix

// Plan 177 (D325): единый fallible-контракт — публичная std возвращает
// Result. Дуальная тройка `parse_int`(throws)/`try_parse_int`(Result)/
// `parse_int_opt`(Option) РЕТРАКТИРОВАНА (D178 amend): одна форма
// @parse_int → Result[int, ParseIntError]. throw на call-site = `!!`,
// проброс = `?`, Result→Option = `.ok()`.

/// Strict parse — returns Result with explicit error. Default radix=10.
/// `radix` valid range: 2..=36.
/// Empty / `-` / `+` without digits → Err(Empty). Invalid digit → Err(InvalidDigit).
/// i64 overflow → Err(Overflow). radix out of range → Err(InvalidRadix).
#stable(since = "0.1")
export fn str @parse_int(radix int = 10) -> Result[int, ParseIntError] {
    if radix < 2 || radix > 36 { return Err(InvalidRadix) }
    ro bytes = @bytes()
    ro n = @byte_len()
    if n == 0 { return Err(Empty) }
    mut neg = false
    mut start = 0
    if bytes[0] == '-' {
        neg = true
        start = 1
    }
    else if bytes[0] == '+' { start = 1 }
    if start >= n { return Err(Empty) }
    mut acc = 0
    for j in start..n {
        ro c = bytes[j] as int
        mut d = -1
        if c >= '0' && c <= '9' { d = c - '0' }
        else if c >= 'a' && c <= 'z' { d = c - 'a' + 10 }
        else if c >= 'A' && c <= 'Z' { d = c - 'A' + 10 }
        if d < 0 || d >= radix { return Err(InvalidDigit) }
        if acc > (9223372036854775807 - d) / radix { return Err(Overflow) }
        acc = acc * radix + d
    }
    Ok(if neg { -acc } else { acc })
}

/// Error variants for `f64.parse`. Exported so callers can match on them.
export type ParseFloatError enum Empty | Invalid

// [M-f64-try-parse-to-parse-f64] (2026-07-07): parsing is a constructor-
// conversion — the domain-appropriate home is the TARGET type (`f64`), not
// `str` (owner: str shouldn't know about every numeric type). Static, единая
// fallible-форма (D325/R3): `f64.try_parse(s) -> Option[f64]` (компиляторный
// builtin, Option вместо Result, без infallible-сиблинга) РЕТРАКТИРОВАН —
// заменён на `f64.parse(s) -> Result[f64, ParseFloatError]`. `?` пробрасывает,
// `!!` throws, `.ok()` даёт Option при желании.
//
// Plain FFI, no compiler name-knowledge (§3): `nova_str_parse_f64` is a
// regular `extern "C" fn` (D282), out-param convention (bool ok + `*out`
// value) mirroring std/net2's `out_err *mut int` cold-path constructors —
// see `nova_str_to_f64`'s thin wrapper in nova_rt/conv.h. The compiler knows
// NOTHING about float parsing; it just lowers an ordinary FFI call.
extern "C" fn nova_str_parse_f64(s str, out *mut f64) -> bool

/// Strict parse — delegates to `nova_str_parse_f64` (conv.h, `strtod`-based;
/// leading whitespace, `+`/`-`, decimal, exponent, `"nan"`/`"inf"` literals).
/// Empty string → `Err(Empty)` (checked here so it's distinguishable from
/// other malformed syntax, which `strtod` cannot tell apart on its own —
/// reported as `Err(Invalid)`).
#stable(since = "0.1")
export fn f64.parse(s str) -> Result[f64, ParseFloatError] {
    if s.is_empty() { return Err(Empty) }
    mut v = 0.0
    if unsafe { nova_str_parse_f64(s, &v) } { Ok(v) } else { Err(Invalid) }
}
