// Plan 91.12 (D126 retract): WriteBuffer реализован полностью на Nova.
// Тип: consume record с полем `mut buf []u8`.
// Ранее: external type + C runtime (Nova_WriteBuffer + 30 inline C функций).
// Теперь: Nova record; все методы на Nova-body над []u8 primitives
// (push / append / extend_from / reserve / copy_from — memmove/memcpy).
//
// API contract (paritет с предыдущим C-runtime):
//   @write_byte/bytes/zero/char/str
//   @write_{u8,i8,u16_le,u16_be,...,u64_be,f32_le,f32_be,f64_le,f64_be}
//   @len, @capacity, @clone
//   consume @into -> []u8

// #no_prelude — break import cycle (prelude → collections → write_buffer).
// Explicit imports cover only what we need.
#no_prelude
module runtime.write_buffer

// no explicit imports — #no_prelude breaks all auto-injection.

// ─── Type ───
//
// **Design note (Plan 91.12):** WriteBuffer — НЕ consume type (в отличие
// от StringBuilder). `consume @into()` метод даёт ownership transfer и
// type-safe «no-reuse-after-into», но binding не требует `consume`
// keyword (D180) — это сохраняет backward-compat с predecessor C runtime,
// где `let mut wb = WriteBuffer.new()` был стандартным паттерном.

export type WriteBuffer {
    mut buf []u8
}

// ─── Constructors ───

// Default initial capacity — 16 bytes, matches предыдущий C runtime
// (NOVA_WRITE_BUFFER_INIT_CAP). Same name as in std/runtime/string_builder.nv —
// module-private const, codegen mangles C-name через `Nova_const_<modpath>_*`
// (Plan 91.12 D126 retract followup).
const INITIAL_CAPACITY = 16

// Пустой WriteBuffer с pre-allocated capacity 16.
//
// [M-vec-spelling-array-value-position-cap-collision] (vec-sweep,
// 2026-07-06, RESOLVED by workaround): chaining `.cap(n)` directly onto a
// same-expression array constructor (`[]u8.new().cap(n)`) mis-dispatches by
// NAME+ARITY to an unrelated co-compiled type's own 1-arg `cap` method
// (reproduced standalone). Binding the constructor result to an explicitly
// `[]u8`-typed local FIRST, then calling `.cap(n)` as a SEPARATE statement,
// resolves correctly (the declared local type anchors dispatch). The local
// is named `_wb_buf` (not `buf`) — using the generic name `buf` here
// triggered a SEPARATE, likely var_types-scoping-related collision with
// some other co-compiled function's own `buf`-named local of a different
// type (observed: external callers of `WriteBuffer.new()` then saw `wb.len()`
// mis-resolve as `str.len()` — [E_STR_NO_LEN]); renaming the local sidesteps
// it too. Both are reported as compiler gaps (see report); this is a
// workaround, not a fix.
export fn WriteBuffer.new() -> Self {
    mut _wb_buf []u8 = []u8.new()
    _wb_buf.cap(INITIAL_CAPACITY)
    mut _wb_self WriteBuffer = { buf: _wb_buf }
    _wb_self
}

// WriteBuffer из существующих байт (deep copy — append через memmove).
// Param `b` is readonly by default (D176 amend, Plan 108.1).
export fn WriteBuffer.from(b []u8) -> Self {
    mut _wb_buf []u8 = []u8.new()
    _wb_buf.cap(b.len())
    mut wb WriteBuffer = { buf: _wb_buf }
    wb.buf.append(b)
    wb
}

// ─── Query ───

// Текущий размер в байтах.
export fn WriteBuffer @len() -> int => @buf.len()

// Allocated capacity в байтах.
//
// [M-unwrap-twins-retraction] (2026-07-07): `@capacity()` alias
// РЕТРАКТИРОВАН (дублировал канонический `@cap()`, D9) — `@cap()` теперь
// единственный 0-arg getter половины `cap`/`cap(n)` property-пары
// (ex-`with_capacity`, D372 amend — with_capacity removed).
export fn WriteBuffer @cap() -> int => @buf.cap()

// Set capacity to exactly `n` bytes (delegates to the underlying `[]u8`'s
// own exact `mut @cap(n)` — no rounding). Replacement for the removed
// `WriteBuffer.with_capacity` static constructor: `WriteBuffer.new().cap(n)`.
//
// [M-vec-spelling-same-name-method-dispatch-collision] (vec-sweep,
// 2026-07-06, RESOLVED by workaround): calling `@buf.cap(n)` DIRECTLY here
// mis-dispatched to `WriteBuffer`'s OWN `cap` (this very method) instead of
// the field's `[]u8`/`Vec[u8]` one — reproduced: generated C called
// `Nova_WriteBuffer_method_cap(nova_self->buf, n)` (wrong arity/type) rather
// than the array's. Root cause: once BOTH the enclosing type and a plain
// (non-`use`-embedded) field's type define a same-name/arity method, the
// codegen method registry appears to prefer the ENCLOSING type by a
// last-registered-wins rule rather than the field's declared type. Binding
// `@buf` to an explicitly `[]u8`-typed local FIRST anchors dispatch to the
// array/Vec method correctly (same technique as the constructors above);
// `b`/`@buf` still alias the SAME heap-allocated Vec buffer, so the
// resulting `@realloc_to` mutation is visible through `@buf` afterwards.
export fn WriteBuffer mut @cap(n int) -> @
    requires n >= @len()
{
    mut b []u8 = @buf
    b.cap(n)
}

// Независимая копия (deep copy buffer). Read-only access — original не consume'ится.
export fn WriteBuffer @clone() -> Self {
    mut _wb_buf []u8 = []u8.new()
    _wb_buf.cap(@buf.len())
    mut copy WriteBuffer = { buf: _wb_buf }
    copy.buf.append(@buf)
    copy
}

// ─── Mutating writes (fluent -> @) ───

// Append один byte. Returns self for chaining (D181).
export fn WriteBuffer mut @write_byte(v u8) -> @ { @buf.push(v) }

// Append массив байт (bulk memmove через []u8.append).
// Param `src` is readonly by default (D176 amend).
export fn WriteBuffer mut @write_bytes(src []u8) -> @ { @buf.append(src) }

// Append n нулевых байт. n <= 0 → no-op.
// Plan 90 followup `[]T.append_zero(n)` — bulk memset extension; O(1)
// growth amortized + single memset(0) для всего сегмента (vs наивный
// push-loop с amortized realloc'ами).
export fn WriteBuffer mut @write_zero(n int) -> @ {
    if n <= 0 { return }
    @buf.append_zero(n)
}

// UTF-8 encode codepoint (1-4 байта). Returns self.
// Логика повторяет StringBuilder.@append(char) — Plan 109 / D179.
export fn WriteBuffer mut @write_char(c char) -> @ {
    ro cp = c as int
    if cp < 0x80 {
        @buf.push(cp as u8)
    } else if cp < 0x800 {
        @buf.push((0xC0 | (cp >> 6)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        @buf.push((0xE0 | (cp >> 12)) as u8)
            .push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    } else {
        @buf.push((0xF0 | (cp >> 18)) as u8)
            .push((0x80 | ((cp >> 12) & 0x3F)) as u8)
            .push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    }
}

// Append UTF-8 байты из str (bulk memmove через []u8.append + as_bytes).
export fn WriteBuffer mut @write_str(s str) -> @ { @buf.append(s.bytes()) }

// ─── 18 numeric × LE/BE ───
//
// Все типизированные writes сводятся к LE/BE byte unpacking через
// `as int` (bit-preserving cast) + shift/truncate. `as u8` — это
// truncating cast на нижний байт, sign safely ignored.

// 1 byte unsigned, без endianness.
export fn WriteBuffer mut @write_u8(v u8) -> @ { @buf.push(v) }

// 1 byte signed, без endianness — bit-pattern preserved через `as u8`.
export fn WriteBuffer mut @write_i8(v i8) -> @ { @buf.push(v as u8) }

// u16 little-endian (2 байта).
export fn WriteBuffer mut @write_u16_le(v u16) -> @ {
    ro x = v as int
    @buf.push(x as u8)
        .push((x >> 8) as u8)
}

// u16 big-endian (2 байта).
export fn WriteBuffer mut @write_u16_be(v u16) -> @ {
    ro x = v as int
    @buf.push((x >> 8) as u8)
        .push(x as u8)
}

// i16 little-endian (2 байта).
export fn WriteBuffer mut @write_i16_le(v i16) -> @ {
    ro x = v as int
    @buf.push(x as u8)
        .push((x >> 8) as u8)
}

// i16 big-endian (2 байта).
export fn WriteBuffer mut @write_i16_be(v i16) -> @ {
    ro x = v as int
    @buf.push((x >> 8) as u8)
        .push(x as u8)
}

// u32 little-endian (4 байта).
export fn WriteBuffer mut @write_u32_le(v u32) -> @ {
    ro x = v as int
    @buf.push(x as u8)
        .push((x >> 8) as u8)
        .push((x >> 16) as u8)
        .push((x >> 24) as u8)
}

// u32 big-endian (4 байта).
export fn WriteBuffer mut @write_u32_be(v u32) -> @ {
    ro x = v as int
    @buf.push((x >> 24) as u8)
        .push((x >> 16) as u8)
        .push((x >> 8) as u8)
        .push(x as u8)
}

// i32 little-endian (4 байта).
export fn WriteBuffer mut @write_i32_le(v i32) -> @ {
    ro x = v as int
    @buf.push(x as u8)
        .push((x >> 8) as u8)
        .push((x >> 16) as u8)
        .push((x >> 24) as u8)
}

// i32 big-endian (4 байта).
export fn WriteBuffer mut @write_i32_be(v i32) -> @ {
    ro x = v as int
    @buf.push((x >> 24) as u8)
        .push((x >> 16) as u8)
        .push((x >> 8) as u8)
        .push(x as u8)
}

// u64 little-endian (8 байт).
export fn WriteBuffer mut @write_u64_le(v u64) -> @ {
    ro x = v as int
    @buf.push(x as u8)
        .push((x >> 8) as u8)
        .push((x >> 16) as u8)
        .push((x >> 24) as u8)
        .push((x >> 32) as u8)
        .push((x >> 40) as u8)
        .push((x >> 48) as u8)
        .push((x >> 56) as u8)
}

// u64 big-endian (8 байт).
export fn WriteBuffer mut @write_u64_be(v u64) -> @ {
    ro x = v as int
    @buf.push((x >> 56) as u8)
        .push((x >> 48) as u8)
        .push((x >> 40) as u8)
        .push((x >> 32) as u8)
        .push((x >> 24) as u8)
        .push((x >> 16) as u8)
        .push((x >> 8) as u8)
        .push(x as u8)
}

// i64 little-endian (8 байт).
export fn WriteBuffer mut @write_i64_le(v i64) -> @ {
    ro x = v as int
    @buf.push(x as u8)
        .push((x >> 8) as u8)
        .push((x >> 16) as u8)
        .push((x >> 24) as u8)
        .push((x >> 32) as u8)
        .push((x >> 40) as u8)
        .push((x >> 48) as u8)
        .push((x >> 56) as u8)
}

// i64 big-endian (8 байт).
export fn WriteBuffer mut @write_i64_be(v i64) -> @ {
    ro x = v as int
    @buf.push((x >> 56) as u8)
        .push((x >> 48) as u8)
        .push((x >> 40) as u8)
        .push((x >> 32) as u8)
        .push((x >> 24) as u8)
        .push((x >> 16) as u8)
        .push((x >> 8) as u8)
        .push(x as u8)
}

// f32 / f64 — IEEE 754 reinterpret-cast через {f32,f64}.to_bits()
// (std/runtime/numeric.nv), затем как unsigned int соответствующей ширины.

// f32 little-endian IEEE 754.
export fn WriteBuffer mut @write_f32_le(v f32) -> @ => @write_u32_le(v.to_bits())

// f32 big-endian IEEE 754.
export fn WriteBuffer mut @write_f32_be(v f32) -> @ => @write_u32_be(v.to_bits())

// f64 little-endian IEEE 754.
export fn WriteBuffer mut @write_f64_le(v f64) -> @ => @write_u64_le(v.to_bits())

// f64 big-endian IEEE 754.
export fn WriteBuffer mut @write_f64_be(v f64) -> @ => @write_u64_be(v.to_bits())

// ─── Finalize ───

// Финализировать в []u8. После @into() WriteBuffer consumed.
// Ownership transfer — возвращает внутренний buf напрямую (no copy).
export fn WriteBuffer consume @into() -> []u8 => @buf
