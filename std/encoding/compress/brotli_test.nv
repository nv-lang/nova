// SPDX-License-Identifier: MIT OR Apache-2.0
// std/encoding/compress/brotli_test.nv — in-module tests for brotli decode
// (Plan 179 Ф.2, D337; owner convention: tests live next to the module).
//
// Vectors are the OFFICIAL google/brotli test data (tests/testdata/*.compressed):
//   10x10y.compressed → "XXXXXXXXXXYYYYYYYYYY" (20 bytes)
//   64x.compressed    → 64× 'X'
//   empty.compressed  → "" (the canonical 1-byte 0x06 empty stream)
// These exercise the real RFC 7932 decoder through nova_rt/brotli_shim.c, proving
// the vendored lib is linked and driven correctly (pos), the bomb-cap trips over
// the FFI (D334), and truncated/corrupt streams surface a typed Err. Reuses the
// module-private `hexbytes` helper from inflate.nv (folder = one module).

module encoding.compress

test "brotli: RFC 7932 vector decode (10x10y)" {
    ro comp = hexbytes("1b130000a4b0b2ea8147028a")
    assert(brotli_decode(comp, 1048576)!! == "XXXXXXXXXXYYYYYYYYYY".to_bytes())
}

test "brotli: RFC 7932 vector decode (64x, back-reference)" {
    ro comp = hexbytes("1b3f000024b0e2998012")
    assert(brotli_decode(comp, 1048576)!! == "X".repeat(64).to_bytes())
}

test "brotli: empty stream" {
    assert(brotli_decode(hexbytes("06"), 1048576)!! == []u8.new())
}

test "brotli: bomb-cap output > max_output → Err (not OOM); boundary exact" {
    ro comp = hexbytes("1b130000a4b0b2ea8147028a")   // decodes to 20 bytes
    assert(brotli_decode(comp, 10).is_err())          // cap 10 < 20 → Bomb
    assert(brotli_decode(comp, 20).is_ok())           // exactly cap → ok
    assert(brotli_decode(comp, 0).is_ok())            // 0 = no limit (escape-hatch)
}

test "brotli: bomb-cap error is Bomb kind" {
    ro comp = hexbytes("1b3f000024b0e2998012")        // decodes to 64 bytes
    match brotli_decode(comp, 16) {
        Ok(_)  => assert(false)
        Err(e) => assert(e.is_bomb())
    }
}

test "brotli: truncated stream → Err" {
    assert(brotli_decode(hexbytes("1b1300"), 1048576).is_err())
}

test "brotli: corrupt stream → Err" {
    // 10x10y body bytes mangled — an invalid prefix code / bit pattern.
    assert(brotli_decode(hexbytes("1b13ffffffffffff8147028a"), 1048576).is_err())
}
