// d323_mock_fs_rw_test.nv — in-memory Fs handler: byte round-trip + positioned
// I/O (Plan 176 Ф.2, D323). Deterministic, no disk. Migrated from
// nova_tests/fs/mock_fs.nv (Plan 182 Ф.2); complements
// d323_file_must_consume_test.nv with remove_file, non-UTF8 content and
// positioned read_at/write_at coverage.
module std.fs

import std.io.{ErrorKind, SeekFrom}

test "mock_fs: write -> read -> metadata -> remove round-trip" {
    mut fs = MemFs.new()
    ro p = Path.posix("/data/hi.txt")
    with Fs = mock_fs(fs) {
        match write(p, "hi bytes") { Ok(()) => assert(true), Err(_) => assert(false) }
        match read(p) { Ok(b) => assert(b.len() == 8), Err(_) => assert(false) }
        match read_text(p) { Ok(s) => assert(s == "hi bytes"), Err(_) => assert(false) }
        match metadata(p) { Ok(m) => assert(m.len() == 8 && m.is_file()), Err(_) => assert(false) }
        match try_exists(p) { Ok(b) => assert(b), Err(_) => assert(false) }
        match remove_file(p) { Ok(()) => assert(true), Err(_) => assert(false) }
        match try_exists(p) { Ok(b) => assert(b == false), Err(_) => assert(false) }
    }
}

test "mock_fs: non-UTF8 content round-trip; read_text on invalid UTF-8 -> InvalidData" {
    mut fs = MemFs.new()
    ro p = Path.posix("/blob.bin")
    mut payload []u8 = []u8.new()
    payload.push(0xFF as u8); payload.push(0x00 as u8); payload.push(0xFE as u8)
    with Fs = mock_fs(fs) {
        match write(p, payload) { Ok(()) => assert(true), Err(_) => assert(false) }
        match read(p) { Ok(b) => { assert(b.len() == 3); assert(b[0] == (0xFF as u8)) }, Err(_) => assert(false) }
        match read_text(p) {
            Ok(_)  => assert(false)
            Err(e) => match e.kind { ErrorKind.InvalidData => assert(true), _ => assert(false) }
        }
    }
}

test "mock_fs: File seek + read_at + write_at (positioned I/O)" {
    mut fs = MemFs.new()
    ro p = Path.posix("/f.dat")
    with Fs = mock_fs(fs) {
        match File.create(p) {
            Err(_) => assert(false)
            Ok(consume f) => {
                ro _ = f.write("0123456789")
                match f.seek(SeekFrom.start(0)) { Ok(pos) => assert(pos == 0), Err(_) => assert(false) }
                mut buf []u8 = []u8.new()
                buf.resize(4, 0 as u8)
                match f.read(buf) { Ok(n) => assert(n == 4), Err(_) => assert(false) }
                assert(buf[0] == (48 as u8))   // '0'
                mut buf2 []u8 = []u8.new()
                buf2.resize(2, 0 as u8)
                match f.read_at(buf2, 5) { Ok(n) => assert(n == 2), Err(_) => assert(false) }
                assert(buf2[0] == (53 as u8))  // '5'
                match f.write_at("AB", 0) { Ok(n) => assert(n == 2), Err(_) => assert(false) }
                ro _ = f.close()
            }
        }
        match read(p) { Ok(b) => assert(b[0] == (65 as u8) && b[1] == (66 as u8)), Err(_) => assert(false) }
    }
}
