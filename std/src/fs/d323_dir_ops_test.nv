// d323_dir_ops_test.nv — directory ops over mock_fs (Plan 176 Ф.2, D323).
// Migrated from nova_tests/fs/mock_dir.nv (Plan 182 Ф.2).
module std.fs

import std.io.{ErrorKind}

test "mock_fs: mkdir + read_dir + rename + copy_file" {
    mut fs = MemFs.new()
    with Fs = mock_fs(fs) {
        ro d = Path.posix("/proj")
        match create_dir(d) { Ok(()) => assert(true), Err(_) => assert(false) }
        ro _ = write(d.join("a.txt"), "a")
        ro _ = write(d.join("b.txt"), "b")
        match read_dir(d) { Ok(es) => assert(es.len() == 2), Err(_) => assert(false) }
        match rename(d.join("a.txt"), d.join("c.txt")) { Ok(()) => assert(true), Err(_) => assert(false) }
        match try_exists(d.join("a.txt")) { Ok(b) => assert(b == false), Err(_) => assert(false) }
        match copy_file(d.join("b.txt"), d.join("d.txt")) { Ok(n) => assert(n == 1), Err(_) => assert(false) }
        match read_text(d.join("d.txt")) { Ok(s) => assert(s == "b"), Err(_) => assert(false) }
    }
}

test "mock_fs: remove non-empty dir -> DirectoryNotEmpty" {
    mut fs = MemFs.new()
    with Fs = mock_fs(fs) {
        ro d = Path.posix("/full")
        ro _ = create_dir(d)
        ro _ = write(d.join("x"), "x")
        match remove_dir(d) {
            Ok(())  => assert(false)
            Err(e) => match e.kind { ErrorKind.DirectoryNotEmpty => assert(true), _ => assert(false) }
        }
    }
}
