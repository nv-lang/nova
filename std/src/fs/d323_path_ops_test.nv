// d323_path_ops_test.nv — byte-backed Path lexical manipulation, POSIX +
// Windows (D323 Q1). Migrated from nova_tests/fs/path_ops.nv (Plan 182 Ф.2);
// complements d323_path_bytes_test.nv with file_name/stem, normalize edge
// cases, with_extension and equals coverage.
module std.fs

// ─── POSIX ──

test "posix: join / parent / file_name / extension / stem" {
    ro p = Path.posix("/usr/local/bin")
    assert(p.is_absolute())
    match p.parent() { Some(par) => assert(par.display() == "/usr/local"), None => assert(false) }
    match p.file_name() { Some(n) => assert(n == "bin"), None => assert(false) }

    ro j = Path.posix("/a/b").join("c.tar.gz")
    assert(j.display() == "/a/b/c.tar.gz")
    match j.extension() { Some(e) => assert(e == "gz"), None => assert(false) }
    match j.stem() { Some(s) => assert(s == "c.tar"), None => assert(false) }
}

test "posix: relative + dotfile has no extension" {
    ro r = Path.posix("relative/path")
    assert(r.is_relative())
    assert(!r.is_absolute())
    match Path.posix(".bashrc").extension() { Some(_) => assert(false), None => assert(true) }
}

test "posix: normalize collapses . and .. (never above root)" {
    assert(Path.posix("/a/b/../c").normalize().display() == "/a/c")
    assert(Path.posix("/a/./b").normalize().display() == "/a/b")
    assert(Path.posix("a/b/..").normalize().display() == "a")
    assert(Path.posix("//a//b//").normalize().display() == "/a/b")
    assert(Path.posix("/../..").normalize().display() == "/")
    assert(Path.posix("").normalize().display() == ".")
}

test "posix: join with absolute replaces" {
    assert(Path.posix("/a/b").join("/etc").display() == "/etc")
}

// ─── Windows ──

test "windows: drive is absolute; drive-relative is not" {
    assert(Path.windows("C:\\Users\\bob").is_absolute())
    assert(Path.windows("\\\\server\\share\\x").is_absolute())   // UNC
    assert(!Path.windows("C:temp").is_absolute())                // drive-relative
    assert(!Path.windows("\\foo").is_absolute())                 // rooted, not absolute
}

test "windows: parent / file_name / extension over backslashes and slashes" {
    ro p = Path.windows("C:\\a\\b\\file.log")
    match p.parent() { Some(par) => assert(par.display() == "C:\\a\\b"), None => assert(false) }
    match p.file_name() { Some(n) => assert(n == "file.log"), None => assert(false) }
    match p.extension() { Some(e) => assert(e == "log"), None => assert(false) }
    // Forward slashes are also separators on Windows.
    match Path.windows("C:/a/b.txt").file_name() { Some(n) => assert(n == "b.txt"), None => assert(false) }
}

test "windows: normalize resolves .. and emits canonical backslash" {
    assert(Path.windows("C:\\Users\\bob\\..\\alice").normalize().display() == "C:\\Users\\alice")
    assert(Path.windows("C:\\a\\.\\b").normalize().display() == "C:\\a\\b")
    assert(Path.windows("a\\b\\..").normalize().display() == "a")
}

test "windows: join appends with backslash" {
    assert(Path.windows("C:\\a").join("b").display() == "C:\\a\\b")
}

// ─── byte-faithful roundtrip + with_extension ──

test "path: non-UTF8 bytes survive os_bytes roundtrip; to_str is None" {
    mut raw []u8 = []u8.new()
    raw.push(47 as u8)        // '/'
    raw.push(0xFF as u8)      // invalid UTF-8 lead byte
    raw.push(0xFE as u8)
    ro p = Path.from_bytes(raw)
    ro back = p.os_bytes()
    assert(back.len() == 3)
    assert(back[1] == (0xFF as u8))
    match p.to_str() { Some(_) => assert(false), None => assert(true) }   // not valid UTF-8
}

test "path: with_extension replaces / appends" {
    assert(Path.posix("/a/b.txt").with_extension("md").display() == "/a/b.md")
    assert(Path.posix("/a/b").with_extension("md").display() == "/a/b.md")
}

test "path: equals is byte + style exact" {
    assert(Path.posix("/a/b").equals(Path.posix("/a/b")))
    assert(!Path.posix("/a/b").equals(Path.posix("/a/c")))
}
