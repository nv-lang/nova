// SPDX-License-Identifier: MIT OR Apache-2.0
// std/fs/ffi.nv — private C FFI layer for std/fs (Plan 176 Ф.2, D323).
//
// Architecture mirrors std/net (ffi / effect / public) but the filesystem is
// **fd-based** like std/io's console hooks — no opaque C handle types cross the
// boundary, only a plain OS `int` fd plus `(*u8, len)` data buffers (§3c: paths
// and data are separated; data is `(*u8, int)`). Paths cross as a NUL-terminated
// `*u8` (a validated `CStr`, §3c(1)); libuv's `uv_fs_*` converts UTF-8/WTF-8 to
// UTF-16 internally on Windows, so no CWStr marshalling is needed at this layer
// (see path.nv note; CWStr deferred — libuv subsumes it).
//
// Every blocking op parks the calling fiber via the libuv threadpool + the
// Plan 22 park/wake pattern (nova_rt/fs.c, exactly the net.c model). Non-blocking
// ops (seek = lseek, platform predicate) are direct static-inline hooks.
//
// C symbols are called by literal name (D282: `extern "C" fn`). C side:
// nova_rt/fs.h + fs.c (park/wake) and nova_rt/io_console.h (fs_seek, platform).

module std.fs

// ─── Portable open flags (Nova ⇆ C agree on these bits; fs.c translates to
//     the platform UV_FS_O_* set, so Nova never sees OS-specific flag values) ──

/// Open for reading.
const OPEN_READ = 1
/// Open for writing.
const OPEN_WRITE = 2
/// All writes append at end-of-file (O_APPEND).
const OPEN_APPEND = 4
/// Truncate to zero length on open (O_TRUNC).
const OPEN_TRUNC = 8
/// Create the file if missing (O_CREAT).
const OPEN_CREATE = 16
/// With CREATE, fail if the file already exists (O_EXCL — anti-TOCTOU, §3c).
const OPEN_EXCL = 32

// ─── Seek whence (nova_fs_seek maps to native SEEK_SET/CUR/END) ──
const SEEK_SET = 0
const SEEK_CUR = 1
const SEEK_END = 2

// ─── stat st_mode kind bits (POSIX S_IFMT >> 12; fs.c normalises Windows) ──
const KIND_FILE = 1
const KIND_DIR = 2
const KIND_SYMLINK = 3
const KIND_OTHER = 0

// ─── Blocking uv_fs_* hooks (nova_rt/fs.c) ──
// Convention (net-precedent): return >= 0 on success (fd / byte-count / 0), or a
// NEGATIVE POSIX errno on failure (fs.c translates UV_E* → POSIX errno so the
// Nova-side `kind_from_errno` is platform-stable). `path`/`data` pointers are the
// NUL-terminated path (open/stat/...) or the raw byte buffer (read/write).

// open: returns fd (>= 0) or -errno. `flags` is the portable OPEN_* bitset.
extern "C" fn fs_open(path *u8, flags int, mode int) -> int // [M-ffi-handle-newtype]
// close: 0 or -errno.
extern "C" fn fs_close(fd int) -> int
// read: fill buf[0..n] from the OS file offset (advances it); returns n (0=EOF) or -errno.
extern "C" fn fs_read(fd int, buf *mut u8, len int) -> int
// write: write len bytes at the OS file offset (advances it); returns n or -errno.
extern "C" fn fs_write(fd int, buf *u8, len int) -> int
// pread: positioned read at `offset` (does not move the cursor); n (0=EOF) or -errno.
extern "C" fn fs_read_at(fd int, buf *mut u8, len int, offset int) -> int
// pwrite: positioned write at `offset` (does not move the cursor); n or -errno.
extern "C" fn fs_write_at(fd int, buf *u8, len int, offset int) -> int
// fsync (all data + metadata): 0 or -errno.
extern "C" fn fs_fsync(fd int) -> int
// fdatasync (data only): 0 or -errno.
extern "C" fn fs_fdatasync(fd int) -> int
// stat/lstat/fstat → caller-owned image, NOT TLS ([M-fs-tls-mn-race] fix,
// net-precedent: STAT_IMAGE_BYTES = fs_stat_image_bytes(), like
// ADDR_IMAGE_BYTES = net_addr_size()). 0 or -errno; on success the img buffer
// (STAT_IMAGE_BYTES long) is filled in place. The accessors read straight off
// the `img` pointer passed to them — no ambient state, safe across any fiber/
// thread interleaving.
extern "C" fn fs_stat_image_bytes() -> int
extern "C" fn fs_stat_into(path *u8, img *mut u8) -> int
extern "C" fn fs_lstat_into(path *u8, img *mut u8) -> int
extern "C" fn fs_fstat_into(fd int, img *mut u8) -> int
extern "C" fn fs_stat_size(img *u8) -> int
extern "C" fn fs_stat_mtime_ns(img *u8) -> i64
extern "C" fn fs_stat_atime_ns(img *u8) -> i64
extern "C" fn fs_stat_ctime_ns(img *u8) -> i64
extern "C" fn fs_stat_mode(img *u8) -> int
extern "C" fn fs_stat_kind(img *u8) -> int
// Build a stat image from components, no syscall (net_addr_v4_into-style pure
// value constructor) — used by mock_fs so a mocked stat produces a
// real_fs-compatible image with no OS-owned cache anywhere.
extern "C" fn fs_stat_build_into(img *mut u8, size int, mtime_ns i64, atime_ns i64, ctime_ns i64, mode int, kind int) -> ()
// mkdir/unlink/rmdir/rename/symlink/chmod: 0 or -errno.
extern "C" fn fs_mkdir(path *u8, mode int) -> int
extern "C" fn fs_unlink(path *u8) -> int
extern "C" fn fs_rmdir(path *u8) -> int
extern "C" fn fs_rename(from *u8, to *u8) -> int
extern "C" fn fs_symlink(target *u8, link *u8) -> int
extern "C" fn fs_chmod(path *u8, mode int) -> int
// copyfile: bytes copied (>= 0) or -errno.
extern "C" fn fs_copyfile(from *u8, to *u8) -> int
// realpath: the canonical path is returned DIRECTLY as a fresh string from the
// SAME call that resolves it — no TLS, no follow-up accessor. *out_err is set
// to 0 on success or a NEGATIVE POSIX errno on failure (empty str returned).
// fsync on the parent dir (write_atomic step 5).
extern "C" fn fs_realpath_into(path *u8, out_err *mut int) -> str
extern "C" fn fs_fsync_dir(path *u8) -> int
// scandir: handle-based, NOT TLS. fs_scandir_open returns a stream handle
// (>= 0, an address-sized boxed pointer) or -errno; fs_scandir_next(h)
// advances THAT handle's own state (1 = another entry cached, 0 = done);
// fs_scandir_name/_kind(h) read its current entry. fs_scandir_close(h) is
// idempotent — call it unconditionally once done with the handle (natural EOF
// or an early break both need it released).
extern "C" fn fs_scandir_open(path *u8) -> int // [M-ffi-handle-newtype]
extern "C" fn fs_scandir_next(h int) -> int
extern "C" fn fs_scandir_name(h int) -> str
extern "C" fn fs_scandir_kind(h int) -> int
extern "C" fn fs_scandir_close(h int) -> ()

// ─── Non-blocking native hooks (io_console.h — always available, no libuv) ──
// fs_seek: lseek/_lseeki64 on the fd; returns the new absolute offset or -errno.
extern "C" fn fs_seek(fd int, offset i64, whence int) -> i64
