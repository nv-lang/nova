// d323_real_fs_test.nv — real_fs end-to-end against a temp dir in the
// worktree cwd (Plan 176 Ф.2). Validates the libuv uv_fs_* park/wake path.
// Blocking fs ops run inside a spawn fiber (the park slot lives on a spawned
// fiber, not the supervised body — the net-test pattern). Uses a relative
// scratch dir (Ф.3 brings os.temp_dir); cleans up after. Migrated from
// nova_tests/fs/real_fs_tmp.nv (Plan 182 Ф.2).
module std.fs

import std.io.{ErrorKind}

test "real_fs: write / read / stat / read_dir / remove round-trip" {
    with Fs = real_fs() {
        supervised {
            spawn {
                ro dir = "fs_rt_scratch".to_path()
                ro _ = remove_dir_all(dir)   // best-effort clean from a prior run
                match create_dir(dir) { Ok(()) => assert(true), Err(_) => assert(false) }
                ro f = dir.join("hello.txt")
                match write(f, "real bytes") { Ok(()) => assert(true), Err(_) => assert(false) }
                match read_text(f) { Ok(s) => assert(s == "real bytes"), Err(_) => assert(false) }
                match metadata(f) { Ok(m) => assert(m.len() == 10 && m.is_file()), Err(_) => assert(false) }
                match read_dir(dir) { Ok(es) => assert(es.len() == 1), Err(_) => assert(false) }
                match remove_file(f) { Ok(()) => assert(true), Err(_) => assert(false) }
                match remove_dir(dir) { Ok(()) => assert(true), Err(_) => assert(false) }
            }
        }
    }
}

test "real_fs: open nonexistent -> NotFound" {
    with Fs = real_fs() {
        supervised {
            spawn {
                match read_text("fs_rt_scratch/does_not_exist_zzz".to_path()) {
                    Ok(_)  => assert(false)
                    Err(e) => match e.kind { ErrorKind.NotFound => assert(true), _ => assert(false) }
                }
            }
        }
    }
}
