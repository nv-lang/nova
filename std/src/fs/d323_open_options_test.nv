// d323_open_options_test.nv — OpenOptions semantics over mock_fs (Plan 176
// Ф.2, D323 Q13). Migrated from nova_tests/fs/mock_options.nv (Plan 182 Ф.2).
module std.fs

import std.io.{ErrorKind}

test "mock_fs: OpenOptions create_new on existing -> AlreadyExists" {
    mut fs = MemFs.new()
    ro p = Path.posix("/exists.txt")
    with Fs = mock_fs(fs) {
        ro _ = write(p, "x")
        match OpenOptions.new().write(true).create_new(true).open(p) {
            Ok(consume fh) => { ro _ = fh.close(); assert(false) }
            Err(e) => match e.kind { ErrorKind.AlreadyExists => assert(true), _ => assert(false) }
        }
    }
}

test "mock_fs: OpenOptions append writes at EOF" {
    mut fs = MemFs.new()
    ro p = Path.posix("/log.txt")
    with Fs = mock_fs(fs) {
        ro _ = write(p, "aa")
        match File.append(p) {
            Err(_) => assert(false)
            Ok(consume f) => { ro _ = f.write("bb"); ro _ = f.close() }
        }
        match read_text(p) { Ok(s) => assert(s == "aabb"), Err(_) => assert(false) }
    }
}

test "mock_fs: append + truncate -> InvalidInput (Q13)" {
    mut fs = MemFs.new()
    with Fs = mock_fs(fs) {
        match OpenOptions.new().append(true).truncate(true).open(Path.posix("/x")) {
            Ok(consume fh) => { ro _ = fh.close(); assert(false) }
            Err(e) => match e.kind { ErrorKind.InvalidInput => assert(true), _ => assert(false) }
        }
    }
}
