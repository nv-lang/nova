// std.collections.vec (mutate) — in-place mutation + bulk operations.
//
// Single-element: push/pop/insert/remove/swap_remove/clear/truncate/reverse.
// Bulk (RawMem memcpy/memmove/memset class): extend/append/retain/copy_from/
// copy_within/fill/append_zero/compare — the `[]T` extend-family parity, now
// RawMem-backed Nova bodies.
#prelude(core, runtime, collections, protocols)
module collections.vec

import std.runtime.raw_mem.{RawMem}

// ──────────────────────────────────────────────────────────────────────────
// Element operations
// ──────────────────────────────────────────────────────────────────────────

/// Append `v` to the end, growing if necessary.
///
/// Returns `@` (self) so calls chain fluently (precedent: `StringBuilder.append`):
/// `Vec[u8].new(cap: 3).push(1 as u8).push(2 as u8)`. A bare statement
/// call `v.push(x)` still works — the returned `@` is simply ignored.
export fn Vec[T] mut @push(v T) -> @ {
    @reserve(1)
    unsafe {
        @data.write_at(@len, v)
    }
    @len += 1
}

/// Append `v`, taking ownership of it -- the consuming form of `push`. D84 mode
/// rule 3 picks it for a temporary or a `consume` binding; for a must-consume
/// `T` it is the only `push` (the copying form above is ordinary-`T` only,
/// D156 amendment 2026-09-24, point 4). Plan 246, class B.
export fn Vec[T consume] mut @push(consume v T) -> @ {
    @reserve(1)
    unsafe {
        @data.write_consume_at(@len, v)
    }
    @len += 1
}

/// Insert `v` at index `i`, taking ownership of it -- the consuming form of
/// `insert` (see the consuming `push`). Panics if `i > len`.
export fn Vec[T consume] mut @insert(i int, consume v T) -> @
    requires 0 <= i && i <= @len
{
    @reserve(1)
    unsafe {
        ro tail = @len - i
        if tail > 0 {
            RawMem.copy_n(@data.offset(i), @data.offset(i + 1), tail)
        }
        @data.write_consume_at(i, v)
    }
    @len += 1
}

/// Move every element of `other` to the end, taking ownership of `other` --
/// the consuming form of `append`. Elements move one by one (`for consume`,
/// D156), so a must-consume element is never duplicated.
export fn Vec[T consume] mut @append(consume other Vec[T]) -> @ {
    @reserve(other.len())
    for consume x in other {
        unsafe {
            @data.write_consume_at(@len, x)
        }
        @len += 1
    }
}

/// Move every element of `other` into this vector at index `i`, taking
/// ownership of `other` -- the consuming form of `splice`. Panics if `i > len`.
export fn Vec[T consume] mut @splice(i int, consume other Vec[T]) -> @
    requires 0 <= i && i <= @len
{
    ro n = other.len()
    @reserve(n)
    ro tail = @len - i
    if tail > 0 {
        unsafe {
            RawMem.copy_n(@data.offset(i), @data.offset(i + n), tail)
        }
    }
    mut k = i
    for consume x in other {
        unsafe {
            @data.write_consume_at(k, x)
        }
        k += 1
    }
    @len += n
}

/// Replace the element at `i` with `v` and hand the old one back -- a take
/// that leaves no hole (plan 246, "how to take ownership out point-wise").
/// Panics if `i` is out of bounds.
export fn Vec[T consume] mut @exchange(i int, consume v T) -> T
    requires 0 <= i && i < @len
{
    consume old = unsafe { @data.read_consume_at(i) }
    unsafe {
        @data.write_consume_at(i, v)
    }
    old
}

/// Look at the element at `i` without taking it: the element is lent to `f` as
/// a view parameter (D216 amendment 2026-09-25) -- the way to read an element
/// of a vector of must-consume values. Panics if `i` is out of bounds.
export fn Vec[T consume] @view[R](i int, f fn(T) -> R) -> R
    requires 0 <= i && i < @len
{
    unsafe { @data.view_at(i, f) }
}

/// Publish `n` elements ALREADY WRITTEN into reserved capacity: `len += n`,
/// `cap` unchanged — in-place grow-only twin of Rust `Vec::set_len(len + n)`.
/// The sanctioned way to bump live length after writing directly through the
/// `@reserve`d pointer (`mut @ptr()` + extern/RawMem writes) — replaces the
/// old header-rebuild idiom `v = Vec.new(v.ptr(), v.len()+n, v.cap())`
/// (fresh GC-header per call; owner 2026-07-18).
///
/// # Contract / unsafety
/// `unsafe fn`: caller asserts the `n` slots past `@len` are INITIALIZED.
/// Reading an uninit `u8` is garbage; for pointer-bearing `T` an uninit slot
/// is GC-hazardous (scanner walks junk) — hence the call-site obligation.
/// Range (`0 <= n <= cap - len`) is enforced by `requires` (D257).
export unsafe fn Vec[T consume] mut @advance(n int) -> @
    requires n >= 0 && n <= @cap - @len
{
    @len += n
}

/// Remove and return the last element, or `None` if empty.
export fn Vec[T consume] mut @pop() -> Option[T] {
    if @len == 0 {
        return None
    }
    @len -= 1
    Some(unsafe { @data.read_consume_at(@len) })
}

/// Insert `v` at index `i`, shifting later elements right. Panics if
/// `i > len` (i == len is an append).
export fn Vec[T] mut @insert(i int, v T) -> @
    requires 0 <= i && i <= @len
{
    @reserve(1)
    unsafe {
        // Shift the suffix `[i, len)` one slot right with a single overlap-safe
        // memmove, then drop `v` into the hole. `RawMem.copy_n` (memmove) handles
        // the dst/src overlap correctly.
        ro tail = @len - i
        if tail > 0 {
            RawMem.copy_n(@data.offset(i), @data.offset(i + 1), tail)
        }
        @data.write_at(i, v)
    }
    @len += 1
}

/// Bulk-insert (splice) every element of `other` at index `i`, shifting the
/// existing suffix `[i, len)` right by `other.len()` slots. Panics if `i > len`
/// (`i == len` is a bulk append). Overlap-safe (memmove) so a self-splice
/// (`v.splice(i, v)`) is correct.
///
/// This is the `[]T` extend-family bulk-insert. Semantics
/// mirror the retired `nova_array_insert_*` C builtin exactly (prefix kept,
/// hole opened, tail shifted, src copied — all overlap-safe). The
/// single-element `@insert(i int, v T)` above is the complementary single
/// insert.
///
/// NAMING: this is `@splice` rather than a second `@insert` overload because
/// generic-method overloads currently COLLAPSE in monomorphization —
/// `resolve_overload` cannot disambiguate `insert(i, T)` from
/// `insert(i, Vec[T])` for a concrete `Vec[int]`. Distinct names route
/// cleanly.
// [M-138.2-bulk-insert-overload] обход: fold `@splice` обратно в
// `@insert`-overload ждёт generic-method-overload-mono.
export fn Vec[T] mut @splice(i int, other Vec[T]) -> @
    requires 0 <= i && i <= @len
{
    // Snapshot `other`'s buffer/length BEFORE `@reserve` may realloc `@data`.
    // A self-insert (`v.insert(i, v)`) has `other.data == @data`; after the
    // reserve `@data` may point at a fresh buffer, so the snapshot keeps the
    // source pointer/length valid (the old buffer stays live under Boehm GC).
    ro src_len = other.len()
    if src_len > 0 {
        ro src_data = other.data
        ro tail = @len - i
        @reserve(src_len)
        unsafe {
            // Open a `src_len`-wide hole at `i`: shift the suffix `[i, len)`
            // right by `src_len` slots (memmove, overlap-safe), then copy the
            // source into the hole (memmove, robust to src being a view of self).
            if tail > 0 {
                RawMem.copy_n(@data.offset(i), @data.offset(i + src_len), tail)
            }
            RawMem.copy_n(src_data, @data.offset(i), src_len)
        }
        @len += src_len
    }
}

/// Move the element at `i` to index 0, shifting the prefix `[0, i)` right by
/// one slot. Panics if `i` is out of bounds. `i == 0` is a no-op.
///
/// One overlap-safe memmove over the prefix plus one write — half the memmove
/// traffic of `v.insert(0, v.remove(i))`, which shifts the same prefix twice
/// (once left closing the gap at `i`, once right opening the gap at 0).
export fn Vec[T consume] mut @move_to_front(i int) -> @
    requires 0 <= i && i < @len
{
    if i == 0 {
        return
    }
    unsafe {
        consume moved = @data.read_consume_at(i)
        // Shift the prefix `[0, i)` one slot right (memmove, overlap-safe),
        // then drop `moved` into the freed slot 0.
        RawMem.copy_n(@data, @data.offset(1), i)
        @data.write_consume_at(0, moved)
    }
}

/// Remove and return the element at `i`, shifting later elements left.
/// Panics if `i` is out of bounds.
export fn Vec[T consume] mut @remove(i int) -> T
    requires 0 <= i && i < @len
{
    consume removed = unsafe { @data.read_consume_at(i) }
    unsafe {
        // Shift the suffix `(i, len)` one slot left with a single overlap-safe
        // memmove, closing the gap left by the removed element.
        ro tail = @len - 1 - i
        if tail > 0 {
            RawMem.copy_n(@data.offset(i + 1), @data.offset(i), tail)
        }
    }
    @len -= 1
    removed
}

/// Remove `n` elements starting at `i`, shifting later elements left. Panics
/// if the run `[i, i + n)` is out of bounds. The removed elements are dropped,
/// so this form is written with a plain `[T]` and exists only for an ordinary
/// `T` (D156 amendment 2026-09-24, point 4); for a must-consume `T` take the
/// run out with `drain(i..i + n)`.
///
/// ```nova
/// mut v = Vec[int].of(1, 2, 3, 4, 5)
/// v.remove(1, 2)
/// assert(v.equal(Vec[int].of(1, 4, 5)))
/// ```
export fn Vec[T] mut @remove(i int, n int) -> @
    requires 0 <= i && 0 <= n && i + n <= @len
{
    ro tail = @len - i - n
    if n > 0 && tail > 0 {
        unsafe {
            RawMem.copy_n(@data.offset(i + n), @data.offset(i), tail)
        }
    }
    @len -= n
}

/// Remove the element at `i` in O(1) by swapping it with the last element,
/// then popping. Does not preserve order. Panics if `i` is out of bounds.
export fn Vec[T consume] mut @swap_remove(i int) -> T
    requires 0 <= i && i < @len
{
    consume removed = unsafe { @data.read_consume_at(i) }
    ro last = @len - 1
    if i != last {
        unsafe {
            @data.write_consume_at(i, @data.read_consume_at(last))
        }
    }
    @len -= 1
    removed
}

// ──────────────────────────────────────────────────────────────────────────
// Mutation
// ──────────────────────────────────────────────────────────────────────────

/// Drop all elements (set len = 0). The buffer is retained for reuse.
export fn Vec[T] mut @clear() -> @ {
    @len = 0
}

/// If `n < len`, shorten to exactly `n` elements. Larger `n` is a no-op.
export fn Vec[T] mut @truncate(n int) -> @ { // [M-lint-findings-param-no-contract]
    if n >= 0 && n < @len {
        @len = n
    }
}

/// Reverse the live elements in place.
export fn Vec[T consume] mut @reverse() -> @ {
    mut lo = 0
    mut hi = @len - 1
    // KEEP as while: two-pointer converge (lo++ / hi--), not a forward `0..@len` loop.
    while lo < hi {
        unsafe {
            // `(a, b) = (b, a)` tuple-assign isn't expressible with
            // method-call targets (`.write_at` isn't an lvalue) — a temp-swap
            // via `.read_at`/`.write_at` is the direct equivalent.
            consume tmp = @data.read_consume_at(lo)
            @data.write_consume_at(lo, @data.read_consume_at(hi))
            @data.write_consume_at(hi, tmp)
        }
        lo += 1
        hi -= 1
    }
}

/// Swap the elements at indices `i` and `j` in place. `i == j` is a no-op.
/// Panics if either index is out of bounds. Returns `@` for chaining.
export fn Vec[T consume] mut @swap(i int, j int) -> @
    requires 0 <= i && i < @len && 0 <= j && j < @len
{
    if i != j {
        unsafe {
            consume tmp = @data.read_consume_at(i)
            @data.write_consume_at(i, @data.read_consume_at(j))
            @data.write_consume_at(j, tmp)
        }
    }
}

/// Resize to exactly `n` elements. `n > len` appends copies of `v`; `n < len`
/// truncates (drops the tail); `n == len` is a no-op. Panics on negative `n`.
/// Returns `@` for chaining. (`@resize_with` generates new elements via a
/// closure instead of cloning a value.)
export fn Vec[T] mut @resize(n int, v T) -> @
    requires n >= 0
{
    if n < @len {
        @len = n
    } else if n > @len {
        ro start = @len
        @reserve(n - @len)
        for i in start..n {
            unsafe {
                @data.write_at(i, v)
            }
        }
        @len = n
    }
}

/// Resize to exactly `n` elements, generating each new element by calling `f()`.
/// `n > len` appends `f()` results in order; `n < len` truncates; `n == len` is
/// a no-op. Panics on negative `n`. Returns `@` for chaining.
export fn Vec[T] mut @resize_with(n int, f fn() -> T) -> @
    requires n >= 0
{
    if n < @len {
        @len = n
    } else if n > @len {
        ro start = @len
        @reserve(n - @len)
        for i in start..n {
            unsafe {
                @data.write_at(i, f())
            }
        }
        @len = n
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Bulk operations
// ──────────────────────────────────────────────────────────────────────────

/// Append every element of any iterable source `S` that yields `T`.
///
/// The source is a generic `Iter[T]`-bounded type parameter `S` (instance
/// method-level generic) rather than a distinct built-in `[]T`. It accepts a
/// built-in array literal, a `Vec[T]`, a `RangeIter`, or any other type that
/// satisfies `Iter[T]` — and keeps compiling unchanged where `[]T` ≡ `Vec[T]`.
///
/// No `reserve` pre-pass: a generic `Iter[T]` has no `len()` in general, so
/// each element is appended via `@push` (amortised ×2 growth).
///
/// Returns `@` for fluent chaining — but NOTE: because `@extend` is a
/// *method-level generic* (`[S Iter[T]]`), the `@` return is not yet inferred
/// through the generic-method emission path. A *chained* result
/// (`v.extend(xs).push(y)`) currently mis-types the receiver to `void*`.
/// Statement-form (`v.extend(xs)`, return discarded) works correctly; chained
/// use is gated on a codegen fix.
export fn Vec[T] mut @extend[S Iter[T]](items S) -> @ {
    for x in items {
        @push(x)
    }
}

// NOTE ([M-138.2-self-in-param]): the receiver-typed params below (`@append`,
// `@copy_from`, `@compare`) keep the explicit `Vec[T]` form rather than `Self`.
// `Self` in *param* position on a generic-type method is a codegen gap: it
// lowers the param's C type without the receiver substitution, emitting a
// forward-decl that conflicts with the definition. Param-`Self` stays `Vec[T]`
// until the generic-method param-type substitution lands in codegen.

/// Copy every element of `other` onto the end of `self`; `other` is left
/// **unchanged**. Accepts any contiguous buffer implementing `AsSlice[T]` —
/// `Vec[T]`, `[]T`, or any custom type with `@as_ptr`+`@len`.
/// Uses `RawMem.copy` (memmove) for the bulk transfer; `@extend` is the
/// generic `Iter` version for non-contiguous sources. Copy, **not** move —
/// matches `StringBuilder.@append` and the cross-language `append`/`addAll`
/// convention (Python/Swift/Java); a move-merge that empties `other` is
/// intentionally not offered (footgun: silently destroys the argument).
// [реестр 221.1 №381] Фасадная перегрузка для `str` на байтовом векторе.
//
// ПОЧЕМУ ПЕРЕГРУЗКА, А НЕ `#impl(AsSlice[u8])` У `str`. Протокол `AsSlice[T]`
// требует пару `@ptr()` + `@len()` (`prelude/protocols.nv`). Дать `str` метод
// `@len()` нельзя: от этого имени ушли СОЗНАТЕЛЬНО в пользу `@byte_len()` —
// у строки длина в байтах и в символах не совпадают, и одно короткое `len`
// на двоих врёт. Перегрузка даёт удобство вызова, не трогая имён `str`.
//
// СТОИТ НОЛЬ: `str @bytes()` — не копия, а вид над тем же указателем
// (`[]u8.new(@ptr, @byte_len())`, `runtime/string/core.nv`). Ровно этим
// приёмом уже пользуется `StringBuilder mut @append(s str)`.
//
// ЗАЧЕМ ЭТО РЕЕСТРУ: пока перегрузки не было, `v.append(some_str)` держался
// на НЕэнфорсенном бáунде — negodный тип проходил `nova check` молча (№381).
// С перегрузкой строка попадает в СВОЮ дверь, и энфорс бáунда можно включать
// без миграции: голую строку в generic-`append` не передаёт ни одно место
// дерева (замер 2026-08-20).
export fn []u8 mut @append(s str) -> @ { @append(s.bytes()) }

export fn Vec[T] mut @append[S AsSlice[T]](other S) -> @ {
    ro m = other.len()
    if m > 0 {
        @reserve(m)
        // memmove so self-append (`v.append(v)`) stays correct: after reserve
        // other.ptr() may equal @data, but [0,m) and [len,len+m) are distinct.
        unsafe {
            RawMem.copy_n(other.ptr(), @data.offset(@len), m)
        }
        @len += m
    }
}

/// Keep only the elements for which `pred(elem)` returns `true`, preserving
/// relative order. O(n).
///
/// Returns `@` (self) for fluent chaining.
export fn Vec[T] mut @retain(pred fn(T) -> bool) -> @ {
    mut write = 0
    for read in 0..@len {
        ro v = unsafe { @data.read_at(read) }
        if pred(v) {
            if write != read {
                unsafe {
                    @data.write_at(write, v)
                }
            }
            write += 1
        }
    }
    @len = write
}

// ─── []T extend-family parity ──
//
// These mirror the bulk operations that were C-builtins on the retired
// `NovaArray` runtime (memcpy/memmove/memset/memcmp in `NOVA_ARRAY_IMPL`).
// At `[]T ≡ Vec[T]` the `[]T` API must still offer them — now as
// RawMem-backed Nova-body methods. Semantics match the old `nova_array_*`
// helpers exactly.

/// Overwrite every live element of `self` from `other`, which must have the
/// **same length**. Overlap-safe (memmove). Panics on length mismatch.
///
/// Mirrors the old `[]T @copy_from`: the strict equal-length
/// contract avoids silent truncation — use `self[..n].copy_from(other[..n])`
/// for a partial copy.
///
/// # Examples
///
/// ```nova
/// mut dst = Vec[int].of(0, 0, 0)
/// ro src = Vec[int].of(1, 2, 3)
/// dst.copy_from(src)
/// assert(dst.equal(src))
/// ```
export fn Vec[T] mut @copy_from(other Vec[T]) -> @
    requires @len == other.len()
{
    if @len > 0 {
        unsafe {
            RawMem.copy_n(other.data, @data, @len)
        }
    }
}

/// Copy `len` elements within the same buffer from `src_from` to `dst_from`.
/// Overlap-safe (memmove). Panics if either range falls outside `[0, len)`.
///
/// Mirrors the old `[]T @copy_within`.
///
/// # Examples
///
/// ```nova
/// mut v = Vec[int].of(1, 2, 3, 4, 5)
/// v.copy_within(0, 2, 2)   // [1,2,3,4,5] -> [1,2,1,2,5]
/// assert(v.equal(Vec[int].of(1, 2, 1, 2, 5)))
/// ```
export fn Vec[T] mut @copy_within(src_from int, dst_from int, len int) -> @
    requires len >= 0 && src_from >= 0 && dst_from >= 0 && src_from + len <= @len && dst_from + len <= @len
{
    if len > 0 {
        unsafe {
            RawMem.copy_n(@data.offset(src_from), @data.offset(dst_from), len)
        }
    }
}

/// Set every live element to `v`. Element-wise for the general case; the
/// single-byte element types (`u8`/`i8`/`bool`) take a `RawMem.fill` (memset)
/// fast-path since a 1-byte memset *is* an element fill.
///
/// Mirrors the old `[]T @fill` (its `sizeof(T)==1 -> memset` path).
///
/// # Examples
///
/// ```nova
/// mut v = Vec[int].of(1, 2, 3)
/// v.fill(7)
/// assert(v.equal(Vec[int].of(7, 7, 7)))
/// ```
export fn Vec[T] mut @fill(v T) -> @ {
    if @len <= 0 {
        return
    }
    if size_of[T]() == 1 {
        // A 1-byte element fill is exactly a byte-pattern memset over the live
        // prefix. `v` is reinterpreted as its single storage byte via the cast.
        unsafe {
            RawMem.fill(@data as *mut u8, v as u8, @len)
        }
    } else {
        for i in 0..@len {
            unsafe {
                @data.write_at(i, v)
            }
        }
    }
}

/// Overwrite every live element with the result of calling `f()` (invoked once
/// per slot, in order `0..len`). The closure counterpart of `@fill(v)`.
/// Returns `@` for chaining.
export fn Vec[T] mut @fill_with(f fn() -> T) -> @ {
    for i in 0..@len {
        unsafe {
            @data.write_at(i, f())
        }
    }
}

/// Extend `self` by `n` zero-initialised elements (`memset 0` over the new
/// tail). Polymorphic over `T` (zero bytes = `0`/`NULL`/`false`/`0.0`), unlike
/// `fill` which is element-typed. Panics on negative `n`; `n == 0` is a no-op.
///
/// Mirrors the old `[]T @append_zero`. Use-case: reserve a
/// write-window in encoders, padding, length-prefix patching.
///
/// # Examples
///
/// ```nova
/// mut v = Vec[int].of(1, 2)
/// v.append_zero(3)
/// assert(v.equal(Vec[int].of(1, 2, 0, 0, 0)))
/// ```
export fn Vec[T] mut @append_zero(n int) -> @
    requires n >= 0
{
    if n == 0 {
        return
    }
    @reserve(n)
    unsafe {
        RawMem.zero_n(@data.offset(@len), n)
    }
    @len += n
}

// NOTE: `@compare` (the `Compare` protocol impl) lives in `protocols.nv`, not
// here. It was previously a byte-wise `RawMem.compare` (memcmp) bulk-op, which
// is only correct for `Vec[u8]` — for `Vec[f64]` IEEE-754 byte order ≠ numeric
// order, for `Vec[int]` little-endian byte order ≠ value order, and for
// record/pointer elements memcmp compares addresses, not content. protocols.nv
// has the element-wise `Vec[T Compare]` version that delegates to each
// element's own `@compare`. A `u8`-specialised memcmp fast-path is a perf
// followup ([M-153-vec-compare-u8-memcmp-fastpath]).

