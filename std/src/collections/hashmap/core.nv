// Реализация HashMap[K, V] в стиле Nova stdlib.
//
// Контекст. По [D26](../spec/decisions/08-runtime.md#d26), `HashMap[K, V]` живёт
// в stdlib (`std.collections.HashMap`), не встроен в язык. Встроены
// только массивы `[]T` и `[N]T` ([D27](../spec/decisions/03-syntax.md#d27)).
//
// Это *черновик реализации* — показывает как stdlib-тип выглядит на
// Nova. Open addressing + linear probing + resize. Без advanced
// оптимизаций (Robin Hood, SIMD lookup, perfect hashing).
//
// Допущения:
//   - `K` имеет операции `hash() -> u64` и `eq(other K) -> bool`
//     (структурно, [D15](../spec/decisions/02-types.md#d15)). В реальной stdlib —
//     prelude-protocol `Hash` + `Eq` с auto-derive для примитивов
//     (зависит от Q15).
//   - Использует `[]T` и `[T; N]` из [D27](../spec/decisions/03-syntax.md#d27).
//   - Методы инстанса через `@` ([D35](../spec/decisions/03-syntax.md#d35)).
//   - Поля по правилам [D36](../spec/decisions/02-types.md#d36): `readonly` для
//     invariants, без префикса для мутируемых.

module collections.hashmap

// Plan 138.2 Ф.0b (D239 / D144): de-risk regression class #4 (map-literal
// bucket arrays) BEFORE the universal `[]T ≡ Vec[T]` flip. Importing the Vec
// template here registers `generic_type_templates["Vec"]`, so the `[]Slot[K,V]`
// bucket fields below lower to a TYPED `Nova_Vec____Nova_Slot____*` backing
// (not int64-erased `NovaArray_nova_int*`) — isolated to the HashMap CU.
// vec_owned only imports raw_mem (no cycle with hashmap). Until Ф.0-final lands
// Vec in the prelude, the rest of the `[]T` world keeps NovaArray-backing.
import std.collections.vec.{Vec}

// ──────────────────────────────────────────────────────────────────────────
// Типы
// ──────────────────────────────────────────────────────────────────────────

// Plan 62.E (2026-05-18): `Hash` мигрирован в `std/prelude/protocols.nv`
// как canonical prelude protocol per D109 split policy (hash-only; equality
// вынесена в отдельный `Equal`). Удалена local-декларация чтобы избежать
// `duplicate top-level name Hash` при загрузке prelude (R27 auto-import
// делает prelude `Hash` видимым в каждом module включая
// `std.collections.hashmap`).
//
// `HashMap[K Hash, V]` ниже теперь резолвит `Hash` через cross-file
// resolve в prelude (`std.prelude.protocols.Hash`). Key collision check
// использует `==` (BinOp::Eq → nova_str_eq / int ==), что требует
// неявного Equal-контракта от K. D109 split-policy: `[K Hash + Equal]`
// будет формальным когда multi-bound syntax появится в bootstrap parser (D72 ext).
//
// Документация моевого Hash осталась в `std/prelude/protocols.nv`
// (single source of truth для `nova doc`).

// Slot — состояние ячейки в open-addressing-таблице.
//
// `Empty` — никогда не использовалась (можно остановить probing на
// поиске).
// `Tombstone` — была занята, потом удалена (probing продолжается, но
// слот можно переиспользовать на insert).
// `Occupied(K, V)` — текущий valid слот.
type Slot[K, V] enum
    | Empty
    | Tombstone
    | Occupied { key K, value V }

/// Hash map with open addressing and linear probing.
///
/// Requires `K: Hash` — a structural bound on `hash() -> u64`.
/// Grows automatically at 75% fill (load factor = 3/4).
///
/// The `map-literal` syntax `[k: v, ...]` desugars into `HashMap` via the
/// `#from_pairs` attribute (D108). A record-literal `{field: val}` coerces
/// into `HashMap[str, V]` via `#from_fields` (D55).
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].new()
/// m.insert("alice", 1)
/// m.insert("bob", 2)
/// assert(m.get("alice") == Some(1))
/// assert(m.len() == 2)
/// ```
///
/// # See Also
///
/// - `HashMap.new(cap: n)` — create with a preallocated capacity
/// - `[HashMap.from]` — from an array of pairs
/// - `[Set]` — a set built on top of HashMap
#stable(since = "0.1")
#from_fields
#from_pairs
export type HashMap[K Hash, V] priv {
    // buckets — массив слотов. Длина — степень двойки (для битовой маски
    // вместо modulo — `idx & (len - 1)`). Internal: layout может изменяться,
    // не обращайся напрямую. Используй @len() / @get() / @insert().
    buckets []Slot[K, V]

    // count — число Occupied слотов. Не считая Tombstone. Internal:
    // экспонируется через @len().
    count int

    // tombstones считаются отдельно — для решения о rehash при
    // accumulating tombstones (даже если count низкий, много
    // tombstones замедляют lookup). Internal.
    tombstones int
}

// ──────────────────────────────────────────────────────────────────────────
// Constructor / static
// ──────────────────────────────────────────────────────────────────────────

// entry-count (сколько вставок без rehash) → требуемый минимум бакетов:
// ceil(4 * min_capacity / 3), округлённый вверх до степени двойки. Общий
// sizing-helper для `new()` и сеттера `mut @cap(n)` (ex-`with_capacity`,
// D372 amend 2026-07-06 — with_capacity удалён, ёмкость = свойство `cap`).
fn hashmap_bucket_count_for(min_capacity int) -> int {
    ro needed = if min_capacity < 4 { 4 } else { (min_capacity * 4 + 2) / 3 }
    next_pow2(needed)
}

/// Create an empty `HashMap` with an initial capacity of 16.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].new()
/// assert(m.is_empty())
/// ```
#stable(since = "0.1")
export fn HashMap[K, V].new(cap int = 16) -> HashMap[K, V]
    requires cap >= 0
{
    HashMap {
        buckets: new_buckets[K, V](hashmap_bucket_count_for(cap)),
        count: 0,
        tombstones: 0,
    }
}

/// Build a `HashMap` from an array of `(key, value)` pairs.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].from([("a", 1), ("b", 2)])
/// assert(m.get("a") == Some(1))
/// assert(m.len() == 2)
/// ```
#stable(since = "0.1")
export fn HashMap[K, V].from(pairs [](K, V)) -> Self { // [M-lint-findings-static-conversion]
    mut m = Self.new(cap: pairs.len() * 2)
    for (k, v) in pairs {
        m.insert(k, v)
    }
    m
}

// ──────────────────────────────────────────────────────────────────────────
// Методы инстанса
// ──────────────────────────────────────────────────────────────────────────

/// Number of elements in the map (tombstone slots not counted).
#stable(since = "0.1")
export fn HashMap[K, V] @len() -> int => @count

/// Returns `true` if the map is empty.
#stable(since = "0.1")
export fn HashMap[K, V] @is_empty() -> bool => @count == 0

/// Total capacity of the internal bucket array.
///
/// [M-unwrap-twins-retraction] (2026-07-07): the `@capacity()` alias was
/// RETRACTED (it duplicated the canonical `@cap()`, D9) — `@cap()` is now
/// the single 0-arg getter of the `cap`/`cap(n)` property pair.
#stable(since = "0.1")
export fn HashMap[K, V] @cap() -> int => @buckets.len()

/// Set the capacity to guarantee at least `n` entries fit without a further
/// rehash (D117 AMEND setter: same-name 1-arg overload of `@cap()`) — the
/// instance-method replacement for the removed `HashMap[K, V].with_capacity`
/// static constructor: `HashMap[K, V].new(cap: n)` reproduces the OLD
/// `with_capacity(n)`'s exact bucket count (entry-count → bucket-count sizing
/// unchanged: `ceil(4n/3)`, next pow2), because `@count == 0` right after
/// `new()` — see the shrink branch below.
///
/// On a map that already holds entries, a hash table cannot shrink its bucket
/// layout without discarding live data, so this setter only GROWS in that
/// case (`n` at or below the current capacity is a no-op). It MAY also shrink
/// when the map is currently empty (`@count == 0`, e.g. right after `new()`
/// or `clear()`) — a cheap reallocation with nothing to lose — which is what
/// lets `new().cap(n)` land on the exact target size regardless of `new()`'s
/// own default (16-entry) baseline.
export fn HashMap[K, V] mut @cap(n int) -> @
    requires n >= 0
{
    ro target = hashmap_bucket_count_for(n)
    if target != @buckets.len() && (target > @buckets.len() || @count == 0) {
        @rehash(target)
    }
}

/// Find the value by key. Returns `Some(value)` or `None`.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].new()
/// m.insert("x", 10)
/// assert(m.get("x") == Some(10))
/// assert(m.get("y") == None)
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] @get(key K) -> Option[V] {
    ro idx = @find_slot(key)
    match @buckets[idx] {
        Occupied { value } => Some(value)        // partial: key игнорируется
        _                  => None
    }
}

/// Check whether the key is present without extracting its value.
#stable(since = "0.1")
export fn HashMap[K, V] @contains(key K) -> bool =>
    if Some(_) = @get(key) { true } else { false }

/// Insert a `(key, value)` pair.
///
/// If the key already exists — overwrites and returns `Some(old_value)`.
/// Otherwise inserts and returns `None`. May trigger a rehash.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].new()
/// assert(m.insert("a", 1) == None)
/// assert(m.insert("a", 2) == Some(1))
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] mut @insert(key K, value V) -> Option[V] {
    @maybe_grow()

    ro idx = @find_slot(key)
    match @buckets[idx] {
        Occupied { key: _, value: old } => {
            // Замена существующего значения — count не меняется.
            @buckets[idx] = Occupied { key, value }
            Some(old)
        }
        Tombstone => {
            // Переиспользуем tombstone — count++, tombstones--.
            @buckets[idx] = Occupied { key, value }
            @count += 1
            @tombstones -= 1
            None
        }
        Empty => {
            // Новая запись.
            @buckets[idx] = Occupied { key, value }
            @count += 1
            None
        }
    }
}

/// Fast-path insertion without a duplicate check — only for map-literal desugar.
///
/// Used by the compiler when desugaring `[k: v, ...]` (D108).
/// Call only on a fresh map after `new().cap(n)` where `n >=` the final count.
///
/// # Contracts
///
/// ```nova,must_verify
/// // requires: the map was created via new().cap(n), n >= the final count
/// // requires: the key is not present in the map
/// // ensures: @len() == old(@len()) + 1
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] mut @insert_new(key K, value V) {
    ro idx = @find_slot(key)
    @buckets[idx] = Occupied { key, value }
    @count += 1
}

/// Create an independent copy of the map (deep / recursively element-wise).
///
/// Per the D230 amend `Clone` is a **deep / recursive** protocol: `clone()`
/// clones element-wise via `K.@clone()` / `V.@clone()`, under the conditional
/// bound `[K Clone, V Clone]` (Rust `impl<K: Clone, V: Clone> Clone for
/// HashMap<K,V>`).
///
/// Plan 138.4 Ф.1 (G-C, [M-138.3-clone-bound-unsupported] RESOLVED): element-wise
/// generic `k.clone()` / `v.clone()` now dispatches correctly for any
/// K/V. Previously a primitive K/V (no `int.@clone()` / `str.@clone()`) mis-routed
/// the unbound `.clone()` into an unrelated foreign `@clone` → CC-FAIL/crash.
/// Codegen now resolves a primitive `.clone()` to built-in identity-copy, and
/// a record K/V — to `K.@clone()` (or identity if the record has no `@clone`).
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].from([("a", 1)])
/// let m2 = m.clone()
/// assert(m2.get("a") == Some(1))
/// ```
#stable(since = "0.1")
export fn HashMap[K Clone, V Clone] @clone() -> HashMap[K, V] {
    mut copy = HashMap[K, V].new(cap: @count)
    for (k, v) in @iter() {
        copy.insert_new(k.clone(), v.clone())
    }
    copy
}

/// Order-independent structural equality — `true` iff both maps have the same
/// length and every pair `(k, v)` from `self` is present in `other` with an equal
/// value (`other.get(k) == Some(v)`). This implements the `Equal` protocol (D109/D237)
/// for `HashMap[K, V]`, a mirror of Rust `impl<K: Eq+Hash, V: Eq> PartialEq`.
///
/// [M-172.1-option-hashmap-eq-structural]: provides the element-wise eq that
/// `emit_field_eq` routes to for a nested `HashMap` (Option/sum field),
/// as it does for `Vec[T]`. Works for any `K`/`V` with a defined `==`; opaque types
/// degrade to identity. `K` already carries the `Hash` bound from the type; `==` on `V`
/// dispatches structurally in codegen (no explicit `[V Equal]` needed — as with `Vec[T] @equal`).
///
/// # Examples
///
/// ```nova
/// let a = HashMap[str, int].from([("x", 1), ("y", 2)])
/// let b = HashMap[str, int].from([("y", 2), ("x", 1)])
/// assert(a.equal(b))   // order-independent
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] @equal(other HashMap[K, V]) -> bool {
    if @len() != other.len() {
        return false
    }
    for (k, v) in @iter() {
        match other.get(k) {
            Some(ov) => {
                if v != ov {
                    return false
                }
            }
            None => return false
        }
    }
    true
}

/// Merge all pairs from `other` into `self` (override semantics: existing keys are overwritten).
///
/// # Examples
///
/// ```nova
/// let mut a = HashMap[str, int].from([("x", 1)])
/// let mut b = HashMap[str, int].from([("x", 99), ("y", 2)])
/// a.merge_from(b)
/// assert(a.get("x") == Some(99))
/// assert(a.get("y") == Some(2))
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] mut @merge_from(other HashMap[K, V]) {
    for (k, v) in other {
        @insert(k, v)
    }
}

/// Return a new `HashMap` of the pairs for which `pred(k, v)` returns `true`.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].from([("a", 1), ("b", 2), ("c", 3)])
/// let big = m.filter(|_, v| v > 1)
/// assert(big.len() == 2)
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] @filter(pred fn(K, V) -> bool) -> HashMap[K, V] {
    mut out = HashMap[K, V].new(cap: @count)
    for (k, v) in @iter() {
        if pred(k, v) { out.insert_new(k, v) }
    }
    out
}

// Plan 56 deferred: @map_values[U] / @map_keys[K2] требуют method-level
// generic params на generic type (HashMap[K,V].@method[U] — два уровня
// generic). Plan 48 mono pass partial — sentinel registered, но body emit
// fails. Полное закрытие — в Plan 60 (method-level generic mono).
//
// Workaround: write inline:
//   let mut out HashMap[K, U] = []
//   for i in 0..m.buckets.len {
//       match m.buckets[i] {
//           Occupied { key, value } => out.insert_new(key, f(value))
//           _ => {}
//       }
//   }

/// Remove the pair by key. Returns `Some(value)` if the key was present, otherwise `None`.
///
/// Leaves a tombstone slot — the internal array does not shrink.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].from([("a", 1)])
/// assert(m.remove("a") == Some(1))
/// assert(m.remove("a") == None)
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] mut @remove(key K) -> Option[V] {
    ro idx = @find_slot(key)
    match @buckets[idx] {
        Occupied { value } => {                  // partial: key игнорируется
            @buckets[idx] = Tombstone
            @count -= 1
            @tombstones += 1
            Some(value)
        }
        _ => None
    }
}

/// Remove all elements. Does not free the internal array (capacity is kept).
#stable(since = "0.1")
export fn HashMap[K, V] mut @clear() {
    for i in 0..@buckets.len() {
        @buckets[i] = Empty
    }
    @count = 0
    @tombstones = 0
}

// Plan 52.x / 55 / 56 — closure: @clone() / @merge_from() (объявлены
// выше) РАБОТАЮТ. mono-pass corruption, мешавшая generic helper-methods
// с pattern-match, устранена Plan 55.4 (save/restore current_fn_return_ty
// + protocol-method whitelist) + 55.5 (mono name-collision). Plan 56
// разблокировал @clone codegen, Plan 59 Ф.7.2 переписал тело на
// idiomatic `for (k, v)`. Map-spread `[...m, k: v]` тоже работает
// (Plan 55 spread-инфраструктура). Regression-покрытие:
// nova_tests/map_literals/positive_clone_merge.nv + positive_spread.nv.

/// Return the value by key, or insert `fallback()` and return it.
///
/// # Examples
///
/// ```nova
/// let mut counts = HashMap[str, int].new()
/// let prev = counts.get_or_insert("foo", || 0)
/// counts.insert("foo", prev + 1)
/// assert(counts.get("foo") == Some(1))
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] mut @get_or_insert(key K, fallback fn() -> V) -> V {
    if Some(v) = @get(key) {
        return v
    }
    ro v = fallback()
    @insert(key, v)
    v
}

// ──────────────────────────────────────────────────────────────────────────
// Итерация
// ──────────────────────────────────────────────────────────────────────────

// Iterator pattern — структурный тип для for-цикла ([D15](../spec/decisions/02-types.md#d15)).
// GC keeps map alive via field reference (D43 — нет &T / borrow в Nova).
type HashMapIter[K, V] {
    map HashMap[K, V]
    pos int
}

/// Iterator over `(key, value)` pairs in an arbitrary order.
///
/// # Examples
///
/// ```nova
/// let mut m = HashMap[str, int].from([("a", 1), ("b", 2)])
/// for (k, v) in m.iter() {
///     assert(v > 0)
/// }
/// ```
#stable(since = "0.1")
export fn HashMap[K, V] @iter() -> HashMapIter[K, V] =>
    { map: @, pos: 0 }

// HashMapIter mut @next() — стандартная операция для for-loop.
//
// Структурно совместима с любым итератором: { next() -> Option[T] }.
export fn HashMapIter[K, V] mut @next() -> Option[(K, V)] {
    while @pos < @map.buckets.len() {
        ro slot = @map.buckets[@pos]
        @pos += 1
        if Occupied { key, value } = slot {
            return Some((key, value))
        }
    }
    None
}

/// Iterator over keys only, in an arbitrary order.
#stable(since = "0.1")
export fn HashMap[K, V] @keys() -> KeysIter[K, V] =>
    { inner: @iter() }

type KeysIter[K, V] { inner HashMapIter[K, V] }

export fn KeysIter[K, V] mut @next() -> Option[K] =>
    match @inner.next() {
        Some((k, _)) => Some(k)
        None         => None
    }

/// Iterator over values only, in an arbitrary order.
#stable(since = "0.1")
export fn HashMap[K, V] @values() -> ValuesIter[K, V] =>
    { inner: @iter() }

type ValuesIter[K, V] { inner HashMapIter[K, V] }

export fn ValuesIter[K, V] mut @next() -> Option[V] =>
    match @inner.next() {
        Some((_, v)) => Some(v)
        None         => None
    }

// ──────────────────────────────────────────────────────────────────────────
// Внутренние helpers
// ──────────────────────────────────────────────────────────────────────────

// HashMap.@find_slot(key) — найти индекс слота для ключа.
//
// Возвращает индекс либо Occupied слота с этим ключом, либо
// первого Empty/Tombstone в probing-цепочке.
//
// Linear probing: cap-mask вместо modulo.
fn HashMap[K, V] @find_slot(key K) -> int {
    ro mask = @buckets.len() - 1
    mut idx = (key.hash() as int) & mask
    mut first_tombstone = -1

    loop {
        match @buckets[idx] {
            Empty => {
                // Если по пути встретили tombstone — переиспользуем
                // его. Иначе — первый Empty.
                return if first_tombstone >= 0 { first_tombstone } else { idx }
            }
            Tombstone => {
                // Запоминаем первый tombstone, продолжаем поиск.
                if first_tombstone < 0 { first_tombstone = idx }
            }
            Occupied { key: k } => {             // partial: value игнорируется
                if k == key { return idx }
            }
        }
        idx = (idx + 1) & mask
    }
}

// HashMap.mut @maybe_grow() — пересоздать массив, если load factor
// превышен или слишком много tombstones.
// Load factor = 3/4 (75%): used * 4 < buckets * 3 → не растём.
fn HashMap[K, V] mut @maybe_grow() {
    ro used = @count + @tombstones
    if used * 4 < @buckets.len() * 3 { return }

    // Если tombstones — большая часть, можно rehash в тот же размер.
    // Иначе удваиваем capacity.
    ro new_cap = if @tombstones * 2 > @count {
        @buckets.len()
    } else {
        @buckets.len() * 2
    }

    @rehash(new_cap)
}

// HashMap.mut @rehash(new_cap) — пересчёт хешей в новом массиве.
//
// Используется при росте и при cleanup tombstones.
fn HashMap[K, V] mut @rehash(new_cap int) {
    ro old_buckets = @buckets
    @buckets = new_buckets[K, V](new_cap)
    @count = 0
    @tombstones = 0

    for slot in old_buckets {
        if Occupied { key, value } = slot {
            @insert(key, value)
        }
    }
}

// new_buckets(cap) — создать массив Empty слотов длины cap.
//
// Не метод HashMap, а свободная функция: используется в new() и
// rehash() до того, как HashMap собран.
//
// Plan 138.2 Ф.0b (D239 / D144): построение bucket-массива идёт через
// ЯВНЫЙ `Vec[Slot[K, V]]` API (`Vec[...]​.with_capacity` + `.push`), а не
// через `[]Slot[K, V]`-литерал-форму. Причина: до Ф.0-final флипа `[]T` в
// ПОЗИЦИИ-ЗНАЧЕНИЯ (`[]T.with_capacity`, `arr.push`) ещё лоуэрится по
// int64-erased NovaArray-пути (emit_c.rs D38 array-static-method, без
// Vec-gate), тогда как `[]Slot[K,V]` в ТИПОВОЙ позиции (поле `_buckets`,
// return type) уже резолвится в типизированный `Nova_Vec____Nova_Slot____*`
// под gate `generic_type_templates["Vec"]`. Эта рассинхронизация давала
// возврат int-erased буфера под типизированным Vec-указателем → битый rehash
// (повреждённый readback после @maybe_grow). Явный `Vec[...]` строит
// типизированное хранилище согласованно с типом поля/return — изолированно в
// HashMap CU, до универсального флипа.
//
// [M-vec-spelling-hashmap-buckets-array-gap] (vec-sweep, 2026-07-06): проверено
// заново — замена на `-> []Slot[K, V]` + `[]Slot[K, V].with_capacity(cap)` даёт
// RUN-FAIL (rehash on growth и др. ломаются на рантайме, не на компиляции); гэп
// [M-153.x-array-new-not-vec] всё ещё жив. ИСКЛЮЧЕНИЕ из []T-канона до фикса
// static-dispatch разрыва между `[]T`-значением и типизированным `Vec[T]`.
fn new_buckets[K, V](cap int) -> Vec[Slot[K, V]] { // [M-153.x-array-new-not-vec]
    mut buckets = Vec[Slot[K, V]].new(cap: cap) // [M-153.x-array-new-not-vec]
    for _ in 0..cap {
        buckets.push(Slot.Empty)
    }
    buckets
}

// next_pow2(n) — наименьшая степень двойки ≥ n.
//
// Чистая функция. При n ≤ 1 возвращает 1.
fn next_pow2(n int) -> int {
    if n <= 1 { return 1 }
    mut x = n - 1
    x = x | (x >> 1)
    x = x | (x >> 2)
    x = x | (x >> 4)
    x = x | (x >> 8)
    x = x | (x >> 16)
    x = x | (x >> 32)
    x + 1
}

// ──────────────────────────────────────────────────────────────────────────
// Что показывает эта реализация
// ──────────────────────────────────────────────────────────────────────────
//
// 1. **HashMap — обычный stdlib-тип**, не встроен в язык. Все
//    операции — методы Nova через `@` (D35). Никакой магии.
//
// 2. **Generic-параметры `[K, V]`** работают через мономорфизацию
//    (как Rust/C++). Структурное требование «K имеет hash() и eq()»
//    проверяется компилятором по [D15](../spec/decisions/02-types.md#d15).
//
// 3. **Sum-type Slot[K, V]** — три состояния (Empty, Tombstone,
//    Occupied) с exhaustive match. Каждый бранч проверяется
//    компилятором.
//
// 4. **`readonly` поля** (load_factor, initial_capacity) показывают
//    [D36](../spec/decisions/02-types.md#d36) — invariants нельзя случайно
//    перезаписать.
//
// 5. **`mut @method` vs `@method`** — `insert`/`remove`/`clear`
//    мутируют, `get`/`contains`/`len` — нет. Видно в сигнатуре.
//
// 6. **Тесты без моков** — HashMap чистый, не зависит от эффектов.
//    Просто `assert(m.get("a") == Some(1))`. Ни Db, ни Time, ни Logger.
//
// 7. **Iterator pattern** через структурный тип — `for k in m.keys()`
//    работает потому что `KeysIter` имеет `mut @next() -> Option[K]`.
//
// Что **не** реализовано (для production-stdlib):
//   - Robin Hood hashing (variance reduction для probe distance)
//   - SIMD lookup (groupwise comparison как в hashbrown)
//   - HashDoS protection (рандомизированный seed, как в Rust)
//   - shrink_to_fit, reserve
//   - Entry API (`entry().or_insert(default)`) — выше get_or_insert
//     это упрощённая версия
//   - drain, retain
//
// Для examples/ — этого достаточно. Реальный std.collections.HashMap
// в Nova будет похож на hashbrown в Rust по сложности.
