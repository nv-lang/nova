// std.collections.vec_iter — ZERO-COST (generic-over-source) lazy iterator
// adapters & terminators on `Vec[T]`.
//
// Plan 153.2 Ф.2 (D260, STAGE 2). The Rust-style `Map<I, F>` / `Filter<I, P>`
// iterator design: each adapter is its OWN generic-over-source `value` record
// that holds the upstream iterator INLINE (a field `src I`, not a boxed `step`
// closure). `@next()` dispatches `(@src).next()` by STATIC, monomorphized call
// — there is NO per-element function-pointer indirection and NO heap box of the
// source. A chain `v.iter().map(f).filter(p)` monomorphizes to a single
// NESTED concrete type `FilterIter[MapIter[VecIter[int], int, int], int]`, and
// every `.next()` inlines down to the base `VecIter.next()`.
//
// ── Relationship to the boxed-fluent `vec_lazy` (`BoxIter`)
//
// `vec_lazy.nv` (the `BoxIter[T] { step fn()->Option[T] }` layer) is RETAINED
// unchanged. It is the closure-fluent surface: ONE erased cursor type, uniform
// `BoxIter[T]` at every stage, at the cost of ~3 heap allocations PER adapter
// (`nova_lambda_N_env` + a `_box_src` box of the captured source + a
// `NovaClosBase`) plus a `step()` pointer call per element. This module is the
// allocation-free alternative: ZERO heap allocations in the adapter chain
// itself (only the user's `f`/`pred` closures still capture). The two coexist
// behind separate explicit imports.
//
// ── Why a SEPARATE, explicitly-imported sibling FILE-module
//
// Same rationale as `vec_lazy` / `vec_seq`: a prelude-global generic-type
// method whose body stores/forwards a CLOSURE (`f`/`pred`) leaks its method-
// level generics and its callback params into every compilation unit's merged
// body ([M-codegen-var-types-fn-scope] + D145). A unit with a top-level `fn f`
// would collide. The adapters stay behind an opt-in
// `import std.collections.vec_iter`.
//
// ── ZERO-COST measurement (Plan 153.2 Ф.2)
//
// For `v.iter().map(|x| x*10).filter(|x| x>25).collect()`:
//   * adapter-record allocations : 0  (by-value `NovaValue_<…>` mono, Stage 1)
//   * source-box (`_box_src`)     : 0  (source held inline as `src I`)
//   * step-closure (`NovaClosBase`) for SOURCE threading : 0  (static dispatch)
// The only residual heap is the user's `f`/`pred` closure env — a closure-as-
// mono-type lift is out of scope for 153.2 ([M-153.2-closure-as-mono-type]).
//
// ── Coverage / known limits
//
// `T` flows through unchanged at `filter`; `map` retargets to `U`. The element
// type and source type are both monomorphized, so each distinct chain shape is
// its own concrete type (Rust-identical). The current surface covers:
// adapters: map / filter / filter_map / take / skip / enumerate / step_by
// terminators: collect / collect_into / fold / sum / count / any / all /
//              find / for_each / reduce / min / max / nth / last / collect_set
//
// ── `SplitIter` / `RSplitIter` — lazy `str.split()` family (Plan 199)
//
// `str @split`/`@splitn`/`@split_terminator` (forward) and `@rsplit`/
// `@rsplitn` (backward) live in `std/runtime/string/search.nv` (their
// historical home, `runtime.string`) but return `SplitIter`/`RSplitIter`
// TYPES DECLARED HERE. Why here and not next to the constructors:
// `runtime.string` is `#no_prelude` and links into EVERY compiled program
// (str is foundational); if it imported `Next`/this generic-over-source
// adapter family directly, every program — even ones that never touch
// `vec_iter` — would drag the closure-carrying adapter bodies into its
// merged compilation unit (the same risk this file's own header warns
// about for `map`/`filter`). Putting the TYPE + `#impl(Next[str])` here
// (an opt-in sibling module that already depends on `Next`) keeps
// `runtime.string` blissfully unaware of `Next`/`vec_iter`, while
// `search.nv` only references the `SplitIter`/`RSplitIter` NAMES (an
// ordinary cross-module type reference — cycles between modules are
// allowed by the resolver, D291/Plan 162, so this is a plain forward
// reference, not a hazard). All fields are plain (not `priv`) so the
// constructor functions in the OTHER module can build the record literal
// directly. `SplitIter` folds `split`/`splitn`/`split_terminator` into ONE
// type via a `limit` (`-1` = unlimited, `0` = empty, `n` = Rust `splitn`
// semantics — last part is the unsplit remainder) and a `terminator` flag
// (omit an empty trailing segment). `RSplitIter` is the mirror-image
// backward scanner for `rsplit`/`rsplitn` (no terminator variant — Nova's
// `str` surface never had `rsplit_terminator`).
//
// ── Comparison: iterator entry point
//
// Nova  : v.iter().map(…)   — explicit cursor (same as Rust)
// Rust  : v.iter().map(…)   — explicit cursor; .into_iter()/.iter_mut() variants
// Swift : v.map(…)          — methods directly on Array; lazy via v.lazy.map(…)
// Kotlin: v.map(…)          — extension fns on Iterable; lazy via v.asSequence().map(…)
// Java  : v.stream().map(…) — explicit stream cursor, similar to Nova/Rust
// `enumerate` yields `(int, T)` pairs via `EnumerateIter`; `take`/`skip` are
// stateful adapters with an inline counter field.

module collections.vec_iter

import std.collections.vec.{Vec, VecIter}
import std.collections.set.{Set}
import std.prelude.collections.{Next}
import std.runtime.raw_mem.{RawMem}

// ──────────────────────────────────────────────────────────────────────────
// Adapter types (generic-over-source `value` records — held inline, by value)
// ──────────────────────────────────────────────────────────────────────────

/// Lazily maps each `T` yielded by the inline upstream `src` through `f` to a
/// `U`. `I` is the concrete upstream iterator type (baked into the mono name).
export type MapIter[I, T, U] value { mut src I, priv f fn(T) -> U }

/// Lazily keeps only the `T`s for which `pred` holds, pulling from the inline
/// upstream `src`.
export type FilterIter[I, T] value { mut src I, priv pred fn(T) -> bool }

/// Lazily map-and-filter: `f` returns `Some(u)` to yield, `None` to skip.
export type FilterMapIter[I, T, U] value { mut src I, priv f fn(T) -> Option[U] }

/// Lazily yield at most `left` elements, then stop.
export type TakeIter[I, T] value { mut src I, mut left int }

/// Lazily skip the first `n` elements, then yield the rest.
export type SkipIter[I, T] value { mut src I, mut to_skip int }

/// Lazily pair each element with its 0-based index `(int, T)`.
export type EnumerateIter[I, T] value { mut src I, mut i int }

// ──────────────────────────────────────────────────────────────────────────
// `next()` — static, monomorphized dispatch on the inline source
// ──────────────────────────────────────────────────────────────────────────

/// Advance: pull one from `src`, map through `f`.
#impl(Next[U])
export fn MapIter[I, T, U] mut @next() -> Option[U] => match @src.next() {
    Some(x) => Some((@f)(x)),
    None => None,
}

/// Advance: pull from `src` until `pred` holds (or the source is exhausted).
#impl(Next[T])
export fn FilterIter[I, T] mut @next() -> Option[T] {
    while true {
        match @src.next() {
            Some(x) => { if (@pred)(x) { return Some(x) } },
            None => return None,
        }
    }
    None
}

/// Advance: pull from `src`, applying `f`; skip `None`, yield `Some(u)`.
#impl(Next[U])
export fn FilterMapIter[I, T, U] mut @next() -> Option[U] {
    while true {
        match @src.next() {
            Some(x) => match (@f)(x) {
                Some(u) => return Some(u),
                None => {},
            },
            None => return None,
        }
    }
    None
}

#impl(Next[T])
export fn TakeIter[I, T] mut @next() -> Option[T] {
    if @left <= 0 { return None }
    @left -= 1
    @src.next()
}

#impl(Next[T])
export fn SkipIter[I, T] mut @next() -> Option[T] {
    while @to_skip > 0 {
        @to_skip -= 1
        match @src.next() {
            Some(_) => {},
            None => return None,
        }
    }
    @src.next()
}

/// Advance: pull one from `src`, pair it with the current index counter.
#impl(Next[(int,T)])
export fn EnumerateIter[I, T] mut @next() -> Option[(int, T)] {
    match @src.next() {
        Some(x) => {
            ro idx = @i
            @i += 1
            Some((idx, x))
        },
        None => None,
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Entry bridge + chainable adapter methods
// ──────────────────────────────────────────────────────────────────────────

// ── adapters ON a `VecIter[T]` source (chain entry) ─────────────────────────

/// Lazily apply `f` to each element of the vector iterator.
export fn VecIter[T] @map[U](f fn(T) -> U) -> MapIter[VecIter[T], T, U] => { src: @, f }

/// Lazily keep only elements for which `pred` holds.
export fn VecIter[T] @filter(pred fn(T) -> bool) -> FilterIter[VecIter[T], T] => { src: @, pred }

/// Lazily map-and-filter the vector iterator.
export fn VecIter[T] @filter_map[U](f fn(T) -> Option[U]) -> FilterMapIter[VecIter[T], T, U] => { src: @, f }

// ── adapters ON a `MapIter` source (continue the chain) ─────────────────────

export fn MapIter[I, T, U] @map[V](f fn(U) -> V) -> MapIter[Self, U, V] => { src: @, f }
export fn MapIter[I, T, U] @filter(pred fn(U) -> bool) -> FilterIter[Self, U] => { src: @, pred }
export fn MapIter[I, T, U] @filter_map[V](f fn(U) -> Option[V]) -> FilterMapIter[Self, U, V] => { src: @, f }

// ── adapters ON a `FilterIter` source (continue the chain) ──────────────────

export fn FilterIter[I, T] @map[U](f fn(T) -> U) -> MapIter[Self, T, U] => { src: @, f }
export fn FilterIter[I, T] @filter(pred fn(T) -> bool) -> FilterIter[Self, T] => { src: @, pred }
export fn FilterIter[I, T] @filter_map[U](f fn(T) -> Option[U]) -> FilterMapIter[Self, T, U] => { src: @, f }

// ── adapters ON a `FilterMapIter` source (continue the chain) ───────────────

export fn FilterMapIter[I, T, U] @map[V](f fn(U) -> V) -> MapIter[Self, U, V] => { src: @, f }
export fn FilterMapIter[I, T, U] @filter(pred fn(U) -> bool) -> FilterIter[Self, U] => { src: @, pred }

// ── @take / @skip / @enumerate — per adapter type ────────────────────────────
//
// These cannot be blanket (return type contains the concrete adapter name),
// so one definition per source type is required.

export fn VecIter[T] @take(n int) -> TakeIter[Self, T]
    requires n >= 0
    => { src: @, left: n }
export fn VecIter[T] @skip(n int) -> SkipIter[Self, T]
    requires n >= 0
    => { src: @, to_skip: n }

export fn MapIter[I, T, U] @take(n int) -> TakeIter[Self, U]
    requires n >= 0
    => { src: @, left: n }
export fn MapIter[I, T, U] @skip(n int) -> SkipIter[Self, U]
    requires n >= 0
    => { src: @, to_skip: n }

export fn FilterIter[I, T] @take(n int) -> TakeIter[Self, T]
    requires n >= 0
    => { src: @, left: n }
export fn FilterIter[I, T] @skip(n int) -> SkipIter[Self, T]
    requires n >= 0
    => { src: @, to_skip: n }

export fn FilterMapIter[I, T, U] @take(n int) -> TakeIter[Self, U]
    requires n >= 0
    => { src: @, left: n }
export fn FilterMapIter[I, T, U] @skip(n int) -> SkipIter[Self, U]
    requires n >= 0
    => { src: @, to_skip: n }

export fn TakeIter[I, T] @take(n int) -> TakeIter[Self, T]
    requires n >= 0
    => { src: @, left: n }
export fn TakeIter[I, T] @skip(n int) -> SkipIter[Self, T]
    requires n >= 0
    => { src: @, to_skip: n }
export fn TakeIter[I, T] @map[U](f fn(T) -> U) -> MapIter[Self, T, U] => { src: @, f }
export fn TakeIter[I, T] @filter(pred fn(T) -> bool) -> FilterIter[Self, T] => { src: @, pred }

export fn SkipIter[I, T] @take(n int) -> TakeIter[Self, T]
    requires n >= 0
    => { src: @, left: n }
export fn SkipIter[I, T] @skip(n int) -> SkipIter[Self, T]
    requires n >= 0
    => { src: @, to_skip: n }
export fn SkipIter[I, T] @map[U](f fn(T) -> U) -> MapIter[Self, T, U] => { src: @, f }
export fn SkipIter[I, T] @filter(pred fn(T) -> bool) -> FilterIter[Self, T] => { src: @, pred }

// ── @step_by — yields every n-th element (zero-cost, inline counter) ────────
//
// `StepByIter` holds the upstream inline (no box); the skip loop is a direct
// static `@src.next()` call — zero indirection per element.

/// Lazily yield every `n`-th element (first, 1+n, 1+2n, …). `n > 0` required.
export type StepByIter[I, T] value { mut src I, priv step int, mut first bool, mut rem int }

#impl(Next[T])
export fn StepByIter[I, T] mut @next() -> Option[T] {
    if @first {
        @first = false
        return @src.next()
    }
    mut i = @rem
    while i > 0 {
        i -= 1
        match @src.next() {
            Some(_) => {},
            None => return None,
        }
    }
    @src.next()
}

export fn VecIter[T]         @step_by(n int) -> StepByIter[Self, T]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }
export fn MapIter[I, T, U]   @step_by(n int) -> StepByIter[Self, U]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }
export fn FilterIter[I, T]   @step_by(n int) -> StepByIter[Self, T]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }
export fn TakeIter[I, T]     @step_by(n int) -> StepByIter[Self, T]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }
export fn SkipIter[I, T]     @step_by(n int) -> StepByIter[Self, T]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }

export fn StepByIter[I, T] @take(n int)  -> TakeIter[Self, T]
    requires n >= 0
    => { src: @, left: n }
export fn StepByIter[I, T] @skip(n int)  -> SkipIter[Self, T]
    requires n >= 0
    => { src: @, to_skip: n }
export fn StepByIter[I, T] @map[U](f fn(T) -> U) -> MapIter[Self, T, U] => { src: @, f }
export fn StepByIter[I, T] @filter(pred fn(T) -> bool) -> FilterIter[Self, T] => { src: @, pred }
export fn StepByIter[I, T] @enumerate() -> EnumerateIter[Self, T] => { src: @, i: 0 }

// ── @enumerate — per adapter type ──────────────────────────────────────────
//
// Cannot be blanket because the return type names `EnumerateIter` explicitly.

export fn VecIter[T] @enumerate() -> EnumerateIter[Self, T] => { src: @, i: 0 }
export fn MapIter[I, T, U] @enumerate() -> EnumerateIter[Self, U] => { src: @, i: 0 }
export fn FilterIter[I, T] @enumerate() -> EnumerateIter[Self, T] => { src: @, i: 0 }
export fn FilterMapIter[I, T, U] @enumerate() -> EnumerateIter[Self, U] => { src: @, i: 0 }
export fn TakeIter[I, T] @enumerate() -> EnumerateIter[Self, T] => { src: @, i: 0 }
export fn SkipIter[I, T] @enumerate() -> EnumerateIter[Self, T] => { src: @, i: 0 }

// ── chaining adapters ON `EnumerateIter` ────────────────────────────────────

export fn EnumerateIter[I, T] @map[U](f fn((int, T)) -> U) -> MapIter[Self, (int, T), U] => { src: @, f }
export fn EnumerateIter[I, T] @filter(pred fn((int, T)) -> bool) -> FilterIter[Self, (int, T)] => { src: @, pred }
export fn EnumerateIter[I, T] @filter_map[U](f fn((int, T)) -> Option[U]) -> FilterMapIter[Self, (int, T), U] => { src: @, f }
export fn EnumerateIter[I, T] @take(n int) -> TakeIter[Self, (int, T)]
    requires n >= 0
    => { src: @, left: n }
export fn EnumerateIter[I, T] @skip(n int) -> SkipIter[Self, (int, T)]
    requires n >= 0
    => { src: @, to_skip: n }
export fn EnumerateIter[I, T] @enumerate() -> EnumerateIter[Self, (int, T)] => { src: @, i: 0 }

// ──────────────────────────────────────────────────────────────────────────
// `SplitIter` / `RSplitIter` — lazy `str.split()` family (Plan 199).
// See the module-header note above for why these TYPES live here while the
// `str @split`/`@splitn`/`@split_terminator`/`@rsplit`/`@rsplitn`
// CONSTRUCTORS stay in `runtime.string` (search.nv).
// ──────────────────────────────────────────────────────────────────────────

/// Lazy forward `str.split()` family. `limit < 0` = unlimited (`split`,
/// `split_terminator`); `limit == 0` = immediately exhausted (`splitn`/
/// `rsplitn` clamp `n <= 0` here); `limit == n` = Rust `splitn` semantics —
/// after `n - 1` separator matches, the REST of the string (not further
/// split) is yielded as the final part. `terminator` (only ever `true` for
/// `split_terminator`) drops a trailing EMPTY segment (the string ended
/// with `sep`) instead of yielding it. Fields are plain (not `priv`) so the
/// `str @split*` constructors — declared in a different module — can build
/// the record literal directly.
export type SplitIter value {
    src str
    sep str
    mut start int
    mut done bool
    limit int
    mut splits int
    terminator bool
}

/// Advance the forward splitter by one segment. Byte-scan for the next
/// non-overlapping `sep` match starting at `start`; `@src[a..b]` views are
/// zero-copy (no heap). Mirrors the retired eager `str @split`/`@splitn`/
/// `@split_terminator` bodies byte-for-byte (see search.nv history).
///
/// The match PROBE at each candidate `i` uses `RawMem.compare` (memcmp) over
/// raw pointers, NOT the safe `@src[i..i+sep_len] == @sep` view-comparison —
/// the latter panics ("slice splits a UTF-8 codepoint") the moment a
/// multi-byte-codepoint payload puts `i` mid-codepoint, which is a normal,
/// expected byte-scan position (only ACTUAL match boundaries are guaranteed
/// codepoint-aligned by R-UTF8, not every probed `i`). Only fully-validated
/// segment boundaries (`@start`, a confirmed match `i`, or `sn`) are ever
/// turned into an `@src[a..b]` VIEW.
#impl(Next[str])
export fn SplitIter mut @next() -> Option[str] {
    if @done { return None }
    if @limit == 0 { @done = true; return None }
    ro sn = @src.byte_len()
    ro sep_len = @sep.byte_len()
    if sep_len == 0 {
        @done = true
        return Some(@src[0..sn])
    }
    if @limit >= 0 && @splits >= @limit - 1 {
        @done = true
        if @terminator && @start >= sn { return None }
        return Some(@src[@start..sn])
    }
    mut i = @start
    while i + sep_len <= sn {
        if unsafe { RawMem.compare(@src.ptr().offset(i), @sep.ptr(), sep_len) == 0 } {
            ro seg = @src[@start..i]
            @start = i + sep_len
            @splits += 1
            return Some(seg)
        }
        i += 1
    }
    @done = true
    if @terminator && @start >= sn { return None }
    Some(@src[@start..sn])
}

// ── adapters ON a `SplitIter` source (chain entry) ───────────────────────
//
// [M-splititer-filter-closure-ctx-gap] (found during Plan 199): an
// UNANNOTATED closure-light literal (`|s| ...`) chained DIRECTLY on these
// adapters (`"a,b".split(",").filter(|s| ...)`) currently loses its param-
// type context in codegen and defaults the param to `nova_int` (CC-FAIL) —
// a gap in the fn-typed-param context threading for CONCRETE (non-generic)
// instance methods specifically (the SAME receiver via a GENERIC adapter,
// e.g. `VecIter[T] @filter`, is unaffected — its context flows through the
// mono-instance substitution machinery, which a plain concrete method never
// enters). Workaround until fixed: spell the closure with an explicit
// signature — `.filter(fn(s str) -> bool => s != "")` instead of
// `.filter(|s| s != "")`. `.take`/`.skip`/`.step_by`/`.enumerate` are
// unaffected (no closure param). Separately tracked as a defect, NOT
// specific to `str.split` — any future concrete (non-generic) `Next[T]`
// iterator with an adapter entry point would hit the same gap.
export fn SplitIter @map[U](f fn(str) -> U) -> MapIter[SplitIter, str, U] => { src: @, f }
export fn SplitIter @filter(pred fn(str) -> bool) -> FilterIter[SplitIter, str] => { src: @, pred }
export fn SplitIter @filter_map[U](f fn(str) -> Option[U]) -> FilterMapIter[SplitIter, str, U] => { src: @, f }
export fn SplitIter @take(n int) -> TakeIter[SplitIter, str]
    requires n >= 0
    => { src: @, left: n }
export fn SplitIter @skip(n int) -> SkipIter[SplitIter, str]
    requires n >= 0
    => { src: @, to_skip: n }
export fn SplitIter @enumerate() -> EnumerateIter[SplitIter, str] => { src: @, i: 0 }
export fn SplitIter @step_by(n int) -> StepByIter[SplitIter, str]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }

/// Lazy backward `str.rsplit()`/`rsplitn()` family — mirror-image of
/// `SplitIter`: scans from `end` toward 0, segments come out in REVERSE
/// order (Rust `rsplit`). No `terminator` variant (Nova has no
/// `rsplit_terminator`).
export type RSplitIter value {
    src str
    sep str
    mut end int
    mut done bool
    limit int
    mut splits int
}

/// Advance the backward splitter by one segment (mirrors `str @rsplit`/
/// `@rsplitn`'s retired eager bodies byte-for-byte).
#impl(Next[str])
export fn RSplitIter mut @next() -> Option[str] {
    if @done { return None }
    if @limit == 0 { @done = true; return None }
    ro sep_len = @sep.byte_len()
    if sep_len == 0 {
        @done = true
        return Some(@src[0..@end])
    }
    if @limit >= 0 && @splits >= @limit - 1 {
        @done = true
        return Some(@src[0..@end])
    }
    mut i = @end - sep_len
    while i >= 0 {
        if unsafe { RawMem.compare(@src.ptr().offset(i), @sep.ptr(), sep_len) == 0 } {
            ro seg = @src[i + sep_len..@end]
            @end = i
            @splits += 1
            return Some(seg)
        }
        i -= 1
    }
    @done = true
    Some(@src[0..@end])
}

// ── adapters ON an `RSplitIter` source (chain entry) ─────────────────────

export fn RSplitIter @map[U](f fn(str) -> U) -> MapIter[RSplitIter, str, U] => { src: @, f }
export fn RSplitIter @filter(pred fn(str) -> bool) -> FilterIter[RSplitIter, str] => { src: @, pred }
export fn RSplitIter @filter_map[U](f fn(str) -> Option[U]) -> FilterMapIter[RSplitIter, str, U] => { src: @, f }
export fn RSplitIter @take(n int) -> TakeIter[RSplitIter, str]
    requires n >= 0
    => { src: @, left: n }
export fn RSplitIter @skip(n int) -> SkipIter[RSplitIter, str]
    requires n >= 0
    => { src: @, to_skip: n }
export fn RSplitIter @enumerate() -> EnumerateIter[RSplitIter, str] => { src: @, i: 0 }
export fn RSplitIter @step_by(n int) -> StepByIter[RSplitIter, str]
    requires n > 0
    => { src: @, step: n, first: true, rem: n - 1 }

// ──────────────────────────────────────────────────────────────────────────
// Terminators — drive the chain.
//
// Plan 161 Ф.3 refactor: terminators that return a type with NO unresolved
// type-var in the return position (int, bool, (), Acc) are written once as
// blanket methods `fn[I Next[T]] I mut @t…()`.
//
// Plan 161 V2 [M-161-parametric-return]: terminators whose return type or
// parameter type contains the element type T (Vec[T], Option[T], T) are
// ALSO blanket now — codegen correctly substitutes T at mono time.
//
// Blanket (O(1) definitions, all adapter types supported):
//   @fold[Acc]      — returns Acc (additional generic)
//   @count          — returns int
//   @for_each       — returns ()
//   @any            — returns bool
//   @all            — returns bool
//   @collect        — returns Vec[T]   (Plan 161 V2)
//   @collect_into   — param mut Vec[T] (Plan 161 V2)
//   @sum            — param/return T   (Plan 161 V2)
//   @find           — returns Option[T](Plan 161 V2)
// ──────────────────────────────────────────────────────────────────────────

// ── blanket terminators (Plan 161 Ф.3) ───────────────────────────────────

// D246-амендмент ([M-ro-launder-via-mut-binding], Ф.2 миграция, 2026-07-23):
// `init` — `mut` (in-out; D326-ревизия §Р3) — генерик `Acc` не может быть
// статически доказан value-safe (случай G: генерик может нести кучевое
// поле), а внутренний `mut acc = init` требует mut-content-view источника.
export fn[I Next[T]] I mut @fold[Acc](mut init Acc, f fn(Acc, T) -> Acc) -> Acc {
    mut acc = init
    while true {
        match @next() {
            Some(x) => { acc = f(acc, x) },
            None => return acc,
        }
    }
    acc
}

export fn[I Next[T]] I mut @count() -> int {
    mut n = 0
    while true {
        match @next() {
            Some(_) => { n += 1 },
            None => return n,
        }
    }
    n
}

export fn[I Next[T]] I mut @for_each(f fn(T) -> ()) -> () {
    while true {
        match @next() {
            Some(x) => f(x),
            None => { return },
        }
    }
}

export fn[I Next[T]] I mut @any(pred fn(T) -> bool) -> bool {
    while true {
        match @next() {
            Some(x) => { if pred(x) { return true } },
            None => return false,
        }
    }
    false
}

export fn[I Next[T]] I mut @all(pred fn(T) -> bool) -> bool {
    while true {
        match @next() {
            Some(x) => { if !pred(x) { return false } },
            None => return true,
        }
    }
    true
}

// ── blanket parametric terminators (Plan 161 V2 [M-161-parametric-return]) ──
// These cover MapIter, FilterIter, FilterMapIter (and any future adapter)
// in a single definition. The codegen now substitutes T in Vec[T] / Option[T]
// / T-params at monomorphization time.

/// Collect all elements into a new `Vec[T]`.
export fn[I Next[T]] I mut @collect() -> Vec[T] {
    mut out = Vec[T].new()
    while true {
        match @next() {
            Some(x) => out.push(x),
            None => return out,
        }
    }
    out
}

/// Drain the chain into a CALLER-PROVIDED, reusable buffer `out` (Stage 4,
/// [M-153.2-collect-into]). APPENDS to `out` (does not clear it first).
/// Amortizes to ZERO `nova_alloc` when `out` is reused across calls.
export fn[I Next[T]] I mut @collect_into(mut out Vec[T]) -> () {
    while true {
        match @next() {
            Some(x) => out.push(x),
            None => { return },
        }
    }
}

/// Sum all elements starting from `zero`. Requires `T` to support `+`.
// D246-амендмент ([M-ro-launder-via-mut-binding], Ф.2 миграция, 2026-07-23):
// `zero` — `mut` (in-out; D326-ревизия §Р3) — `T` не статически value-safe.
export fn[I Next[T]] I mut @sum(mut zero T) -> T {
    mut acc = zero
    while true {
        match @next() {
            Some(x) => { acc += x },
            None => return acc,
        }
    }
    acc
}

/// Return the first element satisfying `pred`, or `None`.
export fn[I Next[T]] I mut @find(pred fn(T) -> bool) -> Option[T] {
    while true {
        match @next() {
            Some(x) => { if pred(x) { return Some(x) } },
            None => return None,
        }
    }
    None
}

/// Reduce without a seed: `None` when empty, else fold from the first element.
export fn[I Next[T]] I mut @reduce(f fn(T, T) -> T) -> Option[T] {
    mut acc = match @next() {
        Some(first) => first,
        None => return None,
    }
    while true {
        match @next() {
            Some(x) => { acc = f(acc, x) },
            None => return Some(acc),
        }
    }
    Some(acc)
}

/// Smallest element by `T`'s `Compare`, or `None` if empty.
/// [M-202-ident-x-module-alias-collision] fix: match-arm bind was named
/// bare `x` — a checker gap (`match_arm_bindings` can't resolve the
/// generic `Option[T]` scrutinee of `@next()` inside THIS generic body, so
/// `x` never lands in `scope`) let it fall through to the `imported_modules`
/// module-call branch of `f1_check_call`'s `Member` dispatch whenever a
/// USER program imported any module whose last path segment was literally
/// `x` — false `[E7401] no function 'compare' in module 'x'`. Renamed to
/// `cand` (checker gap itself is a separate, deeper latent issue — not
/// fixed here, see backlog).
export fn[I Next[T], T Compare] I mut @min() -> Option[T] {
    mut best = match @next() {
        Some(first) => first,
        None => return None,
    }
    while true {
        match @next() {
            Some(cand) => { if cand.compare(best) < 0 { best = cand } },
            None => return Some(best),
        }
    }
    Some(best)
}

/// Largest element by `T`'s `Compare`, or `None` if empty.
/// [M-202-ident-x-module-alias-collision] fix: see `@min` above (same
/// bare-`x` match-arm-bind collision with imported module aliases).
export fn[I Next[T], T Compare] I mut @max() -> Option[T] {
    mut best = match @next() {
        Some(first) => first,
        None => return None,
    }
    while true {
        match @next() {
            Some(cand) => { if cand.compare(best) > 0 { best = cand } },
            None => return Some(best),
        }
    }
    Some(best)
}

/// 0-based `n`-th element (consumes first `n`), or `None`.
export fn[I Next[T]] I mut @nth(n int) -> Option[T] {
    mut k = n
    while true {
        match @next() {
            Some(x) => {
                if k == 0 { return Some(x) }
                k -= 1
            },
            None => return None,
        }
    }
    None
}

/// Last element, or `None` if empty (drains the iterator).
export fn[I Next[T]] I mut @last() -> Option[T] {
    mut result Option[T] = None
    while true {
        match @next() {
            Some(x) => { result = Some(x) },
            None => return result,
        }
    }
    result
}

/// Drain into a fresh `Set[T]`, deduplicating elements. Requires `T Hash`.
export fn[I Next[T], T Hash] I mut @collect_set() -> Set[T] {
    mut out = Set[T].new()
    while true {
        match @next() {
            Some(x) => out.insert(x),
            None => return out,
        }
    }
    out
}

// ──────────────────────────────────────────────────────────────────────────
