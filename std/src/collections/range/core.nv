// stdlib_range.nv — тип Range и его итератор.
//
// `a..b` (exclusive) и `a..=b` (inclusive) — литералы Range
// ([D58](../spec/decisions/03-syntax.md#d58)).
//
// **Canonical form:** Range всегда хранится в **half-open** форме
// `[start, end)`. `..=` нормализуется на конструкторе в `..` через
// `end + 1`. Это даёт:
//   - 16 байт памяти вместо 17+ (нет поля inclusive)
//   - единая семантика во всех методах (нет ветвления if inclusive)
//   - один canonical form — соответствует Rust's `Range`, Python `range()`
//
// Edge case: `0..=int.MAX` → overflow на end+1 при компиляторной
// нормализации `..=` → half-open → **runtime panic** (не Fail; см. ниже).
//
// `Iterable[T]` — структурный effect в prelude. RangeIter автоматически
// удовлетворяет `Iter[int]` через `mut next() -> Option[int]`.

// Plan 91 Ф.7.1: partial_prelude — range.nv is re-exported в std.prelude
// (Plan 62.D bis-1), и full auto-import prelude → cycle при standalone nova check
// (collections.range → std.prelude → std.collections.range). Используем
// #prelude(core, runtime, errors): только core (Option/Some/None/Ordering) + runtime (assert) +
// errors (RuntimeError) — всё что нужно range API + тестам, БЕЗ
// std.collections.range re-export через std.prelude.collections.
#prelude(core, runtime, errors)
module collections.range

// ──────────────────────────────────────────────────────────────────────────
// Тип
// ──────────────────────────────────────────────────────────────────────────

/// A range of integers in half-open form `[start, end)`.
///
/// Created by the `a..b` (exclusive) and `a..=b` (inclusive, normalized to half-open) literals.
/// Immutable — all operations return a new `Range`.
///
/// # Examples
///
/// ```nova
/// let r = 0..5
/// assert(r.len() == 5)
/// assert(r.contains(4))
/// assert(!r.contains(5))
///
/// let mut total = 0
/// for x in 0..5 { total += x }
/// assert(total == 10)
/// ```
///
/// # See Also
///
/// - `[Range.step_by]` — iteration with a step
/// - `[Range.reverse]` — reverse iteration
// [M-138-range-value] Plan 138 Ф.0.3: перевести на value record после Ф.0.1 sweep.
// Цель: export type Range { ro start int; ro end int }  — stack, 16 bytes.
#stable(since = "0.1")
export type Range value {
    ro start int
    ro end   int      // half-open: end НЕ включён
}

// Конструктор не нужен — используй литералы:
//   start..end   →  Range { start, end }     (half-open, исключает end)
//   start..=end  →  Range { start, end+1 }   (нормализуется компилятором)
// Overflow для ..=int.MAX → runtime panic в нормализации компилятором.

// ──────────────────────────────────────────────────────────────────────────
// Базовые операции
// ──────────────────────────────────────────────────────────────────────────

/// Number of elements in the range. Returns `0` if `start >= end`.
#stable(since = "0.1")
export fn Range @len() -> int {
    ro n = @end - @start
    n.max(0)
}

/// Returns `true` if the range contains no elements.
#stable(since = "0.1")
export fn Range @is_empty() -> bool => @len() == 0

/// Check whether a value belongs to the range (half-open: `start <= x < end`).
#stable(since = "0.1")
export fn Range @contains(x int) -> bool =>
    x >= @start && x < @end

// ──────────────────────────────────────────────────────────────────────────
// Итератор
// ──────────────────────────────────────────────────────────────────────────

// Структурно совместим с `Iter[int]` (D58 prelude) — есть метод
// `mut next() -> Option[int]`. Никаких `impl Iter for ...`-блоков.
export type RangeIter value {
    ro end int
    mut cur     int
}

/// Create an iterator over the range.
#stable(since = "0.1")
#impl(Iter[RangeIter])
export fn Range @iter() -> RangeIter =>
    { @end, cur: @start }

#impl(Next[int])
export fn RangeIter mut @next() -> Option[int] {
    if @cur >= @end { return None }
    ro v = @cur
    @cur += 1
    Some(v)
}

// D58 amend: итератор реализует iter() -> Self (trivial) — единая точка входа.
export fn RangeIter @iter() -> RangeIter => @

// ──────────────────────────────────────────────────────────────────────────
// step_by — итерация с шагом
// ──────────────────────────────────────────────────────────────────────────
//
// Альтернатива C-style `for(i=0; i<n; i+=step)` — отвергнут D82.
// Use-case: crypto-блоки (MD5/SHA по 64 байта), base64 (по 4),
// chunked encoding (по N байт).
//
// Семантика: yield'ит start, start+step, start+2*step, ... пока < end.

export type StepRangeIter value {
    ro end  int
    ro step int                       // должен быть > 0
    mut cur      int
}

/// An iterator over the range with step `step`. Throws `OverflowError` if `step <= 0`.
///
/// # Examples
///
/// ```nova
/// for i in (0..10).step_by(2) {
///     assert(i % 2 == 0)
/// }
/// ```
#stable(since = "0.1")
export fn Range @step_by(step int) -> StepRangeIter
    requires step > 0
    => { @end, step, cur: @start }

#impl(Next[int])
export fn StepRangeIter mut @next() -> Option[int] {
    if @cur >= @end { return None }
    ro v = @cur
    @cur += @step
    Some(v)
}

export fn StepRangeIter @iter() -> StepRangeIter => @

// ──────────────────────────────────────────────────────────────────────────
// reverse — обратная итерация
// ──────────────────────────────────────────────────────────────────────────
//
// Альтернатива C-style `for(i=n-1; i>=0; i--)` — отвергнут D82.
// Yield'ит end-1, end-2, ..., start.

export type ReverseRangeIter value {
    ro start int
    mut cur       int                      // internal: следующее значение для выдачи
                                            // (decremented после каждого next)
    mut done      bool                     // internal: флаг завершения (для start == int.MIN)
}

/// An iterator in reverse order: from `end-1` down to `start`.
///
/// # Examples
///
/// ```nova
/// for i in (1..=3).reverse() { /* 3, 2, 1 */ }
/// ```
#stable(since = "0.1")
export fn Range @reverse() -> ReverseRangeIter {
    ro cur = if @end > @start { @end - 1 } else { @start }
    ro done = @end <= @start
    ReverseRangeIter { @start, cur, done }
}

export fn ReverseRangeIter @iter() -> ReverseRangeIter => @

#impl(Next[int])
export fn ReverseRangeIter mut @next() -> Option[int] {
    if @done { return None }
    ro v = @cur
    if @cur == @start {
        @done = true                       // следующая итерация завершит
    } else {
        @cur -= 1
    }
    Some(v)
}

