// stdlib/lru.nv — LRU (Least Recently Used) cache.
//
// API:
//   Lru[K Hash, V].new(capacity int) -> Lru[K, V]
//   cache.get(k K) -> Option[V]      // moves to front (most recent)
//   cache.put(k K, v V)               // evicts LRU if full
//   cache.len -> int
//   cache.contains(k K) -> bool

module collections.lru

import std.collections.hashmap.{HashMap}

/// An LRU (Least Recently Used) cache with a fixed capacity.
///
/// When `capacity` is reached it automatically evicts the least
/// recently used element. `get` refreshes recency.
///
/// Bootstrap implementation: O(n) on `get`/`put` due to array-based ordering.
/// The production stdlib uses a doubly-linked list for O(1).
///
/// # Examples
///
/// ```nova
/// let mut cache = Lru[str, int].new(2)
/// cache.put("a", 1)
/// cache.put("b", 2)
/// cache.put("c", 3)   // evicts "a" (LRU)
/// assert(cache.get("a") == None)
/// assert(cache.get("b") == Some(2))
/// ```
#stable(since = "0.1")
export type Lru[K Hash, V] {
    ro capacity int        // public config
    mut order []K               // internal: index 0 = most recent
    mut store HashMap[K, V]     // internal storage
}

/// Create an empty LRU cache with the given capacity.
#stable(since = "0.1")
export fn Lru[K, V].new(capacity int) -> Self =>
    {
        capacity,
        order: [],
        store: HashMap[K, V].new(),
    }

/// Number of elements in the cache.
#stable(since = "0.1")
export fn Lru[K, V] @len() -> int => @store.len()

/// Returns `true` if the cache is empty.
#stable(since = "0.1")
export fn Lru[K, V] @is_empty() -> bool => @store.len() == 0

/// Check whether the key is present without refreshing recency.
#stable(since = "0.1")
export fn Lru[K, V] @contains(k K) -> bool => @store.contains(k)

/// Get the value by key and refresh recency (move-to-front).
#stable(since = "0.1")
export fn Lru[K, V] mut @get(k K) -> Option[V] {
    match @store.get(k) {
        None => None
        Some(v) => {
            // Move to front
            @move_to_front(k)
            Some(v)
        }
    }
}

/// Insert or update a pair. If the cache is full — evicts the LRU element.
#stable(since = "0.1")
export fn Lru[K, V] mut @put(k K, v V) -> () {
    if @store.contains(k) {
        @store.insert(k, v)
        @move_to_front(k)
        return ()
    }

    if @order.len() >= @capacity {
        // Evict LRU (last element)
        ro evicted = @order[@order.len() - 1]
        @store.remove(evicted)
        // Удаляем последний элемент из order
        @order = @order[..@order.len() - 1]
    }

    // Insert front
    mut new_order []K = [k]
    new_order.append(@order)
    @order = new_order
    @store.insert(k, v)
}

fn Lru[K, V] mut @move_to_front(k K) -> () {
    // Найти k в order, удалить, поставить в начало.
    mut new_order []K = [k]
    for x in @order {
        if x != k { new_order.push(x) }
    }
    @order = new_order
}

