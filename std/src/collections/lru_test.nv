// std/collections/lru_test.nv — публичный контракт Lru.

module collections.lru_test

import std.collections.lru.{Lru}

test "basic put/get" {
    mut cache = Lru[str, int].new(3)
    cache.put("a", 1)
    cache.put("b", 2)
    cache.put("c", 3)

    assert(cache.get("a") == Some(1))
    assert(cache.get("b") == Some(2))
    assert(cache.get("c") == Some(3))
}

test "eviction at capacity" {
    mut cache = Lru[str, int].new(2)
    cache.put("a", 1)
    cache.put("b", 2)
    cache.put("c", 3)              // evicts "a" (LRU)

    assert(cache.get("a") == None)
    assert(cache.get("b") == Some(2))
    assert(cache.get("c") == Some(3))
}

test "get refreshes recency" {
    mut cache = Lru[str, int].new(2)
    cache.put("a", 1)
    cache.put("b", 2)
    ro _ = cache.get("a")          // "a" теперь most recent
    cache.put("c", 3)               // evicts "b" (LRU теперь b)

    assert(cache.get("a") == Some(1))
    assert(cache.get("b") == None)
    assert(cache.get("c") == Some(3))
}

test "update existing key" {
    mut cache = Lru[str, int].new(2)
    cache.put("a", 1)
    cache.put("a", 99)
    assert(cache.get("a") == Some(99))
    assert(cache.len() == 1)
}
