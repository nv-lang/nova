// std/collections/bloom_filter_test.nv — публичный контракт BloomFilter.

module collections.bloom_filter_test

import std.collections.bloom_filter.{BloomFilter}

test "no false negatives" {
    mut bf = BloomFilter.new(1024, 3)
    bf.insert("hello")
    bf.insert("world")
    bf.insert("nova")
    // Все вставленные — гарантированно contains
    assert(bf.contains("hello"))
    assert(bf.contains("world"))
    assert(bf.contains("nova"))
}

test "empty filter — никого не содержит" {
    ro bf = BloomFilter.new(1024, 3)
    assert(!bf.contains("anything"))
}

test "optimal sizing" {
    mut bf = BloomFilter.optimal(100, 0.01)         // 100 items, 1% false-positive
    bf.insert("test1")
    bf.insert("test2")
    assert(bf.contains("test1"))
    assert(bf.contains("test2"))
}

test "false positive rate приемлемый для small set" {
    mut bf = BloomFilter.new(1024, 4)
    for i in 0..50 {
        bf.insert("item-${i}")
    }
    // Сколько false positives на 100 неинсёртенных?
    mut false_pos = 0
    for j in 50..150 {
        if bf.contains("item-${j}") {
            false_pos += 1
        }
    }
    // С m=1024, k=4, n=50 — false-positive rate << 50%
    assert(false_pos < 50)
}
