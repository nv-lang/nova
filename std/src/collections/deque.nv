// stdlib/deque.nv — Double-ended queue (deque).
//
// Push/pop с обоих концов в O(1) amortized. Реализация на циркулярном
// буфере с capacity-grow.
//
// API:
//   Deque[T].new() -> Deque[T]
//   d.push_front(x) / d.push_back(x)
//   d.pop_front() / d.pop_back() -> Option[T]
//   d.front() / d.back() -> Option[T]
//   d.len / d.is_empty()
//
// Use cases: BFS, sliding window, scheduling, undo/redo

module collections.deque

/// A double-ended queue: push/pop from both ends in O(1) amortized.
///
/// Implemented on a dynamic array. Current bootstrap version:
/// `push_front` and `pop_front` are O(n) due to element shifting.
/// The production stdlib uses a circular buffer for O(1) on all operations.
///
/// # Examples
///
/// ```nova
/// let mut d = Deque[int].new()
/// d.push_back(1)
/// d.push_back(2)
/// d.push_front(0)
/// assert(d.pop_front() == Some(0))
/// assert(d.pop_back() == Some(2))
/// ```
///
/// # See Also
///
/// - `[Queue]` — a one-directional FIFO queue via two arrays
#stable(since = "0.1")
export type Deque[T] {
    mut items []T   // internal storage
}

/// Create an empty `Deque`.
#stable(since = "0.1")
export fn Deque[T].new() -> Self => { items: [] }

/// Number of elements in the deque.
#stable(since = "0.1")
export fn Deque[T] @len() -> int => @items.len()

/// Returns `true` if the deque is empty.
#stable(since = "0.1")
export fn Deque[T] @is_empty() -> bool => @items.len() == 0

/// Append an element to the end. O(1) amortized.
#stable(since = "0.1")
export fn Deque[T] mut @push_back(x T) -> () {
    @items.push(x)
}

/// Prepend an element to the front. O(n) in the current implementation; O(1) in production.
#stable(since = "0.1")
export fn Deque[T] mut @push_front(x T) -> () {
    mut new_items []T = [x]
    new_items.append(@items)
    @items = new_items
}

/// Remove and return the last element. O(1).
#stable(since = "0.1")
export fn Deque[T] mut @pop_back() -> Option[T] => @items.pop()

/// Remove and return the first element. O(n) in the current implementation; O(1) in production.
#stable(since = "0.1")
export fn Deque[T] mut @pop_front() -> Option[T] {
    if @items.len() == 0 { return None }
    ro value = @items[0]
    @items = @items[1..]
    Some(value)
}

/// Peek the first element without removing it. `None` if the deque is empty.
#stable(since = "0.1")
export fn Deque[T] @front() -> Option[T] {
    if @items.len() == 0 { None } else { Some(@items[0]) }
}

/// Peek the last element without removing it. `None` if the deque is empty.
#stable(since = "0.1")
export fn Deque[T] @back() -> Option[T] {
    if @items.len() == 0 { None } else { Some(@items[@items.len() - 1]) }
}

/// Get an element by index. `None` if `i` is out of range.
#stable(since = "0.1")
export fn Deque[T] @get(i int) -> Option[T] {
    if i < 0 || i >= @items.len() { None } else { Some(@items[i]) }
}

