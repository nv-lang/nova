// stdlib/bloom_filter.nv — probabilistic membership.
//
// Bloom filter гарантирует:
//   - Negative answer (contains → false) — определённо нет в set'е
//   - Positive answer (contains → true) — может быть false positive
//
// Параметры:
//   m — битов в bit array
//   k — число hash functions
//   n — ожидаемое число элементов
//   Optimal: m = -n*ln(p) / ln(2)^2, k = (m/n) * ln(2)
//
// Use cases:
//   - Cache pre-check (избежать DB-запроса для отсутствующих)
//   - Дедупликация в streaming
//   - Предварительная фильтрация в join'ах

module collections.bloom_filter

/// A probabilistic data structure for set-membership checks.
///
/// Guarantees the absence of false negatives — if `contains` returned `false`,
/// the element was definitely never inserted. False positives are possible with
/// a probability depending on the `bits_size` and `num_hashes` parameters.
///
/// Use `[BloomFilter.optimal]` for automatic parameter selection.
///
/// # Examples
///
/// ```nova
/// let mut bf = BloomFilter.new(1024, 3)
/// bf.insert("hello")
/// assert(bf.contains("hello"))
/// assert(!bf.contains("world"))  // probably false, but not guaranteed
/// ```
///
/// # See Also
///
/// - `[BloomFilter.optimal]` — create with a target false-positive rate
#stable(since = "0.1")
export type BloomFilter {
    ro bits_size int          // public config
    ro num_hashes int         // public config (k)
    mut bits []u8                // internal: packed bit array (1 u8 = 8 bits)
}

/// Create a filter with explicit parameters.
///
/// - `bits_size` — the number of bits (rounded up to bytes)
/// - `num_hashes` — the number of hash functions `k`
///
/// # Examples
///
/// ```nova
/// let mut bf = BloomFilter.new(1024, 3)
/// bf.insert("test")
/// assert(bf.contains("test"))
/// ```
#stable(since = "0.1")
export fn BloomFilter.new(bits_size int, num_hashes int) -> Self {
    ro byte_size = (bits_size + 7) / 8
    mut bits []u8 = []
    for i in 0..byte_size { bits.push(0) }
    {
        bits_size,
        num_hashes,
        bits,
    }
}

/// Create a filter with optimal parameters for the given `expected_n` elements
/// and a target `false_pos_rate` (0.0–1.0).
///
/// Automatically computes `bits_size` and `num_hashes` via the formulas:
/// - `m = -n·ln(p) / ln(2)²`
/// - `k = (m/n)·ln(2)`
///
/// # Examples
///
/// ```nova
/// let mut bf = BloomFilter.optimal(1000, 0.01)  // 1000 items, 1% false-positive
/// bf.insert("item")
/// assert(bf.contains("item"))
/// ```
#stable(since = "0.1")
export fn BloomFilter.optimal(expected_n int, false_pos_rate f64) -> Self {
    // m = -n * ln(p) / ln(2)^2
    ro n = expected_n as f64
    ro ln2 = 0.6931471805599453
    ro m = (-n * false_pos_rate.ln() / (ln2 * ln2)).ceil() as int
    // k = (m/n) * ln(2)
    ro k = ((m as f64 / n) * ln2).ceil() as int
    ro k_safe = k.max(1)
    Self.new(m, k_safe)
}

/// Add a string to the filter. After this, `contains(s)` is guaranteed to return `true`.
#stable(since = "0.1")
export fn BloomFilter mut @insert(s str) -> () {
    ro h1 = hash1(s)
    ro h2 = hash2(s)
    for i in 0..@num_hashes {
        // Plan 206 Ф.2 (D423): double-hashing комбинация — модульная
        // арифметика по замыслу (переполнение mod 2^64 ожидаемо, потом всё
        // равно `% @bits_size`) -> `.wrapping_mul`/`.wrapping_add`.
        ro bit_idx = (h1.wrapping_add((i as u64).wrapping_mul(h2)) as int) % @bits_size
        ro safe_idx = if bit_idx < 0 { bit_idx + @bits_size } else { bit_idx }
        @set_bit(safe_idx)
    }
}

/// Check the probable presence of a string. `false` — definitely absent. `true` — probably present.
#stable(since = "0.1")
export fn BloomFilter @contains(s str) -> bool {
    ro h1 = hash1(s)
    ro h2 = hash2(s)
    for i in 0..@num_hashes {
        // Plan 206 Ф.2 (D423): см. @insert — модульная арифметика по замыслу.
        ro bit_idx = (h1.wrapping_add((i as u64).wrapping_mul(h2)) as int) % @bits_size
        ro safe_idx = if bit_idx < 0 { bit_idx + @bits_size } else { bit_idx }
        if !@bit(safe_idx) { return false }
    }
    true
}

// ──────────────────────────────────────────────────────────────────────────
// Bit manipulation
// ──────────────────────────────────────────────────────────────────────────

fn BloomFilter mut @set_bit(idx int) -> () {
    ro byte_idx = idx / 8
    ro bit_in_byte = idx % 8
    ro mask = (1 << bit_in_byte) as u8
    @bits[byte_idx] = ((@bits[byte_idx] as int) | (mask as int)) as u8
}

fn BloomFilter @bit(idx int) -> bool {
    ro byte_idx = idx / 8
    ro bit_in_byte = idx % 8
    ro mask = (1 << bit_in_byte)
    ((@bits[byte_idx] as int) & mask) != 0
}

// ──────────────────────────────────────────────────────────────────────────
// Hash functions — простые (FNV-1a варианты)
// ──────────────────────────────────────────────────────────────────────────

// Plan 206 Ф.2 (D423): FNV-1a-подобный хэш — модульная арифметика по
// замыслу (mod 2^64 wraparound часть алгоритма) -> `.wrapping_mul`/`.wrapping_add`.
fn hash1(s str) -> u64 {
    mut h u64 = 0xCBF29CE484222325        // FNV offset basis
    for c in s.chars() {
        h = h ^ ((c as int) as u64)
        h = h.wrapping_mul(0x100000001B3)        // FNV prime
    }
    h
}

fn hash2(s str) -> u64 {
    mut h u64 = 0x100000001B3              // другая seed
    for c in s.chars() {
        h = h.wrapping_mul(31)
        h = h.wrapping_add((c as int) as u64)
    }
    h
}

