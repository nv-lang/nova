// Tests for std.collections.index_map (`IndexMap[K, V]`, реестр 221.1
// №319/№320, окно p320-indexmap Фаза 2). Mirrors the shape of
// std/src/collections/hashmap/core_test.nv, plus the two regression tests
// explicitly required by the plan window's gate: "re-insert does not move
// position" and "iteration == insertion order" — these are the very
// properties that distinguish `IndexMap` from a bare `HashMap`.

module collections.index_map

test "new map is empty" {
    ro m = IndexMap[str, int].new()
    assert(m.is_empty())
    assert(m.len() == 0)
}

test "insert and get" {
    mut m = IndexMap[str, int].new()
    m.insert("alice", 1)
    m.insert("bob", 2)

    assert(m.len() == 2)
    assert(!m.is_empty())
    assert(m.get("alice") == Some(1))
    assert(m.get("bob") == Some(2))
    assert(m.get("charlie") == None)
}

test "insert returns old value on overwrite" {
    mut m = IndexMap[str, int].new()
    assert(m.insert("a", 1) == None)
    assert(m.insert("a", 2) == Some(1))
    assert(m.get("a") == Some(2))
    assert(m.len() == 1)
}

test "contains" {
    mut m = IndexMap[str, int].new()
    m.insert("a", 1)
    assert(m.contains("a"))
    assert(!m.contains("z"))
}

test "remove" {
    mut m = IndexMap[str, int].new()
    m.insert("a", 1)
    m.insert("b", 2)

    assert(m.remove("a") == Some(1))
    assert(m.remove("a") == None)
    assert(m.len() == 1)
    assert(m.get("a") == None)
    assert(m.get("b") == Some(2))
}

test "clear" {
    mut m = IndexMap[str, int].new()
    m.insert("a", 1)
    m.insert("b", 2)
    m.clear()
    assert(m.is_empty())
    assert(m.get("a") == None)
}

// ─── the core motivation of this type — insertion order, not hash order ───

test "re-insert of an EXISTING key does NOT move its position (core IndexMap property)" {
    mut m = IndexMap[str, int].new()
    m.insert("first", 1)
    m.insert("second", 2)
    m.insert("third", 3)
    // Re-insert "first" with a new value — position must stay at index 0.
    assert(m.insert("first", 100) == Some(1))
    assert(m.keys().collect() == ["first", "second", "third"])
    assert(m.get("first") == Some(100))
}

test "iteration follows insertion order, NOT hash order (core IndexMap property)" {
    mut m = IndexMap[str, int].new()
    // Insert in an order that would NOT match typical hash-bucket order for
    // these short string keys — the point is order is INSERTION order,
    // period, regardless of what a hash table would produce.
    m.insert("z", 26)
    m.insert("a", 1)
    m.insert("m", 13)

    mut collected = []str.new()
    for (k, _) in m.iter() {
        collected.push(k)
    }
    assert(collected == ["z", "a", "m"])
}

test "keys() returns keys in insertion order" {
    mut m = IndexMap[str, int].new()
    m.insert("b", 2)
    m.insert("a", 1)
    m.insert("c", 3)
    assert(m.keys().collect() == ["b", "a", "c"])
}

test "iter() yields (key, value) pairs in insertion order" {
    mut m = IndexMap[str, int].new()
    m.insert("x", 10)
    m.insert("y", 20)

    mut pairs = [](str, int).new()
    for (k, v) in m.iter() {
        pairs.push((k, v))
    }
    assert(pairs.len() == 2)
    assert(pairs[0].0 == "x" && pairs[0].1 == 10)
    assert(pairs[1].0 == "y" && pairs[1].1 == 20)
}

// ─── equal() INCLUDES the order: it is part of the value (registry 221.1 #507) ───

test "equal() distinguishes maps that differ only in order" {
    mut a = IndexMap[str, int].new()
    a.insert("x", 1)
    a.insert("y", 2)

    mut b = IndexMap[str, int].new()
    b.insert("y", 2)
    b.insert("x", 1)

    // Same pairs, different insertion order. The order is the guarantee this
    // type exists for, so these are NOT the same value.
    assert(!a.equal(b))
}

test "equal() holds for the same pairs in the same order" {
    mut a = IndexMap[str, int].new()
    a.insert("x", 1)
    a.insert("y", 2)

    mut b = IndexMap[str, int].new()
    b.insert("x", 1)
    b.insert("y", 2)

    assert(a.equal(b))
}

test "equal() detects a value difference" {
    mut a = IndexMap[str, int].new()
    a.insert("x", 1)

    mut b = IndexMap[str, int].new()
    b.insert("x", 2)

    assert(!a.equal(b))
}

test "equal() detects a length difference" {
    mut a = IndexMap[str, int].new()
    a.insert("x", 1)

    mut b = IndexMap[str, int].new()
    b.insert("x", 1)
    b.insert("y", 2)

    assert(!a.equal(b))
}

// ─── order: `remove` PRESERVES it, `swap_remove` gives it up (registry 221.1 #505) ───

test "remove of a middle entry preserves the insertion order of the rest" {
    mut m = IndexMap[str, int].new()
    m.insert("a", 1)
    m.insert("b", 2)
    m.insert("c", 3)
    assert(m.remove("a") == Some(1))
    // The remaining entries keep the order they were inserted in — that is the
    // single guarantee this type exists for.
    assert(m.keys().collect() == ["b", "c"])
    assert(m.get("b") == Some(2))
    assert(m.get("c") == Some(3))
}

test "swap_remove trades the order away, and says so in its name" {
    mut m = IndexMap[str, int].new()
    m.insert("a", 1)
    m.insert("b", 2)
    m.insert("c", 3)
    assert(m.swap_remove("a") == Some(1))
    // "c" (the last entry) was moved into "a"'s slot.
    assert(m.keys().collect() == ["c", "b"])
    assert(m.get("b") == Some(2))
    assert(m.get("c") == Some(3))
}

test "remove of the last entry needs no swap" {
    mut m = IndexMap[str, int].new()
    m.insert("a", 1)
    m.insert("b", 2)
    assert(m.remove("b") == Some(2))
    assert(m.keys().collect() == ["a"])
}

// ─── D450 (реестр 221.1 №503): map-/record-literal coercion into IndexMap ───
//
// `IndexMap` is the D450 live carrier: `#from_fields`/`#from_pairs` now
// require exactly ONE constructor, `IndexMap[K, V].new(cap int = ...)`
// (`core.nv`), and desugar calls it directly — no `insert_new` on this
// type, plain `@insert` is used. The point of THESE tests specifically is
// the order guarantee: a literal's coercion must preserve WRITTEN order,
// not just produce a map with the right pairs.

test "map-literal coerces into IndexMap, insertion order == literal order" {
    ro m IndexMap[str, int] = [ "b": 2, "a": 1 ]
    assert(m.len() == 2)
    assert(m.keys().collect() == ["b", "a"])
    assert(m.get("b") == Some(2))
    assert(m.get("a") == Some(1))
}

test "record-literal coerces into IndexMap (not HashMap), insertion order == field order" {
    // Regression guard for the D450 side-finding: `build_record_map_block`
    // used to be hardcoded to emit `HashMap` regardless of the actual
    // `#from_fields` target type — `RecordLit` carried no target-type name
    // at all until `inferred_target_type` was added (mirroring
    // `MapLit.inferred_target_type`). If that regresses, codegen builds a
    // `Nova_HashMap*` and assigns it into a `Nova_IndexMap*`-typed slot —
    // different C struct layouts (`buckets/count/tombstones` vs
    // `entries/index`) — so this either fails to COMPILE, or (if it somehow
    // slipped past) `.swap_remove()`/`.keys()` below observe the wrong
    // shape entirely.
    mut r IndexMap[str, int] = { b: 2, a: 1 }
    assert(r.len() == 2)
    assert(r.keys().collect() == ["b", "a"])
    assert(r.get("b") == Some(2))
    assert(r.get("a") == Some(1))
    // IndexMap-only method (not on HashMap) — proves the object built here
    // really is an IndexMap, not a HashMap wearing an IndexMap's static type.
    assert(r.swap_remove("b") == Some(2))
    assert(r.keys().collect() == ["a"])
}

test "empty map-literal coerces into an empty IndexMap" {
    ro m IndexMap[str, int] = []
    assert(m.is_empty())
    assert(m.len() == 0)
}

test "map-literal with a duplicate key: last value wins, first occurrence keeps its position" {
    // Documents the ACTUAL behavior (D108 §duplicate keys): the literal
    // desugars to a sequence of `@insert` calls (IndexMap has no
    // `insert_new` — plain `insert` is used for every pair, D450), and
    // `IndexMap.insert` on an EXISTING key overwrites the value WITHOUT
    // moving its position — so the FIRST occurrence's slot wins the
    // position, the LAST occurrence's value wins the value. Flagged by the
    // `duplicate-map-key` lint (compile-time warning, not an error).
    // nova:allow duplicate-map-key -- intentional: this test exists to pin the actual last-wins-value/first-keeps-position behavior
    ro m IndexMap[str, int] = [ "a": 1, "b": 2, "a": 3 ]
    assert(m.len() == 2)
    assert(m.get("a") == Some(3))
    assert(m.keys().collect() == ["a", "b"])
}

// ─── int keys — a second concrete K instantiation, per Nova's own mono model ───

test "works with int keys (second K instantiation)" {
    mut m = IndexMap[int, str].new()
    m.insert(3, "three")
    m.insert(1, "one")
    assert(m.get(1) == Some("one"))
    assert(m.keys().collect() == [3, 1])
}
