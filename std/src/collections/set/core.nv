// stdlib_set.nv — множество Set[T] поверх HashMap.
//
// Идея: Set — это HashMap[T, ()] (значения unit). Никакой особой
// реализации, просто обёртка. Демо composition в духе [D39 use-embed](../spec/decisions/02-types.md#d39).
//
// T должен быть «hashable» — структурно с `hash() -> u64`. Bound'ов
// в MVP нет ([Q-bounds](../spec/open-questions.md)), компилятор
// проверит при использовании.

module collections.set

import std.collections.hash_map.{HashMap}

// ──────────────────────────────────────────────────────────────────────────
// Тип
// ──────────────────────────────────────────────────────────────────────────

/// A set of unique elements over `HashMap[T, ()]`.
///
/// Supports union (`|`), intersection (`&`) and difference (`-`)
/// via operator overloading (D46).
///
/// # Examples
///
/// ```nova
/// let mut s = Set[int].new()
/// assert(s.insert(1) == true)
/// assert(s.insert(1) == false)  // duplicate
/// assert(s.contains(1))
///
/// let a = Set[int].new(cap: 4)
/// let b = Set[int].new(cap: 4)
/// // a | b — union
/// // a & b — intersection
/// // a - b — difference
/// ```
///
/// # See Also
///
/// - `[HashMap]` — a map with keys and values
#stable(since = "0.1")
export type Set[T] {
    use map HashMap[T, ()]
}

// ──────────────────────────────────────────────────────────────────────────
// Конструкторы
// ──────────────────────────────────────────────────────────────────────────

/// Create an empty set.
#stable(since = "0.1")
export fn Set[T].new(cap int = 16) -> Self
    requires cap >= 0
    => { map: HashMap[T, ()].new(cap: cap) }

/// Build a set from an array of elements.
///
/// Takes a concrete `[]T` (mirror of `HashMap.from([](K,V))`): a generic
/// `Iterable[T]` protocol erased to `void*` in mono context, and for-in could not recover
/// not derive the iterator C type on a mono instance ([M-91.1-set-from-iter-iterable-param]).
/// An array iterates correctly for any element type.
///
/// # Examples
///
/// ```nova
/// mut s = Set[int].from_iter([1, 2, 3, 2])
/// assert(s.len() == 3)   // duplicate 2 collapsed
/// assert(s.contains(2))
/// ```
#stable(since = "0.1")
export fn Set[T].from_iter(items []T) -> Self {
    mut s = Self.new(cap: items.len() * 2)
    for x in items {
        s.insert(x)
    }
    s
}

// ──────────────────────────────────────────────────────────────────────────
// Базовые операции
// ──────────────────────────────────────────────────────────────────────────

/// Number of elements in the set.
#stable(since = "0.1")
export fn Set[T] @len() -> int => @map.len()

/// Returns `true` if the set is empty.
#stable(since = "0.1")
export fn Set[T] @is_empty() -> bool => @map.is_empty()

/// Check whether an element is present.
#stable(since = "0.1")
export fn Set[T] @contains(item T) -> bool => @map.contains(item)

/// Current capacity (bucket count of the backing `HashMap`). D117 AMEND
/// accessor-pair — 0-arg getter half of `cap`/`cap(n)`.
#stable(since = "0.1")
export fn Set[T] @cap() -> int => @map.cap()

/// Guarantee capacity for at least `n` elements without rehash (delegates to
/// `HashMap`'s own `mut @cap(n)` — same "grows only, entry-count → bucket-count"
/// semantics). Replacement for the removed `Set[T].with_capacity` static
/// constructor: `Set[T].new(cap: n)`.
#stable(since = "0.1")
export fn Set[T] mut @cap(n int) -> @
    requires n >= 0
{
    @map.cap(n)
}

// ──────────────────────────────────────────────────────────────────────────
// Мутирующие операции
// ──────────────────────────────────────────────────────────────────────────

/// Insert an element. Returns `true` if the element is new, `false` if it was already present.
#stable(since = "0.1")
export fn Set[T] mut @insert(item T) -> bool {
    if @map.contains(item) { return false }
    @map.insert(item, ())
    true
}

/// Remove an element. Returns `true` if the element was in the set.
#stable(since = "0.1")
export fn Set[T] mut @remove(item T) -> bool =>
    match @map.remove(item) {
        Some(_) => true
        None    => false
    }

/// Clear the set.
#stable(since = "0.1")
export fn Set[T] mut @clear() -> () => @map.clear()

/// Create an independent copy of the set (deep — every element is cloned).
///
/// Per D230 amend `Clone` is a deep protocol: `clone()` clones every
/// element via `T.@clone()`, under the `[T Clone]` bound. Set delegates to the
/// backing `HashMap` (`{ map: @map.clone() }`), so the deep semantics is
/// inherited from `HashMap.@clone` (per-element `k.clone()`).
///
/// Per-element
/// generic `T.@clone()` now dispatches correctly (primitive T -> built-in
/// identity, record T -> `T.@clone()`), so the delegation yields a fully
/// deep copy.
#stable(since = "0.1")
export fn Set[T Clone] @clone() -> Self =>
    { map: @map.clone() }

// ──────────────────────────────────────────────────────────────────────────
// Set-операции — operator overloading (D46)
// ──────────────────────────────────────────────────────────────────────────

/// Union `a | b` — all elements from both sets.
///
/// Named `@bitor` (not `@or`): `|` is the bitwise/set-union operator selector.
#stable(since = "0.1")
export fn Set[T] @bitor(other Set[T]) -> Self {
    mut out = Self.new()
    for x in @map.keys() { out.insert(x) }
    for x in other.map.keys() { out.insert(x) }
    out
}

/// Intersection `a & b` — elements present in both sets.
#stable(since = "0.1")
export fn Set[T] @bitand(other Set[T]) -> Self {
    mut out = Self.new()
    for x in @map.keys() {
        if other.contains(x) { out.insert(x) }
    }
    out
}

/// Difference `a - b` — elements of `a` not present in `b`.
#stable(since = "0.1")
export fn Set[T] @minus(other Set[T]) -> Self {
    mut out = Self.new()
    for x in @map.keys() {
        if !other.contains(x) { out.insert(x) }
    }
    out
}

// ──────────────────────────────────────────────────────────────────────────
// Итератор — прокси через embed
// ──────────────────────────────────────────────────────────────────────────

/// Iterator over the set elements in arbitrary order.
#stable(since = "0.1")
export fn Set[T] @iter() => @map.keys()
