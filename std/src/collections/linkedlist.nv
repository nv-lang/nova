// stdlib_linkedlist.nv — односвязный список через recursive sum-type.
//
// Демонстрирует [D52](../spec/decisions/02-types.md#d52) sum с
// рекурсивным конструктором — классический ML-стиль:
//
//   type LinkedList[T] enum | Empty | Cons(T, LinkedList[T])
//
// Pattern matching на этой структуре — самый прямой пример sum-семантики
// и exhaustiveness check от компилятора.
//
// Практически в backend этот тип редко используется (`[]T` эффективнее),
// но он — каноническая иллюстрация sum-recursion для AI-обучения.

module collections.linkedlist

// ──────────────────────────────────────────────────────────────────────────
// Тип
// ──────────────────────────────────────────────────────────────────────────

/// A singly-linked list via a recursive sum type (ML-style).
///
/// Structurally: `Empty | Cons(head, tail)`. Memory is managed by the GC — nodes
/// are freed automatically once unreachable.
///
/// For most tasks `[]T` is more efficient. `LinkedList` is the canonical
/// illustration of sum-recursion and pattern matching in Nova.
///
/// # Examples
///
/// ```nova
/// ro l = LinkedList[int].from_array([1, 2, 3])
/// assert(l.head() == Some(1))
/// assert(l.len() == 3)
/// ro doubled = l.map(|x| x * 2)
/// assert(doubled.head() == Some(2))
/// ```
///
/// # See Also
///
/// - `[Deque]` — an array-based double-ended queue
/// - `[Queue]` — a two-array FIFO queue
#stable(since = "0.1")
export type LinkedList[T] enum
    | Empty
    | Cons(T, LinkedList[T])

// ──────────────────────────────────────────────────────────────────────────
// Конструкторы
// ──────────────────────────────────────────────────────────────────────────

/// Create an empty list.
#stable(since = "0.1")
export fn LinkedList[T].new() -> Self => Empty

/// Build a list from an array. Order is preserved.
///
/// # Examples
///
/// ```nova
/// ro l = LinkedList[int].from_array([1, 2, 3])
/// assert(l.head() == Some(1))
/// ```
#stable(since = "0.1")
export fn LinkedList[T].from_array(xs []T) -> Self {
    mut acc = Empty
    mut i = xs.len() - 1
    while i >= 0 {
        acc = Cons(xs[i], acc)
        i -= 1
    }
    acc
}

/// Build a list from an array-like source. Order is preserved.
///
/// [M-91.1-set-from-iter-iterable-param] (a mirror of `Set[T].from_iter` /
/// `HashMap.from`): takes a concrete `[]T`, not the generic `Iter[T]`
/// protocol — the latter is erased to `void*` in a mono'd generic body, and
/// `for-in` could not recover the iterator's C type. An array iterates
/// correctly for any element type.
#stable(since = "0.1")
export fn LinkedList[T].from_iter(items []T) -> Self {
    // Prepend каждый элемент → получаем обратный список (O(1) на шаг).
    // Затем reverse — суммарно O(n), без вспомогательного массива.
    mut acc = Empty
    for x in items {
        acc = Cons(x, acc)
    }
    acc.reversed()
}

// ──────────────────────────────────────────────────────────────────────────
// Базовые операции
// ──────────────────────────────────────────────────────────────────────────

/// Length of the list. O(n).
#stable(since = "0.1")
export fn LinkedList[T] @len() -> int =>
    match @ {
        Empty       => 0
        Cons(_, t)  => 1 + t.len()
    }

/// Returns `true` if the list is empty.
#stable(since = "0.1")
export fn LinkedList[T] @is_empty() -> bool =>
    match @ {
        Empty    => true
        Cons(..) => false                // partial: все поля игнорируются
    }

/// The first element, or `None` for an empty list.
#stable(since = "0.1")
export fn LinkedList[T] @head() -> Option[T] =>
    match @ {
        Empty       => None
        Cons(h, _)  => Some(h)
    }

/// The list without its first element. Returns `Empty` for an empty list.
#stable(since = "0.1")
export fn LinkedList[T] @tail() -> Self =>
    match @ {
        Empty       => Empty
        Cons(_, t)  => t
    }

// ──────────────────────────────────────────────────────────────────────────
// Конструкция
// ──────────────────────────────────────────────────────────────────────────

/// Prepend an element to the list. O(1).
#stable(since = "0.1")
export fn LinkedList[T] @prepend(x T) -> Self =>
    Cons(x, @)

/// Append an element to the end of the list. O(n).
///
/// For frequent appends, prefer `[]T`.
#stable(since = "0.1")
export fn LinkedList[T] @append(x T) -> Self =>
    match @ {
        Empty       => Cons(x, Empty)
        Cons(h, t)  => Cons(h, t.append(x))
    }

// ──────────────────────────────────────────────────────────────────────────
// Операции трансформации
// ──────────────────────────────────────────────────────────────────────────

/// Reverse the element order. O(n) via an accumulator without recursion.
#stable(since = "0.1")
export fn LinkedList[T] @reversed() -> Self {
    mut acc = Empty
    mut cur = @
    mut done = false
    while !done {
        match cur {
            Empty      => { done = true }
            Cons(h, t) => {
                acc = Cons(h, acc)
                cur = t
            }
        }
    }
    acc
}

/// Apply a function to each element, returning a new list. O(n).
#stable(since = "0.1")
export fn LinkedList[T] @map[U](f fn(T) -> U) -> LinkedList[U] =>
    match @ {
        Empty       => Empty
        Cons(h, t)  => Cons(f(h), t.map(f))
    }

/// Return a list of the elements for which `pred` returns `true`. O(n).
#stable(since = "0.1")
export fn LinkedList[T] @filter(pred fn(T) -> bool) -> Self =>
    match @ {
        Empty       => Empty
        Cons(h, t)  => if pred(h) { Cons(h, t.filter(pred)) }
                       else        { t.filter(pred) }
    }

/// Fold the list left-to-right through `f(acc, elem)`. O(n).
///
/// # Examples
///
/// ```nova
/// ro l = LinkedList[int].from_array([1, 2, 3, 4])
/// assert(l.fold(0, |acc, x| acc + x) == 10)
/// ```
#stable(since = "0.1")
export fn LinkedList[T] @fold[Acc](init Acc, f fn(Acc, T) -> Acc) -> Acc =>
    match @ {
        Empty       => init
        Cons(h, t)  => t.fold(f(init, h), f)
    }

// ──────────────────────────────────────────────────────────────────────────
// Конкатенация — operator overloading (D46)
// ──────────────────────────────────────────────────────────────────────────

/// Concatenation `a + b`. O(len(a)).
#stable(since = "0.1")
export fn LinkedList[T] @plus(other Self) -> Self =>
    match @ {
        Empty       => other
        Cons(h, t)  => Cons(h, t + other)
    }

// Тесты — см. peer `linkedlist_test.nv` (module collections.linkedlist_test).
