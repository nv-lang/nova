// stdlib_linkedlist.nv — односвязный список через recursive sum-type.
//
// Демонстрирует [D52](../spec/decisions/02-types.md#d52) sum с
// рекурсивным конструктором — классический ML-стиль:
//
//   type LinkedList[T] enum | Empty | Cons(T, LinkedList[T])
//
// Pattern matching на этой структуре — самый прямой пример sum-семантики
// и exhaustiveness check от компилятора.
//
// Практически в backend этот тип редко используется (`[]T` эффективнее),
// но он — каноническая иллюстрация sum-recursion для AI-обучения.

module collections.linkedlist

// ──────────────────────────────────────────────────────────────────────────
// Тип
// ──────────────────────────────────────────────────────────────────────────

/// Односвязный список через рекурсивный sum-type (ML-стиль).
///
/// Структурно: `Empty | Cons(head, tail)`. Память управляется GC — узлы
/// освобождаются автоматически при недостижимости.
///
/// Для большинства задач `[]T` эффективнее. `LinkedList` — каноническая
/// иллюстрация sum-recursion и pattern matching в Nova.
///
/// # Examples
///
/// ```nova
/// ro l = LinkedList[int].from_array([1, 2, 3])
/// assert(l.head() == Some(1))
/// assert(l.len() == 3)
/// ro doubled = l.map(|x| x * 2)
/// assert(doubled.head() == Some(2))
/// ```
///
/// # See Also
///
/// - `[Deque]` — двусторонняя очередь на массиве
/// - `[Queue]` — FIFO очередь через два массива
#stable(since = "0.1")
export type LinkedList[T] enum
    | Empty
    | Cons(T, LinkedList[T])

// ──────────────────────────────────────────────────────────────────────────
// Конструкторы
// ──────────────────────────────────────────────────────────────────────────

/// Создать пустой список.
#stable(since = "0.1")
export fn LinkedList[T].new() -> Self => Empty

/// Построить список из массива. Порядок сохраняется.
///
/// # Examples
///
/// ```nova
/// ro l = LinkedList[int].from_array([1, 2, 3])
/// assert(l.head() == Some(1))
/// ```
#stable(since = "0.1")
export fn LinkedList[T].from_array(xs []T) -> Self {
    mut acc = Empty
    mut i = xs.len() - 1
    while i >= 0 {
        acc = Cons(xs[i], acc)
        i -= 1
    }
    acc
}

/// Построить список из массива-подобного источника. Порядок сохраняется.
///
/// [M-91.1-set-from-iter-iterable-param] (зеркало `Set[T].from_iter` /
/// `HashMap.from`): принимает конкретный `[]T`, не generic-протокол
/// `Iter[T]` — последний стирается в `void*` в mono'd generic-теле, и
/// `for-in` не мог восстановить C-тип итератора. Массив итерируется
/// корректно для любого типа элемента.
#stable(since = "0.1")
export fn LinkedList[T].from_iter(items []T) -> Self {
    // Prepend каждый элемент → получаем обратный список (O(1) на шаг).
    // Затем reverse — суммарно O(n), без вспомогательного массива.
    mut acc = Empty
    for x in items {
        acc = Cons(x, acc)
    }
    acc.reversed()
}

// ──────────────────────────────────────────────────────────────────────────
// Базовые операции
// ──────────────────────────────────────────────────────────────────────────

/// Длина списка. O(n).
#stable(since = "0.1")
export fn LinkedList[T] @len() -> int =>
    match @ {
        Empty       => 0
        Cons(_, t)  => 1 + t.len()
    }

/// Возвращает `true` если список пуст.
#stable(since = "0.1")
export fn LinkedList[T] @is_empty() -> bool =>
    match @ {
        Empty    => true
        Cons(..) => false                // partial: все поля игнорируются
    }

/// Первый элемент или `None` для пустого списка.
#stable(since = "0.1")
export fn LinkedList[T] @head() -> Option[T] =>
    match @ {
        Empty       => None
        Cons(h, _)  => Some(h)
    }

/// Список без первого элемента. Возвращает `Empty` для пустого списка.
#stable(since = "0.1")
export fn LinkedList[T] @tail() -> Self =>
    match @ {
        Empty       => Empty
        Cons(_, t)  => t
    }

// ──────────────────────────────────────────────────────────────────────────
// Конструкция
// ──────────────────────────────────────────────────────────────────────────

/// Добавить элемент в начало списка. O(1).
#stable(since = "0.1")
export fn LinkedList[T] @prepend(x T) -> Self =>
    Cons(x, @)

/// Добавить элемент в конец списка. O(n).
///
/// Для частых append предпочтительнее использовать `[]T`.
#stable(since = "0.1")
export fn LinkedList[T] @append(x T) -> Self =>
    match @ {
        Empty       => Cons(x, Empty)
        Cons(h, t)  => Cons(h, t.append(x))
    }

// ──────────────────────────────────────────────────────────────────────────
// Операции трансформации
// ──────────────────────────────────────────────────────────────────────────

/// Обратить порядок элементов. O(n) через accumulator без рекурсии.
#stable(since = "0.1")
export fn LinkedList[T] @reversed() -> Self {
    mut acc = Empty
    mut cur = @
    mut done = false
    while !done {
        match cur {
            Empty      => { done = true }
            Cons(h, t) => {
                acc = Cons(h, acc)
                cur = t
            }
        }
    }
    acc
}

/// Применить функцию к каждому элементу, вернуть новый список. O(n).
#stable(since = "0.1")
export fn LinkedList[T] @map[U](f fn(T) -> U) -> LinkedList[U] =>
    match @ {
        Empty       => Empty
        Cons(h, t)  => Cons(f(h), t.map(f))
    }

/// Вернуть список из элементов, для которых `pred` возвращает `true`. O(n).
#stable(since = "0.1")
export fn LinkedList[T] @filter(pred fn(T) -> bool) -> Self =>
    match @ {
        Empty       => Empty
        Cons(h, t)  => if pred(h) { Cons(h, t.filter(pred)) }
                       else        { t.filter(pred) }
    }

/// Свернуть список слева направо через `f(acc, elem)`. O(n).
///
/// # Examples
///
/// ```nova
/// ro l = LinkedList[int].from_array([1, 2, 3, 4])
/// assert(l.fold(0, |acc, x| acc + x) == 10)
/// ```
#stable(since = "0.1")
export fn LinkedList[T] @fold[Acc](init Acc, f fn(Acc, T) -> Acc) -> Acc =>
    match @ {
        Empty       => init
        Cons(h, t)  => t.fold(f(init, h), f)
    }

// ──────────────────────────────────────────────────────────────────────────
// Конкатенация — operator overloading (D46)
// ──────────────────────────────────────────────────────────────────────────

/// Конкатенация `a + b`. O(len(a)).
#stable(since = "0.1")
export fn LinkedList[T] @plus(other Self) -> Self =>
    match @ {
        Empty       => other
        Cons(h, t)  => Cons(h, t + other)
    }

// Тесты — см. peer `linkedlist_test.nv` (module collections.linkedlist_test).
