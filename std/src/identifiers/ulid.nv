// stdlib/ulid.nv — ULID (Universally Unique Lexicographically Sortable
// Identifier).
//
// Independent implementation. Спецификация:
//   https://github.com/ulid/spec (CC0/MIT)
//
// ULID = 128 бит = 26 символов в Crockford's Base32:
//   - 48 бит (10 chars) — Unix timestamp ms
//   - 80 бит (16 chars) — random
//
// Преимущества над UUID:
//   - Lexicographically sortable (как UUID v7, но компактнее)
//   - Crockford's Base32: без I, L, O, U — нет визуальной путаницы
//   - 26 символов vs 36 у UUID — компактнее
//   - Case-insensitive
//
// Использование:
//   - Primary keys в БД (B-tree friendly из-за timestamp prefix)
//   - Distributed event IDs
//   - Файловые имена с timestamp'ом
//
// Decisions:
//   - D52 record-тип, D55 record-coercion
//   - D67 ?-оператор работает только на Result/Option
//   - `Ulid.from(s)` / `u.to_str()` — конструктор-конверсия/представление (D410)
//   - D74 instance-методы числовых операций
//   - Эффекты Random, Time для генерации
//
// API:
//   Ulid.new() Time Random -> Self
//   Ulid.from(s str) Fail[ParseUlidError] -> Self
//   u.to_str() -> str
//   u.timestamp_ms() -> u64

module identifiers.ulid


// ──────────────────────────────────────────────────────────────────────────
// Тип
// ──────────────────────────────────────────────────────────────────────────

/// ULID — 128-bit Universally Unique Lexicographically Sortable Identifier.
///
/// 48 bits timestamp ms (lexicographically sortable) + 80 bits random.
/// Crockford's Base32 encoding (26 chars, без I/L/O/U — нет визуальной путаницы).
/// Use cases: primary keys (B-tree friendly), distributed event IDs, файловые имена.
///
/// # Examples
/// ```nova
/// let u = Ulid.new()
/// let s = u.to_str()            // 26-char Crockford Base32
/// assert(s.len == 26)
/// ```
#stable(since = "0.1")
export type Ulid {
    ro ts_part   u64     // public: старшие 48 бит timestamp + 16 бит random
    ro rand_part u64     // public: 64 бита random
}

/// Errors при парсинге ULID-строки.
#stable(since = "0.1")
export type ParseUlidError enum
    | InvalidLength { actual int, expected int }
    | InvalidChar { position int, char char }
    | TimestampOverflow                              // > 2^48 ms (~10889 AD)


// ──────────────────────────────────────────────────────────────────────────
// Crockford's Base32 alphabet
// ──────────────────────────────────────────────────────────────────────────

// 32-символьный алфавит:
//   0123456789ABCDEFGHJKMNPQRSTVWXYZ
//
// Исключены: I (=1), L (=1), O (=0), U (= confusing с V)
//
// Case-insensitive при декодировании.

fn encode_char(value u8) -> char {
    // value в [0, 31]. Plan 34 Ф.5.2: `int as char` запрещён D54.
    ro code = if value < 10 {
        '0' as int + value as int
    } else if value < 18 {
        // 10..17 → A..H
        'A' as int + value as int - 10
    } else if value == 18 {
        'J' as int
    } else if value == 19 {
        'K' as int
    } else if value == 20 {
        'M' as int
    } else if value == 21 {
        'N' as int
    } else if value < 26 {
        // 22..25 → P..S
        'P' as int + value as int - 22
    } else if value == 26 {
        'T' as int
    } else if value < 31 {
        // 27..30 → V..Y
        'V' as int + value as int - 27
    } else {
        'Z' as int                                   // 31
    }
    match code.to_char() {
        Ok(c)  => c
        Err(_) => '?'
    }
}

fn decode_char(c char) -> Option[u8] {
    ro n = c as int
    // 0..9 → 0..9
    if n >= 48 && n <= 57 { return Some((n - 48) as u8) }

    // Normalize lowercase → uppercase для case-insensitive
    ro upper = if n >= 97 && n <= 122 { n - 32 } else { n }

    // I → 1, L → 1 (Crockford "ambiguity remap"); O → 0
    if upper == 73 { return Some(1) }                 // 'I'
    if upper == 76 { return Some(1) }                 // 'L'
    if upper == 79 { return Some(0) }                 // 'O'

    // A..H → 10..17
    if upper >= 65 && upper <= 72 { return Some((upper - 65 + 10) as u8) }
    // J → 18, K → 19
    if upper == 74 { return Some(18) }
    if upper == 75 { return Some(19) }
    // M → 20, N → 21
    if upper == 77 { return Some(20) }
    if upper == 78 { return Some(21) }
    // P..S → 22..25
    if upper >= 80 && upper <= 83 { return Some((upper - 80 + 22) as u8) }
    // T → 26
    if upper == 84 { return Some(26) }
    // V..Y → 27..30
    if upper >= 86 && upper <= 89 { return Some((upper - 86 + 27) as u8) }
    // Z → 31
    if upper == 90 { return Some(31) }

    None
}


// ──────────────────────────────────────────────────────────────────────────
// Генерация
// ──────────────────────────────────────────────────────────────────────────

/// Generate new ULID с текущим timestamp и random частью.
///
/// Использует Time + Random effects (ambient). В тестах детерминируется
/// через `with Time = th.fixed_ms(...), Random = th.seeded(...)`.
///
/// Throws `TimestampOverflow` если ms ≥ 2^48 (~10889 AD).
#stable(since = "0.1")
export fn Ulid.new() Time Random Fail[ParseUlidError] -> Self { // [M-lint-findings-fail-public-signature]
    ro ms = Timestamp.now().unix_millis() as u64
    if ms >= 0x1000000000000 {                       // 2^48
        throw TimestampOverflow
    }

    // ts_part: 48 бит timestamp в верхних, 16 бит random в младших
    ro rand16 = Random.u64() & 0xFFFF
    ro ts_part = (ms << 16) | rand16

    ro rand_part = Random.u64()

    { ts_part, rand_part }
}


// ──────────────────────────────────────────────────────────────────────────
// Геттеры
// ──────────────────────────────────────────────────────────────────────────

/// Extract Unix timestamp ms из ULID (старшие 48 бит ts_part).
#stable(since = "0.1")
export fn Ulid @timestamp_ms() -> u64 =>
    @ts_part >> 16


// ──────────────────────────────────────────────────────────────────────────
// Сравнение (D46)
// ──────────────────────────────────────────────────────────────────────────

/// Equality (`==`) — structural по обеим частям.
#stable(since = "0.1")
export fn Ulid @equal(other Ulid) -> bool =>
    @ts_part == other.ts_part && @rand_part == other.rand_part

/// Compare — лексикографический order по timestamp, затем random.
/// Точно как сравнение строк-ULID'ов лексикографически — главная фича.
/// Returns <0, 0, >0.
#stable(since = "0.1")
export fn Ulid @compare(other Ulid) -> int {
    if @ts_part != other.ts_part {
        if @ts_part < other.ts_part { -1 } else { 1 }
    } else if @rand_part != other.rand_part {
        if @rand_part < other.rand_part { -1 } else { 1 }
    } else {
        0
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Сериализация (D410)
// ──────────────────────────────────────────────────────────────────────────

/// `to_str()` — 26-char Crockford Base32 string. Round-trip с `Ulid.from`.
///
/// # Examples
/// ```nova
/// let u = Ulid.new()
/// assert(Ulid.from(u.to_str()) == u)
/// ```
#stable(since = "0.1")
export fn Ulid @to_str() -> str {
    consume buf = StringBuilder.new(cap: 26)

    // 48-бит timestamp → 10 chars (10 × 5 = 50 бит, padding 2 нулевых
    // в старших). Т.е. для timestamp нужно value < 2^48 — гарантировано
    // в new(). Сериализация всё равно даёт 10 chars где старший — 0..3.
    ro ts = @ts_part >> 16
    mut shift = 45
    while shift >= 0 {
        ro val = ((ts >> shift) & 0x1F) as u8
        buf.append(encode_char(val))
        shift -= 5
    }

    // 80-бит random → 16 chars (16 × 5 = 80 бит ровно)
    // Биты:
    //   ts_part младшие 16 бит — биты 0..15 random
    //   rand_part 64 бита — биты 16..79
    // Итого 80 бит. Старшие 5 бит = старшие 5 бит rand_part.
    ro r_hi = @rand_part                            // 64 бита, биты 16..79 random'а
    ro r_lo = @ts_part & 0xFFFF                      // 16 бит, биты 0..15 random'а

    // Сериализуем: 16 chars × 5 бит = 80 бит.
    // Биты: [r_hi 64 бит][r_lo 16 бит] = всего 80 бит.
    // Старшие 5 бит = r_hi >> 59.
    // Удобнее считать через объединённое значение в high и low.
    mut shift2 = 75
    while shift2 >= 0 {
        // Извлекаем 5 бит на позиции [shift2 .. shift2+4] из 80-бит значения
        ro val = if shift2 >= 16 {
            // Биты в r_hi: позиции (shift2 - 16) .. (shift2 - 16 + 4)
            ((r_hi >> (shift2 - 16)) & 0x1F) as u8
        } else {
            // Может быть split: shift2 < 16 значит окно пересекает границу r_hi/r_lo.
            // Хотелось бы всё в одном выражении через 80-битное представление
            // (`total >> shift2 & 0x1F`, где `total = (r_hi << 16) | r_lo`), но
            // 80 бит не помещается в u64 — вместо этого separate cases:
            //   shift2 == 15: окно [15..19] пересекает границу — r_lo даёт бит 15,
            //   r_hi даёт биты 0..3 → нужно объединять (см. ветку ниже).
            //   shift2 ∈ {10, 5, 0}: окно целиком внутри r_lo (shift2+4 < 16).
            //
            // [BUG-2 fix] Раньше здесь стояла ДОХЛАЯ (никогда не читаемая)
            // проба-в-одну-строку `low_bits = (r_lo >> shift2) & ((1 << (5 -
            // shift2)) - 1)` — черновик отменённого «всё в одном выражении»
            // подхода выше, оставленный по ошибке. Для shift2 ∈ {10, 15}
            // `5 - shift2` — отрицательное число, а весь этот под-выражение
            // типизируется как u64 (контекст `&` с r_lo/r_hi) → `nova_u64_
            // checked_sub(5, shift2)` детерминированно underflow'ил на КАЖДОМ
            // вызове `to_str()` (D423 trap-default честно поймал бывший тихий
            // wraparound мёртвого кода) — RUN-FAIL "integer overflow: -"
            // (std/src/identifiers/ulid_test.nv). Не легитимный ULID-wraparound
            // (нет физического смысла — значение нигде не читалось), поэтому
            // wrapping_*/checked_* тут не нужны — просто удалено.
            if shift2 + 4 >= 16 {
                // Window spans r_lo high and r_hi low
                ro from_lo = r_lo >> shift2                            // младшие биты выходного значения
                ro from_hi = (r_hi & ((1 << (shift2 + 5 - 16)) - 1)) << (16 - shift2)
                ((from_hi | from_lo) & 0x1F) as u8
            } else {
                // shift2 + 4 < 16: всё в r_lo
                ((r_lo >> shift2) & 0x1F) as u8
            }
        }
        buf.append(encode_char(val))
        shift2 -= 5
    }

    buf
}


// ──────────────────────────────────────────────────────────────────────────
// Парсинг
// ──────────────────────────────────────────────────────────────────────────

/// Parse 26-char Crockford Base32 ULID. Case-insensitive.
/// `I`/`L` → 1, `O` → 0 (Crockford ambiguity remap).
#stable(since = "0.1")
export fn Ulid.from(s str) Fail[ParseUlidError] -> Self { // [M-lint-findings-static-conversion]
    if s.byte_len() != 26 {
        throw InvalidLength { actual: s.byte_len(), expected: 26 }
    }

    // 10 timestamp chars + 16 random chars = 26.
    // Каждый char = 5 бит, итого 130 бит. Старшие 2 бита timestamp
    // должны быть 0 (timestamp 48 бит max, представляется в 50 битах).

    // Парсим timestamp (48 бит)
    mut ts u64 = 0
    for i in 0..10 {
        ro v = decode_char_or_throw(s, i)
        ts = (ts << 5) | (v as u64)
    }

    // Старшие 2 бита timestamp должны быть 0 (после 10 chars × 5 = 50 бит).
    // ts уже 50-битное значение; берём 48 младших.
    if ts >= 0x1000000000000 {
        throw TimestampOverflow
    }

    // Парсим random (80 бит) в две u64 части
    mut r_hi u64 = 0          // биты 16..79
    mut r_lo u64 = 0          // биты 0..15 (только 16 бит)

    // Сначала 80-битное значение в split: 64 high + 16 low.
    // Эквивалентно: shift через все 16 chars, последние 16 бит идут в r_lo.
    mut full_lo u64 = 0
    mut full_hi u64 = 0
    for j in 0..16 {
        ro v = decode_char_or_throw(s, 10 + j)
        // Сдвигаем 80-битное значение влево на 5, добавляем v в младшие 5.
        // 80 бит = (full_hi << 16) | full_lo, но удобнее иметь две u64 и
        // пересылать переполнение.
        ro new_lo = (full_lo << 5) | (v as u64)
        ro new_hi = (full_hi << 5) | (full_lo >> 59)
        full_lo = new_lo & 0xFFFFFFFFFFFFFFFF        // u64 mask (no-op в u64)
        full_hi = new_hi
    }

    // Теперь 80 бит = full_hi (старшие 16 бит) + full_lo (64 бита).
    // ts_part = (ts << 16) | (top 16 бит random)
    // rand_part = младшие 64 бита random
    ro rand_top16 = (full_hi & 0xFFFF) << 48 | (full_lo >> 16) << 0
    // Лучше просто: r_hi (вверх 64 бита random) = full_hi << 48 | full_lo >> 16
    ro rand_64 = (full_hi << 48) | (full_lo >> 16)
    ro rand_low_16 = full_lo & 0xFFFF

    ro ts_part = (ts << 16) | rand_low_16
    ro rand_part = rand_64

    { ts_part, rand_part }
}

// Crockford base32 alphabet is pure ASCII — direct byte access O(1) instead
// of the ретрактированный `chars().nth(pos)` O(n) scan (D260-амендмент).
fn decode_char_or_throw(s str, pos int) Fail[ParseUlidError] -> u8 {
    match s.bytes().get(pos) {
        Some(b) => {
            ro c = (b as int).to_char() ?? ' '
            match decode_char(c) {
                Some(v) => v
                None    => throw InvalidChar { position: pos, char: c }
            }
        }
        None => throw InvalidLength { actual: s.byte_len(), expected: 26 }
    }
}


// Тесты — см. peer-файл ulid_test.nv (module identifiers.ulid_test).
