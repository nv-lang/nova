// stdlib/uuid_v3_v5.nv — name-based UUIDs (RFC 4122 § 4.3).
//
// v3 = MD5(namespace || name)  — legacy, MD5 broken
// v5 = SHA-1(namespace || name) — preferred для name-based
//
// Namespace UUIDs из RFC 4122 Appendix C:
//   DNS:  6ba7b810-9dad-11d1-80b4-00c04fd430c8
//   URL:  6ba7b811-9dad-11d1-80b4-00c04fd430c8
//   OID:  6ba7b812-9dad-11d1-80b4-00c04fd430c8
//   X500: 6ba7b814-9dad-11d1-80b4-00c04fd430c8

module identifiers.uuid_namespace

import std.identifiers.uuid.{Uuid}
import std.crypto.md5.{Md5}
import std.crypto.sha1.{Sha1}

/// DNS namespace UUID (RFC 4122 Appendix C). Used for name-based UUIDs
/// from DNS names (e.g. www.example.com).
#stable(since = "0.1")
export fn namespace_dns() -> Uuid =>
    Uuid.new(0x6ba7b8109dad11d1, 0x80b400c04fd430c8)

/// URL namespace UUID (RFC 4122 Appendix C). For URL-based name UUIDs.
#stable(since = "0.1")
export fn namespace_url() -> Uuid =>
    Uuid.new(0x6ba7b8119dad11d1, 0x80b400c04fd430c8)

/// OID namespace UUID (RFC 4122 Appendix C). For ISO OID identifiers.
#stable(since = "0.1")
export fn namespace_oid() -> Uuid =>
    Uuid.new(0x6ba7b8129dad11d1, 0x80b400c04fd430c8)

/// X.500 namespace UUID (RFC 4122 Appendix C). For X.500 DN-based name UUIDs.
#stable(since = "0.1")
export fn namespace_x500() -> Uuid =>
    Uuid.new(0x6ba7b8149dad11d1, 0x80b400c04fd430c8)

/// UUID v3: name-based, MD5(namespace || name). **Legacy** — MD5 broken,
/// prefer `Uuid.v5` for new projects.
#stable(since = "0.1")
export fn Uuid.v3(namespace Uuid, name str) -> Self {
    mut input []u8 = []
    push_uuid_bytes(input, namespace)
    for b in name.bytes() { input.push(b) }

    ro digest = Md5.hash(input)
    mut bytes = digest[..16]

    // Set version=3 (MD5) и variant
    set_version_variant(bytes, 3)
    bytes_to_uuid(bytes)
}

/// UUID v5: name-based, SHA-1(namespace || name). Deterministic (same inputs → same UUID).
///
/// # Examples
/// ```nova
/// let u = Uuid.v5(namespace_dns(), "www.example.com")
/// assert(u.to_str() == "2ed6657d-e927-568b-95e1-2665a8aea6a2")
/// ```
#stable(since = "0.1")
export fn Uuid.v5(namespace Uuid, name str) -> Self {
    mut input []u8 = []
    push_uuid_bytes(input, namespace)
    for b in name.bytes() { input.push(b) }

    ro digest = Sha1.hash(input)
    // Берём первые 16 байт SHA-1 (она даёт 20) — срез-вид (§18а).
    mut bytes = digest[..16]

    set_version_variant(bytes, 5)
    bytes_to_uuid(bytes)
}

// ──────────────────────────────────────────────────────────────────────────
// Helpers
// ──────────────────────────────────────────────────────────────────────────

fn push_uuid_bytes(mut out []u8, u Uuid) {
    mut i = 7
    while i >= 0 {
        out.push(((u.hi >> (i * 8)) & 0xFF) as u8)
        i -= 1
    }
    mut j = 7
    while j >= 0 {
        out.push(((u.lo >> (j * 8)) & 0xFF) as u8)
        j -= 1
    }
}

fn set_version_variant(mut bytes []u8, version int) {
    // Version в старшие 4 бита 6-го байта (нумерация с 0).
    bytes[6] = (((bytes[6] as int) & 0x0F) | (version << 4)) as u8
    // Variant 10 в старшие 2 бита 8-го байта.
    bytes[8] = (((bytes[8] as int) & 0x3F) | 0x80) as u8
}

fn bytes_to_uuid(bytes []u8) -> Uuid {
    mut hi u64 = 0
    for i in 0..8 {
        hi = (hi << 8) | (bytes[i] as u64)
    }
    mut lo u64 = 0
    for j in 8..16 {
        lo = (lo << 8) | (bytes[j] as u64)
    }
    Uuid.new(hi, lo)
}
