// Prelude — auto-imported в каждый module (через resolve_imports_inline).
//
// Splittable: types/methods/fns живут в `std/prelude/<sub>.nv`,
// `std/prelude.nv` — facade re-export'ит их.
//
// Текущий статус:
//   - core types (Option/Result/Some/None/Ok/Err/Error/Ordering)
//     в std/prelude/core.nv. Bottom-тип `never` — строчный встроенный
//     примитив, в prelude НЕ объявляется.
//   - panic/exit/assert/print/println/suppressed в std/prelude/runtime.nv.
//   - RuntimeError + ReadBufferError + RuntimeNoneError
//     в std/prelude/errors.nv.
//   - Iter[T] protocol формально объявлен в std/prelude/collections.nv.
//   - Protocols (Hash/Equal/Compare/Display/Clone/Index/MutIndex)
//     в std/prelude/protocols.nv.
//   - Fail[E] effect формально объявлен в std/prelude/effects.nv.
//
// **Re-export syntax:** wildcard `export import X.*` не поддерживается —
// используем selective form `export import X.{A, B, ...}`.
// Каждый re-export'ленный name становится auto-available в любом module.

module std.prelude

// Re-export всех core prelude items из std.prelude.core.
// Type names + variant constructors + Error + Ordering — все
// перечислены selectively, поскольку `.*` wildcard не поддерживается.
// Multi-line lists тоже не поддерживаются (bootstrap parser
// `parse_import_inner` не skip'ает newlines внутри `{ }`), поэтому всё
// на одной строке.
//
// Bottom-тип `never` НЕ re-export'ится: это строчный встроенный
// примитив, известен компилятору напрямую — как `int`/`bool`,
// примитивы не объявляются и не re-export'ятся через prelude.
// Ordering/Less/Equal/Greater удалены (Compare.compare -> int).
export import std.prelude.core.{Option, Some, None, Result, Ok, Err, Error, sequence, partition}

// Re-export runtime functions из std.prelude.runtime:
// panic / exit / assert / print / println / suppressed — selective list.
// `suppressed()` — free accessor for the caught primary error's suppressed
// cleanup-failures (`[]any`).
export import std.prelude.runtime.{panic, exit, unreachable, assert, print, println, suppressed, caller_loc}

// Canonical .new() для primitive types.
// `int.new() => 0`, `bool.new() => false`, `f64.new() => 0.0`, etc.
// см. std/runtime/defaults.nv. Static methods на primitives — type-resolver
// видит их через method_table; auto-import делает доступными без явного import.
import std.runtime.defaults

// `char` сюда: `char @to_str()` / `str.from_codepoint` эмитит САМ
// компилятор (тест-харнесс, строковая интерполяция char-литералов) — пользователь
// не может заимпортить за compiler-generated код → обязан быть неявным, как
// Option/print. Прочие std-API (sync/net/cstr) — библиотечные, требуют ЯВНЫЙ
// import (НЕ в prelude). Плейн import (как `defaults`) инлайнит char-сигнатуры
// в каждый модуль → единый реестр (из import-resolved модуля) их содержит.
import std.runtime.char

// `f64`/`f32` math-intrinsics (sqrt/abs/trig/exp/log/...) + `int.abs()`
// были known ТОЛЬКО через codegen-хардкод — реальные `extern "nova"`
// декларации не импортировались, поэтому чекер не видел сигнатуры в
// `method_table`. Плейн import (как `char`/`defaults` выше) делает их
// auto-available (без явного `import` пользователем) И инлайнит сигнатуры
// в `method_table`, так что чекер теперь резолвит `.sqrt()`/`.abs()` через
// нормальный overload-канал. Codegen EMISSION для f64/f32 math не меняется —
// codegen-хардкод остаётся единственным источником C-функции (`sqrt`/...).
// `int.abs()` — ИСКЛЮЧЕНИЕ из этого правила: `int @abs()` ретрактирован
// (был extern "nova" -> C `llabs`, UB на `T.MIN`) — `abs` для `int`
// (и узких signed) теперь настоящий `.nv`-бланкет
// (std/prelude/protocols.nv, `fn[T SignedInts] T @abs()`), без
// C-function-name хардкода.
import std.runtime.math

// Re-export error types из std.prelude.errors.
// RuntimeError (6 variants) + ReadBufferError (1 variant) +
// RuntimeNoneError (unit-type — ошибка `Option!!` на None). Type
// name + variant constructors — все перечислены selectively (см. выше
// note про wildcard и multi-line).
export import std.prelude.errors.{RuntimeError, DivByZero, Overflow, IndexOutOfBounds, TypeMismatch, AssertFailed, NoHandler, ReadBufferError, UnexpectedEnd, RuntimeNoneError, RangeError}

// Re-export Iter[T] protocol formal declaration из std.prelude.collections.
// Раньше `Iter[T]` существовал ТОЛЬКО как structural duck-typing — формальная
// декларация даёт `nova doc` canonical API + eligible как bound (`T Iter`).
// Не ломает existing structural for-in dispatch (codegen ищет метод `next`
// напрямую, protocol declaration не enforced на type annotations).
//
// StringBuilder / WriteBuffer / ReadBuffer — opaque types declared через
// `external type` в std/prelude/collections.nv; auto-available через prelude.
// Methods продолжают жить в `std/runtime/<name>.nv` (external fn).
// Iterable[T] → Next[T] + Iter[I]
export import std.prelude.collections.{Next, Iter, StringBuilder, WriteBuffer, ReadBuffer}

// Re-export Range / RangeIter из std.collections.range.
//
// Auto-import: user-modules видят `Range`/`RangeIter` без явного import.
// Existing cross-file imports (`import std.collections.range.{Range}`) —
// продолжают работать (selective re-export не блокирует direct import).
export import std.collections.range.{Range, RangeIter}

// Re-export `Vec`/`VecIter` so `[]T ≡ Vec[T]` holds universally — every
// prelude unit now has the `Vec` template available, so value/type-position
// `[]T` lowers to the typed `Nova_Vec____<elem>*` storage (not the legacy
// NovaArray int64-erasure).
// MUST come AFTER the Range re-export above: `vec_owned` depends on `Range`
// (`Vec[T] @index(r Range)` range-slice view), and the prelude facade is
// resolved top-to-bottom. `#no_prelude` units degrade gracefully (Vec
// template absent → legacy NovaArray path, the contains_key("Vec") gates).
export import std.collections.vec.{Vec, VecIter}

// Re-export equality / hashing / ordering / display protocols из
// std.prelude.protocols.
//
// From/Into/TryFrom/TryInto РЕТРАКТИРОВАНЫ (протоколы + auto-derive синтез
// в компиляторе сняты целиком). Остаются Hash/Equal/Compare/Display/Clone/
// Index/MutIndex; bound clauses `[T Hash]` резолвятся через cross-file
// resolve как и раньше.
export import std.prelude.protocols.{Hash, Equal, Compare, Display, Clone, Index, MutIndex}

// Re-export Fail[E] effect из std.prelude.effects.
// Formal declaration matches hardcoded codegen pre-registration
// (NovaVtable_Fail + Nova_Fail_fail в nova_rt/effects.h). Type-checker
// и codegen матчат single-element path `["Fail"]` независимо. Декларация
// здесь даёт canonical API surface для `nova doc`.
//
// Time — ambient clock effect (sleep/now/after — last one runtime-only).
// Mem — runtime introspection (alloc_count/free_count/live/reset).
// Skip codegen emit через RUNTIME_DEFINED_TYPES + BUILTIN_VTABLE_NAMES.
//
// `real_random` — `Random`'s `#default_handler` factory (Plan 265 Ф.3 /
// №553 / D454; same `real_*` family as `real_time`/`real_os`/`real_fs`/
// `real_net`/`real_io`), re-exported by name so it is callable ambiently
// (`with Random = real_random() { … }`) exactly like
// `Random.u64()`/`Random.bytes(n)` themselves already are
// (`[M-random-u64-path-return-ice]`, std/prelude/effects.nv) — consistent
// with `Random` itself needing no import anywhere in the CU. `real_random()`
// is also the mechanism a program gets automatically without ANY `with
// Random = …` at all (lazy install-once, D431 §5); the explicit name
// exists for the rarer case of re-asserting it inside a scope that has an
// outer `with Random = th.seeded(...)` mock.
//
// **Detach** НЕ re-export'ится — это keyword-construct (`detach { ... }`),
// syntactic form а не declarable effect. См. std/prelude/effects.nv.
export import std.prelude.effects.{Fail, Time, Mem, real_random}

// Re-export CancelToken из std.prelude.concurrency — auto-available без
// explicit import, паритет с прежним builtin-статусом (`supervised(cancel: tok)`
// — языковая конструкция, токен обязан быть доступен везде). Dispatch остаётся
// в codegen special-cases (NovaCancelToken*, nova_cancel_token_* в
// nova_rt/fibers.h) — см. заголовок std/prelude/concurrency.nv.
//
// Outcome/Finished/Aborted (D455, Plan 266): `supervised(cancel: tok) { … }`
// (without `timeout:`/`deadline:`) returns `Outcome[T]` — same auto-available
// reasoning as CancelToken (a language-construct's result type must be
// visible everywhere without an explicit import). See std/prelude/concurrency.nv
// header for why the variants are named `Finished`/`Aborted`, not the D455
// working-proposal `Done`/`Cancelled` (both collide with existing global
// variant names — provisional pending owner amendment).
export import std.prelude.concurrency.{CancelToken, Outcome, Finished, Aborted}

// Re-export EmbeddedDir/EmbeddedEntry из std.prelude.embed — обязаны быть
// prelude-видимы, т.к. `embed_dir("dir")` резолвер (ДО type-check) синтезирует
// `EmbeddedDir.new([EmbeddedEntry{...}, …])` внутри ПОЛЬЗОВАТЕЛЬСКОГО кода,
// который ссылается на эти типы по имени без явного import.
export import std.prelude.embed.{EmbeddedDir, EmbeddedEntry}

// str Nova-body methods auto-available без explicit import.
// Конверсии are METHODS ON THE SOURCE (`s.to_int()`, `s.to_i64()`, ...) —
// не static constructors on the target type. Static-формы
// `str.from_bytes`/`from_bytes_lossy`/`from_bytes_unchecked` заменены на
// instance/consume методы на источнике `[]u8`: `@to_str()`/`@to_str_lossy()`/
// `@to_str_unchecked()`/`@into_str_unchecked()`. INSTANCE method-call syntax
// (`bytes.to_str()`) on a `#no_prelude`-homed method DOES need this re-export
// to be visible without an explicit `import std.runtime.string` — hence added
// here. std.runtime.string имеет #no_prelude — cycle protection
// (prelude→string→prelude).
export import std.runtime.string.{pad_left, pad_right, repeat, replace, compare, bytes, to_int, to_i64, to_u64, to_u32, to_u8, to_f64, to_str, to_str_lossy, to_str_unchecked, into_str_unchecked}

// char Unicode-aware methods (`'a'.is_alphabetic()` etc.) are NOT re-exported
// here. A bare `export import std.unicode.{is_alphabetic,…}` would ALSO pull
// the same-named free functions (`is_alphabetic(cp int)`,
// `general_category(cp int)`, `to_uppercase(s str)`) into the global prelude
// namespace — breaking the opt-in boundary (`general_category(0x41)` MUST stay
// undefined without `import std.unicode`). Instead the char @methods are made
// available without an explicit import by the resolver's auto-injection of
// `std.unicode` into the USER entry group when it sees a char-Unicode
// *method-call* selector (`expr.is_alphabetic()`, tagged `@method:` in
// lints::collect_expr). That path distinguishes method calls from the opt-in
// free-function form and never enters the prelude→unicode→collections cycle.
// `core` stays unicode-free → partial `#prelude(core,…)` is fixed.

/// Prelude version marker — verified in tests to confirm auto-import works.
/// Bumped on every Plan 62 migration phase.
///   - 1 = pre-migration (only this placeholder).
///   - 2 = Plan 62.A done (core types in file-based form).
///     Plan 62.B reused version 2 (runtime fns added).
///     Plan 62.C reused version 2 (error types added).
///     Plan 62.D non-opaque reused version 2 (Iter[T] added).
///     Plan 62.E reused version 2 (protocols added).
///   - 3 = Plan 62.F done (effects.Fail[E] added) + **Plan 62 closed**.
///   - 4 = Plan 62.D non-opaque bis-1 done: Range / RangeIter now
///     auto-available via the prelude facade (re-export from
///     std.collections.range), 4 latent codegen bugs closed
///     (match inference + closure scope analysis + D29 W_PRELUDE_SHADOW).
///   - 5 = Plan 62.F.bis done (2026-05-18): edition versioning
///     (`[package].edition` → `std/prelude/<sanitized>.nv` resolver) +
///     structured W_PRELUDE_SHADOW lint with `allow_prelude_shadow`
///     suppress + Time/Mem formal effect declarations + spec D-block
///     amendments.
///   - 6 = Plan 62.D.bis done (2026-05-18): StringBuilder / WriteBuffer /
///     ReadBuffer formally declared via new D126 `external type` syntax
///     in std/prelude/collections.nv. Auto-available via the prelude
///     facade — closes the last known-by-name hole in D26 visible
///     prelude. Methods continue to live in std/runtime/<name>.nv
///     (external fn, D82, unchanged).
///   - 7 = Plan 62.B.bis done (2026-05-18): print / println formally
///     declared in std/prelude/runtime.nv via D69 variadic + `[]any` —
///     canonical D26 signature `fn print(...items []any) -> ()`. Plan 67
///     hotfix (infer_print_helper refactor via infer_expr_c_type)
///     absorbed as Ф.0. Codegen special-case (emit_c.rs:11270) fires
///     before variadic routing (Ф.1 reorder) — preserves per-arg type
///     info, the synthesized `[]any` array is never built.
///   - 8 = Plan 62.E.bis done (2026-05-20): TryFrom / TryInto formally
///     re-exported via the prelude facade. Effect blocker lifted by Plan
///     56 Ф.2.7-revert (D122 amended — effects in protocol methods are
///     allowed under mono-dispatch); declarations use the form
///     `try_from(t T) -> Result[Self, E]` (D77, migration path b).
///   - 9 = Plan 62.C.bis done (2026-05-20): RuntimeNoneError
///     (unit-type, D85 — the `Option!!` on None error) formally
///     declared in std/prelude/errors.nv + re-export via the facade.
///     Blocker lifted by Plan 72 P1-B (bodyless-type support in the
///     parser). Remaining deferred sub-plans: 62.A.bis sum_schemas
///     removal (awaits Plan 59 Ф.7.5 increment 2).
///   - 10 = Plan 91 Ф.2.5 done (2026-05-28, D177): str Nova-body methods
///     (parse_int_radix / pad_left / pad_right / repeat / replace) now
///     auto-available via prelude re-export from std.runtime.string.
///   - 11 = Plan 91 Ф.2.6 done (2026-05-28, D178): str API cleanup:
///     bytes→to_bytes, chars→to_chars, parse_int_radix+parse_int→parse_int(radix=10),
///     compare added, split→readonly []str, readonly param syntax.
///   - 12 = Plan 138 (D239): `[]T` ≡ `Vec[T]` foundation (record/sig
///     lowering, array-literal typed-Vec construction) — gated on the Vec
///     template being present per compilation unit.
///   - 13 = (reserved increment — see chronology above).
///   - 14 = Plan 138.2 Ф.0-final (D239 universal flip, 2026-06-11): `Vec`/
///     `VecIter` re-exported from prelude → `[]T ≡ Vec[T]` UNIVERSAL. Every
///     prelude unit lowers value/type-position `[]T` to typed
///     `Nova_Vec____<elem>*` storage. `#no_prelude` units keep the legacy
///     NovaArray path (graceful degrade).
///   - 15 = D73/D77 retraction (2026-07-06): `From`/`Into`/`TryFrom`/
///     `TryInto` protocol declarations removed from std/prelude/protocols.nv
///     facade re-export (auto-derive synthesis removed from compiler too).
///     Remaining: Hash/Equal/Compare/Display. Static `.from`/`.try_from`
///     naming convention and `to_str()`/`to_*` (D410) are unaffected.
///   - 16 = Plan 174.1 done (2026-07-08): `str.parse_int` (D177/D178/D325
///     triad) RETRACTED as public API — removed from this facade's
///     `std.runtime.string` re-export. Replaced by conversion METHODS ON
///     THE SOURCE: `str.to_int()`/`to_i64()`/`to_u64()`/`to_u32()`/`to_u8()`/
///     `to_f64()` (std/runtime/string/parse.nv) — added to this re-export
///     list. (An earlier same-day design, static `T.parse(s)` on the numeric
///     type, was superseded by the owner before landing; a type-set-bounded
///     generic for it also hit a live path-call codegen gap,
///     [M-174.1-parse-typeset-pathcall], out of scope here.)
///   - 17 = Plan 196.3 done (2026-07-12, D109/D74 checker-visibility
///     migration): `std.runtime.math` (`f64`/`f32` math intrinsics +
///     `int.abs()`) now plain-imported (same pattern as `char`/`defaults`
///     above) so the checker resolves them via `method_table` instead of
///     the emit_c.rs-only `primitive_instance_method_known` existence
///     whitelist. Auto-available without explicit import (unchanged
///     surface); codegen emission (`f64_method_to_c`/`int_method_to_c`)
///     unaffected.
///   - 18 = Plan 210 done (2026-07-16, D412 amendment): `EmbeddedDir` /
///     `EmbeddedEntry` formally declared in std/prelude/embed.nv +
///     re-exported via the facade — `embed_dir("dir")` compile-time
///     intrinsic (the embed_resolve.rs resolver synthesizes
///     `EmbeddedDir.new([EmbeddedEntry{...}, …])`, sorted by path).
///     Payloads — zero-copy static rodata (existing HexBlobLit arm,
///     emit_c.rs untouched).
///   - 19 = [M-numeric-try-narrowing] done (2026-07-20, D430): `RangeError`
///     (unit-type, checked numeric-narrowing error) declared in
///     std/prelude/errors.nv + re-exported through this facade —
///     `try_to_<T>` family (std/prelude/protocols.nv, `fn[S Ints] S
///     @try_to_i8()`/.../`@try_to_uint()`) returns `Result[T, RangeError]`.
///   - 20 = Plan 265 Ф.3 / №553 done (2026-08-10, D454): `real_random()`
///     (`std/prelude/effects.nv`, same `real_*` family as `real_time`/
///     `real_os`/`real_fs`/`real_net`/`real_io`) declared as the
///     `#default_handler` for `Random`, re-exported through this facade —
///     `Uuid.v4()`/session ids/API keys/nonces are now unpredictable BY
///     DEFAULT (OS CSPRNG via `random_secure_u64()`, `nova_rt/runtime.c`),
///     not just under an explicit `with Random = th.seeded(...)` mock.
///   - 21 = Plan 266 done (2026-08-10, D455): `Outcome[T]` (`Finished(T) |
///     Aborted`) declared in std/prelude/concurrency.nv + re-exported
///     through this facade — `supervised(cancel: tok) { … }` (without
///     `timeout:`/`deadline:`) now returns `Outcome[T]` instead of the
///     unchecked-invariant plain `T`. Variant names are provisional
///     (`Finished`/`Aborted`, not the D455 working-proposal
///     `Done`/`Cancelled` — both collide with existing global variant
///     names, see std/prelude/concurrency.nv header) pending owner amendment.
#stable(since = "0.1")
export const PRELUDE_VERSION = 21
