// SPDX-License-Identifier: MIT OR Apache-2.0
// std/encoding/compress/gzip.nv — RFC 1952 gzip framing (pure Nova).
//
// Plan 179 Ф.1. magic 0x1f8b + DEFLATE + CRC-32 + ISIZE-trailer поверх
// `inflate.nv`. Пропускает FEXTRA/FNAME/FCOMMENT/FHCRC (длина полей капится —
// anti-flood, Q10). CRC-32 И ISIZE(mod 2^32) верифицируются (D336). MULTI-MEMBER:
// конкатенированные члены склеиваются (RFC 1952 §2.2); мусор после последнего
// валидного члена лениво игнорируется (multistream-совместимость, Q14).

module encoding.compress


// ──────────────────────────────────────────────────────────────────────────
// Разбор gzip-заголовка (переиспользуется one-shot + streaming)
// ──────────────────────────────────────────────────────────────────────────

// Ok(Some(hlen)) = заголовок из hlen байт; Ok(None) = нужно ещё байт; Err = битый.
fn parse_gzip_header(buf []u8, max_output int) -> Result[Option[int], CompressError] {
    if buf.len() < 10 {
        return Ok(None)
    }
    if !(buf[0] == 0x1f && buf[1] == 0x8b) {
        return Err(CompressError.bad_header("gzip: bad magic"))
    }
    if (buf[2] as int) != 8 {
        return Err(CompressError.unsupported("gzip: compression method != 8"))
    }
    ro flg = buf[3] as int
    ro cap = if max_output > 0 { max_output } else { 67108864 }   // 64 MiB field cap
    mut p = 10
    // FEXTRA
    if ((flg >> 2) & 1) == 1 {
        if buf.len() < p + 2 {
            return Ok(None)
        }
        ro xlen = (buf[p] as int) | ((buf[p + 1] as int) << 8)
        if xlen > cap {
            return Err(CompressError.invalid("gzip: FEXTRA field too large"))
        }
        p = p + 2 + xlen
        if buf.len() < p {
            return Ok(None)
        }
    }
    // FNAME
    if ((flg >> 3) & 1) == 1 {
        ro np = match scan_zstring(buf, p, cap)? {
            None => return Ok(None)
            Some(x) => x
        }
        p = np
    }
    // FCOMMENT
    if ((flg >> 4) & 1) == 1 {
        ro np = match scan_zstring(buf, p, cap)? {
            None => return Ok(None)
            Some(x) => x
        }
        p = np
    }
    // FHCRC
    if ((flg >> 1) & 1) == 1 {
        if buf.len() < p + 2 {
            return Ok(None)
        }
        p = p + 2
    }
    Ok(Some(p))
}

// Сканировать zero-terminated поле. Ok(Some(pos_after_zero)) / Ok(None) need-more /
// Err (поле > cap — anti-flood).
fn scan_zstring(buf []u8, start int, cap int) -> Result[Option[int], CompressError] {
    mut result Result[Option[int], CompressError] = Ok(None)
    mut i = start
    loop {
        if i >= buf.len() {
            break
        }
        ro b = buf[i]
        i = i + 1
        if b == 0 {
            result = Ok(Some(i))
            break
        }
        if i - start > cap {
            result = Err(CompressError.invalid("gzip: header string too large"))
            break
        }
    }
    result
}

fn gzip_flood(max_output int, consumed int, produced int) -> bool =>
    max_output > 0 && (consumed - produced) > (max_output * 2 + 4096)


// ──────────────────────────────────────────────────────────────────────────
// One-shot gzip decode (multi-member)
// ──────────────────────────────────────────────────────────────────────────

/// gzip (RFC 1952): magic 0x1f8b + DEFLATE + CRC-32 + ISIZE-trailer. `max_output` —
/// bomb-cap (общий across членов). CRC-32 И ISIZE(mod 2^32) верифицируются;
/// несовпадение → Checksum. MULTI-MEMBER: конкатенированные члены склеиваются;
/// мусор после последнего валидного члена игнорируется.
#stable(since = "0.1")
export fn gzip_decode(data []u8, max_output int) -> Result[[]u8, CompressError] {
    mut out = []u8.new()
    mut pos = 0
    mut members = 0
    loop {
        if data.len() - pos < 2 {
            if members == 0 {
                return Err(CompressError.bad_header("gzip: input too short"))
            }
            break
        }
        if !(data[pos] == 0x1f && data[pos + 1] == 0x8b) {
            if members == 0 {
                return Err(CompressError.bad_header("gzip: bad magic"))
            }
            break   // lenient trailing после валидного члена
        }
        if gzip_flood(max_output, pos, out.len()) {
            return Err(CompressError.bomb(max_output))
        }

        ro hlen = match parse_gzip_header(data[pos..data.len()], max_output)? {
            None => return Err(CompressError.eof())
            Some(h) => h
        }
        ro payload_start = pos + hlen
        if payload_start > data.len() {
            return Err(CompressError.eof())
        }

        mut inf = Inflater.new_at(max_output, out.len())
        inf.feed(data[payload_start..data.len()])?
        inf.mark_done()
        mut mout = []u8.new()
        loop {
            ro c = inf.read(1048576)?
            if c.len() > 0 { mout.append(c) } else { break }
        }
        if !inf.is_done() {
            return Err(CompressError.eof())
        }

        ro dend = payload_start + inf.input_end_byte()
        if data.len() - dend < 8 {
            return Err(CompressError.eof())
        }
        ro crc_stored = (data[dend] as u32)
            | ((data[dend + 1] as u32) << 8)
            | ((data[dend + 2] as u32) << 16)
            | ((data[dend + 3] as u32) << 24)
        ro isize_stored = (data[dend + 4] as u32)
            | ((data[dend + 5] as u32) << 8)
            | ((data[dend + 6] as u32) << 16)
            | ((data[dend + 7] as u32) << 24)
        ro crc_got = crc32(mout)
        if crc_got != crc_stored {
            return Err(CompressError.checksum_err(Crc32, crc_stored, crc_got))
        }
        ro isize_got = mout.len() as u32
        if isize_got != isize_stored {
            return Err(CompressError.checksum_err(Isize, isize_stored, isize_got))
        }
        out.append(mout)
        pos = dend + 8
        members = members + 1
    }
    Ok(out)
}


// ──────────────────────────────────────────────────────────────────────────
// Streaming gzip decode (framing + CRC-32/ISIZE поверх Inflater, single-member)
// ──────────────────────────────────────────────────────────────────────────

/// gzip-стрим-декодер: header-parse + CRC-32 + ISIZE поверх Inflater. НЕ consume
/// (Q6). Контракт feed/read/finish; `finish` верифицирует CRC-32 + ISIZE(mod 2^32).
/// V1 — single-member (multi-member streaming = followup; one-shot `gzip_decode`
/// склеивает члены).
#stable(since = "0.1")
export type GzipReader value {
    mut inner Inflater
    mut header_buf []u8
    mut header_done bool
    mut crc u32
    mut out_len int
    mut max_output int
    mut tail []u8           // остаток выхода, слитый в finish() (drain-order-independent)
    mut tpos int
}

#stable(since = "0.1")
export fn GzipReader.new(max_output int) -> GzipReader =>
    {
        inner: Inflater.new(max_output),
        header_buf: []u8.new(cap: 16),
        header_done: false,
        crc: crc32_init(),
        out_len: 0,
        max_output,
        tail: []u8.new(),
        tpos: 0,
    }

#stable(since = "0.1")
export fn GzipReader mut @feed(chunk []u8) -> Result[(), CompressError] {
    if @header_done {
        return @inner.feed(chunk)
    }
    @header_buf.append(chunk)
    match parse_gzip_header(@header_buf, @max_output)? {
        None => Ok(())
        Some(hlen) => {
            @header_done = true
            if @header_buf.len() > hlen {
                @inner.feed(@header_buf[hlen..@header_buf.len()])?
            }
            Ok(())
        }
    }
}

#stable(since = "0.1")
export fn GzipReader mut @read(max_emit int) -> Result[[]u8, CompressError] {
    ro me = if max_emit < 0 { 0 } else { max_emit }
    if @tpos < @tail.len() {
        ro avail = @tail.len() - @tpos
        ro n = avail.min(me)
        if n <= 0 { return Ok([]u8.new()) }
        mut chunk []u8 = []u8.new(cap: n).append(@tail[@tpos..(@tpos + n)])
        @tpos = @tpos + n
        return Ok(chunk)
    }
    ro c = @inner.read(me)?
    if c.len() > 0 {
        @crc = crc32_update(@crc, c)
        @out_len = @out_len + c.len()
    }
    Ok(c)
}

#stable(since = "0.1")
export fn GzipReader @is_done() -> bool => @inner.is_done() && @tpos >= @tail.len()

#stable(since = "0.1")
export fn GzipReader mut @finish() -> Result[(), CompressError] {
    if !@header_done {
        return Err(CompressError.eof())
    }
    @inner.mark_done()
    loop {
        ro c = @inner.read(1048576)?
        if c.len() > 0 {
            @crc = crc32_update(@crc, c)
            @out_len = @out_len + c.len()
            @tail.append(c)
        } else {
            break
        }
    }
    if !@inner.is_done() {
        return Err(CompressError.eof())
    }
    ro trailer = @inner.leftover_bytes()
    if trailer.len() < 8 {
        return Err(CompressError.eof())
    }
    ro crc_stored = (trailer[0] as u32)
        | ((trailer[1] as u32) << 8)
        | ((trailer[2] as u32) << 16)
        | ((trailer[3] as u32) << 24)
    ro isize_stored = (trailer[4] as u32)
        | ((trailer[5] as u32) << 8)
        | ((trailer[6] as u32) << 16)
        | ((trailer[7] as u32) << 24)
    ro crc_got = crc32_finalize(@crc)
    if crc_got != crc_stored {
        return Err(CompressError.checksum_err(Crc32, crc_stored, crc_got))
    }
    ro isize_got = @out_len as u32
    if isize_got != isize_stored {
        return Err(CompressError.checksum_err(Isize, isize_stored, isize_got))
    }
    Ok(())
}


// ──────────────────────────────────────────────────────────────────────────
// One-shot gzip encode (RFC 1952 framing + CRC-32 + ISIZE) — Ф.3
// ──────────────────────────────────────────────────────────────────────────

// Минимальный 10-байтный gzip-header: magic, CM=8, FLG=0, MTIME=0, XFL=0, OS=255.
fn gzip_header_bytes() -> []u8 {
    mut h []u8 = []u8.new()
    h.cap(10)
    h.push(0x1f)
    h.push(0x8b)
    h.push(0x08)        // CM = deflate
    h.push(0x00)        // FLG
    h.push(0x00)
    h.push(0x00)
    h.push(0x00)
    h.push(0x00)        // MTIME = 0
    h.push(0x00)        // XFL
    h.push(0xff)        // OS = unknown
    h
}

/// gzip-компрессия (RFC 1952): header + DEFLATE + CRC-32 + ISIZE (little-endian).
/// Выход читается `gzip_decode` (round-trip) и системным `gzip -d`.
#stable(since = "0.1")
export fn gzip_encode(data []u8, level CompressLevel) -> Result[[]u8, CompressError] {
    ro body = deflate(data, level)?
    mut out []u8 = []u8.new()
    out.cap(body.len() + 18)
    out.append(gzip_header_bytes())
    out.append(body)
    ro crc = crc32(data)
    out.push((crc & 0xFF) as u8)
    out.push(((crc >> 8) & 0xFF) as u8)
    out.push(((crc >> 16) & 0xFF) as u8)
    out.push(((crc >> 24) & 0xFF) as u8)
    ro isize = data.len() as u32       // ISIZE mod 2^32 (u32-усечение)
    out.push((isize & 0xFF) as u8)
    out.push(((isize >> 8) & 0xFF) as u8)
    out.push(((isize >> 16) & 0xFF) as u8)
    out.push(((isize >> 24) & 0xFF) as u8)
    Ok(out)
}


// ──────────────────────────────────────────────────────────────────────────
// Streaming gzip encode (framing + CRC-32/ISIZE поверх Deflater) — Ф.3
// ──────────────────────────────────────────────────────────────────────────

/// gzip-стрим-энкодер: header + CRC-32/ISIZE-trailer поверх Deflater. value
/// (НЕ consume). `feed`/`flush` (SYNC-FLUSH)/`finish` (дописывает CRC-32 + ISIZE).
#stable(since = "0.1")
export type GzipWriter value {
    mut inner Deflater
    mut crc u32
    mut isize int
    mut header_sent bool
    mut finished bool
}

#stable(since = "0.1")
export fn GzipWriter.new(level CompressLevel) -> GzipWriter =>
    {
        inner: Deflater.new(level),
        crc: crc32_init(),
        isize: 0,
        header_sent: false,
        finished: false,
    }

#stable(since = "0.1")
export fn GzipWriter mut @feed(chunk []u8) -> Result[[]u8, CompressError] {
    mut out []u8 = []u8.new()
    out.cap(chunk.len())
    if !@header_sent {
        out.append(gzip_header_bytes())
        @header_sent = true
    }
    @crc = crc32_update(@crc, chunk)
    @isize = @isize + chunk.len()
    out.append(@inner.feed(chunk)?)
    Ok(out)
}

#stable(since = "0.1")
export fn GzipWriter mut @flush() -> Result[[]u8, CompressError] {
    mut out []u8 = []u8.new()
    out.cap(16)
    if !@header_sent {
        out.append(gzip_header_bytes())
        @header_sent = true
    }
    out.append(@inner.flush()?)
    Ok(out)
}

#stable(since = "0.1")
export fn GzipWriter mut @finish() -> Result[[]u8, CompressError] {
    mut out []u8 = []u8.new()
    out.cap(16)
    if !@header_sent {
        out.append(gzip_header_bytes())
        @header_sent = true
    }
    out.append(@inner.finish()?)
    ro crc = crc32_finalize(@crc)
    out.push((crc & 0xFF) as u8)
    out.push(((crc >> 8) & 0xFF) as u8)
    out.push(((crc >> 16) & 0xFF) as u8)
    out.push(((crc >> 24) & 0xFF) as u8)
    ro isz = @isize as u32
    out.push((isz & 0xFF) as u8)
    out.push(((isz >> 8) & 0xFF) as u8)
    out.push(((isz >> 16) & 0xFF) as u8)
    out.push(((isz >> 24) & 0xFF) as u8)
    @finished = true
    Ok(out)
}


// ──────────────────────────────────────────────────────────────────────────
// Тесты — реальные gzip-векторы (эталон: python gzip / system gzip)
// ──────────────────────────────────────────────────────────────────────────

test "gzip_decode: 'Hello, DEFLATE!' + CRC-32 + ISIZE verify" {
    ro comp = hexbytes("1f8b08000000000000fff348cdc9c9d751707175f3710c71550400acccee010f000000")
    assert(gzip_decode(comp, 1024)!! == "Hello, DEFLATE!".bytes())
}

test "gzip_decode: empty input" {
    ro comp = hexbytes("1f8b08000000000000ff03000000000000000000")
    assert(gzip_decode(comp, 16)!! == [])
}

test "gzip_decode: 300× 'a'" {
    ro comp = hexbytes("1f8b08000000000000ff4b4c1c0589440200091997892c010000")
    mut expect []u8 = []u8.new()
    expect.cap(300)
    for _ in 0..300 { expect.push(97) }
    assert(gzip_decode(comp, 4096)!! == expect)
}

test "gzip_decode: multi-member concatenation → склейка" {
    ro comp = hexbytes("1f8b08000000000000fff348cdc9c9d7510000056f57de070000001f8b08000000000000ff0bcf2fca49510400de9d287606000000")
    assert(gzip_decode(comp, 1024)!! == "Hello, World!".bytes())
}

test "gzip_decode: bad magic → BadHeader" {
    ro comp = hexbytes("1f8c08000000000000fff348cdc9")
    ro r = gzip_decode(comp, 1024)
    assert(match r { Err(e) => match e.kind { BadHeader(_) => true, _ => false }, Ok(_) => false })
}

test "gzip_decode: CRC-32 mismatch → Checksum" {
    // Флипнутый первый байт CRC-32 трейлера (ac→ad)
    ro comp = hexbytes("1f8b08000000000000fff348cdc9c9d751707175f3710c71550400adccee010f000000")
    ro r = gzip_decode(comp, 1024)
    assert(match r {
        Err(e) => match e.kind { Checksum { kind, .. } => match kind { Crc32 => true, _ => false }, _ => false }
        Ok(_) => false
    })
}

test "gzip_decode: truncated → UnexpectedEof" {
    ro comp = hexbytes("1f8b08000000000000fff348cdc9")
    ro r = gzip_decode(comp, 1024)
    assert(match r { Err(e) => match e.kind { UnexpectedEof => true, _ => false }, Ok(_) => false })
}

test "gzip streaming: feed-по-1-байту == one-shot" {
    ro comp = hexbytes("1f8b08000000000000fff348cdc9c9d751707175f3710c71550400acccee010f000000")
    ro oneshot = gzip_decode(comp, 1024)!!
    mut gr = GzipReader.new(1024)
    mut out []u8 = []u8.new()
    out.cap(16)
    for idx in 0..comp.len() {
        mut one []u8 = []u8.new()
        one.cap(1)
        one.push(comp[idx])
        gr.feed(one)!!
        loop {
            ro c = gr.read(8)!!
            if c.len() > 0 { out.append(c) } else { break }
        }
    }
    gr.finish()!!
    loop {
        ro c = gr.read(8)!!
        if c.len() > 0 { out.append(c) } else { break }
    }
    assert(out == oneshot)
    assert(out == "Hello, DEFLATE!".bytes())
}

test "gzip_encode: round-trip via gzip_decode (all levels)" {
    ro data = "gzip framing round-trip payload — repeated. gzip framing round-trip payload.".bytes()
    assert(gzip_decode(gzip_encode(data, CompressLevel.none())!!, 65536)!! == data)
    assert(gzip_decode(gzip_encode(data, CompressLevel.fastest())!!, 65536)!! == data)
    assert(gzip_decode(gzip_encode(data, CompressLevel.best())!!, 65536)!! == data)
}

test "gzip_encode: header magic + CRC-32/ISIZE trailer verify" {
    ro data = "verify trailer".bytes()
    ro comp = gzip_encode(data, CompressLevel.fastest())!!
    assert(comp[0] == 0x1f && comp[1] == 0x8b && comp[2] == 0x08)   // magic + CM=8
    ro n = comp.len()
    ro isize = (comp[n - 4] as u32)
        | ((comp[n - 3] as u32) << 8)
        | ((comp[n - 2] as u32) << 16)
        | ((comp[n - 1] as u32) << 24)
    assert(isize == data.len() as u32)                              // ISIZE == input len
    // gzip_decode уже верифицирует CRC-32 внутри — успех => CRC совпал.
    assert(gzip_decode(comp, 65536)!! == data)
}

test "gzip streaming: GzipWriter feed+finish round-trip" {
    ro data = "streamed gzip content that repeats a lot. streamed gzip content repeats.".bytes()
    mut gw = GzipWriter.new(CompressLevel.default())
    mut comp []u8 = []u8.new()
    comp.cap(64)
    comp.append(gw.feed(data)!!)
    comp.append(gw.finish()!!)
    assert(gzip_decode(comp, 65536)!! == data)
}
