// SPDX-License-Identifier: MIT OR Apache-2.0
// std/encoding/compress/checksum.nv — CRC-32 (gzip) + Adler-32 (zlib).
//
// Plan 179 Ф.1 (D336). DRY-дедуп 2026-07-15 ([M-compress-checksum-cleanup],
// решение владельца): собственные реализации CRC-32/Adler-32 сняты — crc32
// троился (std/checksums, std/encoding/compress, опубликованный
// nova-compress); канон теперь один — `std.checksums.{crc32,adler32}`, этот
// модуль их только `export import`'ит. gzip.nv/zlib.nv (peer-файлы этого
// модуля) продолжают звать `crc32`/`adler32`-семейство без изменений — имена
// приходят через re-export ниже (share namespace модуля, D29 facade pattern).
//
// Спецификации:
//   - CRC-32 IEEE 802.3, poly 0xEDB88320 (reversed 0x04C11DB7) — RFC 1952 (gzip).
//   - Adler-32 mod 65521 — RFC 1950 (zlib) §9.

module encoding.compress

export import std.checksums.crc32.{crc32, crc32_init, crc32_update, crc32_finalize}
export import std.checksums.adler32.{adler32, adler32_init, adler32_update, adler32_finalize}


// ──────────────────────────────────────────────────────────────────────────
// Тесты — известные test vectors
// ──────────────────────────────────────────────────────────────────────────

test "crc32: пустой ввод → 0" {
    ro empty []u8 = []
    assert(crc32(empty) == 0)
}

test "crc32: '123456789' → 0xCBF43926 (классический вектор)" {
    assert(crc32("123456789".bytes()) == 0xCBF43926)
}

test "crc32: 'hello world' → 0x0D4A1185" {
    assert(crc32("hello world".bytes()) == 0x0D4A1185)
}

test "crc32: incremental == монолитный" {
    ro full = "The quick brown fox jumps over the lazy dog".bytes()
    mut state = crc32_init()
    state = crc32_update(state, "The quick brown ".bytes())
    state = crc32_update(state, "fox jumps over ".bytes())
    state = crc32_update(state, "the lazy dog".bytes())
    assert(crc32(full) == crc32_finalize(state))
}

test "adler32: пустой ввод → 1" {
    ro empty []u8 = []
    assert(adler32(empty) == 1)
}

test "adler32: 'Wikipedia' → 0x11E60398 (RFC 1950 пример)" {
    assert(adler32("Wikipedia".bytes()) == 0x11E60398)
}

test "adler32: '123456789' → 0x091E01DE" {
    assert(adler32("123456789".bytes()) == 0x091E01DE)
}

test "adler32: incremental == монолитный" {
    ro full = "The quick brown fox jumps over the lazy dog".bytes()
    mut state = adler32_init()
    state = adler32_update(state, "The quick brown ".bytes())
    state = adler32_update(state, "fox jumps over ".bytes())
    state = adler32_update(state, "the lazy dog".bytes())
    assert(adler32(full) == adler32_finalize(state))
}
