// EXPECT_COMPILE_ERROR E_SERDE_UNKNOWN_FIELD_POLICY_CONFLICT
// Plan 180.1 Ф.7: `#serde(allow_unknown)` (opt-out) and the legacy
// `#serde(deny_unknown_fields)` (explicit strict — now the DEFAULT) together
// on the same type is a self-contradiction, rejected at compile time.
module serde_neg.unknown_field_policy_conflict
import std.encoding.serde.{Serialize, Deserialize, Serializer, Deserializer, SerError, DeError}
#serde(allow_unknown, deny_unknown_fields)
#impl(Serialize + Deserialize)
type Bad value { ro a int }
