// EXPECT_COMPILE_ERROR E_SERDE_FLATTEN_UNSUPPORTED
// Plan 180.1 Ф.1.8: even opting into `#serde(allow_unknown)` (which removes
// the DENY_CONFLICT reason), `flatten` SYNTHESIS itself is still gated
// ([M-180-serde-flatten]) — the hardest field-attribute, honestly scoped
// out (needs a companion "fields-only" synth variant).
module serde_neg.flatten_allow_unknown_gated

import std.encoding.serde.{Serialize, Deserialize, Serializer, Deserializer, SerError, DeError}

#impl(Serialize + Deserialize)
type Inner value { ro x int }

#serde(allow_unknown)
#impl(Serialize + Deserialize)
type Outer value {
    ro y int
    #serde(flatten)
    ro inner Inner
}
