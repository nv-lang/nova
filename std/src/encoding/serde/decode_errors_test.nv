// Plan 180 — typed DeError on malformed / mismatched JSON (D325, §3.7).
// Runtime Err-kind checks are POSITIVE test blocks (test-conventions: no
// runtime-panic marker) — decode must return `Err(DeError)`, never throw/panic.
// Migrated from nova_tests/serde/errors.nv (Plan 182 Ф.2).
module encoding.serde

#impl(Serialize + Deserialize)
type DecErrRec value { ro id int, ro name str }

test "malformed JSON -> Err(Syntax) with line/col in message" {
    match json_decode[DecErrRec]("{ not json ") {
        Ok(_)  => assert(false)
        Err(e) => match e.kind {
            Syntax(_) => assert(true)
            _         => assert(false)
        }
    }
}

test "missing required field -> Err(MissingField)" {
    match json_decode[DecErrRec]("{\"id\": 1}") {
        Ok(_)  => assert(false)
        Err(e) => match e.kind {
            MissingField(f) => assert(f == "name")
            _               => assert(false)
        }
    }
}

test "type mismatch -> Err(UnexpectedType) not panic" {
    match json_decode[DecErrRec]("{\"id\": \"oops\", \"name\": \"x\"}") {
        Ok(_)  => assert(false)
        Err(e) => match e.kind {
            UnexpectedType { expected, found } => {
                assert(expected == "int")
                assert(found == "string")
            }
            _ => assert(false)
        }
    }
}

// #1638 "read exactly": 2^53+1 used to be refused (LossyInteger) because the
// number passed through f64; it is now read EXACTLY -- the property this test
// held ("never silently truncated") holds more strongly. A real loss is still
// refused: a fraction or a too-large float into an `int` field.
test "integer 2^53+1 is decoded exactly, not truncated (#1638)" {
    match json_decode[DecErrRec]("{\"id\": 9007199254740993, \"name\": \"x\"}") {
        Ok(r)  => assert(r.id == 9007199254740993)
        Err(_) => assert(false)
    }
}

test "a fraction into an int field -> Err(LossyInteger)" {
    match json_decode[DecErrRec]("{\"id\": 1.5, \"name\": \"x\"}") {
        Ok(_)  => assert(false)
        Err(e) => match e.kind {
            LossyInteger(_) => assert(true)
            _               => assert(false)
        }
    }
}

test "a float beyond 2^53 into an int field -> Err(LossyInteger)" {
    match json_decode[DecErrRec]("{\"id\": 1e20, \"name\": \"x\"}") {
        Ok(_)  => assert(false)
        Err(e) => match e.kind {
            LossyInteger(_) => assert(true)
            _               => assert(false)
        }
    }
}
