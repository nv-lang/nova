// std/encoding/csv_test.nv — публичный контракт Csv (RFC 4180 parse/encode).

module encoding.csv_test

import std.encoding.csv.{Csv, ParseCsvError}

test "parse: простой CSV" {
    ro r = "a,b,c\n1,2,3\n".to_csv()!!
    assert(r.len() == 2)
    assert(r[0] == ["a", "b", "c"])
    assert(r[1] == ["1", "2", "3"])
}

test "parse: quoted fields" {
    ro r = "\"hello, world\",foo\n".to_csv()!!
    assert(r[0][0] == "hello, world")
    assert(r[0][1] == "foo")
}

test "parse: escaped quote (\"\")" {
    ro r = "\"He said \"\"hi\"\"\"\n".to_csv()!!
    assert(r[0][0] == "He said \"hi\"")
}

test "parse: multiline в quoted field" {
    ro r = "\"line1\nline2\",x\n".to_csv()!!
    assert(r[0][0] == "line1\nline2")
}

test "parse: ошибка — незакрытая quote" {
    // Ошибка — ЗНАЧЕНИЕ (D325 R1): ни хендлера, ни `interrupt`,
    // ни промежуточного `Option` — прямой разбор ветвей.
    match "\"unterminated".to_csv() {
        Err(UnterminatedQuote { .. }) => ()
        _                             => assert(false)
    }
}

test "encode: простой round-trip" {
    ro data [][]str = [["a", "b"], ["1", "2"]]
    ro s = Csv.encode(data)
    ro parsed = s.to_csv()!!
    assert(parsed == data)
}

test "encode: quoting запятых и кавычек" {
    ro data [][]str = [["hello, world", "x"]]
    ro s = Csv.encode(data)
    assert(s.contains("\"hello, world\""))
}

test "encode: простое поле БЕЗ кавычек (пиннинг needs_quoting)" {
    // Пиннинг фикса D417-класса (2026-07-10): needs_quoting был always-true
    // (ведущий || = discarded closure) — каждый вывод квотился, round-trip
    // этого не ловил. Канон: поле без , " \n \r остаётся голым.
    ro data [][]str = [["plain", "x-1"]]
    ro s = Csv.encode(data)
    assert(s == "plain,x-1\n")
    assert(!s.contains("\""))
}
