// std/crypto/jwt_test.nv — HS256 encode/decode/validate round-trip тесты.
// Детерминизм через th.fixed_ms (Time effect handler substitution).

module crypto.jwt_test

import std.collections.hashmap.{HashMap}
import std.crypto.jwt.{Jwt, JwtError}
import std.encoding.json.{JsonValue}
import std.testing.handlers as th

test "encode/decode round-trip" {
    ro secret = "my-secret".bytes()
    mut claims_m = HashMap[str, JsonValue].new()
    claims_m.insert("sub", JsonValue.Str("user-42"))
    claims_m.insert("admin", JsonValue.Bool(true))
    ro claims = JsonValue.Object(claims_m)

    ro token = Jwt.encode_hs256(secret, claims)
    ro decoded = Jwt.decode_hs256(secret, token)!!

    match decoded.object() {
        Some(m) => {
            assert(m.get("sub") == Some(JsonValue.Str("user-42")))
            assert(m.get("admin") == Some(JsonValue.Bool(true)))
        }
        None => assert(false)
    }
}

test "decode: неправильный secret → InvalidSignature" {
    ro secret = "right".bytes()
    mut claims_m = HashMap[str, JsonValue].new()
    claims_m.insert("sub", JsonValue.Str("u1"))
    ro token = Jwt.encode_hs256(secret, JsonValue.Object(claims_m))

    assert(match Jwt.decode_hs256("wrong", token) {
        Err(InvalidSignature) => true
        _                     => false
    })
}

test "decode: неправильный формат → InvalidFormat" {
    assert(match Jwt.decode_hs256("secret", "not-a-jwt") {
        Err(InvalidFormat) => true
        _                  => false
    })
}

test "validate: expired token" {
    ro secret = "s".bytes()
    mut m = HashMap[str, JsonValue].new()
    m.insert("exp", JsonValue.Num(1000.0))         // expired at 1000s = 1_000_000ms
    ro token = Jwt.encode_hs256(secret, JsonValue.Object(m))

    with Time = th.fixed_ms(2_000_000) {
        assert(match Jwt.validate_hs256(secret, token) {
            Err(TokenExpired { .. }) => true
            _                        => false
        })
    }
}

test "validate: not yet valid (nbf в будущем)" {
    ro secret = "s".bytes()
    mut m = HashMap[str, JsonValue].new()
    m.insert("nbf", JsonValue.Num(5000.0))          // valid с 5000s
    ro token = Jwt.encode_hs256(secret, JsonValue.Object(m))

    with Time = th.fixed_ms(1_000_000) {
        assert(match Jwt.validate_hs256(secret, token) {
            Err(NotYetValid { .. }) => true
            _                       => false
        })
    }
}

test "validate: ok если exp в будущем и nbf в прошлом" {
    ro secret = "s".bytes()
    mut m = HashMap[str, JsonValue].new()
    m.insert("nbf", JsonValue.Num(1000.0))
    m.insert("exp", JsonValue.Num(9999.0))
    m.insert("sub", JsonValue.Str("user"))
    ro token = Jwt.encode_hs256(secret, JsonValue.Object(m))

    with Time = th.fixed_ms(5_000_000) {
        ro claims = Jwt.validate_hs256(secret, token)!!
        match claims.object() {
            Some(c) => assert(c.get("sub") == Some(JsonValue.Str("user")))
            None    => assert(false)
        }
    }
}
