// stdlib/hmac.nv — HMAC (Keyed-Hash Message Authentication Code).
//
// Independent implementation per RFC 2104:
// https://www.rfc-editor.org/rfc/rfc2104
//
// HMAC = H(key XOR opad || H(key XOR ipad || message))
//   - H — любая hash function (SHA-256, SHA-1, MD5)
//   - opad = 0x5C × block_size
//   - ipad = 0x36 × block_size
//   - key — нормализуется до block_size: hash если длиннее, pad если короче
//
// Use cases:
//   - API token validation (HMAC over request)
//   - JWT signing (HS256 = HMAC-SHA256)
//   - Cookie integrity
//   - Webhook signature verification
//
// API:
//   HmacSha256.compute(key []u8, message []u8) -> [32]u8
//   HmacSha256.compute_str(key []u8, message []u8) -> str    // hex
//   HmacSha256.verify(key []u8, message []u8, mac [32]u8) -> bool
//                                                       // constant-time

module crypto.hmac

import std.crypto.sha256.{Sha256}
import std.encoding.hex.{Hex}

// ──────────────────────────────────────────────────────────────────────────
// SHA-256 specific (block_size = 64, output_size = 32)
// ──────────────────────────────────────────────────────────────────────────

const SHA256_BLOCK_SIZE = 64
const SHA256_OUTPUT_SIZE = 32

/// HMAC-SHA-256 (RFC 2104) — keyed message authentication. 32-byte tag.
///
/// Used for JWT HS256, API signatures, session cookie integrity.
///
/// # Examples
/// ```nova
/// let mac = HmacSha256.compute("secret".bytes(), "data".bytes())
/// ```
#stable(since = "0.1")
export fn HmacSha256.compute(key []u8, message []u8) -> [32]u8 {
    // Step 1: нормализация ключа к block_size.
    ro key_block = normalize_key_sha256(key)

    // Step 2: ipad / opad
    mut inner_pad []u8 = []u8.new(cap: SHA256_BLOCK_SIZE)
    mut outer_pad []u8 = []u8.new(cap: SHA256_BLOCK_SIZE)
    for i in 0..SHA256_BLOCK_SIZE {
        inner_pad.push(((key_block[i] as int) ^ 0x36) as u8)
        outer_pad.push(((key_block[i] as int) ^ 0x5C) as u8)
    }

    // Step 3: inner hash = H(ipad || message)
    mut inner = Sha256.new()
    inner.update(inner_pad)
    inner.update(message)
    ro inner_digest = inner.finalize()

    // Step 4: outer hash = H(opad || inner_digest)
    mut outer = Sha256.new()
    outer.update(outer_pad)
    outer.update(inner_digest[0..SHA256_OUTPUT_SIZE])
    outer.finalize()
}

/// HMAC-SHA-256 in a lowercase hex string (64 chars).
#stable(since = "0.1")
export fn HmacSha256.compute_str(key []u8, message []u8) -> str {
    ro mac = HmacSha256.compute(key, message)
    Hex.encode(mac[0..SHA256_OUTPUT_SIZE])
}

/// **Constant-time** MAC verification (security-critical). Do NOT use `==`
/// for tag comparison — it leaks timing.
#stable(since = "0.1")
export fn HmacSha256.verify(key []u8, message []u8, expected [32]u8) -> bool {
    ro computed = HmacSha256.compute(key, message)
    constant_time_eq(computed, expected)
}

// Constant-time равенство массивов байт. XOR all pairs, аккумулируем
// в diff; результат 0 ⇔ равны. Без early-exit на различие.
fn constant_time_eq(a [32]u8, b [32]u8) -> bool {
    mut diff int = 0
    for i in 0..32 {
        diff = diff | ((a[i] as int) ^ (b[i] as int))
    }
    diff == 0
}

// ──────────────────────────────────────────────────────────────────────────
// Key normalization (RFC 2104 § 2)
// ──────────────────────────────────────────────────────────────────────────

// Если key длиннее block_size — берём H(key) (32 байта для SHA-256).
// Если короче — pad нулями справа до block_size.
// Если ровно — без изменений.
fn normalize_key_sha256(key []u8) -> []u8 {
    mut block []u8 = []u8.new(cap: SHA256_BLOCK_SIZE)

    if key.len() > SHA256_BLOCK_SIZE {
        ro hashed = Sha256.hash(key)
        block.append(hashed[0..SHA256_OUTPUT_SIZE])
    } else {
        block.append(key)
    }

    while block.len() < SHA256_BLOCK_SIZE { block.push(0x00) }
    block
}

