// stdlib/jwt.nv — JSON Web Token per RFC 7519.
//
// Independent implementation. https://www.rfc-editor.org/rfc/rfc7519
//
// JWT = base64url(header) + "." + base64url(payload) + "." + base64url(signature)
//
// Поддержка:
//   - HS256 алгоритм (HMAC-SHA-256) — самый частый
//   - encode / decode / verify
//   - exp/nbf/iat валидация по Time effect
//
// AI-first: validation использует Time effect — `with Time = th.fixed_ms(...)`
// делает тесты детерминированными.

module crypto.jwt

import std.crypto.hmac.{HmacSha256}
import std.encoding.base64.{Base64}
import std.encoding.json.{Json, JsonValue, JsonObject}

/// Errors in JWT operations.
#stable(since = "0.1")
export type JwtError enum
    | InvalidFormat
    | UnsupportedAlgorithm { alg str }
    | InvalidSignature
    | TokenExpired { exp_ms u64, now_ms u64 }
    | NotYetValid { nbf_ms u64, now_ms u64 }
    | DecodingFailed

/// Create JWT with the HS256 algorithm (HMAC-SHA-256). `claims` — usually `Object`
/// with iss/sub/exp/iat/... fields
///
/// Format: `<header_b64>.<payload_b64>.<signature_b64>` (RFC 7519).
#stable(since = "0.1")
export fn Jwt.encode_hs256(secret []u8, claims JsonValue) -> str {
    ro header = JsonValue.Object(make_header_hs256())
    ro header_b64 = Base64.encode_url(header.to_str())
    ro payload_b64 = Base64.encode_url(claims.to_str())

    ro signing_input = "${header_b64}.${payload_b64}"
    ro mac = HmacSha256.compute(secret, signing_input.bytes())
    ro sig_b64 = Base64.encode_url(mac[..32])

    "${signing_input}.${sig_b64}"
}

fn make_header_hs256() -> JsonObject {
    mut m = JsonObject.new()
    m.insert("alg", JsonValue.Str("HS256"))
    m.insert("typ", JsonValue.Str("JWT"))
    m
}

// ──────────────────────────────────────────────────────────────────────────
// Decode + Verify
// ──────────────────────────────────────────────────────────────────────────

/// Verify HS256 signature + return payload. **Does not check** exp/nbf — that
/// is done by `validate_hs256`. `Err(JwtError)` (Invalid format/sig/alg).
#stable(since = "0.1")
export fn Jwt.decode_hs256(secret []u8, token str) -> Result[JsonValue, JwtError] {
    ro parts = token.split(".").collect()
    if parts.len() != 3 { return Err(InvalidFormat) }

    ro header_b64 = parts[0]
    ro payload_b64 = parts[1]
    ro sig_b64 = parts[2]

    // Парсим header чтобы проверить alg
    ro header_bytes = Base64.decode_url(header_b64).map_err(|_| DecodingFailed)?
    ro header_json = header_bytes.to_str().map_err(|_| DecodingFailed)?
    ro header = Json.parse(header_json).map_err(|_| DecodingFailed)?
    ro alg = match header.object() {
        Some(m) => match m.get("alg") {
            Some(JsonValue.Str(a)) => a
            _                       => return Err(InvalidFormat)
        }
        None => return Err(InvalidFormat)
    }
    if alg != "HS256" {
        return Err(UnsupportedAlgorithm { alg })
    }

    // Verify signature
    ro signing_input = "${header_b64}.${payload_b64}"
    ro expected_mac = HmacSha256.compute(secret, signing_input.bytes())
    ro actual_sig = Base64.decode_url(sig_b64).map_err(|_| InvalidSignature)?
    if actual_sig.len() != 32 { return Err(InvalidSignature) }

    // Constant-time compare
    mut diff = 0
    for i in 0..32 {
        diff = diff | ((expected_mac[i] as int) ^ (actual_sig[i] as int))
    }
    if diff != 0 { return Err(InvalidSignature) }

    // Parse payload
    ro payload_bytes = Base64.decode_url(payload_b64).map_err(|_| DecodingFailed)?
    ro payload_json = payload_bytes.to_str().map_err(|_| DecodingFailed)?
    match Json.parse(payload_json) {
        Ok(v)  => Ok(v)
        Err(_) => Err(DecodingFailed)
    }
}

/// Full JWT validation: signature + `exp` (expiration) + `nbf` (not-before).
/// Uses the Time effect — deterministic in tests via `th.fixed_ms(...)`.
#stable(since = "0.1")
export fn Jwt.validate_hs256(secret []u8, token str) Time -> Result[JsonValue, JwtError] {
    ro claims = Jwt.decode_hs256(secret, token)?
    ro now_ms = Timestamp.now().unix_millis() as u64
    ro now_s = now_ms / 1000

    match claims.object() {
        Some(m) => {
            // exp — expiration (RFC 7519 § 4.1.4)
            match m.get("exp") {
                Some(JsonValue.Num(exp_s)) => {
                    if (now_s as f64) >= exp_s {
                        return Err(TokenExpired { exp_ms: (exp_s as u64) * 1000, now_ms })
                    }
                }
                _ => ()
            }
            // nbf — not before (RFC 7519 § 4.1.5)
            match m.get("nbf") {
                Some(JsonValue.Num(nbf_s)) => {
                    if (now_s as f64) < nbf_s {
                        return Err(NotYetValid { nbf_ms: (nbf_s as u64) * 1000, now_ms })
                    }
                }
                _ => ()
            }
        }
        None => return Err(InvalidFormat)
    }

    Ok(claims)
}

