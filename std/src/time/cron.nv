// stdlib/cron.nv — POSIX cron expression parser & matcher.
//
// Стандартный формат — 5 полей:
//   minute  hour  day-of-month  month  day-of-week
//   0..59   0..23  1..31         1..12  0..6 (0=Sunday)
//
// Каждое поле:
//   *           — any value
//   N           — exact
//   N-M         — range
//   N,M,...     — list
//   *​/N         — step (every N)
//
// Примеры:
//   "0 * * * *"       — каждый час в :00
//   "0 0 * * *"       — каждый день в 00:00
//   "*/15 * * * *"    — каждые 15 минут
//   "0 9-17 * * 1-5"  — каждый час с 9 до 17 в будни
//
// API:
//   s.to_cron() -> Result[CronExpr, ParseCronError]   (str-экстеншен, 174.1)
//   expr.matches(time CronTime) -> bool
//
// Не реализовано (out of scope):
//   - Имена месяцев / дней (jan/feb/mon/tue) — только числа
//   - 6-/7-полевые форматы (Quartz с seconds и year)
//   - @yearly / @daily aliases

module time.cron

/// Errors when parsing a cron expression.
#stable(since = "0.1")
export type ParseCronError enum
    | InvalidFieldCount { actual int }
    | InvalidValue { field str, value str }
    | OutOfRange { field str, value int, min int, max int }

// Парсенное поле. Set всех допустимых значений.
type CronField {
    values []int                    // отсортированный, без дубликатов
}

/// Parsed cron expression — 5 fields (minute/hour/day-of-month/month/day-of-week).
#stable(since = "0.1")
export type CronExpr {
    minute     CronField
    hour       CronField
    day_month  CronField
    month      CronField
    day_week   CronField
}

/// A time-point for cron matching. Usually decoded from a Timestamp.
#stable(since = "0.1")
export type CronTime {
    minute    int             // 0..59
    hour      int             // 0..23
    day_month int             // 1..31
    month     int             // 1..12
    day_week  int             // 0..6 (0 = Sunday)
}

// ──────────────────────────────────────────────────────────────────────────
// Парсинг
// ──────────────────────────────────────────────────────────────────────────

/// Parse a cron expression in 5-field format: `min hour dom month dow`.
///
/// Supported: `*`, `1,5,10` (list), `1-5` (range), `*/15` (step), `10-30/5` (range+step).
///
/// Plan 174.1 (2026-07-08, owner canon): the conversion — a method ON THE
/// SOURCE (`s.to_cron()`, mirroring `s.to_int()`/`s.to_url()`); the static
/// `Cron.parse(expr)` is RETRACTED (one name = one door, §22).
///
/// # Examples
/// ```nova
/// let cron = "*/15 9-17 * * 1-5".to_cron()!!  // every 15 min, 9-17h, weekdays
/// ```
#stable(since = "0.1")
export fn str @to_cron() -> Result[CronExpr, ParseCronError] {
    ro fields = @trim_ascii().split(" ")
    // Удалить пустые (multiple spaces)
    mut clean []str = []
    for f in fields {
        if f.len() > 0 { clean.push(f) }
    }
    if clean.len() != 5 {
        return Err(InvalidFieldCount { actual: clean.len() })
    }

    Ok({
        minute:    parse_field(clean[0], "minute",    0, 59)?,
        hour:      parse_field(clean[1], "hour",      0, 23)?,
        day_month: parse_field(clean[2], "day_month", 1, 31)?,
        month:     parse_field(clean[3], "month",     1, 12)?,
        day_week:  parse_field(clean[4], "day_week",  0, 6)?,
    })
}

fn parse_field(s str, name str, min int, max int) -> Result[CronField, ParseCronError] {
    // List: "1,5,10" → объединение
    if s.contains(",") {
        mut all []int = []
        for part in s.split(",") {
            ro sub = parse_field(part, name, min, max)?
            for v in sub.values { all.push(v) }
        }
        return Ok({ values: dedup_sort(all) })
    }

    // Step: "*/15", "10-30/5"
    if s.contains("/") {
        ro parts = s.split("/").collect()
        if parts.len() != 2 {
            return Err(InvalidValue { field: name, value: s })
        }
        ro step = parse_int_in(parts[1], name, min, max)?
        ro base = parts[0]
        ro (range_min, range_max) = if base == "*" {
            (min, max)
        } else if base.contains("-") {
            parse_range(base, name, min, max)?
        } else {
            ro v = parse_int_in(base, name, min, max)?
            (v, max)
        }
        mut values []int = []
        mut v = range_min
        while v <= range_max {
            values.push(v)
            v += step
        }
        return Ok({ values })
    }

    // Range: "1-5"
    if s.contains("-") {
        ro (lo, hi) = parse_range(s, name, min, max)?
        mut values = (lo..=hi).collect()
        return Ok({ values })
    }

    // Wildcard: "*"
    if s == "*" {
        mut values = (min..=max).collect()
        return Ok({ values })
    }

    // Single value
    ro v = parse_int_in(s, name, min, max)?
    Ok({ values: [v] })
}

fn parse_int_in(s str, name str, min int, max int) -> Result[int, ParseCronError] {
    ro n = s.to_int().map_err(|_| InvalidValue { field: name, value: s })?
    if n < min || n > max {
        return Err(OutOfRange { field: name, value: n, min, max })
    }
    Ok(n)
}

fn parse_range(s str, name str, min int, max int) -> Result[(int, int), ParseCronError] {
    ro parts = s.split("-").collect()
    if parts.len() != 2 {
        return Err(InvalidValue { field: name, value: s })
    }
    ro lo = parse_int_in(parts[0], name, min, max)?
    ro hi = parse_int_in(parts[1], name, min, max)?
    if lo > hi {
        return Err(InvalidValue { field: name, value: s })
    }
    Ok((lo, hi))
}

fn dedup_sort(xs []int) -> []int {
    // `.clone()`, не голый `xs` — тот же read-only-view contract, что и ниже
    // (см. коммент у `mut sorted`): нельзя вернуть caller's `xs` напрямую
    // под mut-default return-типом, даже в early-return ветке.
    if xs.len() == 0 { return xs.clone() }
    // Простая сортировка bubble + dedup для bootstrap
    // `.clone()`, НЕ mut-параметр — `dedup_sort` — read-only view
    // contract (сортирует и возвращает НОВЫЙ массив, не трогая caller's `xs`
    // in-out); делать `xs` in-out изменило бы публичный контракт функции без
    // нужды.
    mut sorted = xs.clone()
    ro n = sorted.len()
    for i in 0..n {
        for j in 0..n - 1 - i {
            if sorted[j] > sorted[j + 1] {
                ro tmp = sorted[j]
                sorted[j] = sorted[j + 1]
                sorted[j + 1] = tmp
            }
        }
    }
    mut out []int = []
    for v in sorted {
        if out.len() == 0 || out[out.len() - 1] != v {
            out.push(v)
        }
    }
    out
}

// ──────────────────────────────────────────────────────────────────────────
// Matching
// ──────────────────────────────────────────────────────────────────────────

/// True if the CronTime matches the expression (all 5 fields match).
#stable(since = "0.1")
export fn CronExpr @matches(t CronTime) -> bool =>
    field_contains(@minute, t.minute)
    && field_contains(@hour, t.hour)
    && field_contains(@day_month, t.day_month)
    && field_contains(@month, t.month)
    && field_contains(@day_week, t.day_week)

fn field_contains(f CronField, v int) -> bool {
    for x in f.values {
        if x == v { return true }
    }
    false
}

