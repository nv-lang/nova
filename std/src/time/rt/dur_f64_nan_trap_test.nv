// Plan 175 Ф.1c / D317 — f64→Duration с NaN траппит (не silent мусор-cast).
// Rust `Duration::mul_f64(NaN)` паникует — Nova-паритет.
// EXPECT_RUNTIME_PANIC non-finite or out-of-range f64

module rt.dur_f64_nan_traps

import std.time.duration

test "Duration @times(NaN) → trap" {
    // NaN построен во runtime (0.0/0.0) — избегаем const-fold.
    ro z = 0.0
    ro nan = z / z
    ro _ = 5.to_seconds() * nan            // ← trap: non-finite f64
}
