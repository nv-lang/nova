// Plan 182 Ф.1 (migrated from nova_tests/time/plan175_f1b_value_typed_surface.nv)
// — Plan 175 Ф.1b + Ф.3 (option C) — pos-фикстура: value-records + typed
// surface поверх int-wire эффекта.
//
// Покрывает §8 acceptance:
//   - Duration/Timestamp/Monotonic — `value`-records (round-trip через
//     to_*/голые геттеры, stack, zero-GC);
//   - арифметика value-records: @plus/@minus/@neg/@times/@div/@compare/==;
//   - typed-сахар `Timestamp.now()` над typed `Time.now()` (D316 Ф.3 retype);
//   - `@is_past`/`@time_until`/`@elapsed` РАБОТАЮТ (int-based) под mock-часами;
//   - `Monotonic.now()` (Plan 175 Ф.3a: `.nv`-сахар, мокабелен, больше не
//     compiler-builtin) non-regression.

module time.value_typed_surface_test

import std.time.duration
import std.testing.handlers as th

test "Ф.1b: value Duration round-trip (to_*/голые геттеры, arithmetic)" {
    ro d = 1500.to_millis()
    assert(d.millis() == 1500)
    assert(d.seconds() == 1)
    assert(d.nanos() == 1_500_000_000)
    // arithmetic on value-records
    assert((1.to_hours() + 30.to_minutes()) == 90.to_minutes())
    assert((1.to_hours() - 15.to_minutes()) == 45.to_minutes())
    assert((5.to_seconds() * 3) == 15.to_seconds())
    assert((1.to_minutes() / 4) == 15.to_seconds())
    assert((-(5.to_seconds())).is_negative())
    assert(1.to_seconds() < 1.to_minutes())
}

test "Ф.1b: value Timestamp round-trip + @plus/@minus" {
    ro t = 1_700_000_000.to_unix_seconds()
    assert(t.unix_seconds() == 1_700_000_000)
    ro later = t + 30.to_seconds()
    assert(later.unix_seconds() == 1_700_000_030)
    ro delta = later - t
    assert(delta == 30.to_seconds())
}

test "Ф.3: Timestamp.now() sugar + @is_past/@time_until/@elapsed (int-based mock)" {
    with Time = th.fixed_ms(10_000) {
        // sugar wraps typed Time.now() → value Timestamp
        assert(Timestamp.now().unix_millis() == 10_000)
        // 10s now; deadline at 6s is past; at 20s is future
        ro past = 6.to_unix_seconds()
        ro future = 20.to_unix_seconds()
        assert(past.is_past())
        assert(!future.is_past())
        assert(past.elapsed() == 4.to_seconds())        // 10s - 6s
        assert(future.time_until() == 10.to_seconds())  // 20s - 10s
    }
}

test "Ф.3: mut_clock advances timed surface coherently" {
    with Time = th.mut_clock(1_000) {
        ro t0 = Timestamp.now()
        assert(t0.unix_millis() == 1_000)
        2_000.to_millis().sleep()
        ro t1 = Timestamp.now()
        assert(t1.unix_millis() == 3_000)
        assert((t1 - t0) == 2.to_seconds())
    }
}

test "Ф.1b: Monotonic.now() (value builtin) non-regression + @plus/@minus(Duration)" {
    ro m0 = Monotonic.now()
    ro m1 = Monotonic.now()
    assert(m1.nanos() >= m0.nanos())
    ro deadline = m0 + 5.to_seconds()
    assert(deadline.nanos() == m0.nanos() + 5_000_000_000)
    ro earlier = deadline - 5.to_seconds()
    assert(earlier.nanos() == m0.nanos())
}
