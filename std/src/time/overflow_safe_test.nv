// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 182 Ф.1 (migrated from nova_tests/time/plan175_f1c_overflow_safe.nv)
// — Plan 175 Ф.1c (D317/D318) — overflow-safe арифметика, cross-module pos.
//
// Проверяет ПУБЛИЧНЫЙ surface (import std.time.duration) — checked_*/
// saturating_*, boundary-saturate на Timestamp/Monotonic, @abs(i64::MIN),
// Monotonic non-regression (saturate-to-zero + checked_duration_since).
// Trap-поведение операторов — std/time/rt/ (EXPECT_RUNTIME_PANIC).

module time.overflow_safe_test

import std.time.duration

const I64_MAX = 9_223_372_036_854_775_807
const I64_MIN = -9_223_372_036_854_775_807 - 1

test "Ф.1c: Duration checked_* — Some in-range, None on overflow" {
    assert((1.to_seconds()).checked_add(1.to_seconds()).is_some())
    assert(I64_MAX.to_nanos().checked_add(1.to_nanos()).is_none())
    assert(I64_MIN.to_nanos().checked_mul(-1).is_none())
    assert(10.to_nanos().checked_div(0).is_none())
    match (30.to_seconds()).checked_sub(10.to_seconds()) {
        Some(r) => assert(r == 20.to_seconds())
        None => assert(false)
    }
}

test "Ф.1c: Duration saturating_* clamps to ±MAX, no wrap" {
    ro top = I64_MAX.to_nanos()
    assert(top.saturating_add(1.to_seconds()).nanos() == I64_MAX)
    assert(top.saturating_mul(1000).nanos() == I64_MAX)
    assert(top.saturating_mul(-1000).nanos() == -I64_MAX)
    assert((5.to_seconds()).saturating_sub(2.to_seconds()) == 3.to_seconds())
}

test "Ф.1c: @abs(i64::MIN) → MAX (no UB)" {
    assert(I64_MIN.to_nanos().abs().nanos() == I64_MAX)
    assert((-3.to_seconds()).abs() == 3.to_seconds())
}

test "Ф.1c: Timestamp saturates at ~2262 horizon, checked → None" {
    ro tmax = I64_MAX.to_unix_nanos()
    assert(tmax.checked_add(1.to_seconds()).is_none())
    assert((tmax + 1.to_seconds()).unix_nanos() == I64_MAX)   // saturate, not wrap
    assert((1042.to_unix_seconds() - 1000.to_unix_seconds()) == 42.to_seconds())
}

test "Ф.1c/D318: Monotonic non-regression (saturate-to-zero + checked None)" {
    ro m = Monotonic.now()
    ro earlier = m - 5.to_seconds()
    assert(m.elapsed_since(earlier) == 5.to_seconds())
    assert(earlier.elapsed_since(m).nanos() == 0)       // regress → 0, never negative
    assert(earlier.checked_duration_since(m).is_none())    // regress → None
    assert(m.checked_duration_since(earlier).is_some())
}
