// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/tz_test.nv — Plan 175.1 Ф.4: IANA-зоны (curated embedded)
// + реальные DST gap/overlap + TZif-парсер (синтетические байты, мокабельно
// на любой ОС) + tzdb_version.

module time.civil

import std.time.duration

// ── tz_load: to_timezone (§1а) ──

test "tz_load: curated-имена Ok, unknown → Err(UnknownZone)" {
    assert("America/New_York".to_timezone().is_ok())
    assert("Europe/London".to_timezone().is_ok())
    assert("Europe/Moscow".to_timezone().is_ok())
    assert("Australia/Sydney".to_timezone().is_ok())
    assert(match "Europe/Atlantis".to_timezone() {
        Err(UnknownZone("Europe/Atlantis")) => true
        _ => false
    })
}

test "tz_load: UTC-алиасы и offset-формы" {
    assert(match "UTC".to_timezone() { Ok(Utc) => true, _ => false })
    assert(match "Z".to_timezone() { Ok(Utc) => true, _ => false })
    assert(match "+05:30".to_timezone() {
        Ok(Fixed(off)) => off.seconds() == 19_800
        _ => false
    })
    assert(match "-08:00".to_timezone() {
        Ok(Fixed(off)) => off.seconds() == -28_800
        _ => false
    })
    assert(match "+02:30:17".to_timezone() {
        Ok(Fixed(off)) => off.seconds() == 9_017
        _ => false
    })
    assert(!"+29:00".to_timezone().is_ok())    // за ±18h
    assert(!"05:30".to_timezone().is_ok())     // нет знака
}

test "tzdb_version доступна (D321 §tzdb)" {
    assert(tzdb_version().byte_len() > 0)
    assert(tzdb_version().contains("curated"))
}

// ── dst_gap_named: America/New_York spring-forward 2026-03-08 ──

test "dst_gap_named: NY 02:30 → push 03:30 EDT (Compatible)" {
    ro ny = "America/New_York".to_timezone()!!
    ro in_gap = Date.new(2026, Mar, 8)!!.at(TimeOfDay.new(2, 30)!!)
    assert(ny.resolve_local(in_gap).is_gap())
    ro z = in_gap.to_zoned(ny)!!
    assert(z.datetime().hour() == 3 && z.datetime().minute() == 30)
    assert(z.offset().seconds() == -14_400)
    // Reject → Ambiguous
    ro rej Disambiguation = Reject
    assert(match in_gap.to_zoned(ny, rej) {
        Err(Ambiguous(_)) => true
        _ => false
    })
}

test "dst_overlap_named: NY fall-back 2026-11-01 01:30 → earlier -04:00" {
    ro ny = "America/New_York".to_timezone()!!
    ro in_ovl = Date.new(2026, Nov, 1)!!.at(TimeOfDay.new(1, 30)!!)
    assert(ny.resolve_local(in_ovl).is_overlap())
    ro z = in_ovl.to_zoned(ny)!!                    // Compatible → earlier
    assert(z.offset().seconds() == -14_400)
    ro later Disambiguation = Later
    ro zl = in_ovl.to_zoned(ny, later)!!
    assert(zl.offset().seconds() == -18_000)
    assert(zl.to_timestamp()!! - z.to_timestamp()!! == 1.to_hours())
}

test "London BST: последнее воскресенье марта 2026 (29-е) 01:00Z gap" {
    ro lon = "Europe/London".to_timezone()!!
    // 2026-03-29 — последнее воскресенье марта
    ro in_gap = Date.new(2026, Mar, 29)!!.at(TimeOfDay.new(1, 30)!!)
    assert(lon.resolve_local(in_gap).is_gap())
    ro z = in_gap.to_zoned(lon)!!
    assert(z.datetime().hour() == 2 && z.datetime().minute() == 30)
    assert(z.offset().seconds() == 3_600)
    // Лето — BST, зима — GMT
    ro summer = Date.new(2026, Jul, 1)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(lon)!!
    assert(summer.offset().seconds() == 3_600)
    ro winter = Date.new(2026, Jan, 1)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(lon)!!
    assert(winter.offset().seconds() == 0)
}

test "Moscow: фикс +03:00 без DST (2015+)" {
    ro msk = "Europe/Moscow".to_timezone()!!
    // NB: имя локала `s` ломает эмиссию receiver'а (теряется `&`) — не использовать
    ro zsum = Date.new(2026, Jul, 10)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(msk)!!
    ro zwin = Date.new(2026, Jan, 10)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(msk)!!
    assert(zsum.offset().seconds() == 10_800)
    assert(zwin.offset().seconds() == 10_800)
    assert(!msk.resolve_local(Date.new(2026, Mar, 29)!!.at(TimeOfDay.new(2, 30)!!)).is_gap())
}

test "Sydney (южное полушарие): DST октябрь→апрель" {
    ro syd = "Australia/Sydney".to_timezone()!!
    // Январь — лето (AEDT +11), июль — зима (AEST +10)
    ro jan = Date.new(2026, Jan, 15)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(syd)!!
    assert(jan.offset().seconds() == 39_600)
    ro jul = Date.new(2026, Jul, 15)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(syd)!!
    assert(jul.offset().seconds() == 36_000)
    // Gap: 1-е воскресенье октября 2026 (4-е), 02:30 local
    ro gap = Date.new(2026, Oct, 4)!!.at(TimeOfDay.new(2, 30)!!)
    assert(syd.resolve_local(gap).is_gap())
    // Overlap: 1-е воскресенье апреля 2026 (5-е), 02:30 local — дважды
    ro ovl = Date.new(2026, Apr, 5)!!.at(TimeOfDay.new(2, 30)!!)
    assert(syd.resolve_local(ovl).is_overlap())
}

// ── dst_roundtrip: RFC-9557 [zone] идентичность через переход ──

test "dst_roundtrip: instant-переход через wall-арифметику named-зоны" {
    ro ny = "America/New_York".to_timezone()!!
    ro before = Date.new(2026, Mar, 7)!!.at(TimeOfDay.new(12, 0)!!).to_zoned(ny)!!
    ro after = before + Period.of_days(1)
    // wall 12:00 сохранена, elapsed 23h (короткий день)
    assert(after.datetime().hour() == 12)
    assert(after.to_timestamp()!! - before.to_timestamp()!! == 23.to_hours())
    // to_iso несёт [America/New_York]
    assert(before.to_iso() == "2026-03-07T12:00:00-05:00[America/New_York]")
    assert(after.to_iso() == "2026-03-08T12:00:00-04:00[America/New_York]")
    // офсеты по инстанту согласованы с offset_at
    assert(ny.offset_at(after.to_timestamp()!!).seconds() == -14_400)
}

// ── TZif-парсер: синтетические байты (мокабельно, без ОС) ──

// Собрать минимальный TZif v2: 1 переход, 2 типа (std -18000 → dst -14400).
fn build_tzif_v2() -> []u8 {
    mut b []u8 = []
    // -- v1 header: magic + version '2' + 15 reserved
    push_str(b, "TZif")
    b.push(50)                       // '2'
    mut i = 0
    while i < 15 { b.push(0); i += 1 }
    // counts: isutcnt=0 isstdcnt=0 leapcnt=0 timecnt=0 typecnt=1 charcnt=1
    push_u32(b, 0); push_u32(b, 0); push_u32(b, 0)
    push_u32(b, 0); push_u32(b, 1); push_u32(b, 1)
    // v1 data: 0 times, 1 ttinfo (utoff=-18000, isdst=0, idx=0), 1 char
    push_i32(b, -18_000); b.push(0); b.push(0)
    b.push(0)                        // charcnt=1: "\0"
    // -- v2 header
    push_str(b, "TZif")
    b.push(50)
    i = 0
    while i < 15 { b.push(0); i += 1 }
    // counts: timecnt=1 typecnt=2 charcnt=1
    push_u32(b, 0); push_u32(b, 0); push_u32(b, 0)
    push_u32(b, 1); push_u32(b, 2); push_u32(b, 1)
    // v2 data: 1 время i64 = 1_000_000, 1 индекс типа = 1
    push_i64(b, 1_000_000)
    b.push(1)
    // 2 ttinfo: std(-18000, isdst=0), dst(-14400, isdst=1)
    push_i32(b, -18_000); b.push(0); b.push(0)
    push_i32(b, -14_400); b.push(1); b.push(0)
    b.push(0)                        // charcnt
    b
}

fn push_str(mut b []u8, s str) {
    for byte in s.bytes() { b.push(byte) }
}

fn push_u32(mut b []u8, v i64) {
    ro u = if v < 0 { v + 4_294_967_296 } else { v }
    b.push(((u / 16_777_216) % 256) as u8)
    b.push(((u / 65_536) % 256) as u8)
    b.push(((u / 256) % 256) as u8)
    b.push((u % 256) as u8)
}

fn push_i32(mut b []u8, v i64) { push_u32(b, v) }

fn push_i64(mut b []u8, v i64) {
    // Только неотрицательные в тестовом билдере.
    push_u32(b, v / 4_294_967_296)
    push_u32(b, v % 4_294_967_296)
}

test "TZif v2: parse синтетических байт → корректные rules" {
    ro tz = TimeZone.from_tzif("Test/Zone", build_tzif_v2())!!
    // До перехода (instant < 1_000_000) — std -18000
    assert(tz.offset_at(999_999.to_unix_seconds()).seconds() == -18_000)
    // После — dst -14400
    assert(tz.offset_at(1_000_000.to_unix_seconds()).seconds() == -14_400)
    assert(tz.to_str() == "Test/Zone")
}

test "TZif: мусорные байты → BadTzData" {
    mut junk []u8 = []
    push_str(junk, "NOPE")
    assert(match TimeZone.from_tzif("X", junk) {
        Err(BadTzData(_)) => true
        _ => false
    })
    mut short []u8 = []
    push_str(short, "TZif")
    assert(match TimeZone.from_tzif("X", short) {
        Err(BadTzData(_)) => true
        _ => false
    })
}
