// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/year_month.nv — YearMonth (billing-периоды) + MonthDay
// (годовщины; Feb-29 валиден как анниверсари). Plan 175.1 Ф.1 (D319).

module time.civil

// ──────────────────────────────────────────────────────────────────────────
// YearMonth — месяц конкретного года (биллинг, отчётные периоды)
// ──────────────────────────────────────────────────────────────────────────

/// Год+месяц без дня (биллинг-периоды).
#stable(since = "0.1")
export type YearMonth value {
    ro year i32
    ro month i32
}

/// Построить с валидацией (год в civil-диапазоне, месяц 1..12).
#stable(since = "0.1")
export fn YearMonth.new(y i32, m Month) -> Result[YearMonth, DateError] {
    if (y as i64) < -999_999 || (y as i64) > 999_999 {
        return Err(InvalidField(FieldKind.Year, y as i64, -999_999, 999_999))
    }
    Ok({ year: y, month: m.number() as i32 })
}

/// Год.
#stable(since = "0.1")
export fn YearMonth @year() -> i32 => @year

/// Месяц.
#stable(since = "0.1")
export fn YearMonth @month() -> Month =>
    Month.from_number(@month as int) ?? Month.Jan   // unreachable: конструктор валидирует

/// Число дней в этом месяце (с учётом високосности года).
#stable(since = "0.1")
export fn YearMonth @length() -> int {
    ro leap = @year % 4 == 0 && (@year % 100 != 0 || @year % 400 == 0)
    @month().length(leap)
}

/// Первый день месяца как Date.
#stable(since = "0.1")
export fn YearMonth @first_day() -> Date =>
    Date.new(@year, @month(), 1) ?? Date.from_epoch_day(0)   // unreachable: поля валидны

/// Последний день месяца как Date.
#stable(since = "0.1")
export fn YearMonth @last_day() -> Date =>
    Date.new(@year, @month(), @length() as i32) ?? Date.from_epoch_day(0)   // unreachable

/// Конкретный день этого месяца → `Result` (валидация дня).
#stable(since = "0.1")
export fn YearMonth @at_day(d i32) -> Result[Date, DateError] =>
    Date.new(@year, @month(), d)

/// Следующий месяц (Dec → Jan следующего года).
#stable(since = "0.1")
export fn YearMonth @next() -> YearMonth =>
    if @month == 12 { { year: @year + 1, month: 1 } }
    else { { @year, month: @month + 1 } }

/// Предыдущий месяц (Jan → Dec предыдущего года).
#stable(since = "0.1")
export fn YearMonth @prev() -> YearMonth =>
    if @month == 1 { { year: @year - 1, month: 12 } }
    else { { @year, month: @month - 1 } }

/// Compare: год, затем месяц.
#stable(since = "0.1")
export fn YearMonth @compare(other YearMonth) -> int {
    if @year < other.year { return -1 }
    if @year > other.year { return 1 }
    if @month < other.month { -1 } else if @month > other.month { 1 } else { 0 }
}

/// ISO-форма `YYYY-MM` (format_year/pad2 — module-private хелперы date.nv).
#stable(since = "0.1")
export fn YearMonth @to_iso() -> str =>
    "${format_year(@year as i64)}-${pad2(@month as i64)}"

/// Display = ISO-форма.
#stable(since = "0.1")
export fn YearMonth @to_str() -> str => @to_iso()

// ──────────────────────────────────────────────────────────────────────────
// MonthDay — месяц+день без года (годовщины, дни рождения)
// ──────────────────────────────────────────────────────────────────────────

/// Месяц+день без года. `Feb-29` ВАЛИДЕН (анниверсари существует,
/// хотя дата есть не в каждом году) — java.time-семантика.
#stable(since = "0.1")
export type MonthDay value {
    ro month i32
    ro day i32
}

/// Построить с валидацией: день против МАКСИМАЛЬНОЙ длины месяца
/// (Feb → 29: анниверсари-семантика, existence в конкретном году
/// проверяет `@at_year`).
#stable(since = "0.1")
export fn MonthDay.new(m Month, d i32) -> Result[MonthDay, DateError] {
    ro max_len = m.length(true)   // leap=true → Feb=29
    if d < 1 || (d as int) > max_len {
        return Err(InvalidField(FieldKind.Day, d as i64, 1, max_len as i64))
    }
    Ok({ month: m.number() as i32, day: d })
}

/// Месяц.
#stable(since = "0.1")
export fn MonthDay @month() -> Month =>
    Month.from_number(@month as int) ?? Month.Jan   // unreachable

/// День.
#stable(since = "0.1")
export fn MonthDay @day() -> i32 => @day

/// Валиден ли в данном году (`Feb-29` → только високосные).
#stable(since = "0.1")
export fn MonthDay @is_valid_year(y i32) -> bool {
    ro leap = y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)
    (@day as int) <= @month().length(leap)
}

/// Конкретная дата в году → `Result` (`Feb-29` в невисокосном — `Err`).
#stable(since = "0.1")
export fn MonthDay @at_year(y i32) -> Result[Date, DateError] =>
    Date.new(y, @month(), @day)

/// Compare: месяц, затем день.
#stable(since = "0.1")
export fn MonthDay @compare(other MonthDay) -> int {
    if @month < other.month { return -1 }
    if @month > other.month { return 1 }
    if @day < other.day { -1 } else if @day > other.day { 1 } else { 0 }
}

/// ISO-форма `--MM-DD` (ISO-8601 monthday).
#stable(since = "0.1")
export fn MonthDay @to_iso() -> str =>
    "--${pad2(@month as i64)}-${pad2(@day as i64)}"

/// Display = ISO-форма.
#stable(since = "0.1")
export fn MonthDay @to_str() -> str => @to_iso()
