// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/time_of_day.nv — TimeOfDay: время суток (D319).
//
// Plan 175.1 Ф.1. Репрезентация: nanos_of_day i64 ∈ [0, 86_399_999_999_999].
// День = ровно 86400s (leap-seconds ignore, Q5). Принимает `Duration`
// (TimeBased), отвергает `Period` — отсутствие перегрузки = compile-error
// (D320 R2). Day-carry ЯВНЫЙ: `@plus(Duration)` возвращает
// `(TimeOfDay, days_overflow i64)`, не молчит про перенос.

module time.civil

import std.time.duration

/// Время суток (wall-clock, без даты/зоны) — value-record, наносекунды
/// от полуночи. Plain-тип D319: НЕ точка на оси.
#stable(since = "0.1")
export type TimeOfDay value {
    ro nanos_of_day i64
}

// Наносекунд в сутках = 86_400 * 1e9.
fn nanos_per_day() -> i64 => 86_400_000_000_000

// ──────────────────────────────────────────────────────────────────────────
// Конструкторы
// ──────────────────────────────────────────────────────────────────────────

/// Полночь (00:00:00.0). Const-форма `TimeOfDay.MIDNIGHT` —
/// [M-175-value-record-const-ref] (обход §4а: static-фн).
#stable(since = "0.1")
export fn TimeOfDay.midnight() -> TimeOfDay => { nanos_of_day: 0 }

/// Построить время суток с валидацией → `Result` (Q6).
///
/// `h` 0..23, `m` 0..59, `s` 0..59 (leap-second `:60` — только clamp на
/// parse, Q5), `ns` 0..999_999_999. Дефолты позволяют `TimeOfDay.new(14, 30)`.
///
/// # Examples
/// ```nova
/// ro t = TimeOfDay.new(14, 30)!!
/// assert(t.hour() == 14)
/// ```
#stable(since = "0.1")
export fn TimeOfDay.new(h int, m int, s int = 0, ns int = 0) -> Result[TimeOfDay, DateError] {
    if h < 0 || h > 23 { return Err(InvalidField(FieldKind.Hour, h as i64, 0, 23)) }
    if m < 0 || m > 59 { return Err(InvalidField(FieldKind.Minute, m as i64, 0, 59)) }
    if s < 0 || s > 59 { return Err(InvalidField(FieldKind.Second, s as i64, 0, 59)) }
    if ns < 0 || ns > 999_999_999 {
        return Err(InvalidField(FieldKind.Nano, ns as i64, 0, 999_999_999))
    }
    ro total = (h as i64) * 3_600_000_000_000 +
        (m as i64) * 60_000_000_000 +
        (s as i64) * 1_000_000_000 +
        (ns as i64)
    Ok({ nanos_of_day: total })
}

/// Из сырых наносекунд от полуночи → `Result` (вне [0, 86400s) — `Err`).
#stable(since = "0.1")
export fn TimeOfDay.from_nanos_of_day(n i64) -> Result[TimeOfDay, DateError] =>
    if n < 0 || n >= nanos_per_day() {
        Err(InvalidField(FieldKind.Nano, n, 0, nanos_per_day() - 1))
    } else {
        Ok({ nanos_of_day: n })
    }

// ──────────────────────────────────────────────────────────────────────────
// Компоненты
// ──────────────────────────────────────────────────────────────────────────

/// Час (0..23).
#stable(since = "0.1")
export fn TimeOfDay @hour() -> int => (@nanos_of_day / 3_600_000_000_000) as int

/// Минута (0..59).
#stable(since = "0.1")
export fn TimeOfDay @minute() -> int =>
    ((@nanos_of_day / 60_000_000_000) % 60) as int

/// Секунда (0..59).
#stable(since = "0.1")
export fn TimeOfDay @second() -> int =>
    ((@nanos_of_day / 1_000_000_000) % 60) as int

/// Наносекунда внутри секунды (0..999_999_999).
#stable(since = "0.1")
export fn TimeOfDay @nano() -> int => (@nanos_of_day % 1_000_000_000) as int

/// Сырые наносекунды от полуночи.
#stable(since = "0.1")
export fn TimeOfDay @to_nanos_of_day() -> i64 => @nanos_of_day

// ──────────────────────────────────────────────────────────────────────────
// Арифметика (TimeBased ONLY — D320: Period здесь НЕ принимается)
// ──────────────────────────────────────────────────────────────────────────

/// Сдвиг на Duration с ЯВНЫМ day-carry: `(новое время, перенос дней)`.
///
/// Перенос никогда не теряется молча: `23:30 + 1h` → `(00:30, 1)`;
/// `00:30 - 1h` (отрицательная Duration) → `(23:30, -1)`.
///
/// # Examples
/// ```nova
/// ro (t, carry) = TimeOfDay.new(23, 30)!!.plus(1.to_hours())
/// assert(t.hour() == 0 && carry == 1)
/// ```
#stable(since = "0.1")
export fn TimeOfDay @plus(d Duration) -> (TimeOfDay, i64) {
    ro total = @nanos_of_day + d.nanos()
    ro nd = nanos_per_day()
    ro q = total / nd
    ro r = total % nd
    ro days = if r < 0 { q - 1 } else { q }
    ro nanos = if r < 0 { r + nd } else { r }
    ro t TimeOfDay = { nanos_of_day: nanos }
    (t, days)
}

/// Сдвиг назад — эквивалент `@plus(-d)`; тот же явный day-carry.
#stable(since = "0.1")
export fn TimeOfDay @minus(d Duration) -> (TimeOfDay, i64) =>
    @plus(0.to_nanos() - d)

/// Duration от `self` до `other` внутри суток (signed).
#stable(since = "0.1")
export fn TimeOfDay @duration_until(other TimeOfDay) -> Duration =>
    (other.nanos_of_day - @nanos_of_day).to_nanos()

// ──────────────────────────────────────────────────────────────────────────
// Compare + Display
// ──────────────────────────────────────────────────────────────────────────

/// Compare по наносекундам от полуночи.
#stable(since = "0.1")
export fn TimeOfDay @compare(other TimeOfDay) -> int =>
    if @nanos_of_day < other.nanos_of_day { -1 }
    else if @nanos_of_day > other.nanos_of_day { 1 }
    else { 0 }

fn pad2_i64(n i64) -> str =>
    if n < 10 { "0${n}" } else { n.to_str() }

// Дробная часть секунды: ".SSS"/".SSSSSS"/".SSSSSSSSS" (короткая форма,
// trailing-zero группами по 3, как java.time) или "" при ns==0.
fn format_frac(ns i64) -> str {
    if ns == 0 { return "" }
    if ns % 1_000_000 == 0 {
        ro ms = ns / 1_000_000
        ro s = ms.to_str()
        return ".${s.pad_start(3, '0')}"
    }
    if ns % 1_000 == 0 {
        ro us = ns / 1_000
        ro s = us.to_str()
        return ".${s.pad_start(6, '0')}"
    }
    ro s = ns.to_str()
    ".${s.pad_start(9, '0')}"
}

/// ISO-8601 форма `HH:MM:SS[.fff]` (наносекунды — 3/6/9 знаков по кратности).
#stable(since = "0.1")
export fn TimeOfDay @to_iso() -> str =>
    "${pad2_i64(@hour() as i64)}:${pad2_i64(@minute() as i64)}:${pad2_i64(@second() as i64)}${format_frac(@nano() as i64)}"

/// Display = ISO-форма.
#stable(since = "0.1")
export fn TimeOfDay @to_str() -> str => @to_iso()

// ──────────────────────────────────────────────────────────────────────────
// DateTime — ДЕКЛАРАЦИЯ здесь (методы в datetime.nv): value-record с
// by-value полями Date+TimeOfDay требует, чтобы оба типа были уже
// эмитнуты (complete) — порядок эмиссии лексикографический по файлам.
// [M-175.1-value-in-value-emit-order] (§4а-обход, codegen не трогаем).
// ──────────────────────────────────────────────────────────────────────────

/// Календарные дата+время без зоны — value-record из двух value-полей.
/// Plain-тип D319: НЕ точка на оси. Методы — datetime.nv.
#stable(since = "0.1")
export type DateTime value {
    ro date Date
    ro time TimeOfDay
}
