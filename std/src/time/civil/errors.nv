// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/errors.nv — структурные ошибки + базовые sum-типы календаря.
//
// Co-equal файл модуля `time.civil`: все типы видны остальным файлам модуля
// без импорта (как runtime.string).
//
// Структурные ошибки: конструкторы/parse возвращают `Result`, НЕТ
// default-panicking конструктора (урок chrono `from_ymd` deprecated).

module time.civil

// ──────────────────────────────────────────────────────────────────────────
// FieldKind — какое поле нарушено (для InvalidField / InvalidValue)
// ──────────────────────────────────────────────────────────────────────────

/// Идентификатор компонента даты/времени в структурной ошибке.
#stable(since = "0.1")
export type FieldKind enum
    | Year
    | Month
    | Day
    | Hour
    | Minute
    | Second
    | Nano
    | OffsetSec
    | Weekday

/// Человекочитаемое имя поля (для сообщений).
#stable(since = "0.1")
export fn FieldKind @name() -> str =>
    match @ {
        Year      => "year",
        Month     => "month",
        Day       => "day",
        Hour      => "hour",
        Minute    => "minute",
        Second    => "second",
        Nano      => "nanosecond",
        OffsetSec => "offset-seconds",
        Weekday   => "weekday",
    }

// ──────────────────────────────────────────────────────────────────────────
// DateError — ошибки построения/арифметики
// ──────────────────────────────────────────────────────────────────────────

/// Структурная ошибка построения/арифметики календарных величин.
///
/// - `InvalidField(field, given, min, max)` — Feb 30, month 13, hour 25.
/// - `RangeOverflow(kind)` — civil↔Timestamp вне ±292y окна.
/// - `Ambiguous(kind)` — `Reject` на DST gap/overlap.
/// - `UnknownZone(name)` — имя зоны не найдено (tz-загрузка).
/// - `BadTzData(what)` — повреждённые/неподдерживаемые TZif-байты.
///
/// Shape — time-crate `ComponentRange` + java.time `getErrorIndex`.
#stable(since = "0.1")
export type DateError enum
    | InvalidField(FieldKind, i64, i64, i64)
    | RangeOverflow(str)
    | Ambiguous(str)
    | UnknownZone(str)
    | BadTzData(str)

/// Диагностическое сообщение.
#stable(since = "0.1")
export fn DateError @to_str() -> str =>
    match @ {
        InvalidField(f, given, mn, mx) => {
            "invalid ${f.name()}: ${given} (expected ${mn}..${mx})"
        }
        RangeOverflow(kind) => "range overflow: ${kind}",
        Ambiguous(kind)     => "ambiguous local time: ${kind}",
        UnknownZone(name)   => "unknown time zone: ${name}",
        BadTzData(what)     => "bad tz data: ${what}",
    }

// ──────────────────────────────────────────────────────────────────────────
// ParseDateTimeError — ошибки разбора текста
// ──────────────────────────────────────────────────────────────────────────

/// Ошибка разбора ISO-8601/RFC-3339/pattern-строки.
///
/// - `FormatMismatch(position, expected)` — структура не совпала.
/// - `InvalidValue(position, field, given)` — значение вне диапазона.
#stable(since = "0.1")
export type ParseDateTimeError enum
    | FormatMismatch(int, str)
    | InvalidValue(int, FieldKind, i64)

/// Диагностическое сообщение.
#stable(since = "0.1")
export fn ParseDateTimeError @to_str() -> str =>
    match @ {
        FormatMismatch(pos, expected) => {
            "format mismatch at ${pos}: expected ${expected}"
        }
        InvalidValue(pos, field, given) => {
            "invalid ${field.name()} at ${pos}: ${given}"
        }
    }

// ──────────────────────────────────────────────────────────────────────────
// Disambiguation / OffsetConflict — DST-политики
// ──────────────────────────────────────────────────────────────────────────

// NB: пространство имён вариантов ФЛОСКОЕ
// (голый вариант резолвится независимо от целевого типа), а qualified
// `Enum.Variant` как ЗНАЧЕНИЕ — ICE (Path call
// `[M-175.1-qualified-variant-value]`) → у DST-политик имена вариантов
// уникальны: конфликт-вариант назван `RejectMismatch` (не `Reject`, как в
// jiff/Temporal) — конвенция зафиксирована.

/// 4-way разрешение рассогласования сохранённого offset с текущими правилами
/// зоны (post-tzdb-change drift). Только для explicit-offset строк.
///
/// - `RejectMismatch` (default) — `Err` при расхождении.
/// - `Use` — доверять сохранённому offset как есть.
/// - `Prefer` — предпочесть сохранённый, если он валиден для зоны.
/// - `Ignore` — игнорировать сохранённый, пересчитать по зоне.
#stable(since = "0.1")
export type OffsetConflict enum
    | RejectMismatch
    | Use
    | Prefer
    | Ignore

/// 4-way разрешение неоднозначного локального времени при переходе DST.
///
/// - `Compatible` (default) — gap → push-forward на длину gap (after-offset);
///   overlap → earlier-offset. Совместимо с Temporal/jiff/RFC-5545.
/// - `Earlier` / `Later` — явный выбор для overlap.
/// - `Reject` — `Err(Ambiguous)` на любом gap/overlap.
#stable(since = "0.1")
export type Disambiguation enum
    | Compatible
    | Earlier
    | Later
    | Reject
