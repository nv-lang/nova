// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/errors.nv — структурные ошибки + базовые sum-типы календаря.
//
// Plan 175.1 (D319/D320/D321). Co-equal файл модуля `time.civil`: все типы
// видны остальным файлам модуля без импорта (как runtime.string).
//
// Структурные ошибки (D321): конструкторы/parse возвращают `Result`, НЕТ
// default-panicking конструктора (урок chrono `from_ymd` deprecated).

module time.civil

// ──────────────────────────────────────────────────────────────────────────
// FieldKind — какое поле нарушено (для InvalidField / InvalidValue)
// ──────────────────────────────────────────────────────────────────────────

/// Identifier of the date/time component in a structural error.
#stable(since = "0.1")
export type FieldKind enum
    | Year
    | Month
    | Day
    | Hour
    | Minute
    | Second
    | Nano
    | OffsetSec
    | Weekday

/// Human-readable field name (for messages).
#stable(since = "0.1")
export fn FieldKind @name() -> str =>
    match @ {
        Year      => "year",
        Month     => "month",
        Day       => "day",
        Hour      => "hour",
        Minute    => "minute",
        Second    => "second",
        Nano      => "nanosecond",
        OffsetSec => "offset-seconds",
        Weekday   => "weekday",
    }

// ──────────────────────────────────────────────────────────────────────────
// DateError — ошибки построения/арифметики (D321)
// ──────────────────────────────────────────────────────────────────────────

/// Structural error of building/arithmetic on calendar quantities.
///
/// - `InvalidField(field, given, min, max)` — Feb 30, month 13, hour 25.
/// - `RangeOverflow(kind)` — civil↔Timestamp outside the ±292y window (D317).
/// - `Ambiguous(kind)` — `Reject` on a DST gap/overlap.
/// - `UnknownZone(name)` — zone name not found (Ф.4 tz loading).
/// - `BadTzData(what)` — corrupt/unsupported TZif bytes (Ф.4).
///
/// Shape — time-crate `ComponentRange` + java.time `getErrorIndex`.
#stable(since = "0.1")
export type DateError enum
    | InvalidField(FieldKind, i64, i64, i64)
    | RangeOverflow(str)
    | Ambiguous(str)
    | UnknownZone(str)
    | BadTzData(str)

/// Diagnostic message.
#stable(since = "0.1")
export fn DateError @to_str() -> str =>
    match @ {
        InvalidField(f, given, mn, mx) => {
            "invalid ${f.name()}: ${given} (expected ${mn}..${mx})"
        }
        RangeOverflow(kind) => "range overflow: ${kind}",
        Ambiguous(kind)     => "ambiguous local time: ${kind}",
        UnknownZone(name)   => "unknown time zone: ${name}",
        BadTzData(what)     => "bad tz data: ${what}",
    }

// ──────────────────────────────────────────────────────────────────────────
// ParseDateTimeError — ошибки разбора текста (D321)
// ──────────────────────────────────────────────────────────────────────────

/// Parse error of an ISO-8601/RFC-3339/pattern string.
///
/// - `FormatMismatch(position, expected)` — the structure did not match.
/// - `InvalidValue(position, field, given)` — a value outside the range.
#stable(since = "0.1")
export type ParseDateTimeError enum
    | FormatMismatch(int, str)
    | InvalidValue(int, FieldKind, i64)

/// Diagnostic message.
#stable(since = "0.1")
export fn ParseDateTimeError @to_str() -> str =>
    match @ {
        FormatMismatch(pos, expected) => {
            "format mismatch at ${pos}: expected ${expected}"
        }
        InvalidValue(pos, field, given) => {
            "invalid ${field.name()} at ${pos}: ${given}"
        }
    }

// ──────────────────────────────────────────────────────────────────────────
// Disambiguation / OffsetConflict — DST-политики (D321)
// ──────────────────────────────────────────────────────────────────────────

// NB [M-175.1-variant-name-collision]: пространство имён вариантов ФЛОСКОЕ
// (голый вариант резолвится независимо от целевого типа), а qualified
// `Enum.Variant` как ЗНАЧЕНИЕ — ICE [P67-LEGACY] Path call
// ([M-175.1-qualified-variant-value]) → у D321-политик имена вариантов
// уникальны: конфликт-вариант назван `RejectMismatch` (не `Reject`, как в
// jiff/Temporal) — спека D321 R2 амендирована.

/// 4-way resolution of a mismatch between the stored offset and the current
/// zone rules (post-tzdb-change drift). Only for explicit-offset strings.
///
/// - `RejectMismatch` (default) — `Err` on a mismatch.
/// - `Use` — trust the stored offset as-is.
/// - `Prefer` — prefer the stored one if it is valid for the zone.
/// - `Ignore` — ignore the stored one, recompute from the zone.
#stable(since = "0.1")
export type OffsetConflict enum
    | RejectMismatch
    | Use
    | Prefer
    | Ignore

/// 4-way resolution of ambiguous local time during a DST transition.
///
/// - `Compatible` (default) — gap → push-forward by the gap length (after-offset);
///   overlap → earlier-offset. Compatible with Temporal/jiff/RFC-5545.
/// - `Earlier` / `Later` — explicit choice for overlap.
/// - `Reject` — `Err(Ambiguous)` on any gap/overlap.
#stable(since = "0.1")
export type Disambiguation enum
    | Compatible
    | Earlier
    | Later
    | Reject
