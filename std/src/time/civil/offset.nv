// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/offset.nv — Offset: фиксированный UTC-сдвиг (D319/D321).
//
// Plan 175.1 Ф.3. Канон — СЕКУНДЫ (ISO ±HH:MM:SS + историч. под-минутные
// зоны; java.time/Temporal — total seconds). Диапазон ±64800 (±18h).
//
// System-local offset — `Offset.local()` ниже, поверх эффект-опа
// `Time.local_offset_sec()` (std/time/duration/time_effect.nv — Plan 175.2
// Ф.2-v4 П6 moved `Time` out of prelude; retype to `local_offset()->Offset`
// ATTEMPTED + REVERTED same wave, П11, D316 amend + D321, 2026-07-10 —
// vtable-слот в NovaVtable_Time, closes [M-175.1-local-offset-effect-op]).
// Даёт ТОЛЬКО числовой сдвиг — никакой implicit-зоны нигде в civil-API
// (D319 R1 не меняется: `ZonedDateTime` всегда требует явный
// `TimeZone`/`Offset`).

module time.civil

/// Fixed offset from UTC in seconds (±18h) — a value-record.
///
/// Positive — east of Greenwich (`+05:30` = 19800).
#stable(since = "0.1")
export type Offset value {
    ro seconds i32
}

// ──────────────────────────────────────────────────────────────────────────
// Конструкторы
// ──────────────────────────────────────────────────────────────────────────

/// Zero offset (UTC).
#stable(since = "0.1")
export fn Offset.utc() -> Offset => { seconds: 0 }

/// From seconds → `Result` (±64800).
#stable(since = "0.1")
export fn Offset.from_seconds(s i32) -> Result[Offset, DateError] =>
    if s < -64_800 || s > 64_800 {
        Err(InvalidField(FieldKind.OffsetSec, s as i64, -64_800, 64_800))
    } else {
        Ok({ seconds: s })
    }

/// From hours+minutes (`h` carries the sign; `m` 0..59 — the modulus, sign inherited).
///
/// # Examples
/// ```nova
/// ro msk = Offset.from_hm(3, 0)!!      // +03:00
/// ro ist = Offset.from_hm(5, 30)!!     // +05:30
/// ro nyc = Offset.from_hm(-5, 0)!!     // -05:00
/// ```
#stable(since = "0.1")
export fn Offset.from_hm(h i32, m i32) -> Result[Offset, DateError] {
    if m < 0 || m > 59 { return Err(InvalidField(FieldKind.Minute, m as i64, 0, 59)) }
    ro sign = if h < 0 { -1 } else { 1 }
    ro habs = if h < 0 { -h } else { h }
    ro total = sign * ((habs as int) * 3600 + (m as int) * 60)
    Offset.from_seconds(total as i32)
}

/// System UTC offset of the machine's CURRENT local zone (D316 amend + D321,
/// 2026-07-10) — closes [M-175.1-local-offset-effect-op]. DST is already
/// accounted for (this is the offset a fresh `Timestamp.now()` would observe
/// RIGHT NOW, not a fixed standard-time offset).
///
/// **An explicit query, not an implicit default** (D319 R1):
/// `ZonedDateTime`/the rest of the civil API still require an explicit
/// `TimeZone`/`Offset` at every call-site — the same operation class as
/// java.time `ZoneId.systemDefault()` / Temporal `Now.timeZoneId()` (an
/// explicit query; the caller decides whether to use the result).
///
/// **Mockable** — a `Time` effect; `with Time = handler {...}` substitutes
/// (`std/testing/handlers.nv` — `fixed_ms`/`mut_clock` give a deterministic
/// `0` — UTC).
///
/// # Examples
/// ```nova
/// ro here = Offset.local()
/// ro dt = DateTime.new(Date.new(2026, Jul, 10)!!, TimeOfDay.new(12, 0)!!)
/// ro z = dt.to_zoned(TimeZone.Fixed(here))!!   // explicit binding — not implicit
/// ```
#stable(since = "0.6")
export fn Offset.local() Time -> Offset => { seconds: Time.local_offset_sec() as i32 }

// ──────────────────────────────────────────────────────────────────────────
// Компоненты
// ──────────────────────────────────────────────────────────────────────────

/// Full offset in seconds (canon).
#stable(since = "0.1")
export fn Offset @to_seconds() -> i32 => @seconds

/// Whether the offset is zero (UTC).
#stable(since = "0.1")
export fn Offset @is_utc() -> bool => @seconds == 0

/// Compare by seconds.
#stable(since = "0.1")
export fn Offset @compare(other Offset) -> int =>
    if @seconds < other.seconds { -1 }
    else if @seconds > other.seconds { 1 }
    else { 0 }

// ──────────────────────────────────────────────────────────────────────────
// ISO-форма: `Z` | `±HH:MM` | `±HH:MM:SS` (под-минутные — с секундами)
// ──────────────────────────────────────────────────────────────────────────

/// ISO-8601/RFC-3339 form: `Z` for zero, otherwise `±HH:MM[:SS]`.
#stable(since = "0.1")
export fn Offset @to_iso() -> str {
    if @seconds == 0 { return "Z" }
    ro neg = @seconds < 0
    ro a = if neg { -(@seconds as i64) } else { @seconds as i64 }
    ro h = a / 3600
    ro m = (a % 3600) / 60
    ro s = a % 60
    ro sign = if neg { "-" } else { "+" }
    ro base = "${sign}${pad2(h)}:${pad2(m)}"
    if s == 0 { base } else { "${base}:${pad2(s)}" }
}

/// Display = the ISO form.
#stable(since = "0.1")
export fn Offset @to_str() -> str => @to_iso()
