// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/tz.nv — IANA-зоны: embedded rule-based curated-таблица +
// str-конверсия `s.to_timezone()` (конверсия — метод на источнике).
//
// Слои загрузки (jiff layered-model):
//   1. `s.to_timezone()` — чистая embedded curated-таблица (rule-based
//      генерация транзишенов на 1996..2100) + "UTC"/"Z"/"±HH:MM[:SS]".
//   2. `TimeZone.from_tzif(id, bytes)` — raw-TZif-bytes loader (tzif.nv).
//   3. `load_timezone(name) Fs, Os` — OS-tzdata-first ($ZONEINFO override →
//      /usr/share/zoneinfo → fallback на embedded) (tzif.nv).
//
// Curated-таблица (задокументированное сужение полного ~450KB IANA-snapshot,
// follow-up [M-175.1-full-tzdb-embed]): правила СОВРЕМЕННЫЕ (см. per-зону);
// исторические переходы до нижней границы диапазона генерации не покрываются
// embedded-таблицей (полная история — через TZif на POSIX).

module time.civil

/// Версия embedded curated-таблицы (expose tzdb-version).
/// Реальный TZif-файл (load_timezone) актуален версии OS-tzdata.
#stable(since = "0.1")
export fn tzdb_version() -> str => "nova-curated-2026a"

// ──────────────────────────────────────────────────────────────────────────
// Rule-based генераторы транзишенов
// ──────────────────────────────────────────────────────────────────────────

// n-е воскресенье месяца (n>=1) года y как epoch-day.
fn nth_sunday_epoch_day(y i32, m Month, n int) -> i64 {
    ro first = Date.new(y, m, 1) ?? panic("tz: nth_sunday unreachable (curated years valid)")
    ro d = first.nth_weekday(n, Sun) ?? panic("tz: nth_sunday out of month (curated rules valid)")
    d.to_epoch_day()
}

// Последнее воскресенье месяца года y как epoch-day.
fn last_sunday_epoch_day(y i32, m Month) -> i64 {
    ro first = Date.new(y, m, 1) ?? panic("tz: last_sunday unreachable")
    ro last = first.last_day_of_month()
    if last.weekday() == Sun { last.to_epoch_day() }
    else { last.prev(Sun).to_epoch_day() }
}

// America/New_York (правила 2007+, Energy Policy Act):
//   EST -05:00 std / EDT -04:00 dst;
//   spring: 2-е воскресенье марта 02:00 local-std (=07:00Z);
//   fall:   1-е воскресенье ноября 02:00 local-dst (=06:00Z).
fn rules_america_new_york() -> ZoneRules {
    mut transitions []i64 = []
    mut offsets []i32 = []
    offsets.push(-18_000)   // до первого перехода (январь 2007) — EST
    for y i32 in 2007..=2100 {
        ro spring = nth_sunday_epoch_day(y, Mar, 2) * 86_400 + 2 * 3_600 + 18_000
        ro fall = nth_sunday_epoch_day(y, Nov, 1) * 86_400 + 2 * 3_600 + 14_400
        transitions.push(spring)
        offsets.push(-14_400)
        transitions.push(fall)
        offsets.push(-18_000)
    }
    { transitions, offsets }
}

// Europe/London (правила EU 1996+):
//   GMT +00:00 std / BST +01:00 dst;
//   spring: последнее воскресенье марта 01:00Z;
//   fall:   последнее воскресенье октября 01:00Z.
fn rules_europe_london() -> ZoneRules {
    mut transitions []i64 = []
    mut offsets []i32 = []
    offsets.push(0)   // январь 1996 — GMT
    for y i32 in 1996..=2100 {
        ro spring = last_sunday_epoch_day(y, Mar) * 86_400 + 3_600
        ro fall = last_sunday_epoch_day(y, Oct) * 86_400 + 3_600
        transitions.push(spring)
        offsets.push(3_600)
        transitions.push(fall)
        offsets.push(0)
    }
    { transitions, offsets }
}

// Europe/Moscow: фикс MSK +03:00 (с 2014-10-26; DST отменён).
// Историческая точность до 2014 — вне curated-диапазона (TZif на POSIX).
fn rules_europe_moscow() -> ZoneRules => ZoneRules.fixed(10_800)

// Australia/Sydney (правила 2008+):
//   AEST +10:00 std / AEDT +11:00 dst (южное полушарие: DST октябрь→апрель);
//   start: 1-е воскресенье октября 02:00 local-std (=16:00Z накануне);
//   end:   1-е воскресенье апреля 03:00 local-dst (=16:00Z накануне).
fn rules_australia_sydney() -> ZoneRules {
    mut transitions []i64 = []
    mut offsets []i32 = []
    offsets.push(11 * 3_600)   // январь 2008 — лето, AEDT
    for y i32 in 2008..=2100 {
        ro apr_end = nth_sunday_epoch_day(y, Apr, 1) * 86_400 + 3 * 3_600 - 11 * 3_600
        ro oct_start = nth_sunday_epoch_day(y, Oct, 1) * 86_400 + 2 * 3_600 - 10 * 3_600
        transitions.push(apr_end)
        offsets.push(10 * 3_600)
        transitions.push(oct_start)
        offsets.push(11 * 3_600)
    }
    { transitions, offsets }
}

// ──────────────────────────────────────────────────────────────────────────
// str @to_timezone — конверсия (embedded, чистая)
// ──────────────────────────────────────────────────────────────────────────

// Разбор "±HH:MM[:SS]" → секунды; None если не offset-форма.
fn parse_offset_str(s str) -> Option[int] {
    ro n = s.byte_len()
    if n != 6 && n != 9 { return None }
    ro sign_ch = s[..1]
    ro sign = if sign_ch == "+" { 1 } else if sign_ch == "-" { -1 } else { return None }
    if s[3..4] != ":" { return None }
    ro h = s[1..3].to_int().ok()?
    ro m = s[4..6].to_int().ok()?
    if m > 59 { return None }
    mut sec = h * 3_600 + m * 60
    if n == 9 {
        if s[6..7] != ":" { return None }
        ro ss = s[7..9].to_int().ok()?
        if ss > 59 { return None }
        sec += ss
    }
    Some(sign * sec)
}

/// Конверсия строки в таймзону (метод на источнике, зеркально
/// `s.to_url()`/`s.to_cron()`):
///
/// - `"UTC"` / `"Etc/UTC"` / `"Z"` → `Utc`;
/// - `"+05:30"` / `"-08:00"` / `"+02:30:17"` → `Fixed`;
/// - curated IANA-имена (`America/New_York`, `Europe/London`,
///   `Europe/Moscow`, `Australia/Sydney`) → `Iana` с rule-based правилами;
/// - иначе → `Err(UnknownZone)` (полный список зон — TZif на POSIX,
///   [`load_timezone`]).
///
/// # Examples
/// ```nova
/// ro ny = "America/New_York".to_timezone()!!
/// ro fx = "+05:30".to_timezone()!!
/// ```
#stable(since = "0.1")
export fn str @to_timezone() -> Result[TimeZone, DateError] {
    if @ == "UTC" || @ == "Etc/UTC" || @ == "Z" || @ == "utc" {
        return Ok(Utc)
    }
    match parse_offset_str(@) {
        Some(sec) => {
            return match Offset.from_seconds(sec as i32) {
                Ok(off) => Ok(Fixed(off)),
                Err(e) => Err(e),
            }
        }
        None => {}
    }
    ro rules = if @ == "America/New_York" { rules_america_new_york() }
        else if @ == "Europe/London" { rules_europe_london() }
        else if @ == "Europe/Moscow" { rules_europe_moscow() }
        else if @ == "Australia/Sydney" { rules_australia_sydney() }
        else { return Err(UnknownZone(@)) }
    ro z IanaZone = { id: @, rules }
    Ok(Iana(z))
}
