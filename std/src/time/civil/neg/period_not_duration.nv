// Plan 175.1 Ф.2 (D320 R2) — DateBased/TimeBased type-enforcement:
// `Date` принимает ТОЛЬКО `Period`; перегрузки `Date @plus(Duration)` НЕТ →
// «add hours to a Date» = ошибка типов (бьёт Temporal runtime-RangeError).
//
// ⚠ Операторная форма `d + 2.hours()` НЕ ловится: резолв оператора
// arg-type-blind (подбирает @plus по имени, тип аргумента не сверяет) —
// [M-175.1-operator-arg-type-blind], та же природа, что
// [M-175.1-minus-overload-arg-type]. Гейт D320 держит МЕТОД-форма.
//
// EXPECT_COMPILE_ERROR

module neg.period_not_duration

import std.time.civil
import std.time.duration

test "date.plus(duration) — type-error (D320)" {
    ro d = Date.new(2026, Jul, 10)!!
    ro _x = d.plus(2.hours())   // ← Duration на Date: перегрузки нет
}
