// SPDX-License-Identifier: MIT OR Apache-2.0
// std/time/civil/zoned.nv — TimeZone + ZoneRules + ZonedDateTime +
// 4-way Disambiguation. IANA-загрузка (TZif/embedded) — в tz.nv.
//
// Type-ladder: ZonedDateTime — точка на оси; `offset` хранит резолвнутый
// сдвиг (round-trip-safe при смене правил), `zone` — идентичность зоны для
// лосслесс round-trip (RFC-9557 [zone]).
//
// `Utc`/`Fixed` — всегда unambiguous (DST нет); реальный gap/overlap
// приносят IANA-зоны — 4-way Disambiguation работает не вхолостую.

module time.civil

import std.time.duration

// `panic` (overflow-trap primitive) is an always-available compiler
// intrinsic — no redeclaration needed.

// ──────────────────────────────────────────────────────────────────────────
// ZoneRules + IanaZone — transition-таблица
// ──────────────────────────────────────────────────────────────────────────

/// Zone rules: transition instants (unix seconds) + offsets.
/// `offsets.len() == transitions.len() + 1`: `offsets[0]` applies until the
/// first transition, `offsets[i+1]` — from `transitions[i]`.
#stable(since = "0.1")
export type ZoneRules {
    ro transitions []i64
    ro offsets []i32
}

/// A named IANA zone: id ("Europe/Moscow") + transition rules.
/// Reference type (rules are shared, not copied).
#stable(since = "0.1")
export type IanaZone {
    ro id str
    ro rules ZoneRules
}

/// Rules with a single fixed offset (no transitions).
#stable(since = "0.1")
export fn ZoneRules.fixed(off i32) -> ZoneRules =>
    { transitions: [], offsets: [off] }

/// Zone offset at a given INSTANT (unix seconds) — no binary search needed
/// on typical tables; a linear scan from the end (recent transitions are the
/// most common queries).
fn rules_offset_at(rules ZoneRules, instant_sec i64) -> i32 {
    ro n = rules.transitions.len()
    mut i = n
    while i > 0 {
        if instant_sec >= rules.transitions[i - 1] { return rules.offsets[i] }
        i -= 1
    }
    rules.offsets[0]
}

// ──────────────────────────────────────────────────────────────────────────
// TimeZone — sum-type
// ──────────────────────────────────────────────────────────────────────────

/// Time zone: `Utc` | `Fixed(Offset)` — value-weight, no DST;
/// `Iana(IanaZone)` — a named zone with rules (Ф.4).
/// No separate OffsetDateTime: `ZonedDateTime{zone: Fixed}` covers it.
#stable(since = "0.1")
export type TimeZone enum
    | Utc
    | Fixed(Offset)
    | Iana(IanaZone)

/// Human-readable zone identity ("UTC", "+05:30", "Europe/Moscow").
#stable(since = "0.1")
export fn TimeZone @to_str() -> str =>
    match @ {
        Utc => "UTC",
        Fixed(off) => off.to_iso(),
        Iana(z) => z.id,
    }

/// Zone offset at the given instant.
#stable(since = "0.1")
export fn TimeZone @offset_at(ts Timestamp) -> Offset =>
    match @ {
        Utc => Offset.utc(),
        Fixed(off) => off,
        Iana(z) => { seconds: rules_offset_at(z.rules, ts.unix_nanos() / 1_000_000_000) },
    }

// ──────────────────────────────────────────────────────────────────────────
// LocalResolution — ambiguity как ЗНАЧЕНИЕ (не exception,
// не chrono-None-путающий-gap-с-ошибкой)
// ──────────────────────────────────────────────────────────────────────────

/// Result of resolving local wall-time in a zone: unique / in a DST gap /
/// in a DST overlap. The offsets — (before, after) around the transition.
#stable(since = "0.1")
export type LocalResolution enum
    | Unique(Offset)
    | Gap(Offset, Offset)
    | Overlap(Offset, Offset)

/// Wall-time landed in a DST gap (spring-forward, does not exist).
#stable(since = "0.1")
export fn LocalResolution @is_gap() -> bool =>
    match @ { Gap(_, _) => true, _ => false }

/// Wall-time landed in a DST overlap (fall-back, occurs twice).
#stable(since = "0.1")
export fn LocalResolution @is_overlap() -> bool =>
    match @ { Overlap(_, _) => true, _ => false }

// Локальные секунды plain DateTime (epoch-based, без зоны).
fn local_seconds(dt DateTime) -> i64 =>
    dt.date().epoch_day() * 86_400 + dt.time().nanos_of_day() / 1_000_000_000

/// Resolve local wall-time in a zone — the ambiguity surface as a value.
#stable(since = "0.1")
export fn TimeZone @resolve_local(dt DateTime) -> LocalResolution {
    match @ {
        Utc => return Unique(Offset.utc()),
        Fixed(off) => return Unique(off),
        Iana(z) => {
            ro l = local_seconds(dt)
            ro rules = z.rules
            ro n = rules.transitions.len()
            // Кандидат i валиден, если instant = l - offsets[i] попадает в
            // интервал действия offsets[i].
            mut valid_before i64 = -1   // индекс первого валидного
            mut valid_after i64 = -1
            for i in 0..=n {
                ro off = rules.offsets[i] as i64
                ro inst = l - off
                ro lo_ok = if i == 0 { true } else { inst >= rules.transitions[i - 1] }
                ro hi_ok = if i == n { true } else { inst < rules.transitions[i] }
                if lo_ok && hi_ok {
                    if valid_before < 0 { valid_before = i as i64 }
                    else { valid_after = i as i64 }
                }
            }
            if valid_before >= 0 && valid_after >= 0 {
                // Два валидных интерпретирования → overlap (earlier = меньший индекс).
                ro ob Offset = { seconds: rules.offsets[valid_before as int] }
                ro oa Offset = { seconds: rules.offsets[valid_after as int] }
                return Overlap(ob, oa)
            }
            if valid_before >= 0 {
                ro u Offset = { seconds: rules.offsets[valid_before as int] }
                return Unique(u)
            }
            // 0 валидных → gap: найти переход, «съевший» wall-time
            // (l между граничными wall-time до/после перехода).
            for j in 0..n {
                ro before = rules.offsets[j] as i64
                ro after = rules.offsets[j + 1] as i64
                ro t = rules.transitions[j]
                if l - before >= t && l - after < t {
                    ro gb Offset = { seconds: rules.offsets[j] }
                    ro ga Offset = { seconds: rules.offsets[j + 1] }
                    return Gap(gb, ga)
                }
            }
            // Недостижимо для корректной таблицы; трактуем как Unique(первый).
            ro fb Offset = { seconds: rules.offsets[0] }
            return Unique(fb)
        }
    }
}

// ──────────────────────────────────────────────────────────────────────────
// ZonedDateTime — точка на оси: wall + резолвнутый offset + зона
// ──────────────────────────────────────────────────────────────────────────

/// An instant of time with a calendar representation in a zone.
#stable(since = "0.1")
export type ZonedDateTime value {
    ro dt DateTime
    ro offset Offset
    ro zone TimeZone
}

/// The wall component (plain DateTime in the zone).
#stable(since = "0.1")
export fn ZonedDateTime @datetime() -> DateTime => @dt

/// The resolved offset of this instant.
#stable(since = "0.1")
export fn ZonedDateTime @offset() -> Offset => @offset

/// The zone (identity; for the RFC-9557 round-trip).
#stable(since = "0.1")
export fn ZonedDateTime @zone() -> TimeZone => @zone

/// The Date component.
#stable(since = "0.1")
export fn ZonedDateTime @date() -> Date => @dt.date()

/// The TimeOfDay component.
#stable(since = "0.1")
export fn ZonedDateTime @time() -> TimeOfDay => @dt.time()

// ──────────────────────────────────────────────────────────────────────────
// DateTime → ZonedDateTime (fallible: единственная дверь
// Plain → точка на оси; Disambiguation)
// ──────────────────────────────────────────────────────────────────────────

/// Attach a plain DateTime to a zone → `Result` (Q8: default `Compatible`).
///
/// Gap: `Compatible`/`Later` — push forward by the gap length (after-offset);
/// `Earlier` — back by the gap length (before-offset); `Reject` → `Err(Ambiguous)`.
/// Overlap: `Compatible`/`Earlier` — the earlier offset; `Later` — the later;
/// `Reject` → `Err(Ambiguous)`.
///
/// # Examples
/// ```nova
/// ro z = dt.to_zoned(Utc)!!
/// ro m = dt.to_zoned(Fixed(Offset.from_hm(3, 0)!!))!!
/// ```
#stable(since = "0.1")
export fn DateTime @to_zoned(tz TimeZone) -> Result[ZonedDateTime, DateError] =>
    @to_zoned(tz, Compatible)

/// Full form with an explicit policy (arity overload: a default enum-variant
/// value is not emitted at the call site — [M-175.1-enum-default-param];
/// the split precedent — D324 `env(k)`/`env(k,v)`).
#stable(since = "0.1")
export fn DateTime @to_zoned(tz TimeZone, disamb Disambiguation) -> Result[ZonedDateTime, DateError] {
    match tz.resolve_local(@) {
        Unique(off) => Ok({ dt: @, offset: off, zone: tz }),
        Gap(before, after) => {
            match disamb {
                Reject => Err(Ambiguous("gap: wall-time does not exist in zone")),
                Earlier => {
                    // Назад на длину gap, интерпретация before-offset.
                    ro gap_len = (after.seconds() - before.seconds()) as i64
                    ro shifted = @minus(gap_len.to_seconds())
                    Ok({ dt: shifted, offset: before, zone: tz })
                }
                _ => {
                    // Compatible | Later: push-forward, after-offset.
                    ro gap_len = (after.seconds() - before.seconds()) as i64
                    ro shifted = @plus(gap_len.to_seconds())
                    Ok({ dt: shifted, offset: after, zone: tz })
                }
            }
        }
        Overlap(earlier, later) => {
            match disamb {
                Reject => Err(Ambiguous("overlap: wall-time occurs twice in zone")),
                Later => Ok({ dt: @, offset: later, zone: tz }),
                _ => Ok({ dt: @, offset: earlier, zone: tz }),   // Compatible | Earlier
            }
        }
    }
}

/// Today's date in zone `tz` (ambient `Time`, mockable).
#stable(since = "0.1")
export fn Date.today(tz TimeZone) Time -> Date =>
    Timestamp.now().to_zoned(tz).date()

/// The current instant in zone `tz` (ambient `Time`, mockable).
#stable(since = "0.1")
export fn ZonedDateTime.now(tz TimeZone) Time -> ZonedDateTime =>
    Timestamp.now().to_zoned(tz)

// ──────────────────────────────────────────────────────────────────────────
// Timestamp ↔ ZonedDateTime (Err ТОЛЬКО civil→Timestamp;
// Timestamp→civil инфаллибельно — окно ±292y ⊂ civil-диапазона)
// ──────────────────────────────────────────────────────────────────────────

/// Instant → calendar representation in the zone. Infallible: the Timestamp
/// window (±292y from the epoch) with any ±18h offset lies deep inside the
/// civil range (±999999y) — Q4.
#stable(since = "0.1")
export fn Timestamp @to_zoned(tz TimeZone) -> ZonedDateTime {
    ro off = tz.offset_at(@)
    ro total_ns = @unix_nanos()
    // floor-division на отрицательных ns
    ro sec0 = total_ns / 1_000_000_000
    ro rem0 = total_ns % 1_000_000_000
    ro sec = if rem0 < 0 { sec0 - 1 } else { sec0 }
    ro subnano = if rem0 < 0 { rem0 + 1_000_000_000 } else { rem0 }
    ro local = sec + (off.seconds() as i64)
    ro day0 = local / 86_400
    ro remd = local % 86_400
    ro day = if remd < 0 { day0 - 1 } else { day0 }
    ro sod = if remd < 0 { remd + 86_400 } else { remd }
    ro date = Date.from_epoch_day(day)
    ro tod = TimeOfDay.from_nanos_of_day(sod * 1_000_000_000 + subnano) ?? panic("Timestamp.to_zoned: unreachable (sod in 0..86400)")
    { dt: date.at(tod), offset: off, zone: tz }
}

/// Calendar instant → Timestamp. `Err(RangeOverflow)` outside the ±292y window (Q4).
/// The instant is determined by the value itself (the offset is stored) — no zone resolve needed.
#stable(since = "0.1")
export fn ZonedDateTime @to_timestamp() -> Result[Timestamp, DateError] {
    ro l = local_seconds(@dt)
    ro inst_sec = l - (@offset.seconds() as i64)
    ro nano = @dt.time().nanos_of_day() % 1_000_000_000
    // Окно i64-ns: ±9_223_372_036 секунд (≈±292y).
    if inst_sec > 9_223_372_035 || inst_sec < -9_223_372_036 {
        return Err(RangeOverflow("ZonedDateTime out of Timestamp ±292y window"))
    }
    Ok((inst_sec * 1_000_000_000 + nano).to_unix_nanos())
}

/// The same instant in another zone → `Result` (Err outside the Timestamp window).
#stable(since = "0.1")
export fn ZonedDateTime @with_zone(tz TimeZone) -> Result[ZonedDateTime, DateError] =>
    match @to_timestamp() {
        Ok(ts) => Ok(ts.to_zoned(tz)),
        Err(e) => Err(e),
    }

// ──────────────────────────────────────────────────────────────────────────
// Арифметика (wall-vs-elapsed асимметрия):
//   @plus(Period)   — календарная: wall-time сохраняется, re-resolve в зоне
//   @plus(Duration) — elapsed: точный сдвиг инстанта (wall может прыгнуть)
// ──────────────────────────────────────────────────────────────────────────

/// Calendar shift: `zoned + Period(days:1)` across DST — the same wall-time
/// (23/25h elapsed). Re-resolve with `Compatible`. **Trap** outside the range.
#stable(since = "0.1")
export fn ZonedDateTime @plus(p Period) -> ZonedDateTime {
    ro moved = @dt + p
    moved.to_zoned(@zone, Compatible) ?? panic("ZonedDateTime arithmetic: + Period out of range")
}

/// Calendar shift backward.
#stable(since = "0.1")
export fn ZonedDateTime @minus(p Period) -> ZonedDateTime {
    ro moved = @dt - p
    moved.to_zoned(@zone, Compatible) ?? panic("ZonedDateTime arithmetic: - Period out of range")
}

/// Elapsed shift: `zoned + Duration(24h)` — exactly 24h on the axis (the
/// wall-time across DST will shift). **Trap** outside the Timestamp window (D317).
#stable(since = "0.1")
export fn ZonedDateTime @plus_duration(d Duration) -> ZonedDateTime =>
    match @to_timestamp() {
        Ok(ts) => (ts + d).to_zoned(@zone),
        Err(_) => panic("ZonedDateTime arithmetic: instant out of ±292y window"),
    }

/// Elapsed shift backward.
#stable(since = "0.1")
export fn ZonedDateTime @minus_duration(d Duration) -> ZonedDateTime =>
    match @to_timestamp() {
        Ok(ts) => (ts - d).to_zoned(@zone),
        Err(_) => panic("ZonedDateTime arithmetic: instant out of ±292y window"),
    }

// ──────────────────────────────────────────────────────────────────────────
// Compare + Display
// ──────────────────────────────────────────────────────────────────────────

/// Compare BY INSTANT (not by wall-time): two ZonedDateTime are equal if
/// they denote the same instant (regardless of the representation zone).
#stable(since = "0.1")
export fn ZonedDateTime @compare(other ZonedDateTime) -> int {
    ro a = local_seconds(@dt) - (@offset.seconds() as i64)
    ro b = local_seconds(other.datetime()) - (other.offset().seconds() as i64)
    if a < b { return -1 }
    if a > b { return 1 }
    ro an = @dt.time().nanos_of_day() % 1_000_000_000
    ro bn = other.datetime().time().nanos_of_day() % 1_000_000_000
    if an < bn { -1 } else if an > bn { 1 } else { 0 }
}

/// ISO/RFC-3339 style: `YYYY-MM-DDTHH:MM:SS±HH:MM`; for an Iana zone — plus an
/// RFC-9557 suffix `[Europe/Moscow]` (lossless zone identity).
#stable(since = "0.1")
export fn ZonedDateTime @to_iso() -> str {
    ro base = "${@dt.to_iso()}${@offset.to_iso()}"
    match @zone {
        Iana(z) => "${base}[${z.id}]",
        _ => base,
    }
}

/// Display = the ISO form.
#stable(since = "0.1")
export fn ZonedDateTime @to_str() -> str => @to_iso()
