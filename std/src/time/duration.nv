// stdlib/duration.nv — Duration + Timestamp + Time effect.
//
// Идея:
//   2.seconds()        → Duration { nanos: 2_000_000_000 }
//   100.millis()       → Duration { nanos: 100_000_000 }
//   0.5.hours()        → Duration { nanos: 1_800_000_000_000 }
//   2.seconds() + 30.millis()
//   ts2 - ts1          → Duration (между двумя моментами)
//   ts + 30.seconds()  → Timestamp (deadline)
//
// Нет magic, нет implicit conversion — обычные методы на примитивах
// (D35: метод привязан к типу через `fn Type @method`).
//
// AI-first: Time effect позволяет в тестах подменить часы:
//   with Time = th.fixed_ms(1700000000000) { ... детерминированный код ... }

//! Plan 45 Ф.34.3 — Duration + Timestamp + Time effect.
//!
//! Time-related types: представление длительностей и моментов времени.
//! Sensible defaults: nanosecond precision, signed Duration (поддерживает
//! отрицательные интервалы), `Time` effect для дeterministic testing.
//!
//! # Examples
//!
//! ```nova
//! let d = Duration.from_secs(5)
//! assert(d.as_secs() == 5)
//! assert(d.as_millis() == 5000)
//! ```

module time.duration

import std.testing.handlers as th

// `panic` (overflow-trap primitive, Plan 175 Ф.1c / D317) is an
// always-available compiler intrinsic ([panic-assert-intrinsic]
// 2026-07-11) — no redeclaration needed. Trap fires in debug AND release
// (never a build-mode-dependent UB — Zig-antipattern; never a silent wrap —
// Go-trap). See §3b/D317.

// ──────────────────────────────────────────────────────────────────────────
// Duration — длительность (signed, ±292 года)
// ──────────────────────────────────────────────────────────────────────────

/// Duration — signed time interval с nanosecond precision.
///
/// Range: ±292 years (i64::MAX nanoseconds). Used для timeouts, intervals,
/// delays. Constructed через `Duration.from_*` static methods (one per unit).
///
/// # Examples
///
/// ```nova
/// let d = Duration.from_millis(500)
/// assert(d.as_millis() == 500)
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
/// Single `i64 nanos` field → ABI-identical to a bare `int64_t` at the C
/// boundary (sync-timeouts / channel-deadlines extract `.nanos`).
#stable(since = "0.1")
export type Duration value {
    ro nanos i64
}

/// Zero duration — 0 nanoseconds. Useful как default / sentinel value.
#stable(since = "0.1")
export const ZERO Duration = { nanos: 0 }

/// One second.
#stable(since = "0.1")
export const SECOND Duration = { nanos: 1_000_000_000 }

/// One minute (60 seconds).
#stable(since = "0.1")
export const MINUTE Duration = { nanos: 60_000_000_000 }

/// One hour (3600 seconds).
#stable(since = "0.1")
export const HOUR   Duration = { nanos: 3_600_000_000_000 }

// Saturation boundaries are ±(2⁶³−1) ns ≈ ±292 years (symmetric; the
// two's-complement `i64::MIN` = -2⁶³ is deliberately excluded so `@neg`/`@abs`
// are total). The `saturating_*` methods clamp to these edges via the internal
// `i64_max()`/`i64_min()` helpers below.
//
// **Deferred:** public consts `Duration.MAX`/`Duration.MIN` (Plan 178 wants
// `@timeout(Duration.MAX)`) are NOT declared here yet — a user type-const named
// `MAX`/`MIN` currently shadows the builtin numeric `.MAX`/`.MIN` in type-set-
// bound generics (`fn[T Ints] f(x T) => x == T.MAX`, spec_tests d310), mis-
// typing `T.MAX` as the record and CC-FAILing. Fix lives in the checker's
// member-const resolution (172-zone, owner-gated). Follow-up
// `[M-175-type-const-max-shadows-builtin]` (docs/plans/backlog-followups.md).



// ──────────────────────────────────────────────────────────────────────────
// Static-конструкторы Duration.from_X — возвращают ПО ИМЕНИ типа
// (`-> Duration`, НЕ `-> Self`): для value-record `-> Self` роутится через
// receiver_c_type → `NovaValue_Duration*` (POINTER на локал = dangling для
// static-конструктора). Return-by-name даёт корректный by-value возврат
// (прецедент `VVec4.new`, Plan 128 / Plan 175 Ф.1b).
// ──────────────────────────────────────────────────────────────────────────

/// Construct Duration from nanoseconds.
///
/// # Examples
/// ```nova
/// let d = Duration.from_nanos(1_000_000)
/// assert(d.as_micros() == 1000)
/// ```
#stable(since = "0.1")
export fn Duration.from_nanos(n i64) -> Duration => { nanos: n }

/// Construct Duration from microseconds (1 μs = 1000 ns).
#stable(since = "0.1")
export fn Duration.from_micros(n i64) -> Duration => { nanos: n * 1_000 }

/// Construct Duration from milliseconds (1 ms = 1_000_000 ns).
///
/// # Examples
/// ```nova
/// let d = Duration.from_millis(500)
/// assert(d.as_millis() == 500)
/// ```
#stable(since = "0.1")
export fn Duration.from_millis(n i64) -> Duration => { nanos: n * 1_000_000 }

/// Construct Duration from seconds.
#stable(since = "0.1")
export fn Duration.from_secs(n i64) -> Duration => { nanos: n * 1_000_000_000 }

/// Construct Duration from minutes (60 seconds per minute).
#stable(since = "0.1")
export fn Duration.from_mins(n i64) -> Duration => { nanos: n * 60 * 1_000_000_000 }

/// Construct Duration from hours (3600 seconds per hour).
#stable(since = "0.1")
export fn Duration.from_hours(n i64) -> Duration => { nanos: n * 3_600 * 1_000_000_000 }

/// Construct Duration from days (86400 seconds per day).
#stable(since = "0.1")
export fn Duration.from_days(n i64) -> Duration => { nanos: n * 86_400 * 1_000_000_000 }

/// Construct Duration from weeks (7 days per week).
#stable(since = "0.1")
export fn Duration.from_weeks(n i64) -> Duration => { nanos: n * 7 * 86_400 * 1_000_000_000 }

/// Construct Duration from fractional seconds (e.g. 0.5 → 500ms).
///
/// Useful для converting measurements (sensor data, sampling intervals)
/// которые natively f64.
///
/// **Plan 175 Ф.1c (D317):** traps on `NaN`/`±inf`/out-of-`i64`-range input
/// (Rust `Duration::from_secs_f64` panics; никогда silent мусор-cast). For a
/// non-trapping variant use [`try_from_secs_f64`].
#stable(since = "0.1")
export fn Duration.from_secs_f64(s f64) -> Duration =>
    Duration.from_nanos(f64_nanos_or_trap(s * 1_000_000_000.0))

/// Fallible construction from fractional seconds — `None` on `NaN`/`±inf`/
/// out-of-`i64`-range (Plan 175 Ф.1c / D317).
#stable(since = "0.1")
export fn Duration.try_from_secs_f64(s f64) -> Option[Duration] =>
    match f64_nanos_checked(s * 1_000_000_000.0) {
        Some(n) => Some(Duration.from_nanos(n)),
        None => None,
    }


// ──────────────────────────────────────────────────────────────────────────
// Конверсия обратно в числа
// ──────────────────────────────────────────────────────────────────────────

/// Total duration in nanoseconds (raw underlying value).
#stable(since = "0.1")
export fn Duration @as_nanos() => @nanos // [M-d410-as-to-migration]

/// Total duration in microseconds (truncating division — sub-μs nanoseconds dropped).
#stable(since = "0.1")
export fn Duration @as_micros() => @nanos / 1_000 // [M-d410-as-to-migration]

/// Total duration in milliseconds (truncating — sub-ms nanoseconds dropped).
///
/// # Examples
/// ```nova
/// assert(Duration.from_secs(2).as_millis() == 2000)
/// ```
#stable(since = "0.1")
export fn Duration @as_millis() => @nanos / 1_000_000 // [M-d410-as-to-migration]

/// Total duration in whole seconds (truncating).
#stable(since = "0.1")
export fn Duration @as_secs() => @nanos / 1_000_000_000 // [M-d410-as-to-migration]

/// Total duration in whole minutes (truncating).
#stable(since = "0.1")
export fn Duration @as_mins() => @nanos / 60_000_000_000 // [M-d410-as-to-migration]

/// Total duration in whole hours (truncating).
#stable(since = "0.1")
export fn Duration @as_hours() => @nanos / 3_600_000_000_000 // [M-d410-as-to-migration]

/// Total duration in whole days (truncating).
#stable(since = "0.1")
export fn Duration @as_days() => @nanos / 86_400_000_000_000 // [M-d410-as-to-migration]

/// Total duration as fractional seconds (`f64`).
///
/// Preserves sub-second precision (unlike [`as_secs`] which truncates).
///
/// # Examples
/// ```nova
/// assert(Duration.from_millis(1500).as_secs_f64() == 1.5)
/// ```
#stable(since = "0.1")
export fn Duration @as_secs_f64() -> f64 => (@nanos as f64) / 1_000_000_000.0 // [M-d410-as-to-migration]

/// Total duration as fractional milliseconds (`f64`).
#stable(since = "0.1")
export fn Duration @as_millis_f64() => (@nanos as f64) / 1_000_000.0 // [M-d410-as-to-migration]

// Round up to whole milliseconds — module-private helper for `@sleep`.
// `@as_millis` truncates toward zero, which would sleep LESS than
// requested when `@nanos` isn't an exact ms multiple (e.g. 1.5ms → 1ms).
// `Time.sleep(ms int)` only accepts whole milliseconds (int-wire, D316),
// so we ceil instead of truncate: `(nanos + 999_999) / 1_000_000`.
// Assumes non-negative `@nanos` (sleeping a negative duration is meaningless).
fn Duration @to_millis_ceil() -> i64 => (@nanos + 999_999) / 1_000_000

/// Sleep for this duration via the ambient `Time` effect.
///
/// **Rounds up** to whole milliseconds — never sleeps for *less* than
/// requested (the `Time` effect's `sleep` op is int-ms wire-typed, D316;
/// sub-millisecond remainders are rounded up, not truncated away).
///
/// # Examples
/// ```nova
/// 5.seconds().sleep()
/// ```
#stable(since = "0.1")
export fn Duration @sleep() Time -> () => Time.sleep(@to_millis_ceil() as int)

/// Suspend the current fiber for at least `d` (Plan 175 Ф.3(b)/Ф.4, D316) —
/// the canonical **free-function** form (Q6/Q8: user code sees only types +
/// free `sleep`/`sleep_until`, never calls the `Time` effect directly).
/// `d <= 0` resolves **immediately** — no error, no negative-sleep trap
/// (Go/tokio parity; the underlying runtime already treats `ms <= 0` as an
/// immediate yield, so this holds for any non-positive `Duration`).
/// Granularity is the libuv timer wheel (~1ms) — `sleep` guarantees
/// «sleep for *at least* `d`», never less. No `tolerance` parameter yet
/// ([M-sleep-tolerance] — Swift-style coalescing, future-additive).
///
/// # Examples
/// ```nova
/// sleep(500.millis())
/// sleep(Duration.from_nanos(0))  // resolves immediately, no wait
/// ```
#stable(since = "0.1")
export fn sleep(d Duration) Time -> () => d.sleep()

/// Suspend until the given **monotonic** deadline (Plan 175 Ф.3(b), D316
/// Q3 — MVP `sleep(deadline - Monotonic.now())` wrapper; drift-free true
/// re-arm timer is future work, Plan 66). Only `Monotonic` deadlines are
/// accepted — **not** `Timestamp`: an absolute wall-clock deadline is immune
/// to NTP/DST jumps only via the monotonic clock (D124 §3); the wall-based
/// equivalent is the explicit, footgun-visible `sleep(ts.time_until())`.
/// A deadline already in the past resolves **immediately** (saturate-to-
/// zero via `elapsed_since`, D318 — never a negative sleep, never a trap).
///
/// # Examples
/// ```nova
/// ro deadline = Monotonic.now() + 5.seconds()
/// sleep_until(deadline)
/// ```
#stable(since = "0.1")
export fn sleep_until(deadline Monotonic) Time -> () =>
    sleep(deadline.elapsed_since(Monotonic.now()))


// ──────────────────────────────────────────────────────────────────────────
// Predicates
// ──────────────────────────────────────────────────────────────────────────

/// True если duration равна нулю (`nanos == 0`).
#stable(since = "0.1")
export fn Duration @is_zero() => @nanos == 0

/// True если duration отрицательная (`nanos < 0`).
///
/// Используется для проверки что `ts2 - ts1` дало "в прошлом" result.
#stable(since = "0.1")
export fn Duration @is_negative() => @nanos < 0

/// True если duration строго положительная (`nanos > 0`).
#stable(since = "0.1")
export fn Duration @is_positive() => @nanos > 0


// ──────────────────────────────────────────────────────────────────────────
// Decomposition — разложение на компоненты (для display / форматирования)
// ──────────────────────────────────────────────────────────────────────────

/// Decomposed duration components — для форматирования "1h 30m 45s".
///
/// Always non-negative (для signed durations см. `Duration.is_negative()`
/// + это разложение модуля).
#stable(since = "0.1")
export type DurationParts {
    ro days int
    ro hours int
    ro minutes int
    ro seconds int
    ro millis int
    ro micros int
    ro nanos int
}

/// Decompose Duration на компоненты (days, hours, ..., nanos).
///
/// Sign discarded — все поля non-negative. Для signed display комбинируй с
/// [`is_negative`].
///
/// # Examples
/// ```nova
/// let d = Duration.from_secs(3661)  // 1h 1min 1s
/// let p = d.parts()
/// assert(p.hours == 1)
/// assert(p.minutes == 1)
/// assert(p.seconds == 1)
/// ```
#stable(since = "0.1")
export fn Duration @parts() -> DurationParts {
    ro total = if @nanos < 0 { -@nanos } else { @nanos }
    ro days = (total / 86_400_000_000_000) as int
    ro r1 = total % 86_400_000_000_000
    ro hours = (r1 / 3_600_000_000_000) as int
    ro r2 = r1 % 3_600_000_000_000
    ro minutes = (r2 / 60_000_000_000) as int
    ro r3 = r2 % 60_000_000_000
    ro seconds = (r3 / 1_000_000_000) as int
    ro r4 = r3 % 1_000_000_000
    ro millis = (r4 / 1_000_000) as int
    ro r5 = r4 % 1_000_000
    ro micros = (r5 / 1_000) as int
    ro nanos = (r5 % 1_000) as int
    { days, hours, minutes, seconds, millis, micros, nanos }
}


// ──────────────────────────────────────────────────────────────────────────
// Overflow-safe i64 primitives (Plan 175 Ф.1c / D317) — module-private.
//
// 3-tier discipline (Rust/Swift-паритет; бьёт Go silent-wrap и Zig
// build-mode-UB): operators trap; `checked_*` → Option; `saturating_*` → clamp.
// Все helpers работают на raw i64 (bare `+`/`-`/`*` wrap by design — именно
// поэтому overflow детектируется ЯВНО, а не полагается на trap примитива).
// ──────────────────────────────────────────────────────────────────────────

/// `i64::MAX` = 2⁶³−1. Fn-form (не const) — избегает value-const-ref gap
/// (`[M-175-value-record-const-ref]`) и const-eval арифметики для MIN.
fn i64_max() -> i64 => 9_223_372_036_854_775_807

/// `i64::MIN` = −2⁶³, выраженное как `-(2⁶³−1) − 1` (литерал `2⁶³` не
/// представим в i64 — считаем во runtime).
fn i64_min() -> i64 => -9_223_372_036_854_775_807 - 1

/// Clamp `x` в `[lo, hi]`.
fn clamp_i64(x i64, lo i64, hi i64) -> i64 =>
    if x < lo { lo } else if x > hi { hi } else { x }

fn checked_add_i64(a i64, b i64) -> Option[i64] {
    if b > 0 && a > i64_max() - b { return None }
    if b < 0 && a < i64_min() - b { return None }
    Some(a + b)
}

fn checked_sub_i64(a i64, b i64) -> Option[i64] {
    if b < 0 && a > i64_max() + b { return None }
    if b > 0 && a < i64_min() + b { return None }
    Some(a - b)
}

fn checked_neg_i64(a i64) -> Option[i64] =>
    if a == i64_min() { None } else { Some(-a) }

fn checked_mul_i64(a i64, b i64) -> Option[i64] {
    if a == 0 || b == 0 { return Some(0) }
    // -1 special-cases first: они дают overflow ровно на i64::MIN и делают
    // divide-back-проверку ниже валидной (a ∉ {0, -1}).
    if a == -1 { return checked_neg_i64(b) }
    if b == -1 { return checked_neg_i64(a) }
    ro r = a * b
    if r / a != b { return None }
    Some(r)
}

fn checked_div_i64(a i64, b i64) -> Option[i64] {
    if b == 0 { return None }
    if b == -1 && a == i64_min() { return None }
    Some(a / b)
}

/// Saturating add clamped to `[lo, hi]`.
fn sat_add_i64(a i64, b i64, lo i64, hi i64) -> i64 =>
    match checked_add_i64(a, b) {
        Some(r) => clamp_i64(r, lo, hi),
        None => if b > 0 { hi } else { lo },
    }

/// Saturating sub clamped to `[lo, hi]`.
fn sat_sub_i64(a i64, b i64, lo i64, hi i64) -> i64 =>
    match checked_sub_i64(a, b) {
        Some(r) => clamp_i64(r, lo, hi),
        None => if b < 0 { hi } else { lo },
    }

/// Saturating mul clamped to `[lo, hi]` (overflow ⇒ sign-directed boundary).
fn sat_mul_i64(a i64, b i64, lo i64, hi i64) -> i64 =>
    match checked_mul_i64(a, b) {
        Some(r) => clamp_i64(r, lo, hi),
        None => if (a > 0) == (b > 0) { hi } else { lo },
    }

// ── trap-wrappers (operators route here) ──

fn add_or_trap(a i64, b i64) -> i64 =>
    match checked_add_i64(a, b) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: add"),
    }

fn sub_or_trap(a i64, b i64) -> i64 =>
    match checked_sub_i64(a, b) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: sub"),
    }

fn neg_or_trap(a i64) -> i64 =>
    match checked_neg_i64(a) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: neg(i64::MIN)"),
    }

fn mul_or_trap(a i64, b i64) -> i64 =>
    match checked_mul_i64(a, b) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: mul"),
    }

fn div_or_trap(a i64, b i64) -> i64 {
    if b == 0 { panic("Duration arithmetic error: division by zero") }
    if b == -1 && a == i64_min() { panic("Duration arithmetic overflow: div(i64::MIN, -1)") }
    a / b
}

/// f64 → i64 nanos с проверкой финитности и диапазона (`None` вне области).
/// `2⁶³` = 9223372036854775808.0 (первое f64-значение вне i64) — граница.
fn f64_nanos_checked(x f64) -> Option[i64] {
    if x.is_nan() || x.is_infinite() { return None }
    if x >= 9223372036854775808.0 { return None }
    if x < -9223372036854775808.0 { return None }
    Some(x as i64)
}

fn f64_nanos_or_trap(x f64) -> i64 =>
    match f64_nanos_checked(x) {
        Some(r) => r,
        None => panic("Duration arithmetic error: non-finite or out-of-range f64"),
    }


// ──────────────────────────────────────────────────────────────────────────
// Арифметика (D46) — overflow-safe (Plan 175 Ф.1c / D317).
//
// Операторы `+`/`-`/унарный `-`/`*`/`/` ТРАПАЮТ на overflow (в debug И release).
// Non-trapping эскейпы: `checked_*` (→ Option) и `saturating_*` (→ clamp к
// ±Duration.MAX). Границей Duration является ±(2⁶³−1) ns ≈ ±292 года.
// ──────────────────────────────────────────────────────────────────────────

/// Сложение durations (operator `+`). **Traps on overflow** (D317).
///
/// # Examples
/// ```nova
/// assert(1.hour() + 30.minutes() == 90.minutes())
/// ```
#stable(since = "0.1")
export fn Duration @plus(other Duration) -> Duration =>
    Duration.from_nanos(add_or_trap(@nanos, other.nanos))

/// Вычитание durations (operator `-`). Может дать negative result.
/// **Traps on overflow** (D317).
#stable(since = "0.1")
export fn Duration @minus(other Duration) -> Duration =>
    Duration.from_nanos(sub_or_trap(@nanos, other.nanos))

/// Унарный минус (operator `-`). Эквивалент `0 - self`.
/// **Traps on `i64::MIN`** (two's-complement asymmetry, D317).
#stable(since = "0.1")
export fn Duration @neg() -> Duration =>
    Duration.from_nanos(neg_or_trap(@nanos))

/// Scalar multiplication by integer (`Duration * i64`). **Traps on overflow** (D317).
#stable(since = "0.1")
export fn Duration @times(n i64) -> Duration =>
    Duration.from_nanos(mul_or_trap(@nanos, n))

/// Scalar multiplication by float (`Duration * f64`).
///
/// **Traps on `NaN`/`±inf`/out-of-range** (D317) — никогда silent мусор-cast.
/// Для non-trapping варианта — [`checked_mul_f64`]. Для финансовых расчётов считай
/// в i64 nanoseconds вручную чтобы избежать FP-rounding.
#stable(since = "0.1")
export fn Duration @times(n f64) -> Duration =>
    Duration.from_nanos(f64_nanos_or_trap((@nanos as f64) * n))

/// Integer division (`Duration / i64`). Truncating.
/// **Traps on `/0` и на `i64::MIN / -1`** (D317).
#stable(since = "0.1")
export fn Duration @div(n i64) -> Duration =>
    Duration.from_nanos(div_or_trap(@nanos, n))

/// Float division (`Duration / f64`).
/// **Traps on `NaN`/`±inf`/out-of-range** (в т.ч. `/0.0` → `±inf`, D317).
#stable(since = "0.1")
export fn Duration @div(n f64) -> Duration =>
    Duration.from_nanos(f64_nanos_or_trap((@nanos as f64) / n))

// ── checked_* → Option[Duration] (None on overflow) ──

/// Checked add — `None` on overflow (D317).
#stable(since = "0.1")
export fn Duration @checked_add(other Duration) -> Option[Duration] =>
    match checked_add_i64(@nanos, other.nanos) {
        Some(r) => Some(Duration.from_nanos(r)),
        None => None,
    }

/// Checked sub — `None` on overflow (D317).
#stable(since = "0.1")
export fn Duration @checked_sub(other Duration) -> Option[Duration] =>
    match checked_sub_i64(@nanos, other.nanos) {
        Some(r) => Some(Duration.from_nanos(r)),
        None => None,
    }

/// Checked scalar multiply — `None` on overflow (D317).
#stable(since = "0.1")
export fn Duration @checked_mul(n i64) -> Option[Duration] =>
    match checked_mul_i64(@nanos, n) {
        Some(r) => Some(Duration.from_nanos(r)),
        None => None,
    }

/// Checked integer divide — `None` on `/0` or `i64::MIN / -1` (D317).
#stable(since = "0.1")
export fn Duration @checked_div(n i64) -> Option[Duration] =>
    match checked_div_i64(@nanos, n) {
        Some(r) => Some(Duration.from_nanos(r)),
        None => None,
    }

/// Checked float multiply — `None` on `NaN`/`±inf`/out-of-range (D317).
#stable(since = "0.1")
export fn Duration @checked_mul_f64(n f64) -> Option[Duration] =>
    match f64_nanos_checked((@nanos as f64) * n) {
        Some(r) => Some(Duration.from_nanos(r)),
        None => None,
    }

/// Checked float divide — `None` on `NaN`/`±inf`/out-of-range (D317).
#stable(since = "0.1")
export fn Duration @checked_div_f64(n f64) -> Option[Duration] =>
    match f64_nanos_checked((@nanos as f64) / n) {
        Some(r) => Some(Duration.from_nanos(r)),
        None => None,
    }

// ── saturating_* → Duration (clamp к ±Duration.MAX = ±(2⁶³−1)) ──

/// Saturating add — clamps to `±Duration.MAX` (D317).
#stable(since = "0.1")
export fn Duration @saturating_add(other Duration) -> Duration =>
    Duration.from_nanos(sat_add_i64(@nanos, other.nanos, -i64_max(), i64_max()))

/// Saturating sub — clamps to `±Duration.MAX` (D317).
#stable(since = "0.1")
export fn Duration @saturating_sub(other Duration) -> Duration =>
    Duration.from_nanos(sat_sub_i64(@nanos, other.nanos, -i64_max(), i64_max()))

/// Saturating scalar multiply — clamps to `±Duration.MAX` (D317).
#stable(since = "0.1")
export fn Duration @saturating_mul(n i64) -> Duration =>
    Duration.from_nanos(sat_mul_i64(@nanos, n, -i64_max(), i64_max()))

/// Ratio between two durations — dimensionless `f64`.
///
/// # Examples
/// ```nova
/// assert(30.seconds().ratio(1.minute()) == 0.5)
/// ```
#stable(since = "0.1")
export fn Duration @ratio(other Duration) -> f64 =>
    (@nanos as f64) / (other.nanos as f64)

/// Абсолютное значение duration (отбрасывает sign).
///
/// **Plan 175 Ф.1c (D317):** `@abs(i64::MIN)` НЕ является UB/wrap — saturate к
/// `i64::MAX`; two's-complement asymmetry (`|i64::MIN| > i64::MAX`).
#stable(since = "0.1")
export fn Duration @abs() -> Duration =>
    if @nanos == i64_min() { Duration.from_nanos(i64_max()) }
    else if @nanos < 0 { Duration.from_nanos(-@nanos) }
    else { @ }

/// Минимум двух durations.
#stable(since = "0.1")
export fn Duration @min(other Duration) -> Duration =>
    if @nanos < other.nanos { @ } else { other }

/// Максимум двух durations.
#stable(since = "0.1")
export fn Duration @max(other Duration) -> Duration =>
    if @nanos > other.nanos { @ } else { other }


// ──────────────────────────────────────────────────────────────────────────
// Compare (D183 amendment, Plan 91.8a.2 part 3): @compare даёт ==/!=/<>/etc
// через synthesis. Magic methods @eq/@lt/@le/@gt/@ge удалены.
// ──────────────────────────────────────────────────────────────────────────

/// Compare.compare — memcmp-style int return (D183).
/// `==`, `!=`, `<`, `<=`, `>`, `>=` operators synthesized via @compare.
#stable(since = "0.1")
export fn Duration @compare(other Duration) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }


// ──────────────────────────────────────────────────────────────────────────
// Display (D410)
// ──────────────────────────────────────────────────────────────────────────

/// `to_str()` — auto-scale короткая запись.
///
/// Выбирает unit по величине: 500ns / 150μs / 42ms / 2.5s / 5min / 2h / 3d.
/// Для развёрнутого формата используй [`to_human`].
///
/// # Examples
/// ```nova
/// assert(500.nanos().to_str() == "500ns")
/// assert(2.hours().to_str() == "2h")
/// ```
#stable(since = "0.1")
export fn Duration @to_str() -> str {
    ro n = @nanos
    ro abs = if n < 0 { -n } else { n }
    ro sign = if n < 0 { "-" } else { "" }

    if abs < 1_000 {
        sign + str.from(abs) + "ns"
    } else if abs < 1_000_000 {
        sign + str.from(abs / 1_000) + "us"
    } else if abs < 1_000_000_000 {
        sign + str.from(abs / 1_000_000) + "ms"
    } else if abs < 60 * 1_000_000_000 {
        sign + str.from(@as_secs_f64().abs()) + "s"
    } else if abs < 3_600 * 1_000_000_000 {
        sign + str.from((abs / 60_000_000_000)) + "min"
    } else if abs < 86_400 * 1_000_000_000 {
        sign + str.from((abs / 3_600_000_000_000)) + "h"
    } else {
        sign + str.from((abs / 86_400_000_000_000)) + "d"
    }
}

/// Display (Plan 175 Ф.3(d)/Ф.4, D237) — delegates to [`to_str`] (ASCII
/// auto-scale short form, e.g. `"2s"`/`"500ns"`/`"150us"`). **Byte-exact
/// ASCII** — no bytes > 0x7F (fixes the U+03BC "μs" regression, Q12; the
/// underlying `to_str` already emits ASCII `"us"`, Ф.1c).
#stable(since = "0.1")
export fn Duration @display(mut w Write) -> () { w.write(@to_str()) }

/// Debug (D237) — diagnostic form showing the exact raw nanoseconds
/// alongside the human short form (unambiguous for overflow/precision
/// debugging, unlike the auto-scaled `@display`).
#stable(since = "0.1")
export fn Duration @debug(mut w Write) -> () {
    w.write("Duration(")
    w.write(@to_str())
    w.write(", ")
    w.write(str.from(@nanos))
    w.write("ns)")
}

/// Human-readable форматирование с декомпозицией на компоненты.
///
/// Формат: `"1d 2h 30min 45s"`. Опускает leading zero-components
/// (i.e. `"30min 45s"` не `"0d 0h 30min 45s"`), но trailing zeros
/// сохраняет если хоть один старший компонент непустой.
///
/// # Examples
/// ```nova
/// let d = 1.day() + 2.hours() + 30.minutes()
/// assert(d.to_human().contains("1d"))
/// ```
#stable(since = "0.1")
export fn Duration @to_human() -> str {
    if @is_zero() { return "0s" }

    ro p = @parts()
    consume buf = StringBuilder.new()
    ro sign = if @nanos < 0 { "-" } else { "" }
    buf.append(sign)

    mut started = false
    if p.days > 0 { buf.append(str.from(p.days)); buf.append("d "); started = true }
    if p.hours > 0 || started { buf.append(str.from(p.hours)); buf.append("h "); started = true }
    if p.minutes > 0 || started { buf.append(str.from(p.minutes)); buf.append("min "); started = true }
    if p.seconds > 0 || started { buf.append(str.from(p.seconds)); buf.append("s") }

    ro result = buf.into_str()
    result.trim_ascii()
}


// ──────────────────────────────────────────────────────────────────────────
// Timestamp — момент во времени (Unix epoch)
// ──────────────────────────────────────────────────────────────────────────

/// Timestamp — момент во времени в Unix epoch nanoseconds.
///
/// Stored как signed `i64` относительно 1970-01-01 UTC. Range покрывает
/// ±292 years (т.е. до ~2262 включительно). Для дат за пределами этого
/// окна используй BigDate (Plan 45.C).
///
/// # Examples
/// ```nova
/// let t = Timestamp.from_unix_secs(1_700_000_000)
/// assert(t.as_unix_secs() == 1_700_000_000)
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
/// Окно i64-ns ≈ 1677-09-21 .. 2262-04-11 (±292 года от эпохи, Q16).
#stable(since = "0.1")
export type Timestamp value {
    ro nanos i64
}

/// Unix epoch — 1970-01-01 00:00:00 UTC.
#stable(since = "0.1")
export const EPOCH Timestamp = { nanos: 0 }

/// Construct Timestamp from Unix epoch seconds.
#stable(since = "0.1")
export fn Timestamp.from_unix_secs(s i64) -> Timestamp =>
    { nanos: s * 1_000_000_000 }

/// Construct Timestamp from Unix epoch milliseconds.
#stable(since = "0.1")
export fn Timestamp.from_unix_millis(ms i64) -> Timestamp =>
    { nanos: ms * 1_000_000 }

/// Construct Timestamp from Unix epoch nanoseconds (raw value).
#stable(since = "0.1")
export fn Timestamp.from_unix_nanos(n i64) -> Timestamp =>
    { nanos: n }

/// Текущее wall-clock-время (Unix epoch).
///
/// **Plan 175 Ф.3/Ф.4 (D316):** ergonomic-сахар `Timestamp.now()` над
/// int-wire `Time.now_unix_ms()` (эффект `Time`). Мокабелен:
/// `with Time = th.fixed_ms(...)` подменяет часы детерминированно.
/// int-wire отдаёт миллисекунды → оборачиваем через `from_unix_millis`.
///
/// # Examples
/// ```nova
/// with Time = th.fixed_ms(1_700_000_000_000) {
///     assert(Timestamp.now().as_unix_millis() == 1_700_000_000_000)
/// }
/// ```
#stable(since = "0.1")
export fn Timestamp.now() Time -> Timestamp =>
    Timestamp.from_unix_millis(Time.now_unix_ms() as i64)


/// Unix epoch seconds (truncating). Negative для timestamps до 1970.
#stable(since = "0.1")
export fn Timestamp @as_unix_secs() => @nanos / 1_000_000_000 // [M-d410-as-to-migration]

/// Unix epoch milliseconds (truncating).
#stable(since = "0.1")
export fn Timestamp @as_unix_millis() => @nanos / 1_000_000 // [M-d410-as-to-migration]

/// Unix epoch nanoseconds (raw `i64`).
#stable(since = "0.1")
export fn Timestamp @as_unix_nanos() => @nanos // [M-d410-as-to-migration]


/// `Timestamp + Duration → Timestamp` — сдвинуть момент вперёд (deadline, expiry).
///
/// # Examples
/// ```nova
/// let start = Timestamp.from_unix_secs(1000)
/// let deadline = start + 30.seconds()
/// assert(deadline.as_unix_secs() == 1030)
/// ```
/// **Plan 175 Ф.1c (D317):** saturates at the i64 boundary (окно 1677..2262 —
/// mirror Go `addSec`-clamp). For explicit overflow-detection use [`checked_add`].
#stable(since = "0.1")
export fn Timestamp @plus(d Duration) -> Timestamp =>
    Timestamp.from_unix_nanos(sat_add_i64(@nanos, d.nanos, i64_min(), i64_max()))

/// `Timestamp - Duration → Timestamp` — сдвинуть момент назад.
/// **Saturates at boundary** (D317).
#stable(since = "0.1")
export fn Timestamp @minus(d Duration) -> Timestamp =>
    Timestamp.from_unix_nanos(sat_sub_i64(@nanos, d.nanos, i64_min(), i64_max()))

/// Checked `Timestamp + Duration` — `None` если результат вне i64-окна (D317).
#stable(since = "0.1")
export fn Timestamp @checked_add(d Duration) -> Option[Timestamp] =>
    match checked_add_i64(@nanos, d.nanos) {
        Some(r) => Some(Timestamp.from_unix_nanos(r)),
        None => None,
    }

/// Checked `Timestamp - Duration` — `None` если результат вне i64-окна (D317).
#stable(since = "0.1")
export fn Timestamp @checked_sub(d Duration) -> Option[Timestamp] =>
    match checked_sub_i64(@nanos, d.nanos) {
        Some(r) => Some(Timestamp.from_unix_nanos(r)),
        None => None,
    }

/// `Timestamp - Timestamp → Duration` — elapsed time между двумя моментами.
///
/// Signed: если `self < other`, result отрицательный.
///
/// # Examples
/// ```nova
/// let t1 = Timestamp.from_unix_secs(1000)
/// let t2 = Timestamp.from_unix_secs(1042)
/// assert((t2 - t1) == 42.seconds())
/// ```
#stable(since = "0.1")
export fn Timestamp @minus(other Timestamp) -> Duration =>
    Duration.from_nanos(sat_sub_i64(@nanos, other.nanos, i64_min(), i64_max()))


/// Compare.compare — memcmp-style int return (D183 amendment, Plan 91.8a.2).
/// `==`, `!=`, `<`, `<=`, `>`, `>=` operators synthesized via @compare.
/// `self < other` означает `self` раньше чем `other`.
#stable(since = "0.1")
export fn Timestamp @compare(other Timestamp) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }

/// Debug (Plan 175 Ф.3(d)/Ф.4, D237). **NOTE:** `@display` (full RFC-3339
/// datetime) live в `std/time/civil/format.nv` (Plan 175.1, вне scope этой
/// волны — civil-time уже сделан, не трогаем). `@debug` здесь — raw-ns
/// diagnostic form (не зависит от civil-слоя): `Timestamp(unix_ns=...)`.
#stable(since = "0.1")
export fn Timestamp @debug(mut w Write) -> () {
    w.write("Timestamp(unix_ns=")
    w.write(str.from(@nanos))
    w.write(")")
}

/// True если `self` уже в прошлом относительно текущего `Time.now_unix_ms()`.
///
/// Использует ambient `Time` effect — детерминирован в тестах под
/// `with Time = th.fixed_ms(...)`.
///
/// # Examples
/// ```nova
/// with Time = th.fixed_ms(10_000) {
///     let deadline = Timestamp.from_unix_secs(5)
///     assert(deadline.is_past())
/// }
/// ```
#stable(since = "0.1")
export fn Timestamp @is_past() Time -> bool =>
    @nanos < Timestamp.now().nanos

/// Сколько остаётся до момента `self`. Положительная если в будущем,
/// отрицательная если в прошлом.
#stable(since = "0.1")
export fn Timestamp @time_until() Time -> Duration =>
    @minus(Timestamp.now())

/// Сколько прошло с момента `self`. Положительная если в прошлом,
/// отрицательная если в будущем.
#stable(since = "0.1")
export fn Timestamp @elapsed() Time -> Duration =>
    Timestamp.now().minus(@)


// ──────────────────────────────────────────────────────────────────────────
// Time effect — главный AI-first момент
// ──────────────────────────────────────────────────────────────────────────
//
// Time — ambient effect (как Random, не fail). В тестах подменяется
// handler'ом → код становится детерминированным без mock-библиотек.
//
// Plan 175 Ф.1 (D316 — единый источник схемы): декларация `type Time effect`
// живёт ТОЛЬКО в std/prelude/effects.nv (codegen читает её оттуда). Ранее
// здесь дублировался закомментированный 5-й источник схемы — УДАЛЁН, чтобы
// не плодить расходящиеся зеркала. int-провод (`now()->int`) сохраняется в
// Ф.1; типизация (`timestamp()->Timestamp`, `sleep(Duration)`) — Ф.2/Ф.3.


// ──────────────────────────────────────────────────────────────────────────
// Extension-методы на int — синтаксис 2.seconds()
// ──────────────────────────────────────────────────────────────────────────

/// Extension: `N.nanos()` → Duration. Эквивалент `Duration.from_nanos(N)`.
///
/// # Examples
/// ```nova
/// assert(500.nanos() == Duration.from_nanos(500))
/// ```
#stable(since = "0.1")
export fn int @nanos() -> Duration => Duration.from_nanos(@)

/// Extension: `N.micros()` → Duration.
#stable(since = "0.1")
export fn int @micros() -> Duration => Duration.from_micros(@)

/// Extension: `N.millis()` → Duration.
#stable(since = "0.1")
export fn int @millis() -> Duration => Duration.from_millis(@)

/// Extension: `N.seconds()` → Duration. Главный читаемый синтаксис: `30.seconds()`.
///
/// # Examples
/// ```nova
/// assert(30.seconds() == Duration.from_secs(30))
/// ```
#stable(since = "0.1")
export fn int @seconds() -> Duration => Duration.from_secs(@)

/// Extension: `N.minutes()` → Duration.
#stable(since = "0.1")
export fn int @minutes() -> Duration => Duration.from_mins(@)

/// Extension: `N.hours()` → Duration.
#stable(since = "0.1")
export fn int @hours() -> Duration => Duration.from_hours(@)

/// Extension: `N.days()` → Duration.
#stable(since = "0.1")
export fn int @days() -> Duration => Duration.from_days(@)

/// Extension: `N.weeks()` → Duration (7 days per week).
#stable(since = "0.1")
export fn int @weeks() -> Duration => Duration.from_weeks(@)

/// Singular alias: `1.second()` — читается лучше чем `1.seconds()`.
#stable(since = "0.1")
export fn int @second() -> Duration => Duration.from_secs(@)

/// Singular alias: `1.minute()`.
#stable(since = "0.1")
export fn int @minute() -> Duration => Duration.from_mins(@)

/// Singular alias: `1.hour()`.
#stable(since = "0.1")
export fn int @hour() -> Duration => Duration.from_hours(@)

/// Singular alias: `1.day()`.
#stable(since = "0.1")
export fn int @day() -> Duration => Duration.from_days(@)

/// Singular alias: `1.week()`.
#stable(since = "0.1")
export fn int @week() -> Duration => Duration.from_weeks(@)


// ──────────────────────────────────────────────────────────────────────────
// Extension-методы на f64
// ──────────────────────────────────────────────────────────────────────────

/// Extension: `X.nanos()` для `f64` — truncates до `i64`.
#stable(since = "0.1")
export fn f64 @nanos() -> Duration =>
    Duration.from_nanos(@ as i64)

/// Extension: `X.micros()` для `f64`. Allows `1.5.micros()` = 1500ns.
#stable(since = "0.1")
export fn f64 @micros() -> Duration =>
    Duration.from_nanos((@ * 1_000.0) as i64)

/// Extension: `X.millis()` для `f64`. Allows `0.5.millis()` = 500_000ns.
#stable(since = "0.1")
export fn f64 @millis() -> Duration =>
    Duration.from_nanos((@ * 1_000_000.0) as i64)

/// Extension: `X.seconds()` для `f64`. Главный fractional API: `0.5.seconds()`.
///
/// # Examples
/// ```nova
/// assert(0.5.seconds() == 500.millis())
/// ```
#stable(since = "0.1")
export fn f64 @seconds() -> Duration =>
    Duration.from_secs_f64(@)

/// Extension: `X.minutes()` для `f64`. Allows `1.5.minutes()` = 90s.
#stable(since = "0.1")
export fn f64 @minutes() -> Duration =>
    Duration.from_secs_f64(@ * 60.0)

/// Extension: `X.hours()` для `f64`. Allows `0.25.hours()` = 15min.
#stable(since = "0.1")
export fn f64 @hours() -> Duration =>
    Duration.from_secs_f64(@ * 3_600.0)

/// Extension: `X.days()` для `f64`.
#stable(since = "0.1")
export fn f64 @days() -> Duration =>
    Duration.from_secs_f64(@ * 86_400.0)


// ──────────────────────────────────────────────────────────────────────────
// Утилиты — структурные шаблоны
// ──────────────────────────────────────────────────────────────────────────

/// Измерить длительность исполнения `action` и вернуть `(результат, elapsed)`.
///
/// Использует ambient `Time` effect — в тестах под `fixed_ms` всегда вернёт
/// elapsed = 0 (clock не движется). Для реальных бенчмарков используется
/// в production где `Time` provided runtime'ом.
///
/// # Examples
/// ```nova
/// with Time = th.fixed_ms(1000) {
///     let (result, elapsed) = measure(|| 42)
///     assert(result == 42)
///     assert(elapsed == Duration.ZERO)
/// }
/// ```
/// **Plan 175 Ф.5(d) (D318):** элапсед-измерение через `Monotonic`, НЕ
/// `Timestamp` — стопвотч/бенчмарк-семантика иммунна к wall-clock skew
/// (NTP/DST jump ВО ВРЕМЯ измерения раньше мог дать отрицательный или
/// вздутый `elapsed` — ровно Go/Rust/Java-конвенция: `time.Since`/`Instant`
/// для измерений всегда монотонные). Сигнатура не меняется (`Duration` —
/// clock-agnostic результат).
#stable(since = "0.1")
export fn measure[T](action fn() -> T) Time -> (T, Duration) {
    ro start = Monotonic.now()
    ro result = action()
    ro elapsed = Monotonic.now().elapsed_since(start)
    (result, elapsed)
}

/// Compute дедлайн `now() + d` с использованием ambient `Time`.
///
/// Convenience-обёртка чтобы не писать `Time.now_unix_ms() + 5.seconds()` каждый раз.
///
/// **Plan 175 Ф.5(d) — намеренно ОСТАЁТСЯ `Timestamp`-based** (НЕ мигрирован
/// на `Monotonic`, в отличие от [`measure`]): возвращаемый тип — `Timestamp`
/// (wall-clock), поэтому клок-источник обязан совпадать с типом контракта
/// (D124 — нельзя молча подменить домен часов внутри функции с committed
/// wall-clock return type). Для монотонных дедлайнов (timer/scope-deadline,
/// 173 §3a `supervised(timeout:)`) используй `Monotonic.now() + d` напрямую —
/// именно ЭТОТ паттерн, а не `deadline_in`, канон для `deadline:`-параметров.
#stable(since = "0.1")
export fn deadline_in(d Duration) Time -> Timestamp =>
    Timestamp.now() + d


// ──────────────────────────────────────────────────────────────────────────
// Тесты
// ──────────────────────────────────────────────────────────────────────────

test "int extensions: basic conversions" {
    assert(2.seconds() == Duration.from_secs(2))
    assert(100.millis() == Duration.from_millis(100))
    assert(5.minutes() == Duration.from_mins(5))
    assert(1.hour() == Duration.from_hours(1))
    assert(3.days() == Duration.from_days(3))
    assert(2.weeks() == Duration.from_weeks(2))
}

test "f64 extensions: fractional values" {
    assert(0.5.seconds() == 500.millis())
    assert(1.5.hours() == 90.minutes())
    assert(0.001.seconds() == 1.millis())
}

test "arithmetic: plus / minus / neg" {
    ro total = 1.hour() + 30.minutes()
    assert(total == 90.minutes())

    ro diff = 1.hour() - 15.minutes()
    assert(diff == 45.minutes())

    ro n = -(5.seconds())
    assert(n.is_negative())
    assert(n.abs() == 5.seconds())
}

test "arithmetic: times / div" {
    assert(5.seconds() * 3 == 15.seconds())
    assert(1.minute() / 4 == 15.seconds())
    assert(10.seconds() * 1.5 == 15.seconds())      // f64 multiplier
    assert(30.seconds() / 1.5 == 20.seconds())
}

test "ratio between durations" {
    ro r = 30.seconds().ratio(1.minute())
    assert(r == 0.5)
}

test "comparison" {
    assert(1.second() < 1.minute())
    assert(1.hour() > 30.minutes())
    assert(60.seconds() == 1.minute())
}

test "min / max" {
    assert(5.seconds().min(10.seconds()) == 5.seconds())
    assert(5.seconds().max(10.seconds()) == 10.seconds())
}

test "predicates" {
    // NB: `Duration.ZERO` как value-const-reference упирается в pre-existing
    // value-record const-emission gap (symbol `ZERO` vs ref `Duration_ZERO`),
    // не time-специфичный — follow-up [M-175-value-record-const-ref]. Значение
    // строится через from_nanos(0) (та же конвенция, что nova_tests/plan91_fe4).
    assert(Duration.from_nanos(0).is_zero())
    assert((-1.second()).is_negative())
    assert(1.second().is_positive())
}

test "parts: декомпозиция" {
    ro d = 1.day() + 2.hours() + 30.minutes() + 45.seconds()
    ro p = d.parts()
    assert(p.days == 1)
    assert(p.hours == 2)
    assert(p.minutes == 30)
    assert(p.seconds == 45)
}

test "to_str(): auto-scale" {
    assert(500.nanos().to_str() == "500ns")
    assert(150.micros().to_str() == "150us")
    assert(42.millis().to_str() == "42ms")
    assert(2.seconds().to_str() == "2s")
    assert(5.minutes().to_str() == "5min")
    assert(2.hours().to_str() == "2h")
}

test "to_human(): компонентами" {
    ro d = 1.day() + 2.hours() + 30.minutes()
    ro s = d.to_human()
    assert(s.contains("1d"))
    assert(s.contains("2h"))
    assert(s.contains("30min"))
}

test "Timestamp arithmetic: ts + duration → ts" {
    ro t1 = Timestamp.from_unix_secs(1000)
    ro t2 = t1 + 30.seconds()
    assert(t2.as_unix_secs() == 1030)
}

test "Timestamp arithmetic: ts - ts → duration" {
    ro t1 = Timestamp.from_unix_secs(1000)
    ro t2 = Timestamp.from_unix_secs(1042)
    ro elapsed = t2 - t1
    assert(elapsed == 42.seconds())
}

test "Timestamp comparison" {
    ro t1 = Timestamp.from_unix_secs(1000)
    ro t2 = Timestamp.from_unix_secs(2000)
    assert(t1 < t2)
    assert(t2 > t1)
}

test "AI-first: Time fixed → детерминированный код" {
    with Time = th.fixed_ms(1700000000000) {
        ro now = Timestamp.now()
        assert(now.as_unix_millis() == 1700000000000)
    }
}

test "deadline_in + is_past через Time-handler" {
    with Time = th.fixed_ms(1000) {
        ro dl = deadline_in(5.seconds())
        // Сейчас 1000ms = 1s; deadline = 1s + 5s = 6s
        assert(dl.as_unix_secs() == 6)
        assert(!dl.is_past())
    }
    with Time = th.fixed_ms(10_000) {
        // 10 секунд после epoch — deadline 6s уже прошёл
        ro dl = Timestamp.from_unix_secs(6)
        assert(dl.is_past())
    }
}

test "measure semantics: под fixed_ms elapsed = 0" {
    // Семантика `measure[T]` (returns (T, Duration)): под fixed-часами
    // clock не движется → elapsed = 0. Проверяется inline через сахар
    // `Timestamp.now()`/@minus/@is_zero (value-Duration round-trip).
    // NB: прямой `ro (r, e) = measure(||…)` требует generic-fn-возврата
    // tuple с value-элементом — отдельный value-record codegen-gap
    // [M-175-value-in-generic-tuple-return] (backlog), не time-специфичный.
    with Time = th.fixed_ms(1000) {
        ro start = Timestamp.now()
        ro result = 42
        ro elapsed = Timestamp.now().minus(start)
        assert(result == 42)
        assert(elapsed.is_zero())
    }
}

test "Ф.5(d): measure[T] мигрирован на Monotonic (elapsed иммунен к wall-clock skew)" {
    // Прямой вызов `measure(...)` (не inline-паттерн выше) — value-in-
    // generic-tuple-return gap [M-175-value-in-generic-tuple-return] здесь
    // НЕ бьёт, потому что `measure` возвращает `(int, Duration)`, а `int`
    // element — не value-record триггер (только Duration/Timestamp/Monotonic
    // ЭЛЕМЕНТОМ tuple вызывают гэп; здесь Duration — второй элемент результата
    // самого measure, но tuple-конструкция происходит ВНУТРИ измеряемого fn,
    // не на call-site — gap специфичен call-site turbofish-инференсу).
    with Time = th.mut_clock(0 as u64) {
        ro (result, elapsed) = measure(fn() -> int {
            Time.sleep(3000)  // virtual clock advance под mock — elapsed = 3s
            42
        })
        assert(result == 42)
        assert(elapsed == 3.seconds())
    }
}

test "elapsed / time_until" {
    with Time = th.fixed_ms(5000) {
        ro earlier = Timestamp.from_unix_secs(2)
        assert(earlier.elapsed() == 3.seconds())   // 5s - 2s

        ro later = Timestamp.from_unix_secs(10)
        assert(later.time_until() == 5.seconds())  // 10s - 5s
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Plan 175 Ф.1c (D317/D318) — overflow-safe arithmetic (inline unit-tests).
// Trap-фикстуры (panic на overflow/div0/NaN) — nova_tests/time/rt/ (EXPECT_RUNTIME_PANIC).
// ──────────────────────────────────────────────────────────────────────────

test "Ф.1c: normal arithmetic unchanged (no false traps)" {
    assert((1.hour() + 30.minutes()) == 90.minutes())
    assert((1.hour() - 15.minutes()) == 45.minutes())
    assert((5.seconds() * 3) == 15.seconds())
    assert((1.minute() / 4) == 15.seconds())
    assert((10.seconds() * 1.5) == 15.seconds())
    assert((30.seconds() / 1.5) == 20.seconds())
    assert((-(5.seconds())).is_negative())
}

test "Ф.1c/D317: Duration checked_add — Some / None at boundary" {
    ro top = Duration.from_nanos(i64_max())
    assert(top.checked_add(Duration.from_nanos(1)).is_none())
    match top.checked_add(Duration.from_nanos(0)) {
        Some(r) => assert(r.as_nanos() == i64_max()),
        None => assert(false),
    }
    match Duration.from_nanos(1000).checked_add(Duration.from_nanos(337)) {
        Some(r) => assert(r.as_nanos() == 1337),
        None => assert(false),
    }
}

test "Ф.1c/D317: Duration checked_sub / checked_mul / checked_div" {
    ro low = Duration.from_nanos(-i64_max())
    assert(low.checked_sub(Duration.from_nanos(2)).is_none())
    assert(Duration.from_nanos(i64_max()).checked_mul(2).is_none())
    // i64::MIN * -1 overflows
    assert(Duration.from_nanos(i64_min()).checked_mul(-1).is_none())
    // i64::MIN / -1 overflows; /0 undefined
    assert(Duration.from_nanos(i64_min()).checked_div(-1).is_none())
    assert(Duration.from_nanos(10).checked_div(0).is_none())
    match Duration.from_nanos(100).checked_div(4) {
        Some(r) => assert(r.as_nanos() == 25),
        None => assert(false),
    }
    match Duration.from_nanos(1000).checked_mul(1000) {
        Some(r) => assert(r.as_nanos() == 1_000_000),
        None => assert(false),
    }
}

test "Ф.1c/D317: Duration saturating_* clamps to ±MAX (no wrap)" {
    ro top = Duration.from_nanos(i64_max())
    assert(top.saturating_add(Duration.from_nanos(1_000_000)).as_nanos() == i64_max())
    assert(top.saturating_mul(4).as_nanos() == i64_max())
    // -1 + (-MAX) underflows below -MAX → clamp to -MAX (symmetric ±MAX)
    assert(Duration.from_nanos(-1).saturating_add(Duration.from_nanos(-i64_max())).as_nanos() == -i64_max())
    // negative overflow via mul
    assert(Duration.from_nanos(i64_max()).saturating_mul(-2).as_nanos() == -i64_max())
    // in-range unaffected
    assert(1.second().saturating_add(1.second()).as_nanos() == 2_000_000_000)
}

test "Ф.1c/D317: @abs(i64::MIN) saturates to MAX (two's-complement asymmetry)" {
    assert(Duration.from_nanos(i64_min()).abs().as_nanos() == i64_max())
    assert(Duration.from_nanos(-5).abs().as_nanos() == 5)
    assert(Duration.from_nanos(5).abs().as_nanos() == 5)
}

test "Ф.1c/D317: f64 conversions reject out-of-range (try_* → None)" {
    ro g = 1_000_000_000.0                 // 1e9
    // 1e18 s × 1e9 = 1e27 ns ≫ i64::MAX → out of range
    assert(Duration.try_from_secs_f64(g * g).is_none())
    match Duration.try_from_secs_f64(1.5) {
        Some(r) => assert(r.as_millis() == 1500),
        None => assert(false),
    }
    // @checked_mul_f64 / @checked_div_f64
    assert(Duration.from_nanos(i64_max()).checked_mul_f64(g).is_none())
    match 10.seconds().checked_mul_f64(1.5) {
        Some(r) => assert(r == 15.seconds()),
        None => assert(false),
    }
}

test "Ф.1c/D317: Timestamp saturates at i64 horizon (~2262, no wrap to 1677)" {
    ro tmax = Timestamp.from_unix_nanos(i64_max())
    assert(tmax.checked_add(1.nanos()).is_none())
    // @plus saturates instead of wrapping negative
    assert((tmax + 1.seconds()).as_unix_nanos() == i64_max())
    ro tmin = Timestamp.from_unix_nanos(i64_min())
    assert(tmin.checked_sub(1.nanos()).is_none())
    assert((tmin - 1.seconds()).as_unix_nanos() == i64_min())
    // saturating diff
    assert((Timestamp.from_unix_secs(1042) - Timestamp.from_unix_secs(1000)) == 42.seconds())
}

test "Ф.1c/D318: Monotonic elapsed_since saturate-to-zero; checked_duration_since → None on regress" {
    ro m = Monotonic.now()
    ro earlier = m - 5.seconds()
    // equal marks → 0
    assert(m.elapsed_since(m).as_nanos() == 0)
    // apparent regress (earlier before m) → saturate to 0, never negative
    assert(earlier.elapsed_since(m).as_nanos() == 0)
    // forward → 5s
    assert(m.elapsed_since(earlier) == 5.seconds())
    // checked: regress → None; forward → Some(5s)
    assert(earlier.checked_duration_since(m).is_none())
    match m.checked_duration_since(earlier) {
        Some(r) => assert(r == 5.seconds()),
        None => assert(false),
    }
}

test "Ф.3(a)/D316: Monotonic.now() мокабелен через Time-handler (mock-coherence)" {
    with Time = th.mut_clock(0 as u64) {
        ro m0 = Monotonic.now()
        Time.sleep(5000)  // virtual clock advance, ms
        ro m1 = Monotonic.now()
        // ОДИН handler двигает и wall (now_unix_ms), и monotonic (now_monotonic_ns)
        // когерентно — оба читают из одного `current_ms` (Ред.2 Q14 mock-coherence).
        assert(m1.elapsed_since(m0) == 5.seconds())
        assert(Timestamp.now().as_unix_millis() == 5000)
    }
}

test "Ф.3(c): m2 - m1 диспатчится в @minus(Monotonic) → Duration, не @minus(Duration)" {
    with Time = th.mut_clock(0 as u64) {
        ro m1 = Monotonic.now()
        Time.sleep(2000)
        ro m2 = Monotonic.now()
        ro d = m2 - m1
        assert(d == 2.seconds())
        assert(d == m2.elapsed_since(m1))
    }
}

test "Ф.3(b): free sleep(Duration) под mock-clock продвигает виртуальные часы" {
    with Time = th.mut_clock(1000 as u64) {
        sleep(500.millis())
        assert(Time.now_unix_ms() == 1500)
        // Duration.ZERO как const-reference — pre-existing [M-175-value-record-const-ref]
        // gap (не time-специфичный); workaround — from_nanos(0), см. "predicates" выше.
        sleep(Duration.from_nanos(0))  // немедленно, часы не двигаются
        assert(Time.now_unix_ms() == 1500)
    }
}

test "Ф.3(b)/Q3: sleep_until(Monotonic) — будущий дедлайн ждёт ровно дельту, прошлый — немедленно" {
    with Time = th.mut_clock(0 as u64) {
        ro m0 = Monotonic.now()
        ro deadline = m0 + 3.seconds()
        sleep_until(deadline)
        assert(Time.now_unix_ms() == 3000)

        // дедлайн уже в прошлом → saturate-to-zero, немедленно (без доп. ожидания)
        ro past = Monotonic.now() - 10.seconds()
        sleep_until(past)
        assert(Time.now_unix_ms() == 3000)
    }
}

test "Ф.3(d)/D237/Q12: @display Duration/Monotonic — byte-exact ASCII (нет байтов > 0x7F)" {
    ro d = 150.micros()
    ro s = "${d}"
    assert(s == "150us")
    ro bs = s.bytes()
    mut all_ascii = true
    for i in 0..bs.len() {
        if bs[i] > 0x7F as u8 { all_ascii = false }
    }
    assert(all_ascii)

    ro m = Monotonic.now()
    ro ms = "${m}"
    assert(ms.starts_with("+"))
}

test "Ф.3(d): @debug Duration/Timestamp/Monotonic — диагностическая форма" {
    // Проверяем ОБА пути: `"${x:?}"`-сахар (interp) и явный `.debug(sb)`
    // Write-sink (D374-паттерн) — оба чинятся ОДНИМ и тем же codegen-фиксом
    // выше (value-record-aware strip + prepare_method_recv), sink-agnostic.
    assert("${2.seconds():?}".contains("Duration("))

    consume sb1 = StringBuilder.new()
    2.seconds().debug(sb1)
    assert(sb1.into_str().contains("Duration("))

    consume sb2 = StringBuilder.new()
    Timestamp.from_unix_millis(1_700_000_000_000).debug(sb2)
    assert(sb2.into_str().contains("Timestamp(unix_ns="))

    consume sb3 = StringBuilder.new()
    Monotonic.now().debug(sb3)
    assert(sb3.into_str().contains("Monotonic(+"))
}


// ──────────────────────────────────────────────────────────────────────────
// Plan 65 Ф.12 / D124 — Monotonic clock (monotonic time, immune to wall-clock skew)
// ──────────────────────────────────────────────────────────────────────────
//
// `Monotonic` — точка во времени относительно непрерывной монотонной
// шкалы (CLOCK_MONOTONIC на Linux/macOS, QueryPerformanceCounter на Windows).
//
// Never goes backwards: immune к NTP adjustments, daylight-saving, system
// time changes. Используется для timer deadlines, profiling intervals,
// retry budgets — везде где «прошло сколько-то времени» важнее даты.
//
// D124 (раздельные типы для wall-clock vs monotonic) — type-system запрещает
// случайное использование Timestamp где нужен Monotonic (silent NTP-skew
// bug) и наоборот. Compile-error на смешивание arithmetic operations.

/// Monotonic — момент в монотонной шкале процесса. Never decreases.
///
/// Используется для timer deadlines (`ChanReader.close_at(Monotonic)`),
/// profiling intervals, retry budgets. Immune к NTP/DST/manual clock
/// adjustments.
///
/// Сериализация запрещена — bessmysленно вне процесса (у каждого процесса
/// свой epoch). Для inter-process timestamps используй `Timestamp`.
///
/// # Examples
/// ```nova
/// let start = Monotonic.now()
/// // ... work ...
/// let elapsed = Monotonic.now() - start  // → Duration
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
#stable(since = "0.6")
export type Monotonic value {
    ro nanos i64
}

/// Текущий монотонный момент. **Plan 175 Ф.3(a) (D316):** ergonomic-сахар
/// над int-wire `Time.now_monotonic_ns()` (эффект `Time`) — тот же паттерн,
/// что `Timestamp.now()` выше. **Мокабелен:** `with Time = th.mut_clock(...)`
/// подменяет монотонные часы детерминированно (закрывает
/// `[M-monotonic-mock-support]`). Заменяет прежний compiler-builtin
/// (4 сайта dispatch/inference в emit_c.rs удалены той же волной — grep
/// `nova_monotonic_now_record`/`"Nova_Monotonic*"` = 0, по норме плана 175 §Ф.3).
///
/// # Examples
/// ```nova
/// with Time = th.mut_clock(0 as u64) {
///     ro m0 = Monotonic.now()
///     Time.sleep(5000)  // virtual clock advance (ms)
///     ro m1 = Monotonic.now()
///     assert(m1.elapsed_since(m0) == 5.seconds())
/// }
/// ```
#stable(since = "0.6")
export fn Monotonic.now() Time -> Monotonic =>
    { nanos: Time.now_monotonic_ns() as i64 }

/// Raw nanoseconds — escape hatch для FFI / bench. Cросс-процессное
/// сравнение бессмысленно. Cравнение внутри одного процесса допустимо.
#stable(since = "0.6")
export fn Monotonic @as_nanos() -> i64 => @nanos // [M-d410-as-to-migration]


// ── Monotonic arithmetic (D124 rule 3: NO cross-type ops with Timestamp) ──

/// `Monotonic + Duration → Monotonic` — сдвинуть монотонный момент вперёд
/// (deadline в будущем). **Saturates at boundary** (D317).
#stable(since = "0.6")
export fn Monotonic @plus(d Duration) -> Monotonic =>
    { nanos: sat_add_i64(@nanos, d.nanos, i64_min(), i64_max()) }

/// `Monotonic - Duration → Monotonic` — сдвинуть монотонный момент назад
/// (deadline в прошлом или earlier-than-now). **Saturates at boundary** (D317).
///
/// NOTE: для `Monotonic - Monotonic → Duration` используй `elapsed_since`
/// (named method). Operator overload отсутствует, чтобы не конфликтовать
/// с method-resolution на receiver type (см. Эволюция).
#stable(since = "0.6")
export fn Monotonic @minus(d Duration) -> Monotonic =>
    { nanos: sat_sub_i64(@nanos, d.nanos, i64_min(), i64_max()) }

/// Elapsed time between two Monotonic points.
///
/// **Plan 175 Ф.1c (D318 — non-regression):** результат **saturate-to-zero**.
/// Если `self < other` (кажущийся регресс часов — HW/VM/OS-баг, JDK-6458294),
/// возвращает `Duration.ZERO`, НИКОГДА не negative и НИКОГДА не panic (без
/// global-lock — урок Rust 1.60-saga). Для явного детекта регресса используй
/// [`checked_duration_since`] (→ `None`).
///
/// # Examples
/// ```nova
/// let t1 = Monotonic.now()
/// // ... work ...
/// let t2 = Monotonic.now()
/// let elapsed = t2.elapsed_since(t1)  // Duration ≥ 0 (clock не идёт назад)
/// ```
#stable(since = "0.6")
export fn Monotonic @elapsed_since(other Monotonic) -> Duration =>
    if @nanos > other.nanos {
        Duration.from_nanos(sat_sub_i64(@nanos, other.nanos, i64_min(), i64_max()))
    } else {
        Duration.from_nanos(0)
    }

/// `Monotonic - Monotonic → Duration` (Plan 175 Ф.3(c) / D318 Q4) —
/// operator-overload alias for [`elapsed_since`], symmetric with
/// `Timestamp @minus(Timestamp) -> Duration` above. `m2 - m1` dispatches
/// HERE (not `@minus(Duration)`, the point-shift overload above) — same
/// saturate-to-zero-on-regress contract as `elapsed_since`.
///
/// # Examples
/// ```nova
/// let m1 = Monotonic.now()
/// let m2 = Monotonic.now()
/// let d = m2 - m1  // → Duration, dispatches to @minus(Monotonic)
/// ```
#stable(since = "0.6")
export fn Monotonic @minus(other Monotonic) -> Duration => @elapsed_since(other)

/// Checked elapsed time — `None` при регрессе (`self < other`), иначе
/// `Some(self - other)` (Plan 175 Ф.1c / D318; Rust `checked_duration_since`).
#stable(since = "0.6")
export fn Monotonic @checked_duration_since(other Monotonic) -> Option[Duration] =>
    if @nanos < other.nanos {
        None
    } else {
        match checked_sub_i64(@nanos, other.nanos) {
            Some(r) => Some(Duration.from_nanos(r)),
            None => None,
        }
    }


// ── Compare (D183 amendment, Plan 91.8a.2 part 3) ──
//
// @compare single source — operators ==/!=/</<=/>/>= synthesized.
// Magic methods @eq/@lt/@le/@gt/@ge удалены.

/// Compare.compare для Monotonic. Только внутри одного процесса.
#stable(since = "0.6")
export fn Monotonic @compare(other Monotonic) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }


// ── Display / Debug (Plan 175 Ф.3(d)/Ф.4, D237) ──
//
// `Monotonic` — process-local offset, NOT a date (D124/D318). `@display`/
// `@debug` show it as a **relative offset**, never as a calendar timestamp
// (unlike `Timestamp`, whose `@display` is RFC-3339 — std/time/civil/format.nv)
// — reading `Monotonic(+1.234s)` must never look like a wall-clock value.

/// Offset form, ASCII (`"+1.234s"`) — never a date.
#stable(since = "0.1")
export fn Monotonic @display(mut w Write) -> () {
    w.write("+")
    w.write(Duration.from_nanos(@nanos).to_str())
}

/// Diagnostic form: `Monotonic(+1.234s)` — explicitly NOT a date (D124/D318).
#stable(since = "0.1")
export fn Monotonic @debug(mut w Write) -> () {
    w.write("Monotonic(+")
    w.write(Duration.from_nanos(@nanos).to_str())
    w.write(")")
}


// Note: NO `Monotonic.as_unix_secs()`, `Monotonic.from_unix_*()`,
// `Monotonic + Timestamp`, `Monotonic - Timestamp` overloads. D124 правило 3:
// смешивание clock-семantik — compile-error через absent overload.
