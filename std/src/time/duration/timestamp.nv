// stdlib/timestamp.nv — Timestamp: момент во времени (Unix epoch wall-clock).
//
// Вынесен из duration.nv в отдельный co-equal файл того же модуля
// `time.duration` (папка = один модуль; import-путь `std.time.duration`
// не меняется). `Duration` — в duration.nv, `Monotonic` — в monotonic.nv.

module time.duration

/// Timestamp — an instant in time in Unix epoch nanoseconds.
///
/// Stored as a signed `i64` relative to 1970-01-01 UTC. The range covers
/// ±292 years (i.e. up to ~2262 inclusive). For dates beyond this window use
/// BigDate (Plan 45.C).
///
/// # Examples
/// ```nova
/// let t = 1_700_000_000.to_unix_seconds()
/// assert(t.unix_seconds() == 1_700_000_000)
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
/// The i64-ns window ≈ 1677-09-21 .. 2262-04-11 (±292 years from the epoch, Q16).
///
/// `nanos` is `priv` (module-private) — was `ro` (publicly constructible
/// `{ nanos: ... }` from any module). Construct via `T.to_unix_seconds()`/
/// `to_unix_millis()`/`to_unix_nanos()` below (module-private access,
/// unaffected). `@unix_nanos()` accessor remains the public raw-value
/// escape hatch.
#stable(since = "0.1")
export type Timestamp value {
    priv nanos i64
}

/// Unix epoch — 1970-01-01 00:00:00 UTC.
#stable(since = "0.1")
export const EPOCH Timestamp = { nanos: 0 }

// `Timestamp.from_unix_*` retracted — единый `to_unix_*`-бланкет над `Ints`
// (зеркалит Duration `to_*` выше).

/// `T.to_unix_seconds()` — construct Timestamp from Unix epoch seconds.
#stable(since = "0.1")
export fn[T Ints] T @to_unix_seconds() -> Timestamp =>
    { nanos: (@ as i64) * 1_000_000_000 }

/// `T.to_unix_millis()` — construct Timestamp from Unix epoch milliseconds.
#stable(since = "0.1")
export fn[T Ints] T @to_unix_millis() -> Timestamp =>
    { nanos: (@ as i64) * 1_000_000 }

/// `T.to_unix_nanos()` — construct Timestamp from Unix epoch nanoseconds (raw value).
#stable(since = "0.1")
export fn[T Ints] T @to_unix_nanos() -> Timestamp =>
    { nanos: @ as i64 }

/// Current wall-clock time (Unix epoch).
///
/// **Plan 175 Ф.3 (D316 typed retype):** a thin ergonomic wrapper over the
/// typed `Time.now()` (the `Time` effect returns a `Timestamp` directly —
/// no more int-wire + wrap). Mockable:
/// `with Time = th.fixed_ms(...)` replaces the clock deterministically.
///
/// # Examples
/// ```nova
/// with Time = th.fixed_ms(1_700_000_000_000) {
///     assert(Timestamp.now().unix_millis() == 1_700_000_000_000)
/// }
/// ```
#stable(since = "0.1")
export fn Timestamp.now() Time -> Timestamp => Time.now()

/// Unix epoch seconds (truncating). Negative for timestamps before 1970.
#stable(since = "0.1")
export fn Timestamp @unix_seconds() => @nanos / 1_000_000_000

/// Unix epoch milliseconds (truncating).
#stable(since = "0.1")
export fn Timestamp @unix_millis() => @nanos / 1_000_000

/// Unix epoch nanoseconds (raw `i64`).
#stable(since = "0.1")
export fn Timestamp @unix_nanos() => @nanos

/// `Timestamp + Duration → Timestamp` — move the instant forward (deadline, expiry).
///
/// # Examples
/// ```nova
/// let start = 1000.to_unix_seconds()
/// let deadline = start + 30.to_seconds()
/// assert(deadline.unix_seconds() == 1030)
/// ```
/// **Plan 175 Ф.1c (D317):** saturates at the i64 boundary (window 1677..2262 —
/// mirror Go `addSec`-clamp). For explicit overflow-detection use [`checked_add`].
#stable(since = "0.1")
export fn Timestamp @plus(d Duration) -> Timestamp =>
    sat_add_i64(@nanos, d.nanos, i64.MIN, i64.MAX).to_unix_nanos()

/// `Timestamp - Duration → Timestamp` — move the instant backward.
/// **Saturates at boundary** (D317).
#stable(since = "0.1")
export fn Timestamp @minus(d Duration) -> Timestamp =>
    sat_sub_i64(@nanos, d.nanos, i64.MIN, i64.MAX).to_unix_nanos()

/// Checked `Timestamp + Duration` — `None` if the result is outside the i64 window (D317).
#stable(since = "0.1")
export fn Timestamp @checked_add(d Duration) -> Option[Timestamp] =>
    match @nanos.checked_add(d.nanos) {
        Some(r) => Some(r.to_unix_nanos())
        None => None
    }

/// Checked `Timestamp - Duration` — `None` if the result is outside the i64 window (D317).
#stable(since = "0.1")
export fn Timestamp @checked_sub(d Duration) -> Option[Timestamp] =>
    match @nanos.checked_sub(d.nanos) {
        Some(r) => Some(r.to_unix_nanos())
        None => None
    }

/// `Timestamp - Timestamp → Duration` — elapsed time between two instants.
///
/// Signed: if `self < other`, the result is negative.
///
/// # Examples
/// ```nova
/// let t1 = 1000.to_unix_seconds()
/// let t2 = 1042.to_unix_seconds()
/// assert((t2 - t1) == 42.to_seconds())
/// ```
#stable(since = "0.1")
export fn Timestamp @minus(other Timestamp) -> Duration =>
    sat_sub_i64(@nanos, other.nanos, i64.MIN, i64.MAX).to_nanos()

/// Compare.compare — memcmp-style int return.
/// `==`, `!=`, `<`, `<=`, `>`, `>=` operators synthesized via @compare.
/// `self < other` means `self` is earlier than `other`.
#stable(since = "0.1")
export fn Timestamp @compare(other Timestamp) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }

/// Debug (Plan 175 Ф.3(d)/Ф.4, D237). **NOTE:** `@display` (full RFC-3339
/// datetime) lives in `std/time/civil/format.nv` (Plan 175.1, out of the scope
/// of this wave — civil-time is already done, not touching it). `@debug` here —
/// a raw-ns diagnostic form (does not depend on the civil layer): `Timestamp(unix_ns=...)`.
/// Signature migrated to `Fmt` — Plan 208 Ф.2/D422,
/// [M-208-time-display-fmt-migration-gap].
#stable(since = "0.1")
export fn Timestamp @debug(mut f Fmt) -> () {
    f.write("Timestamp(unix_ns=")
    f.write(@nanos.to_str())
    f.write(")")
}

/// True if `self` is already in the past relative to the current `Time.now()`.
///
/// Uses the ambient `Time` effect — deterministic in tests under
/// `with Time = th.fixed_ms(...)`.
///
/// # Examples
/// ```nova
/// with Time = th.fixed_ms(10_000) {
///     let deadline = 5.to_unix_seconds()
///     assert(deadline.is_past())
/// }
/// ```
#stable(since = "0.1")
export fn Timestamp @is_past() Time -> bool =>
    @nanos < Timestamp.now().nanos

/// How long until the instant `self`. Positive if in the future,
/// negative if in the past.
#stable(since = "0.1")
export fn Timestamp @time_until() Time -> Duration =>
    @minus(Timestamp.now())

/// How much time has passed since the instant `self`. Positive if in the past,
/// negative if in the future.
#stable(since = "0.1")
export fn Timestamp @elapsed() Time -> Duration =>
    Timestamp.now().minus(@)
