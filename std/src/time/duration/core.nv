// stdlib/duration.nv — Duration + Time effect + shared overflow-safe helpers.
//
// Plan 200 Step 3 (Пункт 13, D78 co-equal folder-module): `Timestamp` живёт
// в timestamp.nv, `Monotonic` — в monotonic.nv (co-equal файлы ТОГО ЖЕ
// модуля `time.duration` — папка = один модуль, import-путь не меняется).
// Module-private overflow-safe хелперы (sat_add_i64/checked_neg_i64/
// f64_nanos_or_trap/и т.п.) остаются здесь — общие для всех трёх типов.
//
// Идея:
//   2.to_seconds()        → Duration { nanos: 2_000_000_000 }
//   100.to_millis()       → Duration { nanos: 100_000_000 }
//   1.5.to_seconds()      → Duration { nanos: 1_500_000_000 }
//   2.to_seconds() + 30.to_millis()
//   ts2 - ts1             → Duration (между двумя моментами)
//   ts + 30.to_seconds()  → Timestamp (deadline)
//
// Нет magic, нет implicit conversion — обычные методы на примитивах
// (D35: метод привязан к типу через `fn Type @method`).
//
// AI-first: Time effect позволяет в тестах подменить часы:
//   with Time = th.fixed_ms(1700000000000) { ... детерминированный код ... }

//! Plan 45 Ф.34.3 — Duration + Timestamp + Time effect.
//!
//! Time-related types: представление длительностей и моментов времени.
//! Sensible defaults: nanosecond precision, signed Duration (поддерживает
//! отрицательные интервалы), `Time` effect для дeterministic testing.
//!
//! # Examples
//!
//! ```nova
//! let d = 5.to_seconds()
//! assert(d.seconds() == 5)
//! assert(d.millis() == 5000)
//! ```

module time.duration

import std.testing.handlers as th

// `panic` (overflow-trap primitive, Plan 175 Ф.1c / D317) is an
// always-available compiler intrinsic ([panic-assert-intrinsic]
// 2026-07-11) — no redeclaration needed. Trap fires in debug AND release
// (never a build-mode-dependent UB — Zig-antipattern; never a silent wrap —
// Go-trap). See §3b/D317.

// ──────────────────────────────────────────────────────────────────────────
// Duration — длительность (signed, ±292 года)
// ──────────────────────────────────────────────────────────────────────────

/// Duration — signed time interval с nanosecond precision.
///
/// Range: ±292 years (i64::MAX nanoseconds). Used для timeouts, intervals,
/// delays. Constructed через `to_*` fluent methods on int/f64 (Plan 200
/// Step 2, D410/D317 amend) — one per unit: `T.to_seconds()`/`to_millis()`/etc.
///
/// # Examples
///
/// ```nova
/// let d = 500.to_millis()
/// assert(d.millis() == 500)
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
/// Single `i64 nanos` field → ABI-identical to a bare `int64_t` at the C
/// boundary (sync-timeouts / channel-deadlines extract `.nanos`).
#stable(since = "0.1")
export type Duration value {
    ro nanos i64
}

/// Zero duration — 0 nanoseconds. Useful как default / sentinel value.
#stable(since = "0.1")
export const ZERO Duration = { nanos: 0 }

/// One second.
#stable(since = "0.1")
export const SECOND Duration = { nanos: 1_000_000_000 }

/// One minute (60 seconds).
#stable(since = "0.1")
export const MINUTE Duration = { nanos: 60_000_000_000 }

/// One hour (3600 seconds).
#stable(since = "0.1")
export const HOUR   Duration = { nanos: 3_600_000_000_000 }

// Saturation boundaries are ±(2⁶³−1) ns ≈ ±292 years (symmetric; the
// two's-complement `i64::MIN` = -2⁶³ is deliberately excluded so `@neg`/`@abs`
// are total). The `saturating_*` methods clamp to these edges via the builtin
// `i64.MAX`/`i64.MIN` associated consts below.
//
// **Deferred:** public consts `Duration.MAX`/`Duration.MIN` (Plan 178 wants
// `@timeout(Duration.MAX)`) are NOT declared here yet — a user type-const named
// `MAX`/`MIN` currently shadows the builtin numeric `.MAX`/`.MIN` in type-set-
// bound generics (`fn[T Ints] f(x T) => x == T.MAX`, spec_tests d310), mis-
// typing `T.MAX` as the record and CC-FAILing. Fix lives in the checker's
// member-const resolution (172-zone, owner-gated). Follow-up
// `[M-175-type-const-max-shadows-builtin]` (docs/plans/backlog-followups.md).



// ──────────────────────────────────────────────────────────────────────────
// Конструкторы — Plan 200 Step 2 (D410/D317 amend, 2026-07-16, владелец):
// единый `to_*`-бланкет над `Ints` (i8..i64/u8..u64/int/uint) вместо
// retracted `Duration.from_*` static-методов + per-width bare-fluent
// (`int @seconds()` и т.п. — были ×8 почти-идентичных тел). Направление
// задаёт форму (§1а): getter (`Duration → i64`, выше) = голое имя;
// конструктор (`T → Duration`) = `to_*` (зеркалит Plan 206 `checked_*`-
// бланкеты). Приёмник `@` явно widen'ится в `i64` ДО арифметики — без этого
// `5i8.to_micros()` переполнил бы `i8` на `* 1_000` до приведения ширины.
// ──────────────────────────────────────────────────────────────────────────

/// `T.to_nanos()` — construct Duration from nanoseconds (any `Ints` width).
///
/// # Examples
/// ```nova
/// let d = 1_000_000.to_nanos()
/// assert(d.micros() == 1000)
/// ```
#stable(since = "0.1")
export fn[T Ints] T @to_nanos() -> Duration => { nanos: @ as i64 }

/// `T.to_micros()` — construct Duration from microseconds (1 μs = 1000 ns).
#stable(since = "0.1")
export fn[T Ints] T @to_micros() -> Duration => { nanos: (@ as i64) * 1_000 }

/// `T.to_millis()` — construct Duration from milliseconds (1 ms = 1_000_000 ns).
///
/// # Examples
/// ```nova
/// let d = 500.to_millis()
/// assert(d.millis() == 500)
/// ```
#stable(since = "0.1")
export fn[T Ints] T @to_millis() -> Duration => { nanos: (@ as i64) * 1_000_000 }

/// `T.to_seconds()` — construct Duration from seconds.
#stable(since = "0.1")
export fn[T Ints] T @to_seconds() -> Duration => { nanos: (@ as i64) * 1_000_000_000 }

/// `T.to_minutes()` — construct Duration from minutes (60 seconds per minute).
#stable(since = "0.1")
export fn[T Ints] T @to_minutes() -> Duration => { nanos: (@ as i64) * 60 * 1_000_000_000 }

/// `T.to_hours()` — construct Duration from hours (3600 seconds per hour).
#stable(since = "0.1")
export fn[T Ints] T @to_hours() -> Duration => { nanos: (@ as i64) * 3_600 * 1_000_000_000 }

/// `T.to_days()` — construct Duration from days (86400 seconds per day).
#stable(since = "0.1")
export fn[T Ints] T @to_days() -> Duration => { nanos: (@ as i64) * 86_400 * 1_000_000_000 }

/// `T.to_weeks()` — construct Duration from weeks (7 days per week).
#stable(since = "0.1")
export fn[T Ints] T @to_weeks() -> Duration => { nanos: (@ as i64) * 7 * 86_400 * 1_000_000_000 }

/// `f64.to_seconds()` — construct Duration from fractional seconds (e.g.
/// `0.5.to_seconds()` → 500ms). `f64 ∉ Ints` — concrete method, NOT part of
/// the blanket above; only seconds gets a float constructor (Plan 200 Step 2,
/// владелец 2026-07-15 — "Только секунды").
///
/// Useful для converting measurements (sensor data, sampling intervals)
/// которые natively f64.
///
/// **Plan 175 Ф.1c (D317):** traps on `NaN`/`±inf`/out-of-`i64`-range input
/// (Rust `Duration::from_secs_f64` panics; никогда silent мусор-cast). For a
/// non-trapping variant use [`checked_to_seconds`].
#stable(since = "0.1")
export fn f64 @to_seconds() -> Duration =>
    { nanos: f64_nanos_or_trap(@ * 1_000_000_000.0) }

// `Duration.try_from_secs_f64(s f64) -> Option[Duration]` (static ctor,
// Plan 175 Ф.1c/D317) RETRACTED (2026-07-17, lint-разкраснение, владелец:
// "мы убрали все Duration.from_*" — не exception к W_TRY_WITHOUT_SIBLING, а
// снос статики целиком). Заменена ресиверной формой ниже — `f64
// @checked_to_seconds()`, зеркалящая non-trapping half пары `@to_seconds()`/
// `@checked_to_seconds()` (тот же паттерн, что `@times(f64)`/`@checked_mul_f64`
// на Duration): конструктор строится НА ИСТОЧНИКЕ (`f64`), не статик-методом
// на цели (`Duration`) — канон §1а, тот же, что уже снёс `Duration.from_*`.

/// Non-trapping variant of [`to_seconds`] — `None` on `NaN`/`±inf`/out-of-
/// `i64`-range fractional seconds instead of a trap (Plan 175 Ф.1c/D317).
/// Receiver form on the source (`f64`), matching `@checked_mul_f64`/
/// `@checked_div_f64` on `Duration` — not a static constructor on the target.
#stable(since = "0.1")
export fn f64 @checked_to_seconds() -> Option[Duration] =>
    match f64_nanos_checked(@ * 1_000_000_000.0) {
        Some(n) => Some(n.to_nanos()),
        None => None,
    }


// ──────────────────────────────────────────────────────────────────────────
// Конверсия обратно в числа
// ──────────────────────────────────────────────────────────────────────────

/// Total duration in nanoseconds (raw underlying value).
#stable(since = "0.1")
export fn Duration @nanos() => @nanos
/// Total duration in microseconds (truncating division — sub-μs nanoseconds dropped).
#stable(since = "0.1")
export fn Duration @micros() => @nanos / 1_000
/// Total duration in milliseconds (truncating — sub-ms nanoseconds dropped).
///
/// # Examples
/// ```nova
/// assert(2.to_seconds().millis() == 2000)
/// ```
#stable(since = "0.1")
export fn Duration @millis() => @nanos / 1_000_000
/// Total duration in whole seconds (truncating).
#stable(since = "0.1")
export fn Duration @seconds() => @nanos / 1_000_000_000
/// Total duration in whole minutes (truncating).
#stable(since = "0.1")
export fn Duration @minutes() => @nanos / 60_000_000_000
/// Total duration in whole hours (truncating).
#stable(since = "0.1")
export fn Duration @hours() => @nanos / 3_600_000_000_000
/// Total duration in whole days (truncating).
#stable(since = "0.1")
export fn Duration @days() => @nanos / 86_400_000_000_000
/// Total duration as fractional seconds (`f64`).
///
/// Preserves sub-second precision (unlike [`seconds`] which truncates).
///
/// # Examples
/// ```nova
/// assert(1500.to_millis().seconds_f64() == 1.5)
/// ```
#stable(since = "0.1")
export fn Duration @seconds_f64() -> f64 => (@nanos as f64) / 1_000_000_000.0
/// Total duration as fractional milliseconds (`f64`).
#stable(since = "0.1")
export fn Duration @millis_f64() => (@nanos as f64) / 1_000_000.0
/// Sleep for this duration via the ambient `Time` effect.
///
/// Plan 175 Ф.3 (D316 typed retype): `Time.sleep` now takes a typed
/// `Duration` directly (no more int-ms wire at the `.nv` surface — the
/// wire's ms-rounding, if any, is an internal handler-impl detail, e.g.
/// the real-clock `#default_handler(Time)` in std/prelude/effects.nv
/// ceils to whole milliseconds because the underlying scheduler primitive
/// is ms-granular; a MOCK handler like `th.mut_clock` can honor full
/// nanosecond precision if it wants to). Full ns precision now flows
/// end-to-end through the effect call itself.
///
/// # Examples
/// ```nova
/// 5.to_seconds().sleep()
/// ```
#stable(since = "0.1")
export fn Duration @sleep() Time -> () => Time.sleep(@)

// Free `sleep(Duration)`/`sleep_until(Monotonic)` RETRACTED (Plan 175
// Ф.2-v3, 2026-07-22, owner decision — П12-снос latch made permanent):
// canonical form is METHOD-ONLY — `d.sleep()` (above) and
// `deadline.sleep_until()` (std/time/duration/monotonic.nv
// `Monotonic @sleep_until()`, pre-existing). No free-function alias.


// ──────────────────────────────────────────────────────────────────────────
// Predicates
// ──────────────────────────────────────────────────────────────────────────

/// True если duration равна нулю (`nanos == 0`).
#stable(since = "0.1")
export fn Duration @is_zero() => @nanos == 0

/// True если duration отрицательная (`nanos < 0`).
///
/// Используется для проверки что `ts2 - ts1` дало "в прошлом" result.
#stable(since = "0.1")
export fn Duration @is_negative() => @nanos < 0

/// True если duration строго положительная (`nanos > 0`).
#stable(since = "0.1")
export fn Duration @is_positive() => @nanos > 0


// ──────────────────────────────────────────────────────────────────────────
// Decomposition — разложение на компоненты (для display / форматирования)
// ──────────────────────────────────────────────────────────────────────────

/// Decomposed duration components — для форматирования "1h 30m 45s".
///
/// Always non-negative (для signed durations см. `Duration.is_negative()`
/// + это разложение модуля).
#stable(since = "0.1")
export type DurationParts {
    ro days int
    ro hours int
    ro minutes int
    ro seconds int
    ro millis int
    ro micros int
    ro nanos int
}

/// Decompose Duration на компоненты (days, hours, ..., nanos).
///
/// Sign discarded — все поля non-negative. Для signed display комбинируй с
/// [`is_negative`].
///
/// # Examples
/// ```nova
/// let d = 3661.to_seconds()  // 1h 1min 1s
/// let p = d.parts()
/// assert(p.hours == 1)
/// assert(p.minutes == 1)
/// assert(p.seconds == 1)
/// ```
#stable(since = "0.1")
export fn Duration @parts() -> DurationParts {
    ro total = if @nanos < 0 { -@nanos } else { @nanos }
    ro days = (total / 86_400_000_000_000) as int
    ro r1 = total % 86_400_000_000_000
    ro hours = (r1 / 3_600_000_000_000) as int
    ro r2 = r1 % 3_600_000_000_000
    ro minutes = (r2 / 60_000_000_000) as int
    ro r3 = r2 % 60_000_000_000
    ro seconds = (r3 / 1_000_000_000) as int
    ro r4 = r3 % 1_000_000_000
    ro millis = (r4 / 1_000_000) as int
    ro r5 = r4 % 1_000_000
    ro micros = (r5 / 1_000) as int
    ro nanos = (r5 % 1_000) as int
    { days, hours, minutes, seconds, millis, micros, nanos }
}


// ──────────────────────────────────────────────────────────────────────────
// Overflow-safe i64 primitives (Plan 175 Ф.1c / D317) — module-private.
//
// 3-tier discipline (Rust/Swift-паритет; бьёт Go silent-wrap и Zig
// build-mode-UB): operators trap; `checked_*` → Option; `saturating_*` → clamp.
// Все helpers работают на raw i64 (bare `+`/`-`/`*` wrap by design — именно
// поэтому overflow детектируется ЯВНО, а не полагается на trap примитива).
// ──────────────────────────────────────────────────────────────────────────

// Plan 200 Step 1 (Пункт 10): локальные `i64_max()`/`i64_min()`/`clamp_i64()`
// удалены — встроенные `i64.MAX`/`i64.MIN`/`@clamp` (Plan 200 Step 0, D74
// amend) покрывают тот же контракт байт-идентично.
//
// Plan 206 Ф.3 (D423): дедуп D317 — `checked_add/_sub/_mul` делегируют
// Ints-бланкетам `@checked_*` (std/src/prelude/protocols.nv, поверх
// компиляторного `@overflowing_*` = `__builtin_*_overflow`). Ручные
// i64-range-проверки (add/sub) и wrap+divide-back (mul) удалены: под
// sized-int trap-default (Ф.1b) старый `checked_mul_i64` ТРАПИЛ на голом
// `a * b` (до divide-back-проверки), а ручные проверки дублировали overflow-
// детект (нарушение «одно окно», 196). Поведение байт-идентично (None ⟺
// overflow i64), но overflow-детект теперь один — аппаратный флаг. Plan 200
// Step 1: сами wrapper-функции `checked_add_i64`/`checked_sub_i64`/
// `checked_mul_i64` тоже удалены — call-сайты зовут `a.checked_add(b)` и т.д.
// напрямую (тот же бланкет, на один слой обёртки меньше).

fn checked_neg_i64(a i64) -> Option[i64] =>
    if a == i64.MIN { None } else { Some(-a) }

fn checked_div_i64(a i64, b i64) -> Option[i64] {
    if b == 0 { return None }
    if b == -1 && a == i64.MIN { return None }
    Some(a / b)
}

/// Saturating add clamped to `[lo, hi]`.
fn sat_add_i64(a i64, b i64, lo i64, hi i64) -> i64 =>
    match a.checked_add(b) {
        Some(r) => r.clamp(lo, hi),
        None => if b > 0 { hi } else { lo },
    }

/// Saturating sub clamped to `[lo, hi]`.
fn sat_sub_i64(a i64, b i64, lo i64, hi i64) -> i64 =>
    match a.checked_sub(b) {
        Some(r) => r.clamp(lo, hi),
        None => if b < 0 { hi } else { lo },
    }

/// Saturating mul clamped to `[lo, hi]` (overflow ⇒ sign-directed boundary).
fn sat_mul_i64(a i64, b i64, lo i64, hi i64) -> i64 =>
    match a.checked_mul(b) {
        Some(r) => r.clamp(lo, hi),
        None => if (a > 0) == (b > 0) { hi } else { lo },
    }

// ── trap-wrappers (operators route here) ──

fn add_or_trap(a i64, b i64) -> i64 =>
    match a.checked_add(b) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: add"),
    }

fn sub_or_trap(a i64, b i64) -> i64 =>
    match a.checked_sub(b) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: sub"),
    }

fn neg_or_trap(a i64) -> i64 =>
    match checked_neg_i64(a) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: neg(i64::MIN)"),
    }

fn mul_or_trap(a i64, b i64) -> i64 =>
    match a.checked_mul(b) {
        Some(r) => r,
        None => panic("Duration arithmetic overflow: mul"),
    }

fn div_or_trap(a i64, b i64) -> i64 {
    if b == 0 { panic("Duration arithmetic error: division by zero") }
    if b == -1 && a == i64.MIN { panic("Duration arithmetic overflow: div(i64::MIN, -1)") }
    a / b
}

/// f64 → i64 nanos с проверкой финитности и диапазона (`None` вне области).
/// `2⁶³` = 9223372036854775808.0 (первое f64-значение вне i64) — граница.
fn f64_nanos_checked(x f64) -> Option[i64] {
    if x.is_nan() || x.is_infinite() { return None }
    if x >= 9223372036854775808.0 { return None }
    if x < -9223372036854775808.0 { return None }
    Some(x as i64)
}

fn f64_nanos_or_trap(x f64) -> i64 =>
    match f64_nanos_checked(x) {
        Some(r) => r,
        None => panic("Duration arithmetic error: non-finite or out-of-range f64"),
    }


// ──────────────────────────────────────────────────────────────────────────
// Арифметика (D46) — overflow-safe (Plan 175 Ф.1c / D317).
//
// Операторы `+`/`-`/унарный `-`/`*`/`/` ТРАПАЮТ на overflow (в debug И release).
// Non-trapping эскейпы: `checked_*` (→ Option) и `saturating_*` (→ clamp к
// ±Duration.MAX). Границей Duration является ±(2⁶³−1) ns ≈ ±292 года.
// ──────────────────────────────────────────────────────────────────────────

/// Сложение durations (operator `+`). **Traps on overflow** (D317).
///
/// # Examples
/// ```nova
/// assert(1.to_hours() + 30.to_minutes() == 90.to_minutes())
/// ```
#stable(since = "0.1")
export fn Duration @plus(other Duration) -> Duration =>
    add_or_trap(@nanos, other.nanos).to_nanos()

/// Вычитание durations (operator `-`). Может дать negative result.
/// **Traps on overflow** (D317).
#stable(since = "0.1")
export fn Duration @minus(other Duration) -> Duration =>
    sub_or_trap(@nanos, other.nanos).to_nanos()

/// Унарный минус (operator `-`). Эквивалент `0 - self`.
/// **Traps on `i64::MIN`** (two's-complement asymmetry, D317).
#stable(since = "0.1")
export fn Duration @neg() -> Duration =>
    neg_or_trap(@nanos).to_nanos()

/// Scalar multiplication by integer (`Duration * i64`). **Traps on overflow** (D317).
#stable(since = "0.1")
export fn Duration @times(n i64) -> Duration =>
    mul_or_trap(@nanos, n).to_nanos()

/// Scalar multiplication by float (`Duration * f64`).
///
/// **Traps on `NaN`/`±inf`/out-of-range** (D317) — никогда silent мусор-cast.
/// Для non-trapping варианта — [`checked_mul_f64`]. Для финансовых расчётов считай
/// в i64 nanoseconds вручную чтобы избежать FP-rounding.
#stable(since = "0.1")
export fn Duration @times(n f64) -> Duration =>
    f64_nanos_or_trap((@nanos as f64) * n).to_nanos()

/// Integer division (`Duration / i64`). Truncating.
/// **Traps on `/0` и на `i64::MIN / -1`** (D317).
#stable(since = "0.1")
export fn Duration @div(n i64) -> Duration =>
    div_or_trap(@nanos, n).to_nanos()

/// Float division (`Duration / f64`).
/// **Traps on `NaN`/`±inf`/out-of-range** (в т.ч. `/0.0` → `±inf`, D317).
#stable(since = "0.1")
export fn Duration @div(n f64) -> Duration =>
    f64_nanos_or_trap((@nanos as f64) / n).to_nanos()

// ── checked_* → Option[Duration] (None on overflow) ──

/// Checked add — `None` on overflow (D317).
#stable(since = "0.1")
export fn Duration @checked_add(other Duration) -> Option[Duration] =>
    match @nanos.checked_add(other.nanos) {
        Some(r) => Some(r.to_nanos()),
        None => None,
    }

/// Checked sub — `None` on overflow (D317).
#stable(since = "0.1")
export fn Duration @checked_sub(other Duration) -> Option[Duration] =>
    match @nanos.checked_sub(other.nanos) {
        Some(r) => Some(r.to_nanos()),
        None => None,
    }

/// Checked scalar multiply — `None` on overflow (D317).
#stable(since = "0.1")
export fn Duration @checked_mul(n i64) -> Option[Duration] =>
    match @nanos.checked_mul(n) {
        Some(r) => Some(r.to_nanos()),
        None => None,
    }

/// Checked integer divide — `None` on `/0` or `i64::MIN / -1` (D317).
#stable(since = "0.1")
export fn Duration @checked_div(n i64) -> Option[Duration] =>
    match checked_div_i64(@nanos, n) {
        Some(r) => Some(r.to_nanos()),
        None => None,
    }

/// Checked float multiply — `None` on `NaN`/`±inf`/out-of-range (D317).
#stable(since = "0.1")
export fn Duration @checked_mul_f64(n f64) -> Option[Duration] =>
    match f64_nanos_checked((@nanos as f64) * n) {
        Some(r) => Some(r.to_nanos()),
        None => None,
    }

/// Checked float divide — `None` on `NaN`/`±inf`/out-of-range (D317).
#stable(since = "0.1")
export fn Duration @checked_div_f64(n f64) -> Option[Duration] =>
    match f64_nanos_checked((@nanos as f64) / n) {
        Some(r) => Some(r.to_nanos()),
        None => None,
    }

// ── saturating_* → Duration (clamp к ±Duration.MAX = ±(2⁶³−1)) ──

/// Saturating add — clamps to `±Duration.MAX` (D317).
#stable(since = "0.1")
export fn Duration @saturating_add(other Duration) -> Duration =>
    sat_add_i64(@nanos, other.nanos, -i64.MAX, i64.MAX).to_nanos()

/// Saturating sub — clamps to `±Duration.MAX` (D317).
#stable(since = "0.1")
export fn Duration @saturating_sub(other Duration) -> Duration =>
    sat_sub_i64(@nanos, other.nanos, -i64.MAX, i64.MAX).to_nanos()

/// Saturating scalar multiply — clamps to `±Duration.MAX` (D317).
#stable(since = "0.1")
export fn Duration @saturating_mul(n i64) -> Duration =>
    sat_mul_i64(@nanos, n, -i64.MAX, i64.MAX).to_nanos()

/// Ratio between two durations — dimensionless `f64`.
///
/// # Examples
/// ```nova
/// assert(30.to_seconds().ratio(1.to_minutes()) == 0.5)
/// ```
#stable(since = "0.1")
export fn Duration @ratio(other Duration) -> f64 =>
    (@nanos as f64) / (other.nanos as f64)

/// Абсолютное значение duration (отбрасывает sign).
///
/// **Plan 175 Ф.1c (D317):** `@abs(i64::MIN)` НЕ является UB/wrap — saturate к
/// `i64::MAX`; two's-complement asymmetry (`|i64::MIN| > i64::MAX`).
#stable(since = "0.1")
export fn Duration @abs() -> Duration =>
    if @nanos == i64.MIN { i64.MAX.to_nanos() }
    else if @nanos < 0 { (-@nanos).to_nanos() }
    else { @ }

/// Минимум двух durations.
#stable(since = "0.1")
export fn Duration @min(other Duration) -> Duration =>
    if @nanos < other.nanos { @ } else { other }

/// Максимум двух durations.
#stable(since = "0.1")
export fn Duration @max(other Duration) -> Duration =>
    if @nanos > other.nanos { @ } else { other }


// ──────────────────────────────────────────────────────────────────────────
// Compare (D183 amendment, Plan 91.8a.2 part 3): @compare даёт ==/!=/<>/etc
// через synthesis. Magic methods @eq/@lt/@le/@gt/@ge удалены.
// ──────────────────────────────────────────────────────────────────────────

/// Compare.compare — memcmp-style int return (D183).
/// `==`, `!=`, `<`, `<=`, `>`, `>=` operators synthesized via @compare.
#stable(since = "0.1")
export fn Duration @compare(other Duration) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }


// ──────────────────────────────────────────────────────────────────────────
// Display (D410)
// ──────────────────────────────────────────────────────────────────────────

/// `to_str()` — auto-scale короткая запись.
///
/// Выбирает unit по величине: 500ns / 150μs / 42ms / 2.5s / 5min / 2h / 3d.
/// Для развёрнутого формата используй [`to_human`].
///
/// # Examples
/// ```nova
/// assert(500.to_nanos().to_str() == "500ns")
/// assert(2.to_hours().to_str() == "2h")
/// ```
#stable(since = "0.1")
export fn Duration @to_str() -> str {
    ro n = @nanos
    ro abs = if n < 0 { -n } else { n }
    ro sign = if n < 0 { "-" } else { "" }

    if abs < 1_000 {
        "${sign}${abs}ns"
    } else if abs < 1_000_000 {
        "${sign}${abs / 1_000}us"
    } else if abs < 1_000_000_000 {
        "${sign}${abs / 1_000_000}ms"
    } else if abs < 60 * 1_000_000_000 {
        "${sign}${@seconds_f64().abs()}s"
    } else if abs < 3_600 * 1_000_000_000 {
        "${sign}${abs / 60_000_000_000}min"
    } else if abs < 86_400 * 1_000_000_000 {
        "${sign}${abs / 3_600_000_000_000}h"
    } else {
        "${sign}${abs / 86_400_000_000_000}d"
    }
}

/// Display (Plan 175 Ф.3(d)/Ф.4, D237; signature migrated to `Fmt` — Plan 208
/// Ф.2/D422, [M-208-time-display-fmt-migration-gap]) — delegates to
/// [`to_str`] (ASCII auto-scale short form, e.g. `"2s"`/`"500ns"`/`"150us"`).
/// **Byte-exact ASCII** — no bytes > 0x7F (fixes the U+03BC "μs" regression,
/// Q12; the underlying `to_str` already emits ASCII `"us"`, Ф.1c).
#stable(since = "0.1")
export fn Duration @display(mut f Fmt) -> () { f.write(@to_str().bytes()) }

/// Debug (D237; signature migrated to `Fmt` — Plan 208 Ф.2/D422) —
/// diagnostic form showing the exact raw nanoseconds alongside the human
/// short form (unambiguous for overflow/precision debugging, unlike the
/// auto-scaled `@display`).
#stable(since = "0.1")
export fn Duration @debug(mut f Fmt) -> () {
    f.write("Duration(")
    f.write(@to_str().bytes())
    f.write(", ")
    f.write(@nanos.to_str().bytes())
    f.write("ns)")
}

/// Human-readable форматирование с декомпозицией на компоненты.
///
/// Формат: `"1d 2h 30min 45s"`. Опускает leading zero-components
/// (i.e. `"30min 45s"` не `"0d 0h 30min 45s"`), но trailing zeros
/// сохраняет если хоть один старший компонент непустой.
///
/// # Examples
/// ```nova
/// let d = 1.to_days() + 2.to_hours() + 30.to_minutes()
/// assert(d.to_human().contains("1d"))
/// ```
#stable(since = "0.1")
export fn Duration @to_human() -> str {
    if @is_zero() { return "0s" }

    ro p = @parts()
    consume buf = StringBuilder.new()
    ro sign = if @nanos < 0 { "-" } else { "" }
    buf.append(sign)

    mut started = false
    if p.days > 0 { buf.append(p.days.to_str()); buf.append("d "); started = true }
    if p.hours > 0 || started { buf.append(p.hours.to_str()); buf.append("h "); started = true }
    if p.minutes > 0 || started { buf.append(p.minutes.to_str()); buf.append("min "); started = true }
    if p.seconds > 0 || started { buf.append(p.seconds.to_str()); buf.append("s") }

    ro result = buf.into_str()
    result.trim_ascii()
}


// ──────────────────────────────────────────────────────────────────────────
// Time effect — главный AI-first момент
// ──────────────────────────────────────────────────────────────────────────
//
// Time — ambient effect (как Random, не fail). В тестах подменяется
// handler'ом → код становится детерминированным без mock-библиотек.
//
// Plan 175 Ф.1 (D316 — единый источник схемы): декларация `type Time effect`
// живёт ТОЛЬКО в std/prelude/effects.nv (codegen читает её оттуда). Ранее
// здесь дублировался закомментированный 5-й источник схемы — УДАЛЁН, чтобы
// не плодить расходящиеся зеркала. int-провод (`now()->int`) сохраняется в
// Ф.1; типизация (`timestamp()->Timestamp`, `(Duration).sleep()`) — Ф.2/Ф.3.

// Plan 175 Ф.2-v3 (2026-07-22): `#default_handler(Time)` (`time_default`)
// MOVED to std/prelude/effects.nv, сразу после декларации `type Time
// effect {...}` — prelude auto-import'ится в КАЖДЫЙ CU, значит ambient
// Time (работает без `with`/явного `import std.time`, как Random, не
// Fail) больше не зависит от того, попал ли ЭТОТ модуль (time.duration)
// транзитивно в конкретный compile-unit. Раньше (Ф.2-v2) фабрика жила
// здесь и полагалась на hardcoded C-fallback (nova_rt/fibers.h
// `Nova_Time_*`) для CU, что её не тянули — тот fallback снесён (Ф.2-v3
// снос рукописного Time-диспатча), так что единственный источник
// ambient-поведения теперь — always-present prelude default handler.


// Plan 200 Step 2 (D410/D317 amend): int/f64 per-width fluent constructors
// (`int @seconds()`, singular `@second()`/`@minute()`/etc., `f64 @nanos()`/
// `@micros()`/`@millis()`/`@minutes()`/`@hours()`/`@days()`) RETRACTED —
// заменены единым `to_*`-бланкетом над `Ints` (см. выше, рядом с
// `f64 @checked_to_seconds()`) + `f64 @to_seconds()` (единственный float-
// конструктор, владелец 2026-07-15 — "Только секунды"; f64-фракции для
// остальных единиц не имели внешних потребителей — repo-wide grep пуст).
// Singular-алиасы (`1.second()`, `1.hour()`, ...) убраны без замены (DRY —
// `1.to_seconds()`, `1.to_hours()`).


// ──────────────────────────────────────────────────────────────────────────
// Утилиты — структурные шаблоны
// ──────────────────────────────────────────────────────────────────────────

/// Измерить длительность исполнения `action` и вернуть `(результат, elapsed)`.
///
/// Использует ambient `Time` effect — в тестах под `fixed_ms` всегда вернёт
/// elapsed = 0 (clock не движется). Для реальных бенчмарков используется
/// в production где `Time` provided runtime'ом.
///
/// # Examples
/// ```nova
/// with Time = th.fixed_ms(1000) {
///     let (result, elapsed) = measure(|| 42)
///     assert(result == 42)
///     assert(elapsed == Duration.ZERO)
/// }
/// ```
/// **Plan 175 Ф.5(d) (D318):** элапсед-измерение через `Monotonic`, НЕ
/// `Timestamp` — стопвотч/бенчмарк-семантика иммунна к wall-clock skew
/// (NTP/DST jump ВО ВРЕМЯ измерения раньше мог дать отрицательный или
/// вздутый `elapsed` — ровно Go/Rust/Java-конвенция: `time.Since`/`Instant`
/// для измерений всегда монотонные). Сигнатура не меняется (`Duration` —
/// clock-agnostic результат).
#stable(since = "0.1")
export fn measure[T](action fn() -> T) Time -> (T, Duration) {
    ro start = Monotonic.now()
    ro result = action()
    ro elapsed = Monotonic.now().elapsed_since(start)
    (result, elapsed)
}

/// Compute дедлайн `now() + d` с использованием ambient `Time`.
///
/// Convenience-обёртка чтобы не писать `Timestamp.now() + 5.to_seconds()` каждый раз.
///
/// **Plan 175 Ф.5(d) — намеренно ОСТАЁТСЯ `Timestamp`-based** (НЕ мигрирован
/// на `Monotonic`, в отличие от [`measure`]): возвращаемый тип — `Timestamp`
/// (wall-clock), поэтому клок-источник обязан совпадать с типом контракта
/// (D124 — нельзя молча подменить домен часов внутри функции с committed
/// wall-clock return type). Для монотонных дедлайнов (timer/scope-deadline,
/// 173 §3a `supervised(timeout:)`) используй `Monotonic.now() + d` напрямую —
/// именно ЭТОТ паттерн, а не `deadline_in`, канон для `deadline:`-параметров.
#stable(since = "0.1")
export fn deadline_in(d Duration) Time -> Timestamp =>
    Timestamp.now() + d


// ──────────────────────────────────────────────────────────────────────────
// Тесты
// ──────────────────────────────────────────────────────────────────────────

test "int extensions: basic conversions" {
    assert(2.to_seconds() == 2_000_000_000.to_nanos())
    assert(100.to_millis() == 100_000_000.to_nanos())
    assert(5.to_minutes() == 300.to_seconds())
    assert(1.to_hours() == 3600.to_seconds())
    assert(3.to_days() == 259_200.to_seconds())
    assert(2.to_weeks() == 1_209_600.to_seconds())
}

test "f64 extensions: fractional values" {
    assert(0.5.to_seconds() == 500.to_millis())
    assert(1.5.to_seconds() == 1500.to_millis())
    assert(0.001.to_seconds() == 1.to_millis())
}

test "arithmetic: plus / minus / neg" {
    ro total = 1.to_hours() + 30.to_minutes()
    assert(total == 90.to_minutes())

    ro diff = 1.to_hours() - 15.to_minutes()
    assert(diff == 45.to_minutes())

    ro n = -(5.to_seconds())
    assert(n.is_negative())
    assert(n.abs() == 5.to_seconds())
}

test "arithmetic: times / div" {
    assert(5.to_seconds() * 3 == 15.to_seconds())
    assert(1.to_minutes() / 4 == 15.to_seconds())
    assert(10.to_seconds() * 1.5 == 15.to_seconds())      // f64 multiplier
    assert(30.to_seconds() / 1.5 == 20.to_seconds())
}

test "ratio between durations" {
    ro r = 30.to_seconds().ratio(1.to_minutes())
    assert(r == 0.5)
}

test "comparison" {
    assert(1.to_seconds() < 1.to_minutes())
    assert(1.to_hours() > 30.to_minutes())
    assert(60.to_seconds() == 1.to_minutes())
}

test "min / max" {
    assert(5.to_seconds().min(10.to_seconds()) == 5.to_seconds())
    assert(5.to_seconds().max(10.to_seconds()) == 10.to_seconds())
}

test "predicates" {
    // NB: `Duration.ZERO` как value-const-reference упирается в pre-existing
    // value-record const-emission gap (symbol `ZERO` vs ref `Duration_ZERO`),
    // не time-специфичный — follow-up [M-175-value-record-const-ref]. Значение
    // строится через to_nanos(0) (та же конвенция, что nova_tests/plan91_fe4).
    assert(0.to_nanos().is_zero())
    assert((-1.to_seconds()).is_negative())
    assert(1.to_seconds().is_positive())
}

test "parts: декомпозиция" {
    ro d = 1.to_days() + 2.to_hours() + 30.to_minutes() + 45.to_seconds()
    ro p = d.parts()
    assert(p.days == 1)
    assert(p.hours == 2)
    assert(p.minutes == 30)
    assert(p.seconds == 45)
}

test "to_str(): auto-scale" {
    assert(500.to_nanos().to_str() == "500ns")
    assert(150.to_micros().to_str() == "150us")
    assert(42.to_millis().to_str() == "42ms")
    assert(2.to_seconds().to_str() == "2s")
    assert(5.to_minutes().to_str() == "5min")
    assert(2.to_hours().to_str() == "2h")
}

test "to_human(): компонентами" {
    ro d = 1.to_days() + 2.to_hours() + 30.to_minutes()
    ro s = d.to_human()
    assert(s.contains("1d"))
    assert(s.contains("2h"))
    assert(s.contains("30min"))
}

test "Timestamp arithmetic: ts + duration → ts" {
    ro t1 = 1000.to_unix_seconds()
    ro t2 = t1 + 30.to_seconds()
    assert(t2.unix_seconds() == 1030)
}

test "Timestamp arithmetic: ts - ts → duration" {
    ro t1 = 1000.to_unix_seconds()
    ro t2 = 1042.to_unix_seconds()
    ro elapsed = t2 - t1
    assert(elapsed == 42.to_seconds())
}

test "Timestamp comparison" {
    ro t1 = 1000.to_unix_seconds()
    ro t2 = 2000.to_unix_seconds()
    assert(t1 < t2)
    assert(t2 > t1)
}

test "AI-first: Time fixed → детерминированный код" {
    with Time = th.fixed_ms(1700000000000) {
        ro now = Timestamp.now()
        assert(now.unix_millis() == 1700000000000)
    }
}

test "deadline_in + is_past через Time-handler" {
    with Time = th.fixed_ms(1000) {
        ro dl = deadline_in(5.to_seconds())
        // Сейчас 1000ms = 1s; deadline = 1s + 5s = 6s
        assert(dl.unix_seconds() == 6)
        assert(!dl.is_past())
    }
    with Time = th.fixed_ms(10_000) {
        // 10 секунд после epoch — deadline 6s уже прошёл
        ro dl = 6.to_unix_seconds()
        assert(dl.is_past())
    }
}

test "measure semantics: под fixed_ms elapsed = 0" {
    // Семантика `measure[T]` (returns (T, Duration)): под fixed-часами
    // clock не движется → elapsed = 0. Проверяется inline через сахар
    // `Timestamp.now()`/@minus/@is_zero (value-Duration round-trip).
    // NB: прямой `ro (r, e) = measure(||…)` требует generic-fn-возврата
    // tuple с value-элементом — отдельный value-record codegen-gap
    // [M-175-value-in-generic-tuple-return] (backlog), не time-специфичный.
    with Time = th.fixed_ms(1000) {
        ro start = Timestamp.now()
        ro result = 42
        ro elapsed = Timestamp.now().minus(start)
        assert(result == 42)
        assert(elapsed.is_zero())
    }
}

test "Ф.5(d): measure[T] мигрирован на Monotonic (elapsed иммунен к wall-clock skew)" {
    // Прямой вызов `measure(...)` (не inline-паттерн выше) — value-in-
    // generic-tuple-return gap [M-175-value-in-generic-tuple-return] здесь
    // НЕ бьёт, потому что `measure` возвращает `(int, Duration)`, а `int`
    // element — не value-record триггер (только Duration/Timestamp/Monotonic
    // ЭЛЕМЕНТОМ tuple вызывают гэп; здесь Duration — второй элемент результата
    // самого measure, но tuple-конструкция происходит ВНУТРИ измеряемого fn,
    // не на call-site — gap специфичен call-site turbofish-инференсу).
    with Time = th.mut_clock(0 as u64) {
        ro (result, elapsed) = measure(fn() -> int {
            3000.to_millis().sleep()  // virtual clock advance под mock — elapsed = 3s
            42
        })
        assert(result == 42)
        assert(elapsed == 3.to_seconds())
    }
}

test "elapsed / time_until" {
    with Time = th.fixed_ms(5000) {
        ro earlier = 2.to_unix_seconds()
        assert(earlier.elapsed() == 3.to_seconds())   // 5s - 2s

        ro later = 10.to_unix_seconds()
        assert(later.time_until() == 5.to_seconds())  // 10s - 5s
    }
}


// ──────────────────────────────────────────────────────────────────────────
// Plan 175 Ф.1c (D317/D318) — overflow-safe arithmetic (inline unit-tests).
// Trap-фикстуры (panic на overflow/div0/NaN) — nova_tests/time/rt/ (EXPECT_RUNTIME_PANIC).
// ──────────────────────────────────────────────────────────────────────────

test "Ф.1c: normal arithmetic unchanged (no false traps)" {
    assert((1.to_hours() + 30.to_minutes()) == 90.to_minutes())
    assert((1.to_hours() - 15.to_minutes()) == 45.to_minutes())
    assert((5.to_seconds() * 3) == 15.to_seconds())
    assert((1.to_minutes() / 4) == 15.to_seconds())
    assert((10.to_seconds() * 1.5) == 15.to_seconds())
    assert((30.to_seconds() / 1.5) == 20.to_seconds())
    assert((-(5.to_seconds())).is_negative())
}

test "Ф.1c/D317: Duration checked_add — Some / None at boundary" {
    ro top = i64.MAX.to_nanos()
    assert(top.checked_add(1.to_nanos()).is_none())
    match top.checked_add(0.to_nanos()) {
        Some(r) => assert(r.nanos() == i64.MAX),
        None => assert(false),
    }
    match 1000.to_nanos().checked_add(337.to_nanos()) {
        Some(r) => assert(r.nanos() == 1337),
        None => assert(false),
    }
}

test "Ф.1c/D317: Duration checked_sub / checked_mul / checked_div" {
    ro low = (-i64.MAX).to_nanos()
    assert(low.checked_sub(2.to_nanos()).is_none())
    assert(i64.MAX.to_nanos().checked_mul(2).is_none())
    // i64::MIN * -1 overflows
    assert(i64.MIN.to_nanos().checked_mul(-1).is_none())
    // i64::MIN / -1 overflows; /0 undefined
    assert(i64.MIN.to_nanos().checked_div(-1).is_none())
    assert(10.to_nanos().checked_div(0).is_none())
    match 100.to_nanos().checked_div(4) {
        Some(r) => assert(r.nanos() == 25),
        None => assert(false),
    }
    match 1000.to_nanos().checked_mul(1000) {
        Some(r) => assert(r.nanos() == 1_000_000),
        None => assert(false),
    }
}

test "Ф.1c/D317: Duration saturating_* clamps to ±MAX (no wrap)" {
    ro top = i64.MAX.to_nanos()
    assert(top.saturating_add(1_000_000.to_nanos()).nanos() == i64.MAX)
    assert(top.saturating_mul(4).nanos() == i64.MAX)
    // -1 + (-MAX) underflows below -MAX → clamp to -MAX (symmetric ±MAX)
    assert((-1).to_nanos().saturating_add((-i64.MAX).to_nanos()).nanos() == -i64.MAX)
    // negative overflow via mul
    assert(i64.MAX.to_nanos().saturating_mul(-2).nanos() == -i64.MAX)
    // in-range unaffected
    assert(1.to_seconds().saturating_add(1.to_seconds()).nanos() == 2_000_000_000)
}

test "Ф.1c/D317: @abs(i64::MIN) saturates to MAX (two's-complement asymmetry)" {
    assert(i64.MIN.to_nanos().abs().nanos() == i64.MAX)
    assert((-5).to_nanos().abs().nanos() == 5)
    assert(5.to_nanos().abs().nanos() == 5)
}

test "Ф.1c/D317: f64 conversions reject out-of-range (checked_* → None)" {
    ro g = 1_000_000_000.0                 // 1e9
    // 1e18 s × 1e9 = 1e27 ns ≫ i64::MAX → out of range
    assert((g * g).checked_to_seconds().is_none())
    match 1.5.checked_to_seconds() {
        Some(r) => assert(r.millis() == 1500),
        None => assert(false),
    }
    // @checked_mul_f64 / @checked_div_f64
    assert(i64.MAX.to_nanos().checked_mul_f64(g).is_none())
    match 10.to_seconds().checked_mul_f64(1.5) {
        Some(r) => assert(r == 15.to_seconds()),
        None => assert(false),
    }
}

test "Ф.1c/D317: Timestamp saturates at i64 horizon (~2262, no wrap to 1677)" {
    ro tmax = i64.MAX.to_unix_nanos()
    assert(tmax.checked_add(1.to_nanos()).is_none())
    // @plus saturates instead of wrapping negative
    assert((tmax + 1.to_seconds()).unix_nanos() == i64.MAX)
    ro tmin = i64.MIN.to_unix_nanos()
    assert(tmin.checked_sub(1.to_nanos()).is_none())
    assert((tmin - 1.to_seconds()).unix_nanos() == i64.MIN)
    // saturating diff
    assert((1042.to_unix_seconds() - 1000.to_unix_seconds()) == 42.to_seconds())
}

test "Ф.1c/D318: Monotonic elapsed_since saturate-to-zero; checked_duration_since → None on regress" {
    ro m = Monotonic.now()
    ro earlier = m - 5.to_seconds()
    // equal marks → 0
    assert(m.elapsed_since(m).nanos() == 0)
    // apparent regress (earlier before m) → saturate to 0, never negative
    assert(earlier.elapsed_since(m).nanos() == 0)
    // forward → 5s
    assert(m.elapsed_since(earlier) == 5.to_seconds())
    // checked: regress → None; forward → Some(5s)
    assert(earlier.checked_duration_since(m).is_none())
    match m.checked_duration_since(earlier) {
        Some(r) => assert(r == 5.to_seconds()),
        None => assert(false),
    }
}

test "Ф.3(a)/D316: Monotonic.now() мокабелен через Time-handler (mock-coherence)" {
    with Time = th.mut_clock(0 as u64) {
        ro m0 = Monotonic.now()
        5000.to_millis().sleep()  // virtual clock advance, ms
        ro m1 = Monotonic.now()
        // ОДИН handler двигает и wall (now), и monotonic (now_monotonic)
        // когерентно — оба читают из одного `current_ms` (Ред.2 Q14 mock-coherence).
        assert(m1.elapsed_since(m0) == 5.to_seconds())
        assert(Timestamp.now().unix_millis() == 5000)
    }
}

test "Ф.3(c): m2 - m1 диспатчится в @minus(Monotonic) → Duration, не @minus(Duration)" {
    with Time = th.mut_clock(0 as u64) {
        ro m1 = Monotonic.now()
        2000.to_millis().sleep()
        ro m2 = Monotonic.now()
        ro d = m2 - m1
        assert(d == 2.to_seconds())
        assert(d == m2.elapsed_since(m1))
    }
}

test "Ф.3(b): (Duration).sleep() метод-канон под mock-clock продвигает виртуальные часы" {
    with Time = th.mut_clock(1000 as u64) {
        (500.to_millis()).sleep()
        assert(Timestamp.now().unix_millis() == 1500)
        // Duration.ZERO как const-reference — pre-existing [M-175-value-record-const-ref]
        // gap (не time-специфичный); workaround — to_nanos(0), см. "predicates" выше.
        (0.to_nanos()).sleep()  // немедленно, часы не двигаются
        assert(Timestamp.now().unix_millis() == 1500)
    }
}

test "Ф.3(b)/Q3: Monotonic @sleep_until — будущий дедлайн ждёт ровно дельту, прошлый — немедленно" {
    with Time = th.mut_clock(0 as u64) {
        ro m0 = Monotonic.now()
        ro deadline = m0 + 3.to_seconds()
        deadline.sleep_until()
        assert(Timestamp.now().unix_millis() == 3000)

        // дедлайн уже в прошлом → saturate-to-zero, немедленно (без доп. ожидания)
        ro past = Monotonic.now() - 10.to_seconds()
        past.sleep_until()
        assert(Timestamp.now().unix_millis() == 3000)
    }
}

test "Ф.3(d)/D237/Q12: @display Duration/Monotonic — byte-exact ASCII (нет байтов > 0x7F)" {
    ro d = 150.to_micros()
    ro s = "${d}"
    assert(s == "150us")
    ro bs = s.bytes()
    mut all_ascii = true
    for i in 0..bs.len() {
        if bs[i] > 0x7F as u8 { all_ascii = false }
    }
    assert(all_ascii)

    ro m = Monotonic.now()
    ro ms = "${m}"
    assert(ms.starts_with("+"))
}

test "Ф.3(d): @debug Duration/Timestamp/Monotonic — диагностическая форма" {
    // Проверяем ОБА пути: `"${x:?}"`-сахар (interp, всегда строит настоящий
    // FmtCtx) и явный `.debug(FmtCtx.bare(sink, 0, true))` call form (Plan 208
    // Ф.2/D422 — `@debug` требует `Fmt`, не голый `Write`/`StringBuilder`;
    // тот же call-shape что и `std/src/collections/vec/protocols_test.nv`).
    assert("${2.to_seconds():?}".contains("Duration("))

    consume sb1 = StringBuilder.new()
    2.to_seconds().debug(FmtCtx.bare(sb1, 0, true))
    assert(sb1.into_str().contains("Duration("))

    consume sb2 = StringBuilder.new()
    1_700_000_000_000.to_unix_millis().debug(FmtCtx.bare(sb2, 0, true))
    assert(sb2.into_str().contains("Timestamp(unix_ns="))

    consume sb3 = StringBuilder.new()
    Monotonic.now().debug(FmtCtx.bare(sb3, 0, true))
    assert(sb3.into_str().contains("Monotonic(+"))
}


