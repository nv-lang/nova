// stdlib/time/duration/time_effect.nv — `Time` effect + real-clock default
// handler (Plan 175.2 Ф.2-v4, П6, D-амендмент).
//
// Plan 175 Ф.2-v3 moved `type Time effect` + its `#default_handler` INTO
// `std/prelude/effects.nv` so ambient use (no `with`, no explicit import)
// worked from any compile-unit (prelude auto-imports everywhere). Plan
// 175.2 Ф.2-v4 (owner code-review finding П6, 2026-07-22) moves it back OUT
// to this co-equal file of the `time.duration` folder-module (papka = один
// модуль — import-путь `std.time.duration` не меняется; см. `core.nv`/
// `monotonic.nv`/`timestamp.nv` — same pattern as Vec's `core.nv`/`iter.nv`):
//
//   - Ambient-без-import was RETRACTED already in Ф.2-v3/Ф.3 (D62 retraction
//     wave) — `Time` must appear explicitly in every fn's effect-row now,
//     exactly like `Fs`/`Net`/`Os`/any other user effect. Prelude residency
//     bought zero-import AMBIENT-VALUE availability (no `with` needed) —
//     it never bought anything about the effect NAME needing no import, and
//     effect-row names resolve compile-unit-wide regardless of which module
//     declares them (07-modules §393 / precedent: `std/time/civil/tzif.nv`
//     writes `Fs Os -> ...` without importing either name). So the prelude
//     placement was serving NO purpose ambient-retraction didn't already
//     obsolete.
//   - Real payoff of the move: `nanos` on `Monotonic`/`Timestamp`/`Duration`
//     becomes MODULE-PRIVATE (`priv`, D220 per-field — see `core.nv`/
//     `monotonic.nv`/`timestamp.nv`) right after this file lands. A
//     module-private field is readable/constructible ONLY from files in
//     ITS OWN module (07-modules §393 — module-private visible from every
//     co-equal file of the SAME folder-module, not just the declaring
//     file). The real-clock handler below constructs `Timestamp`/
//     `Monotonic` via bare record-literal (`{ nanos: ... }`) — living here
//     (same module as the three value-records) keeps that legal WITHOUT a
//     public `from_ns`/`from_nanos` escape hatch. Had this handler stayed
//     in `prelude.effects` (a DIFFERENT module), the same construction
//     would need a public constructor purely to serve one handler body —
//     an API-surface cost for zero user benefit.

module time.duration

// Plan 175.2 Ф.2-v4 (П11 ATTEMPTED, REVERTED same wave, 2026-07-22): tried
// retyping `local_offset()` to return `Offset` (`std.time.civil`) directly
// — consistency with `now()->Timestamp`/`now_monotonic()->Monotonic`.
// Reverted: making `Offset` (and any construction of it, even a bare
// `{ seconds: ... }` record-literal with NO `Offset.from_seconds`/`Result`
// involved) reachable from THIS file broke the authoritative
// `spec_tests/conformance` mega-CU — an UNRELATED bare/erased-`Option`
// if-let (`d34_pattern_bind_conditions.nv`, `fn d34_cache_get(key int) ->
// Option { ... }`, no explicit `[T]`) started resolving its result type as
// `NovaValue_Offset` instead of `nova_int` (CC-FAIL "assigning to
// NovaValue_Offset from incompatible type nova_int"). Confirmed real
// (reverting only THIS retype, keeping every other П4-П9 change, restores
// PASS) and confirmed NOT specific to this handler's construction style —
// removing the `Result`/`from_seconds` round-trip (bare record-literal
// instead) did NOT fix it either, only fully reverting the retype did.
// Root cause NOT identified (some CU-global type-inference/mono-ordering
// state bleeds between unrelated expressions once a NEW value-record type
// becomes reachable this broadly — same class as documented `typedef-
// ordering`/`erasure-collision` markers elsewhere in this codebase, but
// deep compiler-internals work, well beyond this wave's scope). See
// `[M-offset-result-mono-bleed-if-let]` (docs/plans/backlog-followups.md)
// for the full diagnosis and repro recipe. Schema stays `local_offset()->
// int` (unchanged from before this wave) until that gap is closed.

/// **Time-effect** — the effect for access to the clock and scheduler (D11 /
/// D14 / D62, spec/decisions/04-effects.md).
///
/// **Purpose:** AI-first hooks for unit tests. In production `Time.now()`
/// / `Time.sleep(d)` provide a monotonic clock and fiber-suspension through the
/// runtime. In tests, a handler-override:
/// ```nova
/// with Time = effect Time {
///     sleep(d Duration) -> () => ()
///     now() -> Timestamp => 12345.to_unix_millis()
///     now_monotonic() -> Monotonic => 0.to_monotonic_nanos()
///     local_offset() -> int => 0
/// } {
///     // время "замерло" — sleep noop, now() возвращает fixed value
///     run_test_with_fixed_clock()
/// }
/// ```
///
/// **Default handler** (without a `with` block, `real_time()` below — Plan
/// 175.2 Ф.2-v4 П8 rename, symmetry with `real_fs()`/`real_net()`/`real_os()`):
///   - `sleep(d)` — yields the fiber via `time_sleep_ms` (a libuv timer or a
///     blocking sleep in bootstrap mode).
///   - `now()` — unix epoch wall-clock instant (`Timestamp`).
///
/// **Realtime-context:** `Time` is a suspend-effect (D64), forbidden inside
/// `realtime { ... }` blocks. See `realtime_suspend_effect` in types/mod.rs.
///
/// **What is NOT included in the declaration** (intentional deferral):
///   - `after(ms int) -> Chan[int]` — an internal concurrency-runtime op,
///     requires `Chan[T]` in scope. Pre-registered in codegen (emit_c.rs) and
///     works; a formal declaration will appear once `Chan[T]` is usable as a
///     generic bound here.
///
/// **Single source of schema truth (Plan 175 Ф.1, D316; typed since Ф.2-v3;
/// moved here Ф.2-v4/П6):** this declaration is the ONLY source of
/// `effect_schemas["Time"]`; codegen reads it from the `.nv` (`emit_type_decl`
/// → `emit_effect_type`, THE SAME generic path as user effects).
/// Dispatch functions (`Nova_Time_sleep` etc.) are generated FROM THIS schema —
/// not hand-written in nova_rt/fibers.h. A narrow exception (not an architecture
/// hole): the struct type `NovaVtable_Time` + the TLS slot `_nova_handler_Time`
/// stay hand-written in nova_rt/effects.h/.c (channels.h/runtime.c needs a
/// single stable C type) — their WIRE stays int64 nanoseconds; codegen
/// marshals typed parameters/results (`Duration`/`Timestamp`/
/// `Monotonic`) to/from raw i64 at the boundary of the dispatch function and
/// the handler-literal install (emit_c.rs `emit_effect_type`/`emit_handler_lit`,
/// the Time-specific marshalling branch) — the only place where the int-wire is
/// still visible, and it is generated/hand-written C, not a `.nv` schema.
///
/// **`now_monotonic()->Monotonic`** (Plan 65 Ф.12.3 / D124) — the monotonic
/// clock; a `Monotonic` record.
/// **5 timer-observability counters** live in a separate `TimerMetrics`
/// (Plan 175 Ф.1 / Q1, `std/prelude/effects.nv`) — read-only introspection,
/// not "time".
///
/// **`local_offset_sec()->int`** (Plan 175.1, D316 amend + D321,
/// 2026-07-10) — the system UTC offset of the CURRENT local zone of the
/// machine, in seconds. Retype to `Offset` was ATTEMPTED + REVERTED this same
/// wave (Plan 175.2 Ф.2-v4 П11) — see file-header comment / `[M-offset-result-
/// mono-bleed-if-let]` for the codegen blocker found. Gives ONLY the numeric
/// offset — not an implicit zone: `ZonedDateTime`/civil-API still require an
/// explicit `TimeZone`/`Offset` (D319 R1). Stays a plain `int` (not
/// `Duration`) — an offset, not a duration/instant.
#stable(since = "0.1")
export type Time effect {
    sleep(d Duration) -> ()
    now() -> Timestamp
    now_monotonic() -> Monotonic
    local_offset_sec() -> int
}

// Plan 175.2 Ф.2-v4 (П6): extern-примитивы переехали СЮДА вместе с
// эффектом (были в std/prelude/effects.nv). Тонкие `extern "C"` обёртки
// поверх РЕАЛЬНЫХ часов/таймера (nova_rt/fibers.h): scheduler-aware sleep
// (fiber-park / drain / bootstrap-block) + uv-часы.
//
// Owner rename (2026-07-22, той же волной): `time_default_sleep` →
// `time_sleep_ms` — домен+операция+единица (симметрия
// `time_wall_unix_ms`/`time_monotonic_ns`; суффикс `_default` был лишним —
// имя описывает WHAT (sleep in ms), не то, что это чей-то дефолт-хендлер).
extern "C" fn time_wall_unix_ms() -> int
extern "C" fn time_monotonic_ns() -> int
extern "C" fn time_local_offset_sec() -> int
extern "C" fn time_sleep_ms(ms int) -> ()

/// Real-clock `Time` handler (Plan 175.2 Ф.2-v4 П8: renamed from
/// `time_default` — descriptive constructor name, symmetry with
/// `real_fs()`/`real_net()`/`real_os()`, not a `_default`-suffixed name).
///
/// Plan 175.2 Ф.2-v4 (П7, D431): `#default_handler` written BARE (no
/// `(Time)` argument) — the effect is inferred from this fn's own
/// `-> Effect[Time]` return type (checker: `check_default_handlers`).
///
/// Ambient-fallback: the compiler lazily (on first use, without
/// `with`) constructs and installs THIS handler exactly once per thread
/// (generic install-once check inside `Nova_Time_<op>()`,
/// `emit_effect_type`) — an explicit `with Time = ...` still overrides it.
///
/// Plan 175.2 Ф.2-v4 (П4, D-амендмент): handler-ops fully typed
/// (`-> Type` mandatory, matches the `Time` schema above exactly).
///
/// Typed parameters/results (`Duration`/`Timestamp`/`Monotonic`)
/// are constructed directly via record-literal (`{ nanos: ... }`) —
/// legal here specifically BECAUSE this file lives in `time.duration`
/// (module-private `nanos` access, see file header).
#default_handler
fn real_time() -> Effect[Time] {
    effect Time {
        sleep(d Duration) -> () => time_sleep_ms(((d.nanos() + 999_999) / 1_000_000) as int)
        now() -> Timestamp => { nanos: time_wall_unix_ms() * 1_000_000 }
        now_monotonic() -> Monotonic => { nanos: time_monotonic_ns() }
        local_offset_sec() -> int => time_local_offset_sec()
    }
}
