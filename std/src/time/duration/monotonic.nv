// stdlib/monotonic.nv — Monotonic clock.
//
// Вынесен из duration.nv в отдельный co-equal файл того же модуля
// `time.duration` (папка = один модуль; import-путь `std.time.duration`
// не меняется). `Duration` — в duration.nv, `Timestamp` — в timestamp.nv.
//
// `Monotonic` — точка во времени относительно непрерывной монотонной
// шкалы (CLOCK_MONOTONIC на Linux/macOS, QueryPerformanceCounter на Windows).
//
// Never goes backwards: immune к NTP adjustments, daylight-saving, system
// time changes. Используется для timer deadlines, profiling intervals,
// retry budgets — везде где «прошло сколько-то времени» важнее даты.
//
// Раздельные типы для wall-clock vs monotonic — type-system запрещает
// случайное использование Timestamp где нужен Monotonic (silent NTP-skew
// bug) и наоборот. Compile-error на смешивание arithmetic operations.

module time.duration

/// Monotonic — момент в монотонной шкале процесса. Never decreases.
///
/// Используется для timer deadlines (`ChanReader.close_at(Monotonic)`),
/// profiling intervals, retry budgets. Immune к NTP/DST/manual clock
/// adjustments.
///
/// Сериализация запрещена — bessmysленно вне процесса (у каждого процесса
/// свой epoch). Для inter-process timestamps используй `Timestamp`.
///
/// # Examples
/// ```nova
/// let start = Monotonic.now()
/// // ... work ...
/// let elapsed = Monotonic.now() - start  // → Duration
/// ```
///
/// `value`-record — stack-allocated, zero-GC.
///
/// `nanos` is `priv` (module-private) — was `ro` (publicly constructible
/// `{ nanos: ... }` from any module, letting external code assemble an
/// arbitrary `Monotonic` — nonsensical outside this process). The
/// real-clock path stays `Monotonic.now()` (via the ambient `Time`
/// effect); a raw-nanoseconds escape hatch for mocks/FFI/benches is
/// `T.to_monotonic_nanos()` below (paired with the pre-existing raw-read
/// `@nanos()` accessor).
#stable(since = "0.6")
export type Monotonic value {
    priv nanos i64
}

/// Текущий монотонный момент. Тонкая ergonomic-обёртка над typed
/// `Time.now_monotonic()` (эффект `Time`, возвращает `Monotonic` напрямую —
/// больше не int-wire + wrap).
/// **Мокабелен:** `with Time = th.mut_clock(...)` подменяет монотонные
/// часы детерминированно.
///
/// # Examples
/// ```nova
/// with Time = th.mut_clock(0 as u64) {
///     ro m0 = Monotonic.now()
///     5.to_seconds().sleep()  // virtual clock advance
///     ro m1 = Monotonic.now()
///     assert(m1.elapsed_since(m0) == 5.to_seconds())
/// }
/// ```
#stable(since = "0.6")
export fn Monotonic.now() Time -> Monotonic => Time.now_monotonic()

/// Raw nanoseconds — escape hatch для FFI / bench. Cросс-процессное
/// сравнение бессмысленно. Cравнение внутри одного процесса допустимо.
#stable(since = "0.6")
export fn Monotonic @nanos() -> i64 => @nanos

/// `T.to_monotonic_nanos()` — construct a `Monotonic` from a raw
/// nanosecond count (any `Ints` width). Write-direction escape hatch
/// pairing `@nanos()` above — needed now that `nanos` is `priv`, for mock
/// `Time` handlers (`std.testing.handlers`) and any other code OUTSIDE
/// `time.duration` that must build a `Monotonic` from a bare integer
/// without going through `Time.now_monotonic()` (which would be circular
/// inside a mock handler body). Cross-process comparison is still
/// meaningless — this constructs a value for the SAME semantics `@nanos()`
/// already reads back out.
///
/// # Examples
/// ```nova
/// let m = 0.to_monotonic_nanos()
/// assert(m.nanos() == 0)
/// ```
#stable(since = "0.6")
export fn[T Ints] T @to_monotonic_nanos() -> Monotonic => { nanos: @ as i64 }

// ── Monotonic arithmetic (NO cross-type ops with Timestamp) ──

/// `Monotonic + Duration → Monotonic` — сдвинуть монотонный момент вперёд
/// (deadline в будущем). **Saturates at boundary**.
#stable(since = "0.6")
export fn Monotonic @plus(d Duration) -> Monotonic =>
    { nanos: sat_add_i64(@nanos, d.nanos, i64.MIN, i64.MAX) }

/// `Monotonic - Duration → Monotonic` — сдвинуть монотонный момент назад
/// (deadline в прошлом или earlier-than-now). **Saturates at boundary**.
///
/// NOTE: для `Monotonic - Monotonic → Duration` используй `elapsed_since`
/// (named method). Operator overload отсутствует, чтобы не конфликтовать
/// с method-resolution на receiver type (см. Эволюция).
#stable(since = "0.6")
export fn Monotonic @minus(d Duration) -> Monotonic =>
    { nanos: sat_sub_i64(@nanos, d.nanos, i64.MIN, i64.MAX) }

/// Elapsed time between two Monotonic points.
///
/// Результат **saturate-to-zero**. Если `self < other` (кажущийся регресс
/// часов — HW/VM/OS-баг, JDK-6458294), возвращает `Duration.ZERO`, НИКОГДА
/// не negative и НИКОГДА не panic (без global-lock — урок Rust 1.60-saga).
/// Для явного детекта регресса используй [`checked_duration_since`] (→ `None`).
///
/// # Examples
/// ```nova
/// let t1 = Monotonic.now()
/// // ... work ...
/// let t2 = Monotonic.now()
/// let elapsed = t2.elapsed_since(t1)  // Duration ≥ 0 (clock не идёт назад)
/// ```
#stable(since = "0.6")
export fn Monotonic @elapsed_since(other Monotonic) -> Duration =>
    if @nanos > other.nanos {
        sat_sub_i64(@nanos, other.nanos, i64.MIN, i64.MAX).to_nanos()
    } else {
        0.to_nanos()
    }

/// Suspend until THIS **monotonic** deadline (метод вместо ретрактированной
/// свободной `sleep_until(deadline)`; MVP-обёртка `sleep(deadline - now)`;
/// drift-free re-arm — future). Только `Monotonic` — не `Timestamp`
/// (wall-дедлайн уязвим к NTP/DST; явная wall-форма — `ts.time_until().sleep()`).
/// Прошедший дедлайн разрешается НЕМЕДЛЕННО (saturate-to-zero).
///
/// # Examples
/// ```nova
/// ro deadline = Monotonic.now() + 5.to_seconds()
/// deadline.sleep_until()
/// ```
#stable(since = "0.1")
export fn Monotonic @sleep_until() Time -> () =>
    @elapsed_since(Monotonic.now()).sleep()

/// `Monotonic - Monotonic → Duration` — operator-overload alias for
/// [`elapsed_since`], symmetric with `Timestamp @minus(Timestamp) ->
/// Duration` above. `m2 - m1` dispatches HERE (not `@minus(Duration)`, the
/// point-shift overload above) — same saturate-to-zero-on-regress contract
/// as `elapsed_since`.
///
/// # Examples
/// ```nova
/// let m1 = Monotonic.now()
/// let m2 = Monotonic.now()
/// let d = m2 - m1  // → Duration, dispatches to @minus(Monotonic)
/// ```
#stable(since = "0.6")
export fn Monotonic @minus(other Monotonic) -> Duration => @elapsed_since(other)

/// Checked elapsed time — `None` при регрессе (`self < other`), иначе
/// `Some(self - other)` (Rust `checked_duration_since`).
#stable(since = "0.6")
export fn Monotonic @checked_duration_since(other Monotonic) -> Option[Duration] =>
    if @nanos < other.nanos {
        None
    } else {
        match @nanos.checked_sub(other.nanos) {
            Some(r) => Some(r.to_nanos()),
            None => None,
        }
    }

// ── Compare ──
//
// @compare single source — operators ==/!=/</<=/>/>= synthesized.
// Magic methods @eq/@lt/@le/@gt/@ge удалены.

/// Compare.compare для Monotonic. Только внутри одного процесса.
#stable(since = "0.6")
export fn Monotonic @compare(other Monotonic) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }

// ── Display / Debug ──
//
// `Monotonic` — process-local offset, NOT a date. `@display`/
// `@debug` show it as a **relative offset**, never as a calendar timestamp
// (unlike `Timestamp`, whose `@display` is RFC-3339 — std/time/civil/format.nv)
// — reading `Monotonic(+1.234s)` must never look like a wall-clock value.

/// Offset form, ASCII (`"+1.234s"`) — never a date.
#stable(since = "0.1")
export fn Monotonic @display(mut f Fmt) -> () {
    f.write("+")
    f.write(@nanos.to_nanos().to_str())
}

/// Diagnostic form: `Monotonic(+1.234s)` — explicitly NOT a date.
#stable(since = "0.1")
export fn Monotonic @debug(mut f Fmt) -> () {
    f.write("Monotonic(+")
    f.write(@nanos.to_nanos().to_str())
    f.write(")")
}

// Note: NO `Monotonic.unix_seconds()`, `Monotonic.from_unix_*()`,
// `Monotonic + Timestamp`, `Monotonic - Timestamp` overloads. Смешивание
// clock-семантики — compile-error через absent overload.
