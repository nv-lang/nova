// stdlib/monotonic.nv — Monotonic clock (Plan 65 Ф.12 / D124).
//
// Plan 200 Step 3 (Пункт 13, D78 co-equal folder-module): вынесен из
// duration.nv в отдельный co-equal файл того же модуля `time.duration`
// (папка = один модуль; import-путь `std.time.duration` не меняется).
// `Duration` — в duration.nv, `Timestamp` — в timestamp.nv.
//
// `Monotonic` — точка во времени относительно непрерывной монотонной
// шкалы (CLOCK_MONOTONIC на Linux/macOS, QueryPerformanceCounter на Windows).
//
// Never goes backwards: immune к NTP adjustments, daylight-saving, system
// time changes. Используется для timer deadlines, profiling intervals,
// retry budgets — везде где «прошло сколько-то времени» важнее даты.
//
// D124 (раздельные типы для wall-clock vs monotonic) — type-system запрещает
// случайное использование Timestamp где нужен Monotonic (silent NTP-skew
// bug) и наоборот. Compile-error на смешивание arithmetic operations.

module time.duration

/// Monotonic — момент в монотонной шкале процесса. Never decreases.
///
/// Используется для timer deadlines (`ChanReader.close_at(Monotonic)`),
/// profiling intervals, retry budgets. Immune к NTP/DST/manual clock
/// adjustments.
///
/// Сериализация запрещена — bessmysленно вне процесса (у каждого процесса
/// свой epoch). Для inter-process timestamps используй `Timestamp`.
///
/// # Examples
/// ```nova
/// let start = Monotonic.now()
/// // ... work ...
/// let elapsed = Monotonic.now() - start  // → Duration
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
#stable(since = "0.6")
export type Monotonic value {
    ro nanos i64
}

/// Текущий монотонный момент. **Plan 175 Ф.3(a) (D316):** ergonomic-сахар
/// над int-wire `Time.now_monotonic_ns()` (эффект `Time`) — тот же паттерн,
/// что `Timestamp.now()` выше. **Мокабелен:** `with Time = th.mut_clock(...)`
/// подменяет монотонные часы детерминированно (закрывает
/// `[M-monotonic-mock-support]`). Заменяет прежний compiler-builtin
/// (4 сайта dispatch/inference в emit_c.rs удалены той же волной — grep
/// `nova_monotonic_now_record`/`"Nova_Monotonic*"` = 0, по норме плана 175 §Ф.3).
///
/// # Examples
/// ```nova
/// with Time = th.mut_clock(0 as u64) {
///     ro m0 = Monotonic.now()
///     Time.sleep(5000)  // virtual clock advance (ms)
///     ro m1 = Monotonic.now()
///     assert(m1.elapsed_since(m0) == 5.to_seconds())
/// }
/// ```
#stable(since = "0.6")
export fn Monotonic.now() Time -> Monotonic =>
    { nanos: Time.now_monotonic_ns() as i64 }

/// Raw nanoseconds — escape hatch для FFI / bench. Cросс-процессное
/// сравнение бессмысленно. Cравнение внутри одного процесса допустимо.
#stable(since = "0.6")
export fn Monotonic @nanos() -> i64 => @nanos

// ── Monotonic arithmetic (D124 rule 3: NO cross-type ops with Timestamp) ──

/// `Monotonic + Duration → Monotonic` — сдвинуть монотонный момент вперёд
/// (deadline в будущем). **Saturates at boundary** (D317).
#stable(since = "0.6")
export fn Monotonic @plus(d Duration) -> Monotonic =>
    { nanos: sat_add_i64(@nanos, d.nanos, i64.MIN, i64.MAX) }

/// `Monotonic - Duration → Monotonic` — сдвинуть монотонный момент назад
/// (deadline в прошлом или earlier-than-now). **Saturates at boundary** (D317).
///
/// NOTE: для `Monotonic - Monotonic → Duration` используй `elapsed_since`
/// (named method). Operator overload отсутствует, чтобы не конфликтовать
/// с method-resolution на receiver type (см. Эволюция).
#stable(since = "0.6")
export fn Monotonic @minus(d Duration) -> Monotonic =>
    { nanos: sat_sub_i64(@nanos, d.nanos, i64.MIN, i64.MAX) }

/// Elapsed time between two Monotonic points.
///
/// **Plan 175 Ф.1c (D318 — non-regression):** результат **saturate-to-zero**.
/// Если `self < other` (кажущийся регресс часов — HW/VM/OS-баг, JDK-6458294),
/// возвращает `Duration.ZERO`, НИКОГДА не negative и НИКОГДА не panic (без
/// global-lock — урок Rust 1.60-saga). Для явного детекта регресса используй
/// [`checked_duration_since`] (→ `None`).
///
/// # Examples
/// ```nova
/// let t1 = Monotonic.now()
/// // ... work ...
/// let t2 = Monotonic.now()
/// let elapsed = t2.elapsed_since(t1)  // Duration ≥ 0 (clock не идёт назад)
/// ```
#stable(since = "0.6")
export fn Monotonic @elapsed_since(other Monotonic) -> Duration =>
    if @nanos > other.nanos {
        sat_sub_i64(@nanos, other.nanos, i64.MIN, i64.MAX).to_nanos()
    } else {
        0.to_nanos()
    }

/// Suspend until THIS **monotonic** deadline (П12-хвост 2026-07-21: метод
/// вместо ретрактированной свободной `sleep_until(deadline)`; Plan 175
/// Ф.3(b), D316 Q3 — MVP-обёртка `sleep(deadline - now)`; drift-free
/// re-arm — future, Plan 66). Только `Monotonic` — не `Timestamp` (D124 §3:
/// wall-дедлайн уязвим к NTP/DST; явная wall-форма — `ts.time_until().sleep()`).
/// Прошедший дедлайн разрешается НЕМЕДЛЕННО (saturate-to-zero, D318).
///
/// # Examples
/// ```nova
/// ro deadline = Monotonic.now() + 5.to_seconds()
/// deadline.sleep_until()
/// ```
#stable(since = "0.1")
export fn Monotonic @sleep_until() Time -> () =>
    @elapsed_since(Monotonic.now()).sleep()

/// `Monotonic - Monotonic → Duration` (Plan 175 Ф.3(c) / D318 Q4) —
/// operator-overload alias for [`elapsed_since`], symmetric with
/// `Timestamp @minus(Timestamp) -> Duration` above. `m2 - m1` dispatches
/// HERE (not `@minus(Duration)`, the point-shift overload above) — same
/// saturate-to-zero-on-regress contract as `elapsed_since`.
///
/// # Examples
/// ```nova
/// let m1 = Monotonic.now()
/// let m2 = Monotonic.now()
/// let d = m2 - m1  // → Duration, dispatches to @minus(Monotonic)
/// ```
#stable(since = "0.6")
export fn Monotonic @minus(other Monotonic) -> Duration => @elapsed_since(other)

/// Checked elapsed time — `None` при регрессе (`self < other`), иначе
/// `Some(self - other)` (Plan 175 Ф.1c / D318; Rust `checked_duration_since`).
#stable(since = "0.6")
export fn Monotonic @checked_duration_since(other Monotonic) -> Option[Duration] =>
    if @nanos < other.nanos {
        None
    } else {
        match @nanos.checked_sub(other.nanos) {
            Some(r) => Some(r.to_nanos()),
            None => None,
        }
    }


// ── Compare (D183 amendment, Plan 91.8a.2 part 3) ──
//
// @compare single source — operators ==/!=/</<=/>/>= synthesized.
// Magic methods @eq/@lt/@le/@gt/@ge удалены.

/// Compare.compare для Monotonic. Только внутри одного процесса.
#stable(since = "0.6")
export fn Monotonic @compare(other Monotonic) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }


// ── Display / Debug (Plan 175 Ф.3(d)/Ф.4, D237) ──
//
// `Monotonic` — process-local offset, NOT a date (D124/D318). `@display`/
// `@debug` show it as a **relative offset**, never as a calendar timestamp
// (unlike `Timestamp`, whose `@display` is RFC-3339 — std/time/civil/format.nv)
// — reading `Monotonic(+1.234s)` must never look like a wall-clock value.

/// Offset form, ASCII (`"+1.234s"`) — never a date. Signature migrated to
/// `Fmt` — Plan 208 Ф.2/D422, [M-208-time-display-fmt-migration-gap].
#stable(since = "0.1")
export fn Monotonic @display(mut f Fmt) -> () {
    f.write("+")
    f.write(@nanos.to_nanos().to_str().bytes())
}

/// Diagnostic form: `Monotonic(+1.234s)` — explicitly NOT a date (D124/D318).
/// Signature migrated to `Fmt` — Plan 208 Ф.2/D422.
#stable(since = "0.1")
export fn Monotonic @debug(mut f Fmt) -> () {
    f.write("Monotonic(+")
    f.write(@nanos.to_nanos().to_str().bytes())
    f.write(")")
}


// Note: NO `Monotonic.unix_seconds()`, `Monotonic.from_unix_*()`,
// `Monotonic + Timestamp`, `Monotonic - Timestamp` overloads. D124 правило 3:
// смешивание clock-семantik — compile-error через absent overload.
