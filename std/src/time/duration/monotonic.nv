// stdlib/monotonic.nv — Monotonic clock (Plan 65 Ф.12 / D124).
//
// Plan 200 Step 3 (Пункт 13, D78 co-equal folder-module): вынесен из
// duration.nv в отдельный co-equal файл того же модуля `time.duration`
// (папка = один модуль; import-путь `std.time.duration` не меняется).
// `Duration` — в duration.nv, `Timestamp` — в timestamp.nv.
//
// `Monotonic` — точка во времени относительно непрерывной монотонной
// шкалы (CLOCK_MONOTONIC на Linux/macOS, QueryPerformanceCounter на Windows).
//
// Never goes backwards: immune к NTP adjustments, daylight-saving, system
// time changes. Используется для timer deadlines, profiling intervals,
// retry budgets — везде где «прошло сколько-то времени» важнее даты.
//
// D124 (раздельные типы для wall-clock vs monotonic) — type-system запрещает
// случайное использование Timestamp где нужен Monotonic (silent NTP-skew
// bug) и наоборот. Compile-error на смешивание arithmetic operations.

module time.duration

/// Monotonic — an instant on the process's monotonic scale. Never decreases.
///
/// Used for timer deadlines (`ChanReader.close_at(Monotonic)`),
/// profiling intervals, retry budgets. Immune to NTP/DST/manual clock
/// adjustments.
///
/// Serialization is forbidden — meaningless across processes (each process
/// has its own epoch). For inter-process timestamps use `Timestamp`.
///
/// # Examples
/// ```nova
/// let start = Monotonic.now()
/// // ... work ...
/// let elapsed = Monotonic.now() - start  // → Duration
/// ```
///
/// **Plan 175 Ф.1b (D316):** `value`-record — stack-allocated, zero-GC.
///
/// **Plan 175.2 Ф.2-v4 (П5, D220 per-field):** `nanos` is `priv` (module-
/// private per D281) since this wave — was `ro` (publicly constructible
/// `{ nanos: ... }` from any module, letting external code assemble an
/// arbitrary `Monotonic` — nonsensical outside this process, D124). The
/// real-clock path stays `Monotonic.now()` (via the ambient `Time`
/// effect); a raw-nanoseconds escape hatch for mocks/FFI/benches is
/// `T.to_monotonic_nanos()` below (paired with the pre-existing raw-read
/// `@nanos()` accessor).
#stable(since = "0.6")
export type Monotonic value {
    priv nanos i64
}

/// The current monotonic instant. **Plan 175 Ф.3 (D316 typed retype):** a thin
/// ergonomic wrapper over the typed `Time.now_monotonic()` (the `Time` effect
/// returns a `Monotonic` directly — no more int-wire + wrap).
/// **Mockable:** `with Time = th.mut_clock(...)` replaces the monotonic
/// clock deterministically (closes `[M-monotonic-mock-support]`).
///
/// # Examples
/// ```nova
/// with Time = th.mut_clock(0 as u64) {
///     ro m0 = Monotonic.now()
///     5.to_seconds().sleep()  // virtual clock advance
///     ro m1 = Monotonic.now()
///     assert(m1.elapsed_since(m0) == 5.to_seconds())
/// }
/// ```
#stable(since = "0.6")
export fn Monotonic.now() Time -> Monotonic => Time.now_monotonic()

/// Raw nanoseconds — escape hatch for FFI / bench. Cross-process comparison is
/// meaningless. Comparison within a single process is allowed.
#stable(since = "0.6")
export fn Monotonic @nanos() -> i64 => @nanos

/// `T.to_monotonic_nanos()` — construct a `Monotonic` from a raw
/// nanosecond count (any `Ints` width). Plan 175.2 Ф.2-v4 (П5): the
/// write-direction escape hatch pairing `@nanos()` above — needed now that
/// `nanos` is `priv` (D220), for mock `Time` handlers (`std.testing.
/// handlers`) and any other code OUTSIDE `time.duration` that must build a
/// `Monotonic` from a bare integer without going through `Time.
/// now_monotonic()` (which would be circular inside a mock handler body).
/// Cross-process comparison is still meaningless (D124) — this constructs
/// a value for the SAME semantics `@nanos()` already reads back out.
///
/// # Examples
/// ```nova
/// let m = 0.to_monotonic_nanos()
/// assert(m.nanos() == 0)
/// ```
#stable(since = "0.6")
export fn[T Ints] T @to_monotonic_nanos() -> Monotonic => { nanos: @ as i64 }

// ── Monotonic arithmetic (D124 rule 3: NO cross-type ops with Timestamp) ──

/// `Monotonic + Duration → Monotonic` — move the monotonic instant forward
/// (a deadline in the future). **Saturates at boundary** (D317).
#stable(since = "0.6")
export fn Monotonic @plus(d Duration) -> Monotonic =>
    { nanos: sat_add_i64(@nanos, d.nanos, i64.MIN, i64.MAX) }

/// `Monotonic - Duration → Monotonic` — move the monotonic instant backward
/// (a deadline in the past or earlier-than-now). **Saturates at boundary** (D317).
///
/// NOTE: for `Monotonic - Monotonic → Duration` use `elapsed_since`
/// (named method). There is no operator overload, to avoid conflicting with
/// method-resolution on the receiver type (see Evolution).
#stable(since = "0.6")
export fn Monotonic @minus(d Duration) -> Monotonic =>
    { nanos: sat_sub_i64(@nanos, d.nanos, i64.MIN, i64.MAX) }

/// Elapsed time between two Monotonic points.
///
/// **Plan 175 Ф.1c (D318 — non-regression):** result **saturate-to-zero**.
/// If `self < other` (an apparent clock regression — HW/VM/OS bug, JDK-6458294),
/// returns `Duration.ZERO`, NEVER negative and NEVER panics (no global-lock —
/// the Rust 1.60-saga lesson). For explicit regression detection use
/// [`checked_duration_since`] (→ `None`).
///
/// # Examples
/// ```nova
/// let t1 = Monotonic.now()
/// // ... work ...
/// let t2 = Monotonic.now()
/// let elapsed = t2.elapsed_since(t1)  // Duration ≥ 0 (clock does not go backward)
/// ```
#stable(since = "0.6")
export fn Monotonic @elapsed_since(other Monotonic) -> Duration =>
    if @nanos > other.nanos {
        sat_sub_i64(@nanos, other.nanos, i64.MIN, i64.MAX).to_nanos()
    } else {
        // Plan 157 (§157): `Duration.ZERO` now resolves (out-of-body
        // qualified assoc-const migration, core.nv) — direct reference
        // instead of the `0.to_nanos()` zero-construct workaround, matching
        // this method's own docstring.
        Duration.ZERO
    }

/// Suspend until THIS **monotonic** deadline (П12-хвост 2026-07-21: a method
/// instead of the retracted free `sleep_until(deadline)`; Plan 175
/// Ф.3(b), D316 Q3 — an MVP wrapper `sleep(deadline - now)`; drift-free
/// re-arm — future, Plan 66). Only `Monotonic` — not `Timestamp` (D124 §3:
/// a wall deadline is vulnerable to NTP/DST; the explicit wall form —
/// `ts.time_until().sleep()`). An already-passed deadline resolves IMMEDIATELY
/// (saturate-to-zero, D318).
///
/// # Examples
/// ```nova
/// ro deadline = Monotonic.now() + 5.to_seconds()
/// deadline.sleep_until()
/// ```
#stable(since = "0.1")
export fn Monotonic @sleep_until() Time -> () =>
    @elapsed_since(Monotonic.now()).sleep()

/// `Monotonic - Monotonic → Duration` (Plan 175 Ф.3(c) / D318 Q4) —
/// operator-overload alias for [`elapsed_since`], symmetric with
/// `Timestamp @minus(Timestamp) -> Duration` above. `m2 - m1` dispatches
/// HERE (not `@minus(Duration)`, the point-shift overload above) — same
/// saturate-to-zero-on-regress contract as `elapsed_since`.
///
/// # Examples
/// ```nova
/// let m1 = Monotonic.now()
/// let m2 = Monotonic.now()
/// let d = m2 - m1  // → Duration, dispatches to @minus(Monotonic)
/// ```
#stable(since = "0.6")
export fn Monotonic @minus(other Monotonic) -> Duration => @elapsed_since(other)

/// Checked elapsed time — `None` on regression (`self < other`), otherwise
/// `Some(self - other)` (Plan 175 Ф.1c / D318; Rust `checked_duration_since`).
#stable(since = "0.6")
export fn Monotonic @checked_duration_since(other Monotonic) -> Option[Duration] =>
    if @nanos < other.nanos {
        None
    } else {
        match @nanos.checked_sub(other.nanos) {
            Some(r) => Some(r.to_nanos()),
            None => None,
        }
    }

// ── Compare (D183 amendment, Plan 91.8a.2 part 3) ──
//
// @compare single source — operators ==/!=/</<=/>/>= synthesized.
// Magic methods @eq/@lt/@le/@gt/@ge удалены.

/// Compare.compare for Monotonic. Only within a single process.
#stable(since = "0.6")
export fn Monotonic @compare(other Monotonic) -> int =>
    if @nanos < other.nanos { -1 }
    else if @nanos > other.nanos { 1 }
    else { 0 }

// ── Display / Debug (Plan 175 Ф.3(d)/Ф.4, D237) ──
//
// `Monotonic` — process-local offset, NOT a date (D124/D318). `@display`/
// `@debug` show it as a **relative offset**, never as a calendar timestamp
// (unlike `Timestamp`, whose `@display` is RFC-3339 — std/time/civil/format.nv)
// — reading `Monotonic(+1.234s)` must never look like a wall-clock value.

/// Offset form, ASCII (`"+1.234s"`) — never a date. Signature migrated to
/// `Fmt` — Plan 208 Ф.2/D422, [M-208-time-display-fmt-migration-gap].
#stable(since = "0.1")
export fn Monotonic @display(mut f Fmt) -> () {
    f.write("+")
    f.write(@nanos.to_nanos().to_str())
}

/// Diagnostic form: `Monotonic(+1.234s)` — explicitly NOT a date (D124/D318).
/// Signature migrated to `Fmt` — Plan 208 Ф.2/D422.
#stable(since = "0.1")
export fn Monotonic @debug(mut f Fmt) -> () {
    f.write("Monotonic(+")
    f.write(@nanos.to_nanos().to_str())
    f.write(")")
}

// Note: NO `Monotonic.unix_seconds()`, `Monotonic.from_unix_*()`,
// `Monotonic + Timestamp`, `Monotonic - Timestamp` overloads. D124 правило 3:
// смешивание clock-семantik — compile-error через absent overload.
