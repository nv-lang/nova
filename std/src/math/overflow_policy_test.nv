// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Plan 206 Ф.2 (D423) — тесты трёх .nv-бланкетов над компиляторным
// интринсиком `@overflowing_add/_sub/_mul` (std/src/prelude/protocols.nv,
// `fn[T Ints] T @checked_*/@saturating_*/@wrapping_*`):
//   - `checked_*`    -> `Option[T]` (overflow -> `None`)
//   - `wrapping_*`   -> `T` (модульная арифметика, флаг игнор)
//   - `saturating_*` -> `T` (клампит к `T.MAX`/`T.MIN`, op-специфичная
//     формула направления — см. план §Дизайн)
//
// Расположение: НЕ рядом с protocols.nv (`std/src/prelude/`) — файлы внутри
// `std.prelude.*` имеют auto-import global prelude отключённым (cycle
// protection, protocols.nv:13-18), что ломает `assert()`-инфраструктуру
// (`Nova_StringBuilder` struct-tag CC-FAIL) для ЛЮБОГО теста в этом
// namespace — pre-existing gap, не specific для Ф.2 (в prelude.* до сих пор
// не было ни одного *_test.nv). Тесты бланкетов живут здесь, рядом с
// numeric/math-поверхностью, где обычный implicit-prelude работает.
//
// Все receiver'ы — типизированные локали (`ro a i32 = ...`), НЕ inline
// конверсия-вызов (`i32(10).checked_add(...)`): последнее бьётся в
// pre-existing `[P67-LEGACY] method call return type unknown` ICE
// (emit_c.rs:51424) для generic type-set-bound бланкетов, когда receiver
// сам — Call-выражение (obj_ty не выводится для чейна на Call). Не задевает
// реальный overflow-migration-код (fnv/bloom_filter/md5/sha1/sha256/xoshiro)
// — там receiver'ы везде уже типизированные локали/поля, не inline-конверсии.
//
// [M-option-eq-some-literal-elem-adapt] (backlog-followups.md, OPEN,
// pre-existing P2, Plan 172.2): `Option[T] == Some(int-литерал)` не
// адаптирует литерал к `T` для sized не-`int` T → CC-FAIL
// (`NovaOpt_nova_int` vs `NovaOpt_int32_t`). Обход — тот же, что в
// зарегистрированном followup: типизированная локаль вместо голого
// литерала внутри `Some(...)`.
module math.overflow_policy_test

test "Ф.2: checked_add — Some при no-overflow, None при overflow (signed+unsigned)" {
    ro a i32 = 10
    ro fifteen i32 = 15
    assert(a.checked_add(5) == Some(fifteen))
    ro amax i32 = i32.MAX
    assert(amax.checked_add(1) == None)
    ro b u8 = 250
    ro u255 u8 = 255
    assert(b.checked_add(5) == Some(u255))
    assert(b.checked_add(6) == None)
    ro cmin i8 = i8.MIN
    assert(cmin.checked_add(-1) == None)
}

test "Ф.2: checked_sub — Some при no-overflow, None при overflow (signed+unsigned)" {
    ro a i32 = 10
    ro five i32 = 5
    assert(a.checked_sub(5) == Some(five))
    ro bmin i8 = i8.MIN
    assert(bmin.checked_sub(1) == None)
    ro c u8 = 0
    assert(c.checked_sub(1) == None)
    ro d u8 = 5
    ro zero u8 = 0
    assert(d.checked_sub(5) == Some(zero))
}

test "Ф.2: checked_mul — Some при no-overflow, None при overflow" {
    ro a i32 = 6
    ro forty_two i32 = 42
    assert(a.checked_mul(7) == Some(forty_two))
    ro bmax i8 = i8.MAX
    assert(bmax.checked_mul(2) == None)
    ro c u8 = 100
    assert(c.checked_mul(3) == None)
    ro d u8 = 10
    ro twenty u8 = 20
    assert(d.checked_mul(2) == Some(twenty))
}

test "Ф.2: wrapping_add/_sub/_mul — модульная арифметика, без паники" {
    ro a u8 = 250
    assert(a.wrapping_add(10) == 4)
    ro bmax i8 = i8.MAX
    assert(bmax.wrapping_add(1) == i8.MIN)
    ro c u8 = 0
    assert(c.wrapping_sub(1) == u8.MAX)
    ro dmin i8 = i8.MIN
    assert(dmin.wrapping_sub(1) == i8.MAX)
    ro e u8 = 100
    assert(e.wrapping_mul(3) == 44)
    // 2_000_000_000 + 2_000_000_000 = 4_000_000_000 = 2^32 - 294_967_296 -> wraps to -294_967_296
    ro f i32 = 2_000_000_000
    assert(f.wrapping_add(2_000_000_000) == -294_967_296)
}

test "Ф.2: saturating_add — клампит по знаку rhs (add-формула), signed+unsigned" {
    ro a i32 = 10
    assert(a.saturating_add(5) == 15)
    ro bmax i8 = i8.MAX
    assert(bmax.saturating_add(1) == i8.MAX)
    ro cmin i8 = i8.MIN
    assert(cmin.saturating_add(-1) == i8.MIN)
    ro d u8 = 250
    assert(d.saturating_add(10) == u8.MAX)
}

test "Ф.2: saturating_sub — клампит по знаку rhs (sub-формула: rhs<0 -> MAX)" {
    ro a i32 = 10
    assert(a.saturating_sub(5) == 5)
    ro bmin i8 = i8.MIN
    assert(bmin.saturating_sub(1) == i8.MIN)
    ro cmax i8 = i8.MAX
    assert(cmax.saturating_sub(-1) == i8.MAX)
    ro d u8 = 0
    assert(d.saturating_sub(1) == 0)
}

test "Ф.2: saturating_mul — клампит по знаку операндов (одинаковый знак -> MAX)" {
    ro a i32 = 6
    assert(a.saturating_mul(7) == 42)
    ro bmax i8 = i8.MAX
    assert(bmax.saturating_mul(2) == i8.MAX)
    ro cmin i8 = i8.MIN
    assert(cmin.saturating_mul(2) == i8.MIN)
    ro dmax i8 = i8.MAX
    assert(dmax.saturating_mul(-2) == i8.MIN)
    ro e u8 = 100
    assert(e.saturating_mul(3) == u8.MAX)
}

// ── Plan 206.1 (D427): div/rem/neg policy wrappers ──────────────────────

test "206.1: checked_div — Some при no-overflow, None на /0 и MIN/-1 (signed+unsigned)" {
    ro a i32 = 10
    ro five i32 = 5
    assert(a.checked_div(2) == Some(five))
    ro amin i32 = i32.MIN
    assert(amin.checked_div(-1) == None)
    assert(a.checked_div(0) == None)
    ro b u32 = 10
    ro bfive u32 = 5
    assert(b.checked_div(2) == Some(bfive))
    assert(b.checked_div(0) == None)
}

test "206.1: checked_rem — Some при no-overflow, None на /0 и MIN/-1 (signed+unsigned)" {
    ro a i32 = 10
    ro zero i32 = 0
    assert(a.checked_rem(2) == Some(zero))
    ro one i32 = 1
    assert(a.checked_rem(3) == Some(one))
    ro amin i32 = i32.MIN
    assert(amin.checked_rem(-1) == None)
    assert(a.checked_rem(0) == None)
    ro b u32 = 10
    ro btwo u32 = 2
    assert(b.checked_rem(4) == Some(btwo))
    assert(b.checked_rem(0) == None)
}

test "206.1: wrapping_div — MIN/-1 wraps к MIN вместо паники; обычное деление байт-паритет" {
    ro a i32 = 10
    assert(a.wrapping_div(2) == 5)
    ro amin i32 = i32.MIN
    assert(amin.wrapping_div(-1) == i32.MIN)
    ro b u32 = 10
    assert(b.wrapping_div(2) == 5)
}

test "206.1: wrapping_rem — MIN/-1 wraps к 0 (истинный остаток); обычное деление байт-паритет" {
    ro a i32 = 10
    assert(a.wrapping_rem(3) == 1)
    ro amin i32 = i32.MIN
    assert(amin.wrapping_rem(-1) == 0)
    ro b u32 = 10
    assert(b.wrapping_rem(4) == 2)
}

test "206.1: checked_neg — signed None только на MIN, unsigned None кроме 0" {
    ro a i32 = 5
    ro neg_five i32 = -5
    assert(a.checked_neg() == Some(neg_five))
    ro amin i32 = i32.MIN
    assert(amin.checked_neg() == None)
    ro b u32 = 0
    assert(b.checked_neg() == Some(b))
    ro c u32 = 5
    assert(c.checked_neg() == None)
}

test "206.1: wrapping_neg — не паникует никогда; signed MIN -> MIN, unsigned two's-complement wraparound" {
    ro a i32 = 5
    assert(a.wrapping_neg() == -5)
    ro amin i32 = i32.MIN
    assert(amin.wrapping_neg() == i32.MIN)
    ro b u32 = 0
    assert(b.wrapping_neg() == 0)
    ro c u8 = 1
    ro u255 u8 = 255
    assert(c.wrapping_neg() == u255)
}

// ── Raw-operator always-on trap (D427 §R1/§R2) — pin-тесты паники ──────

test "206.1: raw `/` — division by zero panics (int)" panics "division by zero" {
    ro a = 10
    ro b = 0
    ro _r = a / b
}

test "206.1: raw `/` — division by zero panics (sized i32, не только безграничный int)" panics "division by zero" {
    ro a i32 = 10
    ro b i32 = 0
    ro _r = a / b
}

test "206.1: raw `/` — division by zero panics (unsigned u32)" panics "division by zero" {
    ro a u32 = 10
    ro b u32 = 0
    ro _r = a / b
}

test "206.1: raw `/` — MIN/-1 division overflow panics (int)" panics "division overflow" {
    ro a = int.MIN
    ro b = -1
    ro _r = a / b
}

test "206.1: raw `/` — MIN/-1 division overflow panics (sized i32)" panics "division overflow" {
    ro a i32 = i32.MIN
    ro b i32 = -1
    ro _r = a / b
}

test "206.1: raw `%` — MIN/-1 remainder overflow panics identically to `/` (x86 idiv fault)" panics "division overflow" {
    ro a i32 = i32.MIN
    ro b i32 = -1
    ro _r = a % b
}

test "206.1: raw `/=` compound-assign — division by zero panics" panics "division by zero" {
    mut a i32 = 10
    ro b i32 = 0
    a /= b
}

test "206.1: raw unary `-` — negation overflow panics on signed MIN" panics "negation overflow" {
    ro a i32 = i32.MIN
    ro _r = -a
}

test "206.1: raw unary `-` — unsigned negation does NOT panic (still raw wraparound, D427 §R2)" {
    ro a u32 = 5
    ro _r = -a
}

// Plan 200 Step 0 (D74 amend): `@clamp` — бланкет над `Ints`, вытесняет старый
// конкретный `int @clamp` (std/runtime/defaults.nv). Multi-width + lo>hi edge.

test "Step 0/D74: clamp — Ints-бланкет multi-width (i64/u32/i8), в диапазоне/выше/ниже" {
    ro a i64 = 15
    assert(a.clamp(0, 10) == 10)          // выше hi -> hi
    ro b i64 = 5
    assert(b.clamp(0, 10) == 5)           // в диапазоне -> сам
    ro c i64 = -3
    assert(c.clamp(0, 10) == 0)           // ниже lo -> lo

    ro d u32 = 300
    assert(d.clamp(0, 255) == 255)        // unsigned: выше hi -> hi
    ro e u32 = 100
    assert(e.clamp(50, 255) == 100)       // в диапазоне -> сам
    ro f u32 = 10
    assert(f.clamp(50, 255) == 50)        // ниже lo -> lo

    ro g i8 = i8.MAX
    assert(g.clamp(0, 100) == 100)        // i8-ширина: выше hi -> hi (не overflow)
    ro h i8 = i8.MIN
    assert(h.clamp(-100, 0) == -100)      // ниже lo -> lo
}

test "Step 0/D74: clamp — lo>hi edge (контракт 1:1 со старым int @clamp)" {
    // lo>hi: `@ < lo` проверяется первым -> для @ в (hi, lo) результат = @ сам
    // (не паника, не lo/hi) — тот же порядок проверок, что был у конкретного
    // int @clamp до ретракта.
    ro a i64 = 5
    assert(a.clamp(10, 0) == 10)          // 5 < lo=10 -> lo (первая ветка; при lo>hi @ не возвращается никогда)
    ro b i64 = 20
    assert(b.clamp(10, 0) == 0)           // 20 не < 10, но > 0 -> hi=0
    ro c i64 = -5
    assert(c.clamp(10, 0) == 10)          // -5 < 10 -> lo=10
}

// ── [Числовой паритет, 2026-07-19] f64/f32 @clamp — concrete (float ∉ Ints,
// не бланкет), std/runtime/defaults.nv. f32 @clamp был добавлен этой волной
// (зеркало f64, ранее отсутствовал). Тот же контракт-порядок (`@ < lo`
// первой веткой), что у Ints-бланкета выше.

test "Числовой паритет: f64 @clamp — в диапазоне/выше/ниже + lo>hi edge" {
    ro a f64 = 1.5
    assert(a.clamp(0.0, 10.0) == 1.5)      // в диапазоне -> сам
    ro b f64 = 15.0
    assert(b.clamp(0.0, 10.0) == 10.0)     // выше hi -> hi
    ro c f64 = -5.0
    assert(c.clamp(0.0, 10.0) == 0.0)      // ниже lo -> lo
    ro d f64 = 5.0
    assert(d.clamp(10.0, 0.0) == 10.0)     // lo>hi: @ < lo=10 -> lo (тот же порядок, что Ints/int)
}

test "Числовой паритет: f32 @clamp — зеркало f64, в диапазоне/выше/ниже + lo>hi edge" {
    ro a f32 = 1.5
    assert(a.clamp(0.0, 10.0) == 1.5)      // в диапазоне -> сам
    ro b f32 = 15.0
    assert(b.clamp(0.0, 10.0) == 10.0)     // выше hi -> hi
    ro c f32 = -5.0
    assert(c.clamp(0.0, 10.0) == 0.0)      // ниже lo -> lo
    ro d f32 = 5.0
    assert(d.clamp(10.0, 0.0) == 10.0)     // lo>hi: @ < lo=10 -> lo
}

// ── [Числовой паритет, 2026-07-19] SignedInts @signum/@is_negative/
// @is_positive — были concrete-только-на-`int` (D74), теперь бланкет над
// `SignedInts` (i8/i16/i32/i64/int). Тела — чистые сравнения, никакого
// overflow-риска (в отличие от `abs`, который НЕ добирался — см. отчёт).

test "Числовой паритет: signum — знак значения на всех SignedInts-ширинах" {
    ro a int = 5
    assert(a.signum() == 1)
    ro b int = -5
    assert(b.signum() == -1)
    ro c int = 0
    assert(c.signum() == 0)

    ro d i64 = 5
    ro one_i64 i64 = 1
    assert(d.signum() == one_i64)
    ro e i64 = -5
    ro neg_one_i64 i64 = -1
    assert(e.signum() == neg_one_i64)

    ro f i8 = i8.MIN
    ro neg_one_i8 i8 = -1
    assert(f.signum() == neg_one_i8)       // signum само не переполняется (сравнение, не арифметика)
    ro g i16 = 0
    ro zero_i16 i16 = 0
    assert(g.signum() == zero_i16)
    ro h i32 = 7
    ro one_i32 i32 = 1
    assert(h.signum() == one_i32)
}

test "Числовой паритет: is_negative/is_positive — строгие проверки знака на всех SignedInts-ширинах" {
    ro a int = -1
    assert(a.is_negative())
    assert(!a.is_positive())
    ro b int = 0
    assert(!b.is_negative())
    assert(!b.is_positive())
    ro c int = 1
    assert(!c.is_negative())
    assert(c.is_positive())

    ro d i64 = i64.MIN
    assert(d.is_negative())
    ro e i32 = i32.MAX
    assert(e.is_positive())
    ro f i16 = 0
    assert(!f.is_negative() && !f.is_positive())
    ro g i8 = -1
    assert(g.is_negative())
}

// ── [Числовой паритет, 2026-07-19] f64.MIN/f32.MIN — codegen-баг (найден
// этой волной): "MIN" уже проходил чекер generic'ом для ЛЮБОГО numeric-типа,
// но падал на C-компиляции (не было записи в emit_c.rs
// numeric_type_constant_mapping). Rust-паритет: MIN = most-negative-FINITE
// (`-MAX`), НЕ путать с уже существовавшим `MIN_POSITIVE`.

test "Числовой паритет: f64.MIN/f32.MIN — most-negative-finite, отличается от MIN_POSITIVE" {
    assert(f64.MIN == -f64.MAX)
    assert(f32.MIN == -f32.MAX)
    assert(f64.MIN < f64.MIN_POSITIVE)
    assert(f32.MIN < f32.MIN_POSITIVE)
    assert(f64.MIN.is_finite())
    assert(f32.MIN.is_finite())
}

// ── [Числовой паритет-2, 2026-07-20] `abs`/`checked_abs`/`saturating_abs`/
// `wrapping_abs` над `SignedInts` — `int @abs()` retracted от старого extern
// "nova" -> C `llabs` (UB на `T.MIN`), заменён `.nv`-бланкетом, который
// трапит на `T.MIN` через УЖЕ существующий unary-negate trap guard (D427
// §R2, "negation overflow") — не новая overflow-политика. Узкие signed
// (i8/i16/i32/i64) получают `abs` впервые.

test "Числовой паритет-2: abs — обычные значения (int/sized signed), без overflow" {
    ro a int = -5
    assert(a.abs() == 5)
    ro b int = 42
    assert(b.abs() == 42)
    ro c i32 = -2147483647
    ro c_abs i32 = 2147483647
    assert(c.abs() == c_abs)
    ro d i8 = -100
    ro d_abs i8 = 100
    assert(d.abs() == d_abs)
    ro e i64 = 0
    assert(e.abs() == 0)
}

test "Числовой паритет-2: abs — int.MIN трапит (было UB через llabs, теперь честный trap)" panics "negation overflow" {
    ro a = int.MIN
    ro _r = a.abs()
}

test "Числовой паритет-2: abs — i32.MIN трапит (узкий signed, раньше abs вовсе не было)" panics "negation overflow" {
    ro a i32 = i32.MIN
    ro _r = a.abs()
}

test "Числовой паритет-2: checked_abs/saturating_abs/wrapping_abs — MIN-edge (None/MAX/MIN) + обычные" {
    ro amin i8 = i8.MIN
    assert(amin.checked_abs() == None)
    ro amax i8 = i8.MAX
    assert(amin.saturating_abs() == amax)
    assert(amin.wrapping_abs() == amin)

    ro bmin i32 = i32.MIN
    assert(bmin.checked_abs() == None)
    ro bmax i32 = i32.MAX
    assert(bmin.saturating_abs() == bmax)
    assert(bmin.wrapping_abs() == bmin)

    ro c i32 = -7
    ro c_abs i32 = 7
    assert(c.checked_abs() == Some(c_abs))
    assert(c.saturating_abs() == c_abs)
    assert(c.wrapping_abs() == c_abs)
    ro d int = 9
    assert(d.checked_abs() == Some(d))
    assert(d.saturating_abs() == d)
    assert(d.wrapping_abs() == d)
}

// ── [Числовой паритет-2, 2026-07-20] `saturating_neg` над `SignedInts` —
// Rust даёт её ТОЛЬКО signed-типам (в отличие от `checked_neg`/
// `wrapping_neg`, которые остаются `Ints`-бланкетами выше).

test "Числовой паритет-2: saturating_neg — MIN клампит к MAX, обычные не трогает" {
    ro amin i8 = i8.MIN
    ro amax i8 = i8.MAX
    assert(amin.saturating_neg() == amax)
    ro bmin i32 = i32.MIN
    ro bmax i32 = i32.MAX
    assert(bmin.saturating_neg() == bmax)
    ro c i32 = 5
    ro neg_five i32 = -5
    assert(c.saturating_neg() == neg_five)
    ro d i32 = -5
    ro five i32 = 5
    assert(d.saturating_neg() == five)
    ro e int = 0
    assert(e.saturating_neg() == 0)
}

// ── [Числовой паритет-2, 2026-07-20] Целочисленный `pow`/`checked_pow`/
// `saturating_pow`/`wrapping_pow` над `Ints` — раньше не было вообще ни в
// каком виде. `exp` — `u32` (Rust-паритет). `pow` трапит на overflow
// (сырой `*`, D423 §R3), тот же trap-дефолт, что `+`/`-`/`*`.

test "Числовой паритет-2: pow — 0/1/обычные степени, signed+unsigned, без overflow" {
    ro a i32 = 5
    assert(a.pow(0) == 1)
    assert(a.pow(1) == 5)
    ro b i32 = 2
    assert(b.pow(10) == 1024)
    ro z i32 = 0
    assert(z.pow(0) == 1)          // 0^0 == 1 (математическая конвенция, Rust-паритет)
    ro c u8 = 2
    ro c_pow u8 = 128
    assert(c.pow(7) == c_pow)      // 2^7 = 128, ровно на границе u8 (не overflow)
    ro d int = -3
    assert(d.pow(3) == -27)
}

test "Числовой паритет-2: pow — i32 2^31 трапит (integer overflow: *, D423 trap-дефолт)" panics "integer overflow: *" {
    ro a i32 = 2
    ro _r = a.pow(31)
}

test "Числовой паритет-2: checked_pow — None при overflow на любом шаге squaring, Some иначе" {
    ro a i32 = 2
    ro a_pow i32 = 1024
    assert(a.checked_pow(10) == Some(a_pow))
    assert(a.checked_pow(31) == None)          // 2^31 > i32.MAX
    ro b u8 = 2
    assert(b.checked_pow(8) == None)           // 2^8 = 256 > u8.MAX (переполнение в base-squaring шаге)
    ro c u8 = 2
    ro c_pow u8 = 128
    assert(c.checked_pow(7) == Some(c_pow))
}

test "Числовой паритет-2: saturating_pow — знак ИСХОДНОГО @ + чётность exp определяют MIN/MAX" {
    ro a i32 = 2
    ro a_max i32 = i32.MAX
    assert(a.saturating_pow(31) == a_max)       // positive base -> MAX
    ro b i8 = 5
    ro b_max i8 = i8.MAX
    assert(b.saturating_pow(4) == b_max)        // 5^4=625 > i8.MAX(127) -> MAX
    ro c i8 = -3
    ro c_min i8 = i8.MIN
    assert(c.saturating_pow(5) == c_min)        // (-3)^5=-243 < i8.MIN(-128), exp нечётный -> MIN
    ro d u8 = 2
    ro d_max u8 = u8.MAX
    assert(d.saturating_pow(8) == d_max)        // unsigned: @<0 константно false -> всегда MAX
}

test "Числовой паритет-2: wrapping_pow — модульно на каждом шаге squaring, никогда не паникует" {
    ro a u8 = 2
    ro zero u8 = 0
    assert(a.wrapping_pow(8) == zero)           // 2^8 = 256 mod 256 = 0
    ro b i32 = 2
    assert(b.wrapping_pow(31) == i32.MIN)       // 2^31 mod 2^32, представлено как i32 -> i32.MIN
    ro c i32 = 3
    assert(c.wrapping_pow(3) == 27)             // обычный случай — байт-паритет с pow
}
