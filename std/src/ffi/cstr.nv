// SPDX-License-Identifier: MIT OR Apache-2.0
//
// CStr — newtype для C-string FFI. Copy-based rewrite: conversions COPY;
// `@to_cstr` — два overload'а.
//
// Nova `str` carries NO trailing-NUL guarantee — `str` is a pure
// `{ptr,len}` UTF-8 view/buffer, full stop, for literals AND runtime-built
// strings AND slices alike. There is nothing to peek or reuse zero-copy:
// converting a `str` to a C-string is ALWAYS an explicit copy into a
// NUL-terminated buffer, done through `str.to_cstr()`.
//
// Two overloads (arity overload; `to_` = copying conversion, matching the
// `@to_char` / `@to_bytes` convention — `as_` was wrong for a copy):
//   - `@to_cstr() -> CStr`               — GC-allocates a fresh len+1 buffer.
//   - `@to_cstr(buf, buf_size) -> CStr`  — zero-alloc, copies into a
//                                          caller-provided buffer (hot FFI paths).

module ffi.cstr

import std.runtime.raw_mem.{RawMem}

/// Opaque C-string handle. Wraps raw `*u8` pointer; instances satisfy the
/// null-terminator invariant `ptr[strlen(ptr)] == '\0'`. `str` never carries
/// a trailing NUL, so this invariant is established BY the `to_cstr`
/// constructor (a fresh copy + terminator), never inherited from the source
/// `str`'s storage.
///
/// Created via `str.to_cstr()` / `str.to_cstr(buf, buf_size)`.
/// ABI: FFI-marshalled to `const char*` (or `char*` for mutable C-string
/// contexts via dedicated mut variant — not in V1).
///
/// **Lifetime warning**: the pointer is valid only while its backing buffer
/// is alive. For `@to_cstr()` the buffer is GC-managed (conservative
/// stack-scan keeps it alive while the CStr — or a copy of its raw pointer —
/// is reachable from the stack). For `@to_cstr(buf, buf_size)` the buffer is
/// the caller's `buf`, valid for exactly as long as the caller keeps it
/// alive. Pass directly to a C-call or keep the owner alive across the call;
/// do not extract and outlive the raw `*u8`.
#stable(since = "0.1")
export type CStr(*u8)

// str → CStr conversions (both COPY — a `str` is a pure `ptr[len]` view with
// no terminator, so there is no zero-copy path).

/// GC-allocating copy: builds a fresh `byte_len()+1`-byte GC-managed buffer,
/// copies the string's bytes, and appends a `\0` terminator. Scans for an
/// embedded NUL first and panics if one is found — an interior 0x00 would
/// silently truncate the C-string, a classic FFI footgun. `panic` is an
/// always-available compiler intrinsic — needs no import.
export fn str @to_cstr() -> CStr {
    ro bytes = @bytes()
    for b in bytes {
        if b == 0 {
            panic("to_cstr: embedded NUL byte in str (would truncate C-string)")
        }
    }
    mut buf = []u8.new(cap: @byte_len() + 1)
    buf.append(bytes)
    buf.push(0 as u8)
    // No `unsafe`: obtaining the buffer pointer (`.ptr()`) and wrapping it in the
    // `CStr` newtype are both safe — the unsafety is in DEREFERENCING the CStr at
    // the C-FFI boundary, not in its construction (mirrors Rust `Vec::as_ptr`).
    CStr(buf.ptr())
}

/// Zero-alloc copy into a caller-provided buffer, for hot FFI paths that want
/// to avoid a per-call allocation. Copies at most `buf_size - 1` bytes and
/// writes the `\0` terminator at that offset, so the result always fits in
/// `buf_size` bytes (TRUNCATING if the string is longer — no panic, no
/// embedded-NUL scan; this is the explicit "I own the buffer" hot path).
///
/// The `.min(buf_size - 1)` clamp is load-bearing: without it the terminator
/// write would land out-of-bounds on a truncated copy. `buf` must point to at
/// least `buf_size` writable bytes (a raw-pointer precondition the caller owns).
export fn str @to_cstr(buf *mut u8, buf_size int) -> CStr
    requires buf_size > 0
{
    ro n = @byte_len().min(buf_size - 1)
    unsafe {
        RawMem.copy(@ptr(), buf, n)
        buf.write_at(n, 0 as u8)
    }
    CStr(buf)
}
