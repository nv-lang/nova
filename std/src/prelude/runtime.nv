// std/prelude/runtime.nv — runtime functions: panic, exit, assert, print, println.
// Все declarations — `extern "nova" fn` (zero imports), dispatch через codegen
// special-case в emit_c.rs.

module prelude.runtime

// ──────────────────────────────────────────────────────────────────────────
// Runtime functions
// ──────────────────────────────────────────────────────────────────────────

/// Аварийное завершение fiber'а с сообщением. Внутри fiber'а маршрутизируется
/// через ближайший обработчик, на main flow с test-frame'ом — в test-runner,
/// без supervisor'а — abort process. `-> never` позволяет panic быть веткой
/// без значения (например, `?? panic(...)`).
#stable(since = "0.1")
extern "nova" fn panic(msg str) -> never

/// Аварийное завершение всего процесса с exit-code и сообщением. Не
/// перехватывается handler'ом. В тестах маршрутизируется через test-runner,
/// чтобы один тест не убил всю прогонку.
#stable(since = "0.1")
extern "nova" fn exit(code int, msg str) -> never

/// Marker для логически недостижимого кода. Срабатывает только если
/// invariant нарушен — компилятор сам не может доказать недостижимость.
/// Семантически идентичен `panic("unreachable: ${reason}")`, но выражает
/// намерение: «эта точка не должна быть достигнута никогда».
///
/// **Когда использовать:**
/// - После `match` по полному перечислению (когда компилятор не выводит
///   exhaustiveness — например при guards)
/// - В default-branch для ветки, исключённой инвариантом выше
/// - В качестве placeholder'а для невозможной комбинации параметров
///
/// **Не использовать для:**
/// - TODO-stub'а — это `panic("todo")`
/// - Validation user input — это `Fail[E]` через `throw`
///
/// Работает в expression-position в любом if/match, например
/// `let x = if cond { compute() } else { unreachable("inv broken") }`.
#stable(since = "0.1")
// extern "nova" (not a Nova body) — lowers in codegen's special-case to
// C concat helpers, avoiding StringBuilder dependency under #no_prelude.
extern "nova" fn unreachable(reason str) -> never

/// Runtime-проверка условия. Падает с auto-generated сообщением
/// (текст условия через display) если `cond == false`. Always-on:
/// в release-сборке тоже срабатывает.
///
/// Формат: `<file>:<line>: assert failed: <expr>` (без msg) либо
/// `<file>:<line>: assert failed: <msg> (<expr>)` (с msg).
///
/// Обе формы через arity overload: `assert(cond)` — без сообщения,
/// `assert(cond, msg)` — msg печатается перед выражением в скобках.
#stable(since = "0.1")
extern "nova" fn assert(cond bool) -> ()
#stable(since = "0.1")
extern "nova" fn assert(cond bool, msg str) -> ()

/// Печать всех аргументов в stdout без разделителя и без trailing newline.
/// Принимает heterogeneous args (int / str / bool / f64 / mixed).
///
/// # Examples
/// ```nova
/// print("hello")              // → "hello"
/// print("x = ", 42)           // → "x = 42"
/// print("a=", 1, " b=", true) // → "a=1 b=true"
/// ```
#stable(since = "0.1")
extern "nova" fn print(...items []any) -> ()

/// Печать всех аргументов в stdout + trailing newline ('\n'). Идентично
/// `print(...)`, плюс новый перевод строки в конце.
///
/// # Examples
/// ```nova
/// println("hello")                                  // → "hello\n"
/// println(factorial(5).to_str())                     // → "120\n"
/// println("count=", n, " total=", sum)              // mixed-type ok
/// ```
#stable(since = "0.1")
extern "nova" fn println(...items []any) -> ()

/// Подавленные ошибки, сопровождавшие последнюю пойманную ошибку.
/// Cleanup-fail во время propagation НЕ подменяет primary — primary отдаётся
/// ловящему как есть (типизированная ловля `with Fail[Primary]` работает,
/// эффект НЕ становится `Fail[MultiError]`); подавленные лежат «в кармане»
/// и достаются этим аксессором после ловли.
///
/// Возвращает `[]any` в хронологическом порядке аварий (первая-упавшая
/// первой); каждый элемент — `any`, сужается через `is T` / `.try_as[T]()`.
/// Пустой массив = cleanup не падал (карман пуст). Карман сбрасывается на
/// каждый свежий `throw` и заполняется в момент ловли, поэтому не течёт
/// между несвязанными ловлями.
///
/// # Examples
/// ```nova
/// mut primary_code = 0
/// with Fail[DbErr] = effect Fail[DbErr] { fail(e) -> never { primary_code = e.code } } {
///     do_tx()            // тело кинуло DbErr; @cleanup кинул Cleanup2
/// }
/// for s in suppressed() {          // == [Cleanup2]
///     if s is Cleanup2 { Log.warn("cleanup failed") }
/// }
/// ```
#stable(since = "0.1")
extern "nova" fn suppressed() -> []any
