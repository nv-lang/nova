// std/prelude/protocols.nv — file-based source of truth для prelude
// conversion / equality / ordering / hashing / display protocols.
//
// Декларации в этом файле, чтобы:
//   1) `nova doc` показывал canonical API в одном месте,
//   2) пользователь мог shadow'ить эти names с warning'ом,
//   3) splittable prelude работал (`#prelude(protocols)` opt-in).
//
// Один explicit import: `std.prelude.core.Ordering` для signature
// `cmp(other Self) -> Ordering`. `std.prelude.core` не импортирует обратно
// `std.prelude.protocols` — cycle отсутствует.
//
// **Ретрактировано:** `From[T]` / `Into[U]` / `TryFrom[T, E]` /
// `TryInto[U, E]` — остаётся конвенция имён (не протокол).
// **`Hash`** — `hash() -> u64` only (split из combined hash+eq).
// **`Equal`** — `eq(other Self) -> bool` (split).
// **`Compare`** — `cmp(other Self) -> Ordering`.
// **`Display`** — DEFER: зависит от StringBuilder (opaque runtime type).

module prelude.protocols

// Ordering sum-type удалён; Compare.compare возвращает int (< 0 / 0 / > 0).

// `Fmt`'s `@align()` axis reuses the same `Align` enum as
// `StringBuilder.@pad_in_place`/`@write_padded`. `Sign`/`FmtKind` live in
// `runtime.fmt_buf` — it is `#no_prelude` so this import does not reopen
// the prelude → collections → string_builder cycle.
import std.runtime.fmt_buf.{Align, Sign, FmtKind}

// Primitive `@display`/`@debug` bodies below call the `*_display_spec`
// family from `runtime.string_builder` — the single-source-of-truth render
// engine. `string_builder.nv` is `#no_prelude` and does not import back.
import std.runtime.string_builder.{StringBuilder, int_display_spec, f64_display_spec, f32_display_spec, bool_display_spec, char_display_spec, char_debug_display_spec, str_debug_display_spec}

// [M-numeric-try-narrowing]: `RangeError` — return type of
// `try_to_<T>` checked-narrowing family further down.
// `std.prelude.errors` has ZERO imports (no cycle risk).
import std.prelude.errors.{RangeError}

// ──────────────────────────────────────────────────────────────────────────
// Equality / Hashing / Ordering protocols (D109)
// ──────────────────────────────────────────────────────────────────────────

/// Хэшируемые типы — для `HashMap[K, ...]` / `HashSet[K]`.
///
/// `Hash` определяет только `hash() -> u64`, equality вынесена
/// в отдельный `Equal`. `[K Hash]` — достаточно для lookup'а до collision
/// check, `[K Hash + Equal]` — полный contract.
///
/// Примитивы (`int`/`str`/`bool`/`char`/числовые) — auto-hashable.
/// Именованные типы должны явно реализовать `fn T @hash() -> u64`.
///
/// # Examples
///
/// ```nova
/// type UserId { value u64 }
/// fn UserId @hash() -> u64 => @value
/// // UserId теперь удовлетворяет Hash structurally.
/// ```
#stable(since = "0.1")
export type Hash protocol {
    @hash() -> u64
}

/// Равенство. `Self == Self` через явный метод.
/// Если тип satisfies Compare, @equal auto-synthesized через compare;
/// иначе implementer пишет @equal явно.
/// Operators ==/!= synthesized автоматически.
///
/// # Examples
///
/// ```nova
/// // Type only Equal (no order):
/// type Vector3 { x f64, y f64, z f64 }
/// fn Vector3 @equal(other Vector3) -> bool =>
///     @x == other.x && @y == other.y && @z == other.z
///
/// // Type with Compare — equal auto-derived from @compare:
/// type Money { cents int }
/// fn Money @compare(other Money) -> int => @cents - other.cents
/// // @equal synthesized via Equal.equal default body
/// ```
#stable(since = "0.1")
export type Equal protocol {
    @equal(other Self) -> bool => @compare(other) == 0
}

/// Полный порядок. Orthogonal с Equal (no embed); Equal получает
/// default body через coercion к Compare. Возвращает `int`
/// (memcmp-style: < 0, 0, > 0).
///
/// Транзитивность и antisymmetry — программистская обязанность (compiler
/// не верифицирует). Для partial order — отдельный protocol (Plan 62.E+).
///
/// # Examples
///
/// ```nova
/// fn Money @compare(other Money) -> int =>
///     if @cents < other.cents { -1 }
///     else if @cents > other.cents { 1 }
///     else { 0 }
/// ```
#stable(since = "0.1")
export type Compare protocol {
    @compare(other Self) -> int
}

// ──────────────────────────────────────────────────────────────────────────
// Clone protocol
// ──────────────────────────────────────────────────────────────────────────

/// Deep recursive copy.
///
/// Single-method protocol для глубокой копии value-record / heap-record /
/// named tuple / sum-type. Auto-derive через `#impl(Clone)` на типе:
/// compiler synthesize'ит memberwise рекурсивную копию каждого поля.
///
/// **Auto-derive rules:**
/// - Primitive types: copy semantics built-in; `str` clone = новая аллокация.
/// - `[]T`: new array с recursive clone элементов.
/// - Record/NamedTuple: memberwise `field.clone()` chain.
/// - Sum-type: match-arms, payload рекурсивно clone'ится.
///
/// **Cycle detection:** type `A` → `E_AUTO_DERIVE_CYCLE`.
///
/// **Field eligibility:** каждое поле должно implement Clone → иначе
/// `E_AUTO_DERIVE_FIELD_LACKS_PROTOCOL`.
///
/// Manual impl (override default):
///
/// ```nova
/// fn Vec3 @clone() -> Vec3 =>
///     Vec3 { x: @x, y: @y, z: @z }   // shallow copy (primitives)
/// ```
#stable(since = "0.1")
export type Clone protocol {
    @clone() -> Self
}

// ──────────────────────────────────────────────────────────────────────────
// Write / Fmt / FmtCtx — Unified Formatter
// ──────────────────────────────────────────────────────────────────────────
//
// `Fmt` embeds `Write` (protocol-embed, `use Write`) and adds spec-axis
// surface (width/precision/align/fill/sign/alternate/kind) + `@pad`.

/// Byte sink for formatting — minimal, infallible. `@write` takes `[]u8`,
/// not `str`: more fundamental, unifies the shape with `io.Write` without
/// merging the two protocols (fmt-`Write` is infallible; io-`Write` returns
/// `Result[(), IoError]`).
///
/// str-VALUE arguments need an explicit `.bytes()` (zero-copy view);
/// str-LITERAL arguments coerce to `[]u8` automatically.
///
/// `@reserve`/`@advance` are deliberately NOT here: a raw `*mut u8` doesn't
/// belong in a shared protocol. They stay concrete methods on `StringBuilder`
/// — the compiler uses them for the zero-COPY interpolation path.
///
/// # Examples
///
/// ```nova
/// consume sb = StringBuilder.new()
/// sb.write("hello".bytes())
/// ```
#stable(since = "0.1")
export type Write protocol {
    mut @write(bytes []u8) -> ()
}

/// Format-spec context — sink (`use Write`, protocol-embed) + the axes
/// a `${x:SPEC}` rich spec carries. Every `@display`/`@debug` implementor
/// receives one of these (never a bare `Write`) so a type can react to
/// width/align/fill/sign/alternate/kind/precision.
///
/// `use Write` composes `@write([]u8)` into `Fmt`'s method-set — any `Fmt`
/// structurally satisfies `Write` too.
///
/// # Examples
///
/// ```nova
/// fn MyType @display(mut f Fmt) -> () {
///     if f.alternate() { f.write("<".bytes()) }
///     f.write(@to_str().bytes())
///     if f.alternate() { f.write(">".bytes()) }
/// }
/// ```
#stable(since = "0.1")
export type Fmt protocol {
    use Write
    @width()     -> Option[int]
    @precision() -> Option[int]
    @align()     -> Option[Align]
    @fill()      -> char
    @sign()      -> Sign
    @alternate() -> bool
    @kind()      -> FmtKind
    mut @pad(bytes []u8) -> ()
}

/// Concrete `Fmt` implementor the compiler constructs at every `${x[:SPEC]}`
/// call site. Not intended for direct user construction — `FmtCtx.bare`/
/// `FmtCtx.rich` below are the two shapes the codegen hand-synthesizes.
/// Primitive int/bool/etc fields only — `.rich`'s constructor does the
/// int/bool → `Option[T]`/enum mapping on the `.nv` side.
///
/// `mark` — the sink's byte length just BEFORE the type's `@display`/
/// `@debug` body runs, needed by `@pad_in_place`.
/// `pad_consumed` flips true when the type calls `@pad` itself (compiler
/// then skips its own auto-pad).
#stable(since = "0.1")
export type FmtCtx {
    sink Write
    mark int
    width Option[int]
    precision Option[int]
    align Option[Align]
    fill char
    sign Sign
    alternate bool
    kind FmtKind
    mut pad_consumed bool
    mut prec_consumed bool
}

/// Bare `${x}` / `${x:?}` — no spec at all: every axis empty/default.
/// `is_debug` selects `@kind()` (`Debug` vs `Display`); nothing else reacts.
export fn FmtCtx.bare(sink Write, mark int, is_debug bool) -> Self => {
    sink, mark,
    width: None, precision: None, align: None,
    fill: ' ', sign: Sign.Minus, alternate: false,
    kind: if is_debug { FmtKind.Debug } else { FmtKind.Display },
    pad_consumed: false, prec_consumed: false,
}

/// Rich `${x:SPEC}` — full parsed axes, primitive-typed params only (the
/// codegen call site hand-formats ints/bools straight from
/// `FormatSpecParsed`, mirroring the pre-existing `nova_fmt_pad(...)`
/// call-site convention). `align_code`: 0=Left/1=Right/2=Center/other=unset;
/// `fill_cp`: Unicode scalar value of the fill char.
export fn FmtCtx.rich(sink Write, mark int,
    has_width bool, width int,
    has_precision bool, precision int,
    align_code int, fill_cp int,
    sign_plus bool, alternate bool, is_debug bool) -> Self {
    // D54: `int as char` is banned (unchecked) — `fill_cp` is always a valid
    // Unicode scalar value (round-tripped from a real `char`, `spec.fill as
    // u32 as i64` on the Rust side), so the `Err` arm is unreachable in
    // practice; ' ' fallback only for the exhaustive match (same pattern as
    // `std/src/encoding/hex.nv`'s `digit()`).
    ro fill_c = match fill_cp.to_char() { Ok(c) => c, Err(_) => ' ' }
    {
        sink, mark,
        width: if has_width { Some(width) } else { None },
        precision: if has_precision { Some(precision) } else { None },
        align: if align_code == 0 { Some(Align.Left) }
            else if align_code == 1 { Some(Align.Right) }
            else if align_code == 2 { Some(Align.Center) }
            else { None },
        fill: fill_c,
        sign: if sign_plus { Sign.Plus } else { Sign.Minus },
        alternate,
        kind: if is_debug { FmtKind.Debug } else { FmtKind.Display },
        pad_consumed: false, prec_consumed: false,
    }
}

export fn FmtCtx mut @write(bytes []u8) -> () { @sink.write(bytes) }
export fn FmtCtx @width() -> Option[int] => @width

export fn FmtCtx @precision() -> Option[int] => @precision

export fn FmtCtx @align() -> Option[Align] => @align

export fn FmtCtx @fill() -> char => @fill

export fn FmtCtx @sign() -> Sign => @sign

export fn FmtCtx @alternate() -> bool => @alternate

export fn FmtCtx @kind() -> FmtKind => @kind

/// Type-owned padding (D422 §2/§4): a type that wants to pad ITSELF (rather
/// than let the compiler's auto-`@pad_in_place` run after the fact) writes
/// through this instead of `@write`, then the compiler sees `pad_consumed`
/// and does not double-pad. V1: delegates straight to the sink (no width-
/// aware behavior yet beyond what the caller already computed into `bytes`)
/// — full type-driven pad composition is a future refinement; today's
/// primary auto-pad path is the compiler's own `@pad_in_place` (D179 amend).
export fn FmtCtx mut @pad(bytes []u8) -> () {
    @sink.write(bytes)
    @pad_consumed = true
}

// ──────────────────────────────────────────────────────────────────────────
// Display + Debug protocols
// ──────────────────────────────────────────────────────────────────────────

/// Форматирование в строку (для println, str.from, etc).
/// **REQUIRED, no default body**: `@to_str()` is a bounded-`Display`
/// blanket instead (only callable on a type that already has a real
/// `@display`). Auto-derive synthesizes a real `@display` on demand.
///
/// # Examples
///
/// ```nova
/// type Point { x int, y int }
/// fn Point @display(mut f Fmt) -> () {
///     f.write("Point(".bytes())
///     f.write(@x.to_str().bytes())
///     f.write(", ".bytes())
///     f.write(@y.to_str().bytes())
///     f.write(")".bytes())
/// }
/// ```
#stable(since = "0.1")
export type Display protocol { @display(mut f Fmt) -> () }

/// Protocol для отладочного представления — sibling к Display.
/// **REQUIRED, no default body**.
///
/// **Distinction от Display:**
/// - `Display.@display` — user-facing display (e.g., `Point(1, 2)`, `"hello"`).
/// - `Debug.@debug` — diagnostic representation (e.g.,
///   `Point { x: 1, y: 2 }`, `"\"hello\\n\""` с quote-escape).
///
/// **Trigger:** `${expr:?}` syntax inside Nova interp-strings.
/// Bare `${expr}` (no `:?`) routes к `Display.@display`.
///
/// **Auto-derive:** synthesized on-demand.
///
/// # Examples
///
/// ```nova
/// type Point { x int, y int }
/// fn Point @debug(mut f Fmt) -> () {
///     f.write("Point(".bytes())
///     f.write(@x.to_str().bytes())
///     f.write(", ".bytes())
///     f.write(@y.to_str().bytes())
///     f.write(")".bytes())
/// }
/// ```
#stable(since = "0.1")
export type Debug protocol { @debug(mut f Fmt) -> () }

// ──────────────────────────────────────────────────────────────────────────
// Cleanup[E] + WithExitTimeout
// ──────────────────────────────────────────────────────────────────────────

/// Контракт ресурса для `consume X = expr { body }` scope-block'а.
/// **Один** метод `cleanup` вызывается ровно один раз при выходе из body.
///
/// **`E`** — тип ошибок, которые `cleanup` сам может throw.
/// Если ресурс infallible — используйте `Cleanup[never]`.
///
/// **R-rules:**
/// - R1: если `init` throws — `cleanup` не вызывается.
/// - R2: exactly-once invariant.
/// - R3: cancel-shield by default внутри `cleanup` body.
/// - R4: watchdog-threshold resolution at scope-entry.
/// - R5: LIFO composition для вложенных consume{}.
/// - R6: release-acquire memory ordering между body и cleanup.
///
/// # Examples
///
/// ```nova
/// type Transaction { /* ... */ }
///
/// fn Transaction consume @cleanup(outcome ScopeOutcome) Fail[DbError] -> () {
///     match outcome {
///         Success      => @commit()!!
///         Failure(_)   => @rollback()!!
///         Panic(_)     => @rollback_emergency()
///     }
/// }
///
/// fn process() Fail[DbError] -> () {
///     consume tx = Db.begin() {
///         do_work()?
///     }
///     // tx.cleanup вызван ровно один раз; commit/rollback по outcome.
/// }
/// ```
#stable(since = "0.1")
export type Cleanup[E] protocol {
    consume @cleanup(outcome ScopeOutcome) Fail[E] -> ()
}

/// Опциональный protocol для ресурсов с custom watchdog-порогом.
/// **Не** часть Cleanup — structural-match: любой тип с методом
/// `exit_timeout_ms() -> int` автоматически satisfies.
///
/// 3-level resolution (codegen consume-prologue):
/// 1. WithExitTimeout impl (этот protocol) — если есть;
/// 2. Application effect handler — `default_exit_timeout_ms()`;
/// 3. Hardcoded fallback — 5000 ms.
///
/// `Mutex` / `Sem` / `Lock` намеренно **не** implement — hardcoded 5s достаточен.
///
/// `int` милисекунд вместо `Duration` — избегаем cross-module import.
///
/// # Examples
///
/// ```nova
/// fn Transaction @exit_timeout_ms() -> int => 30_000   // 30 секунд
/// ```
#stable(since = "0.1")
export type WithExitTimeout protocol {
    @exit_timeout_ms() -> int
}

// ──────────────────────────────────────────────────────────────────────────
// Index[K, V] + MutIndex[K, V] protocols
// ──────────────────────────────────────────────────────────────────────────

/// Индексный доступ `a[key]` — magic-метод `@index` для `a[key]` выражений
/// на user-типах. Паникует при invalid key.
///
/// Встроенные `[]T` и `str` удовлетворяют через built-in codegen path;
/// user-типы реализуют явно.
///
/// `a[key]` десугаринг в `a.index(key)`.
///
/// # Examples
///
/// ```nova
/// // []T implements Index[int, T]:
/// mut v = []int.new()
/// v.push(10); v.push(20)
/// assert(v[0] == 10)  // v.index(0)
///
/// // Custom map implementing Index[str, int]:
/// type MyMap { ... }
/// fn MyMap @index(key str) -> int { ... }
/// ```
#stable(since = "0.1")
export type Index[K, V] protocol {
    @index(key K) -> V
}

/// Индексная запись `a[key] = val` — magic-метод `mut @index` для assignment
/// lhs. Read-only типы реализуют только `Index`. Мутабельные — оба.
///
/// `a[key] = val` десугаринг в `a.@index(key, val)`.
///
/// # Examples
///
/// ```nova
/// // []T implements MutIndex[int, T]:
/// mut v = []int.new()
/// v.push(10)
/// v[0] = 99  // v.@index(0, 99)
/// assert(v[0] == 99)
/// ```
#stable(since = "0.1")
export type MutIndex[K, V] protocol {
    mut @index(key K, val V)
}

// ──────────────────────────────────────────────────────────────────────────
// AsSlice[T] protocol
// ──────────────────────────────────────────────────────────────────────────

/// Raw contiguous-buffer protocol: a type that exposes a pointer + length
/// pair suitable for bulk `RawMem.copy` operations.
///
/// Implemented by `[]T`. Allows `@append` and similar bulk-copy methods
/// to accept any contiguous source without per-element iteration.
///
/// # Examples
///
/// ```nova
/// mut a = []int.of(1, 2, 3)
/// ro b = []int.of(4, 5)
/// a.append(b)           // []T implements AsSlice[T]
/// assert(a == [1, 2, 3, 4, 5])
/// ```
#stable(since = "0.1")
export type AsSlice[T] protocol {
    @ptr() -> *T
    @len() -> int
}

// ──────────────────────────────────────────────────────────────────────────
// Concrete Display + Debug for primitive scalars
// ──────────────────────────────────────────────────────────────────────────
//
// Даём каждому примитиву concrete `@display`/`@debug` чтобы
// element-dispatch в generic контейнере резолвился правильно (не падал на
// type-confused stub). Тела зовут `*_display_spec`-семейство из
// `runtime.string_builder` — единый render engine.
// Debug численных примитивов идентичен Display (D229 — числа не экранируются).
// `char`/`str` Debug добавляют кавычки и эскейпы.
// [M-154.1-f32-display-debug]
#impl(Display)
fn int @display(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    int_display_spec(sb, @, 0, 10, false, false, false, false, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Debug)
fn int @debug(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    int_display_spec(sb, @, 0, 10, false, false, false, false, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Display)
fn f64 @display(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    f64_display_spec(sb, @, 0, false, -1, false, false, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Debug)
fn f64 @debug(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    f64_display_spec(sb, @, 0, false, -1, false, false, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

// Plan 180: f32 display/debug — f32-PRECISE shortest-round-trip formatter
// (`f32_fmt`/`nova_f32_shortest`, NOT widen-to-f64 first — widening surfaces
// the f32→f64 mantissa tail, `0.1f` → `"0.10000000149011612"`); mirrors the
// bare `${f32val}` interp path (emit_c.rs `primitive_to_str_fn`'s
// `nova_f32_to_str`). Numeric debug == display (no escaping).
#impl(Display)
fn f32 @display(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    f32_display_spec(sb, @, 0, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Debug)
fn f32 @debug(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    f32_display_spec(sb, @, 0, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Display)
fn bool @display(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    bool_display_spec(sb, @, 0, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Debug)
fn bool @debug(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    bool_display_spec(sb, @, 0, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Display)
fn char @display(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    char_display_spec(sb, @, 0, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Debug)
fn char @debug(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    char_debug_display_spec(sb, @, 0, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

#impl(Display)
fn str @display(mut f Fmt) -> () { f.write(@bytes()) }

#impl(Debug)
fn str @debug(mut f Fmt) -> () {
    consume sb = StringBuilder.new()
    str_debug_display_spec(sb, @, 0, false, -1, Align.Left, ' ')
    f.write(sb.into_str().bytes())
}

// ──────────────────────────────────────────────────────────────────────────
// Option[T] / Result[T,E] — Debug + Display impl
// ──────────────────────────────────────────────────────────────────────────
// Moved here from `std/prelude/core.nv` because they reference `Debug`
// and `Write` — declared in THIS module. Under partial `#prelude(core,
// runtime)` (no `protocols`) they raised `E_IMPL_UNKNOWN_PROTOCOL`.
// String literals below are passed bare, no `.bytes()` — str-literal→`[]u8`
// coercion applies. Interpolated-string bodies still need explicit `.bytes()`.

/// Debug representation for Option[T]: `Some(value)` or `None`.
/// Requires `[T Debug]` — propagates the bound to the inner value.
///
/// # Examples
///
/// ```nova
/// assert("${Some(42):?}" == "Some(42)")
/// assert("${None:?}" == "None")
/// assert("${Some("hi"):?}" == "Some(\"hi\")")
/// ```
#impl(Debug)
fn Option[T Debug] @debug(mut f Fmt) -> () {
    match @ {
        Some(v) => {
            f.write("Some(")
            v.debug(f)
            f.write(")")
        }
        None => f.write("None")
    }
}

/// Debug representation for Result[T,E]: `Ok(value)` or `Err(error)`.
/// Requires `[T Debug, E Debug]`.
///
/// # Examples
///
/// ```nova
/// assert("${Ok(1):?}" == "Ok(1)")
/// assert("${Err("oops"):?}" == "Err(\"oops\")")
/// ```
#impl(Debug)
fn Result[T Debug, E Debug] @debug(mut f Fmt) -> () {
    match @ {
        Ok(v) => {
            f.write("Ok(")
            v.debug(f)
            f.write(")")
        }
        Err(e) => {
            f.write("Err(")
            e.debug(f)
            f.write(")")
        }
    }
}

// Display counterparts — were missing before (only `@debug` existed),
// so bare `${some_option}` failed to compile. Body identical to `@debug`
// but calls `.display(f)` instead of `.debug(f)`.

/// Display representation for Option[T]: `Some(value)` or `None`.
/// Requires `[T Display]` — propagates the bound to the inner value.
///
/// # Examples
///
/// ```nova
/// assert("${Some(42)}" == "Some(42)")
/// assert("${None}" == "None")
/// assert("${Some("hi")}" == "Some(hi)")
/// ```
#impl(Display)
fn Option[T Display] @display(mut f Fmt) -> () {
    match @ {
        Some(v) => {
            f.write("Some(")
            v.display(f)
            f.write(")")
        }
        None => f.write("None")
    }
}

/// Display representation for Result[T,E]: `Ok(value)` or `Err(error)`.
/// Requires `[T Display, E Display]`.
///
/// # Examples
///
/// ```nova
/// assert("${Ok(1)}" == "Ok(1)")
/// assert("${Err("oops")}" == "Err(oops)")
/// ```
#impl(Display)
fn Result[T Display, E Display] @display(mut f Fmt) -> () {
    match @ {
        Ok(v) => {
            f.write("Ok(")
            v.display(f)
            f.write(")")
        }
        Err(e) => {
            f.write("Err(")
            e.display(f)
            f.write(")")
        }
    }
}

// Type-set bounds for primitive integer families. Signed/unsigned are
// separate sets (E_TYPE_SET_MIXED_SIGNEDNESS guards user-declared mixed).
type SignedInts   set i8 | i16 | i32 | i64 | int
type UnsignedInts set u8 | u16 | u32 | u64 | uint

// `Ints` = SignedInts ∪ UnsignedInts — единый bound для
// `@overflowing_*`/`@checked_*`/`@saturating_*`/`@wrapping_*`.
// ВКЛЮЧАЕТ И БЕЗЗНАКОВЫЕ (все 10 целых типов) — не «только знаковые».
type Ints set i8 | i16 | i32 | i64 | int | u8 | u16 | u32 | u64 | uint

// Three blanket methods over compiler intrinsic `@overflowing_add/_sub/_mul`:
// `checked_*` -> Option[T], `wrapping_*` -> T, `saturating_*` -> T.
// `unchecked_*` отложен.

/// `checked_add` — `None` при overflow, иначе `Some(a + b)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_add(rhs T) -> Option[T] {
    ro (wrapped, overflowed) = @overflowing_add(rhs)
    if overflowed { None } else { Some(wrapped) }
}

/// `checked_sub` — `None` при overflow, иначе `Some(a - b)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_sub(rhs T) -> Option[T] {
    ro (wrapped, overflowed) = @overflowing_sub(rhs)
    if overflowed { None } else { Some(wrapped) }
}

/// `checked_mul` — `None` при overflow, иначе `Some(a * b)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_mul(rhs T) -> Option[T] {
    ro (wrapped, overflowed) = @overflowing_mul(rhs)
    if overflowed { None } else { Some(wrapped) }
}

/// `wrapping_add` — модульная арифметика (2^n wraparound); флаг overflow игнорируется.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_add(rhs T) -> T {
    ro (wrapped, _overflowed) = @overflowing_add(rhs)
    wrapped
}

/// `wrapping_sub` — модульная арифметика (2^n wraparound); флаг overflow игнорируется.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_sub(rhs T) -> T {
    ro (wrapped, _overflowed) = @overflowing_sub(rhs)
    wrapped
}

/// `wrapping_mul` — модульная арифметика (2^n wraparound); флаг overflow игнорируется.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_mul(rhs T) -> T {
    ro (wrapped, _overflowed) = @overflowing_mul(rhs)
    wrapped
}

/// `saturating_add` — при overflow клампит к `T.MAX`/`T.MIN` (направление
/// по знаку `rhs`: прибавили положительное -> перелилось вверх -> `MAX`).
#stable(since = "0.1")
export fn[T Ints] T @saturating_add(rhs T) -> T {
    ro (wrapped, overflowed) = @overflowing_add(rhs)
    if overflowed {
        if rhs > 0 { T.MAX } else { T.MIN }
    } else {
        wrapped
    }
}

/// `saturating_sub` — при overflow клампит к `T.MAX`/`T.MIN` (направление по
/// знаку `rhs`: вычли отрицательное -> перелилось вверх -> `MAX`; unsigned
/// underflow -> `MIN` = 0).
#stable(since = "0.1")
export fn[T Ints] T @saturating_sub(rhs T) -> T {
    ro (wrapped, overflowed) = @overflowing_sub(rhs)
    if overflowed {
        if rhs < 0 { T.MAX } else { T.MIN }
    } else {
        wrapped
    }
}

/// `saturating_mul` — при overflow клампит к `T.MAX`/`T.MIN` (направление по
/// знаку операндов: одинаковый знак -> произведение положительное ->
/// перелилось вверх -> `MAX`; разный знак -> вниз -> `MIN`).
#stable(since = "0.1")
export fn[T Ints] T @saturating_mul(rhs T) -> T {
    ro (wrapped, overflowed) = @overflowing_mul(rhs)
    if overflowed {
        if (@ < 0) == (rhs < 0) { T.MAX } else { T.MIN }
    } else {
        wrapped
    }
}

// ── div/rem/neg policy wrappers ──────────────────────────────────────
//
// `div`/`mod`/`neg` have no `__builtin_*_overflow` intrinsic — conditions
// detected manually in `.nv`: `rhs == 0` and `@ == T.MIN && rhs == -1`
// (reformulated as `rhs.negate() == 1` via `overflowing_sub` to avoid
// negative literal for unsigned monomorphization).

/// `checked_div` — `None` when `rhs == 0` (division by zero — a domain
/// error, not an overflow) or when `@ == T.MIN && rhs == -1` (the one
/// quotient-overflow case), else `Some(@ / rhs)`. Unsigned `T` only ever
/// hits the `rhs == 0` arm — division can never overflow for unsigned.
#stable(since = "0.1")
export fn[T Ints] T @checked_div(rhs T) -> Option[T] {
    if rhs == 0 { return None }
    if @ == T.MIN {
        ro zero = 0 as T
        ro (negated, ovf) = zero.overflowing_sub(rhs)
        if !ovf && negated == 1 { return None }
    }
    Some(@ / rhs)
}

/// `checked_rem` — same domain as `checked_div` (`None` on the identical two
/// conditions): on x86 `idiv` computes quotient AND remainder together and
/// faults on quotient overflow regardless, so `%` needs the same guard as
/// `/` even though the true mathematical remainder for `MIN % -1` is 0.
#stable(since = "0.1")
export fn[T Ints] T @checked_rem(rhs T) -> Option[T] {
    if rhs == 0 { return None }
    if @ == T.MIN {
        ro zero = 0 as T
        ro (negated, ovf) = zero.overflowing_sub(rhs)
        if !ovf && negated == 1 { return None }
    }
    Some(@ % rhs)
}

/// `wrapping_div` — **panics on `rhs == 0`** (division by zero has no wrap
/// semantics); the one overflow case (`T.MIN / -1`) wraps to `T.MIN` instead
/// of trapping.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_div(rhs T) -> T {
    if @ == T.MIN {
        ro zero = 0 as T
        ro (negated, ovf) = zero.overflowing_sub(rhs)
        if !ovf && negated == 1 { return T.MIN }
    }
    @ / rhs
}

/// `wrapping_rem` — **panics on `rhs == 0`**; `T.MIN % -1` wraps to `0`
/// (the true mathematical remainder, short-circuited).
#stable(since = "0.1")
export fn[T Ints] T @wrapping_rem(rhs T) -> T {
    if @ == T.MIN {
        ro zero = 0 as T
        ro (negated, ovf) = zero.overflowing_sub(rhs)
        if !ovf && negated == 1 { return 0 as T }
    }
    @ % rhs
}

/// `checked_neg` — signed: `None` iff `@ == T.MIN` (two's-complement
/// asymmetry). Unsigned: `None` unless `@ == 0`. One body sound for both
/// signednesses via `@overflowing_sub`.
#stable(since = "0.1")
export fn[T Ints] T @checked_neg() -> Option[T] {
    ro zero = 0 as T
    ro (wrapped, overflowed) = zero.overflowing_sub(@)
    if overflowed { None } else { Some(wrapped) }
}

/// `wrapping_neg` — modular negation, never panics (unlike raw unary `-`).
/// Signed `T.MIN` maps to itself; unsigned negation is `(2ⁿ − x) mod 2ⁿ`
/// wraparound. Same `0 - @` computation as `checked_neg`, flag ignored.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_neg() -> T {
    ro zero = 0 as T
    ro (wrapped, _overflowed) = zero.overflowing_sub(@)
    wrapped
}

// `clamp` blanket над `Ints` — replaces per-type concrete methods.

/// `clamp` — ограничивает значение диапазоном `[lo, hi]`: при `@ < lo` -> `lo`;
/// при `@ > hi` -> `hi`; иначе -> `@` без изменений. Контракт скопирован 1:1 со
/// старого конкретного `int @clamp` (std/runtime/defaults.nv, до Plan 200 Step
/// 0): порядок проверок фиксирован (`@ < lo` первым), поэтому при `lo > hi`
/// метод НЕ паникует — просто ведёт себя по той же формуле: при `lo > hi`
/// результат всегда `lo` (если `@ < lo`) либо `hi` (иначе) — сам `@` при
/// перевёрнутом диапазоне не возвращается никогда (эмпирика 2026-07-17).
#stable(since = "0.1")
export fn[T Ints] T @clamp(lo T, hi T) -> T =>
    if @ < lo { lo } else if @ > hi { hi } else { @ }

// `signum`/`is_negative`/`is_positive` над `SignedInts` — replaces per-type
// concrete methods. `UnsignedInts` не входит (Rust-паритет).

/// `signum` — знак значения: `-1`, если `@ < 0`; `1`, если `@ > 0`; иначе `0`.
#stable(since = "0.1")
export fn[T SignedInts] T @signum() -> T =>
    if @ < 0 { -1 } else if @ > 0 { 1 } else { 0 }

/// `is_negative` — строгая проверка знака: `true` iff `@ < 0`.
#stable(since = "0.1")
export fn[T SignedInts] T @is_negative() -> bool => @ < 0

/// `is_positive` — строгая проверка знака: `true` iff `@ > 0`.
#stable(since = "0.1")
export fn[T SignedInts] T @is_positive() -> bool => @ > 0

// `saturating_neg` над `SignedInts` — clamp `T.MIN` to `T.MAX`.
/// `saturating_neg` — при `@ == T.MIN` клампит к `T.MAX`, иначе `-@`.
#stable(since = "0.1")
export fn[T SignedInts] T @saturating_neg() -> T =>
    if @ == T.MIN { T.MAX } else { -@ }

// `abs`/`checked_abs`/`wrapping_abs`/`saturating_abs` над `SignedInts` —
// replaces old `extern "nova"` hardcoded `int @abs()` which was UB on T.MIN.

/// `abs` — модуль значения; трапит на `T.MIN` ("negation overflow" — тот
/// же trap, что голый унарный `-@`, НЕ новая политика).
#stable(since = "0.1")
export fn[T SignedInts] T @abs() -> T =>
    if @ < 0 { -@ } else { @ }

/// `checked_abs` — `None` iff `@ == T.MIN` (единственный непредставимый
/// случай — `|T.MIN|` не влезает в `T`), иначе `Some(|@|)`.
#stable(since = "0.1")
export fn[T SignedInts] T @checked_abs() -> Option[T] {
    if @ == T.MIN { return None }
    Some(if @ < 0 { -@ } else { @ })
}

/// `saturating_abs` — при `@ == T.MIN` клампит к `T.MAX`, иначе `|@|`.
#stable(since = "0.1")
export fn[T SignedInts] T @saturating_abs() -> T =>
    if @ == T.MIN { T.MAX } else if @ < 0 { -@ } else { @ }

/// `wrapping_abs` — модульно: `T.MIN` отображается сам в себя (тот же
/// two's-complement-эффект, что `wrapping_neg(T.MIN) == T.MIN`), иначе `|@|`.
#stable(since = "0.1")
export fn[T SignedInts] T @wrapping_abs() -> T =>
    if @ == T.MIN { T.MIN } else if @ < 0 { -@ } else { @ }

// `pow`/`checked_pow`/`saturating_pow`/`wrapping_pow` над `Ints` —
// exponentiation by squaring. `exp: u32` (Rust-паритет).
// `pow` traps on overflow (сырой `*`); `checked_*`/`saturating_*`/`wrapping_*`
// use `overflowing_mul` intrinsic directly (avoid nested-blanket-call ICE).

/// `pow` — целочисленное возведение в степень (exponentiation by
/// squaring). Трапит на overflow (сырой `*`, D423 §R3 trap-дефолт).
/// `exp` — `u32` (Rust-паритет: отрицательных степеней для целых нет).
/// `pow(0) == 1` (включая `0.pow(0) == 1`, математическая конвенция).
#stable(since = "0.1")
export fn[T Ints] T @pow(exp u32) -> T {
    if exp == 0 { return 1 as T }
    mut base = @
    mut e = exp
    mut acc = 1 as T
    while true {
        if e % 2 == 1 {
            acc = acc * base
            if e == 1 { return acc }
        }
        e = e / 2
        base = base * base
    }
    acc
}

/// `checked_pow` — `None`, если overflow на любом шаге squaring, иначе
/// `Some(result)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_pow(exp u32) -> Option[T] {
    if exp == 0 { return Some(1 as T) }
    mut base = @
    mut e = exp
    mut acc = 1 as T
    while true {
        if e % 2 == 1 {
            ro (wrapped, overflowed) = acc.overflowing_mul(base)
            if overflowed { return None }
            acc = wrapped
            if e == 1 { return Some(acc) }
        }
        e = e / 2
        ro (wrapped2, overflowed2) = base.overflowing_mul(base)
        if overflowed2 { return None }
        base = wrapped2
    }
    None
}

/// `saturating_pow` — при overflow клампит к `T.MAX`/`T.MIN` по знаку
/// ИСТИННОГО (непереполнённого) результата: `@ < 0 && exp` нечётный ->
/// `T.MIN`, иначе `T.MAX` (Rust-паритет формулы). Для unsigned `@ < 0`
/// константно `false` -> всегда `T.MAX`, корректно.
#stable(since = "0.1")
export fn[T Ints] T @saturating_pow(exp u32) -> T {
    if exp == 0 { return 1 as T }
    mut base = @
    mut e = exp
    mut acc = 1 as T
    while true {
        if e % 2 == 1 {
            ro (wrapped, overflowed) = acc.overflowing_mul(base)
            if overflowed {
                return if @ < 0 && exp % 2 == 1 { T.MIN } else { T.MAX }
            }
            acc = wrapped
            if e == 1 { return acc }
        }
        e = e / 2
        ro (wrapped2, overflowed2) = base.overflowing_mul(base)
        if overflowed2 {
            return if @ < 0 && exp % 2 == 1 { T.MIN } else { T.MAX }
        }
        base = wrapped2
    }
    acc
}

/// `wrapping_pow` — модульная арифметика на каждом шаге squaring, флаг
/// overflow игнорируется; никогда не паникует.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_pow(exp u32) -> T {
    if exp == 0 { return 1 as T }
    mut base = @
    mut e = exp
    mut acc = 1 as T
    while true {
        if e % 2 == 1 {
            ro (wrapped, _overflowed) = acc.overflowing_mul(base)
            acc = wrapped
            if e == 1 { return acc }
        }
        e = e / 2
        ro (wrapped2, _overflowed2) = base.overflowing_mul(base)
        base = wrapped2
    }
    acc
}

// [M-numeric-try-narrowing]: checked narrowing число→число, CHAINED form.
// `(300u32).try_to_u8() -> Result[u8, RangeError]` — method on source value.
// `as` stays fast truncating cast. ONE blanket per target type `<T>` over
// full `Ints` set.
// Single `Ints`-wide body with sign-agnostic `if @ < 0 { .. } else { .. }`
// split: each body widens `@` to `i64`/`u64` (wide enough for any member),
// so no cast truncates. Full 10×10 matrix is deliberate (mirrors Rust
// `TryFrom` coverage). `as` remains the zero-check fast path.

/// `try_to_i8` — checked narrowing conversion into `i8` (range
/// `[-128, 127]`). `Err(RangeError)` if `@` does not fit; `Ok(@ as i8)`
/// otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_i8() -> Result[i8, RangeError] {
    if @ < 0 {
        ro w = @ as i64
        if w < (i8.MIN as i64) { Err(RangeError) } else { Ok(@ as i8) }
    } else {
        ro w = @ as u64
        if w > (i8.MAX as u64) { Err(RangeError) } else { Ok(@ as i8) }
    }
}

/// `try_to_i16` — checked narrowing conversion into `i16` (range
/// `[-32768, 32767]`). `Err(RangeError)` if `@` does not fit; `Ok(@ as
/// i16)` otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_i16() -> Result[i16, RangeError] {
    if @ < 0 {
        ro w = @ as i64
        if w < (i16.MIN as i64) { Err(RangeError) } else { Ok(@ as i16) }
    } else {
        ro w = @ as u64
        if w > (i16.MAX as u64) { Err(RangeError) } else { Ok(@ as i16) }
    }
}

/// `try_to_i32` — checked narrowing conversion into `i32`. `Err
/// (RangeError)` if `@` does not fit; `Ok(@ as i32)` otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_i32() -> Result[i32, RangeError] {
    if @ < 0 {
        ro w = @ as i64
        if w < (i32.MIN as i64) { Err(RangeError) } else { Ok(@ as i32) }
    } else {
        ro w = @ as u64
        if w > (i32.MAX as u64) { Err(RangeError) } else { Ok(@ as i32) }
    }
}

/// `try_to_i64` — checked narrowing conversion into `i64`. Only ever fails
/// for a source WIDER than `i64` (`u64`/`uint` values above `i64.MAX`) —
/// no signed source can overflow `i64`, it is the platform's widest
/// signed type. `Err(RangeError)` if `@` does not fit; `Ok(@ as i64)`
/// otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_i64() -> Result[i64, RangeError] {
    if @ < 0 {
        ro w = @ as i64
        if w < (i64.MIN as i64) { Err(RangeError) } else { Ok(@ as i64) }
    } else {
        ro w = @ as u64
        if w > (i64.MAX as u64) { Err(RangeError) } else { Ok(@ as i64) }
    }
}

/// `try_to_int` — checked narrowing conversion into `int` (same width as
/// `i64` on this platform, D129). Same contract as `@try_to_i64`, distinct
/// C type. `Err(RangeError)` if `@` does not fit; `Ok(@ as int)` otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_int() -> Result[int, RangeError] {
    if @ < 0 {
        ro w = @ as i64
        if w < (int.MIN as i64) { Err(RangeError) } else { Ok(@ as int) }
    } else {
        ro w = @ as u64
        if w > (int.MAX as u64) { Err(RangeError) } else { Ok(@ as int) }
    }
}

/// `try_to_u8` — checked narrowing conversion into `u8` (range
/// `[0, 255]`). Negative sources always `Err(RangeError)`; otherwise `Err`
/// if `@ > 255`, else `Ok(@ as u8)`.
#stable(since = "0.1")
export fn[S Ints] S @try_to_u8() -> Result[u8, RangeError] {
    if @ < 0 {
        Err(RangeError)
    } else {
        ro w = @ as u64
        if w > (u8.MAX as u64) { Err(RangeError) } else { Ok(@ as u8) }
    }
}

/// `try_to_u16` — checked narrowing conversion into `u16` (range
/// `[0, 65535]`). Negative sources always `Err(RangeError)`; otherwise
/// `Err` if `@ > 65535`, else `Ok(@ as u16)`.
#stable(since = "0.1")
export fn[S Ints] S @try_to_u16() -> Result[u16, RangeError] {
    if @ < 0 {
        Err(RangeError)
    } else {
        ro w = @ as u64
        if w > (u16.MAX as u64) { Err(RangeError) } else { Ok(@ as u16) }
    }
}

/// `try_to_u32` — checked narrowing conversion into `u32`. Negative
/// sources always `Err(RangeError)`; otherwise `Err` if `@ > u32.MAX`,
/// else `Ok(@ as u32)`.
#stable(since = "0.1")
export fn[S Ints] S @try_to_u32() -> Result[u32, RangeError] {
    if @ < 0 {
        Err(RangeError)
    } else {
        ro w = @ as u64
        if w > (u32.MAX as u64) { Err(RangeError) } else { Ok(@ as u32) }
    }
}

/// `try_to_u64` — checked narrowing conversion into `u64`. Only ever fails
/// for a negative signed source — `u64` is the platform's widest unsigned
/// type, so no non-negative source can overflow it. `Err(RangeError)` if
/// `@ < 0`; `Ok(@ as u64)` otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_u64() -> Result[u64, RangeError] {
    if @ < 0 {
        Err(RangeError)
    } else {
        ro w = @ as u64
        if w > (u64.MAX as u64) { Err(RangeError) } else { Ok(@ as u64) }
    }
}

/// `try_to_uint` — checked narrowing conversion into `uint` (same width as
/// `u64` on this platform). Same contract as `@try_to_u64`, distinct C
/// type. `Err(RangeError)` if `@ < 0`; `Ok(@ as uint)` otherwise.
#stable(since = "0.1")
export fn[S Ints] S @try_to_uint() -> Result[uint, RangeError] {
    if @ < 0 {
        Err(RangeError)
    } else {
        ro w = @ as u64
        if w > (uint.MAX as u64) { Err(RangeError) } else { Ok(@ as uint) }
    }
}
