// std/prelude/protocols.nv — file-based source of truth для prelude
// conversion / equality / ordering / hashing / display protocols.
// Plan 62 phase 62.E.
//
// Декларации добавлены в этот файл, чтобы:
//   1) `nova doc` показывал canonical API в одном месте (AI-readable),
//   2) пользователь мог shadow'ить эти names в своём коде с warning'ом
//      (Plan 62.F W_PRELUDE_SHADOW),
//   3) splittable prelude работал (`#prelude(protocols)` opt-in
//      только protocols без core/runtime/errors/collections).
//
// Архитектурные правила (Plan 62 §«Стратификация»):
//   - **Один explicit import**: `std.prelude.core.{Ordering}` нужен для
//     signature `cmp(other Self) -> Ordering`. Auto-import `std.prelude`
//     отключён внутри `std.prelude.*` (cycle protection,
//     `is_prelude_self_module` в compiler-codegen/src/manifest.rs:314+),
//     поэтому Ordering надо завезти explicitly. `std.prelude.core` не
//     импортирует обратно `std.prelude.protocols` — cycle отсутствует.
//
// **Bootstrap status (Plan 62.E):**
//
// - **`From[T]` / `Into[U]` / `TryFrom[T, E]` / `TryInto[U, E]`** —
//   ретрактированы (D73/D77, 2026-07-06). См. spec/decisions/08-runtime.md#d73.
//   Остаётся: `.from(x)`/`.try_from(x)` конвенция имён (не протокол),
//   `consume @into_ЦЕЛЬ()` (D131), `to_str()`/`to_*` (D410).
// - **`Hash`** — `hash() -> u64` only (split из combined hash+eq в
//   `std/collections/hashmap.nv` per D109 split policy). Совместимо с
//   structural matching: type удовлетворяющий combined `Hash`
//   (hash+eq) автоматически удовлетворяет split `Hash` (только hash).
// - **`Equal`** — `eq(other Self) -> bool` (split из combined per D109).
// - **`Compare`** — `cmp(other Self) -> Ordering` (D109 strict).
//   Ordering импортирован explicitly из `std.prelude.core` (cycle prot).
//
// **NOT migrated (Plan 62.E scope — deferred / in-progress):**
//
// - **`Display`** — `fmt(sb StringBuilder) -> ()` зависит от
//   `StringBuilder` (opaque runtime type, hardcoded в type-checker
//   builtins). До 62.D.bis (опаковые типы → `external type`) Display
//   declaration не может ссылаться на StringBuilder через cross-file
//   resolve. См. DEFER comment ниже.
//
// **NOT modified (Plan 62.E explicit non-goals):**
//
// - Built-in dispatch Hash/Eq/Ord для примитивов (`int.hash()`,
//   `str.eq()`, etc.) в codegen — остаётся.
// - `lints.rs:565` `collect_protocol_names` HashSet — идемпотентно
//   с этими declarations (HashSet de-dups; protocol resolution
//   не ломается).

module prelude.protocols

// Plan 91.8a (D183): Ordering sum-type удалён; Compare.compare возвращает int
// (memcmp-style: < 0 / 0 / > 0). Никаких imports из core не требуется.

// Plan 208 Ф.2 (D422): `Fmt`'s `@align()` axis reuses the SAME `Align` enum
// `StringBuilder.@pad_in_place`/`@write_padded` already take (D179 amend,
// Ф.1) — one type, not a second one. `Sign`/`FmtKind` are new (Ф.2 scope,
// not introduced in Ф.1) but live in the SAME file (`runtime.fmt_buf`) for
// a single format-enum home. `runtime.fmt_buf` is `#no_prelude` (only
// builtin primitives) so this import does not reopen the
// `prelude → collections → string_builder` cycle `protocols.nv` itself
// otherwise stays clear of.
import std.runtime.fmt_buf.{Align, Sign, FmtKind}


// ──────────────────────────────────────────────────────────────────────────
// Equality / Hashing / Ordering protocols (D109)
// ──────────────────────────────────────────────────────────────────────────

/// Хэшируемые типы — для `HashMap[K, ...]` / `HashSet[K]` (D109,
/// spec/decisions/04-effects.md; D237 rename Hash → Hash).
///
/// **Split policy (D109):** `Hash` определяет только `hash() -> u64`,
/// equality вынесена в отдельный `Equal`. Это упрощает структурную
/// проверку: `[K Hash]` означает "достаточно для хэш-таблицы lookup'а
/// **до** collision check", `[K Hash + Equal]` — полный contract.
///
/// **Bootstrap:** примитивы (`int`/`str`/`bool`/`char`/числовые) — auto-
/// hashable per type-checker special-case (emit_c.rs:5817). Именованные
/// типы должны явно реализовать `fn T @hash() -> u64`.
///
/// # Examples
///
/// ```nova
/// type UserId { value u64 }
/// fn UserId @hash() -> u64 => @value
/// // UserId теперь удовлетворяет Hash structurally.
/// ```
#stable(since = "0.1")
export type Hash protocol {
    @hash() -> u64
}

/// Равенство (D109; D237 rename Equal → Equal, @equal → @equal).
///
/// `Self == Self` через явный метод. Plan 91.8a.2 (D183 amendment):
/// Если тип satisfies Compare, @equal auto-synthesized через compare;
/// иначе implementer пишет @equal явно (e.g. Vector3, Complex без linear
/// order). Operators ==/!= synthesized автоматически.
///
/// # Examples
///
/// ```nova
/// // Type only Equal (no order):
/// type Vector3 { x f64, y f64, z f64 }
/// fn Vector3 @equal(other Vector3) -> bool =>
///     @x == other.x && @y == other.y && @z == other.z
///
/// // Type with Compare — equal auto-derived from @compare:
/// type Money { cents int }
/// fn Money @compare(other Money) -> int => @cents - other.cents
/// // @equal synthesized via Equal.equal default body
/// ```
#stable(since = "0.1")
export type Equal protocol {
    @equal(other Self) -> bool => @compare(other) == 0
}

/// Полный порядок (D109, D183 amendment Plan 91.8a.2; D237 rename Compare → Compare).
/// Orthogonal с Equal (no embed); Equal получает default body через
/// coercion к Compare. Возвращает `int` (memcmp-style: < 0, 0, > 0).
///
/// Транзитивность и antisymmetry — программистская обязанность (compiler
/// не верифицирует). Для partial order — отдельный protocol (Plan 62.E+).
///
/// # Examples
///
/// ```nova
/// fn Money @compare(other Money) -> int =>
///     if @cents < other.cents { -1 }
///     else if @cents > other.cents { 1 }
///     else { 0 }
/// ```
#stable(since = "0.1")
export type Compare protocol {
    @compare(other Self) -> int
}


// ──────────────────────────────────────────────────────────────────────────
// Plan 137 (D237) — Clone protocol (renamed from Clone)
// ──────────────────────────────────────────────────────────────────────────

/// Deep recursive copy (Plan 126, D230; D237 rename Clone → Clone).
///
/// Single-method protocol для глубокой копии value-record / heap-record /
/// named tuple / sum-type. Auto-derive через `#impl(Clone)` на типе:
/// compiler synthesize'ит memberwise рекурсивную копию каждого поля.
///
/// **Auto-derive rules:**
/// - Primitive types (int/f64/bool/char/byte/str): copy semantics built-in;
///   `str` clone = новая аллокация с тем же контентом.
/// - `[]T`: new array с recursive clone элементов.
/// - Record/NamedTuple: memberwise `field.clone()` chain.
/// - Sum-type: match-arms, payload рекурсивно clone'ится.
/// - Reference fields в value-record: clone underlying (`[]T` deep copy).
///
/// **Cycle detection:** type `A` ссылающийся на `A` сам (через embed) →
/// `E_AUTO_DERIVE_CYCLE` при попытке synthesize.
///
/// **Field eligibility:** каждое поле type'а должно implement Clone
/// (либо primitive, либо `#impl(Clone)`). Иначе →
/// `E_AUTO_DERIVE_FIELD_LACKS_PROTOCOL`.
///
/// # Examples
///
/// ```nova
/// #impl(Clone)
/// type Vec3 value {
///     x f64
///     y f64
///     z f64
/// }
///
/// ro a = Vec3 { x: 1.0, y: 2.0, z: 3.0 }
/// ro b = a.clone()  // synthesized: Vec3 { x: @x.clone(), y: @y.clone(), z: @z.clone() }
/// ```
///
/// Manual impl (override default):
///
/// ```nova
/// fn Vec3 @clone() -> Vec3 =>
///     Vec3 { x: @x, y: @y, z: @z }   // shallow copy (primitives)
/// ```
#stable(since = "0.1")
export type Clone protocol {
    @clone() -> Self
}


// ──────────────────────────────────────────────────────────────────────────
// Plan 208 Ф.2 (D422) — Write / Fmt / FmtCtx — Unified Formatter
// ──────────────────────────────────────────────────────────────────────────
//
// D419 RETRACT/SUPERSEDED (spec/decisions/02-types.md#d419): the two-method
// `@display(mut w Write)` + optional `@display_fmt(mut f Fmt)` scheme is
// gone. ONE required primitive per type — `@display(mut f Fmt)` /
// `@debug(mut f Fmt)` — below. `Fmt` embeds `Write` (D145 protocol-embed,
// `use Write`) and adds the full spec-axis surface (width/precision/align/
// fill/sign/alternate/kind) plus type-owned `@pad`. See D422 §1-§3.

/// Byte sink for formatting — minimal, infallible (Plan 208 Ф.2, D422 §1,
/// D374 AMEND ×2). `@write` takes `[]u8`, not `str`: more fundamental,
/// unifies the shape with `io.Write` (Plan 176) without merging the two
/// protocols (fmt-`Write` is infallible; io-`Write` returns
/// `Result[(), IoError]` — "two byte relatives", D325).
///
/// str-VALUE arguments need an explicit `.bytes()` (D176, zero-copy view);
/// str-LITERAL arguments coerce to `[]u8` automatically (D55 amend — the
/// same "literal in a typed position" carve-out as int-literal→newtype).
///
/// `@reserve`/`@advance` are deliberately NOT here (design review 2026-07-15,
/// D422 §1): a raw `*mut u8` doesn't belong in a shared protocol, and an
/// io-sink cannot hand out a pointer to bytes it hasn't received yet. They
/// stay concrete methods on `StringBuilder` (D179 amend) — the compiler uses
/// them directly for the zero-COPY top-level interpolation path; generic
/// `@display`/`@debug` bodies (sink typed only as `Fmt`/`Write`) render a
/// primitive into a stack buffer and make one `@write` call — zero-ALLOC,
/// no heap, mirroring Rust's minimal `fmt::Write`.
///
/// # Examples
///
/// ```nova
/// consume sb = StringBuilder.new()
/// sb.write("hello".bytes())
/// ```
#stable(since = "0.1")
export type Write protocol {
    mut @write(bytes []u8) -> ()
}

/// Format-spec context — sink (`use Write`, D145 protocol-embed) + the axes
/// a `${x:SPEC}` rich spec carries (Plan 208 Ф.2, D422 §2). Every
/// `@display`/`@debug` implementor receives one of these (never a bare
/// `Write`) so a type CAN react to width/align/fill/sign/alternate/kind/
/// precision — but padding itself is compiler-owned by default (§`@pad`).
///
/// `use Write` composes `@write([]u8)` into `Fmt`'s method-set (same
/// mechanism as any other `protocol { use A, B }`, D145) — any `Fmt`
/// structurally satisfies `Write` too.
///
/// # Examples
///
/// ```nova
/// fn MyType @display(mut f Fmt) -> () {
///     if f.alternate() { f.write("<".bytes()) }
///     f.write(@to_str().bytes())
///     if f.alternate() { f.write(">".bytes()) }
/// }
/// ```
#stable(since = "0.1")
export type Fmt protocol {
    use Write
    @width()     -> Option[int]
    @precision() -> Option[int]
    @align()     -> Option[Align]
    @fill()      -> char
    @sign()      -> Sign
    @alternate() -> bool
    @kind()      -> FmtKind
    mut @pad(bytes []u8) -> ()
}

/// Concrete `Fmt` implementor the compiler constructs at every `${x[:SPEC]}`
/// call site (Plan 208 Ф.2, D422 §2). Not intended for direct user
/// construction — `FmtCtx.bare`/`FmtCtx.rich` below are the two shapes the
/// codegen hand-synthesizes (bare interpolation has no spec at all; a rich
/// `${x:SPEC}` carries the parsed axes). Primitive int/bool/etc fields only
/// (no Nova enum literals cross the hand-synthesized C call boundary) —
/// `.rich`'s constructor does the int/bool → `Option[T]`/enum mapping on the
/// `.nv` side.
///
/// `mark` — the sink's byte length just BEFORE the type's `@display`/
/// `@debug` body runs, needed by `@pad_in_place` (composite/streaming render
/// whose length is only known AFTER the body streams into `sink`, D422 §4).
/// `pad_consumed`/`prec_consumed` mirror each other: `pad_consumed` flips
/// true when the type calls `@pad` itself (compiler then skips its own
/// auto-pad); `prec_consumed` is NOT flip-able via any `Fmt` method (no
/// setter in the protocol, D422 §2 lists none) — it exists on the struct for
/// symmetry/future use but Ф.2 leaves it permanently `false` (see
/// `docs/plans/208-impl-progress.md` for why the D419-era "did the type look
/// at precision" auto-truncation fallback is NOT carried forward for the
/// composite/user-type path — Rust's own Debug/derive ignores `.N` the same
/// way; a type that wants precision semantics reads `@precision()` itself).
#stable(since = "0.1")
export type FmtCtx {
    sink Write
    mark int
    width Option[int]
    precision Option[int]
    align Option[Align]
    fill char
    sign Sign
    alternate bool
    kind FmtKind
    mut pad_consumed bool
    mut prec_consumed bool
}

/// Bare `${x}` / `${x:?}` — no spec at all: every axis empty/default.
/// `is_debug` selects `@kind()` (`Debug` vs `Display`); nothing else reacts.
export fn FmtCtx.bare(sink Write, mark int, is_debug bool) -> Self => {
    sink, mark,
    width: None, precision: None, align: None,
    fill: ' ', sign: Sign.Minus, alternate: false,
    kind: if is_debug { FmtKind.Debug } else { FmtKind.Display },
    pad_consumed: false, prec_consumed: false,
}

/// Rich `${x:SPEC}` — full parsed axes, primitive-typed params only (the
/// codegen call site hand-formats ints/bools straight from
/// `FormatSpecParsed`, mirroring the pre-existing `nova_fmt_pad(...)`
/// call-site convention). `align_code`: 0=Left/1=Right/2=Center/other=unset;
/// `fill_cp`: Unicode scalar value of the fill char.
export fn FmtCtx.rich(
    sink Write, mark int,
    has_width bool, width int,
    has_precision bool, precision int,
    align_code int, fill_cp int,
    sign_plus bool, alternate bool, is_debug bool,
) -> Self => {
    sink, mark,
    width: if has_width { Some(width) } else { None },
    precision: if has_precision { Some(precision) } else { None },
    align:
        if align_code == 0 { Some(Align.Left) }
        else if align_code == 1 { Some(Align.Right) }
        else if align_code == 2 { Some(Align.Center) }
        else { None },
    fill: fill_cp as char,
    sign: if sign_plus { Sign.Plus } else { Sign.Minus },
    alternate,
    kind: if is_debug { FmtKind.Debug } else { FmtKind.Display },
    pad_consumed: false, prec_consumed: false,
}

export fn FmtCtx mut @write(bytes []u8) -> () { @sink.write(bytes) }
export fn FmtCtx @width() -> Option[int] => @width
export fn FmtCtx @precision() -> Option[int] => @precision
export fn FmtCtx @align() -> Option[Align] => @align
export fn FmtCtx @fill() -> char => @fill
export fn FmtCtx @sign() -> Sign => @sign
export fn FmtCtx @alternate() -> bool => @alternate
export fn FmtCtx @kind() -> FmtKind => @kind

/// Type-owned padding (D422 §2/§4): a type that wants to pad ITSELF (rather
/// than let the compiler's auto-`@pad_in_place` run after the fact) writes
/// through this instead of `@write`, then the compiler sees `pad_consumed`
/// and does not double-pad. V1: delegates straight to the sink (no width-
/// aware behavior yet beyond what the caller already computed into `bytes`)
/// — full type-driven pad composition is a future refinement; today's
/// primary auto-pad path is the compiler's own `@pad_in_place` (D179 amend).
export fn FmtCtx mut @pad(bytes []u8) -> () {
    @sink.write(bytes)
    @pad_consumed = true
}

// ──────────────────────────────────────────────────────────────────────────
// Plan 137 (D237) — Display + Debug protocols (renamed from Display/Debug)
// Plan 208 Ф.2 (D422 §3) — ONE required primitive, no to_str-calling default
// ──────────────────────────────────────────────────────────────────────────

/// Форматирование в строку (для println, str.from, etc).
/// D237 rename: Display → Display, @display → @display.
/// D422 (Plan 208 Ф.2): sink parameter changed from `Write` to `Fmt`
/// (D374 AMEND ×2) — a `Fmt` gives width/align/fill/sign/alternate/kind
/// axes on top of the same `@write`. **REQUIRED, no default body**
/// (D422 §3 invariant): a `to_str()`-calling default was the D419-era
/// cycle trap (`to_str`'s own blanket body is `"${@}"`, which for a type
/// with no real `@display` would recurse into the very default calling it).
/// `@to_str()` is now a bounded-`Display` blanket instead (only callable on
/// a type that ALREADY has a real `@display`, std/runtime/string/core.nv)
/// — no cycle is structurally possible. Auto-derive (record/sum/tuple)
/// synthesizes a real `@display` on demand, so structural types stay
/// Display-capable without a hand-written impl; a non-derivable opaque type
/// with no `@display` is a compile error at the `${x}` call site, not an
/// infinite loop (D422 §3 point 4).
///
/// # Examples
///
/// ```nova
/// type Point { x int, y int }
/// fn Point @display(mut f Fmt) -> () {
///     f.write("Point(".bytes())
///     f.write(@x.to_str().bytes())
///     f.write(", ".bytes())
///     f.write(@y.to_str().bytes())
///     f.write(")".bytes())
/// }
/// ```
#stable(since = "0.1")
export type Display protocol { @display(mut f Fmt) -> () }


/// Protocol для отладочного представления — sibling к Display (D229; D237 rename).
/// D422 (Plan 208 Ф.2): sink parameter `Write` → `Fmt`; **REQUIRED, no
/// default body** — same D422 §3 rationale as `Display` above. The old
/// default (`w.write(str.from_debug(@))`) is retracted along with
/// `str.from_debug` itself (Plan 174.2 left it an unimplemented symbol;
/// D422 removes even the dead reference — see D422 §"Связь").
///
/// **Distinction от Display:**
/// - `Display.@display` — user-facing display (e.g., `Point(1, 2)`, `"hello"`).
/// - `Debug.@debug` — diagnostic representation (e.g.,
///   `Point { x: 1, y: 2 }`, `"\"hello\\n\""` с quote-escape), matches
///   Rust `#[derive(Debug)]` shape.
///
/// **Trigger:** `${expr:?}` syntax inside Nova interp-strings (Plan 91.14 Ф.2).
/// Bare `${expr}` (no `:?`) routes к Display.@display (unchanged).
///
/// **Auto-derive:** synthesized on-demand при первом encounter `${x:?}`.
///
/// # Examples
///
/// ```nova
/// type Point { x int, y int }
/// fn Point @debug(mut f Fmt) -> () {
///     f.write("Point(".bytes())
///     f.write(@x.to_str().bytes())
///     f.write(", ".bytes())
///     f.write(@y.to_str().bytes())
///     f.write(")".bytes())
/// }
/// ```
#stable(since = "0.1")
export type Debug protocol { @debug(mut f Fmt) -> () }


// ──────────────────────────────────────────────────────────────────────────
// Plan 110 (D188 / D192 / D194) — Cleanup[E] + WithExitTimeout
// ──────────────────────────────────────────────────────────────────────────

/// Plan 110 (D188): контракт ресурса для `consume X = expr { body }`
/// scope-block'а. **Один** метод `cleanup` вызывается ровно один раз
/// при выходе из body (success/throw/panic/cancel).
///
/// **`E`** — тип ошибок, которые `cleanup` сам может throw (commit
/// failure, flush failure). Если ресурс infallible — используйте
/// `Cleanup[never]` (D194), это даёт caller'у право не объявлять
/// `Fail[E]` + codegen hot-path elision.
///
/// **R-rules (D188):**
/// - R1: если `init` throws — `cleanup` не вызывается (partial-construction).
/// - R2: exactly-once invariant (runtime counter).
/// - R3: cancel-shield by default внутри `cleanup` body.
/// - R4: watchdog-threshold resolution at scope-entry (3-level; D192-ретракт:
///   порог ВАРНА «fiber застрял в cleanup», не прерывания — cleanup добегает).
/// - R5: LIFO composition для вложенных consume{}.
/// - R6: release-acquire memory ordering между body и cleanup.
///
/// # Examples
///
/// ```nova
/// type Transaction { /* ... */ }
///
/// fn Transaction consume @cleanup(outcome ScopeOutcome) Fail[DbError] -> () {
///     match outcome {
///         Success      => @commit()!!
///         Failure(_)   => @rollback()!!
///         Panic(_)     => @rollback_emergency()
///     }
/// }
///
/// fn process() Fail[DbError] -> () {
///     consume tx = Db.begin() {
///         do_work()?
///     }
///     // tx.cleanup вызван ровно один раз; commit/rollback по outcome.
/// }
/// ```
#stable(since = "0.1")
export type Cleanup[E] protocol {
    consume @cleanup(outcome ScopeOutcome) Fail[E] -> ()
}

/// Plan 110 (D192; ретракт Plan 173 Ф.5 п.2): опциональный protocol для
/// ресурсов с custom watchdog-порогом (ex-`exit_timeout`). **Не** часть
/// Cleanup — structural-match: любой тип с методом
/// `exit_timeout_ms() -> int` автоматически satisfies.
///
/// Порог = источник watchdog-ВАРНА «fiber застрял в cleanup» (D192-ретракт:
/// force-прерывания нет; превышение видно в ResourceTrace exit-событии
/// как duration_ms/overrun). 3-level resolution (codegen consume-prologue):
/// 1. WithExitTimeout impl (этот protocol) — если есть;
/// 2. Application effect handler — `default_exit_timeout_ms()`;
/// 3. Hardcoded fallback — 5000 ms.
///
/// `Mutex` / `Sem` / `Lock` намеренно **не** implement — для них
/// hardcoded 5s достаточен (releases instant).
///
/// **Bootstrap:** `int` милисекунд вместо `Duration` (последний в std/time/,
/// не prelude — избегаем cross-module import).
///
/// # Examples
///
/// ```nova
/// fn Transaction @exit_timeout_ms() -> int => 30_000   // 30 секунд
/// ```
#stable(since = "0.1")
export type WithExitTimeout protocol {
    @exit_timeout_ms() -> int
}


// ──────────────────────────────────────────────────────────────────────────
// Plan 138 (D238 / D240) — Index[K, V] + MutIndex[K, V] protocols
// ──────────────────────────────────────────────────────────────────────────

/// Индексный доступ `a[key]` — magic-метод `@index` для `a[key]` выражений
/// на user-типах. Паникует при invalid key (OOB, missing key etc).
///
/// Встроенные `[]T` и `str` удовлетворяют через built-in codegen path;
/// user-типы (`[]T`, `HashMap[K,V]` и т.д.) реализуют явно.
///
/// # D238 (spec/decisions/03-syntax.md)
///
/// `a[key]` десугаринг в `a.index(key)` для любого типа реализующего
/// `Index[K, V]`. `K` — тип ключа, `V` — тип возвращаемого значения.
///
/// # Examples
///
/// ```nova
/// // []T implements Index[int, T]:
/// mut v = []int.new()
/// v.push(10); v.push(20)
/// assert(v[0] == 10)  // v.index(0)
///
/// // Custom map implementing Index[str, int]:
/// type MyMap { ... }
/// fn MyMap @index(key str) -> int { ... }
/// ```
#stable(since = "0.1")
export type Index[K, V] protocol {
    @index(key K) -> V
}

/// Индексная запись `a[key] = val` — magic-метод `mut @index` для assignment
/// lhs. Read-only типы реализуют только `Index`. Мутабельные — оба.
///
/// # D240 (spec/decisions/03-syntax.md)
///
/// `a[key] = val` десугаринг в `a.@index(key, val)` (write-overload `@index`
/// с `mut`-receiver) для типов реализующих `MutIndex[K, V]`.
///
/// # Examples
///
/// ```nova
/// // []T implements MutIndex[int, T]:
/// mut v = []int.new()
/// v.push(10)
/// v[0] = 99  // v.@index(0, 99)
/// assert(v[0] == 99)
/// ```
#stable(since = "0.1")
export type MutIndex[K, V] protocol {
    mut @index(key K, val V)
}


// ──────────────────────────────────────────────────────────────────────────
// D299 — AsSlice[T] protocol (Plan 153.1, 2026-06-17)
// ──────────────────────────────────────────────────────────────────────────

/// Raw contiguous-buffer protocol: a type that exposes a pointer + length
/// pair suitable for bulk `RawMem.copy` operations.
///
/// Implemented by `[]T` (`Vec[T]` under the definition-site name). Allows
/// `@append` and similar bulk-copy methods to accept any contiguous source
/// without per-element iteration.
///
/// # D299 (spec/decisions/02-types.md)
///
/// # Examples
///
/// ```nova
/// mut a = []int.of(1, 2, 3)
/// ro b = []int.of(4, 5)
/// a.append(b)           // []T implements AsSlice[T]
/// assert(a == [1, 2, 3, 4, 5])
/// ```
#stable(since = "0.1")
export type AsSlice[T] protocol {
    @ptr() -> *T
    @len() -> int
}

// ──────────────────────────────────────────────────────────────────────────
// Plan 154.1 (D269) — concrete Display + Debug for primitive scalars
// ──────────────────────────────────────────────────────────────────────────
//
// Why these exist (the `vec_debug_pos` mis-dispatch, Plan 154.1):
//   A container's monomorphized `[]T @debug` body calls `@data[i].debug(sb)`
//   on the ELEMENT. When T is a primitive (`int`, `f64`, ...), the element has
//   no concrete `@debug` method, so codegen's single-key `method_receivers`
//   fallback used to mis-route the call to the container's own erased
//   `Nova_Vec_method_debug` stub (a type-confused no-op). Giving each primitive
//   a CONCRETE `@display`/`@debug` lets element-dispatch resolve correctly
//   (`Nova_int_method_debug`), and the guard in emit_c.rs (Plan 154.1 Ф.1)
//   turns any remaining primitive-via-generic mis-dispatch into a loud error.
//
// Display bodies are uniform `sb.append(@)` — they dispatch on the value's
// type through the typed `@append` overloads on StringBuilder (str/char/int/
// f64/bool; see std/runtime/string_builder.nv). No intermediate `nova_str`
// from an interp-string temp StringBuilder.
//
// Debug bodies: for `int`/`f64`/`bool` the debug form is identical to display
// (`nova_*_to_debug_str` == `nova_*_to_str`), so they reuse `sb.append(@)`.
// For `char`/`str` debug adds quotes + escapes (`'c'`, `"a\nb"`); that logic
// lives in the conv.h `nova_char_to_debug_str` / `nova_str_to_debug_str`
// formatters, reached from Nova via the interp `:?` spec. The interp path uses
// the conv.h formatter DIRECTLY for primitives (never re-dispatches to this
// method), so the char/str debug bodies do NOT recurse.
//
// `#impl(Display)` / `#impl(Debug)` opt-in (Plan 154.1 Ф.2 / D268) binds the
// protocol to the primitive type and checks the signature.
//
// `f32` (Plan 154.1 followup [M-154.1-f32-display-debug], 2026-06-14): now
// covered — conv.h `nova_f32_to_str`/`_to_debug_str` widen to double + reuse
// the f64 formatter; `@append(f32)` casts to f64; interp-map routes `${f32}`
// directly to conv.h. Numeric debug == display (no escaping).

// Plan 174.2 (str.from-ретракция) + Plan 208 Ф.2 (D422 signature migration):
// тела ниже пишут через интерполяцию ("${@}" / "${@:?}") НАПРЯМУЮ — НЕ через
// `.to_str()` (инвариант рекурсии: `.to_str()`'s blanket-тело САМО есть
// `"${@}"`; примитив-путь `${@}` лоуэрится в emit_c.rs::emit_interpolated_str
// прямо в nova_int_to_str/nova_f64_to_str/… — цикла нет ни в одну, ни в
// другую сторону). Debug-тело численных примитивов идентично display (D229 —
// numbers don't need escaping), спеллинг через `:?` — та же C-функция
// (nova_*_to_debug_str == nova_*_to_str, conv.h).
//
// `.bytes()` on the interpolated-string RESULT (a runtime `str` VALUE, not a
// literal) is required now that `Write.@write` takes `[]u8` (D374 aменд ×2)
// — D55's literal→[]u8 coercion only covers literal `"..."` positions, not
// an interpolated expression's result (D176 explicit-.bytes() rule).
//
// These bodies are the STRUCTURAL-satisfaction primitive for `Display`/
// `Debug` (required, no default per D422 §3) — the compiler's OWN
// interpolation codegen (`emit_interpolated_str`/`emit_format_spec_value`)
// never actually CALLS them for a bare or rich-spec primitive (it keeps its
// pre-existing direct `conv.h` fast path, unchanged byte-for-byte). They are
// exercised only when a primitive is dispatched to POLYMORPHICALLY through a
// generic `Fmt`-typed sink — e.g. `Option[T Debug]`/`Result[T Debug, E Debug]`
// below calling `v.debug(f)` where `T`/`E` monomorphizes to a primitive, or a
// future `Vec[T]`/`[]T` generic Display (Ф.3). Radix/width/alternate axes on
// `f` are therefore NOT read here (`f.kind()` stays unconsulted) — a nested
// `${container:x}` hex-formatting its primitive elements is out of THIS
// phase's scope (no existing call site exercises it; documented follow-up,
// see `docs/plans/208-impl-progress.md`).
#impl(Display)
fn int @display(mut f Fmt) -> () { f.write("${@}".bytes()) }
#impl(Debug)
fn int @debug(mut f Fmt) -> () { f.write("${@:?}".bytes()) }

#impl(Display)
fn f64 @display(mut f Fmt) -> () { f.write("${@}".bytes()) }
#impl(Debug)
fn f64 @debug(mut f Fmt) -> () { f.write("${@:?}".bytes()) }

// Plan 180: f32 display/debug — f32-precise shortest-round-trip formatter
// (nova_f32_to_str, strtof-based), routed directly by the interp `${f32}`
// dispatch (emit_c.rs primitive_to_str_fn). Widening to f64 first
// (`@ as f64` before interpolating) would surface the f32→f64 mantissa tail
// (0.1f → "0.10000000149011612"); the direct f32 interp path keeps "0.1".
#impl(Display)
fn f32 @display(mut f Fmt) -> () { f.write("${@}".bytes()) }
#impl(Debug)
fn f32 @debug(mut f Fmt) -> () { f.write("${@:?}".bytes()) }

#impl(Display)
fn bool @display(mut f Fmt) -> () { f.write("${@}".bytes()) }
#impl(Debug)
fn bool @debug(mut f Fmt) -> () { f.write("${@:?}".bytes()) }

#impl(Display)
fn char @display(mut f Fmt) -> () { f.write("${@}".bytes()) }
#impl(Debug)
fn char @debug(mut f Fmt) -> () { f.write("${@:?}".bytes()) }

#impl(Display)
fn str @display(mut f Fmt) -> () { f.write(@.bytes()) }
#impl(Debug)
fn str @debug(mut f Fmt) -> () { f.write("${@:?}".bytes()) }


// ──────────────────────────────────────────────────────────────────────────
// Option[T] / Result[T,E] — Debug impl
// ──────────────────────────────────────────────────────────────────────────
// Plan 91.15 Ф.2 originally declared these in `std/prelude/core.nv`, next to the
// Option/Result type declarations. Plan 169.2.1 (D303) moved them HERE because
// they reference the `Debug` protocol and the `Write` sink — both declared in
// THIS module — so under a partial `#prelude(core, runtime)` (no `protocols`)
// they raised `E_IMPL_UNKNOWN_PROTOCOL`. Hosting them with the protocols they
// implement keeps `core` self-contained (its "ZERO imports" architecture rule)
// and lets `#prelude(core, runtime)` compile. The `Option`/`Result` types are
// visible here via the prelude auto-import (re-exported from `prelude.core`).

/// Debug representation for Option[T]: `Some(value)` or `None`.
/// Requires `[T Debug]` — propagates the bound to the inner value.
///
/// # Examples
///
/// ```nova
/// assert("${Some(42):?}" == "Some(42)")
/// assert("${None:?}" == "None")
/// assert("${Some("hi"):?}" == "Some(\"hi\")")
/// ```
#impl(Debug)
fn Option[T Debug] @debug(mut f Fmt) -> () {
    match @ {
        Some(v) => {
            f.write("Some(".bytes())
            v.debug(f)
            f.write(")".bytes())
        }
        None => f.write("None".bytes())
    }
}

/// Debug representation for Result[T,E]: `Ok(value)` or `Err(error)`.
/// Requires `[T Debug, E Debug]`.
///
/// # Examples
///
/// ```nova
/// assert("${Ok(1):?}" == "Ok(1)")
/// assert("${Err("oops"):?}" == "Err(\"oops\")")
/// ```
#impl(Debug)
fn Result[T Debug, E Debug] @debug(mut f Fmt) -> () {
    match @ {
        Ok(v) => {
            f.write("Ok(".bytes())
            v.debug(f)
            f.write(")".bytes())
        }
        Err(e) => {
            f.write("Err(".bytes())
            e.debug(f)
            f.write(")".bytes())
        }
    }
}

// Plan 172.3 (D310): stdlib type-set bounds over the primitive integer families.
// A type-set is a named set of concrete types usable as a generic bound
// (`fn[T SignedInt] …`), монорфизируется per member. Signed and unsigned are
// SEPARATE sets — u64.MAX = 2^64-1 ∉ i64, so a single body cannot be sound for
// both (E_TYPE_SET_MIXED_SIGNEDNESS guards user-declared mixed sets).
//
// Главный потребитель — Plan 174.1 (primitive parse API): один
// `fn[T SignedInt] T.try_parse(...)` вместо ×N per-type обёрток.
type SignedInt   set i8 | i16 | i32 | i64 | int
type UnsignedInt set u8 | u16 | u32 | u64 | uint

// Plan 206 Ф.0 (D423): полное объединение SignedInt ∪ UnsignedInt — единый
// bound для `@overflowing_*`/`@checked_*`/`@saturating_*`/`@wrapping_*`
// (один бланкет на op вместо ×2 через SignedInt/UnsignedInt раздельно).
// D310 §«Знаковость» запрещает ЧАСТИЧНЫЙ signed/unsigned микс (несоундно —
// разные value-domains); ПОЛНОЕ объединение (все 5 signed + все 5 unsigned,
// без пропусков) — отдельно разрешённый случай (D423 amends D310): тело
// использует только per-member-моно `T.MAX`/`T.MIN`-резолв и знак-агностичные
// сравнения (`rhs < 0` у unsigned константно false), несоундности из
// частичного микса тут нет. Тот же случай, что иллюстративный `AnyNumber`
// в самом тексте D310 (02-types.md).
type Ints set i8 | i16 | i32 | i64 | int | u8 | u16 | u32 | u64 | uint

// Plan 206 Ф.2 (D423): три .nv-бланкета над компиляторным интринсиком
// `@overflowing_add/_sub/_mul` (генерик `fn[T Ints] T @overflowing_op(rhs T)
// -> (T, bool)`, Ф.1 hardcoded dispatch, см. 206-progress.md). По одному
// бланкету на op — работает и для signed, и для unsigned Ints без
// дублирования тела (диспетч бланкетов над примитивами — D164-фикс).
//
// - `checked_*` -> `Option[T]` (overflow -> `None`, иначе `Some(wrapped)`).
// - `wrapping_*` -> `T` (модульная арифметика: берёт `wrapped`, флаг игнор).
// - `saturating_*` -> `T` (overflow -> клампит к `T.MAX`/`T.MIN`,
//   ОП-СПЕЦИФИЧНАЯ формула направления, НЕ «по знаку rhs» одинаково для
//   всех трёх — см. план §Дизайн):
//     add: overflow -> `rhs > 0 ? MAX : MIN`
//     sub: overflow -> `rhs < 0 ? MAX : MIN` (вычли отрицательное -> вверх)
//     mul: overflow -> `(a < 0) == (rhs < 0) ? MAX : MIN` (одинаковый знак
//          операндов -> произведение вверх)
//   Все три формулы автоматически корректны и для unsigned: `x < 0`
//   константно `false` для unsigned-члена мономорфизации -> ветки
//   схлопываются в правильную сторону (unsigned add/mul -> MAX, unsigned
//   sub -> MIN=0).
// - `unchecked_*` — ОТЛОЖЕН (владелец 2026-07-14), не реализуется здесь.

/// `checked_add` — `None` при overflow, иначе `Some(a + b)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_add(rhs T) -> Option[T] {
    ro (wrapped, overflowed) = @overflowing_add(rhs)
    if overflowed { None } else { Some(wrapped) }
}

/// `checked_sub` — `None` при overflow, иначе `Some(a - b)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_sub(rhs T) -> Option[T] {
    ro (wrapped, overflowed) = @overflowing_sub(rhs)
    if overflowed { None } else { Some(wrapped) }
}

/// `checked_mul` — `None` при overflow, иначе `Some(a * b)`.
#stable(since = "0.1")
export fn[T Ints] T @checked_mul(rhs T) -> Option[T] {
    ro (wrapped, overflowed) = @overflowing_mul(rhs)
    if overflowed { None } else { Some(wrapped) }
}

/// `wrapping_add` — модульная арифметика (2^n wraparound); флаг overflow игнорируется.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_add(rhs T) -> T {
    ro (wrapped, _overflowed) = @overflowing_add(rhs)
    wrapped
}

/// `wrapping_sub` — модульная арифметика (2^n wraparound); флаг overflow игнорируется.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_sub(rhs T) -> T {
    ro (wrapped, _overflowed) = @overflowing_sub(rhs)
    wrapped
}

/// `wrapping_mul` — модульная арифметика (2^n wraparound); флаг overflow игнорируется.
#stable(since = "0.1")
export fn[T Ints] T @wrapping_mul(rhs T) -> T {
    ro (wrapped, _overflowed) = @overflowing_mul(rhs)
    wrapped
}

/// `saturating_add` — при overflow клампит к `T.MAX`/`T.MIN` (направление
/// по знаку `rhs`: прибавили положительное -> перелилось вверх -> `MAX`).
#stable(since = "0.1")
export fn[T Ints] T @saturating_add(rhs T) -> T {
    ro (wrapped, overflowed) = @overflowing_add(rhs)
    if overflowed {
        if rhs > 0 { T.MAX } else { T.MIN }
    } else {
        wrapped
    }
}

/// `saturating_sub` — при overflow клампит к `T.MAX`/`T.MIN` (направление по
/// знаку `rhs`: вычли отрицательное -> перелилось вверх -> `MAX`; unsigned
/// underflow -> `MIN` = 0).
#stable(since = "0.1")
export fn[T Ints] T @saturating_sub(rhs T) -> T {
    ro (wrapped, overflowed) = @overflowing_sub(rhs)
    if overflowed {
        if rhs < 0 { T.MAX } else { T.MIN }
    } else {
        wrapped
    }
}

/// `saturating_mul` — при overflow клампит к `T.MAX`/`T.MIN` (направление по
/// знаку операндов: одинаковый знак -> произведение положительное ->
/// перелилось вверх -> `MAX`; разный знак -> вниз -> `MIN`).
#stable(since = "0.1")
export fn[T Ints] T @saturating_mul(rhs T) -> T {
    ro (wrapped, overflowed) = @overflowing_mul(rhs)
    if overflowed {
        if (@ < 0) == (rhs < 0) { T.MAX } else { T.MIN }
    } else {
        wrapped
    }
}
