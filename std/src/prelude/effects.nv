// std/prelude/effects.nv — file-based declarations for prelude effects:
// Fail[E], Detach (keyword). All are runtime-defined — declarations here
// provide canonical API surface for `nova doc` and splittable prelude.
//
// `Mem` — NOT an effect (D76 amend, [M-mem-effect-demote-to-namespace],
// owner decision 2026-08-01): demoted to a plain namespace (`export type
// Mem`, unit type — same shape as `RawMem`, std/src/runtime/raw_mem.nv).
// It never had a vtable/handler/mock — all three defining properties of an
// effect were absent, and its own original D76 rationale ("a vtable would
// distort the measurement") was already an argument AGAINST effect-hood.
// Call syntax (`Mem.alloc_count()` etc.) is unchanged for consumers.

module prelude.effects

/// **Failable effect** — a way to declare an error in a function signature.
///
/// **Parameter `E`** — the type of the value passed to `fail(e)`. Can be any
/// Nova type (sum type, record, str, int, etc.). Convention:
/// domain errors are sum types (see `std.prelude.errors.RuntimeError`).
///
/// **Signature `fail(e E) -> never`** — the operation never returns control.
/// A handler body for a never-operation must end with `interrupt v`,
/// `throw err`, `panic(...)` or `exit(...)`.
///
/// **Syntactic sugar:**
///   - `throw expr` desugars to `Fail[E].fail(expr)` where `E` is inferred
///     from the expr type.
///   - postfix `expr!!` on `Option[T]` / `Result[T, E]` also desugars
///     into `Fail` via unwrap-or-fail.
///
/// **Handler forms:**
/// ```
/// // Lambda form: inferred Fail[E] handler.
/// with Fail[E] = |e| { panic("got {}", e) } { body }
///
/// // Explicit handler form: full Effect[Fail[E]] declaration.
/// with Fail[E] = effect Fail[E] { fail(e) -> never => panic("...") } { body }
/// ```
///
/// **Default handler:** the runtime installs a handler that calls
/// `nova_throw` with a longjmp to the nearest fail-frame — silent
/// propagation to the caller.
///
/// **Auto-inference:** if a function contains `throw` and `Fail` is absent
/// from the effect row, the compiler automatically adds `Fail`. Applies
/// only to non-exported functions; exported ones require explicit `Fail[E]`.
#stable(since = "0.1")
export type Fail[E] effect {
    fail(e E) -> never
}

// `Time` effect + its `real_time()` default-handler — moved to
// `std/time/duration/time_effect.nv`.

/// **TimerMetrics-effect** — read-only introspection timer-runtime counters.
///
/// **Purpose:** observe the timer alloc/fire/cancel counters without
/// turning `Time` into an inflated effect. `Mem` (below) is the namespace
/// analogue for allocator counters — same read-only-introspection
/// motivation, but demoted OUT of the effect system entirely (D76 amend,
/// [M-mem-effect-demote-to-namespace]) since it never had a vtable/
/// handler/mock to begin with. `TimerMetrics` itself stays an effect for
/// now (out of scope for the D76 amend).
///
/// **Operations (all `() -> int`, ns/ms counters):**
///   - `timer_alloc_total()` — total timers allocated.
///   - `timer_alloc_active()` — currently active (alloc − fired − cancelled).
///   - `timer_fired()` — fired naturally.
///   - `timer_cancelled()` — cancelled.
///   - `timer_longest_pending_ms()` — rolling-max wait (ms).
///
/// **Default handler:** runtime hooks, read-only — not a suspend effect.
#stable(since = "0.1")
export type TimerMetrics effect {
    timer_alloc_total() -> int
    timer_alloc_active() -> int
    timer_fired() -> int
    timer_cancelled() -> int
    timer_longest_pending_ms() -> int
}

// ──────────────────────────────────────────────────────────────────────────
// `Mem` namespace — runtime introspection for memory allocator stats
// ──────────────────────────────────────────────────────────────────────────
//
// D76 amend, [M-mem-effect-demote-to-namespace] (owner decision
// 2026-08-01): `Mem` used to be `export type Mem effect { ... }`, but it
// never had a vtable, a handler, or a mock — every property that makes an
// effect an effect was absent, and the ops were already thin inline
// wrappers over runtime counters. `Mem`'s own original D76 rationale ("a
// vtable would distort the measurement") was an argument AGAINST
// effect-hood, not for it. Demoted to a plain namespace type, same shape
// as `RawMem` (`std/src/runtime/raw_mem.nv`): a unit type carrying static
// methods over `extern "C"` runtime counters. Call syntax for consumers
// (`Mem.alloc_count()`, `Mem.reset()`, …) is UNCHANGED.

/// `Mem` — a namespace for GC allocator-stats introspection (NOT an
/// effect — see the D76 amend note above).
///
/// **Purpose:** leak/growth tests can observe allocator counters
/// without exposing GC internals.
///
/// **Operations:**
///   - `alloc_count() -> int` — total nova_alloc calls since gc_init
///     or the last `reset()`.
///   - `free_count() -> int` — total free calls.
///   - `live() -> int` — `alloc_count() - free_count()`, a rough estimate
///     of live allocations.
///   - `reset() -> ()` — zero stats counters (per-test isolation).
#stable(since = "0.1")
export type Mem

/// `nova_rt/alloc.h` — GC allocator stat counters (literal-name `extern
/// "C" fn`, D282). File-private: `Mem.*` below is the only public surface.
extern "C" fn nova_gc_alloc_count() -> int
extern "C" fn nova_gc_free_count() -> int
extern "C" fn nova_gc_live_count() -> int
extern "C" fn nova_gc_reset_stats() -> ()

/// Total `nova_alloc` calls since `nova_gc_init` or the last `Mem.reset()`.
export fn Mem.alloc_count() -> int {
    nova_gc_alloc_count()
}

/// Total free/release calls (plain-malloc backend → `0`).
export fn Mem.free_count() -> int {
    nova_gc_free_count()
}

/// `alloc_count() - free_count()` — a rough estimate of live allocations.
export fn Mem.live() -> int {
    nova_gc_live_count()
}

/// Zero the allocator stats counters (per-test isolation).
export fn Mem.reset() -> () {
    nova_gc_reset_stats()
}

/// **Random-effect** — ambient PRNG.
///
/// **Purpose:** AI-first substitution of randomness. Production code
/// (`Uuid.v4()`, `Ulid.new()`, retry-jitter) declares `Random` in the
/// effect row; tests replace the handler with a deterministic PRNG:
/// ```nova
/// import std.testing.handlers as th
/// with Random = th.seeded(42) { Uuid.v4() }   // deterministic
/// ```
/// The `seeded(seed u64) -> Effect[Random]` handler factory (xoshiro256++)
/// lives in `std/testing/handlers.nv`.
///
/// **[M-random-u64-path-return-ice]:** the declaration moved here from
/// `std/testing/handlers.nv`. While it lived outside the prelude, modules
/// (uuid, ulid, retry) had no `effect_schemas["Random"]`, and codegen hit
/// the «Path call return type unknown» ICE. The prelude is the single
/// source of the schema; emitted as a regular user effect (no RUNTIME_DEFINED_TYPES).
#stable(since = "0.1")
export type Random effect {
    u64() -> u64                        // 64 случайных бита
    bytes(n int) -> []u8                // массовая генерация
}

// ──────────────────────────────────────────────────────────────────────────
// ResourceTrace observability effect
// ──────────────────────────────────────────────────────────────────────────

/// `ResourceTrace` effect — observability-only handler dispatch for tracing
/// resource-scope entry/exit. Default handler — no-op, zero overhead if not
/// used. Orthogonal to `Cleanup[E].@cleanup` — a layer for metrics/tracing.
///
/// **Operations:**
///   - `on_resource_enter(label str)` — invoked on entering a
///     `consume X = ... { body }` scope block.
///   - `on_resource_exit(label str, outcome ScopeOutcome, duration_ms int,
///     overrun bool)` — invoked on scope exit with the final outcome.
///     Cleanup always runs to completion (no force interrupts exist).
///
/// **Handler restrictions:**
///   - A handler cannot `throw` (observability must be idempotent).
///   - A handler cannot `suspend` (sync-only).
///   - Return type `()` (observability-only, not value-returning).
#stable(since = "0.1")
export type ResourceTrace effect {
    on_resource_enter(label str) -> ()
    on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> ()
}

// ──────────────────────────────────────────────────────────────────────────
// Supervisor effect (supervision-as-effect) + Decision
// ──────────────────────────────────────────────────────────────────────────

/// **Supervisor's decision** on a child scope failure.
/// Returned by the `Supervisor.on_child_fail` handler.
///
///   - `Escalate` — the child's error becomes the scope's primary error,
///     siblings are cooperatively cancelled, the scope re-throws it outward.
///     Default behavior (without a supervisor).
///   - `Stop` — the child is "discarded": its error is NOT escalated,
///     siblings are NOT cancelled, the scope keeps working. The error stays
///     available for diagnostics.
///
/// The `Restart` family was retracted: restart is an actor-system idiom,
/// while `supervised` is structured concurrency; retrying lives in the child body — `std/concurrency/retry`.
#stable(since = "0.1")
export type Decision enum Escalate | Stop

/// **Supervisor effect** — a swappable policy for reacting to a child
/// failure of `spawn`/`parallel for` inside `supervised { ... }`.
///
/// **Operation** `on_child_fail(idx int, err any) -> Decision`:
///   - `idx` — the retention slot of the failed child (spawn order of the
///     scope's remote children);
///   - `err` — the error value as `any`: a typed-throw payload (narrowed
///     with `err is T`), for string-throw / panic — a `str` message.
///
/// **Strategies = handlers:** there is no separate "strategy name" entity.
/// Built-in policies: `std.concurrency.supervisor` (`escalate()` / `stop()`).
///
/// ```nova
/// import std.concurrency.supervisor as sup
/// with Supervisor = sup.stop() {
///     supervised {
///         for u in urls { spawn { fetch(u) } }
///     }
/// }
/// ```
///
/// **Default (no handler):** the first error cancels siblings and is
/// re-thrown (byte-parity with the old behavior).
///
/// **Call semantics:** the handler runs serially, one failure at a time.
/// A child panic also reaches the decision; induced sibling cancellations
/// are not shown to the handler.
///
/// **Handler restrictions:** `throw`/`Fail` allowed (Escalate-with-error);
/// `interrupt` and suspend operations (`Time.sleep`) forbidden.
#stable(since = "0.1")
export type Supervisor effect {
    on_child_fail(idx int, err any) -> Decision
}

// ──────────────────────────────────────────────────────────────────────────
// Application effect для top-level lifecycle
// ──────────────────────────────────────────────────────────────────────────

/// Application effect for the top-level application lifecycle
/// (finalizers + default exit_timeout for cleanup scopes).
///
/// **Operations:**
///   - `register_finalizer(f fn() -> ())` — register a fn to run on
///     exit from the enclosing `with Application = handler { ... }` scope.
///     Topo-order: reverse of registration (LIFO).
///   - `default_exit_timeout_ms() -> int` — fallback for ConsumeScope
///     timeout resolution.
///
/// **Use cases:**
///   - `Application.register_finalizer(|| metrics.flush())` — clean
///     metrics shutdown.
///   - `with Application = Application.handler(default_exit_timeout_ms: 10_000)`
///     — set global cleanup timeout.
///
/// **Nesting semantics:**
///   - Inner handler wins (effect-stack semantics).
///   - Finalizer registry NOT inherited (test isolation).
///   - Default exit_timeout NOT inherited.
///   - Cross-fiber: a spawned child sees the parent's Application via the effect snapshot.
///   - abort/SIGKILL do not fire finalizers (OS limitation).
#stable(since = "0.1")
export type Application effect {
    register_finalizer(f fn() -> ()) -> ()
    default_exit_timeout_ms() -> int
}
