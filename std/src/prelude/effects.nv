// std/prelude/effects.nv — file-based declarations for prelude effects:
// Fail[E], Mem, Detach (keyword). All are runtime-defined — declarations here
// provide canonical API surface for `nova doc` and splittable prelude.

module prelude.effects

/// **Failable-эффект** — способ объявить ошибку в сигнатуре функции.
///
/// **Параметр `E`** — тип значения, передаваемого в `fail(e)`. Может быть
/// любой Nova-тип (sum-type, record, str, int, etc.). Соглашение:
/// доменные ошибки — sum-типы (см. `std.prelude.errors.RuntimeError`).
///
/// **Сигнатура `fail(e E) -> never`** — операция не возвращает управление.
/// handler-body для never-операции обязан завершиться `interrupt v`,
/// `throw err`, `panic(...)` или `exit(...)`.
///
/// **Syntactic sugar:**
///   - `throw expr` desugar'ится в `Fail[E].fail(expr)` где `E` infer'ится
///     из expr type.
///   - postfix `expr!!` на `Option[T]` / `Result[T, E]` тоже
///     desugar'ится в `Fail` через unwrap-or-fail.
///
/// **Handler-формы:**
/// ```
/// // Lambda-форма: inferred Fail[E] handler.
/// with Fail[E] = |e| { panic("got {}", e) } { body }
///
/// // Explicit handler-форма: full Effect[Fail[E]] declaration.
/// with Fail[E] = effect Fail[E] { fail(e) -> never => panic("...") } { body }
/// ```
///
/// **Default handler:** runtime устанавливает обработчик, который вызывает
/// `nova_throw` с longjmp к ближайшему fail-frame — бесшумная propagation
/// в caller'а.
///
/// **Auto-inference:** если функция содержит `throw` и `Fail` отсутствует
/// в effect-row, компилятор автоматически добавляет `Fail`. Применяется
/// только к non-exported функциям; exported требуют явный `Fail[E]`.
#stable(since = "0.1")
export type Fail[E] effect {
    fail(e E) -> never
}

// `Time` effect + its `real_time()` default-handler — moved to
// `std/time/duration/time_effect.nv`.

/// **TimerMetrics-effect** — read-only introspection timer-runtime counters.
///
/// **Назначение:** наблюдать счётчики таймеров alloc/fire/cancel без
/// превращения `Time` в раздутый эффект. Симметрично `Mem`.
///
/// **Operations (все `() -> int`, ns/ms-счётчики):**
///   - `timer_alloc_total()` — суммарно аллоцировано таймеров.
///   - `timer_alloc_active()` — активных сейчас (alloc − fired − cancelled).
///   - `timer_fired()` — сработавших естественно.
///   - `timer_cancelled()` — отменённых.
///   - `timer_longest_pending_ms()` — rolling-max ожидания (ms).
///
/// **Default handler:** runtime hooks, read-only — не suspend-effect.
#stable(since = "0.1")
export type TimerMetrics effect {
    timer_alloc_total() -> int
    timer_alloc_active() -> int
    timer_fired() -> int
    timer_cancelled() -> int
    timer_longest_pending_ms() -> int
}

/// **Mem-effect** — runtime introspection эффект для memory allocator stats.
///
/// **Назначение:** leak/growth тесты могут наблюдать allocator counters
/// без exposing GC internals.
///
/// **Operations:**
///   - `alloc_count() -> int` — total nova_alloc calls с момента gc_init
///     или последнего `reset()`.
///   - `free_count() -> int` — total free calls.
///   - `live() -> int` — `alloc_count() - free_count()`, грубая оценка
///     live allocations.
///   - `reset() -> ()` — zero stats counters (per-test isolation).
///
/// **Default handler:** runtime hooks, read-only.
///
/// **Не user-overridable:** хотя `with Mem = handler {...}` разрешён,
/// semantically counters отражают реальное состояние аллокатора.
#stable(since = "0.1")
export type Mem effect {
    alloc_count() -> int
    free_count() -> int
    live() -> int
    reset() -> ()
}

/// **Random-effect** — ambient PRNG.
///
/// **Назначение:** AI-first substitution случайности. Production-код
/// (`Uuid.v4()`, `Ulid.new()`, retry-jitter) объявляет
/// `Random` в effect-row; тесты подменяют handler детерминированным PRNG:
/// ```nova
/// import std.testing.handlers as th
/// with Random = th.seeded(42) { Uuid.v4() }   // deterministic
/// ```
/// Handler-фабрика `seeded(seed u64) -> Effect[Random]` (xoshiro256++) —
/// в `std/testing/handlers.nv`.
///
/// **[M-random-u64-path-return-ice]:** декларация перенесена сюда из
/// `std/testing/handlers.nv`. Когда декларация жила вне prelude, модули
/// (uuid, ulid, retry) не имели `effect_schemas["Random"]`, и codegen падал
/// ICE «Path call return type unknown». Prelude — единственный источник
/// схемы. Эмитится как обычный user-effect (без RUNTIME_DEFINED_TYPES).
#stable(since = "0.1")
export type Random effect {
    u64() -> u64                        // 64 случайных бита
    bytes(n int) -> []u8                // массовая генерация
}

// ──────────────────────────────────────────────────────────────────────────
// ResourceTrace observability effect
// ──────────────────────────────────────────────────────────────────────────

/// `ResourceTrace` effect — observability-only handler dispatch для tracing
/// resource-scope entry/exit. Default handler — no-op, zero-overhead если не
/// использован. Orthogonal к `Cleanup[E].@cleanup` — слой для metrics/tracing.
///
/// **Operations:**
///   - `on_resource_enter(label str)` — invoked при входе в
///     `consume X = ... { body }` scope-block.
///   - `on_resource_exit(label str, outcome ScopeOutcome, duration_ms int,
///     overrun bool)` — invoked при выходе из scope с финальным outcome.
///     Cleanup всегда добегает (force-прерывания не существует).
///
/// **Handler restrictions:**
///   - Handler не может `throw` (observability должна быть idempotent).
///   - Handler не может `suspend` (sync-only).
///   - Return type `()` (observability-only, not value-returning).
#stable(since = "0.1")
export type ResourceTrace effect {
    on_resource_enter(label str) -> ()
    on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> ()
}

// ──────────────────────────────────────────────────────────────────────────
// Supervisor effect (supervision-as-effect) + Decision
// ──────────────────────────────────────────────────────────────────────────

/// **Решение супервизора** на падение ребёнка scope'а.
/// Возвращается хендлером `Supervisor.on_child_fail`.
///
///   - `Escalate` — ошибка ребёнка становится primary-ошибкой scope'а,
///     siblings кооперативно отменяются, scope перевыбрасывает наружу.
///     Поведение дефолта (без супервизора).
///   - `Stop` — ребёнок «выкинут»: его ошибка НЕ эскалируется, siblings
///     НЕ отменяются, scope продолжает работу. Ошибка доступна диагностике.
///
/// `Restart`-семейство ретрактировано: рестарт — идиома акторных систем,
/// а `supervised` — структурная конкуренция. Повтор попытки живёт внутри
/// тела ребёнка — `std/concurrency/retry`.
#stable(since = "0.1")
export type Decision enum Escalate | Stop

/// **Supervisor-эффект** — подменяемая политика реакции на падение ребёнка
/// `spawn`/`parallel for` внутри `supervised { ... }`.
///
/// **Операция** `on_child_fail(idx int, err any) -> Decision`:
///   - `idx` — retention-слот упавшего ребёнка (spawn-порядок remote-детей
///     scope'а);
///   - `err` — значение ошибки как `any`: typed-throw payload (сужается
///     `err is T`), для string-throw / panic — `str`-сообщение.
///
/// **Стратегии = хендлеры:** отдельной сущности «имя стратегии» нет.
/// Встроенные политики: `std.concurrency.supervisor` (`escalate()` / `stop()`).
///
/// ```nova
/// import std.concurrency.supervisor as sup
/// with Supervisor = sup.stop() {
///     supervised {
///         for u in urls { spawn { fetch(u) } }
///     }
/// }
/// ```
///
/// **Дефолт (нет хендлера):** первая ошибка отменяет siblings и
/// перевыбрасывается (байт-паритет со старым поведением).
///
/// **Семантика вызова:** хендлер исполняется сериализованно, по одному
/// падению. panic ребёнка тоже доходит до решения; индуцированные отмены
/// siblings хендлеру не показываются.
///
/// **Ограничения хендлера:** `throw`/`Fail` разрешён (Escalate-with-error);
/// `interrupt` и suspend-операции (`Time.sleep`) запрещены.
#stable(since = "0.1")
export type Supervisor effect {
    on_child_fail(idx int, err any) -> Decision
}

// ──────────────────────────────────────────────────────────────────────────
// Application effect для top-level lifecycle
// ──────────────────────────────────────────────────────────────────────────

/// Application effect для top-level application lifecycle
/// (finalizers + default exit_timeout для cleanup-scopes).
///
/// **Operations:**
///   - `register_finalizer(f fn() -> ())` — register fn to run при
///     exit из enclosing `with Application = handler { ... }` scope.
///     Topo-order: reverse of registration (LIFO).
///   - `default_exit_timeout_ms() -> int` — fallback для ConsumeScope
///     timeout resolution.
///
/// **Use cases:**
///   - `Application.register_finalizer(|| metrics.flush())` — clean
///     metrics shutdown.
///   - `with Application = Application.handler(default_exit_timeout_ms: 10_000)`
///     — set global cleanup timeout.
///
/// **Nesting semantics:**
///   - Inner handler wins (effect-stack semantics).
///   - Finalizer registry NOT inherited (test isolation).
///   - Default exit_timeout NOT inherited.
///   - Cross-fiber: spawn child видит parent's Application via effect snapshot.
///   - abort/SIGKILL не fires finalizers (OS limitation).
#stable(since = "0.1")
export type Application effect {
    register_finalizer(f fn() -> ()) -> ()
    default_exit_timeout_ms() -> int
}
