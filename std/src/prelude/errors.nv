// std/prelude/errors.nv — file-based source of truth для prelude error
// types.
//
// Архитектурные правила:
//   - **ZERO imports.** Все declarations self-contained на primitives
//     (`int`, `str`). Никаких `use std.runtime.*` — иначе circular
//     import через auto-imported prelude.
//
// Bootstrap status:
//
// - `RuntimeError` declared here как plain `type` (не `external`) —
//   variants visible для type-checker'а через cross-file resolve.
//   Codegen НЕ doubly-emit'ит C struct: `emit_type_decl`
//   skip'ает RuntimeError через RUNTIME_DEFINED_TYPES список —
//   implementation остаётся в `nova_rt/array.h`
//   (`Nova_RuntimeError` + `nova_make_RuntimeError_<Variant>`
//   constructors).
// - `init_prelude_decls_from_items` распознаёт RuntimeError type decl,
//   регистрирует Prelude entry с variants + abi + method_routing
//   **inherited от HardcodedBaseline** (behavior-preserving migration).
// - Pre-populated `sum_schemas["RuntimeError"]` оставлен как ABI-compat
//   fallback baseline («HardcodedBaseline остаётся fallback; lookup
//   precedence DeclaredFromPrelude > HardcodedBaseline»).
// - `ReadBufferError` — нет HardcodedBaseline entry; codegen
//   distinguish'ет sum-type через type-name только (runtime-level
//   payload — string-based throw, см. nova_rt/read_buffer.h).
//   Variants регистрируются через registry для cross-file resolve.
//
// `RuntimeNoneError` (unit-type) задекларирован ниже. Декларация —
// canonical type-name для type-checker'а; runtime throw остаётся
// string-payload (`nova_rt/effects.h`), structured payload отложен
// (тот же mechanism что у `ReadBufferError`).
// Bottom-тип НЕ мигрируется сюда — это строчный встроенный примитив
// `never`, не капитализированный prelude-тип.
//
// DEFER: throw-point conversion to structured `RuntimeError`-payload
// (compiler: a/b на 0, arr[i] out-of-bounds, etc.) остаётся отдельной
// задачей — требует расширения fail-frame mechanism с `nova_str` на
// `void*` payload.

module prelude.errors

// ──────────────────────────────────────────────────────────────────────────
// Runtime errors (bottom-level runtime errors)
// ──────────────────────────────────────────────────────────────────────────

/// Bottom-уровневые runtime-ошибки. Бросаются автоматически compiler'ом
/// (`a/b` на 0, `arr[i]` out-of-bounds, type mismatch, и т.д.) либо
/// вручную через `throw`.
///
/// `StackOverflow` и `OutOfMemory` НЕ входят — они panic, не Fail.
///
/// **Bootstrap**: `Nova_RuntimeError*` typedef + `nova_make_RuntimeError_*`
/// constructors живут в `nova_rt/array.h`. Pre-populated
/// `sum_schemas["RuntimeError"]` регистрирует 6 variants;
/// `init_prelude_decls_from_items` распознаёт эту декларацию и регистрирует
/// Prelude entry в `sum_schema_registry`, inheriting variant info и
/// (currently empty) `method_routing` от HardcodedBaseline.
///
/// **Variant set strict-equality:** этот declaration МУСТ matchить ровно
/// 6 вариантов HardcodedBaseline entry. Расширение variant set требует
/// edition bump.
#stable(since = "0.1")
export type RuntimeError enum
    | DivByZero
    | Overflow
    | IndexOutOfBounds { index int, length int }
    | TypeMismatch(str)
    | AssertFailed(str)
    | NoHandler(str)

// ──────────────────────────────────────────────────────────────────────────
// ReadBuffer errors
// ──────────────────────────────────────────────────────────────────────────

/// Ошибка чтения буфера: данных меньше чем ожидалось. Throw'ится
/// `@read_*` методами `ReadBuffer` (см. nova_rt/read_buffer.h) когда
/// cursor выходит за границы underlying byte-slice.
///
/// **Bootstrap**: actual error payload в `Nova_Fail_fail` — это
/// formatted `nova_str` ("ReadBuffer.UnexpectedEnd: wanted N, available M",
/// см. nova_rt/read_buffer.h), НЕ structured `Nova_ReadBufferError*`.
/// Эта Nova-level декларация даёт type-checker'у канонический type-name
/// для signatures `Fail[ReadBufferError]` / `Result[T, ReadBufferError]`
/// и pattern-matching конструкций. Конверсия в structured payload отложена.
///
/// Variants:
///   - `UnexpectedEnd { wanted int, available int }` — попытка прочитать
///     `wanted` байтов когда осталось `available < wanted`.
#stable(since = "0.1")
export type ReadBufferError enum
    | UnexpectedEnd { wanted int, available int }

// ──────────────────────────────────────────────────────────────────────────
// Option-unwrap error
// ──────────────────────────────────────────────────────────────────────────

/// Ошибка разворачивания пустого `Option`. Бросается оператором `expr!!`
/// когда `expr` — `None` (`Option!!` → `throw RuntimeNoneError`). Функция,
/// использующая `opt!!`, должна иметь `Fail[RuntimeNoneError]` в сигнатуре.
///
/// Unit-тип (без вариантов / полей) — носит сам факт «развернули None»,
/// полезной нагрузки нет.
///
/// **Bootstrap:** actual throw в `nova_rt/effects.h` — это string-payload
/// (`nova_throw(nova_str_from_cstr("RuntimeNoneError"))`), structured
/// `Nova_RuntimeNoneError*` payload не строится. Эта Nova-level
/// декларация даёт type-checker'у канонический type-name для сигнатур
/// `Fail[RuntimeNoneError]` / pattern-matching. Конверсия в structured
/// payload отложена (тот же mechanism что у `ReadBufferError`).
///
/// # Examples
///
/// ```nova
/// fn first_word(s str) Fail[RuntimeNoneError] -> str =>
///     s.split(" ").next()!!
/// ```
#stable(since = "0.1")
export type RuntimeNoneError

// ──────────────────────────────────────────────────────────────────────────
// MultiError — composite error для failable cleanup
// ──────────────────────────────────────────────────────────────────────────

/// Composite error от **failable defer body**.
///
/// Когда cleanup-fail происходит **во время propagation другой ошибки** —
/// primary error НЕ заменяется; cleanup-error appended в chain `suppressed`.
/// Caller инспектирует composite через `.primary()` / `.suppressed()` API.
///
/// # Сценарии
///
/// **A. Cleanup-fail на normal exit** — `MultiError { primary: cleanup_err,
/// suppressed: [] }`. Single error; surface as обычный `Fail`.
///
/// **B. Cleanup-fail во время propagation primary'a** — `MultiError {
/// primary: original_err, suppressed: [cleanup_err1, cleanup_err2, ...] }`.
/// Caller видит root cause + cascaded cleanup failures.
///
/// **C. Multi-defer LIFO accumulation** — обрабатывается runtime'ом.
///
/// # Bootstrap
///
/// String-based: `primary: str` + `suppressed: []str`. Runtime materialize
/// MultiError из `NovaFailFrame.error_suppressed` chain (через
/// `nova_failframe_suppressed_count` / `nova_failframe_suppressed_at`).
///
/// Production-grade typed payload (`primary: E1`, `suppressed: []E2`) —
/// deferred.
///
/// # Examples
///
/// ```nova
/// fn process() Fail[Err] -> () {
///     consume tx = begin()
///     defer { tx.commit() }                       // failable cleanup
///     do_work_that_fails()?
/// }
///
/// match process() {
///     Ok(_) => Log.info("done"),
///     Err(e) => {
///         Log.error("primary: ${e.primary()}")
///         for s in e.suppressed() {
///             Log.error("  suppressed: ${s}")
///         }
///     }
/// }
/// ```
#stable(since = "0.1")
export type MultiError {
    ro primary str
    ro suppressed []str
}

/// Returns primary (root cause) error — what was originally thrown before
/// cleanup chain fired.
#stable(since = "0.1")
fn MultiError @primary() -> str => @primary

/// Returns chain of suppressed errors (cleanup-fail during propagation),
/// in LIFO order of firing (most-recently-fired first).
#stable(since = "0.1")
fn MultiError @suppressed() -> []str => @suppressed

/// Human-readable summary of composite — primary + numbered list of
/// suppressed.
#stable(since = "0.1")
fn MultiError @fmt_chain() -> str => @primary

// ──────────────────────────────────────────────────────────────────────────
// MultiError iteration + walk + panic detection
// ──────────────────────────────────────────────────────────────────────────

/// Walk over all errors в chain LIFO order
/// (primary first, then suppressed[0], suppressed[1], ...).
/// Возвращает []str — массив всех messages.
#stable(since = "0.1")
fn MultiError @walk() -> []str {
    mut result []str = []str.new(cap: @suppressed.len() + 1)
    result.push(@primary)
    for s in @suppressed {
        result.push(s)
    }
    result
}

/// Find first panic message в chain (если есть).
/// Bootstrap: ищет prefix "panic:" в messages — full typed panic
/// discrimination после `any` payload migration.
#stable(since = "0.1")
fn MultiError @find_first_panic() -> Option[str] {
    if @primary.starts_with("panic:") {
        return Some(@primary)
    }
    for s in @suppressed {
        if s.starts_with("panic:") {
            return Some(s)
        }
    }
    None
}

// ──────────────────────────────────────────────────────────────────────────
// Typed cancel/timeout/truncation errors
// ──────────────────────────────────────────────────────────────────────────

/// Cancel-as-error payload. При cancel/interrupt
/// в `consume {}` body — outcome приходит как `Failure(CancelError { ... })`.
/// Resource'у видна типизированная причина cancel'а вместо опаковой
/// «cancellation».
///
/// **Bootstrap status:** declaration here; codegen path
/// `nv_consume_emit_cancel_as_failure` материализует payload при
/// cancel-доставке в body.
///
/// # Examples
///
/// ```nova
/// fn Transaction consume @cleanup(outcome ScopeOutcome) Fail[DbError] -> () {
///     match outcome {
///         Success => @commit()!!
///         Failure(err) => {
///             if err is CancelError {
///                 // explicit cancel — rollback w/o full retry logic
///                 @rollback()!!
///             } else {
///                 @rollback_with_log(err.msg)!!
///             }
///         }
///         Panic(_) => @rollback_emergency()
///     }
/// }
/// ```
#stable(since = "0.1")
export type CancelError {
    ro reason str
}

/// Scope-deadline exceeded. Выбрасывается
/// runtime'ом наружу из `supervised(deadline:/timeout:) { ... }` когда срок
/// области истёк: все fiber'ы области кооперативно отменяются (тот же путь,
/// что `cancel:`), их cleanup'ы добегают, и наружу летит типизированный
/// `TimeoutError` — ловится `is TimeoutError` или
/// `with Fail[TimeoutError]`.
///
/// `deadline_ns` — превышенная точка на монотонных часах (абсолютные
/// наносекунды, epoch реализации; только дельты значимы). NB: ретрактнутый
/// `CleanupTimeoutError` был про
/// cleanup-бюджет ресурса и УДАЛЁН (превышение = watchdog-варн + overrun в
/// ResourceTrace exit-событии); этот тип — про срок ЦЕЛОЙ области
/// (bounded-shutdown) и живёт. Реальная USER-ошибка внутри области
/// побеждает срок (USER-precedence): при истечении срока И user-throw'е наружу
/// летит user-ошибка, не `TimeoutError`.
///
/// # Examples
///
/// ```nova
/// fn fetch_bounded() Fail[TimeoutError] -> () {
///     supervised(timeout: 5.to_seconds()) {
///         spawn { slow_download() }  // если > 5s — TimeoutError
///     }
/// }
///
/// with Fail[TimeoutError] = |_| interrupt handle_timeout() {
///     supervised(deadline: Monotonic.now() + 200.to_millis()) {
///         spawn { poll_until_ready() }
///     }
/// }
/// ```
#stable(since = "0.1")
export type TimeoutError {
    ro deadline_ns i64
}

/// Sentinel composed в `MultiError.suppressed` когда cleanup-cascade
/// глубина превышает depth-limit (256). Дальнейшие compose silently
/// ignored; pointer на этот sentinel signal'ит «cascade was truncated at
/// depth N».
///
/// **Bootstrap status:** declaration here; emission
/// в `nv_compose_error`.
#stable(since = "0.1")
export type MultiErrorTruncated {
    ro depth int
}

// ──────────────────────────────────────────────────────────────────────────
// Char conversion errors
// ──────────────────────────────────────────────────────────────────────────

/// Ошибка конверсии `int` → `char`. Выбрасывается `(cp int).to_char()`
/// когда codepoint вне диапазона [0, 0x10FFFF] или является surrogate
/// [0xD800, 0xDFFF].
///
/// Unit-тип — сам факт «невалидный codepoint», payload не нужен.
///
/// Renamed from `CharTryFromError` — `char.try_from` renamed to
/// `char.from` (was the only static char conversion without an infallible
/// sibling).
///
/// # Examples
///
/// ```nova
/// match (-1).to_char() {
///     Ok(c) => ...
///     Err(CharFromError) => // codepoint out of range
/// }
/// ```
#stable(since = "0.1")
export type CharFromError

/// Ошибка конверсии `char` → `u8`. Выбрасывается `u8.try_from(c char)`
/// когда codepoint > 0xFF (символ не является Latin-1).
///
/// Unit-тип — сам факт «символ не вмещается в u8».
///
/// # Examples
///
/// ```nova
/// match u8.try_from('é') {
///     Ok(b) => ...
///     Err(TryFromCharError) => // codepoint > 0xFF
/// }
/// ```
#stable(since = "0.1")
export type TryFromCharError

// ──────────────────────────────────────────────────────────────────────────
// Numeric narrowing error
// ──────────────────────────────────────────────────────────────────────────

/// Ошибка проверяемого сужающего числового преобразования (число→число).
/// Возвращается `try_to_<T>` семейством (`std/prelude/protocols.nv`,
/// `fn[S Ints] S @try_to_i8()`/`@try_to_u8()`/... — по одному бланкету на
/// целевой тип `<T>`, охватывает весь `Ints`-набор источников) когда
/// исходное значение не влезает в диапазон целевого типа `<T>` (`as`
/// остаётся быстрым обрезающим кастом — без изменений).
///
/// Unit-тип — сам факт «не влезло», payload не нужен (тот же прецедент,
/// что `CharFromError`/`TryFromCharError` выше — «факт без данных»).
///
/// # Examples
///
/// ```nova
/// match (300u32).try_to_u8() {
///     Ok(v) => ...                  // влезло — value as u8
///     Err(RangeError) => ...        // 300 > u8.MAX (255)
/// }
/// ro n = (-1i32).try_to_u8()
/// assert(n == Err(RangeError))      // отрицательное → unsigned
/// ```
#stable(since = "0.1")
export type RangeError
