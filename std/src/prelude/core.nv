// std/prelude/core.nv — file-based source of truth для core prelude types.
//
// Декларации перенесены из hardcoded type-checker builtins в этот файл:
//   1) `nova doc` показывает canonical API в одном месте,
//   2) пользователь может shadow'ить эти типы с warning'ом,
//   3) splittable prelude работает (`#prelude(core)` opt-in).
//
// Правила:
//   - **ZERO imports** — всё self-contained на primitives или
//     forward-reference через built-in effects.
//   - Никаких `use std.runtime.*` (circular import через auto-imported prelude).
//
// Сохранено как hardcoded:
//   - codegen pre-populated `sum_schemas[Result]` (bootstrap compromise);
//   - codegen pre-populated `record_schemas[Error]` (infrastructure для
//     `Nova_Error_static_new`);
//   - pattern-match dispatch + runtime helpers Option/Result.

module prelude.core

// `core` is unicode-free. Unicode methods moved to `std/unicode/category.nv`,
// re-exported through `std/prelude.nv` (not through core).
// [M-169.2.1-core-unicode-decouple]

// ──────────────────────────────────────────────────────────────────────────
// Sum types
// ──────────────────────────────────────────────────────────────────────────

/// Optional value — `Some(v)` либо `None`. Idiomatic путь для
/// fallible операций без exceptions / null.
#stable(since = "0.1")
export type Option[T] enum Some(T) | None

/// Result of fallible computation. `Ok(v)` — success, `Err(e)` —
/// failure with typed error payload `e: E`.
#stable(since = "0.1")
export type Result[T, E] enum Ok(T) | Err(E)

// `Ordering` sum-type удалён — `compare.compare` возвращает int.
//
// Bottom-тип `never` — строчный встроенный примитив (как `int`/`bool`),
// в prelude НЕ объявляется. Известен компилятору напрямую.

/// Exit-outcome для `consume X = expr { body }` scope-block'а.
/// `Cleanup.cleanup` получает это значение и решает что делать с ресурсом.
///
/// `Failure` carries the erased original error as `any`. Hooks narrow it
/// with `if err is T` to recover the typed cause:
/// - a typed `throw MyErr{..}` surfaces as `Failure(any=MyErr)`;
/// - a bare `throw "msg"` surfaces as `Failure(any=str)`;
/// - a cooperative cancel surfaces as `Failure(any=CancelError{reason})`;
/// - `interrupt` surfaces as `Failure(any=str="interrupt")`.
///
/// **Variants:**
/// - `Success` — body завершился нормально.
/// - `Failure(err)` — body throw'нул / cancel / interrupt; `err: any`.
/// - `Panic(msg)` — body panic'нул; resource НЕ должен throw в этом
///   случае, но может выполнить emergency cleanup.
///
/// # Examples
///
/// ```nova
/// fn Transaction consume @cleanup(outcome ScopeOutcome) Fail[DbError] -> () {
///     match outcome {
///         Success      => @commit()!!
///         Failure(err) =>
///             if err is CancelError { @rollback()!! }
///             else { @rollback_with_log()!! }
///         Panic(_)     => @rollback_emergency()
///     }
/// }
/// ```
#stable(since = "0.1")
export type ScopeOutcome enum Success | Failure(any) | Panic(str)

// ──────────────────────────────────────────────────────────────────────────
// Record types
// ──────────────────────────────────────────────────────────────────────────

/// Lightweight error record для quick-and-dirty failure cases.
/// Поле `msg` — readonly UTF-8 string, описание ошибки. Для
/// structured runtime errors см. `RuntimeError`.
#stable(since = "0.1")
export type Error {
    ro msg str
}

// Static fn `Error.new(msg)` — codegen special-case (Error — record, не sum).

// ──────────────────────────────────────────────────────────────────────────
// str — lang-item value-record [M-139-f0-lang-item-decl]
// ──────────────────────────────────────────────────────────────────────────

/// UTF-8 string — immutable, value-typed view `{ ptr *u8, len int }`.
///
/// `str` — полноценный Nova value-record. Объявление здесь делает `str`
/// источником правды для:
///   - **privacy** (`priv(type)` поля): `s.ptr` / `s.len` снаружи str-методов
///     недоступны (через публичные методы `@len`, `@byte_at`, `@as_bytes`).
///   - **field layout / sizeof** (16 байт на x64).
///
/// **Field `ptr *u8`** — bare `*u8`: ro-pointee canon (`*T ≡ *ro T`),
/// запись `s.ptr[i] = …` → `E_POINTER_RO_ASSIGN`.
///
/// **ABI-bridge:** C-тип — `nova_str` (`{ const uint8_t* ptr; int64_t len; }`).
/// Codegen не эмитит struct — `str` в RUNTIME_DEFINED_TYPES skip-list.
#stable(since = "0.1")
// priv(type) — методы str живут в другом модуле (runtime.string),
// field-priv сломал бы их. Перенос декларации в runtime.string невозможен
// (bootstrap: prelude первичен).
type str value priv(type) {
    ptr *u8
    len int
}

// ──────────────────────────────────────────────────────────────────────────
// Option[T] methods
// ──────────────────────────────────────────────────────────────────────────
//
// Signature должна matchить runtime trampoline / inline emit
// в codegen. Init копирует `method_routing` в DeclaredFromPrelude —
// behavior-preserving migration.

/// True если Option содержит значение.
#stable(since = "0.1")
fn Option[T] @is_some() -> bool => match @ { Some(_) => true, None => false }

// Option[T].new() declined — codegen не поддерживает generic static
// методы на builtin sum-types (Option/Result). Workaround: use `None`
// directly. [M-91.7-option-new-static]

/// True если Option пустой (None).
#stable(since = "0.1")
fn Option[T] @is_none() -> bool => match @ { Some(_) => false, None => true }

// [M-unwrap-twins-retraction] (2026-07-07): `@unwrap()` /
// `@unwrap_or(default)` / `@unwrap_or_else(f)` ретрактированы — дублировали
// операторы `x!!` / `x ?? v` / `x ?? f()`. Все вызовы мигрированы на
// операторную форму.

/// Применяет `map_fn` к содержимому Some, возвращает Some(map_fn(v)). None пропускает.
/// Param-name `map_fn` (не `f`) — избегаем shadowing user-функций с именем `f`.
#stable(since = "0.1")
fn Option[T] @map[U](map_fn fn(T) -> U) -> Option[U]
  => match @ { Some(v) => Some(map_fn(v)), None => None }

/// `Some(v) -> Ok(v)`, `None -> Err(err)`. Полезно для conversion
/// Option в Result-чейн.
#stable(since = "0.1")
fn Option[T] @ok_or[E](err E) -> Result[T, E]
  => match @ { Some(v) => Ok(v), None => Err(err) }

/// `Some(v) -> Some(v)`, `None -> other`. Возвращает другой Option если
/// текущий пустой (fallback chain).
#stable(since = "0.1")
fn Option[T] @or(other Option[T]) -> Option[T] => match @ { Some(v) => Some(v), None => other }

/// Bind/monadic chain: `Some(v) -> flat_map_fn(v)`, `None -> None`. В отличие
/// от `@map`, `flat_map_fn` сам возвращает `Option[U]` — вложенность
/// `Option[Option[U]]` не образуется.
///
/// Единственный из канонических комбинаторов, невыразимый через `??`/`!!`/
/// `.map`/`match` — bind-цепочка fallible-шагов без ручного снятия вложенности
/// требует отдельного метода. Имя `flat_map` (не `and_then`/`then`) — сиблинг
/// к `map`, без булевого багажа `and`/`or` и без коллизии с `bool::then`.
/// Param-name `flat_map_fn` (не `f`) — избегаем shadowing.
///
/// Fallible-шаг (замыкание возвращает `Result`): канон — явная `.ok()` на
/// месте вызова, `opt.flat_map(|v| do_thing(v).ok())`.
#stable(since = "0.1")
fn Option[T] @flat_map[U](flat_map_fn fn(T) -> Option[U]) -> Option[U]
  => match @ { Some(v) => flat_map_fn(v), None => None }

/// `Some(v) -> Some(v)` если `pred(v)`, иначе `None`. `None` остаётся `None`.
/// `??`/`.map` не отбрасывают `Some` по предикату — единственный способ
/// вернуть `None` из `Some` без явного `match`. Param-name `pred` —
/// паритет с `Vec`/`Iter` `@filter`.
#stable(since = "0.1")
fn Option[T] @filter(pred fn(T) -> bool) -> Option[T]
  => match @ { Some(v) => if pred(v) { Some(v) } else { None }, None => None }

// ──────────────────────────────────────────────────────────────────────────
// Result[T, E] methods
// ──────────────────────────────────────────────────────────────────────────

/// True если Result — Ok variant.
#stable(since = "0.1")
fn Result[T, E] @is_ok() -> bool => match @ { Ok(_) => true, Err(_) => false }

/// True если Result — Err variant.
#stable(since = "0.1")
fn Result[T, E] @is_err() -> bool => match @ { Ok(_) => false, Err(_) => true }

// [M-unwrap-twins-retraction] (2026-07-07): `@unwrap()` /
// `@unwrap_or(default)` / `@unwrap_or_else(f)` ретрактированы —
// дублировали операторы `x!!` / `x ?? v`. Result's `unwrap_or_else(fn(E) -> T)`
// давал доступ к error-значению в fallback — `??` его отбрасывает.
// Все вызовы мигрированы на операторную форму.

/// Применяет `map_fn` к Ok-значению: `Ok(v) -> Ok(map_fn(v))`, `Err(e)` пропускает.
/// Param-name `map_fn` (не `f`) — см. Option.map.
#stable(since = "0.1")
fn Result[T, E] @map[U](map_fn fn(T) -> U) -> Result[U, E]
  => match @ { Ok(v) => Ok(map_fn(v)), Err(e) => Err(e) }

/// Применяет `err_fn` к Err-payload: `Err(e) -> Err(err_fn(e))`, `Ok(v)` пропускает.
/// Param-name `err_fn` (не `f`) — см. Option.map.
#stable(since = "0.1")
fn Result[T, E] @map_err[F](err_fn fn(E) -> F) -> Result[T, F]
  => match @ { Ok(v) => Ok(v), Err(e) => Err(err_fn(e)) }

/// Bind/monadic chain: `Ok(v) -> flat_map_fn(v)`, `Err(e) -> Err(e)`. В
/// отличие от `@map`, `flat_map_fn` сам возвращает `Result[U, E]` —
/// вложенность `Result[Result[U,E], E]` не образуется.
/// Зеркало `Option.flat_map` — та же мотивация.
/// Param-name `flat_map_fn` — см. `Option.flat_map`.
#stable(since = "0.1")
fn Result[T, E] @flat_map[U](flat_map_fn fn(T) -> Result[U, E]) -> Result[U, E]
  => match @ { Ok(v) => flat_map_fn(v), Err(e) => Err(e) }

/// `Ok(v) -> Some(v)`, `Err(_) -> None`. Discards error.
#stable(since = "0.1")
fn Result[T, E] @ok() -> Option[T] => match @ { Ok(v) => Some(v), Err(_) => None }

/// `Err(e) -> Some(e)`, `Ok(_) -> None`. Discards Ok-value.
#stable(since = "0.1")
fn Result[T, E] @err() -> Option[E] => match @ { Ok(_) => None, Err(e) => Some(e) }

/// Fail-fast коллектор списка результатов. Первая `Err` обрывает и
/// возвращается (short-circuit); иначе `Ok` со ВСЕМИ значениями в порядке.
///
/// ```nova
/// assert(sequence([Ok(1), Ok(2), Ok(3)]) == Ok([1, 2, 3]))
/// assert(sequence([Ok(1), Err("x"), Ok(3)]) == Err("x"))
/// ```
#stable(since = "0.1")
export fn[T, E] sequence(items []Result[T, E]) -> Result[[]T, E] {
    mut out []T = []
    for r in items {
        match r {
            Ok(v)  => out.push(v),
            Err(e) => return Err(e),
        }
    }
    Ok(out)
}

/// Разделяет список результатов на успехи и ошибки — ОБЕ стороны
/// сохранены (в отличие от `sequence`, который обрывается на первой `Err`).
///
/// ```nova
/// ro (oks, errs) = partition([Ok(1), Err("a"), Ok(2), Err("b")])
/// assert(oks == [1, 2])
/// assert(errs == ["a", "b"])
/// ```
#stable(since = "0.1")
export fn[T, E] partition(items []Result[T, E]) -> ([]T, []E) {
    mut oks  []T = []
    mut errs []E = []
    for r in items {
        match r {
            Ok(v)  => oks.push(v),
            Err(e) => errs.push(e),
        }
    }
    (oks, errs)
}

// `Option[T] @debug` / `Result[T,E] @debug` moved OUT of `core` into
// `std/prelude/protocols.nv` — они ссылаются на `Debug`/`Write`, объявленные
// в protocols. Под partial `#prelude(core, runtime)` (без protocols) они
// давали E_IMPL_UNKNOWN_PROTOCOL.
