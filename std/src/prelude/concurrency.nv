// std/prelude/concurrency.nv — file-based source of truth для prelude
// concurrency-типа `CancelToken`. Формальная декларация: тип объявлен здесь,
// методы — extern "nova" декларации в prelude-файле + codegen name-keyed
// special-case dispatch.
//
// До переноса `CancelToken` жил ТОЛЬКО именем в bypass-HashSet: чекер
// пропускал `CancelToken.new()` нерезолвленным (нет TypeDecl → static-ctor
// армы не срабатывали), и legacy-инференс угадывал ПРОИЗВОЛЬНЫЙ чужой
// `.new()` по arity — наблюдались `Nova_WriteBuffer*` / `Nova_StringBuilder*`
// в зависимости от compile-unit контекста. Неверный C-тип binding'а протекал
// в spawn-capture ctx struct → CC-FAIL «no member named 'cancel' ...».
// Формальные декларации дают чекеру TypeDecl + method-сигнатуры → штатная
// материализация возврата конструктора в канал, legacy-гадание становится
// недостижимым.
//
// Архитектурные правила:
//   - **Один explicit import**: `std.prelude.core.{Option}` — нужен для
//     `reason() -> Option[str]` (образец: prelude/collections.nv).
//     Auto-import `std.prelude` отключён внутри `std.prelude.*`
//     (cycle protection).
//
// **Bootstrap status:** dispatch остаётся в codegen special-cases (receiver
// `NovaCancelToken*`; C-runtime `nova_cancel_token_*` в nova_rt/fibers.h) —
// эти декларации синхронизируют type-checker signatures с фактическим API.
// Mangled-имена ExternalRegistry для этих деклараций НЕ эмитятся:
// special-case-диспатч перехватывает раньше, и instance-, и static-форму.
// Лоуэринг типа — хардкод `CancelToken → NovaCancelToken*` — остаётся
// C-маппингом (не newtype-путь: match-арм имени стоит раньше).
//
// Generic-форма `CancelToken[T]` (typed reason) осталась codegen-side —
// здесь объявлена НЕ-generic базовая форма; в корпусе живых
// `CancelToken[T]`-аннотаций нет, typed-reason проходит через
// `@cancel(reason any)`.

module prelude.concurrency

import std.prelude.core.{Option}

// ─── CancelToken ─────────────────────────────────────────────────

/// Caller-owned cancellation handle.
///
/// Cooperative cancellation: `supervised(cancel: tok)` binds execution
/// scopes to the token; `tok.cancel()` delivers cancellation to all bound
/// scopes (children are aborted at the nearest yield point).
///
/// The methods work on a readonly receiver (`ro tok = CancelToken.new()` —
/// the canonical pattern): the state is an atomic runtime handle (interior
/// mutability, akin to Go `context.CancelFunc`).
///
/// `#share` (D415 §2): audited vouch — the handle is real synchronization
/// (atomic flag + wake in the C runtime), safe for alias/capture across
/// the `spawn` boundary (same mechanism as `Mutex`).
#stable(since = "0.1")
#share
export type CancelToken(*())

/// A new (not-cancelled) token.
#realtime
#stable(since = "0.1")
export extern "nova" fn CancelToken.new() -> Self

/// Cancel with the default reason "cancelled" (T=str).
///
/// Idempotent: a repeated `cancel()` is a no-op (the first reason sticks).
#wakes
#stable(since = "0.1")
export extern "nova" fn CancelToken @cancel()

/// Cancel with a reason (Plan 49 Ф.1/Ф.6 — typed reason).
///
/// Boxing the reason by the actual argument type is done by codegen
/// (str → nova_cancel_box_str; pointer — as-is; value — box_copy_raw).
#wakes
#stable(since = "0.1")
export extern "nova" fn CancelToken @cancel(reason any)

/// Whether the token has been cancelled.
#realtime
#stable(since = "0.1")
export extern "nova" fn CancelToken @is_cancelled() -> bool

/// Cancellation reason: `Some(reason)` after `cancel(reason)`, `None` otherwise.
///
/// Default form is T=str; for tracked `CancelToken[T]` codegen emits a
/// per-T un-box (Plan 49 Ф.6, `cancel_token_t_map`).
#realtime
#stable(since = "0.1")
export extern "nova" fn CancelToken @reason() -> Option[str]

/// Composition (Plan 49 P3): a new token that is cancelled when ANY of
/// the sources is cancelled. Same-T in V1.
///
/// NB: the return is spelled `-> CancelToken` (not `-> Self`) — the D132
/// "-> Self but all paths return @" check cannot distinguish bodyless
/// extern declarations and falsely demands a fluent `-> @` (merge returns a NEW token).
#realtime
#stable(since = "0.1")
export extern "nova" fn CancelToken @merge(other CancelToken) -> CancelToken

/// Directed cascade: `child.cancelled_by(parent)` — `parent.cancel()`
/// also cancels child; `child.cancel()` does NOT touch parent.
#realtime
#stable(since = "0.1")
export extern "nova" fn CancelToken @cancelled_by(parent CancelToken) -> ()
