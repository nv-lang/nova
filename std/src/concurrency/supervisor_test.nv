// supervisor_test.nv — тесты встроенных политик std.concurrency.supervisor
// (Plan 173.2). Семантические матрицы — в nova_tests/err173_2/.

module concurrency.supervisor_test

import std.concurrency.supervisor as sup

// Plan 175.2 Ф.2-v4 (П6): `(5).to_millis()` used to resolve without an
// explicit import — an accidental side effect of `Time` (and its
// `Duration`/`Timestamp`/`Monotonic` import) living in `std.prelude.effects`
// (auto-imported into every CU). Now that `Time` moved to
// `std.time.duration` (this file doesn't otherwise transitively pull that
// module in), the `to_millis()` blanket needs its own explicit import.
import std.time.duration

test "stop(): падение ребёнка не эскалируется, siblings доживают" {
    ro n = 5
    mut done = AtomicInt.new(0)
    mut after_scope = 0
    with Supervisor = sup.stop() {
        supervised {
            for i in 0..n {
                ro tag = i
                spawn {
                    if tag == 1 { throw 13 }
                    5.to_millis().sleep()
                    done.fetch_add(1)
                }
            }
        }
        after_scope = 1
    }
    assert(after_scope == 1)
    assert(done.load() == n - 1)
}

test "escalate(): падение эскалируется наружу (паритет с дефолтом)" {
    // Plan 238 Ф.4 (D441 §3): `with Fail[T]` handler исполняется в файбере
    // падающей операции — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut caught = AtomicBool.new(false)
    ro _ = with Fail[int] = |e| {
        caught.store(true)
        0
    } {
        with Supervisor = sup.escalate() {
            supervised {
                spawn { throw 21 }
            }
        }
        99
    }
    assert(caught.load())
}
