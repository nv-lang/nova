// stdlib/concurrency/cancellation.nv — `race2` над `supervised(cancel:)` +
// `CancelToken`.
//
// API (этот файл):
//   race2[T](a fn() -> T, b fn() -> T) -> T
//     — два fiber'а соревнуются, возвращается первый завершившийся;
//       second отменяется через CancelToken. Аналог Go `select` для
//       двух операций. (`race[T](competitors []fn() -> T)` — V2,
//       требует `[]fn()->T` поддержку в generic-context.)
//
// `within[T](timeout_ms int, body fn() -> T) -> Option[T]` и
// `with_timeout[T](timeout_ms int, body fn() -> T) -> T` РЕТРАКТИРОВАНЫ.
// Субсумированы `supervised(timeout: Duration)`/`supervised(deadline:
// Monotonic)` — структурная конструкция, а не fn-обёртка над чистым
// `fn()->T` (эффекты тела текут наружу, не erased в closure-сигнатуру).
// Миграция call-site:
//   было:  match within(1000, || body()) { Some(v) => v, None => fallback }
//   стало: with Fail[TimeoutError] = |_| fallback {
//              supervised(timeout: 1.second()) { body() }
//          }
// (или дать `TimeoutError` пробросить наружу, если fallback не нужен —
// `with_timeout`'а throw-семантика теперь ЭТО и есть, by default).
// `race2[T]` НЕ субсумирован — остаётся (нет structured-scope аналога
// "первый из двух конкурентов").
//
// Сравнение с индустрией:
//   - Go: `context.WithTimeout(parent, dur)` — context везде явный
//     pollution; у нас `supervised(timeout:)` берёт срок прямо в scope.
//   - Rust: `tokio::time::timeout(dur, fut)` — паритет; требует Tokio
//     runtime, у нас встроенно в `supervised`.
//   - TS: `Promise.race([...])` — нет cancellation losers (Promises
//     остаются «висеть»); у нас losers отменяются через scope.

module concurrency.cancellation

// NB: std.testing.handlers НЕ импортируется здесь — handlers.nv
// `mut_clock(start)` обращается к `d.nanos` где d приходит как
// `nova_int ms` из runtime Time effect signature (schema mismatch
// между Duration в Nova-side и int ms в runtime).
// [M-time-effect-schema-mismatch-sleep] — следующая итерация.

// ──────────────────────────────────────────────────────────────────────────
// race2[T] — два fiber'а соревнуются, first-result-wins
// ──────────────────────────────────────────────────────────────────────────

// Запускает `a` и `b` параллельно, возвращает результат того кто
// завершился первым. Проигравший отменяется через CancelToken
// (cooperative — обрывается на ближайшем yield-point'е).
//
// Если ОБА fiber'а throw'нули USER-ошибку — пробрасывается first-USER
// (USER-precedence: real-error wins над CANCEL).
//
// V2: race[T](competitors []fn() -> T) — требует `[]fn() -> T` в
// generic-context (array-of-closures). Сейчас фиксированно 2.
/// Race two competitors — return result от первого завершившегося. Loser отменяется.
///
/// Если оба user-throw'ят — first-USER пробрасывается (USER-precedence).
/// Если оба завершились без result'а (rare) — throws "race2: both failed".
///
/// V2: `race[T](competitors []fn() -> T)` — отложено до array-of-closures
/// support в generic context.
#stable(since = "0.1")
export fn race2[T](a fn() -> T, b fn() -> T) -> T {
    ro tok = CancelToken.new()
    // Победитель — через канал, НЕ mut-захват. Старый код
    // (`winner = Some(r)` из двух sibling-fiber'ов под
    // is_cancelled()-проверкой) был настоящим TOCTOU-race: оба могли
    // пройти проверку и писать одновременно. Канал cap 2 (оба могут
    // успеть try_send без блокировки); FIFO-порядок канала = first-wins.
    ro (tx, rx) = Channel.new(2)

    supervised(cancel: tok) {
        spawn {
            if !tok.is_cancelled() {
                ro r = a()
                if !tok.is_cancelled() {
                    tx.try_send(r)
                    tok.cancel("a wins")
                }
            }
        }
        spawn {
            if !tok.is_cancelled() {
                ro r = b()
                if !tok.is_cancelled() {
                    tx.try_send(r)
                    tok.cancel("b wins")
                }
            }
        }
    }

    tx.close()
    match rx.try_recv() {
        Some(v) => v
        None    => throw "race2: both competitors failed without producing a result"
    }
}
