// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Plan 174 (D349) — областной срок `supervised(deadline:/timeout:)`.
// По истечении срока: кооперативная отмена области (тот же путь, что
// `cancel:`) → cleanup'ы добегают → наружу типизированный `TimeoutError`
// (ловится `with Fail[TimeoutError]` / `is TimeoutError`).
//
// Проверяется:
//   1. тело укладывается в срок → результат как обычно (таймер погашен);
//   2. `timeout:` (относит.) истёк → TimeoutError, ловится `is TimeoutError`;
//   3. отмена прерывает `Time.sleep` РАНО (замер времени << полный сон);
//   4. `deadline:` (абсолютный Monotonic) — та же семантика;
//   5. вложенные сроки — внутренний НЕ может продлить внешний;
//   6. `deadline:`+`cancel:` вместе — раннее из двух;
//   7. нулевой/отрицательный срок → мгновенный TimeoutError (D349).
//   8. [M-178-server-graceful-deadline] repro (Plan 173 Ф.3, found 2026-07-12/13):
//      a SPAWNED child parked on `Time.sleep` did not actually unwind on
//      scope cancellation — `_nova_sleep_via_libuv`/`_nova_sleep_via_driver`
//      woke the fiber early (timer cut short by `nova_scope_deliver_cancel`)
//      but never re-checked `cancel_requested` after the park returned, so
//      the sleep "succeeded" and the child ran its remaining body to
//      completion instead of throwing/unwinding. The scope-level
//      `TimeoutError` still fired on time (that gate is independent, in
//      `nova_supervised_run_impl`), which is why tests 2/3/5-7 above never
//      caught it — they only assert on the OUTER elapsed time / catch, not
//      on whether the child fiber itself was actually cut off. Fixed in
//      `fibers.h` (re-check `cancel_requested` + shield-aware
//      `nova_throw_cancel_reason` after every park return AND at both
//      pre-arm early-exit fast-paths — mirrors `nova_fiber_yield` /
//      channels.h / net.c, which already did this correctly).

module concurrency.supervised_deadline_test

import std.time.duration

// Хелпер для проверки `is TimeoutError` (D54/174.3 narrowing на `any`):
// принимает `any`, значение TimeoutError бокс'ится, внутри — is-дискриминация.
fn is_timeout_error(e any) -> bool => e is TimeoutError

// 1. Тело укладывается в срок → нормальный проход, TimeoutError НЕ летит.

test "within-budget: тело успевает — срок не срабатывает" {
    mut done = false
    supervised(timeout: 30.to_seconds()) {
        spawn { 5.to_millis().sleep() }
    }
    done = true
    assert(done)
}

// 2. + 3. timeout истёк → TimeoutError, ловится `is TimeoutError`,
//    и sleep(5000) прерван РАНО (elapsed << 5000).

test "timeout fires: TimeoutError caught, sleep interrupted early" {
    // Typed catch by `Fail[TimeoutError]` proves the escaping error is a
    // TimeoutError (dispatch is by type-id — a non-TimeoutError would not
    // route here). The `is TimeoutError` narrowing form is exercised in the
    // `outcome`-based test below.
    // Plan 238 Ф.4 (D441 §3): `with Fail[TimeoutError]` handler исполняется
    // в файбере падающей операции — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut caught_typed = AtomicBool.new(false)
    ro t0 = Timestamp.now().unix_millis()
    ro r = with Fail[TimeoutError] = |e| {
        // `is TimeoutError` narrowing (e boxed to `any` через хелпер).
        caught_typed.store(is_timeout_error(e))
        0
    } {
        supervised(timeout: 100.to_millis()) {
            spawn { 5000.to_millis().sleep() }
        }
        99
    }
    ro elapsed = Timestamp.now().unix_millis() - t0
    // Handler сработал на TimeoutError → r = 0 (не 99).
    assert(r == 0)
    assert(caught_typed.load())
    // Ключевой замер: sleep(5000) прерван отменой около срока (100ms),
    // НЕ доспал до конца. Порог щедрый (2000ms) под медленный CI.
    assert(elapsed < 2000)
}

// 4. Абсолютная форма `deadline: Monotonic`.

test "deadline (absolute Monotonic) fires TimeoutError" {
    // Plan 238 Ф.4 (D441 §3): AtomicBool вместо mut-флага.
    mut caught = AtomicBool.new(false)
    ro r = with Fail[TimeoutError] = |_e| {
        caught.store(true)
        0
    } {
        supervised(deadline: Monotonic.now() + 100.to_millis()) {
            spawn { 5000.to_millis().sleep() }
        }
        7
    }
    assert(r == 0)
    assert(caught.load())
}

// 5. Вложенные сроки: внутренний срок ДЛИННЕЕ внешнего — не может продлить.
//    Внешний (100ms) срабатывает, sleep(5000) во вложенной области прерван рано.

test "nested: inner deadline cannot extend outer" {
    // Plan 238 Ф.4 (D441 §3): AtomicBool вместо mut-флага.
    mut caught = AtomicBool.new(false)
    ro t0 = Timestamp.now().unix_millis()
    ro r = with Fail[TimeoutError] = |_e| {
        caught.store(true)
        0
    } {
        supervised(timeout: 100.to_millis()) {
            supervised(timeout: 30.to_seconds()) {
                spawn { 5000.to_millis().sleep() }
            }
        }
        1
    }
    ro elapsed = Timestamp.now().unix_millis() - t0
    assert(r == 0)
    assert(caught.load())
    assert(elapsed < 2000)
}

// 6. `deadline:` + `cancel:` вместе — раннее из двух.
//    6a. cancel раньше срока → штатная отмена, TimeoutError НЕ летит.

test "deadline+cancel: cancel earlier — no TimeoutError" {
    ro tok = CancelToken.new()
    // Plan 238 Ф.4 (D441 §3): AtomicBool вместо mut-флага.
    mut timed_out = AtomicBool.new(false)
    ro r = with Fail[TimeoutError] = |_e| {
        timed_out.store(true)
        0
    } {
        supervised(cancel: tok, timeout: 30.to_seconds()) {
            spawn { 20.to_millis().sleep(); tok.cancel() }
            spawn { 5000.to_millis().sleep() }
        }
        5
    }
    // Отмена сделала работу до срока → нет TimeoutError → r = 5.
    assert(!timed_out.load())
    assert(r == 5)
}

//    6b. срок раньше cancel → TimeoutError.

test "deadline+cancel: deadline earlier — TimeoutError" {
    ro tok = CancelToken.new()
    // Plan 238 Ф.4 (D441 §3): AtomicBool вместо mut-флага.
    mut timed_out = AtomicBool.new(false)
    ro r = with Fail[TimeoutError] = |_e| {
        timed_out.store(true)
        0
    } {
        supervised(cancel: tok, timeout: 100.to_millis()) {
            spawn { 5000.to_millis().sleep(); tok.cancel() }
        }
        5
    }
    assert(timed_out.load())
    assert(r == 0)
}

// 7. Нулевой срок → мгновенный TimeoutError (D349: срок в прошлом/сейчас
//    = немедленное истечение; тело-дети отменяются на первом suspend).

test "zero timeout: immediate TimeoutError" {
    // Plan 238 Ф.4 (D441 §3): AtomicBool вместо mut-флага.
    mut caught = AtomicBool.new(false)
    ro r = with Fail[TimeoutError] = |_e| {
        caught.store(true)
        0
    } {
        supervised(timeout: 0.to_millis()) {
            spawn { 5000.to_millis().sleep() }
        }
        3
    }
    assert(caught.load())
    assert(r == 0)
}

// 8. [M-178-server-graceful-deadline]: a cancelled child must actually
//    unwind at its `Time.sleep`, not run its remaining body to completion.
//    Repro: the child sends a marker on a channel AFTER `Time.sleep`
//    returns. If cancellation is genuine, the child's sleep throws and the
//    marker is NEVER sent — `try_recv()` stays `None` even well past the
//    child's full (uncancelled) sleep duration. Before the fix, the child
//    silently "completed" its sleep on the cancel-wake and went on to send
//    the marker — the outer `supervised` still returned/threw on time
//    (independent gate), masking the leak unless something specifically
//    checked what the child did AFTER the sleep call.

test "deadline cancels a spawned child's in-flight sleep (no leaked marker)" {
    ro (tx, rx) = Channel.new(1)
    // Plan 238 Ф.4 (D441 §3): AtomicBool вместо mut-флага.
    mut caught = AtomicBool.new(false)
    ro r = with Fail[TimeoutError] = |_e| {
        caught.store(true)
        0
    } {
        supervised(timeout: 100.to_millis()) {
            spawn {
                3000.to_millis().sleep()
                // Reachable only if the child was NOT actually cancelled.
                tx.try_send(true)
            }
        }
        1
    }
    assert(r == 0)
    assert(caught.load())
    // Grace window past the child's full (uncancelled) sleep duration.
    3200.to_millis().sleep()
    ro leaked = rx.try_recv()
    assert(leaked == None)
}
