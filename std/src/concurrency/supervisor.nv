// stdlib/supervisor.nv — встроенные политики Supervisor-эффекта (Plan 173.2).
//
// `Supervisor` / `Decision` объявлены в std/prelude/effects.nv (авто-доступны
// без импорта). Стратегии — обычные handler-значения (`Effect[Supervisor]`),
// подменяются как Time/Fail:
//
//   import std.concurrency.supervisor as sup
//
//   with Supervisor = sup.stop() {
//       supervised {
//           for u in urls { spawn { fetch(u) } }   // упавший НЕ отменяет siblings
//       }
//   }
//
// Пользовательская политика — просто handler-литерал:
//
//   with Supervisor = effect Supervisor {
//       on_child_fail(idx int, err any) -> Decision =>
//           if err is TransientError { Decision.Stop } else { Decision.Escalate }
//   } { ... }
//
// Словарь решений `Escalate` / `Stop` — ПОЛНЫЙ (Restart-семейство
// ретрактировано D416 2026-07-10: рестарт — акторная идиома, не структурная
// конкуренция; повтор попытки — внутри тела ребёнка, std/concurrency/retry).

module concurrency.supervisor

/// The "escalate everything" policy — equivalent to the default (no supervisor):
/// the error of the first failed child becomes primary, siblings cooperatively
/// get cancelled, the scope rethrows outward. Useful as an explicit baseline
/// (or an outer layer, on top of which a different policy is set locally).
#stable(since = "0.1")
export fn escalate() -> Effect[Supervisor] {
    effect Supervisor {
        on_child_fail(idx int, err any) -> Decision => Decision.Escalate
    }
}

/// The "drop the failed" policy — a child's failure is NOT escalated and does NOT
/// cancel siblings: the scope keeps running as if the failed child
/// just finished without a result (its error stays retained per-slot,
/// 173.0 — not silently lost). Analog of an Erlang `temporary` child.
#stable(since = "0.1")
export fn stop() -> Effect[Supervisor] {
    effect Supervisor {
        on_child_fail(idx int, err any) -> Decision => Decision.Stop
    }
}
