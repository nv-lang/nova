// stdlib/rate_limiter.nv — Token bucket rate limiter.
//
// AI-first флагман: использует Time effect → детерминированные тесты
// через `with Time = th.fixed_ms(...)`.
//
// Token bucket algorithm:
//   - Bucket capacity = max burst size
//   - refill_rate tokens per second
//   - Каждый вызов acquire() забирает 1 token; если их нет — false.
//
// API:
//   TokenBucket.new(capacity int, refill_per_sec f64) -> TokenBucket
//   bucket.acquire() Time -> bool
//   bucket.acquire_n(n int) Time -> bool

module concurrency.rate_limiter

import std.time.duration

/// Token bucket rate limiter. `capacity` = max burst, `refill_per_sec` = sustained rate.
///
/// Uses the Time effect → deterministic in tests under `th.fixed_ms(...)`.
#stable(since = "0.1")
// [M-rate-limiter-monotonic] ЗАКРЫТ (Plan 175 Ф.3, 2026-07-11): refill-тайминг
// переведён на `Monotonic` (D124, std/time/duration.nv) — immune к
// NTP wall-clock скачкам, в отличие от прежнего `Time.now()`.
// Переход был gated на `now_monotonic`-слот в рантайм-vtable
// `NovaVtable_Time` (nova_rt/effects.h) — слот появился в Plan 175 Ф.3(a)
// (закрыл `[M-monotonic-mock-support]`), `Monotonic.now()` теперь мокабелен
// через `th.fixed_ms`/`th.mut_clock` когерентно с wall-clock. Ручной
// `.max(0)`-clamp на регресс больше не нужен — `Monotonic.@elapsed_since`
// УЖЕ saturate-to-zero на регрессе (D318), контракт защиты теперь на
// уровне типа, а не ad-hoc в этом модуле.
export type TokenBucket {
    ro capacity i64
    ro refill_per_sec f64
    mut tokens f64            // internal: текущее число tokens (может быть дробное)
    mut last_refill Monotonic // internal: последний refill момент (Monotonic.now())
}

/// Init TokenBucket. Starts with full `capacity` tokens.
///
/// # Examples
/// ```nova
/// let mut bucket = TokenBucket.new(5, 1.0)  // 5 burst, 1 token/sec sustained
/// assert(bucket.acquire())
/// ```
#stable(since = "0.1")
export fn TokenBucket.new(capacity i64, refill_per_sec f64) Time -> Self =>
    {
        capacity,
        refill_per_sec,
        tokens: capacity as f64,
        last_refill: Monotonic.now(),
    }

// Refill bucket на основе прошедшего времени.
//
// `Monotonic.@elapsed_since` saturate-to-zero на регрессе (D318): кажущийся
// регресс часов назад просто ставит refill на паузу до момента, когда часы
// снова догонят `last_refill` — не приводит к потере/порче tokens. Скачок
// часов ВПЕРЁД остаётся ограниченным существующим capacity-cap ниже
// (полное ведро, не переполнение).
fn TokenBucket mut @refill() Time -> () {
    ro now = Monotonic.now()
    ro elapsed_secs = now.elapsed_since(@last_refill).seconds_f64()
    ro to_add = elapsed_secs * @refill_per_sec
    @tokens += to_add
    if @tokens > (@capacity as f64) {
        @tokens = @capacity as f64
    }
    @last_refill = now
}

/// Try acquire 1 token. `true` if it succeeded, `false` if the bucket is empty.
#stable(since = "0.1")
export fn TokenBucket mut @acquire() Time -> bool =>
    @acquire_n(1)

/// Try acquire `n` tokens atomically (all-or-nothing).
#stable(since = "0.1")
export fn TokenBucket mut @acquire_n(n int) Time -> bool
    requires n >= 0
{
    @refill()
    if @tokens >= (n as f64) {
        @tokens -= n as f64
        true
    } else {
        false
    }
}

/// Current available tokens (refreshed under the current Time).
#stable(since = "0.1")
export fn TokenBucket mut @available() Time -> f64 {
    @refill()
    @tokens
}

