// SPDX-License-Identifier: MIT OR Apache-2.0
// std/net/mock.nv — in-memory, deterministic `Net` handler.
//
// Same module as tcp.nv/udp.nv/addr.nv, so it reuses the package-private
// factories and Result helpers. Touches no real socket: constructors return stub
// handles, read/recv fill the caller buffer with fixed content, addresses are
// filled via the pure address FFI (no I/O). Deterministic net tests without a
// live substrate.

module std.net

/// In-memory `Net` handler for unit-testing code that depends on `Net`.
///
/// - bind / connect / accept succeed with stub handles.
/// - write / send_to report the input byte count.
/// - read / recv_from fill the caller buffer with `"mock-reply"` / empty.
/// - lookup returns a single loopback address; getters return fixed stubs.
///
/// ```nova
/// test "write echo without network" {
///     with Net = mock_net() {
///         mut s = TcpStream.connect(SocketAddr.loopback(0))!!
///         assert(s.write("hi".bytes())!! == 2)
///         s.close()
///     }
/// }
/// ```
#stable(since = "0.1")
export fn mock_net() -> Effect[Net] => effect Net {
    // ── TCP ──────────────────────────────────────────────────────────────────
    tcp_bind(_addr SocketAddr) -> Result[TcpListener, NetError] => listener_ok(1 as *())
    accept(_listener TcpListener) -> Result[TcpStream, NetError] => stream_ok(2 as *())
    connect(_addr SocketAddr) -> Result[TcpStream, NetError] => stream_ok(3 as *())
    read(_stream TcpStream, buf mut []u8) -> Result[int, NetError] => int_ok(mock_fill(buf, "mock-reply"))
    write(_stream TcpStream, data []u8) -> Result[int, NetError] => int_ok(data.len())
    shutdown(_stream TcpStream) -> Result[(), NetError] => unit_ok()
    close_stream(_stream TcpStream) -> () {}
    close_listener(_listener TcpListener) -> () {}
    mark_split(_stream TcpStream) -> () {}
    listener_local_port(_listener TcpListener) -> int => 4242
    listener_local_addr(_listener TcpListener, out mut []u8) -> () {
        unsafe { net_addr_loopback_into(4242, out.ptr()) }
    }
    stream_local_port(_stream TcpStream) -> int => 5050
    stream_peer_port(_stream TcpStream) -> int => 6060
    stream_local_addr(_stream TcpStream, out mut []u8) -> () {
        unsafe { net_addr_loopback_into(5050, out.ptr()) }
    }
    stream_peer_addr(_stream TcpStream, out mut []u8) -> () {
        unsafe { net_addr_loopback_into(6060, out.ptr()) }
    }
    set_nodelay(_stream TcpStream, _on bool) -> () {}
    set_keepalive(_stream TcpStream, _on bool) -> () {}
    set_reuse_address(_listener TcpListener, _on bool) -> () {}

    // ── UDP ──────────────────────────────────────────────────────────────────
    udp_bind(_addr SocketAddr) -> Result[UdpSocket, NetError] => socket_ok(10 as *())
    send_to(_sock UdpSocket, data []u8, _addr SocketAddr) -> Result[int, NetError] => int_ok(data.len())
    recv_from(_sock UdpSocket, buf mut []u8, sender mut []u8) -> Result[int, NetError] {
        unsafe { net_addr_loopback_into(0, sender.ptr()) }
        ro _ = buf
        int_ok(0)
    }
    close_socket(_sock UdpSocket) -> () {}
    socket_local_port(_sock UdpSocket) -> int => 7070
    socket_local_addr(_sock UdpSocket, out mut []u8) -> () {
        unsafe { net_addr_loopback_into(7070, out.ptr()) }
    }

    // ── DNS ──────────────────────────────────────────────────────────────────
    lookup(_host []u8, _port int) -> Result[[]SocketAddr, NetError] => mock_lookup()
}

// A single-element loopback "array" (a nova_alloc'd POD) for the mock DNS stub;
// `build_addrs` copies the one image out and the owned []SocketAddr returns
// straight through the vtable (dns.nv).
fn mock_lookup() -> Result[[]SocketAddr, NetError] {
    // `net_addr_loopback` returns `*()` — inferred `unsafe fn`, so the call
    // requires the explicit wrap (mirrors the `net_addr_loopback_into` calls
    // above in this same file).
    ro base = unsafe { net_addr_loopback(0) }
    lookup_ok(build_addrs(base as int, 1))
}

// Copy up to buf.len() bytes of `data` into `buf`; returns the count copied.
fn mock_fill(mut buf []u8, data []u8) -> int {
    ro n = if data.len() < buf.len() { data.len() } else { buf.len() }
    for i in 0..n {
        buf[i] = data[i]
    }
    n
}
