// SPDX-License-Identifier: MIT OR Apache-2.0
// std/net/tcp.nv — TCP value types + the unified real_net() handler
// (TCP + UDP + DNS). Byte surface throughout.
//
// Layering:
//   ffi.nv     — private C FFI (extern "C", opaque `*()` handles, no export)
//   effect.nv  — the single `Net` effect (byte-surface ops)
//   tcp.nv     — TCP types + public methods + real_net() handler (this file)
//   udp.nv     — UDP type + public methods
//   dns.nv     — resolve()
//   mock.nv    — mock_net() handler
//
// Handles (`TcpListener`/`TcpStream`/halves) are `consume value` records over an
// opaque `*()` C handle; `@close()` consumes, so use-after-close is a COMPILE
// error. Read/write are full-duplex on one handle (independent C-side
// park slots), so a "split" is just handing the same handle to two half-values
// with a refcount close — no duplicate C read/write API.

module std.net

import std.io.{IoError}

// ─── Value-record handle types ────────────────────────────────────────────────

/// Async TCP listener (server socket). `bind`/`accept`/`close` carry `Net`
/// (accept parks the fiber). `close()` consumes.
#stable(since = "0.1")
export type TcpListener consume value { priv handle *() }

/// Connected async TCP stream. `connect`/`read`/`write`/`close` carry `Net`.
/// `close()` consumes (use-after-close is a compile error).
///
/// Plan 201 (D188 amendment): `rc` — a shared refcount of owners:
/// `@share()` copies carry THE SAME `AtomicInt` cell; `@close`/`@cleanup` =
/// `fetch_sub`, the real extern socket close runs ONLY in the LAST owner
/// (transition to 0). The refcount lives entirely in nv (convention §3) — zero
/// new C.
///
/// Plan 248 (wave 3, D447): `AtomicInt` moved to a value-inside, `#no_copy`
/// representation (no heap allocation, no pointer indirection PER ATOMIC) —
/// copying an `AtomicInt` value now gives each copy its OWN independent
/// counter, which is the opposite of what a shared refcount needs. `rc` is
/// therefore a `*mut AtomicInt` — a pointer to ONE counter cell that ALL
/// `share()` copies of a stream alias. The cell is heap-escape-promoted from
/// a local in `TcpStream.from_raw` (see below); `share_copy` only ever
/// copies the pointer itself (cheap, and correctly aliases the same cell —
/// pointers are ordinary Copy values, `#no_copy` does not apply to them).
#stable(since = "0.1")
export type TcpStream consume value { priv handle *(), priv rc *mut AtomicInt }

/// Read half of a split `TcpStream`. Shares the connection with its
/// sibling `TcpWriteHalf`; the two may run in separate fibers (independent
/// C-side park slots). The socket closes only after BOTH halves close.
#stable(since = "0.1")
export type TcpReadHalf consume value { priv handle *() }

/// Write half of a split `TcpStream`. See `[TcpReadHalf]`.
#stable(since = "0.1")
export type TcpWriteHalf consume value { priv handle *() }

// ─── Package-private factories / helpers ──────────────────────────────────────

fn TcpListener.from_raw(h *()) -> TcpListener => { handle: h }
// Свежий стрим = единственный владелец (rc=1). NB: эфемерные
// `from_raw(@handle)`-обёртки в half-методах ниже тоже аллоцируют rc —
// мелкая GC-аллокация на вызов (перф-заметка; половины хранят
// голый handle, их close идёт мимо nv-rc через C-side split-refcount).
fn TcpStream.from_raw(h *()) -> TcpStream {
    // Plan 248 (wave 3): heap-escape-promoted counter cell (D216 §4 escape
    // analysis) — `&counter` outlives this frame, valid for every share()
    // copy that later aliases the same pointer.
    mut counter = AtomicInt.new(1)
    TcpStream { handle: h, rc: &counter }
}
// Share-копия — тот же handle И ТОТ ЖЕ rc-указатель (alias владения).
fn share_copy(h *(), rc *mut AtomicInt) -> TcpStream => { handle: h, rc }

fn TcpReadHalf.from_raw(h *()) -> TcpReadHalf => { handle: h }

fn TcpWriteHalf.from_raw(h *()) -> TcpWriteHalf => { handle: h }

// Null-handle test for a cold-path constructor return.
fn is_null(p *()) -> bool => (0 as *()) == p

// Result constructors as regular (non-handler) fns so the checker annotates the
// Path-call return type (mirrors the old net.c pattern — variant construction
// must stay out of an effect-handler body).
fn listener_ok(h *()) -> Result[TcpListener, NetError] => Ok(TcpListener.from_raw(h))

fn stream_ok(h *()) -> Result[TcpStream, NetError] => Ok(TcpStream.from_raw(h))

fn err_listener(code int) -> Result[TcpListener, NetError] => Err(NetError.from_code(code))

fn err_stream(code int) -> Result[TcpStream, NetError] => Err(NetError.from_code(code))

fn int_ok(n int) -> Result[int, NetError] => Ok(n)

fn int_err(code int) -> Result[int, NetError] => Err(NetError.from_code(code))

fn unit_ok() -> Result[(), NetError] => Ok(())

fn unit_err(code int) -> Result[(), NetError] => Err(NetError.from_code(code))

// Tuple-return helper (codegen tuple inference in handler bodies).
fn split_pair(rh TcpReadHalf, wh TcpWriteHalf) -> (TcpReadHalf, TcpWriteHalf) => (rh, wh)

// ─── TcpListener public API ───────────────────────────────────────────────────

/// Bind a TCP listener to `addr`. `SocketAddr.loopback(0)` → OS-assigned port
/// (`local_port()` reports it). `Err(NetError.AddressInUse)` if already bound.
#stable(since = "0.1")
export fn TcpListener.bind(addr SocketAddr) Net -> Result[TcpListener, NetError] {
    Net.tcp_bind(addr)
}

/// Bind a TCP listener to a string address (Rust-parity `ToSocketAddrs`
/// convenience). Parses `addr` via [`str @to_socket_addr`] then delegates to
/// the `SocketAddr` form above; a malformed address surfaces as the same
/// `NetError` the parser returns (`InvalidAddr`/`InvalidPort`).
#stable(since = "0.1")
export fn TcpListener.bind(addr str) Net -> Result[TcpListener, NetError] {
    TcpListener.bind(addr.to_socket_addr()?)
}

/// Accept the next incoming connection (parks; cancel-safe).
#stable(since = "0.1")
export fn TcpListener mut @accept() Net -> Result[TcpStream, NetError] {
    Net.accept(@)
}

/// Local port this listener is bound to.
#stable(since = "0.1")
export fn TcpListener @local_port() Net -> u16 { Net.listener_local_port(@) }

/// Local address this listener is bound to.
#stable(since = "0.1")
export fn TcpListener @local_addr() Net -> SocketAddr {
    mut b = addr_image()
    Net.listener_local_addr(@, b)
    SocketAddr.from_image(b)
}

/// Set SO_REUSEADDR.
#stable(since = "0.1")
export fn TcpListener mut @set_reuse_address(on bool) Net {
    Net.set_reuse_address(@, on)
}

/// Close the listener (consume).
#stable(since = "0.1")
export fn TcpListener consume @close() Net { Net.close_listener(@) }

/// D432/Plan 217.1 `Cleanup[never]` implementation: cleanup = `@close()`.
/// Makes `TcpListener` usable with auto-`@cleanup` (C hybrid, D432) — an
/// unconsumed listener at scope end closes automatically, like `TcpStream`
/// (see below).
#stable(since = "0.1")
export fn TcpListener consume @cleanup(_outcome ScopeOutcome) -> () {
    @close()
}

// ─── TcpStream public API ─────────────────────────────────────────────────────

/// Connect to a remote TCP address (parks until connected or error).
#stable(since = "0.1")
export fn TcpStream.connect(addr SocketAddr) Net -> Result[TcpStream, NetError] {
    Net.connect(addr)
}

/// Connect to a string address (Rust-parity `ToSocketAddrs` convenience).
/// Parses `addr` via [`str @to_socket_addr`] then delegates to the
/// `SocketAddr` form above; a malformed address surfaces as the same
/// `NetError` the parser returns (`InvalidAddr`/`InvalidPort`).
#stable(since = "0.1")
export fn TcpStream.connect(addr str) Net -> Result[TcpStream, NetError] {
    TcpStream.connect(addr.to_socket_addr()?)
}

/// Read up to `buf.len()` bytes into `buf`; returns `Ok(n)`. `Ok(0)` = clean EOF
/// (peer closed). The bytes land straight in `buf` (zero-copy).
///
/// **`io.Read` conformance:** the error is the shared
/// `io.IoError` (best-effort projection of the transport `NetError` via
/// `@to_error_kind()` — see std/net/error.nv), so `TcpStream` satisfies
/// `io.Read` structurally. The `Net` effect op itself still carries `NetError`
/// (`write_all`/`read_bytes`/`read_text` and the split halves surface it
/// directly, unchanged); only this method and `@write`/`@flush` are the
/// io-conformance surface.
#stable(since = "0.1")
export fn TcpStream mut @read(buf mut []u8) Net -> Result[int, IoError] {
    match Net.read(@, buf) {
        Ok(n)  => Ok(n)
        Err(e) => Err(e.to_io_error("read"))
    }
}

/// Write `data`; returns `Ok(n)` bytes accepted (sent straight from `data`).
/// **`io.Write` conformance:** see `@read`.
#stable(since = "0.1")
export fn TcpStream mut @write(data []u8) Net -> Result[int, IoError] {
    match Net.write(@, data) {
        Ok(n)  => Ok(n)
        Err(e) => Err(e.to_io_error("write"))
    }
}

/// `io.Write` conformance: a `TcpStream` write hits the socket directly (same
/// unbuffered contract as `File`) — `@flush()` is a no-op.
#stable(since = "0.1")
export fn TcpStream mut @flush() -> Result[(), IoError] => Ok(())

/// Write the entire buffer, looping until all bytes are sent.
#stable(since = "0.1")
export fn TcpStream mut @write_all(data []u8) Net -> Result[(), NetError] {
    mut off = 0
    while off < data.len() {
        match Net.write(@, data[off..]) {
            Ok(n)  => { if n <= 0 { return Err(NetError.BrokenPipe) } off += n }
            Err(e) => { return Err(e) }
        }
    }
    Ok(())
}

/// Read up to `max` bytes, returning them as an owned `[]u8` (empty = EOF).
/// Byte-first convenience over the buffer-fill `@read`.
#stable(since = "0.1")
export fn TcpStream mut @read_bytes(max int) Net -> Result[[]u8, NetError] {
    mut buf []u8 = []u8.new()
    buf.resize(max, 0 as u8)
    match Net.read(@, buf) {
        Ok(n)  => { buf.truncate(n) Ok(buf) }
        Err(e) => { Err(e) }
    }
}

/// Read up to `max` bytes and decode as UTF-8 text.
///
/// Text convenience over the bytes: `[]u8 @to_str() -> Result[str, Utf8Error]`;
/// invalid UTF-8 surfaces as `NetError.IoError`.
#stable(since = "0.1")
export fn TcpStream mut @read_text(max int) Net -> Result[str, NetError] {
    match @read_bytes(max) {
        Ok(bytes) => {
            match bytes.to_str() {
                Ok(s)  => Ok(s)
                Err(_) => Err(NetError.IoError("invalid utf-8 in stream"))
            }
        }
        Err(e) => Err(e)
    }
}

/// Write text as its UTF-8 bytes; returns `Ok(n)` bytes accepted.
#stable(since = "0.1")
export fn TcpStream mut @write_str(s str) Net -> Result[int, NetError] {
    Net.write(@, s.bytes())
}

/// Half-close the write side (TCP FIN); the read side stays open.
#stable(since = "0.1")
export fn TcpStream mut @shutdown() Net -> Result[(), NetError] { Net.shutdown(@) }

/// Local port of this stream.
#stable(since = "0.1")
export fn TcpStream @local_port() Net -> u16 { Net.stream_local_port(@) }

/// Remote peer port of this stream.
#stable(since = "0.1")
export fn TcpStream @peer_port() Net -> u16 { Net.stream_peer_port(@) }

/// Local address of this stream.
#stable(since = "0.1")
export fn TcpStream @local_addr() Net -> SocketAddr {
    mut b = addr_image()
    Net.stream_local_addr(@, b)
    SocketAddr.from_image(b)
}

/// Remote peer address of this stream.
#stable(since = "0.1")
export fn TcpStream @peer_addr() Net -> SocketAddr {
    mut b = addr_image()
    Net.stream_peer_addr(@, b)
    SocketAddr.from_image(b)
}

/// Set TCP_NODELAY (disable Nagle).
#stable(since = "0.1")
export fn TcpStream mut @set_nodelay(on bool) Net { Net.set_nodelay(@, on) }

/// Set TCP keepalive.
#stable(since = "0.1")
export fn TcpStream mut @set_keepalive(on bool) Net { Net.set_keepalive(@, on) }

/// **Alias of ONE TCP stream, NOT an independent copy** (Plan 201,
/// D188 amendment): `share()` returns a second OWNER of the same socket —
/// read/write bytes are SHARED between the copies, and the socket is
/// **closed by the LAST** owner (`rc` fetch_add on share, fetch_sub on
/// `close`/`cleanup`; the real extern-close runs only when rc reaches 0).
/// Each copy is an owned linear value with its OWN consume obligation
/// (D133): it must be closed too.
///
/// Canonical uses: escaping a `consume X { … }` block
/// (`TlsStream.new(stream.share(), session)`) and a per-fiber copy for
/// multi-fiber access (`ro w = s.share(); spawn { …w… }` —
/// E_LINEAR_CAPTURE_IN_FIBER forbids capture without share).
///
/// Named `share` (NOT `clone`): Nova's Clone protocol — an independent
/// deep copy; alias semantics — always `share()`.
#stable(since = "0.1")
export fn TcpStream @share() -> TcpStream {
    @rc.fetch_add(1)
    share_copy(@handle, @rc)
}

/// Close the stream (consume). Plan 201: with `share()` copies the real
/// extern-close runs only in the LAST owner (rc → 0); the other closes only
/// release their share of ownership.
#stable(since = "0.1")
export fn TcpStream consume @close() Net {
    if @rc.fetch_sub(1) == 1 {
        Net.close_stream(@)
    }
}

/// D188 `Cleanup[never]` implementation (Plan 201): cleanup = `@close()`
/// (rc-aware — the real extern-close only in the last owner).
/// Makes `TcpStream` usable in `consume s = … { … }` /
/// `consume s { … }` scope blocks.
#stable(since = "0.1")
export fn TcpStream consume @cleanup(_outcome ScopeOutcome) -> () {
    @close()
}

/// Split into a read half and a write half (consume). The halves share the
/// connection but have independent park slots, so they may be moved into
/// separate fibers and used concurrently; the socket closes after BOTH close.
///
/// Plan 201: split requires SOLE ownership — `split()` on a
/// `share()`-ed stream (rc > 1) = runtime panic: the halves are counted by a
/// C-side split-refcount, and a live share-copy would break the
/// "last-owner-closes" invariant.
#stable(since = "0.1")
export fn TcpStream consume @into_split() Net -> (TcpReadHalf, TcpWriteHalf) {
    if @rc.fetch_sub(1) != 1 {
        panic("TcpStream.into_split(): stream has live share()-copies — split requires sole ownership (close the copies first)")
    }
    ro h = @handle
    Net.mark_split(TcpStream.from_raw(h))
    split_pair(TcpReadHalf.from_raw(h), TcpWriteHalf.from_raw(h))
}

// ─── TcpReadHalf / TcpWriteHalf public API ───────────────────────────────────

/// Read up to `buf.len()` bytes into `buf`; `Ok(0)` = EOF.
#stable(since = "0.1")
export fn TcpReadHalf mut @read(buf mut []u8) Net -> Result[int, NetError] {
    Net.read(TcpStream.from_raw(@handle), buf)
}

/// Local port of this read half.
#stable(since = "0.1")
export fn TcpReadHalf @local_port() Net -> u16 {
    Net.stream_local_port(TcpStream.from_raw(@handle))
}

/// Close the read half (consume). Closes the socket if the write half is gone.
#stable(since = "0.1")
export fn TcpReadHalf consume @close() Net {
    Net.close_stream(TcpStream.from_raw(@handle))
}

/// D432/Plan 217.1 `Cleanup[never]` implementation: cleanup = `@close()`.
#stable(since = "0.1")
export fn TcpReadHalf consume @cleanup(_outcome ScopeOutcome) -> () {
    @close()
}

/// Write `data` to the write half; returns `Ok(n)` bytes accepted.
#stable(since = "0.1")
export fn TcpWriteHalf mut @write(data []u8) Net -> Result[int, NetError] {
    Net.write(TcpStream.from_raw(@handle), data)
}

/// Local port of this write half.
#stable(since = "0.1")
export fn TcpWriteHalf @local_port() Net -> u16 {
    Net.stream_local_port(TcpStream.from_raw(@handle))
}

/// Close the write half (consume): sends a real TCP FIN (half-close,
/// `shutdown(SHUT_WR)`) to the peer so it observes clean EOF on ITS read
/// side, then releases this half's ownership unit. Closes the socket only
/// once the read half is ALSO gone (split-refcounted, `net_tcp_close`).
///
/// Plan 249 Ф.0-а fix: before this, closing only the write half decremented
/// the split refcount and returned WITHOUT touching the socket at all
/// (`net_tcp_close`'s `if (left > 0) return;` early-out in
/// `compiler-codegen/nova_rt/net.c`) — no `uv_shutdown` call anywhere on
/// that path, so the peer's read half blocked forever waiting for a FIN
/// that never came. `Net.shutdown` (wired to the separate `net_tcp_shutdown`
/// C function) is now issued explicitly first; it is a plain `uv_shutdown`
/// fire-and-forget (see net.c's `net_tcp_shutdown` doc comment — "half-close
/// is already advisory") and does not affect the split-refcount teardown
/// that follows.
#stable(since = "0.1")
export fn TcpWriteHalf consume @close() Net {
    // Best-effort/advisory by design (mirrors net_tcp_shutdown's own doc
    // comment): a shutdown failure here does not change what `close()` does
    // next — the split-refcounted close below still runs either way.
    ro _ = Net.shutdown(TcpStream.from_raw(@handle))
    Net.close_stream(TcpStream.from_raw(@handle))
}

/// D432/Plan 217.1 `Cleanup[never]` implementation: cleanup = `@close()`.
#stable(since = "0.1")
export fn TcpWriteHalf consume @cleanup(_outcome ScopeOutcome) -> () {
    @close()
}

// ─── real_net: the unified Net handler (TCP + UDP + DNS) ──────────────────────

/// Concrete `Net` handler over libuv via the net2 C FFI. Install at the root of
/// an async program:
/// ```nova
/// with Net = real_net() { /* network code */ }
/// ```
///
/// `#default_handler` (bare form) — `Net` now auto-constructs (lazily, once
/// per thread) on first transitive use with no enclosing `with Net = …`,
/// consistent with `Time`/`real_time()`.
#stable(since = "0.1")
#default_handler
export fn real_net() -> Effect[Net] => effect Net {
    // ── TCP ──────────────────────────────────────────────────────────────────
    tcp_bind(addr SocketAddr) -> Result[TcpListener, NetError] {
        mut err int = 0                                   // &err → *mut int out-param
        ro h = unsafe { net_tcp_listen(addr.ptr(), 128, &err) }
        if is_null(h) { err_listener(err) } else { listener_ok(h) }
    }
    accept(listener TcpListener) -> Result[TcpStream, NetError] {
        mut err int = 0
        ro h = unsafe { net_tcp_accept(listener.handle, &err) }
        if is_null(h) { err_stream(err) } else { stream_ok(h) }
    }
    connect(addr SocketAddr) -> Result[TcpStream, NetError] {
        mut err int = 0
        ro h = unsafe { net_tcp_connect(addr.ptr(), &err) }
        if is_null(h) { err_stream(err) } else { stream_ok(h) }
    }
    read(stream TcpStream, buf mut []u8) -> Result[int, NetError] {
        ro n = unsafe { net_tcp_read(stream.handle, buf.ptr(), buf.len()) }
        if n < 0 { int_err(n) } else { int_ok(n) }
    }
    write(stream TcpStream, data []u8) -> Result[int, NetError] {
        ro n = unsafe { net_tcp_write(stream.handle, data.ptr(), data.len()) }
        if n < 0 { int_err(n) } else { int_ok(n) }
    }
    shutdown(stream TcpStream) -> Result[(), NetError] {
        ro rc = unsafe { net_tcp_shutdown(stream.handle) }
        if rc < 0 { unit_err(rc) } else { unit_ok() }
    }
    close_stream(stream TcpStream) -> () { unsafe { net_tcp_close(stream.handle) } }
    close_listener(listener TcpListener) -> () { unsafe { net_listener_close(listener.handle) } }
    mark_split(stream TcpStream) -> () { unsafe { net_tcp_mark_split(stream.handle) } }
    listener_local_port(listener TcpListener) -> u16 => unsafe { net_listener_local_port(listener.handle) }
    listener_local_addr(listener TcpListener, out mut []u8) -> () {
        unsafe { net_listener_local_addr(listener.handle, out.ptr()) }
    }
    stream_local_port(stream TcpStream) -> u16 => unsafe { net_tcp_local_port(stream.handle) }
    stream_peer_port(stream TcpStream) -> u16 => unsafe { net_tcp_peer_port(stream.handle) }
    stream_local_addr(stream TcpStream, out mut []u8) -> () {
        unsafe { net_tcp_local_addr(stream.handle, out.ptr()) }
    }
    stream_peer_addr(stream TcpStream, out mut []u8) -> () {
        unsafe { net_tcp_peer_addr(stream.handle, out.ptr()) }
    }
    set_nodelay(stream TcpStream, on bool) -> () => unsafe { net_tcp_set_nodelay(stream.handle, on) }
    set_keepalive(stream TcpStream, on bool) -> () => unsafe { net_tcp_set_keepalive(stream.handle, on) }
    set_reuse_address(listener TcpListener, on bool) -> () => unsafe { net_listener_set_reuse_address(listener.handle, on) }

    // ── UDP ──────────────────────────────────────────────────────────────────
    udp_bind(addr SocketAddr) -> Result[UdpSocket, NetError] {
        mut err int = 0
        ro h = unsafe { net_udp_bind(addr.ptr(), &err) }
        if is_null(h) { err_socket(err) } else { socket_ok(h) }
    }
    send_to(sock UdpSocket, data []u8, addr SocketAddr) -> Result[int, NetError] {
        ro n = unsafe { net_udp_send_to(sock.handle, data.ptr(), data.len(), addr.ptr()) }
        if n < 0 { int_err(n) } else { int_ok(n) }
    }
    recv_from(sock UdpSocket, buf mut []u8, sender mut []u8) -> Result[int, NetError] {
        ro n = unsafe { net_udp_recv_from(sock.handle, buf.ptr(), buf.len(), sender.ptr()) }
        if n < 0 { int_err(n) } else { int_ok(n) }
    }
    close_socket(sock UdpSocket) -> () { unsafe { net_udp_close(sock.handle) } }
    socket_local_port(sock UdpSocket) -> u16 => unsafe { net_udp_local_port(sock.handle) }
    socket_local_addr(sock UdpSocket, out mut []u8) -> () {
        unsafe { net_udp_local_addr(sock.handle, out.ptr()) }
    }

    // ── DNS ──────────────────────────────────────────────────────────────────
    lookup(host []u8, port u16) -> Result[(int, int), NetError] {
        mut base int = 0    // C writes the GC-array base pointer here (via &base)
        mut err int = 0
        ro count = unsafe { net_dns_lookup(host.ptr(), host.len(), port, (&base) as *(), &err) }
        if count < 0 { err_lookup(err) } else { lookup_ok(base, count) }
    }
}
