// SPDX-License-Identifier: MIT OR Apache-2.0
// std/net/udp.nv — UDP public API (byte surface).
//
// UdpSocket: bound async datagram socket. All operations carry `Net` and return
// `Result[T, NetError]`; `send_to` sends straight from the caller's bytes,
// `recv_from` writes the datagram straight into the caller's buffer and fills a
// 20-byte sender image (no TLS `_net_recv_data`/`_net_recv_sender`). `close()`
// consumes (use-after-close is a compile error).

module std.net

/// Bound async UDP datagram socket.
///
/// ```nova
/// with Net = real_net() {
///     supervised {
///         spawn {
///             mut sock = UdpSocket.bind(SocketAddr.loopback(0))!!
///             mut buf = []u8.new(); buf.resize(512, 0 as u8)
///             let (n, sender) = sock.recv_from(buf)!!
///             sock.close()
///         }
///     }
/// }
/// ```
#stable(since = "0.1")
export type UdpSocket consume value { priv handle *() }

fn UdpSocket.from_raw(h *()) -> UdpSocket => { handle: h }

// Result constructors (regular fns — keep variant construction out of handlers).
fn socket_ok(h *()) -> Result[UdpSocket, NetError] => Ok(UdpSocket.from_raw(h))

fn err_socket(code int) -> Result[UdpSocket, NetError] => Err(NetError.from_code(code))

fn recv_pair(n int, addr SocketAddr) -> (int, SocketAddr) => (n, addr)

fn recv_ok(n int, addr SocketAddr) -> Result[(int, SocketAddr), NetError] => Ok(recv_pair(n, addr))

fn recv_bytes_pair(data []u8, addr SocketAddr) -> ([]u8, SocketAddr) => (data, addr)

fn recv_bytes_ok(data []u8, addr SocketAddr) -> Result[([]u8, SocketAddr), NetError] => Ok(recv_bytes_pair(data, addr))

/// Bind a UDP socket to `addr`. `SocketAddr.loopback(0)` → OS-assigned port.
#stable(since = "0.1")
export fn UdpSocket.bind(addr SocketAddr) Net -> Result[UdpSocket, NetError] {
    Net.udp_bind(addr)
}

/// Send a datagram to `addr`; returns `Ok(n)` bytes sent (straight from `data`).
#stable(since = "0.1")
export fn UdpSocket mut @send_to(data []u8, addr SocketAddr) Net -> Result[int, NetError] {
    Net.send_to(@, data, addr)
}

/// Send text (its UTF-8 bytes) as a datagram to `addr`.
#stable(since = "0.1")
export fn UdpSocket mut @send_str(s str, addr SocketAddr) Net -> Result[int, NetError] {
    Net.send_to(@, s.bytes(), addr)
}

/// Receive the next datagram into `buf`; returns `Ok((n, sender))`.
/// The bytes land straight in `buf` (zero-copy); `sender` is the peer address.
#stable(since = "0.1")
export fn UdpSocket mut @recv_from(buf mut []u8) Net -> Result[(int, SocketAddr), NetError] {
    mut sender = addr_image()
    match Net.recv_from(@, buf, sender) {
        Ok(n)  => recv_ok(n, SocketAddr.from_image(sender))
        Err(e) => Err(e)
    }
}

/// Receive the next datagram as an owned `[]u8` plus the sender address.
#stable(since = "0.1")
export fn UdpSocket mut @recv_from_vec(max int) Net -> Result[([]u8, SocketAddr), NetError] {
    mut buf []u8 = []u8.new()
    buf.resize(max, 0 as u8)
    mut sender = addr_image()
    match Net.recv_from(@, buf, sender) {
        Ok(n)  => { buf.truncate(n) recv_bytes_ok(buf, SocketAddr.from_image(sender)) }
        Err(e) => Err(e)
    }
}

/// Local port this socket is bound to.
#stable(since = "0.1")
export fn UdpSocket @local_port() Net -> u16 { Net.socket_local_port(@) }

/// Local address this socket is bound to.
#stable(since = "0.1")
export fn UdpSocket @local_addr() Net -> SocketAddr {
    mut b = addr_image()
    Net.socket_local_addr(@, b)
    SocketAddr.from_image(b)
}

/// Close the socket (consume).
#stable(since = "0.1")
export fn UdpSocket consume @close() Net { Net.close_socket(@) }

/// D432/Plan 217.1 `Cleanup[never]` implementation: cleanup = `@close()`.
/// Makes `UdpSocket` usable with auto-`@cleanup` (C hybrid, D432) — an
/// unconsumed socket at scope end closes automatically (see
/// `TcpStream`/`TcpListener`, std/net/tcp.nv).
#stable(since = "0.1")
export fn UdpSocket consume @cleanup(_outcome ScopeOutcome) -> () {
    @close()
}
