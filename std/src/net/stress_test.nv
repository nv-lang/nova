// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 183 Ф.4 — M:N stress proof + throughput baseline over std/net2.
//
// Test 1: 8 client fibers × concurrent echo exchanges through ONE listener
// under work-stealing. Every fiber sends its own byte pattern
// (`(fid*31 + k*7) % 251`) and must receive exactly its own bytes back —
// cross-fiber payload corruption (the old net.c TLS-slot class) would trip
// the per-byte asserts.
//
// Test 2: throughput baseline (§2а ориентир): 8 MiB ping-pong echoed in
// 64 KiB chunks over one loopback connection; the measured MiB/s is printed
// (visible via `nova test-build --keep-artifacts` + direct run) and recorded
// in docs/plans/183-net-rework.md.
//
// Loop-affinity contract (net2.c header, Ф.4): every socket is created INSIDE
// the fiber that operates it, so the uv handle lives on that worker's own
// libuv loop. The listener port is published through a buffered channel
// (capacity == number of clients → sends never park).
//
// `must` (typed-Result extractor) is shared from tcp_test.nv (same module).

module std.net

// [M-p81-unknown-static-receiver-silent-p67] (окно №81): `Monotonic` was used
// below with NO import anywhere in this module's peer-file group — silently
// tolerated only inside a huge multi-file compile unit (spec_tests/conformance)
// that happens to ALSO contain an unrelated file importing the real
// declaration (std/time/duration/monotonic.nv); an isolated single-file/folder
// compile of just std/net (`nova build`/`nova test` on split_test.nv,
// byte_surface_test.nv, ...) has no such neighbor, exposing the miss as a
// checker-silent `[P67-LEGACY] ... method=now` ICE in emit_c. Real fix: import
// the module that actually declares `Monotonic`.
import std.time.duration

test "net2/stress: 8 fibers × concurrent echo through one listener, per-fiber pattern integrity" {
    with Net = real_net() {
        ro ch_port = Channel[int].new(8)
        supervised {
            // Server: bind in-fiber, publish the port 8×, then serve 8
            // connections sequentially (each echo runs to completion; client
            // payloads sit in kernel buffers meanwhile — 8 KiB ≪ SO_RCVBUF).
            spawn {
                mut lst = must(TcpListener.bind(SocketAddr.loopback(0)))
                ro port = lst.local_port()
                assert(port > 0)
                for _ in 0..8 {
                    ch_port.tx.send(port)     // buffered (cap 8) — no park
                }
                for _ in 0..8 {
                    mut conn = must(lst.accept())
                    mut buf []u8 = []u8.new()
                    buf.resize(8192, 0 as u8)
                    mut got = 0
                    while got < 8192 {
                        ro n = must_io(conn.read(buf))
                        assert(n > 0)          // client never half-closes early
                        assert(must_io(conn.write(buf[0..n])) == n)
                        got = got + n
                    }
                    assert(got == 8192)
                    conn.close()
                }
                lst.close()
            }
            // 8 clients: each connects in-fiber, streams its own 8 KiB
            // pattern, and byte-verifies the echo.
            for fid in 0..8 {
                spawn {
                    ro port = match ch_port.rx.recv() { Some(p) => p, None => 0 }
                    assert(port > 0)
                    mut data []u8 = []u8.new()
                    data.resize(8192, 0 as u8)
                    for k in 0..8192 {
                        data[k] = ((fid * 31 + k * 7) % 251) as u8
                    }
                    mut conn = must(TcpStream.connect(SocketAddr.loopback(port)))
                    match conn.write_all(data) {
                        Ok(_)  => {}
                        Err(_) => assert(false)
                    }
                    // Echo arrives in-order — verify each chunk against the
                    // pattern at its stream offset as it lands (no slice-view
                    // reads, no second 8 KiB buffer).
                    mut echo []u8 = []u8.new()
                    echo.resize(8192, 0 as u8)
                    mut off = 0
                    while off < 8192 {
                        ro n = must_io(conn.read(echo))
                        assert(n > 0)          // server echoes all 8192 bytes
                        for j in 0..n {
                            assert(echo[j] == ((fid * 31 + (off + j) * 7) % 251) as u8)
                        }
                        off = off + n
                    }
                    assert(off == 8192)
                    conn.close()
                }
            }
        }
    }
}

test "net2/stress: throughput baseline — 8 MiB echo in 64 KiB chunks" {
    with Net = real_net() {
        ro ch_port = Channel[int].new(1)
        supervised {
            // Echo server: one connection, echo chunks until 8 MiB total.
            spawn {
                mut lst = must(TcpListener.bind(SocketAddr.loopback(0)))
                ch_port.tx.send(lst.local_port())   // buffered — no park
                mut conn = must(lst.accept())
                mut buf []u8 = []u8.new()
                buf.resize(65536, 0 as u8)
                mut total = 0
                while total < 8388608 {
                    ro n = must_io(conn.read(buf))
                    assert(n > 0)
                    assert(must_io(conn.write(buf[0..n])) == n)
                    total = total + n
                }
                assert(total == 8388608)
                conn.close()
                lst.close()
            }
            // Client: ping-pong 128 × 64 KiB, timed.
            spawn {
                ro port = match ch_port.rx.recv() { Some(p) => p, None => 0 }
                mut chunk []u8 = []u8.new()
                chunk.resize(65536, 171 as u8)      // 0xAB fill
                mut back []u8 = []u8.new()
                back.resize(65536, 0 as u8)
                mut conn = must(TcpStream.connect(SocketAddr.loopback(port)))
                ro start = Monotonic.now().nanos()
                for _ in 0..128 {
                    match conn.write_all(chunk) {
                        Ok(_)  => {}
                        Err(_) => assert(false)
                    }
                    mut off = 0
                    while off < 65536 {
                        ro n = must_io(conn.read(back))
                        assert(n > 0)
                        // Spot-verify each landed chunk (full byte integrity
                        // is test 1's job).
                        assert(back[0] == 171 as u8)
                        assert(back[n - 1] == 171 as u8)
                        off = off + n
                    }
                    assert(off == 65536)
                }
                ro elapsed_ns = Monotonic.now().nanos() - start
                assert(elapsed_ns > 0)
                // One-way payload: 8 MiB. MiB/s = 8 * 1e9 / elapsed_ns.
                ro mibps = 8 * 1000000000 / elapsed_ns
                ro elapsed_ms = elapsed_ns / 1000000
                // NOTE: `${…}` interpolation kept here (not `mibps.to_str()`)
                // — historically `int` owned no `to_str` method and a
                // same-module collision let a bare `.to_str()` call SILENTLY
                // mis-dispatch to `NetError.to_str` (int passed as the enum
                // pointer → SEGV); fixed by checker receiver-type inference,
                // [M-183-int-to-str-module-method-collision] CLOSED. Plan 174.2:
                // `int` now HAS a canonical `@to_str()` (bare-T blanket,
                // std/runtime/string/core.nv) and D84/D285 receiver-compatibility
                // dispatch resolves it correctly even alongside `NetError.to_str`
                // in the same CU — interpolation kept here anyway (no reason to
                // churn a working call site; `.to_str()` is exercised elsewhere).
                println("net2/stress: throughput ${mibps} MiB/s (8 MiB in 64K chunks, ${elapsed_ms} ms)")
                assert(mibps > 0)
                conn.close()
            }
        }
    }
}
