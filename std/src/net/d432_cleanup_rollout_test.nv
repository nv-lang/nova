// Split halves reach `@cleanup` only via an explicit re-bind into a bare
// consume-let (see module doc comment above — `.into_split()`'s own tuple
// return is NOT tracked by D432's flow analysis).
test "Plan 217.1: split halves re-bound into bare idents auto-clean independently" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        with Net = mock_net() {
            consume s = match TcpStream.connect(SocketAddr.loopback(0)) {
                Ok(consume c) => c
                Err(_) => panic("connect")
            }
            mut (rdh0, wrh0) = s.into_split()
            consume rdh = rdh0
            consume wrh = wrh0
            ro _x = rdh.local_port()
            ro _y = wrh.local_port()
        }
    }
    assert(exit_calls == 2)
}

test "Plan 217.1: split half explicit close disarms auto-cleanup (no double-fire)" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(label, _outcome, _duration_ms, _overrun) -> () {
            assert(label == "TcpWriteHalf")
            exit_calls += 1
            return ()
        }
    } {
        with Net = mock_net() {
            consume s = match TcpStream.connect(SocketAddr.loopback(0)) {
                Ok(consume c) => c
                Err(_) => panic("connect")
            }
            mut (rdh0, wrh0) = s.into_split()
            consume rdh = rdh0
            consume wrh = wrh0
            rdh.close()
            ro _y = wrh.local_port()
        }
    }
    assert(exit_calls == 1)
}
