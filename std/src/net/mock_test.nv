// Plan 183 Ф.2 — the in-memory mock_net() handler: deterministic net tests with
// no live substrate (no supervised/spawn needed — mock ops never park).
// `must` (typed-Result extractor) is shared from tcp_test.nv (same module).

module std.net

test "net2/mock: TCP round-trip is fully in-memory" {
    with Net = mock_net() {
        mut s = must(TcpStream.connect(SocketAddr.loopback(0)))
        assert(must_io(s.write("hi")) == 2)
        mut buf []u8 = []u8.new()
        buf.resize(32, 0 as u8)
        ro n = must_io(s.read(buf))
        assert(unsafe { buf[0..n].to_str_unchecked() } == "mock-reply")
        assert(s.local_port() == 5050)
        assert(s.peer_addr().port() == 6060)
        s.close()
    }
}

test "net2/mock: listener + UDP + DNS stubs are deterministic" {
    with Net = mock_net() {
        mut lst = must(TcpListener.bind(SocketAddr.loopback(0)))
        assert(lst.local_port() == 4242)
        assert(lst.local_addr().port() == 4242)
        mut conn = must(lst.accept())
        conn.close()
        lst.close()

        mut sock = must(UdpSocket.bind(SocketAddr.loopback(0)))
        assert(must(sock.send_to("x", SocketAddr.loopback(1))) == 1)
        assert(sock.local_port() == 7070)
        sock.close()

        // []SocketAddr via direct match (not generic must — see dns_test.nv).
        match resolve("anything", 80) {
            Ok(addrs) => assert(addrs.len() == 1)
            Err(_)    => assert(false)
        }
    }
}

// ─── str-address overloads (2026-08-02 owner decision: `bind`/`connect` take
// a `str` alongside `SocketAddr`, Rust `ToSocketAddrs`-parity) ───────────────

test "net2/mock: TcpListener.bind(str) parses then binds like the SocketAddr form" {
    with Net = mock_net() {
        mut lst = must(TcpListener.bind("0.0.0.0:0"))
        assert(lst.local_port() == 4242)
        lst.close()
    }
}

test "net2/mock: TcpListener.bind(str) rejects a malformed address before touching Net" {
    with Net = mock_net() {
        match TcpListener.bind("not an address") {
            Ok(consume l) => { l.close() assert(false) }
            Err(_) => assert(true)
        }
    }
}

test "net2/mock: TcpStream.connect(str) parses then connects like the SocketAddr form" {
    with Net = mock_net() {
        mut s = must(TcpStream.connect("127.0.0.1:9090"))
        assert(s.peer_addr().port() == 6060)
        s.close()
    }
}

test "net2/mock: TcpStream.connect(str) rejects a malformed address before touching Net" {
    with Net = mock_net() {
        match TcpStream.connect("not an address") {
            Ok(consume s) => { s.close() assert(false) }
            Err(_) => assert(true)
        }
    }
}

test "net2/mock: UdpSocket.bind(str) parses then binds like the SocketAddr form" {
    with Net = mock_net() {
        mut sock = must(UdpSocket.bind("0.0.0.0:0"))
        assert(sock.local_port() == 7070)
        sock.close()
    }
}

test "net2/mock: UdpSocket.bind(str) rejects a malformed address before touching Net" {
    with Net = mock_net() {
        match UdpSocket.bind("not an address") {
            Ok(consume sock) => { sock.close() assert(false) }
            Err(_) => assert(true)
        }
    }
}
