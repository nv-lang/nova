// SPDX-License-Identifier: MIT OR Apache-2.0
// std/text/regex_test.nv — публичный контракт Regex.compile/matches/find/find_all
// (RE2-style Thompson NFA engine).

module text.regex_test

import std.text.regex.{Regex, CompileError}

test "literal match" {
    ro r = Regex.compile("hello")!!
    assert(r.matches("hello"))
    assert(!r.matches("world"))
    assert(r.find("say hello world") == Some((4, 9)))
}

test "any char ." {
    ro r = Regex.compile("a.c")!!
    assert(r.matches("abc"))
    assert(r.matches("a-c"))
    assert(!r.matches("ac"))
}

test "char class" {
    ro r = Regex.compile("[abc]")!!
    assert(r.matches("a"))
    assert(r.matches("b"))
    assert(!r.matches("d"))
}

test "char class range" {
    ro r = Regex.compile("[a-z]+")!!
    assert(r.matches("hello"))
    assert(!r.matches("123"))
}

test "negated class" {
    ro r = Regex.compile("[^0-9]")!!
    assert(r.matches("a"))
    assert(!r.matches("5"))
}

test "\\d \\w \\s" {
    ro digit = Regex.compile("\\d+")!!
    assert(digit.matches("12345"))
    assert(!digit.matches("abc"))

    ro word = Regex.compile("\\w+")!!
    assert(word.matches("hello_world123"))

    ro space = Regex.compile("\\s+")!!
    assert(space.matches("   "))
}

test "anchors ^ $" {
    ro r = Regex.compile("^abc$")!!
    assert(r.matches("abc"))
    assert(!r.matches("xabc"))
    assert(!r.matches("abcx"))
}

test "quantifier *" {
    ro r = Regex.compile("ab*c")!!
    assert(r.matches("ac"))
    assert(r.matches("abc"))
    assert(r.matches("abbbbbc"))
}

test "quantifier +" {
    ro r = Regex.compile("ab+c")!!
    assert(!r.matches("ac"))
    assert(r.matches("abc"))
}

test "quantifier ?" {
    ro r = Regex.compile("ab?c")!!
    assert(r.matches("ac"))
    assert(r.matches("abc"))
    assert(!r.matches("abbc"))
}

test "repeat {n}" {
    ro r = Regex.compile("a{3}")!!
    assert(r.matches("aaa"))
    assert(!r.matches("aa"))
    assert(!r.matches("aaaa"))       // в matches требуем полное совпадение
}

test "repeat {n,m}" {
    ro r = Regex.compile("a{2,4}")!!
    assert(!r.matches("a"))
    assert(r.matches("aa"))
    assert(r.matches("aaa"))
    assert(r.matches("aaaa"))
    assert(!r.matches("aaaaa"))
}

test "alternation" {
    ro r = Regex.compile("cat|dog|bird")!!
    assert(r.matches("cat"))
    assert(r.matches("dog"))
    assert(r.matches("bird"))
    assert(!r.matches("fish"))
}

test "groups (...)" {
    ro r = Regex.compile("(ab)+")!!
    assert(r.matches("ab"))
    assert(r.matches("abab"))
    assert(r.matches("ababab"))
    assert(!r.matches("aba"))
}

test "phone number pattern" {
    ro r = Regex.compile("^\\d{3}-\\d{4}$")!!
    assert(r.matches("123-4567"))
    assert(!r.matches("12-4567"))
    assert(!r.matches("123-456"))
}

test "find inside text" {
    ro r = Regex.compile("\\d+")!!
    assert(r.find("call 123 then 456") == Some((5, 8)))
}

test "find_all" {
    ro r = Regex.compile("\\d+")!!
    ro matches = r.find_all("a1 b22 c333")
    assert(matches.len() == 3)
}

test "no catastrophic backtracking — ключевое отличие от PCRE" {
    // Этот pattern на длинной строке 'aaaa...' зависает в PCRE,
    // но в RE2/Thompson NFA — линейная сложность.
    ro r = Regex.compile("(a+)+b")!!
    assert(!r.matches("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    // Должно завершиться быстро без зависания.
}

test "compile: unclosed group" {
    assert(match Regex.compile("(abc") {
        Err(UnclosedGroup { .. }) => true
        _                         => false
    })
}

test "compile: unclosed class" {
    assert(match Regex.compile("[abc") {
        Err(UnclosedClass { .. }) => true
        _                         => false
    })
}
