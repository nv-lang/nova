// stdlib/markdown_minimal.nv — minimal CommonMark subset → HTML.
// https://spec.commonmark.org/0.31.2/
//
// Поддержка:
//   - Headings: # h1, ## h2, ... ###### h6
//   - Paragraphs (пустая строка как separator)
//   - Inline emphasis: *italic*, **bold**, `code`
//   - Inline links: [text](url)
//   - Code blocks: ```...```
//   - Bullet lists: - item / * item
//
// Не поддержка (намеренно):
//   - Numbered lists, nested lists
//   - Tables (GFM extension)
//   - Reference-style links
//   - HTML passthrough
//   - Images, footnotes, blockquotes
//
// Это ~25% CommonMark, достаточно для README/docs/changelogs.
//
// API:
//   Markdown.to_html(md str) -> str

module text.markdown_minimal


/// Convert minimal CommonMark subset → HTML.
///
/// Поддерживает: headings (`#`), paragraphs, `*italic*`, `**bold**`,
/// `` `code` ``, `[text](url)`, ``` ``` ``` блоки, `-` bullet lists.
///
/// Не поддерживает: numbered lists, tables, reference links, HTML passthrough,
/// images, footnotes, blockquotes. Достаточно для README/changelogs.
///
/// # Examples
/// ```nova
/// let html = Markdown.to_html("# Title\n\n**bold** text")
/// assert(html.contains("<h1>Title</h1>"))
/// ```
#stable(since = "0.1")
export fn Markdown.to_html(md str) -> str {
    consume buf = StringBuilder.new(cap: md.byte_len() * 2)
    ro lines = md.split("\n").collect()
    mut i = 0
    mut in_code_block = false
    mut in_list = false
    consume paragraph = StringBuilder.new()

    while i < lines.len() {
        ro line = lines[i]

        // Code block fence
        if line.starts_with("```") {
            if in_code_block {
                buf.append("</code></pre>\n")
                in_code_block = false
            } else {
                flush_paragraph(buf, paragraph)
                consume paragraph = StringBuilder.new()
                if in_list { buf.append("</ul>\n"); in_list = false }
                buf.append("<pre><code>")
                in_code_block = true
            }
            i += 1
            continue
        }

        if in_code_block {
            buf.append(escape_html(line))
            buf.append('\n')
            i += 1
            continue
        }

        // Heading
        if line.starts_with("#") {
            flush_paragraph(buf, paragraph)
            consume paragraph = StringBuilder.new()
            if in_list { buf.append("</ul>\n"); in_list = false }
            // Целевая for-in итерация вместо ретрактированного `chars().nth(level)`
            // (D260-амендмент) — последовательный скан, случайный доступ не нужен.
            mut level = 0
            for c in line.chars() {
                if level == 6 { break }
                if c != '#' { break }
                level += 1
            }
            ro text = line[level..line.byte_len()].trim_ascii()
            buf.append("<h${level.to_str()}>")
            buf.append(render_inline(text))
            buf.append("</h${level.to_str()}>\n")
            i += 1
            continue
        }

        // Bullet list item
        if line.starts_with("- ") || line.starts_with("* ") {
            flush_paragraph(buf, paragraph)
            consume paragraph = StringBuilder.new()
            if !in_list {
                buf.append("<ul>\n")
                in_list = true
            }
            buf.append("<li>")
            buf.append(render_inline(line[2..line.byte_len()]))
            buf.append("</li>\n")
            i += 1
            continue
        }

        // Empty line — paragraph break
        if line.trim_ascii().byte_len() == 0 {
            flush_paragraph(buf, paragraph)
            consume paragraph = StringBuilder.new()
            if in_list { buf.append("</ul>\n"); in_list = false }
            i += 1
            continue
        }

        // Regular paragraph line
        if paragraph.byte_len() > 0 { paragraph.append(' ') }
        paragraph.append(line)
        i += 1
    }

    // Flush последнего
    flush_paragraph(buf, paragraph)
    if in_list { buf.append("</ul>\n") }
    if in_code_block { buf.append("</code></pre>\n") }

    buf
}


fn flush_paragraph(mut buf StringBuilder, consume paragraph StringBuilder) -> () {
    ro text = paragraph.into_str()
    ro trimmed = text.trim_ascii()
    if trimmed.byte_len() > 0 {
        buf.append("<p>")
        buf.append(render_inline(trimmed))
        buf.append("</p>\n")
    }
}


// Inline parsing: **bold**, *italic*, `code`, [text](url)
//
// Random-access index scan (lookahead/backahead на i+1, end+1, ...) — не
// последовательный for-in паттерн, поэтому вместо ретрактированного
// `chars().nth(i)` (D260-амендмент) материализуем `[]char` ОДИН раз (O(n)
// push-loop, не `.collect()` — CharsIter `.collect()` крашит кодоген,
// [M-d73-d77-retraction-migration] Block 2 precedent) и далее — O(1)
// `Vec[char] @get(i)`.
fn render_inline(s str) -> str {
    consume buf = StringBuilder.new(cap: s.byte_len())
    ro sc = to_chars(s)
    ro n = sc.len()
    mut i = 0
    while i < n {
        ro c = sc[i]

        // Inline code
        if c == '`' {
            ro start = i + 1
            mut end = start
            while end < n && sc.get(end) != Some('`') { end += 1 }
            if end < n {
                buf.append("<code>")
                buf.append(escape_html(s[start..end]))
                buf.append("</code>")
                i = end + 1
                continue
            }
        }

        // Bold ** ... **
        if c == '*' && sc.get(i + 1) == Some('*') {
            ro start = i + 2
            mut end = start
            while end + 1 < n {
                if sc.get(end) == Some('*') && sc.get(end + 1) == Some('*') { break }
                end += 1
            }
            if end + 1 < n {
                buf.append("<strong>")
                buf.append(escape_html(s[start..end]))
                buf.append("</strong>")
                i = end + 2
                continue
            }
        }

        // Italic * ... *
        if c == '*' {
            ro start = i + 1
            mut end = start
            while end < n && sc.get(end) != Some('*') { end += 1 }
            if end < n {
                buf.append("<em>")
                buf.append(escape_html(s[start..end]))
                buf.append("</em>")
                i = end + 1
                continue
            }
        }

        // Link [text](url)
        if c == '[' {
            ro close_bracket_opt = find_in(sc, ']', i + 1)
            match close_bracket_opt {
                Some(close_bracket) => {
                    if sc.get(close_bracket + 1) == Some('(') {
                        ro close_paren_opt = find_in(sc, ')', close_bracket + 2)
                        match close_paren_opt {
                            Some(close_paren) => {
                                ro text = s[i + 1..close_bracket]
                                ro url = s[close_bracket + 2..close_paren]
                                buf.append("<a href=\"")
                                buf.append(escape_html(url))
                                buf.append("\">")
                                buf.append(escape_html(text))
                                buf.append("</a>")
                                i = close_paren + 1
                                continue
                            }
                            None => ()
                        }
                    }
                }
                None => ()
            }
        }

        // Литерал — экранируем HTML-спецсимволы (пропущенное экранирование
        // здесь — pre-existing content-баг: escape_html() вызывался только
        // для code/link сегментов, обычный текст проходил raw; обнаружено
        // 2026-07-08 через `nova test --full`, `nova check` этого не ловил).
        match c {
            '<' => buf.append("&lt;")
            '>' => buf.append("&gt;")
            '&' => buf.append("&amp;")
            '"' => buf.append("&quot;")
            _   => buf.append(c)
        }
        i += 1
    }
    buf
}


// Push-loop materialisation of `s.chars()` — see `render_inline` doc.
fn to_chars(s str) -> []char {
    mut out []char = []char.new(cap: s.byte_len())
    for c in s.chars() { out.push(c) }
    out
}

fn find_in(sc []char, target char, start int) -> Option[int] {
    mut i = start
    while i < sc.len() {
        if sc.get(i) == Some(target) { return Some(i) }
        i += 1
    }
    None
}


fn escape_html(s str) -> str {
    consume buf = StringBuilder.new(cap: s.byte_len())
    for c in s.chars() {
        match c {
            '<' => buf.append("&lt;")
            '>' => buf.append("&gt;")
            '&' => buf.append("&amp;")
            '"' => buf.append("&quot;")
            _   => buf.append(c)
        }
    }
    buf
}


