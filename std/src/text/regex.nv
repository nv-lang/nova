// stdlib/regex.nv — RE2-style regex engine.
//
// Independent implementation. Алгоритм Russ Cox (Thompson's NFA simulation):
//   https://swtch.com/~rsc/regstack/
//
// Ключевое отличие от PCRE / Perl:
//   - Гарантированная O(n*m) линейная сложность по длине input.
//   - НЕТ catastrophic backtracking — `(a+)+b` на 'aaaa...' работает быстро.
//   - НЕТ backreferences (\1, \2) — математически требуют backtracking.
//   - НЕТ lookbehind ((?<=...)) — лимитация классической NFA.
//
// Поддержка:
//   - Char classes: . [a-z] [^abc] \d \w \s \D \W \S
//   - Anchors: ^ $
//   - Quantifiers: * + ? {n} {n,m}
//   - Groups: (...) (?:...)
//   - Alternation: a|b
//   - Escape: \. \\ \( \) \[ \] \* \+ \? \| \^ \$
//
// API:
//   Regex.compile(pattern str) -> Result[Regex, CompileError]
//   re.matches(text str) -> bool
//   re.find(text str) -> Option[(int, int)]    // (start, end)
//   re.find_all(text str) -> [](int, int)
//
// Use cases: validation, search-filtering, user-supplied patterns
// (без риска DoS).

module text.regex

// ──────────────────────────────────────────────────────────────────────────
// AST после парсинга pattern'а
// ──────────────────────────────────────────────────────────────────────────

/// AST node after parsing a regex pattern (internal — usually not needed directly).
#stable(since = "0.1")
export type RegexNode enum
    | NEmpty
    | NLiteral(char)
    | NAnyChar
    | NCharClass { chars []char, ranges [](char, char), negated bool }
    | NConcat([]RegexNode)
    | NAlternate([]RegexNode)
    | NStar(RegexNode)
    | NPlus(RegexNode)
    | NOptional(RegexNode)
    | NRepeat { node RegexNode, min int, max int }
    | NAnchorStart
    | NAnchorEnd

// ──────────────────────────────────────────────────────────────────────────
// NFA states (после компиляции)
// ──────────────────────────────────────────────────────────────────────────
//
// Каждый state — node в NFA. Переходы:
//   - Match: один out, потребляет character matching predicate
//   - Split: два out, эпсилон-переход (без потребления)
//   - Match (final): принимающее состояние
//
// State хранится как индекс в []NfaState.

/// NFA state — Thompson construction (internal). State is stored as an index into `[]NfaState`.
#stable(since = "0.1")
export type NfaState enum
    | SMatch
    | SChar { c char, out int }
    | SAnyChar { out int }
    | SCharClass { chars []char, ranges [](char, char), negated bool, out int }
    | SSplit { out1 int, out2 int }
    | SAnchorStart { out int }
    | SAnchorEnd { out int }

/// Compiled regex. RE2-style NFA simulation — O(n*m) guaranteed, no catastrophic
/// backtracking. No backreferences or lookbehind (both require backtracking).
#stable(since = "0.1")
export type Regex {
    ro states []NfaState
    ro start int
    ro anchored_start bool
}

/// Errors when compiling a regex pattern.
#stable(since = "0.1")
export type CompileError enum
    | UnclosedGroup { position int }
    | UnclosedClass { position int }
    | InvalidEscape { position int, char char }
    | InvalidQuantifier { position int }
    | NothingToRepeat { position int }

// ──────────────────────────────────────────────────────────────────────────
// Parsing — pattern → AST
// ──────────────────────────────────────────────────────────────────────────

type Parser {
    pattern str
    // Push-loop materialisation of `pattern.chars()` (not `.collect()` —
    // crashes codegen on CharsIter). `@peek()` is called at every parse step;
    // decoding via `chars().nth(@pos)` would be an O(n) scan
    // per call. `chs.get(@pos)` is O(1). Pattern literals can
    // contain non-ASCII chars (e.g. matching literal Unicode text), so this
    // must be a real codepoint vector, not a byte view.
    chs []char
    mut pos int
}

fn Parser.new(p str) -> Self {
    mut chs []char = []char.new(cap: p.byte_len())
    for c in p.chars() { chs.push(c) }
    { pattern: p, chs, pos: 0 }
}

fn Parser @peek() -> Option[char] => @chs.get(@pos)

fn Parser mut @advance() -> Option[char] {
    ro c = @peek()
    if c != None { @pos += 1 }
    c
}

fn Parser mut @parse_pattern() Fail[CompileError] -> RegexNode {
    @parse_alternate()
}

// alternate := concat ('|' concat)*
fn Parser mut @parse_alternate() Fail[CompileError] -> RegexNode {
    mut alts []RegexNode = [@parse_concat()]
    while @peek() == Some('|') {
        @advance()
        alts.push(@parse_concat())
    }
    if alts.len() == 1 { alts[0] } else { NAlternate(alts) }
}

// concat := atom*
fn Parser mut @parse_concat() Fail[CompileError] -> RegexNode {
    mut items []RegexNode = []
    mut done = false
    while !done {
        match @peek() {
            None             => { done = true }
            Some(')')        => { done = true }
            Some('|')        => { done = true }
            _ => {
                ro atom = @parse_quantified()
                items.push(atom)
            }
        }
    }
    if items.len() == 0 { NEmpty }
    else if items.len() == 1 { items[0] }
    else { NConcat(items) }
}

// quantified := atom quantifier?
// quantifier := '*' | '+' | '?' | '{n}' | '{n,}' | '{n,m}'
fn Parser mut @parse_quantified() Fail[CompileError] -> RegexNode {
    ro atom = @parse_atom()
    match @peek() {
        Some('*') => { @advance(); NStar(atom) }
        Some('+') => { @advance(); NPlus(atom) }
        Some('?') => { @advance(); NOptional(atom) }
        Some('{') => @parse_braced_quantifier(atom)
        _         => atom
    }
}

fn Parser mut @parse_braced_quantifier(atom RegexNode) Fail[CompileError] -> RegexNode {
    ro start = @pos
    @advance()                           // {
    consume n_str = StringBuilder.new()
    loop {
        match @peek() {
            Some(c) if c >= '0' && c <= '9' => { n_str.append(c); @advance() }
            _ => break
        }
    }
    ro min_str = n_str.into_str()
    if min_str.byte_len() == 0 { throw InvalidQuantifier { position: start } }
    ro min = int.try_from(min_str) ?? throw InvalidQuantifier { position: start }

    ro max = if @peek() == Some(',') {
        @advance()
        @parse_quantifier_max(start)
    } else {
        min                          // {n} — точно n
    }

    if @peek() != Some('}') {
        throw InvalidQuantifier { position: start }
    }
    @advance()
    NRepeat { node: atom, min, max }
}

// Извлечён в отдельную fn: consume-binding `m_str` живёт целиком в СВОЁМ
// top-level function scope (не внутри ветки `if`-expression) — иначе
// компилятор не может доказать cleanup-покрытие для throw'ов
// снаружи ветки (`if @peek() != Some('}')` после этого блока).
fn Parser mut @parse_quantifier_max(start int) Fail[CompileError] -> int {
    consume m_str = StringBuilder.new()
    loop {
        match @peek() {
            Some(c) if c >= '0' && c <= '9' => { m_str.append(c); @advance() }
            _ => break
        }
    }
    ro m = m_str.into_str()
    if m.byte_len() == 0 { return -1 }        // {n,} — unbounded
    // [M-d162-structural-throw-sibling] обход: естественная match-форма
    // вместо `if parsed.is_err() { throw ... }` + `parsed!!`
    match int.try_from(m) {
        Ok(v)  => v
        Err(_) => throw InvalidQuantifier { position: start }
    }
}

// atom := char | '.' | '[' ... ']' | '(' alt ')' | '\\' escape | '^' | '$'
fn Parser mut @parse_atom() Fail[CompileError] -> RegexNode {
    match @peek() {
        None      => throw NothingToRepeat { position: @pos }
        Some('.') => { @advance(); NAnyChar }
        Some('^') => { @advance(); NAnchorStart }
        Some('$') => { @advance(); NAnchorEnd }
        Some('[') => @parse_char_class()
        Some('(') => @parse_group()
        Some('\\') => {
            @advance()
            @parse_escape()
        }
        Some(c) if is_special(c) => throw NothingToRepeat { position: @pos }
        Some(c) => { @advance(); NLiteral(c) }
    }
}

fn is_special(c char) -> bool =>
    c == '*' || c == '+' || c == '?' || c == '|' ||
    c == ')' || c == '}' || c == ']'

fn Parser mut @parse_char_class() Fail[CompileError] -> RegexNode {
    ro start = @pos
    @advance()                          // [
    ro negated = @peek() == Some('^')
    if negated { @advance() }
    mut chars []char = []
    mut ranges [](char, char) = []
    mut closed = false
    while !closed {
        match @peek() {
            None => throw UnclosedClass { position: start }
            Some(']') => { @advance(); closed = true }
            Some('\\') => {
                @advance()
                ro c = match @advance() {
                    Some(c) => decode_escape_char(c)
                    None    => throw UnclosedClass { position: start }
                }
                // Может быть range: \d-\f
                if @peek() == Some('-') && @chs.get(@pos + 1) != Some(']') {
                    @advance()
                    ro to = match @advance() {
                        Some('\\') => match @advance() {
                            Some(x) => decode_escape_char(x)
                            None    => throw UnclosedClass { position: start }
                        }
                        Some(x) => x
                        None    => throw UnclosedClass { position: start }
                    }
                    ranges.push((c, to))
                } else {
                    chars.push(c)
                }
            }
            Some(c) => {
                @advance()
                if @peek() == Some('-') && @chs.get(@pos + 1) != Some(']') {
                    @advance()
                    ro to = @advance() ?? throw UnclosedClass { position: start }
                    ranges.push((c, to))
                } else {
                    chars.push(c)
                }
            }
        }
    }
    NCharClass { chars, ranges, negated }
}

fn Parser mut @parse_group() Fail[CompileError] -> RegexNode {
    ro start = @pos
    @advance()                          // (
    // Non-capturing: (?:...)
    if @peek() == Some('?') {
        @advance()
        if @peek() == Some(':') {
            @advance()
        }
        // Named groups (?<name>...) — упрощено: пропускаем
    }
    ro inner = @parse_alternate()
    if @peek() != Some(')') {
        throw UnclosedGroup { position: start }
    }
    @advance()                          // )
    inner
}

fn Parser mut @parse_escape() Fail[CompileError] -> RegexNode {
    match @advance() {
        None => throw InvalidEscape { position: @pos, char: ' ' }
        Some(c) => match c {
            'd' => NCharClass { chars: [], ranges: [('0', '9')], negated: false }
            'D' => NCharClass { chars: [], ranges: [('0', '9')], negated: true }
            'w' => NCharClass {
                chars: ['_'],
                ranges: [('a', 'z'), ('A', 'Z'), ('0', '9')],
                negated: false,
            }
            'W' => NCharClass {
                chars: ['_'],
                ranges: [('a', 'z'), ('A', 'Z'), ('0', '9')],
                negated: true,
            }
            's' => NCharClass {
                chars: [' ', '\t', '\n', '\r'],
                ranges: [],
                negated: false,
            }
            'S' => NCharClass {
                chars: [' ', '\t', '\n', '\r'],
                ranges: [],
                negated: true,
            }
            'n' => NLiteral('\n')
            't' => NLiteral('\t')
            'r' => NLiteral('\r')
            other => NLiteral(other)        // \. \\ \( etc — литерал escape'а
        }
    }
}

fn decode_escape_char(c char) -> char => match c {
    'n' => '\n'
    't' => '\t'
    'r' => '\r'
    other => other
}

// ──────────────────────────────────────────────────────────────────────────
// Compile AST → NFA
// ──────────────────────────────────────────────────────────────────────────

type Compiler {
    mut states []NfaState
}

fn Compiler.new() -> Self => { states: [] }

fn Compiler mut @add(s NfaState) -> int {
    @states.push(s)
    @states.len() - 1
}

// Compile node → возвращает (start, [out_indices]) — outs нужно
// "patch'нуть" после.
//
// Упрощено: возвращаем только start; out — последний state ссылается
// на placeholder-id, который мы потом обновляем.
//
// Для bootstrap делаем линейную композицию: каждый node возвращает
// start-state и помещает свой "exit" как ссылку на следующий start.
//
// Используем sentinel-out -1 для "ещё не привязано", потом patch'им.

fn Compiler mut @compile_node(node RegexNode, out_state int) -> int {
    match node {
        NEmpty => out_state
        NLiteral(c) => @add(SChar { c, out: out_state })
        NAnyChar    => @add(SAnyChar { out: out_state })
        NCharClass { chars, ranges, negated } =>
            @add(SCharClass { chars, ranges, negated, out: out_state })
        NAnchorStart => @add(SAnchorStart { out: out_state })
        NAnchorEnd   => @add(SAnchorEnd { out: out_state })

        NConcat(items) => {
            // Compile right-to-left так чтобы каждое item вело в start следующего
            mut current = out_state
            for i in (0..items.len()).reverse() {
                current = @compile_node(items[i], current)
            }
            current
        }

        NAlternate(alts) => {
            // Для двух — простой Split; для N — n-1 Split-ов.
            if alts.len() == 1 { return @compile_node(alts[0], out_state) }
            // Compile все ветви, объединяем через Split
            mut start = @compile_node(alts[alts.len() - 1], out_state)
            for i in (0..alts.len() - 1).reverse() {
                ro branch = @compile_node(alts[i], out_state)
                start = @add(SSplit { out1: branch, out2: start })
            }
            start
        }

        NStar(inner) => {
            // Split: либо в inner (с возвратом в Split), либо в out
            // Patch loop: inner.out → split
            ro split_idx = @add(SSplit { out1: 0, out2: out_state })   // placeholder
            ro inner_start = @compile_node(inner, split_idx)
            // Patch out1
            @states[split_idx] = SSplit { out1: inner_start, out2: out_state }
            split_idx
        }

        NPlus(inner) => {
            // Однократный inner, потом Star inside
            ro split_idx = @add(SSplit { out1: 0, out2: out_state })
            ro inner_start = @compile_node(inner, split_idx)
            @states[split_idx] = SSplit { out1: inner_start, out2: out_state }
            inner_start
        }

        NOptional(inner) => {
            // Split: в inner или сразу к out
            ro inner_start = @compile_node(inner, out_state)
            @add(SSplit { out1: inner_start, out2: out_state })
        }

        NRepeat { node, min, max } => {
            // Развёртка: min обязательных, потом max-min опциональных
            // (или unbounded если max=-1).
            mut current = out_state
            // Optional / unbounded хвост
            if max == -1 {
                // {min,} = min обязательных + Star
                current = @compile_node(NStar(node), current)
            } else {
                // {min,max} = max-min Optional
                mut k = max - min
                while k > 0 {
                    current = @compile_node(NOptional(node), current)
                    k -= 1
                }
            }
            // min обязательных перед хвостом
            mut k = min
            while k > 0 {
                current = @compile_node(node, current)
                k -= 1
            }
            current
        }
    }
}

// ──────────────────────────────────────────────────────────────────────────
// Public API
// ──────────────────────────────────────────────────────────────────────────

/// Compile a regex pattern. `Err(CompileError)` on syntax errors.
///
/// Supported: `.`, `[a-z]`, `[^abc]`, `\d \w \s \D \W \S`, `^`, `$`,
/// `*`, `+`, `?`, `{n}`, `{n,m}`, `(...)`, `(?:...)`, `|`.
///
/// D325: public API is Result. Internal `@parse_*` are NOT exported and
/// stay on Fail[CompileError]: their return is a RegexNode with DIRECT recursion
/// (NStar(RegexNode) etc.), and `Result[RegexNode, _]` crashes codegen
/// (tens-of-GB allocations / hangs; minimal repro — an enum with
/// a directly-recursive variant inside Result) [M-result-direct-recursive-enum].
/// Fail does not leak outward — it is swallowed by the handler here.
///
/// # Examples
/// ```nova
/// let re = Regex.compile("^[a-z]+$")!!
/// assert(re.matches("hello"))
/// ```
#stable(since = "0.1")
export fn Regex.compile(pattern str) -> Result[Regex, CompileError] {
    with Fail[CompileError] = |e| interrupt Err(e) {
        mut p = Parser.new(pattern)
        ro ast = p.parse_pattern()

        // Detect anchored start
        ro anchored = match ast {
            NConcat(items) if items.len() > 0 => match items[0] {
                NAnchorStart => true
                _            => false
            }
            NAnchorStart => true
            _            => false
        }

        mut c = Compiler.new()
        ro accept = c.add(SMatch)
        ro start = c.compile_node(ast, accept)

        Ok({
            states: c.states,
            start,
            anchored_start: anchored,
        })
    }
}

// ──────────────────────────────────────────────────────────────────────────
// NFA simulation (Thompson)
// ──────────────────────────────────────────────────────────────────────────
//
// Двойной буфер: current set of states, next set. Для каждого character
// шагаем по character-edge'ам. ε-переходы expand'ятся в add_state().

// `tchars` — subject text materialised as `[]char` ONCE by the caller (see
// `try_match`) instead of scanning via `chars().nth()`.
fn add_state(set mut []bool, states []NfaState, idx int, pos int, tchars []char) -> () {
    if idx < 0 || idx >= states.len() { return () }
    if set[idx] { return () }
    set[idx] = true
    match states[idx] {
        SSplit { out1, out2 } => {
            add_state(set, states, out1, pos, tchars)
            add_state(set, states, out2, pos, tchars)
        }
        SAnchorStart { out } => {
            if pos == 0 {
                add_state(set, states, out, pos, tchars)
            }
        }
        SAnchorEnd { out } => {
            if pos == tchars.len() {
                add_state(set, states, out, pos, tchars)
            }
        }
        _ => ()
    }
}

fn matches_class(s NfaState, c char) -> bool => match s {
    SChar { c: target, .. } => c == target
    SAnyChar { .. } => c != '\n'
    SCharClass { chars, ranges, negated, .. } => {
        mut found = false
        for ch in chars { if ch == c { found = true } }
        for r in ranges {
            ro n = c as int
            if n >= (r.0 as int) && n <= (r.1 as int) { found = true }
        }
        if negated { !found } else { found }
    }
    _ => false
}

fn step_out(s NfaState) -> int => match s {
    SChar { out, .. } => out
    SAnyChar { out } => out
    SCharClass { out, .. } => out
    _ => -1
}

// Попробовать matchить начиная с position `start_pos` в tchars (subject text
// materialised as `[]char` by the caller — `Regex.matches`/`@find`/`@find_all`
// decode ONCE, not per `try_match` call, restoring O(n*m)
// instead of O(n²)-per-scan that `chars().nth()` would cause).
// Возвращает Some(end_pos) если matched (consumed [start_pos..end_pos]),
// иначе None.
fn try_match(re Regex, tchars []char, start_pos int) -> Option[int] {
    ro n = re.states.len()
    mut current []bool = []
    mut next []bool = []
    for i in 0..n { current.push(false); next.push(false) }

    add_state(current, re.states, re.start, start_pos, tchars)

    mut last_match = if current[final_state(re)] { Some(start_pos) } else { None }

    mut pos = start_pos
    while pos < tchars.len() {
        ro c = match tchars.get(pos) { Some(ch) => ch, None => break }

        // Reset next
        for k in 0..n { next[k] = false }

        // Step every active state
        for idx in 0..n {
            if current[idx] {
                if matches_class(re.states[idx], c) {
                    ro out = step_out(re.states[idx])
                    if out >= 0 {
                        add_state(next, re.states, out, pos + 1, tchars)
                    }
                }
            }
        }

        // Swap
        ro tmp = current
        current = next
        next = tmp

        pos += 1

        if current[final_state(re)] {
            last_match = Some(pos)
        }
    }

    last_match
}

fn final_state(re Regex) -> int {
    mut i = 0
    while i < re.states.len() {
        match re.states[i] {
            SMatch => return i
            _      => ()
        }
        i += 1
    }
    -1
}

// Полное соответствие?
// Push-loop materialisation of `s.chars()` (not `.collect()` — crashes
// codegen on CharsIter). Decoded ONCE per public entry call — see `try_match`
// doc for why. [M-d73-d77-retraction-migration]
fn to_chars(s str) -> []char {
    mut out []char = []char.new(cap: s.byte_len())
    for c in s.chars() { out.push(c) }
    out
}

/// True if the regex matches anywhere in text (substring match).
#stable(since = "0.1")
export fn Regex @matches(text str) -> bool {
    ro tchars = to_chars(text)
    ro r = try_match(@, tchars, 0)
    match r {
        Some(end) => end == tchars.len()
        None      => false
    }
}

// Найти первое вхождение, вернуть (start, end).
/// Find first match — returns `Some((start, end))` byte-offsets, or `None`.
#stable(since = "0.1")
export fn Regex @find(text str) -> Option[(int, int)] {
    ro tchars = to_chars(text)
    mut start = 0
    if @anchored_start {
        match try_match(@, tchars, 0) {
            Some(end) => return Some((0, end))
            None      => return None
        }
    }
    while start <= tchars.len() {
        match try_match(@, tchars, start) {
            Some(end) => return Some((start, end))
            None      => ()
        }
        start += 1
    }
    None
}

/// Find all non-overlapping matches — list of `(start, end)` tuples.
#stable(since = "0.1")
export fn Regex @find_all(text str) -> [](int, int) {
    ro tchars = to_chars(text)
    mut results [](int, int) = []
    mut start = 0
    while start <= tchars.len() {
        match try_match(@, tchars, start) {
            Some(end) => {
                results.push((start, end))
                if end > start { start = end } else { start += 1 }
            }
            None => { start += 1 }
        }
    }
    results
}

// Тесты — см. peer-файл regex_test.nv (module text.regex_test).
