// std/runtime/parse_float_corpus_slow.nv — plan 283 Ф.5: the external float-parsing
// corpus (github.com/nigeltao/parse-number-fxx-test-data, 5 299 993 lines) against Nova's
// own conversion, bit for bit. Slow lane (`_slow`, D376): skipped by `nova test` by
// default, run with `--slow-only` / `--include-slow`.
//
// Where the corpus comes from: `scripts/tools/fetch-parse-float-corpus.sh` clones it at a
// pinned commit into `nova_tests/.cache/parse-number-fxx/` (gitignored) or into
// `$NOVA_PARSE_FLOAT_CORPUS`. The data is NOT in the repository (plan 283, «Не делаем»):
// millions of lines live outside, here are the runner and the hash.
//
// Corpus line = four space-separated fields: f16 bits, f32 bits, f64 bits (hex) and the
// string, e.g. `3C00 3F800000 3FF0000000000000 1`. Both the f64 AND the f32 field are
// judged (plan 283 Ф.7 opened `str @to_f32()`); the f16 field has no door in Nova.
//
// STREAMED, NOT SLURPED, and that is not premature: the four largest files are about 52 MB
// each, so reading one whole would allocate the file as a single `str` and then a Vec of
// five million line slices. The loop below holds one 64 KiB buffer and the tail of the
// previous chunk, so memory stays flat however large the corpus grows. The shape (`resize`,
// `loop` over `read`, `chunk[..n]`, retry on `is_interrupted`) is the one `io.read_to_end`
// uses; only the accumulation differs.
//
// Skip-never-fail: no corpus directory -> zero checks and a green test (the same policy as
// the Unicode conformance lane). A string Nova's grammar rejects (`inf`, hex floats,
// whitespace — the corpus has a few) is COUNTED as skipped, not failed. A mismatch anywhere
// is a FAIL naming the first offending line. The SECOND assertion is the one that catches a
// quiet nothing: files read but zero judged is a failure, not a pass — which is exactly how
// a CRLF corpus looked before the fetch script began refusing one.
//
// A sibling module of `runtime.string`, not a co-equal file: it needs `std.fs` / `std.os`
// (real handlers), which the `#no_prelude` string module cannot import.
module runtime.parse_float_corpus_slow

import std.fs.{real_fs, read_dir, File, Path, write}
import std.os.{real_os, env}
import std.runtime.numeric

const CORPUS_DEFAULT_DIR = "nova_tests/.cache/parse-number-fxx"
const CORPUS_CHUNK = 65536
const F64_POS_INF_BITS u64 = 0x7FF0000000000000
const F64_NEG_INF_BITS u64 = 0xFFF0000000000000

/// What the run found. Carried by reference, so the file loop and the line judge share one.
type CorpusTally {
    mut ok int
    mut mismatch int
    mut skipped int
    mut files int
    mut lines int
    mut first_bad str
}

fn CorpusTally.new() -> CorpusTally =>
    { ok: 0, mismatch: 0, skipped: 0, files: 0, lines: 0, first_bad: "" }

// One corpus line -> (expected f32 bits, expected f64 bits, the string), or None when the
// line has not got the four-field shape (blank lines, comments).
fn split_corpus_line(line str) -> Option[(u32, u64, str)] {
    ro (_f16, rest1) = line.split_once(" ")?
    ro (f32_hex, rest2) = rest1.split_once(" ")?
    ro (f64_hex, literal) = rest2.split_once(" ")?
    ro f32_bits = match f32_hex.to_u32(radix: 16) {
        Ok(b) => b
        Err(_) => return None
    }
    match f64_hex.to_u64(radix: 16) {
        Ok(bits) => Some((f32_bits, bits, literal))
        Err(_) => None
    }
}

fn CorpusTally mut @note_bad(what str) -> () {
    @mismatch += 1
    if @first_bad.is_empty() { @first_bad = what }
}

// Both doors against one corpus line. An overflow of ours (`TooLarge` / `TooSmall`) is the
// corpus's infinity: its field carries the bit pattern, we carry the direction.
fn CorpusTally mut @judge(name str, line str) -> () {
    if Some(parsed) = split_corpus_line(line) {
        ro (expected_f32, expected_f64, literal) = parsed
        @lines += 1
        match literal.to_f64() {
            Ok(v) => {
                if v.to_bits() == expected_f64 {
                    @ok += 1
                } else {
                    @note_bad("${name}: ${line} -> f64 ${v.to_bits()}")
                }
            }
            Err(TooLarge) => {
                if expected_f64 == F64_POS_INF_BITS {
                    @ok += 1
                } else {
                    @note_bad("${name}: ${line} -> TooLarge")
                }
            }
            Err(TooSmall) => {
                if expected_f64 == F64_NEG_INF_BITS {
                    @ok += 1
                } else {
                    @note_bad("${name}: ${line} -> TooSmall")
                }
            }
            Err(_) => { @skipped += 1 }
        }
        match literal.to_f32() {
            Ok(v32) => {
                if v32.to_bits() != expected_f32 { @note_bad("${name}: ${line} -> f32 ${v32.to_bits()}") }
            }
            Err(_) => {}
        }
    }
}

// One file, streamed: read a chunk, judge every COMPLETE line in it, carry the tail over.
fn CorpusTally mut @judge_file(dir Path, name str) Fs -> () {
    match File.open(dir.join(name)) {
        Err(_) => {}
        Ok(consume f) => {
            mut chunk []u8 = []u8.new()
            chunk.resize(CORPUS_CHUNK, 0 as u8)
            mut pending = ""
            mut done = false
            while !done {
                match f.read(chunk) {
                    Ok(0) => done = true
                    Ok(n) => {
                        ro text = match chunk[..n].to_str() {
                            Ok(s) => s
                            Err(_) => ""
                        }
                        ro joined = "${pending}${text}"
                        match joined.rsplit_once("\n") {
                            Some((head, tail)) => {
                                for line in head.split("\n") { @judge(name, line) }
                                pending = tail
                            }
                            None => pending = joined
                        }
                    }
                    Err(e) => {
                        // `is_interrupted` is worth a retry; anything else ends this file.
                        if !e.is_interrupted() { done = true }
                    }
                }
            }
            if !pending.is_empty() { @judge(name, pending) }
            match f.close() {
                Ok(()) => {}
                Err(_) => {}
            }
            @files += 1
        }
    }
}

test "283 Ф.5: parse-number-fxx corpus — every f64 and f32 field equals ours bit for bit (zero checks when the corpus is absent)" {
    ro dir = with Os = real_os() {
        match env("NOVA_PARSE_FLOAT_CORPUS") {
            Some(d) => d
            None => CORPUS_DEFAULT_DIR
        }
    }
    // A green run prints NOTHING: the harness echoes a test's stdout only when the binary
    // exits non-zero (`test_runner.rs`), and an `assert` message with interpolation is lost
    // whole (registry 221.1 #1002). So a run over 5.3 million lines would leave one word,
    // `PASS`, and no numbers -- and on a failure, no first offending line either. When
    // `NOVA_PARSE_FLOAT_CORPUS_REPORT` names a path, the tally is written there before the
    // assertions, so it survives both outcomes.
    ro report = with Os = real_os() {
        match env("NOVA_PARSE_FLOAT_CORPUS_REPORT") {
            Some(pth) => pth
            None => ""
        }
    }
    with Fs = real_fs() {
        supervised {
            spawn {
                ro data_dir = "${dir}/data".to_path()
                match read_dir(data_dir) {
                    Err(_) => {
                        // corpus absent: nothing to judge (run scripts/tools/fetch-parse-float-corpus.sh)
                        assert(true)
                    }
                    Ok(entries) => {
                        mut t = CorpusTally.new()
                        for e in entries {
                            if e.is_file() {
                                if Some(name) = e.name_str() {
                                    t.judge_file(data_dir, name)
                                }
                            }
                        }
                        if !report.is_empty() {
                            ro tally = "283 corpus: files=${t.files} lines=${t.lines} ok=${t.ok} mismatch=${t.mismatch} skipped=${t.skipped} first=${t.first_bad}\n"
                            // `write`, not `write_text`: the signature is matched exactly
                            // (`data []u8`), and this is the form the fs tests exercise --
                            // `write_text` has no caller and no test anywhere in the tree,
                            // and a long slot is the wrong place to be its first user.
                            match write(report.to_path(), tally.bytes()) {
                                Ok(()) => {}
                                Err(_) => {}
                            }
                        }
                        assert(t.mismatch == 0,
                            "283 corpus: files=${t.files} lines=${t.lines} ok=${t.ok} mismatch=${t.mismatch} skipped=${t.skipped}; first: ${t.first_bad}")
                        assert(t.files == 0 || t.ok > 0,
                            "283 corpus: ${t.files} file(s) read, ${t.lines} line(s) parsed, but nothing judged")
                    }
                }
            }
        }
    }
}
