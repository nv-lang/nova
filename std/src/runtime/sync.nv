/// Lock-free platform-word unsigned atomic integer.
///
/// `uint` = `nova_uint` = `uintptr_t` (address-sized, Plan 133/70.5; на
/// x64 совпадает по ширине с `uint64_t`). Platform-word unsigned atomic.
/// Useful for array indexes, buffer sizes.
///
/// Plan 207 (2026-07-16 консолидация имён): раньше назывался `Atomic` +
/// `Usize` — переименован в `AtomicUint`.
#stable(since = "0.1")
#share
export type AtomicUint(*())

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint.new(v uint) -> Self

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint @load(ord MemOrdering) -> uint
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint @load() -> uint

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint mut @store(v uint, ord MemOrdering)
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint mut @store(v uint)

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint mut @swap(v uint, ord MemOrdering) -> uint
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicUint mut @swap(v uint) -> uint

#realtime
extern "nova" fn AtomicUint mut @cmpxchg(expected uint, desired uint, weak bool, success MemOrdering, failure MemOrdering) -> CasRawUint

/// Compare-and-swap (Plan 207 [M-cas-return-witnessed-value]): `Ok(())` — успех
/// (значение заменено на `desired`). `Err(actual)` — провал, `actual` = фактически
/// прочитанное значение (witness), даром из C11 op — без повторного `load()` в CAS-цикле.
#realtime
#stable(since = "0.1")
export fn AtomicUint mut @compare_exchange(expected uint, desired uint, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), uint] {
    ro raw = @cmpxchg(expected, desired, false, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

/// Compare-and-swap weak: может spuriously fail даже если текущее значение ==
/// expected (ARM). Свидетель (`Err(actual)`) корректен и в spurious-failure
/// случае — `actual == expected`, но своп не произошёл, нужен повторный виток цикла.
#realtime
#stable(since = "0.1")
export fn AtomicUint mut @compare_exchange_weak(expected uint, desired uint, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), uint] {
    ro raw = @cmpxchg(expected, desired, true, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

