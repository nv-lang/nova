// ─── AtomicBool ──────────────────────────────────────────────────

/// Lock-free атомарный булев флаг.
///
/// `swap()` полезен для one-shot ownership паттерна:
/// `if !flag.swap(true) { /* только первый caller выполняет */ }`.
///
/// Ordering-aware overloads добавлены в Plan 103.2.
/// Methods без `MemOrdering` используют `SeqCst` (M1) — safest default.
///
/// # See Also
///
/// - `[AtomicInt]` — address-sized integer atomic
/// - `[AtomicI64]` — fixed 64-bit integer atomic
/// - `[Once]` — barrier для exactly-once execution
/// - `[MemOrdering]` — ordering parameter enum
#stable(since = "0.1")
#share
export type AtomicBool(*())

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool.new(v bool) -> Self

/// Загрузить текущее значение с explicit ordering.
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool @load(ord MemOrdering) -> bool
/// Загрузить текущее значение (SeqCst ordering).
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool @load() -> bool

/// Записать новое значение с explicit ordering.
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool mut @store(v bool, ord MemOrdering)
/// Записать новое значение (SeqCst ordering).
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool mut @store(v bool)

#realtime
extern "nova" fn AtomicBool mut @cmpxchg(expected bool, desired bool, weak bool, success MemOrdering, failure MemOrdering) -> CasRawBool

/// Compare-and-swap с explicit orderings (Plan 207 [M-cas-return-witnessed-value]).
/// `Ok(())` — успех. `Err(actual)` — провал, `actual` = witness (фактически
/// прочитанное значение, даром из C11 op).
#realtime
#stable(since = "0.1")
export fn AtomicBool mut @compare_exchange(expected bool, desired bool, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), bool] {
    ro raw = @cmpxchg(expected, desired, false, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

/// Compare-and-swap weak с explicit orderings. Может spuriously fail на ARM —
/// свидетель (`Err(actual)`) корректен и в spurious-failure случае.
#realtime
#stable(since = "0.1")
export fn AtomicBool mut @compare_exchange_weak(expected bool, desired bool, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), bool] {
    ro raw = @cmpxchg(expected, desired, true, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

/// Атомарно установить `v`, вернуть предыдущее значение с explicit ordering.
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool mut @swap(v bool, ord MemOrdering) -> bool
/// Атомарно установить `v`, вернуть предыдущее значение (SeqCst ordering).
///
/// Полезен для one-shot ownership: `if !flag.swap(true) { /* first */ }`.
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicBool mut @swap(v bool) -> bool

