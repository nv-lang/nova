// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 18 std.sync: fiber-aware synchronization primitives.
//
// AtomicInt   — lock-free address-sized atomic integer (nova_int width,
//               intptr_t — Plan 133). Plan 207 (2026-07-16): consolidated
//               name — absorbs the former int32-precision legacy AtomicInt
//               (its subset API is covered by this type's SeqCst defaults)
//               and the former Isize spelling.
// AtomicUint  — lock-free address-sized unsigned atomic integer (nova_uint
//               width, uintptr_t). Plan 207: consolidated from Usize spelling.
// AtomicBool  — lock-free atomic boolean; swap() useful for one-shot ownership.
// Mutex       — fair FIFO fiber-aware mutex; park/wake via nova_sched.
// WaitGroup   — counter-based rendezvous; wait() parks until count == 0.
// Once        — exactly-once execution barrier; run()/done() pair.
// MemOrdering — memory ordering enum for atomic ops and fences (Plan 103.1).
// fence()     — memory fence function; ordered by MemOrdering (Plan 103.1).
//
// Sync-class annotations (Plan 103.6):
//   #realtime — leaf method; allowed in realtime{} and blocking{}.
//   #parks         — may park the calling fiber; forbidden in realtime{} and blocking{}.
//   #wakes         — leaf wake (no self-park, but wakes waiters); forbidden in realtime{}.
//
// See compiler-codegen/nova_rt/sync_primitives.h for C implementations.

module runtime.sync

// ─── MemOrdering ─────────────────────────────────────────────────

/// Memory ordering для atomic operations и fences. Контролирует
/// happens-before отношения между операциями в разных fiber'ах.
///
/// Default ordering для simple-overload методов — `SeqCst` (design decision M1):
/// безопасно для всех use cases, может быть переопределено для
/// perf-critical кода через `_ordered` overloads (Plan 103.2+).
///
/// **Семантика** (D167):
///
/// - `Relaxed`: только атомарность операции; нет happens-before.
///   Use case: telemetry counters, statistics. Цена: dirty reads
///   возможны cross-fiber, но не torn writes.
/// - `Acquire`: для load; формирует happens-before с paired Release.
///   Use case: load shared payload after seeing flag set.
/// - `Release`: для store; формирует happens-before с paired Acquire.
///   Use case: publish payload before setting flag.
/// - `AcqRel`: для RMW (swap, CAS, fetch_*); combination Acquire+Release.
///   Use case: lock-free queue head/tail; one-shot ownership transfer.
/// - `SeqCst`: sequentially consistent — total order на всех SeqCst
///   операциях во всех fiber'ах. Use case: simple mental model,
///   correctness без deep analysis. Default.
///
/// **Примечание**: `MemOrdering` (memory ordering) отличается от
/// `Ordering` (three-way comparison: Less|Equal|Greater) из prelude.
/// Разные типы, разные применения.
///
/// **Variant tag values** (sync_primitives.h координация):
///   Relaxed=0  Acquire=1  Release=2  AcqRel=3  SeqCst=4
#stable(since = "0.1")
export type MemOrdering enum
    | Relaxed
    | Acquire
    | Release
    | AcqRel
    | SeqCst

/// Memory fence — sequenced ordering point без atomic operation.
///
/// Используется для отделения unsynchronized reads/writes от synchronized
/// (publish/subscribe pattern, refcount-drop с deferred-free).
///
/// **Семантика** (D167):
///
/// - `fence(MemOrdering.Relaxed)`: no-op. Валиден синтаксически для
///   consistency, но не имеет ordering эффекта (Acquire/Release нужны).
/// - `fence(MemOrdering.Acquire)`: все subsequent reads/writes
///   happen-after все prior Release-stores (visible-to-this-fiber).
/// - `fence(MemOrdering.Release)`: все prior reads/writes happen-before
///   все subsequent Acquire-loads (visible-to-other-fibers).
/// - `fence(MemOrdering.AcqRel)`: combination Acquire+Release.
/// - `fence(MemOrdering.SeqCst)`: total-order participation; sequenced
///   относительно всех других SeqCst fences и SeqCst operations.
///
/// # Example: refcount-drop с deferred-free
///
/// ```nova
/// // worker fiber:
/// let prev = refcount.fetch_sub(1)   // Release-dec (103.2)
/// if prev == 1 {
///     fence(MemOrdering.Acquire)     // synchronize with all Release-decs
///     // safe to access data — last fiber holds it
///     destroy(data)
/// }
/// ```
#realtime
#stable(since = "0.1")
export extern "nova" fn fence(ord MemOrdering)

// ─── CAS-witness raw carriers (Plan 207 [M-cas-return-witnessed-value]) ──
//
// `compare_exchange`/`compare_exchange_weak` return `Result[(), T]`: `Ok(())`
// on success, `Err(actual)` on failure where `actual` is the value the C11
// atomic op observed (witness) — no extra `load()` needed to retry a CAS
// loop. The private `@cmpxchg` intrinsic (module-private, not exported)
// returns the raw (ok, witness) pair from ONE atomic op; each public
// compare_exchange/_weak method below is a plain (non-extern) wrapper that
// builds the `Result` from it.
//
// These `CasRaw*` types are declared for the type-checker only — the C
// struct (`NovaTuple_CasRaw*`) is hand-written in `sync_primitives.h` and
// pre-registered in `RUNTIME_DEFINED_TYPES` (emit_c.rs), so codegen does not
// re-emit the struct body (same convention as `MutexGuard`/`MemOrdering`).
type CasRawI64(ok bool, witness i64)
type CasRawI32(ok bool, witness i32)
type CasRawI16(ok bool, witness i16)
type CasRawI8(ok bool, witness i8)
type CasRawU64(ok bool, witness u64)
type CasRawU32(ok bool, witness u32)
type CasRawU16(ok bool, witness u16)
type CasRawU8(ok bool, witness u8)
type CasRawInt(ok bool, witness int)
type CasRawUint(ok bool, witness uint)
type CasRawBool(ok bool, witness bool)

// ─── AtomicI64 ───────────────────────────────────────────────────

/// Lock-free 64-bit signed atomic integer.
///
/// Wraparound: signed overflow в fetch_add/sub — modular arithmetic
/// (consistent с Rust default, Java AtomicLong).
///
/// # Default ordering
///
/// Methods без `MemOrdering` параметра используют `SeqCst` (M1) — safest.
/// Для perf-critical использовать overloads с explicit [`MemOrdering`].
///
/// # See Also
///
/// - `[AtomicInt]` — address-sized (`intptr_t`) atomic; use when the width
///   must track the platform word (indexes/offsets), not a fixed 64 bits
/// - `[AtomicBool]` — atomic boolean
/// - `[MemOrdering]` — ordering parameter enum
#stable(since = "0.1")
#share
export type AtomicI64(*())

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64.new(v i64) -> Self

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 @load(ord MemOrdering) -> i64
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 @load() -> i64

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @store(v i64, ord MemOrdering)
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @store(v i64)

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @swap(v i64, ord MemOrdering) -> i64
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @swap(v i64) -> i64

#realtime
extern "nova" fn AtomicI64 mut @cmpxchg(expected i64, desired i64, weak bool, success MemOrdering, failure MemOrdering) -> CasRawI64

/// Compare-and-swap (Plan 207 [M-cas-return-witnessed-value]): `Ok(())` — успех
/// (значение заменено на `desired`). `Err(actual)` — провал, `actual` = фактически
/// прочитанное значение (witness), даром из C11 op — без повторного `load()` в CAS-цикле.
#realtime
#stable(since = "0.1")
export fn AtomicI64 mut @compare_exchange(expected i64, desired i64, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), i64] {
    ro raw = @cmpxchg(expected, desired, false, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

/// Compare-and-swap weak: может spuriously fail даже если текущее значение ==
/// expected (ARM). Свидетель (`Err(actual)`) корректен и в spurious-failure
/// случае — `actual == expected`, но своп не произошёл, нужен повторный виток цикла.
#realtime
#stable(since = "0.1")
export fn AtomicI64 mut @compare_exchange_weak(expected i64, desired i64, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), i64] {
    ro raw = @cmpxchg(expected, desired, true, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_add(v i64, ord MemOrdering) -> i64
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_add(v i64) -> i64

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_sub(v i64, ord MemOrdering) -> i64
#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_sub(v i64) -> i64

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_or(v i64, ord MemOrdering) -> i64
