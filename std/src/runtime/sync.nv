#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_or(v i64) -> i64

#realtime
#stable(since = "0.1")
export extern "nova" fn AtomicI64 mut @fetch_and(v i64, ord MemOrdering) -> i64
