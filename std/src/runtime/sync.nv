export fn AtomicUint mut @compare_exchange_weak(expected uint, desired uint, success MemOrdering = MemOrdering.SeqCst, failure MemOrdering = MemOrdering.SeqCst) -> Result[(), uint] {
    ro raw = @cmpxchg(expected, desired, true, success, failure)
    if raw.ok { Ok(()) } else { Err(raw.witness) }
}

