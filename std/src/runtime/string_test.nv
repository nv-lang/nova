// SPDX-License-Identifier: MIT OR Apache-2.0
// std/runtime/string_test.nv — beside-module test for the folder-module
// `std.runtime.string` (std/src/runtime/string/{chars,core,parse,search,
// slice,transform}.nv, all co-equal `module runtime.string`, `#no_prelude`).
// Same shape as `std/time/units_test.nv` importing `std.time.duration`
// (another folder-module) — a genuinely separate peer module, NOT a
// co-equal file inside the `string/` folder itself (that would just extend
// `runtime.string`'s own `#no_prelude` namespace and lose ordinary
// `assert()`/prelude access for no reason).
//
// [Числовой паритет-2, 2026-07-20]: covers the `str @to_*` widths added
// this wave (`to_i8`/`to_i16`/`to_i32`/`to_u16`/`to_uint`,
// std/runtime/string/parse.nv) — completing the SignedInts/UnsignedInts set
// that Plan 174.1 originally left partial by owner decision. Pre-existing
// `to_int`/`to_i64`/`to_u64`/`to_u32`/`to_u8` already have conformance
// coverage (spec_tests/conformance/parse_int_*.nv) — not duplicated here.
module runtime.string_test

import std.runtime.string.{ParseIntError}

test "Числовой паритет-2: str.to_i8 — в диапазоне / overflow / мусор" {
    match "100".to_i8() {
        Ok(n)  => { ro hundred i8 = 100; assert(n == hundred) }
        Err(_) => assert(false, "expected Ok(100)")
    }
    match "-100".to_i8() {
        Ok(n)  => { ro neg_hundred i8 = -100; assert(n == neg_hundred) }
        Err(_) => assert(false, "expected Ok(-100)")
    }
    match "200".to_i8() {
        Ok(_)          => assert(false, "expected Err(AboveMax) — 200 > i8.MAX(127)")
        Err(AboveMax)  => {}
        Err(_)         => assert(false, "expected AboveMax variant")
    }
    match "-200".to_i8() {
        Ok(_)          => assert(false, "expected Err(BelowMin) — -200 < i8.MIN(-128)")
        Err(BelowMin)  => {}
        Err(_)         => assert(false, "expected BelowMin variant")
    }
    match "abc".to_i8() {
        Ok(_)             => assert(false, "expected Err(InvalidDigit)")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit variant")
    }
}

test "Числовой паритет-2: str.to_i16 — в диапазоне / overflow / мусор" {
    match "30000".to_i16() {
        Ok(n)  => { ro thirty_k i16 = 30000; assert(n == thirty_k) }
        Err(_) => assert(false, "expected Ok(30000)")
    }
    match "40000".to_i16() {
        Ok(_)          => assert(false, "expected Err(AboveMax) — 40000 > i16.MAX(32767)")
        Err(AboveMax)  => {}
        Err(_)         => assert(false, "expected AboveMax variant")
    }
    match "xyz".to_i16() {
        Ok(_)             => assert(false, "expected Err(InvalidDigit)")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit variant")
    }
}

test "Числовой паритет-2: str.to_i32 — в диапазоне / overflow / мусор" {
    match "2000000000".to_i32() {
        Ok(n)  => { ro two_b i32 = 2000000000; assert(n == two_b) }
        Err(_) => assert(false, "expected Ok(2000000000)")
    }
    match "9999999999".to_i32() {
        Ok(_)          => assert(false, "expected Err(AboveMax) — > i32.MAX")
        Err(AboveMax)  => {}
        Err(_)         => assert(false, "expected AboveMax variant")
    }
    match "!!".to_i32() {
        Ok(_)             => assert(false, "expected Err(InvalidDigit)")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit variant")
    }
    match "".to_i32() {
        Ok(_)         => assert(false, "expected Err(Empty)")
        Err(Empty)    => {}
        Err(_)        => assert(false, "expected Empty variant")
    }
}

test "Числовой паритет-2: str.to_u16 — в диапазоне / overflow / мусор / '-' (unsigned InvalidDigit)" {
    match "60000".to_u16() {
        Ok(n)  => { ro sixty_k u16 = 60000; assert(n == sixty_k) }
        Err(_) => assert(false, "expected Ok(60000)")
    }
    match "70000".to_u16() {
        Ok(_)          => assert(false, "expected Err(AboveMax) — 70000 > u16.MAX(65535)")
        Err(AboveMax)  => {}
        Err(_)         => assert(false, "expected AboveMax variant")
    }
    match "-1".to_u16() {
        Ok(_)             => assert(false, "expected Err(InvalidDigit) — unsigned engine, no negation")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit variant")
    }
    match "zz".to_u16() {
        Ok(_)             => assert(false, "expected Err(InvalidDigit)")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit variant")
    }
}

test "Числовой паритет-2: str.to_uint — обычные значения / мусор / пусто (нет узкого range-check — сама ширина движка)" {
    match "123456789".to_uint() {
        Ok(n)  => { ro v uint = 123456789; assert(n == v) }
        Err(_) => assert(false, "expected Ok(123456789)")
    }
    match "0".to_uint() {
        Ok(n)  => { ro zero uint = 0; assert(n == zero) }
        Err(_) => assert(false, "expected Ok(0)")
    }
    match "garbage".to_uint() {
        Ok(_)             => assert(false, "expected Err(InvalidDigit)")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit variant")
    }
    match "".to_uint() {
        Ok(_)      => assert(false, "expected Err(Empty)")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty variant")
    }
}

test "Числовой паритет-2: radix-N работает для новых широт (hex to_i32, to_u16)" {
    match "ff".to_i32(radix: 16) {
        Ok(n)  => { ro v i32 = 255; assert(n == v) }
        Err(_) => assert(false, "expected Ok(255)")
    }
    match "ff".to_u16(radix: 16) {
        Ok(n)  => { ro v u16 = 255; assert(n == v) }
        Err(_) => assert(false, "expected Ok(255)")
    }
}

// ── Plan 232.1 Т1 (2026-07-26): str.to_bool / str.to_char ─────────────────

test "232.1 Т1: str.to_bool — 'true'/'false' строго lowercase" {
    match "true".to_bool() {
        Ok(b)  => assert(b == true)
        Err(_) => assert(false, "expected Ok(true)")
    }
    match "false".to_bool() {
        Ok(b)  => assert(b == false)
        Err(_) => assert(false, "expected Ok(false)")
    }
}

test "232.1 Т1: str.to_bool — 'TRUE' (регистр) / '' → Err" {
    match "TRUE".to_bool() {
        Ok(_)         => assert(false, "expected Err(Invalid) — регистр не lowercase")
        Err(Invalid)  => {}
        Err(_)        => assert(false, "expected Invalid variant")
    }
    match "".to_bool() {
        Ok(_)      => assert(false, "expected Err(Empty)")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty variant")
    }
}

test "232.1 Т1: str.to_bool — прочий мусор → Err(Invalid)" {
    match "1".to_bool() {
        Ok(_)         => assert(false, "expected Err(Invalid) — '1' не 'true'/'false'")
        Err(Invalid)  => {}
        Err(_)        => assert(false, "expected Invalid variant")
    }
    match "yes".to_bool() {
        Ok(_)         => assert(false, "expected Err(Invalid)")
        Err(Invalid)  => {}
        Err(_)        => assert(false, "expected Invalid variant")
    }
}

test "232.1 Т1: str.to_char — 'a' / 'ф' / '🎈' → Ok, ровно один codepoint" {
    match "a".to_char() {
        Ok(c)  => { ro want char = 'a'; assert(c == want) }
        Err(_) => assert(false, "expected Ok('a')")
    }
    match "ф".to_char() {
        Ok(c)  => { ro want char = 'ф'; assert(c == want) }
        Err(_) => assert(false, "expected Ok('ф')")
    }
    match "🎈".to_char() {
        Ok(c)  => { ro want char = '🎈'; assert(c == want) }
        Err(_) => assert(false, "expected Ok('🎈')")
    }
}

test "232.1 Т1: str.to_char — '' → Err(Empty), 'ab' → Err(TooManyChars)" {
    match "".to_char() {
        Ok(_)      => assert(false, "expected Err(Empty)")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty variant")
    }
    match "ab".to_char() {
        Ok(_)              => assert(false, "expected Err(TooManyChars)")
        Err(TooManyChars)  => {}
        Err(_)             => assert(false, "expected TooManyChars variant")
    }
}

// ── plan 282 Ф.4 (2026-09-05): str.to_f64 — грамматика наша, округление — C ──

test "282 Ф.4: str.to_f64 — строгая грамматика принимает формы литерала Rust/Go" {
    assert("1.5".to_f64() == Ok(1.5))
    assert("-3.25".to_f64() == Ok(-3.25))
    assert("+2.5E-3".to_f64() == Ok(0.0025))
    assert("1.".to_f64() == Ok(1.0))
    assert(".5".to_f64() == Ok(0.5))
    assert("1e3".to_f64() == Ok(1000.0))
    assert("-0.0".to_f64() == Ok(-0.0))
    assert("1e-999".to_f64() == Ok(0.0))            // underflow — не ошибка
}

test "282 Ф.4: str.to_f64 — что strtod принимал, а грамматика отвергает, с позицией" {
    match " 1.5".to_f64() {
        Err(Malformed { at }) => assert(at == 0, "leading space at 0")
        _ => assert(false, "leading whitespace must be Invalid")
    }
    match "1,5".to_f64() {
        Err(Malformed { at }) => assert(at == 1, "comma at 1")
        _ => assert(false, "comma is not a decimal separator")
    }
    match "0x1p3".to_f64() {
        Err(Malformed { at }) => assert(at == 1, "hex float breaks at x")
        _ => assert(false, "hex float must be Invalid")
    }
    match "nan".to_f64() {
        Err(Malformed { at }) => assert(at == 0, "nan is not a number literal")
        _ => assert(false, "nan must be Invalid")
    }
    match "inf".to_f64() {
        Err(Malformed { .. }) => {}
        _ => assert(false, "inf must be Invalid")
    }
    match "1.2.3".to_f64() {
        Err(Malformed { at }) => assert(at == 3, "second dot at 3")
        _ => assert(false, "two dots must be Invalid")
    }
    match "1e".to_f64() {
        Err(Malformed { at }) => assert(at == 2, "exponent without digits breaks at 2")
        _ => assert(false, "bare exponent must be Invalid")
    }
    match ".".to_f64() {
        Err(Malformed { .. }) => {}
        _ => assert(false, "a lone dot has no digits")
    }
    match "1.5 ".to_f64() {
        Err(Malformed { at }) => assert(at == 3, "trailing space at 3")
        _ => assert(false, "trailing whitespace must be Invalid")
    }
}

test "282 Ф.4: str.to_f64 — переполнение по направлению, не молчаливый inf (имена TooLarge/TooSmall — временные, до фикса №136)" {
    match "1e999".to_f64() {
        Err(TooLarge) => {}
        _ => assert(false, "1e999 must be TooLarge")
    }
    match "-1e999".to_f64() {
        Err(TooSmall) => {}
        _ => assert(false, "-1e999 must be TooSmall")
    }
    match "".to_f64() {
        Err(Empty) => {}
        _ => assert(false, "empty must be Empty")
    }
}

test "282 Ф.4: str.to_i8 — InvalidDigit несёт позицию" {
    match "12x4".to_i8() {
        Err(InvalidDigit { at }) => assert(at == 2, "x at 2")
        _ => assert(false, "12x4 must be InvalidDigit")
    }
    match "-".to_int() {
        Err(Empty) => {}
        _ => assert(false, "a lone sign is Empty")
    }
}
