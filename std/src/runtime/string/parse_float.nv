// Co-equal file of module `runtime.string` (folder = one module).
// Role: `str @to_f64()` — the float parse surface, grammar owned by Nova.
//
// Why a separate file (owner decision 2026-09-05, plan 282 Ф.4, D178 amendment): the
// old `to_f64` copied the string into a buffer and accepted whatever `strtod`
// accepted — leading whitespace, `nan`/`inf`, hex floats `0x1p3`, `1e999` as a silent
// `inf`, and a decimal separator taken from `LC_NUMERIC`. Parsing a number is two
// jobs: the GRAMMAR (what is a number, where it broke, did it overflow) and the
// correctly-rounded decimal→binary CONVERSION. The first is `parse_number` below,
// which also assembles the `Number` the second job consumes. The second used to be
// delegated to C; as of plan 283 Ф.4 it is a Nova port of Rust's `core::num::dec2flt`
// living in the peer `float_convert.nv` — a Clinger fast path, Eisel-Lemire, and a
// `DigitBuf` big-decimal slow path (`pow5_table.nv` carries the powers of five,
// `digit_buf.nv` the slow path itself). `str @to_f64()` no longer touches C at all;
// `strtod` remains only as the oracle of the differential tests.
//
// `str` Nova-body methods. #no_prelude breaks the prelude->string->prelude
// import cycle.

#no_prelude
module runtime.string

import std.prelude.core.{Option, Some, None, Result, Ok, Err}

// WHY THESE NAMES ARE INTERIM (2026-09-05, registry #136 + its new carrier). This note
// lives in `//`, not in `///`: a doc comment is a user-facing artifact of the coming
// release and carries no internal references — no plan numbers, no `[M-...]`, no registry
// numbers, no repro paths (nv-coding-style §0а). The owner's decision is the shared
// vocabulary `Empty | Invalid { at } | AboveMax | BelowMin` (same as `ParseIntError`,
// `RangeError`, `CharError`). It cannot be used yet: a variant name that exists in more
// than one sum of the CU is lowered by its BARE name — even when written qualified
// (`ParseFloatError.Invalid { at }`) — and lands in another sum's tag; measured on this
// file: `Err(Invalid { at })` built a `ParseBoolError.Invalid` (unit) and every match
// missed, `AboveMax` printed as `Invalid`. `Malformed`/`TooLarge`/`TooSmall` are unique in
// the CU and are to be renamed back to the vocabulary the day #136 is fixed (probe:
// `docs/plans/repro/962-variant-name-collision/`).

/// Error variants for `str @to_f64()`.
///
/// - `Empty` — the string is empty;
/// - `Malformed { at }` — the grammar broke at byte index `at` (first byte that does not
///   continue a number: `"1.2.3"` → `at: 3`, `" 1.5"` → `at: 0`, `"1,5"` → `at: 1`,
///   `"0x1p3"` → `at: 1`, `"nan"` → `at: 0`);
/// - `TooLarge` / `TooSmall` — the literal is finite but its value is outside `f64`
///   (`"1e999"`, `"-1e999"`); `strtod` would have returned `±inf` silently.
/// Underflow (`"1e-999"`) is not an error — the result is `0.0` or a denormal, which is
/// what the literal means at `f64` precision.
export type ParseFloatError enum Empty | Malformed { at int } | TooLarge | TooSmall

// parse.rs `MIN_19DIGIT_INT`: 10^18 — a significand at or above it already carries 19
// digits, the most a u64 holds without overflow for any next digit.
const MIN_19DIGIT_INT u64 = 1000000000000000000

// The grammar pass and the `Number` assembly in ONE walk over the bytes (donor: parse.rs
// `parse_partial_number`, minus the leniencies our grammar never had — no `inf`/`nan`, no
// partial match). The `Malformed { at }` positions are exactly those of the grammar-only
// version this replaces (plan 282 Ф.4); `string_test.nv` pins them.
//
// The significand is accumulated modulo 2^64 during the walk (wrapping, as the donor
// does): for up to 19 digits that IS the value; for more, the significant digits are
// re-read below and `many_digits` tells the converter that the tail was dropped.
fn parse_number(s str) -> Result[Number, ParseFloatError] {
    ro bytes = s.bytes()
    ro n = s.byte_len()
    if n == 0 { return Err(ParseFloatError.Empty) }
    mut i = 0
    ro negative = bytes[0] == '-'
    if bytes[0] == '-' || bytes[0] == '+' { i = 1 }
    ro int_start = i
    mut mantissa = 0 as u64
    mut n_digits = 0
    while i < n {
        ro c = bytes[i] as int
        if c >= '0' && c <= '9' {
            mantissa = mantissa.wrapping_mul(10).wrapping_add((c - 48) as u64)
            i += 1
            n_digits += 1
        } else { break }
    }
    ro int_end = i
    mut frac_start = i
    mut frac_end = i
    mut exponent = 0
    if i < n && bytes[i] == '.' {
        i += 1
        frac_start = i
        while i < n {
            ro c = bytes[i] as int
            if c >= '0' && c <= '9' {
                mantissa = mantissa.wrapping_mul(10).wrapping_add((c - 48) as u64)
                i += 1
                n_digits += 1
            } else { break }
        }
        frac_end = i
        exponent = -(frac_end - frac_start)
    }
    if n_digits == 0 { return Err(ParseFloatError.Malformed { at: i }) }
    mut exp_number = 0
    if i < n && (bytes[i] == 'e' || bytes[i] == 'E') {
        i += 1
        mut exp_negative = false
        if i < n && (bytes[i] == '-' || bytes[i] == '+') {
            exp_negative = bytes[i] == '-'
            i += 1
        }
        mut exponent_digits = 0
        while i < n {
            ro c = bytes[i] as int
            if c >= '0' && c <= '9' {
                // Saturate well before overflow (donor: parse_scientific): past 0x10000 the
                // value is zero or infinity whatever the significand says.
                if exp_number < 0x10000 { exp_number = 10 * exp_number + (c - 48) }
                i += 1
                exponent_digits += 1
            } else { break }
        }
        if exponent_digits == 0 { return Err(ParseFloatError.Malformed { at: i }) }
        if exp_negative { exp_number = -exp_number }
    }
    if i < n { return Err(ParseFloatError.Malformed { at: i }) }
    exponent += exp_number
    if n_digits <= 19 {
        return Ok(Number(mantissa, exponent, negative, false))
    }
    // More than 19 digits: leading zeros (and the dot among them) are not significant.
    mut significant = n_digits - 19
    mut p = int_start
    while p < frac_end && (bytes[p] == '.' || bytes[p] == '0') {
        if bytes[p] == '0' { significant -= 1 }
        p += 1
    }
    if significant <= 0 {
        // At most 19 significant digits after all: the wrapped accumulation is exact.
        return Ok(Number(mantissa, exponent, negative, false))
    }
    // Truly more than 19 significant digits: re-read the first 19 of them exactly, let the
    // exponent account for the digits not read, and flag the truncation.
    mantissa = 0
    mut j = int_start
    while j < int_end && mantissa < MIN_19DIGIT_INT {
        mantissa = mantissa * 10 + (((bytes[j] as int) - 48) as u64)
        j += 1
    }
    mut exp_read = 0
    if mantissa >= MIN_19DIGIT_INT {
        // 19 digits came from the integer part: the rest of it is the exponent
        exp_read = int_end - j
    } else {
        // continue into the fraction (it exists: the integer part alone was short)
        mut k = frac_start
        while k < frac_end && mantissa < MIN_19DIGIT_INT {
            mantissa = mantissa * 10 + (((bytes[k] as int) - 48) as u64)
            k += 1
        }
        exp_read = -(k - frac_start)
    }
    Ok(Number(mantissa, exp_read + exp_number, negative, true))
}

/// Strict float parse into `f32`, same grammar and same errors as `@to_f64()`.
///
/// ```text
/// float := [+-]? ( digits [ "." digits? ] | "." digits ) [ ("e"|"E") [+-]? digits ]
/// ```
///
/// The value is rounded to `f32` in ONE step, directly from the decimal digits. Parsing to
/// `f64` first and narrowing afterwards rounds twice and disagrees with the correct answer
/// for strings very close to the midpoint between two `f32` values, so it is not done.
/// `TooLarge` / `TooSmall` mean the literal is finite but outside `f32`; a value too small
/// for `f32` is `0.0` (or a denormal), which is what the literal means at this precision.
#stable(since = "0.1")
export fn str @to_f32() -> Result[f32, ParseFloatError] {
    ro n = parse_number(@)?
    ro v = convert_number_f32(n, @)
    // Infinity means the finite literal did not fit; we say which way rather than
    // returning it. Compared as BITS: the sign is carried by the pattern itself.
    ro bits = v.to_bits()
    if bits == F32_INF_BITS { return Err(ParseFloatError.TooLarge) }
    if bits == (F32_INF_BITS | (0x80000000 as u32)) { return Err(ParseFloatError.TooSmall) }
    Ok(v)
}

/// Strict float parse. Grammar (the same strictness as `@to_int`):
///
/// ```text
/// float := [+-]? ( digits [ "." digits? ] | "." digits ) [ ("e"|"E") [+-]? digits ]
/// ```
///
/// No leading/trailing whitespace, no `nan`/`inf`, no hex, no `_` separators, no locale:
/// the decimal separator is `.` and only `.`. Accepts `"1."`, `".5"`, `"1e3"`, `"-0.0"`,
/// `"+2.5E-3"` — the Rust/Go grammar for a float literal in a string.
#stable(since = "0.1")
export fn str @to_f64() -> Result[f64, ParseFloatError] {
    // Grammar first, then Nova's own rounding (`float_convert.nv`): the exact fast path,
    // Eisel-Lemire, and the big-decimal slow path for the near-half-way cases.
    // NB: variants are written qualified AND uniquely named — see the type's doc (#136).
    ro n = parse_number(@)?
    ro v = convert_number(n, @)
    // A FINITE literal whose value does not fit f64: the conversion yields infinity, and
    // we say which way rather than returning it.
    if v > 1.7976931348623157e308 { return Err(ParseFloatError.TooLarge) }
    if v < -1.7976931348623157e308 { return Err(ParseFloatError.TooSmall) }
    Ok(v)
}
