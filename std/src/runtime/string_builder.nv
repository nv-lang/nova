// Plan 109 (D179): StringBuilder реализован полностью на Nova.
// Тип: consume record с полем `mut buf []u8`.
// Ранее: external type + C runtime (Nova_StringBuilder / Rust String).
// Теперь: Nova record; все методы на Nova-body.
//
// API-изменения (Plan 109 / D179):
//   @byte_len() → bytes (O(1)), как str (D249-канон: строкоподобное — только
//     byte_len(); [M-unwrap-twins-retraction] 2026-07-07 откатил прежнее
//     «@byte_len удалён, используйте @len()» — D249 требует обратное)
//   - @char_len() удалён (счёт codepoint — линза+терминатор через
//     `.clone().into_str().chars().count()`, не выделенное свойство; 0
//     usages в std/, [M-unwrap-twins-retraction] 2026-07-07)
//   - @peek() удалён (unsound: pointer aliasing с realloc)
//   @into() переименован → @as_str() (consume)
//   @append_bytes(arr) удалён → @append(readonly arr []u8) overload
//   @plus(s) / @plus(c) удалены — используйте @append напрямую
//   type StringBuilder consume  — тип требует явного consume

// #no_prelude — break import cycle (prelude → collections → string_builder).
// Explicit imports cover only what we need.
#no_prelude
module runtime.string_builder

// Plan 208 Ф.1 (D422/D179 amend) — additive imports for the new
// @reserve/@advance/@pad_in_place/@write_padded/@into_str_checked methods
// below. `Align` (runtime.fmt_buf, also `#no_prelude` — see its header note)
// does not reopen the prelude cycle this file already breaks out of.
import std.runtime.fmt_buf.{Align}
import std.runtime.raw_mem.{RawMem}
import std.prelude.core.{Result}
import std.runtime.string.{Utf8Error}

// ─── Type ───

export type StringBuilder consume {
    mut buf []u8
}

// ─── Constructors ───

// Default capacity для StringBuilder.new() — 16 bytes (1-line string).
const INITIAL_CAPACITY = 16

// [M-vec-spelling-consume-block-body-untyped] (vec-sweep, 2026-07-06,
// RESOLVED by workaround): giving `StringBuilder.new()`/`@clone()` a
// multi-statement BLOCK body (`{ mut _buf ...; ...; { buf: _buf } }`) broke
// D133 consume-tracking for every OTHER file's `consume sb = StringBuilder.new()`
// call site in the same CU — `[D133-not-consumed] переменная sb (тип \`\`)`
// (empty resolved type — the consume-checker's own type-resolution pass
// didn't see through the block body, unlike the main type-checker). Kept as
// a private helper returning plain `[]u8` (no consume concerns there) so the
// constructor itself stays the single-expression `=> { buf: … }` bare-literal
// arrow-body shape the consume-checker expects.
fn sb_init_buf(cap int) -> []u8 => []u8.new(cap: cap)

// Deep-copy helper for `@clone`: fresh exact-capacity buffer + one bulk
// `append` (RawMem.copy). Free fn on `[]u8` (NOT a StringBuilder method) so
// `@clone`'s own body stays a single `=> { buf: … }` expression (same
// consume-checker shape constraint as `new()`/sb_init_buf above), AND so the
// `append` here dispatches on a plainly-typed `[]u8` local — calling
// `.append(@buf)` on a `{ buf: … }` record-literal receiver mis-dispatched to
// StringBuilder's own `@append(s str)` overload (generated C passed a
// `Nova_Vec____nova_byte*` where `nova_str` was expected) — this was the root
// of the `vec_of_empty_panic` CC-FAIL ([M-vec-neg-panic-cascaded-cc-fail]).
fn sb_clone_buf(src []u8) -> []u8 {
    mut b []u8 = sb_init_buf(src.len())
    b.append(src)
    b
}

// Пустой StringBuilder с pre-allocated capacity 16.
export fn StringBuilder.new(cap int = INITIAL_CAPACITY) -> Self
    requires cap >= 0
    => { buf: sb_init_buf(cap) }

// StringBuilder из существующей строки (copy UTF-8 bytes).
//
// W_STATIC_CONVERSION AMEND (2026-07-17, lint-разкраснение, владелец):
// static-конверсия `StringBuilder.from(s)` — запрещённая «пятая дверь»
// (nv-coding-style §1а, ретракция 2026-07-09). Канон: метод на источнике.
export fn str @to_stringbuilder() -> StringBuilder => StringBuilder.new().append(@)

// StringBuilder из одного codepoint (UTF-8 encode).
// Plan 73.1 D180: delegate to to_stringbuilder() (str) — старый pattern `let mut sb = StringBuilder.new()
// + sb.append(c)` нарушал D180 (sb consume-obligation не satisfied при
// implicit fluent-return). [M-91.11-from-char-direct] ✅ RESOLVED/verified:
// `new().append(c)` fluent chain совместим с D180.
//
// W_STATIC_CONVERSION AMEND (2026-07-17, lint-разкраснение, владелец): та же
// ретракция, что у `str @to_stringbuilder()` выше — метод на источнике `char`.
export fn char @to_stringbuilder() -> StringBuilder => StringBuilder.new().append(@)

// ─── Query methods ───

// Длина буфера в байтах. O(1). D249-канон: строкоподобная поверхность
// (как str) — только byte_len(), не len().
export fn StringBuilder @byte_len() -> int => @buf.len()

// Allocated capacity в байтах.
//
// [M-unwrap-twins-retraction] (2026-07-07): `@capacity()` alias
// РЕТРАКТИРОВАН (дублировал канонический `@cap()`, D9) — `@cap()` теперь
// единственный 0-arg getter половины `cap`/`cap(n)` property-пары
// (ex-`with_capacity`, D372 amend — with_capacity removed).
export fn StringBuilder @cap() -> int => @buf.cap()

// Set capacity to exactly `n` bytes (delegates to the underlying `[]u8`'s
// own exact `mut @cap(n)` — no rounding). Replacement for the removed
// `StringBuilder.with_capacity` static constructor: `StringBuilder.new().cap(n)`.
export fn StringBuilder mut @cap(n int) -> @
    requires n >= @byte_len()
{ @buf.cap(n) }

// true если буфер пуст.
export fn StringBuilder @is_empty() -> bool => @buf.is_empty()

// Независимая копия (deep copy buffer). Нужен для consume-типа при разветвлении.
export fn StringBuilder @clone() -> Self => { buf: sb_clone_buf(@buf) }

// Проверить prefix буфера. Slice-view + memcmp (zero-copy).
export fn StringBuilder @starts_with(prefix str) -> bool {
    ro pbytes = prefix.bytes()
    ro plen = pbytes.len()
    plen <= @buf.len() && @buf[0..plen].compare(pbytes) == 0
}

// Проверить suffix буфера. Slice-view + memcmp (zero-copy).
export fn StringBuilder @ends_with(suffix str) -> bool {
    ro sbytes = suffix.bytes()
    ro slen = sbytes.len()
    ro blen = @buf.len()
    slen <= blen && @buf[blen - slen..blen].compare(sbytes) == 0
}

// ─── Mutating (-> @) ───

// Append UTF-8 bytes из str. Zero-copy view (as_bytes).
export fn StringBuilder mut @append(s str) -> @ { @buf.append(s.bytes()) }

// Append codepoint как UTF-8 (1-4 байта). Fluent push chain (D181)
// + multi-line continuation (Plan 91 followup parser fix).
export fn StringBuilder mut @append(c char) -> @ {
    ro cp = c as int
    if cp < 0x80 {
        @buf.push(cp as u8)
    } else if cp < 0x800 {
        @buf.push((0xC0 | (cp >> 6)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        @buf.push((0xE0 | (cp >> 12)) as u8)
            .push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    } else {
        @buf.push((0xF0 | (cp >> 18)) as u8)
            .push((0x80 | ((cp >> 12) & 0x3F)) as u8)
            .push((0x80 | ((cp >> 6) & 0x3F)) as u8)
            .push((0x80 | (cp & 0x3F)) as u8)
    }
}

// Append raw []u8 bytes. Caller отвечает за UTF-8 validity.
export fn StringBuilder mut @append(arr []u8) -> @ { @buf.append(arr) }

// Plan 154.1 (D269): typed scalar overloads so `sb.append(x)` dispatches on
// the value's type uniformly — no `append_int`-style names, no caller-side
// `str.from`. Used by the primitive Display impls in std/prelude/protocols.nv
// (`fn int @display(mut sb StringBuilder) { sb.append(@) }`), and convenient
// for users directly. `bool` appends the literal "true"/"false" with no
// intermediate; `int`/`f64` route through `@to_str()` (bare-T blanket,
// `"${@}"` — same conv.h formatters the interp path uses), avoiding the temp
// StringBuilder an interp-string body would otherwise allocate.
// Параметр `x` (не `n`, 2026-07-17): это ЗНАЧЕНИЕ для форматирования,
// не count/index/len — прежнее имя `n` ложно матчило W_PARAM_NO_CONTRACT
// (линт по имени параметра, не по семантике); `requires n >= 0` было бы
// НЕВЕРНО (запрещало бы append отрицательных чисел). Rename на `x` —
// консистентно с f64/f32-сиблингами ниже — снимает false-positive.
export fn StringBuilder mut @append(x int) -> @ { @append(x.to_str()) }
export fn StringBuilder mut @append(x f64) -> @ { @append(x.to_str()) }
export fn StringBuilder mut @append(b bool) -> @ { if b { @append("true") } else { @append("false") } }
// Plan 154.1 [M-154.1-f32-display-debug] + Plan 180: f32 via `@to_str()` →
// the f32-precise shortest-round-trip formatter (nova_f32_to_str). Widening to
// f64 first would surface the f32→f64 mantissa tail now that f64's formatter is
// faithful (0.1f → "0.10000000149011612"); the direct f32 path keeps "0.1".
export fn StringBuilder mut @append(x f32) -> @ { @append(x.to_str()) }

// Append строку s ровно n раз. n <= 0 → no-op.
// Single reserve(total) → один realloc вместо n× амортизированного doubling.
// `bytes()` — zero-copy view; `append` в loop без indirection.
export fn StringBuilder mut @append_repeat(s str, n int) -> @
    requires n >= 0
{
    if n <= 0 { return }
    ro bytes = s.bytes()
    @buf.reserve(bytes.len() * n)
    for _ in 0..n {
        @buf.append(bytes)
    }
}

// Обрезать буфер до len байт. len >= @byte_len() → no-op. Caller отвечает за UTF-8 границы.
export fn StringBuilder mut @truncate(len int) -> @
    requires len >= 0
{ @buf.truncate(len) }

// Plan 152.7.1 (D374 AMEND, ex-D374) + Plan 208 Ф.2 (D422 §1, D374 AMEND
// ×2) — Write protocol implementation. `@write` now takes `[]u8` directly
// (was `str`) — delegates straight to `@buf.append`, one fewer indirection
// than the old `s.bytes()` unwrap. Returns () — satisfies Write contract.
export fn StringBuilder mut @write(bytes []u8) -> () { @buf.append(bytes) }

// ─── Consume ───

// Финализировать в str. После @into_str() StringBuilder consumed.
// Zero-copy steal: reuse @buf data ptr напрямую (writes '\0' in-place
// если cap > len, иначе alloc+copy fallback).
// Infallible: UTF-8 invariant поддерживается append-методами.
// Renamed as_str → into_str (Plan 91.18 Ф.2; D77: into_* = consuming).
// [M-174.1-into-str-unchecked-legacy-array-codegen-gap]: the zero-copy steal
// path (`@buf.into_str_unchecked()`) mis-codegens here — this file is
// `#no_prelude` (breaks the prelude→collections→string_builder cycle) and so
// `@buf` uses the LEGACY `NovaArray` representation (prelude.nv: "#no_prelude
// units keep the legacy NovaArray path"), for which the new consume-method
// dispatch doesn't wire correctly (generates a C body returning `int` instead
// of `nova_str` — CC-FAIL "assigning to 'nova_str' from incompatible type
// 'int'"). Falls back to the non-consuming copy path (`to_str_unchecked`)
// until that gap is closed under its own plan (see backlog-followups.md
// marker); correctness is unaffected, only the zero-copy-reuse optimization
// is foregone for this legacy-array call site.
export fn StringBuilder consume @into_str() -> str => unsafe { @buf.to_str_unchecked() }

// Checked twin of `@into_str()` — validates UTF-8 instead of assuming it
// (Plan 208 Ф.1, D422 §"into_str()"). Delegates to `[]u8 @to_str()`
// (std/runtime/string/core.nv).
export fn StringBuilder consume @into_str_checked() -> Result[str, Utf8Error] => @buf.to_str()

// ─── Plan 208 Ф.1 (D422/D179 amend) — buffer-primitive plumbing ───
//
// ADDITIVE: these five methods are new zero-copy/zero-alloc surface for the
// Ф.2 compiler rewrite (`emit_interpolated_str`/`emit_format_spec_value` onto
// `@display(mut f Fmt)`) to call into. Nothing existing above is touched or
// re-routed through them yet.

// Expose a pointer into (at least) `n` bytes of SPARE capacity beyond the
// current live length — the compiler-path zero-COPY digit-loop target (D422
// §1/§9: "top-level компилятор-путь... digit-loop прямо в sb.reserve()/
// sb.advance()"). The bytes at `[@byte_len(), @byte_len()+n)` are NOT yet
// live (`@byte_len()` unchanged) until a matching `@advance(n)` call — the
// caller's contract is to write at most `n` bytes starting at the returned
// pointer, then call `@advance` with the number actually written.
export fn StringBuilder mut @reserve(n int) -> *mut u8
    requires n >= 0
{
    @buf.reserve(n)
    @buf.ptr().offset(@buf.len())
}

// Commit `n` bytes of previously-`@reserve`d spare capacity to the live
// length — the second half of the zero-copy digit-loop protocol. Rebuilds
// `@buf` via the public `Vec[T].new(ptr, len, cap)` cross-type bridge
// (std/collections/vec/core.nv) since `data`/`len`/`cap` are `priv` to the
// `collections.vec` module — this is the sanctioned way to bump the live
// length after writing directly through the `@reserve`d pointer.
export fn StringBuilder mut @advance(n int) -> ()
    requires n >= 0 && n <= @buf.cap() - @buf.len()
{
    @buf = []u8.new(@buf.ptr(), @buf.len() + n, @buf.cap())
}

// UTF-8 codepoint count of a byte run (D422 §"width = кодпоинты") — counts
// non-continuation bytes (top two bits != 0b10), mirroring `conv.h`'s
// `nova_fmt_char_count`.
fn utf8_char_count(bytes []u8) -> int {
    mut n = 0
    for b in bytes {
        if (b & 0xC0) != 0x80 { n = n + 1 }
    }
    n
}

// UTF-8 byte-length (1..4) of a single codepoint's encoding.
fn char_utf8_len(c char) -> int {
    ro cp = c as int
    if cp < 0x80 { 1 } else if cp < 0x800 { 2 } else if cp < 0x10000 { 3 } else { 4 }
}

// Encode a single codepoint as UTF-8 into a 4-byte fixed array (unused
// trailing slots stay `0`; caller reads only the first `char_utf8_len(c)`
// bytes). Mirrors `StringBuilder.@append(c char)`'s own bit-shift encoding —
// duplicated (not shared) so `@pad_in_place` can write the encoded bytes
// directly into the main buffer via raw pointer instead of appending.
fn char_utf8_bytes(c char) -> [4]u8 {
    ro cp = c as int
    mut out [4]u8 = [0, 0, 0, 0]
    if cp < 0x80 {
        out[0] = cp as u8
    } else if cp < 0x800 {
        out[0] = (0xC0 | (cp >> 6)) as u8
        out[1] = (0x80 | (cp & 0x3F)) as u8
    } else if cp < 0x10000 {
        out[0] = (0xE0 | (cp >> 12)) as u8
        out[1] = (0x80 | ((cp >> 6) & 0x3F)) as u8
        out[2] = (0x80 | (cp & 0x3F)) as u8
    } else {
        out[0] = (0xF0 | (cp >> 18)) as u8
        out[1] = (0x80 | ((cp >> 12) & 0x3F)) as u8
        out[2] = (0x80 | ((cp >> 6) & 0x3F)) as u8
        out[3] = (0x80 | (cp & 0x3F)) as u8
    }
    out
}

// Known-length primitive/str write with width/align/fill padding, WITHOUT a
// shift (D422 §4 "известная длина... write_padded... без сдвига"): `bytes`
// has not been written to the main buffer yet, so the fill run and the
// content can just be appended in the right order directly.
export fn StringBuilder mut @write_padded(bytes []u8, width int, fill char, align Align) -> ()
    requires width >= 0
{
    ro content_chars = utf8_char_count(bytes)
    ro pad_chars = if width > content_chars { width - content_chars } else { 0 }
    match align {
        Align.Left => {
            @append(bytes)
            mut k = 0
            while k < pad_chars { @append(fill); k = k + 1 }
        }
        Align.Right => {
            mut k = 0
            while k < pad_chars { @append(fill); k = k + 1 }
            @append(bytes)
        }
        Align.Center => {
            ro left = pad_chars / 2
            ro right = pad_chars - left
            mut k1 = 0
            while k1 < left { @append(fill); k1 = k1 + 1 }
            @append(bytes)
            mut k2 = 0
            while k2 < right { @append(fill); k2 = k2 + 1 }
        }
    }
}

// Streaming-composite width padding (D422 §4 "pad_in_place"): the body
// starting at byte offset `mark` has ALREADY been streamed into the main
// buffer (its length was not known ahead of the render — record/tuple/Vec/
// sum composites), so reaching `width` codepoints (when short) means
// memmove-ing that body and splicing in `fill` — right/center shift the body
// right via an overlap-safe `RawMem.copy` (memmove, not memcpy); left just
// appends trailing fill (the body is already correctly positioned).
export fn StringBuilder mut @pad_in_place(mark int, width int, fill char, align Align) -> ()
    requires mark >= 0 && mark <= @byte_len() && width >= 0
{
    ro end = @byte_len()
    ro content_len = end - mark
    mut content_chars = 0
    mut i = mark
    while i < end {
        if (@buf[i] & 0xC0) != 0x80 { content_chars = content_chars + 1 }
        i = i + 1
    }
    if content_chars >= width { return }
    ro pad_chars = width - content_chars

    mut left_chars = 0
    mut right_chars = 0
    match align {
        Align.Left   => { right_chars = pad_chars }
        Align.Right  => { left_chars = pad_chars }
        Align.Center => { left_chars = pad_chars / 2; right_chars = pad_chars - left_chars }
    }

    if left_chars > 0 {
        ro fill_len = char_utf8_len(fill)
        ro fill_bytes = char_utf8_bytes(fill)
        ro left_bytes = left_chars * fill_len
        @buf.reserve(left_bytes)
        unsafe {
            // memmove (overlap-safe) the existing tail right by `left_bytes`.
            RawMem.copy(@buf.ptr().offset(mark) as *u8, @buf.ptr().offset(mark + left_bytes) as *mut u8, content_len)
            mut pos = mark
            mut c = 0
            while c < left_chars {
                mut b = 0
                while b < fill_len {
                    @buf.ptr().write_at(pos, fill_bytes[b])
                    pos = pos + 1
                    b = b + 1
                }
                c = c + 1
            }
        }
        @buf = []u8.new(@buf.ptr(), end + left_bytes, @buf.cap())
    }

    mut k = 0
    while k < right_chars { @append(fill); k = k + 1 }
}
