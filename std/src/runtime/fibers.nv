// std/runtime/fibers.nv — Fiber arena introspection API (Plan 44.2 Этап 3).
//
// **NOT auto-gen.** Этот модуль документирует hard-coded namespace `fibers.*`
// который dispatched через [compiler-codegen/src/codegen/emit_c.rs]
// special-cases (как `gc.*` в Plan 32).
//
// `fibers` — lowercase namespace, аналогично `gc.*`:
//   - Go:     `runtime.Stack(buf, all)`, `runtime.NumGoroutine()`
//   - Java:   `Thread.activeCount()`
//
// Использование:
//
//   import std.runtime.fibers as fibers
//
//   let v = fibers.virtual_reserved()  // bytes reserved via mmap
//   let s = fibers.slot_count()         // total slots
//   let a = fibers.slots_active()       // currently allocated slots
//   let h = fibers.high_water()         // peak concurrent slots
//
// **Semantics per platform:**
//
// | API                | Linux/macOS                    | Windows           |
// |--------------------|--------------------------------|-------------------|
// | virtual_reserved() | mmap reserved bytes per thread | 0 (arena off)     |
// | slot_count()       | total slot count (4096 × 2MB)  | 0 (arena off)     |
// | slots_active()     | currently allocated slots      | 0 (arena off)     |
// | high_water()       | peak concurrent slots          | 0 (arena off)     |
//
// На Windows fiber stacks идут через calloc-путь (см. Plan 42+); arena
// не активна, поэтому всё возвращает 0 как «honest sentinel» — тесты
// могут использовать `if fibers.slot_count() == 0 { ... skip ... }`.
//
// ──────────────────────────────────────────────────────────────────────────
// Источник истины для type-checker'а И codegen
// ──────────────────────────────────────────────────────────────────────────
//
// Эти `external fn` объявления — **единственный source of truth**, и для
// type-checker'а (обычный `import`), и для codegen: c-имя
// (`nova_fibers_*`) приходит через `ExternalRegistry::NAMESPACE_OVERRIDES`
// (compiler-codegen/src/codegen/external_registry.rs) — этот файл
// embedded builtin source, ручной синхронизации с emit_c.rs больше не
// требуется ([M-compiler-nv-porting-wave] item B1, 2026-07-07).

module runtime.fibers

// ─── fibers namespace ───────────────────────────────────────────────────

/// Bytes reserved via `mmap` for the per-thread fiber arena (Linux/macOS).
///
/// Reflects the total virtual address space reserved for fiber stacks.
/// On Windows always `0` — the arena is inactive, stacks go through the calloc path.
///
/// # See Also
///
/// - `[fibers.slot_count]` — number of slots
/// - `[fibers.compact]` — force returning physical pages
#stable(since = "0.1")
export extern "nova" fn fibers.virtual_reserved() -> int

/// Total number of slots in the fiber arena (slot = 1 fiber stack).
///
/// On Linux/macOS: 4096 × 2MB = 8GB virtual reserved per thread (lazily committed).
/// Returns `0` on Windows.
///
/// # See Also
///
/// - `[fibers.slots_active]` — how many are currently in use
/// - `[fibers.high_water]` — the peak value
#stable(since = "0.1")
export extern "nova" fn fibers.slot_count() -> int

/// The number of currently-allocated slots (active fibers).
///
/// Slots are released after fiber termination and can be reused.
/// If `slots_active` is close to `slot_count` — the workload is approaching the arena limit.
/// Returns `0` on Windows.
///
/// # See Also
///
/// - `[fibers.high_water]` — peak concurrent slots
#stable(since = "0.1")
export extern "nova" fn fibers.slots_active() -> int

/// Peak concurrent slot count since process start.
///
/// Useful for capacity planning: if `high_water` is close to `slot_count` —
/// the workload briefly approached the arena limit. Returns `0` on Windows.
///
/// # See Also
///
/// - `[fibers.slot_count]` — total arena capacity
/// - `[fibers.slots_active]` — current value
#stable(since = "0.1")
export extern "nova" fn fibers.high_water() -> int

/// Forcefully return the physical pages of all free slots to the OS.
///
/// Executes `MADV_DONTNEED` on each contiguous run of free slots.
/// Useful for long-running workloads without a natural idle window, where
/// the arena does not reach the automatic decay threshold.
///
/// Auto-decay: the runtime does this automatically when `slots_active == 0`.
/// Call manually only if there is no such idle window.
///
/// On Windows: no-op (no arena).
///
/// # Effects
///
/// A `madvise`/`MADV_DONTNEED` system call on Linux/macOS.
#stable(since = "0.1")
export extern "nova" fn fibers.compact() -> ()
