#no_prelude
module runtime.fmt_buf
import std.prelude.core.{Option, Some, None, Result, Ok, Err}
import std.runtime.numeric
import std.runtime.string
import std.runtime.float_parse

// Дифференциал плана 285 Ф.1: НАШ производитель кратчайшей записи против
// существующего `nova_f64_shortest` (через `f64_fmt`, `kind 0`).
//
// ЗАЧЕМ ДИФФЕРЕНЦИАЛ, А НЕ ROUND-TRIP. Round-trip уже есть
// (`roundtrip_test.nv`), и он проверяет ДРУГОЕ: что напечатанное читается обратно
// тем же числом. Этого мало — так проходит и запись `1E-1` вместо `0.1`: биты те
// же, байты другие. Здесь сверяются именно БАЙТЫ, потому что поверхность уже
// обещана всем golden-выводам в дереве, интерполяции и JSON.
//
// ЧТО ЗДЕСЬ ЭТАЛОН. Эталон — старый C-хелпер, и это НЕ значит, что он верен: он
// дорог (до одиннадцати печатей и разборов на значение) и потому подлежит замене.
// Он значит ровно одно — поверхность не должна поехать в тот момент, когда меняется
// производитель цифр. Когда Ф.3 переключит `f64_fmt` на наш код, этот файл
// становится регрессией против самого себя, и его эталон уходит вместе с libc.

// Печать нашим производителем.
fn ours(v f64) -> []u8 {
    mut buf = []u8.new(cap: 64)
    ro n = f64_shortest_fmt(v, buf.ptr(), 64)
    mut out = []u8.new(cap: 64)
    // ДЛИНА ОГРАНИЧИВАЕТСЯ БУФЕРОМ, и это не перестраховка: производитель
    // возвращает НУЖНУЮ длину, которая может ПРЕВЫШАТЬ `cap`. Проба приёмки
    // Ф.2 (сломанная константа) дала абсурдную длину — и помощник, веривший ей
    // на слово, ушёл в SEGV вместо честного отказа теста.
    for i in 0..n.min(64) {
        out.push(unsafe { buf.ptr().read_at(i) })
    }
    out
}

// Эталон сверки — C-хелперы, вызываемые НАПРЯМУЮ, а не через `f64_fmt`/`f32_fmt`.
//
// ПОЧЕМУ НАПРЯМУЮ, и это не педантизм. До Ф.3 `f64_fmt` с `kind 0` делегировал в
// `nova_f64_shortest`, и звать эталон через обёртку было тем же самым. Ф.3
// переключает обёртку на НАШ производитель — и в тот же миг дифференциал, зовущий
// эталон через неё, начал бы сравнивать наш код САМ С СОБОЙ и остался бы вечно
// зелёным. Тест, переставший проверять, выглядит точно как тест, который проверяет.
// Прямая дверь к хелперу делает эталон независимым от того, что делает обёртка.
extern "C" fn nova_f64_shortest(v f64, buf *mut u8) -> int
extern "C" fn nova_f32_shortest(v f32, buf *mut u8) -> int

fn theirs(v f64) -> []u8 {
    mut buf = []u8.new(cap: 64)
    ro n = unsafe { nova_f64_shortest(v, buf.ptr()) }
    mut out = []u8.new(cap: 64)
    // ДЛИНА ОГРАНИЧИВАЕТСЯ БУФЕРОМ, и это не перестраховка: производитель
    // возвращает НУЖНУЮ длину, которая может ПРЕВЫШАТЬ `cap`. Проба приёмки
    // Ф.2 (сломанная константа) дала абсурдную длину — и помощник, веривший ей
    // на слово, ушёл в SEGV вместо честного отказа теста.
    for i in 0..n.min(64) {
        out.push(unsafe { buf.ptr().read_at(i) })
    }
    out
}

fn same(a []u8, b []u8) -> bool {
    if a.len() != b.len() { return false }
    mut i = 0
    while i < a.len() {
        if a[i] != b[i] { return false }
        i += 1
    }
    true
}

// Детерминированный xorshift64: зерно названо в тесте, поэтому красный случай
// воспроизводится точно, а не «иногда». Своя реализация здесь дешевле, чем
// зависимость: три сдвига и три XOR, без единого умножения.
fn next_bits(state u64) -> u64 {
    mut x = state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    x
}

// ─── Ф.2: то же для `f32` ───
//
// Эталон другой и уже: `f32_fmt` не берёт ни `kind`, ни `prec` — у него один вид,
// Shortest. Значит дифференциал для `f32` сверяет ровно ту поверхность, которая
// сегодня единственная.

fn ours32(v f32) -> []u8 {
    mut buf = []u8.new(cap: 64)
    ro n = f32_shortest_fmt(v, buf.ptr(), 64)
    mut out = []u8.new(cap: 64)
    // ДЛИНА ОГРАНИЧИВАЕТСЯ БУФЕРОМ, и это не перестраховка: производитель
    // возвращает НУЖНУЮ длину, которая может ПРЕВЫШАТЬ `cap`. Проба приёмки
    // Ф.2 (сломанная константа) дала абсурдную длину — и помощник, веривший ей
    // на слово, ушёл в SEGV вместо честного отказа теста.
    for i in 0..n.min(64) {
        out.push(unsafe { buf.ptr().read_at(i) })
    }
    out
}

fn theirs32(v f32) -> []u8 {
    mut buf = []u8.new(cap: 64)
    ro n = unsafe { nova_f32_shortest(v, buf.ptr()) }
    mut out = []u8.new(cap: 64)
    // ДЛИНА ОГРАНИЧИВАЕТСЯ БУФЕРОМ, и это не перестраховка: производитель
    // возвращает НУЖНУЮ длину, которая может ПРЕВЫШАТЬ `cap`. Проба приёмки
    // Ф.2 (сломанная константа) дала абсурдную длину — и помощник, веривший ей
    // на слово, ушёл в SEGV вместо честного отказа теста.
    for i in 0..n.min(64) {
        out.push(unsafe { buf.ptr().read_at(i) })
    }
    out
}

fn next_bits32(state u32) -> u32 {
    mut x = state
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    x
}

test "285 F.2: дифференциал f32 на классах и на границе выкладки" {
    ro cases = []f32.of(
        0.0, 1.0, 0.5, 2.5, 0.1, 0.2, 0.3,
        100000.0, 1000000.0, 1230000.0, 1234567.0, 999999.0, 12345670.0,
        123456.7, 0.000123, 1.0e-5, 1.0e-4, 1.0e20,
        3.4028235e38, 3.1415927, 2.7182817,
    )
    mut i = 0
    while i < cases.len() {
        ro v = cases[i]
        assert(same(ours32(v), theirs32(v)), "байты f32 обязаны совпасть с C-хелпером")
        i += 1
    }
    // Отрицательные стоят ОТДЕЛЬНО, а не в списке: унарный минус делает
    // элемент ВЫРАЖЕНИЕМ, а не литералом, и неявное сужение f64->f32
    // запрещено (D44/D54, `E_ARRAY_ELEM_NARROW`). Минус-ноль важен: у него
    // другие биты, и знак обязан дойти до печати.
    ro neg_zero = -(0.0 as f32)
    ro neg_one = -(1.0 as f32)
    assert(same(ours32(neg_zero), theirs32(neg_zero)), "байты f32 на минус-нуле")
    assert(same(ours32(neg_one), theirs32(neg_one)), "байты f32 на минус-единице")
}

test "285 F.2: дифференциал f32 на 10 000 случайных из названного зерна" {
    mut state = 0x2853F1EA as u32
    mut checked = 0
    mut i = 0
    while i < 10000 {
        state = next_bits32(state)
        ro v = f32.from_bits(state)
        // Субнормали пропускаются НАМЕРЕННО: там расхождение известное и
        // перечислено отдельным тестом ниже, ровно как у `f64`.
        if v == v && v - v == 0.0 && (v == 0.0 || v > 1.2e-38 || v < -1.2e-38) {
            assert(same(ours32(v), theirs32(v)), "байты f32 разошлись на случайном значении")
            checked += 1
        }
        i += 1
    }
    assert(checked > 9000, "случайных нормальных f32 должно быть подавляющее большинство")
}

test "285 F.2: субнормали f32 — расхождение ПО ЗАМЫСЛУ, тот же класс, что у f64" {
    // ЗАМЕР 2026-09-13: 59 786 значений, ЧЕТЫРЕ расхождения, и все четыре
    // субнормальные. Причина та же, что у `f64`: хелпер берёт первую точность,
    // что читается обратно, начиная с `%g` — шести значащих цифр ТОЧНОГО
    // двоичного значения, — а у субнормали с малой мантиссой хвостовые нули не
    // появляются. По контракту `FloatKind.Shortest` (spec/decisions/02-types.md)
    // мы обязаны печатать кратчайшее, значит расхождение — ДЕФЕКТ ХЕЛПЕРА.
    ro v = 1.4e-45 as f32
    assert(!same(ours32(v), theirs32(v)), "ожидается ИЗВЕСТНОЕ расхождение на субнормали f32")
    // Неизменно другое: наша запись обязана читаться обратно в то же значение.
    match ours32(v).to_str() {
        Ok(s) => match s.to_f32() {
            Ok(parsed) => assert(parsed.to_bits() == v.to_bits(), "наша запись субнормали f32 обязана читаться обратно")
            Err(_) => assert(false, "наша запись субнормали f32 не разобралась")
        }
        Err(_) => assert(false, "наша запись субнормали f32 не UTF-8")
    }
}

test "285 F.1: дифференциал на границе, где D и порядок по разные стороны шести" {
    // Эти значения выбраны ЗАМЕРОМ, а не вкусом: правило `%g` меняет форму записи
    // ровно здесь, и дифференциал без них зелёный и слепой к той самой границе,
    // на которой донорский `to_chars` разошёлся бы с нашей поверхностью.
    ro cases = []f64.of(
        1230000.0, 1234567.0, 999999.0, 1000000.0, 10000000.0, 12345670.0,
        123456.7, 0.000123, 0.0000123, 0.0001, 0.00001,
        1.0e20, 1.0e21, 1.0e-5, 1.0e-4,
    )
    mut i = 0
    while i < cases.len() {
        ro v = cases[i]
        assert(same(ours(v), theirs(v)), "байты обязаны совпасть с C-хелпером на границе %g")
        i += 1
    }
}

test "285 F.1: дифференциал на классах, которые ломали прежний путь" {
    ro cases = []f64.of(
        0.0, -0.0, 1.0, -1.0, 0.5, 2.5, 0.1, 0.2, 0.3,
        3.141592653589793, 2.718281828459045,
        1234567.89, 1.7976931348623157e308,
        123456789012345.6, 9.007199254740993e15,
        100000.0, 0.000001,
    )
    // `5.0e-324` НАМЕРЕННО не здесь: на нём байты расходятся ПО ЗАМЫСЛУ, и это
    // отдельный тест ниже. Держать его в общем списке значило бы либо красный
    // без причины, либо тихое ослабление проверки под известное исключение.
    mut i = 0
    while i < cases.len() {
        ro v = cases[i]
        assert(same(ours(v), theirs(v)), "байты обязаны совпасть с C-хелпером")
        i += 1
    }
}

test "285 F.1: КОНТРОЛЬ — сверка байтов действительно умеет краснеть" {
    // Без этого случая два зелёных выше не доказывают, что `same` вообще что-то
    // сравнивает. Здесь берутся два ЗАВЕДОМО разных вывода — печать одного
    // значения и печать другого, — и требуется РАСХОЖДЕНИЕ.
    assert(!same(ours(0.1), theirs(0.2)), "сверка обязана видеть разницу")
    assert(same(ours(0.1), theirs(0.1)), "и обязана видеть совпадение")
}

test "285 F.1: дифференциал на 10 000 случайных f64 из названного зерна" {
    // Зерно названо в тесте: красный случай воспроизводится точно.
    mut state = 0x2853F1EA7C0DE001 as u64
    mut checked = 0
    mut i = 0
    while i < 10000 {
        state = next_bits(state)
        ro v = f64.from_bits(state)
        // Не-конечные пропускаются НАМЕРЕННО и судятся отдельным тестом ниже:
        // написание NaN со знаком у разных библиотек разное, и смешивать открытый
        // вопрос со сверкой конечных значений — это прятать его в общий зелёный.
        if v == v && v - v == 0.0 {
            assert(same(ours(v), theirs(v)), "байты разошлись на случайном f64")
            checked += 1
        }
        i += 1
    }
    // Замер обязан назвать, СКОЛЬКО он на самом деле проверил: «10 000 итераций»
    // и «10 000 сверок» — разные числа, и вторая цифра здесь та, что важна.
    assert(checked > 9000, "случайных конечных значений должно быть подавляющее большинство")
}

test "285 F.1: субнормали с малой мантиссой — расхождение ПО ЗАМЫСЛУ, перечисленное" {
    // НАЙДЕНО ЗАМЕРОМ 2026-09-09, 20:49, до всякого прогона на машине: 0 расхождений
    // на 200 000 случайных `f64` и 3871 из 4000 в нижней субнормальной ленте.
    //
    // ПОЧЕМУ ТАК, и почему это не дефект порта. Старый хелпер берёт ПЕРВУЮ точность,
    // что читается обратно, а начинает с `%g`, то есть с ШЕСТИ значащих цифр точного
    // двоичного значения. Обычно это и есть кратчайшая запись с нулями на хвосте —
    // но у субнормали с малой мантиссой двоичная величина далеко от короткой десятичной
    // (у наименьшей — на 1.2 %), и шесть цифр не сокращаются. Хелпер печатает
    // `4.94066e-324` там, где кратчайшая запись есть `5e-324`.
    //
    // ЭТО ДЕФЕКТ ХЕЛПЕРА, А НЕ НАША ВОЛЬНОСТЬ, и решено это спекой, а не вкусом:
    // `spec/decisions/02-types.md:17943` объявляет `f64_fmt(..., kind FloatKind =
    // FloatKind.Shortest, ...)`, а `:17959` — сам вид `FloatKind enum Shortest | Fixed
    // | Sci`. `Shortest` есть ИМЯ ВИДА, то есть контракт; функция, объявленная печатающей
    // кратчайшее и печатающая в этой ленте шестизначное, контракт НЕ ИСПОЛНЯЕТ. Наш
    // производитель не отступает от поверхности — он начинает исполнять её там, где она
    // не исполнялась, и спек-амендмент потому не нужен: менять нечего, `Shortest` уже
    // записан. (Решение интегратора 2026-09-09 20:57, спека сверена мной по строкам выше.)
    //
    // Воспроизвести старое байт-в-байт означало бы завести ВТОРОЙ алгоритм — печать с
    // ЗАДАННОЙ точностью (`d2fixed` донора): шестизначную запись из кратчайших цифр не
    // вывести, её надо породить. Это против приёмки Ф.1 («один проход») и удваивает порт
    // ради ленты, куда не попало ни одно из 200 000 случайных значений.
    ro v = 5.0e-324
    assert(!same(ours(v), theirs(v)), "ожидается ИЗВЕСТНОЕ расхождение; совпало — значит поменялся хелпер, и решение надо пересмотреть")
    // Обе записи обязаны читаться обратно в ТО ЖЕ значение — вот что здесь неизменно.
    match ours(v).to_str() {
        Ok(s) => match s.to_f64() {
            Ok(parsed) => assert(parsed.to_bits() == v.to_bits(), "наша запись субнормали обязана читаться обратно")
            Err(_) => assert(false, "наша запись субнормали не разобралась")
        }
        Err(_) => assert(false, "наша запись субнормали не UTF-8")
    }
}

test "285 F.1: не-конечные значения — открытый вопрос, заданный ЯВНО" {
    // Бесконечности однозначны у любой библиотеки.
    assert(same(ours(1.0 / 0.0), theirs(1.0 / 0.0)), "inf")
    assert(same(ours(-1.0 / 0.0), theirs(-1.0 / 0.0)), "-inf")
    // NaN: наша ветка печатает без знака, и это ПРЕДПОЛОЖЕНИЕ, а не знание.
    // Если тест покраснеет — ответ получен, и меняется ветка печати особых
    // значений, а не производитель цифр.
    ro nan = 0.0 / 0.0
    assert(same(ours(nan), theirs(nan)), "написание NaN разошлось с C-библиотекой")
}
