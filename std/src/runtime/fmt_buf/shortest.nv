// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Co-equal file of module `runtime.fmt_buf` (folder = one module).
// Role: the shortest round-trip producer behind `f64_fmt`/`f32_fmt` with
// `FloatKind.Shortest` -- the digits, not the surface. Width, fill, sign and the
// `${x}` mini-language stay where they are (D422 §5); what changes is only who
// produces the digits.
//
// STATE (plan 285): Ф.1 in progress. What is here is the DIGIT PRODUCER --
// the donor's `d2d`, its small-integer fast path and the helpers they need.
// Nothing calls it yet: `f64_fmt` still goes to the C helper
// `nova_f64_shortest`, and the switch-over is Ф.3, after the differential in
// Ф.1 has judged this code against it.
//
// Provenance. Ported from Ryu -- Ulf Adams, "Ryu: fast float-to-string
// conversion" (PLDI 2018) -- taken from https://github.com/ulfjack/ryu at commit
// 4c0618b0e44f7ef027ebae05d2cc7812048f7c8f (2026-02-09, master; read through the
// GitHub API on 2026-09-09, the sources are NOT vendored into this tree). Donor
// files: `ryu/d2s.c`, `ryu/d2s_intrinsics.h`, `ryu/common.h`, with the tables in
// `ryu/d2s_full_table.h` moved mechanically into the peer `pow5_split_table.nv`.
// Each function below names the donor function it carries.
//
// Licence of the donor: dual, at the user's choice -- Apache License 2.0 OR Boost
// Software License 1.0, "Copyright 2018 Ulf Adams" (the notice is quoted from
// `ryu/d2s.c` at the commit above, not from memory). Both texts are vendored:
// `THIRD_PARTY/ryu-LICENSE` (Apache 2.0) and `THIRD_PARTY/ryu-LICENSE-Boost`;
// the entry is number 6 in `THIRD_PARTY/README.md`. Nova code is
// `MIT OR Apache-2.0`, so the Apache branch of the donor's choice is the one
// that composes.
//
// WHY Ryu AND NOT THE DONOR OF THE PARSE SIDE (plan 283's `core::num::imp::dec2flt`).
// Decided by the integrator on 2026-09-09 and VERIFIED BY THE DONOR'S OWN CODE, as
// he required, before this file was written: the Rust printing side is a two-path
// algorithm with a fallback, which is exactly what plan 285 Ф.1's acceptance
// ("no check loop") rules out. Its module documentation
// (`library/core/src/num/imp/flt2dec/mod.rs`, read 2026-09-09) says so in one
// sentence: "They are total for all finite `f32` and `f64` inputs (Grisu internally
// falls back to Dragon if necessary)" -- `strategy::grisu` and `strategy::dragon`
// are both there, and both are `format_shortest`. Ryu is single-pass by
// construction, so the choice rests on the donor's structure, not on taste.
//
// WHAT IS DELIBERATELY *NOT* PORTED, and this is the most expensive thing in the
// phase. The donor's `to_chars` prints ALWAYS in scientific notation: `0.1` comes
// out of it as `1E-1`, `100000` as `1E5`, and its `copy_special_str` writes `NaN`,
// `Infinity`, `0E0`. Our surface is different and already promised: the C helper
// `nova_f64_shortest` renders by `%g` rules. A verbatim port of `to_chars` would
// therefore PASS the round-trip acceptance and break every golden output, the
// `${x}` interpolation and JSON -- same bits, different bytes. So only the digits
// and the decimal exponent come from the donor; the byte assembly is ours and
// arrives with the rest of Ф.1.
//
// The naming follows `docs/dev/nv-coding-style.md`; the algorithm, control flow,
// constants and the comments that justify each rounding decision are kept from the
// donor, as in `runtime/float_parse/convert.nv`.

#no_prelude
module runtime.fmt_buf

import std.prelude.core.{Option, Some, None}
import std.runtime.numeric

// Donor: the `DOUBLE_*` defines at the top of `ryu/d2s.c`.
const DOUBLE_MANTISSA_BITS = 52
const DOUBLE_EXPONENT_BITS = 11
const DOUBLE_BIAS = 1023

/// A decimal `mantissa * 10^exponent` -- the donor's `floating_decimal_64`.
///
/// The decimal exponent's range is -324 to 308 inclusive, so `int` is wider than
/// it needs to be; the donor stores it in `int32_t` for cache reasons that do not
/// apply to a value returned by register.
type FloatingDecimal64(mantissa u64 = 0, exponent int = 0)

// ─── Integer logarithms (donor: `ryu/common.h`) ───
//
// These are integer APPROXIMATIONS with a stated range of validity, not general
// logarithms, and the ranges are the donor's own: outside them the multiplication
// overflows 32 bits and the answer is silently wrong. Our `int` is 64-bit, so the
// overflow cannot happen here -- which removes the donor's failure mode rather
// than hiding it. Every caller below stays inside the donor's ranges anyway.

/// `e == 0 ? 1 : floor(log_2(5^e))`; donor requires `0 <= e <= 3528`.
fn log2_pow5(e int) -> int => (e * 1217359) >> 19

/// `e == 0 ? 1 : ceil(log_2(5^e))`; donor requires `0 <= e <= 3528`.
fn pow5_bits(e int) -> int => log2_pow5(e) + 1

/// `floor(log_10(2^e))`; donor requires `0 <= e <= 1650`.
fn log10_pow2(e int) -> int => (e * 78913) >> 18

/// `floor(log_10(5^e))`; donor requires `0 <= e <= 2620`.
fn log10_pow5(e int) -> int => (e * 732923) >> 20

// ─── Small divisions (donor: `ryu/d2s_intrinsics.h`) ───
//
// The donor has two spellings of each: a plain division and a multiply-high trick
// for platforms whose compiler will not do it. We take the plain one. Whether the
// trick pays for itself here is a QUESTION FOR A MEASUREMENT (plan 285 Ф.5), not
// for a port: copying an optimisation across a language boundary on the donor's
// authority is how unmeasured complexity gets in.

fn div5(x u64) -> u64 => x / 5
fn div10(x u64) -> u64 => x / 10
fn div100(x u64) -> u64 => x / 100
fn div1e8(x u64) -> u64 => x / 100000000

/// Number of times 5 divides `value`; donor `pow5Factor`, `value != 0`.
///
/// The multiplication is modulo 2^64 BY DESIGN -- `m_inv_5` is the inverse of 5 in
/// that ring, so multiplying by it rotates the factors of five out one at a time.
/// Hence `wrapping_mul` and not `*`: in Nova a plain `*` traps on overflow, and
/// here the overflow IS the algorithm.
fn pow5_factor(value_in u64) -> int {
    ro m_inv_5 = 14757395258967641293 as u64   // 5 * m_inv_5 = 1 (mod 2^64)
    ro n_div_5 = 3689348814741910323 as u64    // 2^64 / 5
    mut value = value_in
    mut count = 0
    while true {
        value = value.wrapping_mul(m_inv_5)
        if value > n_div_5 { break }
        count += 1
    }
    count
}

/// Donor `multipleOfPowerOf5`: is `value` divisible by `5^p`?
fn multiple_of_power_of_5(value u64, p int) -> bool => pow5_factor(value) >= p

/// Donor `multipleOfPowerOf2`: is `value` divisible by `2^p`? Requires `p < 64`.
fn multiple_of_power_of_2(value u64, p int) -> bool => (value & ((1 as u64 << p) - 1)) == 0

// ─── The 128-bit multiply-and-shift (donor: `ryu/d2s_intrinsics.h`) ───

/// Donor `shiftright128`: the high 64 bits of a 128-bit `(hi, lo)` shifted right.
///
/// Precondition, the donor's own and asserted there: `0 < dist < 64`. It matters:
/// at `dist == 0` the expression would shift a `u64` by its full width, which is
/// not the identity anybody expects. In the full-table double path the donor
/// states the range is [49, 58], so the precondition holds by construction rather
/// than by hope.
fn shift_right_128(lo u64, hi u64, dist int) -> u64 => (hi << (64 - dist)) | (lo >> dist)

/// Donor `mulShift64`: `(m * mul) >> j`, where `mul` is the 128-bit table entry
/// split as `(lo, hi)` -- column 0 of the donor's table carries weight 2^0 and
/// column 1 weight 2^64, read from the donor's own `mulShift64`.
fn mul_shift_64(m u64, mul_lo u64, mul_hi u64, j int) -> u64 {
    ro (b0_hi, _b0_lo) = m.widening_mul(mul_lo)
    ro (b2_hi, b2_lo) = m.widening_mul(mul_hi)
    // The sum of the two partial products can carry into the high word; the
    // comparison IS the carry flag, as in the donor.
    ro sum = b0_hi.wrapping_add(b2_lo)
    mut high = b2_hi
    if sum < b0_hi { high += 1 }
    shift_right_128(sum, high, j - 64)
}

/// Donor `mulShiftAll64`: the same product for the three interval bounds at once,
/// returned as `(vr, vp, vm)`.
///
/// The donor keeps a commented-out fused version next to this one; we take the
/// three-call spelling it actually compiles, for the same reason as the divisions
/// above -- the fused one is an optimisation to be measured, not inherited.
fn mul_shift_all_64(m u64, mul_lo u64, mul_hi u64, j int, mm_shift int) -> (u64, u64, u64) {
    // `4 * m` cannot overflow: `m` is at most 2^53 here, so the plain arithmetic
    // (which traps in Nova) doubles as an assertion of that bound.
    ro vr = mul_shift_64(4 * m, mul_lo, mul_hi, j)
    ro vp = mul_shift_64(4 * m + 2, mul_lo, mul_hi, j)
    ro vm = mul_shift_64(4 * m - 1 - (mm_shift as u64), mul_lo, mul_hi, j)
    (vr, vp, vm)
}

// ─── Decimal length (donor: `decimalLength17` in `ryu/d2s.c`) ───

/// Number of decimal digits in `v`, which must have at most 17 of them.
///
/// A chain of comparisons and not a loop, high-to-low, because the average output
/// length is 16.38 digits -- the donor's measurement, kept with its reasoning.
fn decimal_length17(v u64) -> int {
    if v >= 10000000000000000 { return 17 }
    if v >= 1000000000000000 { return 16 }
    if v >= 100000000000000 { return 15 }
    if v >= 10000000000000 { return 14 }
    if v >= 1000000000000 { return 13 }
    if v >= 100000000000 { return 12 }
    if v >= 10000000000 { return 11 }
    if v >= 1000000000 { return 10 }
    if v >= 100000000 { return 9 }
    if v >= 10000000 { return 8 }
    if v >= 1000000 { return 7 }
    if v >= 100000 { return 6 }
    if v >= 10000 { return 5 }
    if v >= 1000 { return 4 }
    if v >= 100 { return 3 }
    if v >= 10 { return 2 }
    1
}

// ─── The small-integer fast path (donor: `d2d_small_int`) ───

/// Values that are integers in `[1, 2^53)`: their shortest decimal is exact and
/// needs none of the interval machinery. `None` means "not such a value".
fn d2d_small_int(ieee_mantissa u64, ieee_exponent int) -> Option[FloatingDecimal64] {
    ro m2 = (1 as u64 << DOUBLE_MANTISSA_BITS) | ieee_mantissa
    ro e2 = ieee_exponent - DOUBLE_BIAS - DOUBLE_MANTISSA_BITS

    // f = m2 * 2^e2 >= 2^53 is an integer, but not one this path handles.
    if e2 > 0 { return None }
    // f < 1.
    if e2 < -52 { return None }

    // Since 2^52 <= m2 < 2^53 and 0 <= -e2 <= 52: 1 <= f = m2 / 2^-e2 < 2^53.
    // Test whether the low -e2 bits of the significand are zero, i.e. whether the
    // fractional part is zero.
    ro mask = (1 as u64 << (-e2)) - 1
    if (m2 & mask) != 0 { return None }

    // Note: the mantissa may still carry trailing DECIMAL zeros; the caller moves
    // them into the exponent, because whether they belong there depends on the
    // notation being printed.
    Some(FloatingDecimal64(m2 >> (-e2), 0))
}

// ─── The producer (donor: `d2d`) ───

/// Shortest decimal `(mantissa, exponent)` whose round-trip is the same `f64`.
///
/// Steps are the donor's, and so are the numbers: step 2 builds the interval of
/// values that read back as this one, step 3 moves it to a decimal power base with
/// the 128-bit tables, step 4 shortens inside the interval.
fn d2d(ieee_mantissa u64, ieee_exponent int) -> FloatingDecimal64 {
    mut e2 = 0
    mut m2 = 0 as u64
    if ieee_exponent == 0 {
        // Subnormal. The 2 is subtracted so that the bounds computation below has
        // two extra bits to work in.
        e2 = 1 - DOUBLE_BIAS - DOUBLE_MANTISSA_BITS - 2
        m2 = ieee_mantissa
    } else {
        e2 = ieee_exponent - DOUBLE_BIAS - DOUBLE_MANTISSA_BITS - 2
        m2 = (1 as u64 << DOUBLE_MANTISSA_BITS) | ieee_mantissa
    }
    ro even = (m2 & 1) == 0
    ro accept_bounds = even

    // Step 2: the interval of valid decimal representations.
    ro mv = 4 * m2
    // The donor relies on the implicit bool -> int conversion here; Nova has none,
    // so the two cases are written out.
    ro mm_shift = if ieee_mantissa != 0 || ieee_exponent <= 1 { 1 } else { 0 }

    // Step 3: convert to a decimal power base using 128-bit arithmetic.
    mut vr = 0 as u64
    mut vp = 0 as u64
    mut vm = 0 as u64
    mut e10 = 0
    mut vm_is_trailing_zeros = false
    mut vr_is_trailing_zeros = false

    if e2 >= 0 {
        // Slightly faster than `max(0, log10_pow2(e2) - 1)`, says the donor.
        ro q = log10_pow2(e2) - (if e2 > 3 { 1 } else { 0 })
        e10 = q
        ro k = DOUBLE_POW5_INV_BITCOUNT + pow5_bits(q) - 1
        ro i = -e2 + q + k
        ro (r_vr, r_vp, r_vm) = mul_shift_all_64(
            m2, DOUBLE_POW5_INV_SPLIT_LO[q], DOUBLE_POW5_INV_SPLIT_HI[q], i, mm_shift)
        vr = r_vr
        vp = r_vp
        vm = r_vm
        if q <= 21 {
            // This should hold for q <= 22, but 21 is the bound the donor is sure
            // of, and a bound one is sure of is the one to port.
            // Only one of mp, mv and mm can be a multiple of 5, if any.
            ro mv_mod5 = mv - 5 * div5(mv)
            if mv_mod5 == 0 {
                vr_is_trailing_zeros = multiple_of_power_of_5(mv, q)
            } else if accept_bounds {
                // Same as min(e2 + (~mm & 1), pow5Factor(mm)) >= q
                // <=> e2 + (~mm & 1) >= q && pow5Factor(mm) >= q
                // <=> true && pow5Factor(mm) >= q, since e2 >= q.
                vm_is_trailing_zeros = multiple_of_power_of_5(mv - 1 - (mm_shift as u64), q)
            } else {
                // Same as min(e2 + 1, pow5Factor(mp)) >= q.
                if multiple_of_power_of_5(mv + 2, q) { vp -= 1 }
            }
        }
    } else {
        // Slightly faster than `max(0, log10_pow5(-e2) - 1)`.
        ro q = log10_pow5(-e2) - (if -e2 > 1 { 1 } else { 0 })
        e10 = q + e2
        ro i = -e2 - q
        ro k = pow5_bits(i) - DOUBLE_POW5_BITCOUNT
        ro j = q - k
        ro (r_vr, r_vp, r_vm) = mul_shift_all_64(
            m2, DOUBLE_POW5_SPLIT_LO[i], DOUBLE_POW5_SPLIT_HI[i], j, mm_shift)
        vr = r_vr
        vp = r_vp
        vm = r_vm
        if q <= 1 {
            // {vr,vp,vm} has trailing zeros if {mv,mp,mm} has at least q trailing
            // zero bits. mv = 4 * m2, so it always has at least two.
            vr_is_trailing_zeros = true
            if accept_bounds {
                // mm = mv - 1 - mm_shift, so it has one trailing zero bit iff
                // mm_shift == 1.
                vm_is_trailing_zeros = mm_shift == 1
            } else {
                // mp = mv + 2, so it always has at least one trailing zero bit.
                vp -= 1
            }
        } else if q < 63 {
            // We want to know whether the full product has at least q trailing
            // zeros: min(p2(mv), p5(mv) - e2) >= q <=> p2(mv) >= q, because
            // -e2 >= q.
            vr_is_trailing_zeros = multiple_of_power_of_2(mv, q)
        }
    }

    // Step 4: the shortest decimal representation inside the interval.
    mut removed = 0
    mut last_removed_digit = 0 as u64
    mut output = 0 as u64

    if vm_is_trailing_zeros || vr_is_trailing_zeros {
        // The general case, which the donor measures at ~0.7% of inputs.
        while true {
            ro vp_div10 = div10(vp)
            ro vm_div10 = div10(vm)
            if vp_div10 <= vm_div10 { break }
            ro vm_mod10 = vm - 10 * vm_div10
            ro vr_div10 = div10(vr)
            ro vr_mod10 = vr - 10 * vr_div10
            vm_is_trailing_zeros = vm_is_trailing_zeros && vm_mod10 == 0
            vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed_digit == 0
            last_removed_digit = vr_mod10
            vr = vr_div10
            vp = vp_div10
            vm = vm_div10
            removed += 1
        }
        if vm_is_trailing_zeros {
            while true {
                ro vm_div10 = div10(vm)
                ro vm_mod10 = vm - 10 * vm_div10
                if vm_mod10 != 0 { break }
                ro vp_div10 = div10(vp)
                ro vr_div10 = div10(vr)
                ro vr_mod10 = vr - 10 * vr_div10
                vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed_digit == 0
                last_removed_digit = vr_mod10
                vr = vr_div10
                vp = vp_div10
                vm = vm_div10
                removed += 1
            }
        }
        if vr_is_trailing_zeros && last_removed_digit == 5 && vr % 2 == 0 {
            // Round to even when the exact value is .....50..0.
            last_removed_digit = 4
        }
        // Take vr + 1 when vr is outside the bounds, or when rounding up.
        ro outside = vr == vm && (!accept_bounds || !vm_is_trailing_zeros)
        output = vr + (if outside || last_removed_digit >= 5 { 1 as u64 } else { 0 as u64 })
    } else {
        // The common case, ~99.3%.
        mut round_up = false
        ro vp_div100 = div100(vp)
        ro vm_div100 = div100(vm)
        if vp_div100 > vm_div100 {
            // Remove two digits at a time; the donor measures this at ~86.2% of
            // the common case.
            ro vr_div100 = div100(vr)
            ro vr_mod100 = vr - 100 * vr_div100
            round_up = vr_mod100 >= 50
            vr = vr_div100
            vp = vp_div100
            vm = vm_div100
            removed += 2
        }
        while true {
            ro vp_div10 = div10(vp)
            ro vm_div10 = div10(vm)
            if vp_div10 <= vm_div10 { break }
            ro vr_div10 = div10(vr)
            ro vr_mod10 = vr - 10 * vr_div10
            round_up = vr_mod10 >= 5
            vr = vr_div10
            vp = vp_div10
            vm = vm_div10
            removed += 1
        }
        output = vr + (if vr == vm || round_up { 1 as u64 } else { 0 as u64 })
    }

    FloatingDecimal64(output, e10 + removed)
}

/// Donor `d2s_buffered_n`, minus the printing: decode the bits, take the
/// small-integer path when it applies, otherwise run `d2d`.
///
/// `None` for the values that have no decimal digits at all -- zero, infinity and
/// NaN. The donor answers those inside `copy_special_str`, which also decides how
/// they LOOK (`NaN`, `Infinity`, `0E0`); that decision is a surface one and ours
/// differs, so it does not belong in the producer.
fn f64_shortest_digits(v f64) -> Option[FloatingDecimal64] {
    ro bits = v.to_bits()
    ro ieee_mantissa = bits & ((1 as u64 << DOUBLE_MANTISSA_BITS) - 1)
    ro exp_mask = (1 as u64 << DOUBLE_EXPONENT_BITS) - 1
    ro ieee_exponent = ((bits >> DOUBLE_MANTISSA_BITS) & exp_mask) as int

    ro all_ones = (1 << DOUBLE_EXPONENT_BITS) - 1
    if ieee_exponent == all_ones { return None }
    if ieee_exponent == 0 && ieee_mantissa == 0 { return None }

    match d2d_small_int(ieee_mantissa, ieee_exponent) {
        Some(small) => {
            // A small integer may carry trailing DECIMAL zeros; scientific
            // notation wants them in the exponent instead.
            mut mantissa = small.mantissa
            mut exponent = small.exponent
            while true {
                ro q = div10(mantissa)
                ro r = mantissa - 10 * q
                if r != 0 { break }
                mantissa = q
                exponent += 1
            }
            Some(FloatingDecimal64(mantissa, exponent))
        }
        None => Some(d2d(ieee_mantissa, ieee_exponent))
    }
}

// ─── The byte assembly: OURS, not the donor's ───
//
// See the file header for why the donor's `to_chars` is not ported. What follows
// reproduces the surface the C helper `nova_f64_shortest` already promises: the
// `%g` rules at the precision the helper's loop settles on.
//
// THE LAYOUT RULE, and how it is known. `%g` prints in scientific form when the
// decimal exponent X (the value written as `d.ddd * 10^X`) is below -4 or at least
// the call's precision P, and in positional form otherwise; trailing zeros are
// dropped either way. The helper calls `%g` first (P = 6) and only then escalates
// `%.7g` … `%.17g` until the value reads back, so P is `max(6, D)` where D is the
// shortest digit count. That last step was a reconstruction from the helper's code
// and is now MEASURED: 4030 values, zero mismatches, including the boundary where
// D and X fall on opposite sides of six (`1230000` prints as `1.23e+06`, but
// `1234567` prints as `1234567`). The measurement judged the RULE on another
// implementation of `%g`, not our binary -- the differential against
// `nova_f64_shortest` still owns the final verdict (plan 285 Ф.1).
//
// Digits go straight into their final positions, least-significant first: the
// position of each is a function of the layout, so no scratch array is needed and
// there is nothing to size wrongly.

/// One byte at `pos`, ignored when it would fall outside the buffer.
///
/// Truncating defensively rather than trapping is the convention of this module
/// (`bool_fmt`, `char_fmt`): the caller owns the buffer and gets the written count
/// back, so a short buffer is the caller's answer, not a crash.
fn put_at(buf *mut u8, cap int, pos int, b u8) {
    if pos >= 0 && pos < cap { unsafe { buf.write_at(pos, b) } }
}

/// `n` decimal digits of `value` ending at `end` (exclusive), written backwards.
fn put_digits_back(buf *mut u8, cap int, end int, n int, value u64) {
    mut v = value
    mut pos = end - 1
    mut left = n
    while left > 0 {
        ro d = v % 10
        put_at(buf, cap, pos, (48 + d) as u8)
        v = v / 10
        pos -= 1
        left -= 1
    }
}

/// The exponent field of scientific form: `e`, a sign, then AT LEAST two digits --
/// `e+06`, `e-05`, `e+308`. Returns the byte count.
fn put_exponent(buf *mut u8, cap int, start int, x int) -> int {
    put_at(buf, cap, start, 'e' as u8)
    mut pos = start + 1
    mut mag = x
    if x < 0 {
        put_at(buf, cap, pos, '-' as u8)
        mag = -x
    } else {
        put_at(buf, cap, pos, '+' as u8)
    }
    pos += 1
    ro width = if mag >= 100 { 3 } else { 2 }
    put_digits_back(buf, cap, pos + width, width, mag as u64)
    pos + width - start
}

/// Shortest round-trip rendering of `v` into `buf[0..cap)`, by the `%g` rules the
/// current C helper follows. Returns the number of bytes the full rendering needs;
/// like the rest of this module it truncates rather than trapping, so a return
/// value greater than `cap` means the caller's buffer was too small.
export fn f64_shortest_fmt(v f64, buf *mut u8, cap int) -> int
    requires cap >= 0
{
    ro bits = v.to_bits()
    ro negative = (bits >> 63) != 0
    mut index = 0

    match f64_shortest_digits(v) {
        None => {
            // Zero, infinity and NaN have no decimal digits; the donor's own
            // spelling of these (`0E0`, `Infinity`, `NaN`) is NOT ours.
            //
            // OPEN, and deliberately not settled from memory: which spelling the
            // C library actually produces for a NEGATIVE NaN (`nan` or `-nan`)
            // differs between libraries, and our helper simply forwards `%g`. The
            // differential in Ф.1 answers it; until then a NaN prints unsigned
            // here, and if the differential says otherwise, this branch is what
            // changes -- not the producer.
            ro exp_mask = (1 as u64 << DOUBLE_EXPONENT_BITS) - 1
            ro ieee_exponent = ((bits >> DOUBLE_MANTISSA_BITS) & exp_mask) as int
            ro ieee_mantissa = bits & ((1 as u64 << DOUBLE_MANTISSA_BITS) - 1)
            if ieee_exponent == (1 << DOUBLE_EXPONENT_BITS) - 1 {
                if ieee_mantissa != 0 {
                    put_at(buf, cap, 0, 'n' as u8)
                    put_at(buf, cap, 1, 'a' as u8)
                    put_at(buf, cap, 2, 'n' as u8)
                    return 3
                }
                if negative { put_at(buf, cap, index, '-' as u8); index += 1 }
                put_at(buf, cap, index, 'i' as u8)
                put_at(buf, cap, index + 1, 'n' as u8)
                put_at(buf, cap, index + 2, 'f' as u8)
                return index + 3
            }
            // Zero. `-0.0` keeps its sign: the bits differ, and so does the text.
            if negative { put_at(buf, cap, index, '-' as u8); index += 1 }
            put_at(buf, cap, index, '0' as u8)
            index + 1
        }
        Some(fd) => {
            if negative { put_at(buf, cap, index, '-' as u8); index += 1 }
            ro digits = decimal_length17(fd.mantissa)
            // X: the exponent of the leading digit, i.e. `v = d.ddd * 10^X`.
            ro x = fd.exponent + digits - 1
            ro precision = if digits > 6 { digits } else { 6 }

            if x < -4 || x >= precision {
                // Scientific. One digit, then the rest behind a point.
                if digits == 1 {
                    put_digits_back(buf, cap, index + 1, 1, fd.mantissa)
                    index += 1
                } else {
                    // The leading digit sits at `index`, the point right after it,
                    // and the remaining `digits - 1` follow -- so the whole run is
                    // written backwards into `index + 1 .. index + digits + 1` and
                    // the leading digit is then moved one place left, over the
                    // point's slot. Writing it in one pass and fixing up is what
                    // the donor does too, for the same reason: the digits come out
                    // least-significant first.
                    put_digits_back(buf, cap, index + digits + 1, digits - 1, fd.mantissa)
                    ro lead = leading_digit(fd.mantissa, digits)
                    put_at(buf, cap, index, lead)
                    put_at(buf, cap, index + 1, '.' as u8)
                    index += digits + 1
                }
                index + put_exponent(buf, cap, index, x)
            } else if x >= 0 {
                // Positional, with a whole part.
                ro int_digits = x + 1
                if digits <= int_digits {
                    // All significant digits are in the whole part; the rest of it
                    // is zeros. No point, no fraction.
                    put_digits_back(buf, cap, index + digits, digits, fd.mantissa)
                    mut z = index + digits
                    while z < index + int_digits {
                        put_at(buf, cap, z, '0' as u8)
                        z += 1
                    }
                    index + int_digits
                } else {
                    // The point falls inside the digit run: write the fraction
                    // first (it is the low end of the mantissa), then the whole
                    // part, then the point between them.
                    ro frac_digits = digits - int_digits
                    put_digits_back(buf, cap, index + int_digits + 1 + frac_digits,
                        frac_digits, fd.mantissa)
                    ro whole = fd.mantissa / pow10(frac_digits)
                    put_digits_back(buf, cap, index + int_digits, int_digits, whole)
                    put_at(buf, cap, index + int_digits, '.' as u8)
                    index + digits + 1
                }
            } else {
                // Positional, below one: `0.` then `-x - 1` zeros then the digits.
                ro zeros = -x - 1
                put_at(buf, cap, index, '0' as u8)
                put_at(buf, cap, index + 1, '.' as u8)
                mut z = index + 2
                while z < index + 2 + zeros {
                    put_at(buf, cap, z, '0' as u8)
                    z += 1
                }
                put_digits_back(buf, cap, index + 2 + zeros + digits, digits, fd.mantissa)
                index + 2 + zeros + digits
            }
        }
    }
}

/// The most significant of `digits` decimal digits of `value`, as a byte.
fn leading_digit(value u64, digits int) -> u8 => (48 + value / pow10(digits - 1)) as u8

/// `10^n` for `0 <= n <= 18`; a loop and not a table, because this is called at
/// most twice per rendering and a table here would be a third place to keep the
/// powers of ten correct.
fn pow10(n int) -> u64 {
    mut r = 1 as u64
    mut i = 0
    while i < n {
        r = r * 10
        i += 1
    }
    r
}
