// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Co-equal file of module `runtime.fmt_buf` (folder = one module).
// Role: the two lookup tables the shortest-printing producer in the peer
// `shortest.nv` multiplies by -- nothing else lives here, and nothing here
// decides anything.
//
// Provenance. Generated MECHANICALLY from Ryu's `ryu/d2s_full_table.h` at commit
// ulfjack/ryu@4c0618b0e44f7ef027ebae05d2cc7812048f7c8f (2026-02-09), which itself says the numbers
// come from its own `PrintDoubleLookupTable`. Licence and the full provenance of
// the port: see the header of `shortest.nv`, `THIRD_PARTY/ryu-LICENSE` and entry 6
// in `THIRD_PARTY/README.md`. NOT typed by hand, and not to be edited by hand: a
// single wrong digit in one of these constants misrounds one rare value, and that
// is a defect no reasonable test set turns red. Regenerate from the donor instead.
//
// SHAPE, and why it differs from the donor. The donor stores `uint64_t T[N][2]`;
// here each table is TWO flat arrays, `_LO` and `_HI`. Which column is which is
// read from the donor's own `mulShift64` (`d2s_intrinsics.h`): `mul[0]` carries
// weight 2^0 and `mul[1]` weight 2^64, so column 0 is LOW and column 1 is HIGH.
// The length sits IN THE TYPE (`[342]u64`, not `[]u64`) for the same reason as in
// `runtime/float_parse/pow5_table.nv`: a truncated table then fails to compile
// instead of failing to round.

#no_prelude
module runtime.fmt_buf

// The donor's own bit counts -- the shift amounts in `shortest.nv` are derived
// from these, never written out as numbers.
const DOUBLE_POW5_INV_BITCOUNT = 125
const DOUBLE_POW5_BITCOUNT = 125
const DOUBLE_POW5_INV_TABLE_SIZE = 342
const DOUBLE_POW5_TABLE_SIZE = 326

