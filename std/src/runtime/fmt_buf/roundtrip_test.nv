#no_prelude
module runtime.fmt_buf
import std.prelude.core.{Option, Some, None, Result, Ok, Err}
import std.runtime.numeric
import std.runtime.string
import std.runtime.float_parse

// Каркас приёмки плана 285 (Ф.0): round-trip печати, НЕ ЗАВИСЯЩИЙ ОТ libc.
//
// ЗАЧЕМ ИМЕННО ТАК. До волны 283 печать float можно было сверить только с
// `strtod`/`snprintf`, то есть с тем же семейством, что и проверяемое: libc
// против libc. После 283 у нас СВОЙ разбор (`str @to_f64()`, корректное
// округление на Nova), поэтому цепочка замкнута нашим кодом:
//     число -> печать (`f64_fmt`) -> байты -> `to_str()` -> `to_f64()` -> биты
// и сравнение битов с исходными. Ни одного вызова libc в СУДЕЙСКОЙ части.
//
// ЧТО ЭТОТ ФАЙЛ СУДИТ СЕГОДНЯ: существующего производителя — `nova_f64_fmt`
// с `kind 0` (Shortest), который внутри всё ещё C. Это НЕ противоречие, а
// требование приёмки Ф.0: иначе каркас не отличит «порт неверен» от
// «каркас неверен». Зелёным он обязан быть ДО нового кода [INV-GUARD: этот файл в `nova test std`]
// — красный каркас виден самим прогоном, отдельного стража предмет не требует.
// Когда Ф.1
// заменит производителя на Nova, ЭТОТ ЖЕ файл станет его судьёй без правок.
//
// СРАВНИВАЮТСЯ БИТЫ, А НЕ ЧИСЛА: `==` на float отвечает на другой вопрос
// (`-0.0 == 0.0`, а биты у них разные), и для round-trip нужен именно
// побитовый ответ — «прочиталось ТО ЖЕ значение», а не «близкое».
//
// ПОЧЕМУ ПРОВЕРЯЮЩАЯ ДВЕРЬ `to_str()`, А НЕ `to_str_unchecked()`. Сперва
// было взято непроверяющее (печать float заведомо ASCII, ветка Err казалась
// мёртвой), но компилятор потребовал `unsafe { }` — и это оказалось поводом
// решить лучше: судья, обёрнутый в `unsafe`, способен прочитать мусор
// НЕЗАМЕТНО, а проверяющая дверь превращает «печать дала не-UTF-8» в честный
// отказ теста. Ветка Err не мёртвая, а инвариантная.

// Печать в scratch-буфер и обратное чтение нашим разбором.
// `Some(bits)` — прочитанные биты; `None` — печать пуста, байты не UTF-8 либо
// разбор отказал. Все три исхода для теста ниже равно негодны, и он их не
// различает намеренно: любой из них означает, что цепочка разорвана.
fn print_then_parse(v f64, kind FloatKind, prec int) -> Option[u64] {
    mut buf = []u8.new(cap: 64)
    ro n = unsafe { f64_fmt(v, buf.ptr(), 64, kind: kind, prec: prec) }
    if n <= 0 { return None }
    // Байты читаются через сырой указатель: примитив пишет мимо `Vec`, и
    // `buf.len()` остаётся нулём (тот же приём, что в `core_test.nv`).
    mut out = []u8.new(cap: 64)
    mut i = 0
    while i < n {
        out.push(unsafe { buf.ptr().read_at(i) })
        i += 1
    }
    match out.to_str() {
        Ok(s) => match s.to_f64() {
            Ok(parsed) => Some(parsed.to_bits())
            Err(_) => None
        }
        Err(_) => None
    }
}

test "285 F.0: round-trip печати замкнут НАШИМ разбором, без libc в судейской части" {
    // Значения выбраны не «красивые», а по классам: точные степени двойки,
    // числа с длинной значащей частью, отрицательные, субнормаль, нуль и
    // минус-нуль (у него биты отличаются от нуля — `==` этого не увидит).
    ro cases = []f64.of(
        0.0, -0.0, 1.0, -1.0, 0.5, 2.5,
        0.1, 0.2, 0.3,
        3.141592653589793, 2.718281828459045,
        1234567.89, 1.7976931348623157e308, 5.0e-324,
        123456789012345.6, 9.007199254740993e15,
    )
    mut i = 0
    while i < cases.len() {
        ro v = cases[i]
        match print_then_parse(v, FloatKind.Shortest, 0) {
            Some(bits) => assert(bits == v.to_bits(), "round-trip обязан вернуть ТЕ ЖЕ биты")
            None => assert(false, "печать, UTF-8 или разбор отказали там, где обязаны работать")
        }
        i += 1
    }
}

test "285 F.0: КОНТРОЛЬ — обрезанная последняя цифра ломает round-trip" {
    // Без этого случая зелёный выше не значит ничего: он проходил бы и на
    // каркасе, который сравнивает что угодно с чем угодно. Здесь round-trip
    // ЛОМАЕТСЯ нарочно — печать усекается на один байт, — и тест требует,
    // чтобы биты РАЗОШЛИСЬ. Требование «должно отличаться» и есть проба в
    // обе стороны, встроенная в сам случай.
    ro v = 0.1
    mut buf = []u8.new(cap: 64)
    ro n = unsafe { f64_fmt(v, buf.ptr(), 64, kind: FloatKind.Shortest, prec: 0) }
    assert(n > 1, "у Shortest-печати 0.1 больше одного байта")

    mut out = []u8.new(cap: 64)
    mut i = 0
    while i < n - 1 {          // ОДИН байт отброшен намеренно
        out.push(unsafe { buf.ptr().read_at(i) })
        i += 1
    }
    match out.to_str() {
        Ok(truncated) => match truncated.to_f64() {
            Ok(parsed) => assert(parsed.to_bits() != v.to_bits(), "обрезанная печать НЕ должна читаться обратно в то же число")
            // Отказ разбора — законный исход контроля: усечение могло
            // оставить строку, которая не является числом вовсе.
            Err(_) => assert(true, "разбор отказал на обрезанной строке — контроль сработал")
        }
        Err(_) => assert(true, "усечение дало не-UTF-8 — контроль сработал")
    }
}
