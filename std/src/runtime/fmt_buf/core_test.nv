#no_prelude
module runtime.fmt_buf

// Scratch buffer: a `Vec[u8]` sized generously for these tests, exposing a
// raw `*mut u8` via `.ptr()` for the primitives under test. Reads back via
// `unsafe { buf.ptr().read_at(i) }` — NOT `buf[i]` — since these primitives
// write through the raw pointer directly, bypassing `Vec`'s own `len`
// tracking (`buf.len()` stays `0` the whole time).
fn scratch(cap int) -> []u8 => []u8.new(cap: cap)

test "int_fmt: decimal positive/negative/zero" {
    mut buf = scratch(24)
    ro spec = FmtSpec.new()

    // Plan 208 Ф.4R §10R-Д3: `int_fmt` is now `unsafe fn` (merged former
    // `int_fmt_into` bridge's unsafe-status) — every call wraps.
    ro n1 = unsafe { int_fmt(42, buf.ptr(), 24, spec: spec) }
    assert(n1 == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == ('4' as u8))
        assert(buf.ptr().read_at(1) == ('2' as u8))
    }

    ro n2 = unsafe { int_fmt(-5, buf.ptr(), 24, spec: spec) }
    assert(n2 == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == ('-' as u8))
        assert(buf.ptr().read_at(1) == ('5' as u8))
    }

    ro n3 = unsafe { int_fmt(0, buf.ptr(), 24, spec: spec) }
    assert(n3 == 1)
    unsafe { assert(buf.ptr().read_at(0) == ('0' as u8)) }
}

test "int_fmt: default spec (§10R-Д3 — simple render = defaulted call)" {
    // Omitting `spec` entirely renders plain decimal — the SAME behavior the
    // retired `int_fmt_into` bridge used to provide, now via callnorm's
    // free-fn default-arg backfill (`spec FmtSpec = FmtSpec.new()`).
    mut buf = scratch(24)
    ro n = unsafe { int_fmt(42, buf.ptr(), 24) }
    assert(n == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == ('4' as u8))
        assert(buf.ptr().read_at(1) == ('2' as u8))
    }
}

test "int_fmt: zero_pad width" {
    mut buf = scratch(24)
    ro spec = FmtSpec { ...FmtSpec.new(), width: 4, zero_pad: true }

    ro n = unsafe { int_fmt(42, buf.ptr(), 24, spec: spec) }
    assert(n == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == ('0' as u8))
        assert(buf.ptr().read_at(1) == ('0' as u8))
        assert(buf.ptr().read_at(2) == ('4' as u8))
        assert(buf.ptr().read_at(3) == ('2' as u8))
    }

    // Negative zero_pad: '0' padding goes BETWEEN the sign and the digits.
    ro n2 = unsafe { int_fmt(-7, buf.ptr(), 24, spec: spec) }
    assert(n2 == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == ('-' as u8))
        assert(buf.ptr().read_at(1) == ('0' as u8))
        assert(buf.ptr().read_at(2) == ('0' as u8))
        assert(buf.ptr().read_at(3) == ('7' as u8))
    }
}

test "int_fmt: hex radix (lower/upper/alt), oct, bin" {
    mut buf = scratch(24)

    ro hex_lower = FmtSpec { ...FmtSpec.new(), radix: 16 }
    ro nh = unsafe { int_fmt(255, buf.ptr(), 24, spec: hex_lower) }
    assert(nh == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == ('f' as u8))
        assert(buf.ptr().read_at(1) == ('f' as u8))
    }

    ro hex_upper = FmtSpec { ...FmtSpec.new(), radix: 16, upper: true }
    ro nhu = unsafe { int_fmt(255, buf.ptr(), 24, spec: hex_upper) }
    assert(nhu == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == ('F' as u8))
        assert(buf.ptr().read_at(1) == ('F' as u8))
    }

    ro hex_alt = FmtSpec { ...FmtSpec.new(), radix: 16, alt: true }
    ro nha = unsafe { int_fmt(255, buf.ptr(), 24, spec: hex_alt) }
    assert(nha == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == ('0' as u8))
        assert(buf.ptr().read_at(1) == ('x' as u8))
        assert(buf.ptr().read_at(2) == ('f' as u8))
        assert(buf.ptr().read_at(3) == ('f' as u8))
    }

    ro oct = FmtSpec { ...FmtSpec.new(), radix: 8 }
    ro no = unsafe { int_fmt(8, buf.ptr(), 24, spec: oct) }
    assert(no == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == ('1' as u8))
        assert(buf.ptr().read_at(1) == ('0' as u8))
    }

    ro bin = FmtSpec { ...FmtSpec.new(), radix: 2 }
    ro nb = unsafe { int_fmt(5, buf.ptr(), 24, spec: bin) }
    assert(nb == 3)
    unsafe {
        assert(buf.ptr().read_at(0) == ('1' as u8))
        assert(buf.ptr().read_at(1) == ('0' as u8))
        assert(buf.ptr().read_at(2) == ('1' as u8))
    }

    // radix reinterprets negative values as the raw two's-complement bit
    // pattern (Rust `{:x}` of -1i64 == "ff..ff") — 64-bit `int` on this
    // platform → 16 hex digits, all 'f'.
    ro nneg = unsafe { int_fmt(-1, buf.ptr(), 24, spec: hex_lower) }
    assert(nneg == 16)
    unsafe {
        mut i = 0
        while i < 16 {
            assert(buf.ptr().read_at(i) == ('f' as u8))
            i = i + 1
        }
    }
}

test "int_fmt: cap truncation never overruns" {
    // cap smaller than the rendered length — must not panic/overrun, and
    // must report the truncated length actually written.
    mut buf = scratch(4)
    ro spec = FmtSpec { ...FmtSpec.new(), width: 8, zero_pad: true }
    ro n = unsafe { int_fmt(42, buf.ptr(), 2, spec: spec) }
    assert(n == 2)
}

test "bool_fmt: true/false" {
    mut buf = scratch(8)
    ro nt = bool_fmt(true, buf.ptr(), 8)
    assert(nt == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == ('t' as u8))
        assert(buf.ptr().read_at(1) == ('r' as u8))
        assert(buf.ptr().read_at(2) == ('u' as u8))
        assert(buf.ptr().read_at(3) == ('e' as u8))
    }

    ro nf = bool_fmt(false, buf.ptr(), 8)
    assert(nf == 5)
    unsafe {
        assert(buf.ptr().read_at(0) == ('f' as u8))
        assert(buf.ptr().read_at(1) == ('a' as u8))
        assert(buf.ptr().read_at(2) == ('l' as u8))
        assert(buf.ptr().read_at(3) == ('s' as u8))
        assert(buf.ptr().read_at(4) == ('e' as u8))
    }
}

test "char_fmt: 1/2/3/4-byte UTF-8 encodings" {
    mut buf = scratch(8)

    ro n1 = char_fmt('A', buf.ptr(), 8)
    assert(n1 == 1)
    unsafe { assert(buf.ptr().read_at(0) == ('A' as u8)) }

    ro n2 = char_fmt('\u{E9}', buf.ptr(), 8)   // 'é'
    assert(n2 == 2)
    unsafe {
        assert(buf.ptr().read_at(0) == 0xC3 as u8)
        assert(buf.ptr().read_at(1) == 0xA9 as u8)
    }

    ro n3 = char_fmt('\u{4E2D}', buf.ptr(), 8)  // '中'
    assert(n3 == 3)
    unsafe {
        assert(buf.ptr().read_at(0) == 0xE4 as u8)
        assert(buf.ptr().read_at(1) == 0xB8 as u8)
        assert(buf.ptr().read_at(2) == 0xAD as u8)
    }

    ro n4 = char_fmt('\u{1F600}', buf.ptr(), 8)  // grinning face emoji
    assert(n4 == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == 0xF0 as u8)
        assert(buf.ptr().read_at(1) == 0x9F as u8)
        assert(buf.ptr().read_at(2) == 0x98 as u8)
        assert(buf.ptr().read_at(3) == 0x80 as u8)
    }
}

test "nova_f64_fmt (C-extern): Shortest/Fixed/Sci kinds" {
    mut buf = scratch(64)

    // kind 1 = Fixed
    // Plan 208 Ф.4R §10R-Д3: renamed from `f64_fmt_into` (extern, D282
    // literal name — now `nova_`-prefixed header-style, see nova_rt.h).
    // [M-174.6-rawptr-extern-unsafe-infer] (D424 rule 1): inferred `unsafe fn`.
    ro nf = unsafe { nova_f64_fmt(3.14159, buf.ptr(), 64, 1, 2) }
    assert(nf == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == ('3' as u8))
        assert(buf.ptr().read_at(1) == ('.' as u8))
        assert(buf.ptr().read_at(2) == ('1' as u8))
        assert(buf.ptr().read_at(3) == ('4' as u8))
    }

    // kind 0 = Shortest (round-trip minimal) — same engine as println(float).
    ro ns = unsafe { nova_f64_fmt(2.5, buf.ptr(), 64, 0, 0) }
    assert(ns == 3)
    unsafe {
        assert(buf.ptr().read_at(0) == ('2' as u8))
        assert(buf.ptr().read_at(1) == ('.' as u8))
        assert(buf.ptr().read_at(2) == ('5' as u8))
    }

    // kind 2 = Sci
    ro ne = unsafe { nova_f64_fmt(1234.5, buf.ptr(), 64, 2, 1) }
    assert(ne > 0)
    unsafe { assert(buf.ptr().read_at(1) == ('.' as u8)) }
}

test "f64_fmt: FloatKind enum wrapper matches nova_f64_fmt" {
    mut buf = scratch(64)
    // Plan 208 Ф.4R §10R-Д3: `f64_fmt` is now `unsafe fn` (merged former
    // `f64_fmt_shortest_into` bridge's unsafe-status) — every call wraps.
    ro n = unsafe { f64_fmt(3.14159, buf.ptr(), 64, kind: FloatKind.Fixed, prec: 2) }
    assert(n == 4)
    unsafe {
        assert(buf.ptr().read_at(0) == ('3' as u8))
        assert(buf.ptr().read_at(2) == ('1' as u8))
        assert(buf.ptr().read_at(3) == ('4' as u8))
    }

    ro n2 = unsafe { f64_fmt(2.5, buf.ptr(), 64, kind: FloatKind.Shortest, prec: 0) }
    assert(n2 == 3)

    // Default-arg call shape (§10R-Д3 norm): omitting kind/prec renders
    // shortest round-trip — the SAME behavior the retired
    // `f64_fmt_shortest_into` bridge used to provide.
    ro n3 = unsafe { f64_fmt(2.5, buf.ptr(), 64) }
    assert(n3 == 3)
}

// Вынесено из core.nv (test-conventions §тесты-рядом-в-пир-файле, тот же
// folder-module `runtime.fmt_buf` — str_debug_fmt/char_debug_fmt).

test "str_debug_fmt: quotes, escapes (\\n \\t \\r \\0 \" \\\\), control \\xHH, passthrough" {
    mut buf = scratch(64)
    ro n = str_debug_fmt("a\nb\tc\rd\\e\"f", buf.ptr(), 64)
    // `"a\nb\tc\rd\\e\"f"` — 18 bytes.
    assert(n == 18)

    mut buf2 = scratch(16)
    ro n2 = str_debug_fmt("a\u{01}b", buf2.ptr(), 16)
    // `"a\x01b"` — 8 bytes.
    assert(n2 == 8)
    unsafe {
        assert(buf2.ptr().read_at(0) == ('"' as u8))
        assert(buf2.ptr().read_at(1) == ('a' as u8))
        assert(buf2.ptr().read_at(2) == ('\\' as u8))
        assert(buf2.ptr().read_at(3) == ('x' as u8))
        assert(buf2.ptr().read_at(4) == ('0' as u8))
        assert(buf2.ptr().read_at(5) == ('1' as u8))
        assert(buf2.ptr().read_at(6) == ('b' as u8))
        assert(buf2.ptr().read_at(7) == ('"' as u8))
    }
}

test "str_debug_fmt: cap truncation never overruns" {
    mut buf = scratch(4)
    ro n = str_debug_fmt("hello world", buf.ptr(), 4)
    assert(n == 4)
}

test "char_debug_fmt: quote/backslash/control/passthrough" {
    mut buf = scratch(8)
    ro n1 = char_debug_fmt('x', buf.ptr(), 8)
    assert(n1 == 3)
    unsafe {
        assert(buf.ptr().read_at(0) == ('\'' as u8))
        assert(buf.ptr().read_at(1) == ('x' as u8))
        assert(buf.ptr().read_at(2) == ('\'' as u8))
    }

    ro n2 = char_debug_fmt('\n', buf.ptr(), 8)
    assert(n2 == 4)
    unsafe {
        assert(buf.ptr().read_at(1) == ('\\' as u8))
        assert(buf.ptr().read_at(2) == ('n' as u8))
    }

    ro n3 = char_debug_fmt('\'', buf.ptr(), 8)
    assert(n3 == 4)
    unsafe {
        assert(buf.ptr().read_at(1) == ('\\' as u8))
        assert(buf.ptr().read_at(2) == ('\'' as u8))
    }

    ro n4 = char_debug_fmt('中', buf.ptr(), 8)
    assert(n4 == 5)  // ' + 3-byte UTF-8 + '
}
