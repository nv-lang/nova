// SPDX-License-Identifier: MIT OR Apache-2.0
// std/os/os.nv — public os API (args / env / cwd / dirs / process) + real_os
// handler.
//
// The pure-Nova wrapper layer over the thin `Os` effect: it builds the rich
// `Option`/`Result`/`Path` return types from the effect's primitive `int`/`str`
// codes, OUTSIDE the effect boundary (which would erase them). Mirrors std/fs's
// fs.nv split (effect = int-primitive plumbing, wrappers = rich types).
//
// **Concurrency contract.** `set_env`/`set_current_dir` mutate
// process-global state and are inherently racy across threads/fibers (Rust made
// `set_var` `unsafe` in 1.84 for exactly this). Nova does not make them unsafe,
// but documents the single-threaded-mutation contract: mutate the environment /
// cwd only during program setup, before spawning concurrent work that reads it.
// Reads (`get_env`, `args`, `current_dir`) are safe.

module std.os

import std.io.{IoError, ErrorKind}
import std.fs.{Path}

// ─── os_cstr: validate + NUL-terminate a key/path for the FFI ──
//
// Env keys and paths cross to C as a NUL-terminated `*u8`. Reject an interior
// NUL (a classic truncation bug → `InvalidInput`) and append a terminator; the
// returned bytes' `.ptr()` is a valid C string. (Same shape as fs's `c_path`
// — the []u8-native `CStr.from_bytes`, `[M-176-cstr-from-bytes-canonical]`.)
fn os_cstr(bytes []u8) -> Result[[]u8, IoError] {
    mut i = 0
    while i < bytes.len() {
        if bytes[i] == (0 as u8) {
            return Err(IoError.new(ErrorKind.InvalidInput, "argument contains NUL"))
        }
        i += 1
    }
    mut out []u8 = []u8.new()
    out.append(bytes)
    out.push(0 as u8)
    Ok(out)
}

fn os_wrap_unit(rc int, op str) -> Result[(), IoError] {
    if rc < 0 { Err(IoError.from_os(0 - rc, op)) } else { Ok(()) }
}

// ─── Program arguments ──

/// The program's command-line arguments. `args()[0]` is the program path (as
/// invoked), matching Go `os.Args` / Rust `env::args`. Bytes are carried
/// verbatim (a non-UTF-8 argument is preserved).
#stable(since = "0.1")
export fn args() Os -> []str {
    ro n = Os.arg_count()
    mut out []str = []
    for i in 0..n {
        out.push(Os.arg_at(i))
    }
    out
}

// ─── Environment ──

/// One environment variable (a `key`/`value` pair) from `vars()`.
#stable(since = "0.1")
export type EnvVar value {
    ro key str
    ro value str
}

/// The key of this variable.
#stable(since = "0.1")
export fn EnvVar @key() -> str => @key

/// The value of this variable.
#stable(since = "0.1")
export fn EnvVar @value() -> str => @value

/// The value of environment variable `key`, or `None` if it is not set. An unset
/// variable and an empty value are distinguished (unlike a bare lookup). Bytes
/// are carried verbatim; use `env_bytes` for guaranteed byte-fidelity of a
/// non-UTF-8 value.
#stable(since = "0.1")
export fn env(key str) Os -> Option[str] => Os.env_get(key.bytes())

/// The raw value bytes of environment variable `key`, or `None` if unset —
/// byte-correct for non-UTF-8 Unix values (Rust `var_os` precedent).
#stable(since = "0.1")
export fn env_bytes(key []u8) Os -> Option[[]u8] {
    match Os.env_get(key) { Some(s) => Some(s.bytes()), None => None }
}

/// Whether environment variable `key` is set.
#stable(since = "0.1")
export fn has_env(key str) Os -> bool => Os.env_has(key.bytes())

/// Set environment variable `key` to `value` (creating or overwriting).
/// **Racy**: mutate only during single-threaded setup.
#stable(since = "0.1")
export fn env(key str, value str) Os -> Result[(), IoError] =>
    env_bytes(key.bytes(), value.bytes())

/// Set `key` to raw `value` bytes (byte-correct). **Racy**.
#stable(since = "0.1")
export fn env_bytes(key []u8, value []u8) Os -> Result[(), IoError] =>
    os_wrap_unit(Os.env_set(key, value), "env")

/// Remove environment variable `key`. Removing an unset variable is not an error.
/// **Racy**.
#stable(since = "0.1")
export fn remove_env(key str) Os -> Result[(), IoError] =>
    os_wrap_unit(Os.env_remove(key.bytes()), "remove_env")

/// A snapshot of all environment variables (Go `os.Environ` / Rust `env::vars`).
#stable(since = "0.1")
export fn vars() Os -> []EnvVar {
    ro n = Os.env_len()
    mut out []EnvVar = []
    for i in 0..n {
        out.push(EnvVar { key: Os.env_key_at(i), value: Os.env_val_at(i) })
    }
    out
}

// ─── Working directory ──

/// The current working directory as an absolute `Path`, or `Err` if it cannot be
/// determined (e.g. the directory was unlinked).
#stable(since = "0.1")
export fn cwd() Os -> Result[Path, IoError] {
    ro s = Os.cwd()
    // Empty == the getcwd hook failed; the effect carries no errno, so surface a
    // raw-0 IoError (kind Other) built inside std.io — avoids the cross-module
    // payload-variant ctor gap.
    if s.is_empty() { Err(IoError.from_os(0, "cwd")) }
    else { Ok(Path.from_bytes(s.bytes())) }
}

/// Change the current working directory to `path`. **Racy**: mutate only
/// during single-threaded setup — a concurrent relative-path resolution races it.
#stable(since = "0.1")
export fn cwd(path Path) Os -> Result[(), IoError] =>
    os_wrap_unit(Os.set_cwd(path.os_bytes()), "cwd")

// ─── Well-known directories ──

/// The system temporary-file directory (`TMPDIR`/`TEMP`/`TMP`, with a portable
/// fallback). Always returns a path.
#stable(since = "0.1")
export fn temp_dir() Os -> Path => Path.from_bytes(Os.temp_dir().bytes())

/// The current user's home directory, or `None` if it cannot be determined.
#stable(since = "0.1")
export fn home_dir() Os -> Option[Path] {
    ro s = Os.home_dir()
    if s.is_empty() { None } else { Some(Path.from_bytes(s.bytes())) }
}

// ─── Process ──

/// Terminate the process with exit `code`, after flushing stdout/stderr (exit
/// codes 0..255 are portable). Does NOT run pending fibers / cleanup — an
/// immediate exit (Go `os.Exit` / Rust `process::exit`). Under `real_os` this
/// never returns. (Named `exit_process` — the bare `exit(code, msg)` is the
/// language builtin for a message-bearing abort.)
#stable(since = "0.1")
export fn exit_process(code int) Os -> () {
    ro _ = Os.exit(code)
}

/// This process's id.
#stable(since = "0.1")
export fn pid() Os -> int => Os.pid()

/// The host name, or `Err` if it cannot be determined.
#stable(since = "0.1")
export fn hostname() Os -> Result[str, IoError] {
    ro s = Os.hostname()
    if s.is_empty() { Err(IoError.from_os(0, "hostname")) } else { Ok(s) }
}

// ─── Process spawn (Plan 265 Ф.1, D453) ──
//
// Scope of THIS wave (owner, 2026-08-10): spawn / wait / exit code ONLY —
// NO stdin/stdout/stderr redirection (deferred to a later wave, gated on
// that decision). `Command.run()` is a single blocking (fiber-parking) call:
// spawn + wait combined, no persistent `Process` handle exposed — nothing to
// leak, nothing to must-consume.

/// Sentinel `Os.process_run` rc meaning "the enclosing `supervised(timeout:)`/
/// `(cancel:)` interrupted the wait" (D453). MUST match `nova_rt/process.h`'s
/// `NOVA_PROCESS_CANCELLED` — kept in sync by convention (out of any real
/// errno's range on either side), not by a shared constant across the FFI.
const PROCESS_CANCELLED = 0 - 100000

// Join `parts` into a NUL-separated byte blob for the process-effect FFI
// boundary (byte-first — mirrors env's `os_cstr`). Each part must not
// contain an interior NUL (would silently truncate an argument otherwise).
fn join_nul(parts []str) -> Result[[]u8, IoError] {
    mut out []u8 = []u8.new()
    for p in parts {
        ro pb = p.bytes()
        mut i = 0
        while i < pb.len() {
            if pb[i] == (0 as u8) {
                return Err(IoError.new(ErrorKind.InvalidInput, "argument contains NUL"))
            }
            i += 1
        }
        out.append(pb)
        out.push(0 as u8)
    }
    Ok(out)
}

// Last-write-wins de-duplication by key (small linear scan — override lists
// are short; a map would be overkill here).
fn dedupe_envs(envs []EnvVar) -> []EnvVar {
    mut out []EnvVar = []
    for v in envs {
        mut found = false
        mut i = 0
        while i < out.len() {
            ro cur EnvVar = out[i]
            if cur.key() == v.key() { out[i] = v; found = true }
            i += 1
        }
        if !found { out.push(v) }
    }
    out
}

fn env_blob_of(envs []EnvVar) -> Result[[]u8, IoError] {
    mut parts []str = []
    for v in envs { parts.push("${v.key()}=${v.value()}") }
    join_nul(parts)
}

/// The completion status of a finished child process (Plan 265 Ф.1, D453).
/// `code()` is the process's own exit code (`0` conventionally means
/// success on both POSIX and Windows); a process killed by a signal it did
/// NOT receive via `supervised(timeout:)`/`(cancel:)` reports `128 + signal`
/// (shell convention).
#stable(since = "0.1")
export type ExitStatus value { ro code int }

/// The raw exit code the child returned.
#stable(since = "0.1")
export fn ExitStatus @code() -> int => @code

/// Whether the child exited with code `0`.
#stable(since = "0.1")
export fn ExitStatus @success() -> bool => @code == 0

/// A subprocess to launch (Rust `Command` / Go `exec.Cmd` precedent). Build
/// with `Command.new(program)`, then `.arg`/`.env`/`.dir` (each returns a
/// modified copy — a `value` builder, `OpenOptions`-style, D323), then
/// `.run()` to launch it, wait for it to exit, and observe the
/// [`ExitStatus`].
///
/// `program` is PATH-searched like a shell (`uv_spawn`'s own
/// `execvp`/`SearchPath`): `Command.new("git")` finds `git` on `PATH`
/// without a full path.
#stable(since = "0.1")
export type Command value priv {
    program str
    args []str
    envs []EnvVar
    clear_env bool
    dir Option[Path]
}

/// A fresh command running `program` with no arguments, inheriting the
/// parent's environment and current working directory.
#stable(since = "0.1")
export fn Command.new(program str) -> Command =>
    { program, args: [], envs: [], clear_env: false, dir: None }

/// Append one argument.
#stable(since = "0.1")
export fn Command mut @arg(a str) -> @ { @args.push(a) }

/// Append several arguments.
#stable(since = "0.1")
export fn Command mut @args(a []str) -> @ { @args.append(a) }

/// Set (or override) one environment variable for the child. Repeatable;
/// the LAST call for a given key wins. Without `.env_clear()` the child
/// inherits the parent's environment first, then these overrides apply.
#stable(since = "0.1")
export fn Command mut @env(key str, value str) -> @ { @envs.push(EnvVar { key, value }) }

/// Start the child with an EMPTY environment (ignore the parent's) — only
/// variables set via `.env(...)` reach it.
#stable(since = "0.1")
export fn Command mut @env_clear() -> @ { @clear_env = true }

/// Run the child in `path` instead of the parent's current working directory.
#stable(since = "0.1")
export fn Command mut @dir(path Path) -> @ { @dir = Some(path) }

/// Launch the child, wait for it to finish, and report its [`ExitStatus`].
///
/// `Err` means the process never RAN at all (bad `program`, permission
/// denied, or the call was interrupted by an enclosing
/// `supervised(timeout:)`/`(cancel:)` — `ErrorKind.Interrupted`) — distinct
/// from a successfully-run process that exited with a non-zero code, which
/// is `Ok(ExitStatus{ code: n })`, `n != 0`. Both are typed, not string-
/// distinguished (D453).
#stable(since = "0.1")
export fn Command @run() Os -> Result[ExitStatus, IoError] {
    ro argv = join_nul(@args)?
    ro use_env = @clear_env || !@envs.is_empty()
    ro deduped = dedupe_envs(@envs)
    ro env_blob = if use_env { env_blob_of(deduped)? } else { []u8.new() }
    ro cwd_bytes = match @dir {
        Some(p) => p.os_bytes()
        None => []u8.new()
    }
    ro (rc, code) = Os.process_run(@program.bytes(), argv, @args.len(), env_blob, deduped.len(), use_env, cwd_bytes)
    if rc == PROCESS_CANCELLED { Err(IoError.new(ErrorKind.Interrupted, "process run")) }
    else if rc < 0 { Err(IoError.from_os(0 - rc, "process run")) }
    else { Ok(ExitStatus { code }) }
}

// ─── real_os — the production Os handler over the native hooks (os_env.h) ──
//
// Thin: each op forwards to the matching os_* hook (which returns the int/str
// code the effect declares). Keys/paths are NUL-validated via os_cstr; a rejected
// argument yields -EINVAL (→ InvalidInput) or an empty string.

/// Concrete `Os` handler dispatching to the native process environment
/// (getenv/getcwd/setenv/getpid/…). Install at the root of a program:
/// `with Os = real_os() { … }`.
///
/// `#default_handler` (bare form) — `Os` auto-constructs (lazily, once per
/// thread) on first transitive use with no enclosing `with Os = …`, consistent
/// with `Time`/`real_time()`.
#stable(since = "0.1")
#default_handler
export fn real_os() -> Effect[Os] {
    effect Os {
        arg_count() -> int => os_arg_count()
        arg_at(i int) -> str => os_arg_at(i)
        env_get(key []u8) -> Option[str] {
            match os_cstr(key) { Ok(ck) => if unsafe { os_env_has(ck.ptr()) } == 1 { Some(unsafe { os_env_get(ck.ptr()) }) } else { None }, Err(_) => None }
        }
        env_has(key []u8) -> bool {
            match os_cstr(key) { Ok(ck) => unsafe { os_env_has(ck.ptr()) } == 1, Err(_) => false }
        }
        env_set(key []u8, val []u8) -> int {
            match os_cstr(key) {
                Ok(ck) => match os_cstr(val) { Ok(cv) => unsafe { os_env_set(ck.ptr(), cv.ptr()) }, Err(_) => 0 - 22 }
                Err(_) => 0 - 22
            }
        }
        env_remove(key []u8) -> int {
            match os_cstr(key) { Ok(ck) => unsafe { os_env_remove(ck.ptr()) }, Err(_) => 0 - 22 }
        }
        env_len() -> int => os_env_len()
        env_key_at(i int) -> str => os_env_key_at(i)
        env_val_at(i int) -> str => os_env_val_at(i)
        cwd() -> str => os_cwd()
        set_cwd(path []u8) -> int {
            match os_cstr(path) { Ok(cp) => unsafe { os_set_cwd(cp.ptr()) }, Err(_) => 0 - 22 }
        }
        temp_dir() -> str => os_temp_dir()
        home_dir() -> str => os_home_dir()
        exit(code int) -> int => os_exit(code)
        pid() -> int => os_pid()
        hostname() -> str => os_hostname()
        process_run(program []u8, argv []u8, argc int, env []u8, envc int, use_env bool, cwd []u8) -> (int, int) {
            mut code = 0
            ro rc = unsafe { os_process_run(program.ptr(), program.len(), argv.ptr(), argv.len(), argc, env.ptr(), env.len(), envc, use_env, cwd.ptr(), cwd.len(), &code) }
            (rc, code)
        }
    }
}
