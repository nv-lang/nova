// SPDX-License-Identifier: MIT OR Apache-2.0
// std/os/proc.nv — child-process streams (Plan 294 F.1, D492; continues D453).
//
// `Command.run()` / `Os.process_run` (D453) stay exactly as they are: one call, spawn +
// wait + exit code, stdio on the null device. This file adds the other half — a live
// `Child` handle and byte streams over its stdin / stdout / stderr:
//
//     consume child = Command.new("tool").arg("x").stdin(Stdio.Piped).stdout(Stdio.Piped).start()?
//     consume tx = child.take_stdin()          // ChildStdin  — io.Write
//     consume rx = child.take_stdout()         // ChildStdout — io.Read
//     ...
//     ro status = child.wait()?                // parks the FIBER, not the OS thread
//
// `Proc` is a plumbing effect (the `Net` / `Os` precedent): user code calls the methods
// below, never the effect operations; production uses `real_proc()` (auto-installed,
// `#default_handler`); a test handler (`mock_proc`) is deferred, plan 294 marker
// `[M-294-mock-proc]`, so tests run real processes. It is a NEW effect next to `Os`
// because D453 forbids widening `process_run` after the fact and `Os` carries no
// handles.
//
// **Back pressure.** `ChildStdout.read` PULLS: libuv reads one chunk straight into the
// caller's buffer and stops. Nothing is queued inside the runtime — a child writing faster
// than the reader is blocked by the OS pipe (64 KiB on Linux, 4 KiB on Windows).
//
// **Deadlock rule.** A child filling stderr while you read only stdout blocks forever. Read
// both from separate fibers (see `Command.output()`, which does exactly that) or send the
// unused one to `Stdio.Null`.
//
// **Name.** The plan's `spawn` is a reserved word in Nova (it starts a fiber), so the method is `start`.
//
// **Bytes, not text.** Nothing is re-encoded, no newline is translated.

module std.os

import std.io.{IoError, ErrorKind}
import std.io.{read_to_end}
import std.time.duration.{Duration}

// ─── Stdio selection ──

/// What the child's stdin / stdout / stderr is connected to.
///   * `Null`    — the OS null device (the default, as in D453).
///   * `Inherit` — the parent's own descriptor.
///   * `Piped`   — a pipe whose parent end is taken with `Child.take_*`.
#stable(since = "0.1")
export type Stdio enum
    | Null | Inherit | Piped

/// A signal to deliver to a child (`Child.kill`, `kill_pid`). POSIX sends the real signal;
/// Windows has none: `Kill` and `Terminate` both end the process at once, every other value
/// is `Err(Unsupported)` there (plan 294, table 3.4), never silently mapped to something else.
#stable(since = "0.1")
export type Signal enum
    | Interrupt | Terminate | Kill | Hangup | Other(int)

/// How far `kill` and scope cancellation reach.
///   * `Single` - the child process only (the default, as in D453).
///   * `Group`  - the child leads its own process group (POSIX: `setsid`) / Job Object
///     (Windows); every kill, `stop`, cancellation and `cleanup` hits the whole tree.
///     The tree does not outlive its leader: when the leader exits (for any reason, even
///     by itself with code 0) the members left are killed at once. A grandchild the
///     leader left running as a "daemon" therefore does not keep the pipes open.
///     POSIX note: a `Group` child loses the parent's controlling terminal.
#stable(since = "0.1")
export type Tree enum
    | Single | Group

fn signal_number(s Signal) -> int {
    match s {
        Interrupt => 2
        Terminate => 15
        Kill => 9
        Hangup => 1
        Other(n) => n
    }
}

fn stdio_code(s Stdio) -> int {
    match s {
        Null => 0
        Inherit => 1
        Piped => 2
    }
}

// ─── The Proc plumbing effect ──

/// Ambient child-process access. Internal dispatch point — user code uses
/// `Command.start` / `Child` / `ChildStdout` ..., not these operations.
///
/// Thin by design, like `Os`: raw `int` / handle results; every `Result` / `Option` is
/// built in this file OUTSIDE the effect boundary. Errors are negative errno numbers.
#stable(since = "0.1")
export type Proc effect {
    // (err, child): err is 0 on success, a negative errno otherwise (then child is null).
    fn launch(program []u8, argv []u8, argc int, env []u8, envc int, use_env bool, cwd []u8, modes int) -> (int, *())
    fn child_pipe(child *(), which int) -> *()
    fn child_pid(child *()) -> int
    // (rc, code, signal): rc 0 exited, PROCESS_CANCELLED cancelled, < 0 error.
    fn child_wait(child *()) -> (int, int, int)
    // rc 0 exited, 1 still running.
    fn child_try_wait(child *()) -> (int, int, int)
    fn child_release(child *()) -> ()
    // Plan 294 F.2. rc 0 ok (also for a child already gone), < 0 = -errno / unsupported.
    fn child_kill(child *(), sig int) -> int
    // (rc, code, signal): rc 0 exited, 1 still running after `ms` (the child is NOT killed).
    fn child_wait_ms(child *(), ms int) -> (int, int, int)
    fn kill_pid(pid int, sig int, tree bool) -> int
    fn pipe_read(pipe *(), mut buf []u8) -> int
    fn pipe_write(pipe *(), data []u8) -> int
    fn pipe_close(pipe *()) -> ()
    // Plan 294 F.4 — pseudo terminal (pty.nv). Same conventions as the child operations above.
    fn pty_launch(program []u8, argv []u8, argc int, env []u8, envc int, use_env bool, cwd []u8, rows int, cols int) -> (int, *())
    fn pty_read(pty *(), mut buf []u8) -> int
    fn pty_write(pty *(), data []u8) -> int
    fn pty_resize(pty *(), rows int, cols int) -> int
    fn pty_pid(pty *()) -> int
    fn pty_wait(pty *()) -> (int, int, int)
    fn pty_try_wait(pty *()) -> (int, int, int)
    fn pty_kill(pty *(), sig int) -> int
    fn pty_close(pty *()) -> ()
}

// ─── Types ──

/// A running (or finished) child process. `consume`: leaving the scope without waiting
/// KILLS a still-running child (no orphan outlives its owner, D492 rule 6) and closes
/// every pipe that was never taken.
#stable(since = "0.1")
export type Child consume value priv { handle *() }

/// The write end of the child's stdin (`io.Write`). `close()` delivers end-of-input.
#stable(since = "0.1")
export type ChildStdin consume value priv { handle *() }

/// The read end of the child's stdout (`io.Read`); `Ok(0)` = end of stream.
#stable(since = "0.1")
export type ChildStdout consume value priv { handle *() }

/// The read end of the child's stderr (`io.Read`); `Ok(0)` = end of stream.
#stable(since = "0.1")
export type ChildStderr consume value priv { handle *() }

/// Everything a finished child produced: see `Command.output()`.
#stable(since = "0.1")
export type Output value { ro status ExitStatus, ro stdout []u8, ro stderr []u8 }

// Mirrors NOVA_PROC_UNSUPPORTED / NOVA_PROC_NO_SUCH / NOVA_PROC_CLOSED in nova_rt/process.h.
const PROC_UNSUPPORTED = 0 - 100001
const PROC_NO_SUCH = 0 - 3
const PROC_CLOSED = 0 - 100002

// A stream op result. A closed (or scope-cancelled) stream is NotConnected, never Interrupted:
// std.io loop helpers retry Interrupted, and a dead stream would answer every retry the same.
fn stream_result(n int, op str) -> Result[int, IoError] {
    if n == PROC_CLOSED { Err(IoError.new(ErrorKind.NotConnected, op)) }
    else if n < 0 { Err(proc_io_err(n, op)) }
    else { Ok(n) }
}

fn signal_result(rc int, op str) -> Result[(), IoError] {
    if rc == 0 { Ok(()) }
    else if rc == PROC_UNSUPPORTED { Err(IoError.new(ErrorKind.Unsupported, op)) }
    else if rc == PROC_NO_SUCH { Err(IoError.new(ErrorKind.NotFound, op)) }
    else { Err(proc_io_err(rc, op)) }
}

fn ptr_is_null(p *()) -> bool => (0 as *()) == p

fn proc_io_err(neg_errno int, op str) -> IoError => IoError.from_os(0 - neg_errno, op)

// ─── Command: stream configuration + spawn ──

/// How far kill / cancellation reach (default `Tree.Single`). See `Tree`.
#stable(since = "0.1")
export fn Command mut @tree(t Tree) -> @ { @tree_mode = t }

/// Connect the child's stdin (default `Stdio.Null`).
#stable(since = "0.1")
export fn Command mut @stdin(s Stdio) -> @ { @stdin_mode = s }

/// Connect the child's stdout (default `Stdio.Null`).
#stable(since = "0.1")
export fn Command mut @stdout(s Stdio) -> @ { @stdout_mode = s }

/// Connect the child's stderr (default `Stdio.Null`).
#stable(since = "0.1")
export fn Command mut @stderr(s Stdio) -> @ { @stderr_mode = s }

/// Start the child and return its live handle without waiting.
///
/// `Err` means the process never started: `NotFound` (no such program, or a bad
/// `dir`), `PermissionDenied`, `NotADirectory`, ... with the raw OS code in `raw_os`.
/// The same argument / environment / directory rules as `Command.run()`.
#stable(since = "0.1")
export fn Command @start() Proc -> Result[Child, IoError] {
    ro argv = join_nul(@args)?
    ro use_env = @clear_env || !@envs.is_empty()
    ro deduped = dedupe_envs(@envs)
    ro env_blob = if use_env { env_blob_of(deduped)? } else { []u8.new() }
    ro cwd_bytes = match @dir {
        Some(p) => p.os_bytes()
        None => []u8.new()
    }
    ro tree_bit = match @tree_mode {
        Single => 0
        Group => 64
    }
    ro modes = stdio_code(@stdin_mode) + 4 * stdio_code(@stdout_mode) + 16 * stdio_code(@stderr_mode) + tree_bit
    ro (err, h) = Proc.launch(@program.bytes(), argv, @args.len(), env_blob, deduped.len(), use_env, cwd_bytes, modes)
    if err < 0 { Err(proc_io_err(err, "spawn")) }
    else { Ok(Child { handle: h }) }
}

// ─── Child ──

/// The OS process id.
#stable(since = "0.1")
export fn Child @pid() Proc -> int { Proc.child_pid(@handle) }

/// The child's stdin writer. `Some` once, and only when spawned with `Stdio.Piped`.
#stable(since = "0.1")
export fn Child mut @take_stdin() Proc -> Option[ChildStdin] {
    ro h = Proc.child_pipe(@handle, 0)
    if ptr_is_null(h) { None } else { Some(ChildStdin { handle: h }) }
}

/// The child's stdout reader. `Some` once, and only when spawned with `Stdio.Piped`.
#stable(since = "0.1")
export fn Child mut @take_stdout() Proc -> Option[ChildStdout] {
    ro h = Proc.child_pipe(@handle, 1)
    if ptr_is_null(h) { None } else { Some(ChildStdout { handle: h }) }
}

/// The child's stderr reader. `Some` once, and only when spawned with `Stdio.Piped`.
#stable(since = "0.1")
export fn Child mut @take_stderr() Proc -> Option[ChildStderr] {
    ro h = Proc.child_pipe(@handle, 2)
    if ptr_is_null(h) { None } else { Some(ChildStderr { handle: h }) }
}

fn exit_status_of(code int, sig int) -> ExitStatus {
    // A signal death reports `128 + signal` in `code()` (shell convention, as D453) and
    // the signal itself in `signal()`.
    if sig != 0 { ExitStatus { code: 128 + sig, sig } } else { ExitStatus { code, sig: 0 } }
}

/// Wait for the child to exit. Parks the calling fiber, not the OS thread. Output the
/// child has produced stays readable from the pipes you hold. If the enclosing
/// `supervised(timeout:)` / `(cancel:)` fires first, the child is killed and the result is
/// `Err(Interrupted)` (D453, same choice).
#stable(since = "0.1")
export fn Child mut @wait() Proc -> Result[ExitStatus, IoError] {
    ro (rc, code, sig) = Proc.child_wait(@handle)
    if rc == PROCESS_CANCELLED { Err(IoError.new(ErrorKind.Interrupted, "child wait")) }
    else if rc < 0 { Err(proc_io_err(rc, "child wait")) }
    else { Ok(exit_status_of(code, sig)) }
}

/// Non-blocking: `Ok(Some(status))` if the child has exited, `Ok(None)` while it runs.
#stable(since = "0.1")
export fn Child mut @try_wait() Proc -> Result[Option[ExitStatus], IoError] {
    ro (rc, code, sig) = Proc.child_try_wait(@handle)
    if rc == 0 { Ok(Some(exit_status_of(code, sig))) }
    else if rc == 1 { Ok(None) }
    else { Err(proc_io_err(rc, "child try_wait")) }
}

/// Send `sig` to the child, to its whole tree after `Command.tree(Tree.Group)`. `Ok` also for a
/// child that has already exited (idempotent) - and then NOTHING is sent: the number of an exited
/// process (or group) may belong to an unrelated one by now. Does not wait and does not mark the child as
/// cancelled: `wait()` afterwards reports the real status (`signal() == Some(9)` after `Kill`).
/// Windows: only `Kill` / `Terminate`; anything else is `Err(Unsupported)`.
#stable(since = "0.1")
export fn Child mut @kill(sig Signal) Proc -> Result[(), IoError] {
    signal_result(Proc.child_kill(@handle, signal_number(sig)), "child kill")
}

/// Wait up to `d` for the child to exit. `Ok(None)` = the time ran out and the child is STILL
/// RUNNING: this never kills (the caller decides). Parks the fiber in short steps (a few
/// milliseconds), so an exit is noticed within that granularity. A cancelled scope unwinds
/// the wait like any sleep.
#stable(since = "0.1")
export fn Child mut @wait_timeout(d Duration) Proc -> Result[Option[ExitStatus], IoError] {
    ro (rc, code, sig) = Proc.child_wait_ms(@handle, d.millis() as int)
    if rc == 0 { Ok(Some(exit_status_of(code, sig))) }
    else if rc == 1 { Ok(None) }
    else { Err(proc_io_err(rc, "child wait_timeout")) }
}

/// Graceful stop: `Terminate`, wait up to `grace`, then `Kill`, then wait for the exit. A child
/// that leaves on `Terminate` reports its own status; one that ignores it dies by signal 9
/// (`signal() == Some(9)`). Windows has no gentler signal: `Terminate` ends the process at
/// once and `grace` is never spent. With `Tree.Group` both steps reach the whole tree.
#stable(since = "0.1")
export fn Child mut @stop(grace Duration) Proc -> Result[ExitStatus, IoError] {
    @kill(Signal.Terminate)?
    match @wait_timeout(grace)? {
        Some(st) => Ok(st)
        None => {
            @kill(Signal.Kill)?
            @wait()
        }
    }
}

/// Signal a process this program holds no `Child` for (a pid read from a file, a service that
/// restarted). `tree`: the whole process group LED by `pid` on POSIX (a child started with
/// `Tree.Group`), and `pid` plus its descendants (one snapshot of the process table) on Windows.
/// `Err(NotFound)` when there is no such process / group, `Err(PermissionDenied)` when it is not
/// ours. Best effort: a pid can be reused by an unrelated process after its owner died; prefer
/// `Child.kill` whenever you still hold the `Child`. On Windows every process of the tree is killed
/// through an open handle and only if it was created before the snapshot (a descendant: not before
/// its parent), so a number reused while the call runs is never hit.
#stable(since = "0.1")
export fn kill_pid(pid int, sig Signal, tree bool) Proc -> Result[(), IoError] {
    signal_result(Proc.kill_pid(pid, signal_number(sig), tree), "kill_pid")
}

/// `Cleanup[never]` (D188): a child still running when its scope ends gets `Terminate`, a short
/// grace (500 ms) and then `Kill` (the whole tree with `Tree.Group`), and the call returns only
/// once the process is gone; pipes never taken are closed. After the child exited this only
/// releases the handle and signals nothing (a group's stragglers died with its leader).
#stable(since = "0.1")
export fn Child consume @cleanup(_outcome ScopeOutcome) -> () { @release() }

// Raw effect ops need `Proc` declared (D62); `cleanup` itself is `-> ()` like TcpStream's.
fn Child consume @release() Proc { Proc.child_release(@handle) }

// ─── ChildStdin (io.Write) ──

/// Write `data`; returns `Ok(n)` bytes accepted (the whole buffer on success). A child that
/// has closed its stdin or exited yields `Err(BrokenPipe)`.
#stable(since = "0.1")
export fn ChildStdin mut @write(data []u8) Proc -> Result[int, IoError] {
    stream_result(Proc.pipe_write(@handle, data), "write child stdin")
}

/// `io.Write` conformance: writes reach the pipe directly — `flush` is a no-op.
#stable(since = "0.1")
export fn ChildStdin mut @flush() -> Result[(), IoError] => Ok(())

/// Close the pipe: the child sees end-of-input. Idempotent by ownership (`consume`).
#stable(since = "0.1")
export fn ChildStdin consume @close() Proc { Proc.pipe_close(@handle) }

#stable(since = "0.1")
export fn ChildStdin consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

// ─── ChildStdout / ChildStderr (io.Read) ──

/// Read up to `buf.len()` bytes. `Ok(0)` = the child closed its end (it exited or closed
/// stdout); data is never lost to it. Parks the fiber until bytes arrive.
#stable(since = "0.1")
export fn ChildStdout mut @read(mut buf []u8) Proc -> Result[int, IoError] {
    stream_result(Proc.pipe_read(@handle, buf), "read child stdout")
}

/// Close our end. A still-running child that writes more gets a broken pipe;
/// the process itself is untouched — `wait()` still waits for it.
#stable(since = "0.1")
export fn ChildStdout consume @close() Proc { Proc.pipe_close(@handle) }

#stable(since = "0.1")
export fn ChildStdout consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

/// See `ChildStdout.read`.
#stable(since = "0.1")
export fn ChildStderr mut @read(mut buf []u8) Proc -> Result[int, IoError] {
    stream_result(Proc.pipe_read(@handle, buf), "read child stderr")
}

#stable(since = "0.1")
export fn ChildStderr consume @close() Proc { Proc.pipe_close(@handle) }

#stable(since = "0.1")
export fn ChildStderr consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

// ─── output(): run to completion, collect both streams ──

fn output_missing(what str) -> IoError => IoError.new(ErrorKind.InvalidInput, what)

/// Run the command to completion and collect stdout and stderr (stdin is the null
/// device). The two streams are drained by TWO fibers in parallel, so a child filling
/// stderr while you wait on stdout cannot deadlock.
#stable(since = "0.1")
export fn Command @output() Proc -> Result[Output, IoError] {
    ro piped Command = { @program, @args, @envs, @clear_env, @dir,
                         stdin_mode: Stdio.Null, stdout_mode: Stdio.Piped, stderr_mode: Stdio.Piped,
                         @tree_mode }
    consume child = piped.start()?
    consume so = match child.take_stdout() {
        Some(consume s) => s
        None => return Err(output_missing("output: stdout pipe missing"))
    }
    consume se = match child.take_stderr() {
        Some(consume s) => s
        None => return Err(output_missing("output: stderr pipe missing"))
    }
    // The stderr fiber reports through two plain channels (bytes, raw OS code): a
    // `Channel[Result[[]u8, IoError]]` corrupted the received value (registry #1858).
    ro err_bytes = Channel[[]u8].new(1)
    ro err_code = Channel[int].new(1)
    mut out_res Result[[]u8, IoError] = Err(output_missing("output: not read"))
    supervised {
        spawn consume e = se {
            match read_to_end(e) {
                Ok(b) => { err_bytes.tx.send(b); err_code.tx.send(0) }
                Err(x) => { err_bytes.tx.send([]u8.new()); err_code.tx.send(if x.raw_os == 0 { 5 } else { x.raw_os }) }
            }
        }
        out_res = read_to_end(so)
    }
    ro stderr_bytes = match err_bytes.rx.recv() {
        Some(b) => b
        None => []u8.new()
    }
    ro stderr_code = match err_code.rx.recv() {
        Some(c) => c
        None => 5
    }
    ro status = child.wait()?
    if stderr_code != 0 { return Err(IoError.from_os(stderr_code, "read child stderr")) }
    Ok(Output { status, stdout: out_res?, stderr: stderr_bytes })
}

// ─── real_proc — the production Proc handler over nova_rt/process.c ──

/// Concrete `Proc` handler dispatching to the native libuv-backed child-process layer.
/// `#default_handler`: `Proc` auto-constructs on first use with no enclosing `with Proc = …`.
#stable(since = "0.1")
#default_handler
export fn real_proc() -> Effect[Proc] {
    effect Proc {
        launch(program []u8, argv []u8, argc int, env []u8, envc int, use_env bool, cwd []u8, modes int) -> (int, *()) {
            mut err = 0
            ro h = unsafe { proc_spawn(program.ptr(), program.len(), argv.ptr(), argv.len(), argc, env.ptr(), env.len(), envc, use_env, cwd.ptr(), cwd.len(), modes, &err) }
            (err, h)
        }
        child_pipe(child *(), which int) -> *() => unsafe { proc_child_pipe(child, which) }
        child_pid(child *()) -> int => unsafe { proc_child_pid(child) }
        child_wait(child *()) -> (int, int, int) {
            mut code = 0
            mut sig = 0
            ro rc = unsafe { proc_child_wait(child, &code, &sig) }
            (rc, code, sig)
        }
        child_try_wait(child *()) -> (int, int, int) {
            mut code = 0
            mut sig = 0
            ro rc = unsafe { proc_child_try_wait(child, &code, &sig) }
            (rc, code, sig)
        }
        child_release(child *()) -> () { unsafe { proc_child_release(child) } }
        child_kill(child *(), sig int) -> int => unsafe { proc_child_kill(child, sig) }
        child_wait_ms(child *(), ms int) -> (int, int, int) {
            mut code = 0
            mut sig = 0
            ro rc = unsafe { proc_child_wait_ms(child, ms, &code, &sig) }
            (rc, code, sig)
        }
        kill_pid(pid int, sig int, tree bool) -> int => unsafe { proc_kill_pid(pid, sig, tree) }
        pipe_read(pipe *(), mut buf []u8) -> int => unsafe { proc_pipe_read(pipe, buf.ptr(), buf.len()) }
        pipe_write(pipe *(), data []u8) -> int => unsafe { proc_pipe_write(pipe, data.ptr(), data.len()) }
        pipe_close(pipe *()) -> () { unsafe { proc_pipe_close(pipe) } }
        pty_launch(program []u8, argv []u8, argc int, env []u8, envc int, use_env bool, cwd []u8, rows int, cols int) -> (int, *()) {
            mut err = 0
            ro h = unsafe { proc_pty_spawn(program.ptr(), program.len(), argv.ptr(), argv.len(), argc, env.ptr(), env.len(), envc, use_env, cwd.ptr(), cwd.len(), rows, cols, &err) }
            (err, h)
        }
        pty_read(pty *(), mut buf []u8) -> int => unsafe { proc_pty_read(pty, buf.ptr(), buf.len()) }
        pty_write(pty *(), data []u8) -> int => unsafe { proc_pty_write(pty, data.ptr(), data.len()) }
        pty_resize(pty *(), rows int, cols int) -> int => unsafe { proc_pty_resize(pty, rows, cols) }
        pty_pid(pty *()) -> int => unsafe { proc_pty_pid(pty) }
        pty_wait(pty *()) -> (int, int, int) {
            mut code = 0
            mut sig = 0
            ro rc = unsafe { proc_pty_wait(pty, &code, &sig) }
            (rc, code, sig)
        }
        pty_try_wait(pty *()) -> (int, int, int) {
            mut code = 0
            mut sig = 0
            ro rc = unsafe { proc_pty_try_wait(pty, &code, &sig) }
            (rc, code, sig)
        }
        pty_kill(pty *(), sig int) -> int => unsafe { proc_pty_kill(pty, sig) }
        pty_close(pty *()) -> () { unsafe { proc_pty_close(pty) } }
    }
}
