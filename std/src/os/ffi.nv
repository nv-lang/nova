// SPDX-License-Identifier: MIT OR Apache-2.0
// std/os/ffi.nv — private C FFI layer for std/os.
//
// The OS surface (env / args / cwd / well-known dirs / process) is a set of
// **non-blocking native syscalls** — getenv/getcwd/setenv/getpid/… — so, exactly
// like std/io's console hooks and std/fs's fs_seek, they are plain static-inline
// C hooks (nova_rt/os_env.h, always included) rather than libuv-backed park/wake
// ops (that pattern is for real blocking I/O — fs.c/net.c). No OS handle types
// cross the boundary: keys/paths cross as a NUL-terminated `*u8` (a validated
// C string — the real_os handler NUL-terminates via `c_str`, mirroring
// fs's `c_path`), values come back as a `str` carrying the raw bytes verbatim
// (byte-transparent — non-UTF-8 Unix env bytes round-trip losslessly).
//
// C symbols are called by literal name (`extern "C" fn`). C side:
// nova_rt/os_env.h (`os_*` hooks + `os_set_args`, called from `main`).

module std.os

// ─── Program arguments (argv) ──
// Captured once at process start by main() (os_set_args). arg[0] is the
// program path. Read count then index.

// arg_count: number of program arguments (>= 0; includes argv[0]).
extern "C" fn os_arg_count() -> int
// arg_at: the i-th argument as a str (empty out of range).
extern "C" fn os_arg_at(i int) -> str

// ─── Environment ──
// Keys/values are NUL-terminated `*u8`. Getter returns raw value bytes as a
// `str` (empty when absent — disambiguate with os_env_has; конвертируется в Option на границе, обработчик в os.nv). Mutators return 0
// or a NEGATIVE POSIX errno.

// env_get: raw value bytes for `key` (empty if absent).
extern "C" fn os_env_get(key *u8) -> str
// env_has: 1 if `key` is present, else 0 (конвертируется в bool на границе, обработчик в os.nv).
extern "C" fn os_env_has(key *u8) -> int
// env_set: set `key` = `val` (overwrite). 0 or -errno.
extern "C" fn os_env_set(key *u8, val *u8) -> int
// env_remove: remove `key` (missing key = success). 0 or -errno.
extern "C" fn os_env_remove(key *u8) -> int
// env_len: number of environment entries (snapshot count).
extern "C" fn os_env_len() -> int
// env_key_at / env_val_at: key/value of the i-th entry (split on '=').
extern "C" fn os_env_key_at(i int) -> str
extern "C" fn os_env_val_at(i int) -> str

// ─── Working directory ──
// cwd: absolute current directory (empty on error).
extern "C" fn os_cwd() -> str
// set_cwd: chdir to `path`. 0 or -errno.
extern "C" fn os_set_cwd(path *u8) -> int

// ─── Well-known directories ──
// temp_dir: system temp directory (never empty — portable fallback).
extern "C" fn os_temp_dir() -> str
// home_dir: user home directory (empty == none).
extern "C" fn os_home_dir() -> str

// ─── Process ──
// exit: flush stdout/stderr and terminate (never returns; int keeps the op
// shape uniform).
extern "C" fn os_exit(code int) -> int
// pid: this process's id.
extern "C" fn os_pid() -> int
// hostname: host name (empty on error).
extern "C" fn os_hostname() -> str

// ─── Process spawn (Plan 265 Ф.1, D453) ──
// os_process_run — spawn `program` with `argc` NUL-separated arguments from
// `argv` (program itself excluded), wait for it to exit, report (rc,
// *out_exit_code). SINGLE-SHOT (mirrors net_dns_lookup, not
// net_tcp_connect — see process.h's design note): no persistent handle
// crosses the boundary. `env`/`envc` are read only when `use_env` is true
// (NUL-separated "KEY=VALUE" entries; envc==0 is a valid, explicit EMPTY
// environment); `cwd_len==0` inherits the parent's cwd. Return: 0 = ran to
// completion (*out_exit_code valid); PROCESS_CANCELLED (os.nv) = the
// enclosing supervised(timeout:)/(cancel:) interrupted the wait; <0
// (other) = failed to SPAWN, -errno-compatible. See D453.
extern "C" fn os_process_run(program *u8, program_len int, argv *u8, argv_len int, argc int, env *u8, env_len int, envc int, use_env bool, cwd *u8, cwd_len int, out_exit_code *mut int) -> int
