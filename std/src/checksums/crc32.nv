// stdlib/crc32.nv — CRC-32 checksum (IEEE 802.3 polynomial).
//
// Independent implementation. Спецификации:
//   - ISO 3309
//   - ITU-T V.42
//   - RFC 1952 (gzip): https://www.rfc-editor.org/rfc/rfc1952
//
// Полином: 0xEDB88320 (reversed 0x04C11DB7), используется в:
//   - ZIP/gzip
//   - PNG
//   - Ethernet (802.3)
//   - SATA, MPEG-2
//
// Алгоритм:
//   - Pre-computed таблица 256 значений (lazy в реальной реализации,
//     здесь — runtime функция-replacement).
//   - Для каждого байта: crc = table[(crc ^ u8) & 0xFF] ^ (crc >> 8)
//   - Финальное XOR с 0xFFFFFFFF
//
// Pure function, без эффектов. Прямая проверка integrity.
//
// API:
//   fn crc32(data []u8) -> u32

module checksums.crc32

// ──────────────────────────────────────────────────────────────────────────
// Lookup table
// ──────────────────────────────────────────────────────────────────────────

// Считаем таблицу один раз. В production-stdlib это будет
// `const TABLE [256]u32 = [...]` — массив литералов. Здесь — функция
// которая возвращает значение для данного индекса. Production tooling
// сгенерирует таблицу в comptime.
//
// Полином 0xEDB88320 — reversed standard CRC-32 (IEEE 802.3).
fn table_value(i u8) -> u32 {
    mut c = i as u32
    for k in 0..8 {
        c = if c & 1 == 1 {
            0xEDB88320 ^ (c >> 1)
        } else {
            c >> 1
        }
    }
    c
}

// Wrapper для удобного доступа. Будущая оптимизация — закэшировать
// в массив через `let TABLE [256]u32 = ...` когда будут comptime массивы.
fn lookup(i u8) -> u32 => table_value(i)

// ──────────────────────────────────────────────────────────────────────────
// Public API
// ──────────────────────────────────────────────────────────────────────────

/// CRC-32 checksum (IEEE 802.3 polynomial) для последовательности байт.
///
/// Pure-функция: deterministic, no I/O. Use cases — file integrity,
/// network frame check, ZIP/PNG/gzip.
///
/// # Examples
/// ```nova
/// let cs = crc32("123456789".bytes())
/// assert(cs == 0xCBF43926)
/// ```
#stable(since = "0.1")
export fn crc32(data []u8) -> u32 {
    mut crc u32 = 0xFFFFFFFF
    for u8 in data {
        ro idx = (crc ^ (u8 as u32)) as u8
        crc = lookup(idx) ^ (crc >> 8)
    }
    crc ^ 0xFFFFFFFF
}

/// Init incremental CRC-32 state — для streamed input.
///
/// # Examples
/// ```nova
/// let mut s = crc32_init()
/// s = crc32_update(s, chunk1)
/// s = crc32_update(s, chunk2)
/// let final = crc32_finalize(s)
/// ```
#stable(since = "0.1")
export fn crc32_init() -> u32 => 0xFFFFFFFF

/// Update CRC-32 state с новыми bytes. Без финализации (нужен `crc32_finalize`).
#stable(since = "0.1")
export fn crc32_update(state u32, data []u8) -> u32 {
    mut crc = state
    for u8 in data {
        ro idx = (crc ^ (u8 as u32)) as u8
        crc = lookup(idx) ^ (crc >> 8)
    }
    crc
}

/// Финализирует CRC-32 state — XOR с 0xFFFFFFFF (IEEE 802.3 convention).
#stable(since = "0.1")
export fn crc32_finalize(state u32) -> u32 =>
    state ^ 0xFFFFFFFF

