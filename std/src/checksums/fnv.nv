// stdlib/fnv.nv — FNV-1 / FNV-1a non-cryptographic hash.
//
// Independent implementation. http://www.isthe.com/chongo/tech/comp/fnv/
//
// FNV (Fowler-Noll-Vo) — простой быстрый non-cryptographic hash.
// FNV-1a — современный вариант (xor перед multiply, лучше распределение).
//
// ⚠️ НЕ использовать для:
//   - Cryptographic integrity (используй SHA-256)
//   - HMAC / passwords
//
// Допустимо для:
//   - HashMap внутренности
//   - Bloom filter (см. bloom_filter.nv)
//   - Content-addressable storage с low-collision требованиями
//
// API:
//   Fnv.hash32(data []u8) -> u32
//   Fnv.hash64(data []u8) -> u64
//   Fnv.hash_str(s str) -> u64

module checksums.fnv

// FNV-1a 32-bit
const FNV1A_32_OFFSET u32 = 0x811C9DC5
const FNV1A_32_PRIME  u32 = 0x01000193

// FNV-1a 64-bit
const FNV1A_64_OFFSET u64 = 0xCBF29CE484222325
const FNV1A_64_PRIME  u64 = 0x100000001B3

/// FNV-1a 32-bit hash. Non-cryptographic. NOT for passwords/integrity (see SHA-256).
///
/// # Examples
/// ```nova
/// assert(Fnv.hash32("a".bytes()) == 0xE40C292C)
/// ```
#stable(since = "0.1")
export fn Fnv.hash32(data []u8) -> u32 {
    mut h = FNV1A_32_OFFSET
    for b in data {
        h = h ^ (b as u32)
        // Plan 206 Ф.2 (D423): FNV — модульная арифметика ПО ЗАМЫСЛУ (mod 2^32
        // multiply — часть спецификации, не баг). Голый `*` трапит после Ф.1b
        // sized-int trap-default -> явный opt-out через `.wrapping_mul`.
        h = h.wrapping_mul(FNV1A_32_PRIME)
    }
    h
}

/// FNV-1a 64-bit hash. Non-cryptographic, fast, low collision for small/medium inputs.
#stable(since = "0.1")
export fn Fnv.hash64(data []u8) -> u64 {
    mut h = FNV1A_64_OFFSET
    for b in data {
        h = h ^ (b as u64)
        // Plan 206 Ф.2 (D423): модульная арифметика по замыслу — см. hash32.
        h = h.wrapping_mul(FNV1A_64_PRIME)
    }
    h
}

/// Convenience: hash a UTF-8 string to u64.
#stable(since = "0.1")
export fn Fnv.hash_str(s str) -> u64 =>
    Fnv.hash64(s.bytes())

/// Streaming state for FNV-1a 64-bit (incremental updates).
#stable(since = "0.1")
export type Fnv64State {
    mut h u64    // internal accumulator
}

/// Init Fnv64State (offset basis per the FNV spec).
#stable(since = "0.1")
export fn Fnv64.new() -> Fnv64State =>
    { h: FNV1A_64_OFFSET }

/// Update the state with the next chunk of bytes.
#stable(since = "0.1")
export fn Fnv64State mut @update(data []u8) -> () {
    for b in data {
        @h = @h ^ (b as u64)
        // Plan 206 Ф.2 (D423): модульная арифметика по замыслу — см. hash32.
        @h = @h.wrapping_mul(FNV1A_64_PRIME)
    }
}

/// Finalize — return final hash.
#stable(since = "0.1")
export fn Fnv64State @finalize() -> u64 => @h

