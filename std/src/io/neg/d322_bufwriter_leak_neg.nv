// EXPECT_COMPILE_ERROR E_D432_CLEANUP_EFFECT_NOT_DECLARED
// D432 §1 amendment (2026-08-04, №315): `BufWriter[W]` is auto-`@cleanup`
// eligible -- a leftover one auto-closes at scope exit, and its cleanup's
// flush error becomes a DIRECT `Fail[IoError]` effect of the function that
// leaves it (std/src/io/buffered.nv:104). So the negative case is a function
// that leaves a `BufWriter` WITHOUT declaring `Fail[IoError]`.
//
// History (registry 221.1 #1345, 2026-09-25): until then this file expected
// `D133-not-consumed` inside a `test` block. That verdict was a gap, and this
// file's own comment named it: the consume pass recorded an EMPTY type for the
// `BufWriter[BytesWriter].new(sink)` init shape, so the D432 eligibility lookup
// missed it and the strict-linear path fired. #1345 gave the pass the binding's
// full type; the `test` block (which handles `Fail` itself) now correctly
// accepts the leftover writer, and the real D432 rule is pinned here instead.

module neg.d322_bufwriter_leak_neg

import std.io.{BytesWriter, BufWriter}

// nova:expect E_D432_CLEANUP_EFFECT_NOT_DECLARED -- the leftover BufWriter's cleanup can fail with IoError, which this fn does not declare
fn leak() -> () {
    mut sink = BytesWriter.new()
    consume bw = BufWriter[BytesWriter].new(sink)
    mut d []u8 = []u8.new()
    d.push(0x41 as u8)
    ro _ = bw.write(d)
}

fn main() Io -> () {
    leak()
}
