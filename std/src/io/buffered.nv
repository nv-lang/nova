// SPDX-License-Identifier: MIT OR Apache-2.0
// std/io/buffered.nv — BufReader / BufWriter.
//
// `BufWriter[W]` is **must-consume** — the #1 differentiator:
// a `BufWriter` that is never `@close`d is a **compile error**,
// and `@close` returns the flush `Result`, so the error
// that so often only shows up on close (ENOSPC / EIO / quota) is **not
// ignorable**. Beats every peer: Go `bufio.Flush` footgun, Rust `Drop`-swallow,
// Zig's manual `flush()`. No silent flush-on-drop.
//
// `BufReader[R]` amortises many small `@read`s over an inner reader by refilling
// a buffer in `DEFAULT_BUF_CAP` chunks (Rust `BufReader`, Go `bufio.Reader`).

module std.io

// 8 KiB — the classic stdio buffer size (Rust `BufReader`/`BufWriter`).
const DEFAULT_BUF_CAP = 8192

// ─── BufWriter[W] — must-consume buffering sink ───

/// Buffering wrapper over an inner `io.Write`. `@close` surfaces the final
/// flush error instead of swallowing it. Accumulates writes and flushes to the
/// inner sink in `DEFAULT_BUF_CAP` chunks.
///
/// **D432 §1 amendment (2026-08-04, №315 fix) — auto-`@cleanup` enabled**,
/// same treatment as `File` (std/src/fs/fs.nv, see its type doc for the full
/// rationale): a `BufWriter` left un-closed at scope-exit auto-`@cleanup`s
/// instead of being a compile error, but the final-flush error is still NOT
/// swallowed — it propagates via `Fail[IoError]`, a DIRECT effect the
/// triggering function must declare (D432 §1) or `E_D432_CLEANUP_EFFECT_NOT_DECLARED`
/// fires at compile time. Explicit `@close()` still works and disarms
/// auto-cleanup (D432 §4).
#stable(since = "0.1")
export type BufWriter[W Write] consume priv {
    mut inner W
    mut buf []u8
}

/// Wrap `inner` in a buffer.
#stable(since = "0.1")
export fn BufWriter[W].new(inner W) -> Self => { inner, buf: []u8.new() }

// Flush the internal buffer to the inner sink (non-consuming helper). Forwards
// to the shared `write_all` loop over `@inner` — was an inlined COPY of that
// loop (`[M-176-io-forward-bounded-generic]`, checker gap: the bound-forward
// `write_all(@inner, ...)` from a receiver-generic method into a free bounded-
// generic fn with the SAME bound falsely failed "does not satisfy"); collapsed
// now that Plan 176 Ф.1 fixed the checker (`types/mod.rs::check_satisfaction`).
fn BufWriter[W Write] mut @drain() -> Result[(), IoError] {
    if @buf.len() == 0 { return Ok(()) }
    match write_all(@inner, @buf) {
        Ok(())  => { @buf.clear(); Ok(()) }
        Err(e)  => Err(e)
    }
}

/// io.Write: buffer `data`, draining to the inner sink whenever the buffer
/// grows past `DEFAULT_BUF_CAP`. Always accepts the whole slice.
#stable(since = "0.1")
export fn BufWriter[W Write] mut @write(data []u8) -> Result[int, IoError] {
    @buf.append(data)
    if @buf.len() >= DEFAULT_BUF_CAP {
        match @drain() {
            Ok(())  => {}
            Err(e)  => return Err(e)
        }
    }
    Ok(data.len())
}

// (No `@write_str` convenience method on BufWriter: a method by that name would
// collide, under coarse-by-name method dispatch, with the `write_str` selector
// the auto-derived `@debug`/`@display` emit on the text-sink — it mis-routes a
// StringBuilder into this method. Use the free `write_str(bw, s)` instead — since
// `BufWriter` is an `io.Write`, that bridges text→bytes just the same.)

/// io.Write: flush the buffer, then flush the inner sink.
#stable(since = "0.1")
export fn BufWriter[W Write] mut @flush() -> Result[(), IoError] {
    match @drain() {
        Ok(())  => @inner.flush()
        Err(e)  => Err(e)
    }
}

/// Discharge: flush everything and consume the writer. The explicit
/// release, still recommended (surfaces the flush error inline rather than
/// through the caller's signature); the flush error is returned, never lost.
/// After `@close` the `BufWriter` cannot be used again (double-close is a
/// compile error).
#stable(since = "0.1")
export fn BufWriter[W Write] consume @close() -> Result[(), IoError] {
    @flush()
}

/// D432 §1 amendment (2026-08-04, №315 fix) `Cleanup[IoError]`
/// implementation: cleanup = `@close()`, propagated via `!!` — see
/// `File consume @cleanup` (std/src/fs/fs.nv) for the full rationale, same
/// pattern here. No effect beyond `Fail[IoError]` is declared (mirrors
/// `@close`/`@flush`/`@write` above, all effect-free in their OWN
/// signature — the inner `W`'s effect, if any, surfaces transitively at
/// monomorphisation, same as every other `BufWriter[W]` method).
#stable(since = "0.1")
export fn BufWriter[W Write] consume @cleanup(_outcome ScopeOutcome) Fail[IoError] -> () {
    @close()!!
}

// ─── BufReader[R] — buffering source ───

/// Buffering wrapper over an inner `io.Read`. Serves reads from an internal
/// buffer, refilling in `DEFAULT_BUF_CAP` chunks — amortises the per-`@read`
/// cost of many small reads. Is itself an `io.Read`.
#stable(since = "0.1")
export type BufReader[R Read] priv {
    mut inner R
    mut buf []u8
    mut pos int
}

/// Wrap `inner` in a read buffer.
#stable(since = "0.1")
export fn BufReader[R].new(inner R) -> Self => { inner, buf: []u8.new(), pos: 0 }

// Refill the buffer from the inner reader when exhausted. Returns the number of
// bytes now available (0 = inner reached EOF). Retries `Interrupted`.
fn BufReader[R Read] mut @refill() -> Result[int, IoError] {
    if @pos < @buf.len() { return Ok(@buf.len() - @pos) }
    mut chunk []u8 = []u8.new()
    chunk.resize(DEFAULT_BUF_CAP, 0 as u8)
    loop {
        match @inner.read(chunk) {
            Ok(0)  => return Ok(0)
            Ok(n)  => {
                @buf = chunk.truncate(n)
                @pos = 0
                return Ok(n)
            }
            Err(e) => {
                if e.is_interrupted() { continue }
                return Err(e)
            }
        }
    }
}

/// io.Read: serve up to `buf.len()` bytes from the internal buffer, refilling
/// from the inner reader when empty. `Ok(0)` (non-empty `buf`) = EOF.
#stable(since = "0.1")
export fn BufReader[R Read] mut @read(mut buf []u8) -> Result[int, IoError] {
    ro want = buf.len()
    if want == 0 { return Ok(0) }
    ro avail = @refill()?
    if avail == 0 { return Ok(0) }
    ro n = want.min(avail)
    for i in 0..n {
        buf[i] = @buf[@pos + i]
    }
    @pos += n
    Ok(n)
}
