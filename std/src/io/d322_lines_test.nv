// d322_lines_test.nv — lines() / byte_lines() edge cases (Plan 176 Ф.1, Q7).
// Migrated from nova_tests/io/d322_lines.nv (Plan 182 Ф.2).

module std.io

test "lines strips trailing CR (CRLF), yields final line without newline" {
    mut r = BytesReader.new("a\r\nbb\nccc")
    match lines(r) {
        Ok(ls) => {
            assert(ls.len() == 3)
            assert(ls[0] == "a")     // \r stripped
            assert(ls[1] == "bb")
            assert(ls[2] == "ccc")   // no trailing \n → still yielded
        }
        Err(_) => assert(false)
    }
}

test "lines: embedded lone CR is NOT a separator" {
    mut r = BytesReader.new("x\ry\n")
    match lines(r) {
        Ok(ls) => { assert(ls.len() == 1); assert(ls[0] == "x\ry") }
        Err(_) => assert(false)
    }
}

test "lines: empty input yields no lines" {
    mut r = BytesReader.new([]u8.new())
    match lines(r) { Ok(ls) => assert(ls.len() == 0), Err(_) => assert(false) }
}

test "byte_lines: raw LF split, no CR stripping" {
    mut r = BytesReader.new("a\r\nb\n")
    match byte_lines(r) {
        Ok(ls) => {
            assert(ls.len() == 2)
            assert(ls[0].len() == 2)          // "a\r" — CR preserved (raw)
            assert(ls[0][1] == 0x0D as u8)
            assert(ls[1][0] == 0x62 as u8)
        }
        Err(_) => assert(false)
    }
}
