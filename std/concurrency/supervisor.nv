// stdlib/supervisor.nv — встроенные политики Supervisor-эффекта (Plan 173.2).
//
// `Supervisor` / `Decision` объявлены в std/prelude/effects.nv (авто-доступны
// без импорта). Стратегии — обычные handler-значения (`Effect[Supervisor]`),
// подменяются как Time/Fail:
//
//   import std.concurrency.supervisor as sup
//
//   with Supervisor = sup.stop() {
//       supervised {
//           for u in urls { spawn { fetch(u) } }   // упавший НЕ отменяет siblings
//       }
//   }
//
// Пользовательская политика — просто handler-литерал:
//
//   with Supervisor = effect Supervisor {
//       on_child_fail(idx, err) => if err is TransientError { Decision.Stop }
//                                  else { Decision.Escalate }
//   } { ... }
//
// MVP-словарь исполнения (§3b): `Escalate` / `Stop`. Restart-варианты
// гейтятся изоляцией restartable-тела (Plan 173.3) — конструирование внутри
// хендлера отклоняется компилятором (E_SUPERVISOR_RESTART_GATED).

module concurrency.supervisor

/// Политика «эскалировать всё» — эквивалент дефолта (нет супервизора):
/// ошибка первого упавшего ребёнка становится primary, siblings кооперативно
/// отменяются, scope перевыбрасывает наружу. Полезна как явная базовая точка
/// (или внешний слой, поверх которого локально ставится иная политика).
#stable(since = "0.1")
export fn escalate() -> Effect[Supervisor] {
    effect Supervisor {
        on_child_fail(idx, err) => Decision.Escalate
    }
}

/// Политика «выкинуть упавшего» — падение ребёнка НЕ эскалируется и НЕ
/// отменяет siblings: scope продолжает работу, как будто упавший ребёнок
/// просто завершился без результата (его ошибка остаётся retained per-slot,
/// 173.0 — не теряется молча). Аналог Erlang `temporary`-ребёнка.
#stable(since = "0.1")
export fn stop() -> Effect[Supervisor] {
    effect Supervisor {
        on_child_fail(idx, err) => Decision.Stop
    }
}
