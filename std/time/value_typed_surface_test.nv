// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 182 Ф.1 (migrated from nova_tests/time/plan175_f1b_value_typed_surface.nv)
// — Plan 175 Ф.1b + Ф.3 (option C) — pos-фикстура: value-records + typed
// surface поверх int-wire эффекта.
//
// Покрывает §8 acceptance:
//   - Duration/Timestamp/Monotonic — `value`-records (round-trip через
//     from_*/as_*, stack, zero-GC);
//   - арифметика value-records: @plus/@minus/@neg/@times/@div/@compare/==;
//   - typed-сахар `Timestamp.now()` над int-wire `Time.now()`;
//   - `@is_past`/`@time_until`/`@elapsed` РАБОТАЮТ (int-based) под mock-часами;
//   - `Monotonic.now()` (value-builtin) non-regression.

module time.value_typed_surface_test

import std.time.duration
import std.testing.handlers as th

test "Ф.1b: value Duration round-trip (from_*/as_*, arithmetic)" {
    ro d = Duration.from_millis(1500)
    assert(d.as_millis() == 1500)
    assert(d.as_secs() == 1)
    assert(d.as_nanos() == 1_500_000_000)
    // arithmetic on value-records
    assert((1.hour() + 30.minutes()) == 90.minutes())
    assert((1.hour() - 15.minutes()) == 45.minutes())
    assert((5.seconds() * 3) == 15.seconds())
    assert((1.minute() / 4) == 15.seconds())
    assert((-(5.seconds())).is_negative())
    assert(1.second() < 1.minute())
}

test "Ф.1b: value Timestamp round-trip + @plus/@minus" {
    ro t = Timestamp.from_unix_secs(1_700_000_000)
    assert(t.as_unix_secs() == 1_700_000_000)
    ro later = t + 30.seconds()
    assert(later.as_unix_secs() == 1_700_000_030)
    ro delta = later - t
    assert(delta == 30.seconds())
}

test "Ф.3: Timestamp.now() sugar + @is_past/@time_until/@elapsed (int-based mock)" {
    with Time = th.fixed_ms(10_000) {
        // sugar wraps int-wire Time.now() (ms) → value Timestamp
        assert(Timestamp.now().as_unix_millis() == 10_000)
        // 10s now; deadline at 6s is past; at 20s is future
        ro past = Timestamp.from_unix_secs(6)
        ro future = Timestamp.from_unix_secs(20)
        assert(past.is_past())
        assert(!future.is_past())
        assert(past.elapsed() == 4.seconds())        // 10s - 6s
        assert(future.time_until() == 10.seconds())  // 20s - 10s
    }
}

test "Ф.3: mut_clock advances timed surface coherently" {
    with Time = th.mut_clock(1_000) {
        ro t0 = Timestamp.now()
        assert(t0.as_unix_millis() == 1_000)
        Time.sleep(2_000)  // int ms wire
        ro t1 = Timestamp.now()
        assert(t1.as_unix_millis() == 3_000)
        assert((t1 - t0) == 2.seconds())
    }
}

test "Ф.1b: Monotonic.now() (value builtin) non-regression + @plus/@minus(Duration)" {
    ro m0 = Monotonic.now()
    ro m1 = Monotonic.now()
    assert(m1.as_nanos() >= m0.as_nanos())
    ro deadline = m0 + 5.seconds()
    assert(deadline.as_nanos() == m0.as_nanos() + 5_000_000_000)
    ro earlier = deadline - 5.seconds()
    assert(earlier.as_nanos() == m0.as_nanos())
}
