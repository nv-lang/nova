// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 182 Ф.1 (migrated from nova_tests/time/plan175_f1c_overflow_safe.nv)
// — Plan 175 Ф.1c (D317/D318) — overflow-safe арифметика, cross-module pos.
//
// Проверяет ПУБЛИЧНЫЙ surface (import std.time.duration) — checked_*/
// saturating_*, boundary-saturate на Timestamp/Monotonic, @abs(i64::MIN),
// Monotonic non-regression (saturate-to-zero + checked_duration_since).
// Trap-поведение операторов — std/time/rt/ (EXPECT_RUNTIME_PANIC).

module time.overflow_safe_test

import std.time.duration

const I64_MAX = 9_223_372_036_854_775_807
const I64_MIN = -9_223_372_036_854_775_807 - 1

test "Ф.1c: Duration checked_* — Some in-range, None on overflow" {
    assert((1.second()).checked_add(1.second()).is_some())
    assert(Duration.from_nanos(I64_MAX).checked_add(1.nanos()).is_none())
    assert(Duration.from_nanos(I64_MIN).checked_mul(-1).is_none())
    assert(Duration.from_nanos(10).checked_div(0).is_none())
    match (30.seconds()).checked_sub(10.seconds()) {
        Some(r) => assert(r == 20.seconds()),
        None => assert(false),
    }
}

test "Ф.1c: Duration saturating_* clamps to ±MAX, no wrap" {
    ro top = Duration.from_nanos(I64_MAX)
    assert(top.saturating_add(1.seconds()).as_nanos() == I64_MAX)
    assert(top.saturating_mul(1000).as_nanos() == I64_MAX)
    assert(top.saturating_mul(-1000).as_nanos() == -I64_MAX)
    assert((5.seconds()).saturating_sub(2.seconds()) == 3.seconds())
}

test "Ф.1c: @abs(i64::MIN) → MAX (no UB)" {
    assert(Duration.from_nanos(I64_MIN).abs().as_nanos() == I64_MAX)
    assert((-3.seconds()).abs() == 3.seconds())
}

test "Ф.1c: Timestamp saturates at ~2262 horizon, checked → None" {
    ro tmax = Timestamp.from_unix_nanos(I64_MAX)
    assert(tmax.checked_add(1.seconds()).is_none())
    assert((tmax + 1.seconds()).as_unix_nanos() == I64_MAX)   // saturate, not wrap
    assert((Timestamp.from_unix_secs(1042) - Timestamp.from_unix_secs(1000)) == 42.seconds())
}

test "Ф.1c/D318: Monotonic non-regression (saturate-to-zero + checked None)" {
    ro m = Monotonic.now()
    ro earlier = m - 5.seconds()
    assert(m.elapsed_since(earlier) == 5.seconds())
    assert(earlier.elapsed_since(m).as_nanos() == 0)       // regress → 0, never negative
    assert(earlier.checked_duration_since(m).is_none())    // regress → None
    assert(m.checked_duration_since(earlier).is_some())
}
