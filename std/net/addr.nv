// SPDX-License-Identifier: MIT OR Apache-2.0
// DEPRECATED (план 183 Ф.3): модуль заменён std/net2; удаление после санации nova_tests (план 182).
// Plan 91.12 Ф.3 / Plan 178 Ф.0.5: std/net/addr.nv — SocketAddr public API.
//
// SocketAddr: IPv4/IPv6 socket address. The `handle` field is a CSocketAddr
// (= void*) holding a NovaRt_SocketAddr*.
//
// Plan 178 Ф.0.5 — AddrNet retracted: address construction/inspection do NO I/O
// (no syscall, no parking, no capability) — они чистые операции над значением.
// Per the placement rule (§13.2: метод в эффекте ⟺ неразрывно завязан на I/O /
// parking / capability; иначе pure; FFI ≠ эффект) these are now plain `fn`s
// calling the `extern "C"` address FFI directly — no `AddrNet` effect, no `with`
// ceremony. DNS `SocketAddr.lookup` (resolve host → addresses = I/O) stays in
// the `Net` effect (dns.nv).
//
// NOTE (rep): the value-record `{family, addr-bytes, port}` rep-change (§13.2 /
// §3.10 — nv-sourcing) is byte-baseline-guarded and NON-blocking; it rides a
// separate net-sweep commit and does not gate HTTP (HTTP берёт SocketAddr как
// данные — работает при любом rep). This pass keeps the opaque-handle rep and
// only retracts the effect. Marker: [M-net-socketaddr-value-record].
//
// C handles allocated nova_alloc_uncollectable(); GC does not collect.

module std.net

/// IPv4/IPv6 socket address (host + port).
///
/// Stack-allocated: contains exactly one field (a C pointer).
/// Cheap to copy; two copies reference the same C-side NovaRt_SocketAddr.
///
/// # Examples
///
/// ```nova
/// let a4 = SocketAddr.loopback(8080)       // 127.0.0.1:8080
/// let a6 = SocketAddr.loopback_v6(8080)    // [::1]:8080
/// let av = SocketAddr.v4(192, 168, 1, 1, 80)
/// let ap = SocketAddr.from_str("127.0.0.1:9090").unwrap()
/// ```
///
/// # See Also
///
/// - `[TcpListener.bind]`, `[TcpStream.connect]`, `[UdpSocket.bind]`
#stable(since = "0.1")
export type SocketAddr value { priv handle CSocketAddr }

/// Create IPv4 loopback address 127.0.0.1:port.
///
/// Passing `port = 0` asks the OS to choose an available port.
#stable(since = "0.1")
export fn SocketAddr.loopback(port u16) -> SocketAddr {
    SocketAddr._from_raw(socket_addr_loopback(port))
}

/// Create IPv6 loopback address [::1]:port.
#stable(since = "0.1")
export fn SocketAddr.loopback_v6(port u16) -> SocketAddr {
    SocketAddr._from_raw(socket_addr_loopback_v6(port))
}

/// Create IPv4 address from dotted-quad octets.
///
/// # Examples
///
/// ```nova
/// let addr = SocketAddr.v4(127, 0, 0, 1, 80)  // 127.0.0.1:80
/// ```
#stable(since = "0.1")
export fn SocketAddr.v4(a u8, b u8, c u8, d u8, port u16) -> SocketAddr {
    SocketAddr._from_raw(socket_addr_v4(a, b, c, d, port))
}

/// Parse "host:port" string into a SocketAddr.
///
/// Returns `Err(NetError.InvalidAddr(...))` if the string is malformed,
/// `Err(NetError.InvalidPort)` if the port is out of range.
/// IPv6 literal addresses must be bracketed: `"[::1]:9090"`.
///
/// Pure: parses an address literal, no DNS / no I/O.
#stable(since = "0.1")
export fn SocketAddr.from_str(s str) -> Result[SocketAddr, NetError] {
    ro code = socket_addr_parse(s)
    if code == 2 { addr_invalid_port() }
    else if code != 0 { addr_invalid(s) }
    else { Ok(SocketAddr._from_raw(socket_addr_parse_result())) }
}

/// Get the port number.
#stable(since = "0.1")
export fn SocketAddr @port() -> u16 { socket_addr_port(@handle) }

/// Get the host IP as a human-readable string.
///
/// For IPv4: dotted-decimal ("127.0.0.1"). For IPv6: compressed hex ("::1").
#stable(since = "0.1")
export fn SocketAddr @ip() -> str { socket_addr_ip(@handle) }

/// Return `true` if this is an IPv4 address.
#stable(since = "0.1")
export fn SocketAddr @is_v4() -> bool { socket_addr_is_v4(@handle) }

/// Return `true` if this is an IPv6 address.
#stable(since = "0.1")
export fn SocketAddr @is_v6() -> bool { socket_addr_is_v6(@handle) }

/// Return a human-readable "host:port" string.
#stable(since = "0.1")
export fn SocketAddr @to_str() -> str { socket_addr_to_str(@handle) }

// Package-private factory: wrap a CSocketAddr into a SocketAddr.
// Used by tcp.nv / udp.nv / dns.nv handlers which cannot access priv fields directly.
fn SocketAddr._from_raw(h CSocketAddr) -> SocketAddr => { handle: h }

// ─── Error-construction helpers ──────────────────────────────────────────────
//
// The payload variant `NetError.InvalidAddr(s)` is constructed via a regular
// (non-handler) fn so the checker annotates the Path-call return type. This
// mirrors tcp.nv's `net_error()`/`tcp_result_err()` helpers and keeps the
// variant construction out of any effect-handler body.
fn addr_invalid(s str) -> Result[SocketAddr, NetError] => Err(NetError.InvalidAddr(s))
fn addr_invalid_port() -> Result[SocketAddr, NetError] => Err(NetError.InvalidPort)
