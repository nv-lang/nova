// SPDX-License-Identifier: MIT OR Apache-2.0
// DEPRECATED (план 183 Ф.3): модуль заменён std/net2; удаление после санации nova_tests (план 182).
// Plan 91.12 Ф.2 / Plan 178 Ф.0.5: std/net effect — single unified `Net` effect.
//
// Effects provide a mockable dispatch point for network operations.
// Concrete handlers: real_net() (tcp.nv) / mock_net() (mock.nv).
//
// Effect operations take/return public Nova value types (SocketAddr, etc.),
// not raw C handles. Handlers unwrap/wrap .handle internally.
//
// All fallible operations return Result[T, NetError] so error handling is
// explicit and uniform at the call site. Operations that wait on I/O park the
// calling fiber inside the effect handler (real_net), resuming it when the
// libuv event loop completes the request; the caller sees a plain
// synchronous-looking call carrying only the `Net` effect.
//
// D173/D301: std/net effect family spec (amended Plan 178 Ф.0.5 — TCP-split
// byte-surface). D365: net effect family (ex-D291 TcpNet/UdpNet/DnsNet)
// reconciled to spec D62's single canonical `Net` (04-effects.md:2990) —
// [M-net-merge-to-single-effect].

module std.net

// ─── Plan 178 Ф.0.5: TcpNet + UdpNet + DnsNet merged into one `Net` effect ────
//
// Spec D62 (04-effects.md:2990) canonises ONE `Net` effect for "сетевые
// запросы". Plan 91.12 had split it into TcpNet/UdpNet/DnsNet (ex-D291); that
// granularity was an unblessed divergence from the canon. The merge returns the
// code to spec: one effect, one `real_net()` handler (~37 ops: tcp+udp+dns), one
// `mock_net()`. AddrNet retracted separately — its ops do no I/O, so they are
// pure `.nv` calling the `extern "C"` address FFI directly (FFI ≠ effect); see
// addr.nv.
//
// ─── Effect-operation naming convention (Plan 91.15 P2) ──────────────────────
//
// These effect operations are internal dispatch points; user code never calls
// them directly (it uses the @method() API on TcpListener/TcpStream/UdpSocket).
// Operation names follow a per-handle prefix so the receiver type is obvious at
// the dispatch site:
//
//   listener_*    — operations on a TcpListener   (listener_local_port, …)
//   stream_*      — operations on a TcpStream      (stream_local_addr, …)
//   read_half_*   — operations on a TcpReadHalf    (Plan 91.16 split)
//   write_half_*  — operations on a TcpWriteHalf   (Plan 91.16 split)
//   socket_*      — operations on a UdpSocket       (socket_local_port, …)
//
// Exceptions (intentional, verb implies receiver): accept / connect / write /
// write_all / read / send_to / recv_from / lookup and the close_<kind> family
// (close_stream / close_listener / close_socket / split_stream). The two
// constructors that would otherwise collide after the merge are disambiguated
// by protocol prefix: `tcp_bind` (→ TcpListener) and `udp_bind` (→ UdpSocket).
//
// Byte-surface note (Plan 178 Ф.0.5): the `[]u8` read/write/send/recv methods
// (TcpStream.@read_bytes / @write_bytes / …, UdpSocket.@send_to_bytes / …) are
// NOT effect operations — they are thin public wrappers over the `str`-carrying
// ops below (str↔[]u8 conversion in the public method; the C transport is
// already length-delimited so the round-trip is byte-clean). See tcp.nv/udp.nv.

// Net -- unified TCP + UDP + DNS transport operations.
//
// All fallible operations return Result[T, NetError].
// Operations that wait on I/O (accept, connect, write, read, send_to,
// recv_from, lookup) park the calling fiber inside the handler and resume it
// from the libuv event loop.
#stable(since = "0.1")
export type Net effect {
    // ── TCP ──────────────────────────────────────────────────────────────────
    tcp_bind(addr SocketAddr) -> Result[TcpListener, NetError]
    accept(listener TcpListener) -> Result[TcpStream, NetError]
    connect(addr SocketAddr) -> Result[TcpStream, NetError]
    write(stream TcpStream, data str) -> Result[int, NetError]
    write_all(stream TcpStream, data str) -> Result[(), NetError]
    read(stream TcpStream, max int) -> Result[str, NetError]
    close_stream(stream TcpStream) -> ()
    close_listener(listener TcpListener) -> ()
    listener_local_port(listener TcpListener) -> u16
    listener_local_addr(listener TcpListener) -> SocketAddr
    stream_local_port(stream TcpStream) -> u16
    stream_peer_port(stream TcpStream) -> u16
    stream_local_addr(stream TcpStream) -> SocketAddr
    stream_peer_addr(stream TcpStream) -> SocketAddr
    // Socket options — stubs in real_net for now (Ф.6).
    set_nodelay(stream TcpStream, on bool) -> ()
    set_keepalive(stream TcpStream, on bool) -> ()
    set_reuse_address(listener TcpListener, on bool) -> ()

    // ── Plan 91.16 / D300: TcpStream split into read + write halves ──
    // split_stream consumes the stream and yields two halves that may be used
    // concurrently from separate fibers (independent C-side park slots).
    split_stream(stream TcpStream) -> (TcpReadHalf, TcpWriteHalf)
    read_half_read(half TcpReadHalf, max int) -> Result[str, NetError]
    read_half_close(half TcpReadHalf) -> ()
    read_half_local_port(half TcpReadHalf) -> u16
    read_half_peer_port(half TcpReadHalf) -> u16
    read_half_local_addr(half TcpReadHalf) -> SocketAddr
    read_half_peer_addr(half TcpReadHalf) -> SocketAddr
    write_half_write(half TcpWriteHalf, data str) -> Result[int, NetError]
    write_half_write_all(half TcpWriteHalf, data str) -> Result[(), NetError]
    write_half_close(half TcpWriteHalf) -> ()
    write_half_local_port(half TcpWriteHalf) -> u16
    write_half_peer_port(half TcpWriteHalf) -> u16
    write_half_local_addr(half TcpWriteHalf) -> SocketAddr
    write_half_peer_addr(half TcpWriteHalf) -> SocketAddr

    // ── UDP ──────────────────────────────────────────────────────────────────
    udp_bind(addr SocketAddr) -> Result[UdpSocket, NetError]
    send_to(sock UdpSocket, data str, addr SocketAddr) -> Result[int, NetError]
    recv_from(sock UdpSocket, max int) -> Result[(str, SocketAddr), NetError]
    close_socket(sock UdpSocket) -> ()
    socket_local_port(sock UdpSocket) -> u16
    socket_local_addr(sock UdpSocket) -> SocketAddr

    // ── DNS ──────────────────────────────────────────────────────────────────
    // Async DNS resolution (uv_getaddrinfo). Parks via callback (net.c).
    // V2: returns ALL resolved addresses as []SocketAddr.
    lookup(host str, port u16) -> Result[[]SocketAddr, NetError]
}
