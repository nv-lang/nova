// DEPRECATED (план 183 Ф.3): модуль заменён std/net2; удаление после санации nova_tests (план 182).
// Plan 91.13 Ф.0 / Plan 178 Ф.0.5: std/net/dns.nv — SocketAddr.lookup.
//
// DNS resolution (uv_getaddrinfo) is genuine network I/O + parking, so it stays
// in the `Net` effect (unlike the pure address ops in addr.nv). The concrete
// handler is real_net() (tcp.nv); the operation parks the calling fiber via the
// uv_getaddrinfo callback (net.c) and returns ALL resolved addresses.
//
// D295: DNS is part of the unified net effect family (D365).

module std.net

/// Resolve a hostname and port to a []SocketAddr using the ambient `Net` effect.
///
/// Returns all resolved addresses, or `Err(NetError....)` on failure.
/// Parks the calling fiber until resolution completes (requires a spawned fiber).
///
/// # Example
///
/// ```nova
/// with Net = real_net() {
///     supervised {
///         spawn {
///             ro addrs = SocketAddr.lookup("example.com", 80)!!
///             // addrs[0] is the first resolved address
///         }
///     }
/// }
/// ```
#stable(since = "0.1")
export fn SocketAddr.lookup(host str, port u16) Net -> Result[[]SocketAddr, NetError] {
    Net.lookup(host, port)
}
