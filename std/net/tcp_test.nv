// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 183 Ф.2 — TCP over the public net2 API (value SocketAddr, consume handles,
// byte-surface `Net` effect). Two-fiber loopback echo — the exact scenario that
// deterministically segfaulted on the old net.c TLS layer; here read writes the
// network bytes straight into the caller's []u8 (zero static slots).
//
// NOTE on `_must`: `!!` on a `Result[_, NetError]` re-throws via `Fail[E]`
// (core.nv), whose inline lowering only supports `E = str` (typed-error unwrap is
// a pre-existing compiler gap — even `parse_int()!!` fails to build). Net
// tests therefore extract typed Results via a `match` helper (the same choice the
// old std/net dns tests made). This is a test-file peer of module std.net2, so
// the helper is shared across all net2 `*_test.nv` files and never ships.
//
// Plan 176 Ф.4 (Q3): `TcpStream.@read`/`@write` now return `io.IoError`
// (io.Read/io.Write conformance), while every other `Net`-effect op
// (bind/connect/accept/write_all/read_to_vec/...) still returns `NetError` —
// `must_io` is the `IoError` twin of `must`, used ONLY at direct `@read`/
// `@write` call sites below.

module std.net

import std.io.{IoError}

// Module-private `panic` decl (mirrors std/collections/vec/core.nv): a folder-
// module peer cannot rely on the prelude `panic` being visible when these test
// bodies are compiled as a dependency of an external importer of `std.net2`.
extern "nova" fn panic(msg str) -> never

// Shared test helper: extract a typed Result or abort the test.
fn must[T](r Result[T, NetError]) -> T {
    match r {
        Ok(v)  => v
        Err(e) => panic("net2 test: unexpected Err: " + e.to_str())
    }
}

// `IoError` twin of `must` (Ф.4 io.Read/io.Write conformance on TcpStream).
fn must_io[T](r Result[T, IoError]) -> T {
    match r {
        Ok(v)  => v
        Err(e) => panic("net2 test: unexpected Err: " + e.to_str())
    }
}

test "net2/tcp: two-fiber loopback echo through the Net effect" {
    with Net = real_net() {
        mut lst = must(TcpListener.bind(SocketAddr.loopback(0)))
        ro port = lst.local_port()
        assert(port > 0)

        supervised {
            spawn {
                mut conn = must(TcpStream.connect(SocketAddr.loopback(port)))
                assert(must_io(conn.write("hello net2".bytes())) == 10)
                mut buf []u8 = []u8.new()
                buf.resize(64, 0 as u8)
                ro n = must_io(conn.read(buf))
                assert(n == 16)
                assert(unsafe { str.from_bytes_unchecked(buf[0..n]) } == "echo: hello net2")
                conn.close()
            }
            spawn {
                mut srv = must(lst.accept())
                mut buf []u8 = []u8.new()
                buf.resize(64, 0 as u8)
                ro n = must_io(srv.read(buf))
                assert(n == 10)
                ro msg = unsafe { str.from_bytes_unchecked(buf[0..n]) }
                assert(msg == "hello net2")
                assert(must_io(srv.write(("echo: " + msg).bytes())) == 16)
                srv.close()
            }
        }

        lst.close()
    }
}

test "net2/tcp: read observes clean EOF as Ok(0)" {
    with Net = real_net() {
        mut lst = must(TcpListener.bind(SocketAddr.loopback(0)))
        ro port = lst.local_port()

        supervised {
            spawn {
                mut conn = must(TcpStream.connect(SocketAddr.loopback(port)))
                conn.close()
            }
            spawn {
                mut srv = must(lst.accept())
                mut buf []u8 = []u8.new()
                buf.resize(16, 0 as u8)
                assert(must_io(srv.read(buf)) == 0)   // clean EOF, not garbage / hang
                srv.close()
            }
        }

        lst.close()
    }
}

test "net2/tcp: read_text / write_str text conveniences" {
    with Net = real_net() {
        mut lst = must(TcpListener.bind(SocketAddr.loopback(0)))
        ro port = lst.local_port()

        supervised {
            spawn {
                mut conn = must(TcpStream.connect(SocketAddr.loopback(port)))
                assert(must(conn.write_str("ping")) == 4)
                assert(must(conn.read_text(32)) == "pong")
                conn.close()
            }
            spawn {
                mut srv = must(lst.accept())
                assert(must(srv.read_text(32)) == "ping")
                assert(must(srv.write_str("pong")) == 4)
                srv.close()
            }
        }

        lst.close()
    }
}

test "net2/tcp: connect to a refused port yields Err (closed socket → NetError)" {
    with Net = real_net() {
        supervised {
            spawn {
                // Loopback port 1 (tcpmux) — nothing listens → immediate RST →
                // ConnectionRefused. A failing op must surface a typed NetError,
                // not crash or hang.
                match TcpStream.connect(SocketAddr.loopback(1)) {
                    Ok(s)  => { s.close() assert(false) }   // must not connect
                    Err(_) => { assert(true) }              // refused / unreachable
                }
            }
        }
    }
}

test "net2/tcp: from_str rejects a malformed address" {
    match SocketAddr.from_str("this is not an address") {
        Ok(_)  => assert(false)
        Err(e) => assert(e.to_str().contains("invalid address"))
    }
}

test "net2/tcp: from_str round-trips a v4 literal" {
    ro a = must(SocketAddr.from_str("127.0.0.1:9090"))
    assert(a.is_v4())
    assert(a.port() == 9090)
    assert(a.ip() == "127.0.0.1")
    assert(a.to_str() == "127.0.0.1:9090")
}
