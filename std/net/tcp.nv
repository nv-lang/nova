// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 183 Ф.2: std/net2/tcp.nv — TCP value types + the unified real_net()
// handler (TCP + UDP + DNS). Byte surface throughout (D407).
//
// Layering:
//   ffi.nv     — private C FFI (extern "C", opaque `*()` handles, no export)
//   effect.nv  — the single `Net` effect (byte-surface ops)
//   tcp.nv     — TCP types + public methods + real_net() handler (this file)
//   udp.nv     — UDP type + public methods
//   dns.nv     — resolve()
//   mock.nv    — mock_net() handler
//
// Handles (`TcpListener`/`TcpStream`/halves) are `consume value` records over an
// opaque `*()` C handle; `@close()` consumes, so use-after-close is a COMPILE
// error (D133). Read/write are full-duplex on one handle (independent C-side
// park slots), so a "split" is just handing the same handle to two half-values
// with a refcount close — no duplicate C read/write API (D407 §6).

module std.net

// ─── Value-record handle types ────────────────────────────────────────────────

/// Async TCP listener (server socket). `bind`/`accept`/`close` carry `Net`
/// (accept parks the fiber). `close()` consumes.
#stable(since = "0.1")
export type TcpListener consume value { priv handle *() }

/// Connected async TCP stream. `connect`/`read`/`write`/`close` carry `Net`.
/// `close()` consumes (use-after-close is a compile error, D133).
#stable(since = "0.1")
export type TcpStream consume value { priv handle *() }

/// Read half of a split `TcpStream` (D407 §6). Shares the connection with its
/// sibling `TcpWriteHalf`; the two may run in separate fibers (independent
/// C-side park slots). The socket closes only after BOTH halves close.
#stable(since = "0.1")
export type TcpReadHalf consume value { priv handle *() }

/// Write half of a split `TcpStream` (D407 §6). See `[TcpReadHalf]`.
#stable(since = "0.1")
export type TcpWriteHalf consume value { priv handle *() }

// ─── Package-private factories / helpers ──────────────────────────────────────

fn TcpListener._from_raw(h *()) -> TcpListener => { handle: h }
fn TcpStream._from_raw(h *()) -> TcpStream => { handle: h }
fn TcpReadHalf._from_raw(h *()) -> TcpReadHalf => { handle: h }
fn TcpWriteHalf._from_raw(h *()) -> TcpWriteHalf => { handle: h }

// Null-handle test for a cold-path constructor return.
fn _is_null(p *()) -> bool => (0 as *()) == p

// Result constructors as regular (non-handler) fns so the checker annotates the
// Path-call return type (mirrors the old net.c pattern — variant construction
// must stay out of an effect-handler body).
fn _listener_ok(h *()) -> Result[TcpListener, NetError] => Ok(TcpListener._from_raw(h))
fn _stream_ok(h *()) -> Result[TcpStream, NetError] => Ok(TcpStream._from_raw(h))
fn _err_listener(code int) -> Result[TcpListener, NetError] => Err(NetError.from_code(code))
fn _err_stream(code int) -> Result[TcpStream, NetError] => Err(NetError.from_code(code))
fn _int_ok(n int) -> Result[int, NetError] => Ok(n)
fn _int_err(code int) -> Result[int, NetError] => Err(NetError.from_code(code))
fn _unit_ok() -> Result[(), NetError] => Ok(())
fn _unit_err(code int) -> Result[(), NetError] => Err(NetError.from_code(code))

// Tuple-return helper (codegen tuple inference in handler bodies).
fn _split_pair(rh TcpReadHalf, wh TcpWriteHalf) -> (TcpReadHalf, TcpWriteHalf) => (rh, wh)

// ─── TcpListener public API ───────────────────────────────────────────────────

/// Bind a TCP listener to `addr`. `SocketAddr.loopback(0)` → OS-assigned port
/// (`local_port()` reports it). `Err(NetError.AddressInUse)` if already bound.
#stable(since = "0.1")
export fn TcpListener.bind(addr SocketAddr) Net -> Result[TcpListener, NetError] {
    Net.tcp_bind(addr)
}

/// Accept the next incoming connection (parks; cancel-safe).
#stable(since = "0.1")
export fn TcpListener mut @accept() Net -> Result[TcpStream, NetError] {
    Net.accept(@)
}

/// Local port this listener is bound to.
#stable(since = "0.1")
export fn TcpListener @local_port() Net -> u16 { Net.listener_local_port(@) }

/// Local address this listener is bound to.
#stable(since = "0.1")
export fn TcpListener @local_addr() Net -> SocketAddr {
    mut b = _addr_image()
    Net.listener_local_addr(@, b)
    SocketAddr._from_image(b)
}

/// Set SO_REUSEADDR.
#stable(since = "0.1")
export fn TcpListener mut @set_reuse_address(on bool) Net {
    Net.set_reuse_address(@, on)
}

/// Close the listener (consume).
#stable(since = "0.1")
export fn TcpListener consume @close() Net { Net.close_listener(@) }

// ─── TcpStream public API ─────────────────────────────────────────────────────

/// Connect to a remote TCP address (parks until connected or error).
#stable(since = "0.1")
export fn TcpStream.connect(addr SocketAddr) Net -> Result[TcpStream, NetError] {
    Net.connect(addr)
}

/// Read up to `buf.len()` bytes into `buf`; returns `Ok(n)`. `Ok(0)` = clean EOF
/// (peer closed). The bytes land straight in `buf` (zero-copy).
#stable(since = "0.1")
export fn TcpStream mut @read(buf mut []u8) Net -> Result[int, NetError] {
    Net.read(@, buf)
}

/// Write `data`; returns `Ok(n)` bytes accepted (sent straight from `data`).
#stable(since = "0.1")
export fn TcpStream mut @write(data []u8) Net -> Result[int, NetError] {
    Net.write(@, data)
}

/// Write the entire buffer, looping until all bytes are sent.
#stable(since = "0.1")
export fn TcpStream mut @write_all(data []u8) Net -> Result[(), NetError] {
    mut off = 0
    while off < data.len() {
        match Net.write(@, data[off..data.len()]) {
            Ok(n)  => { if n <= 0 { return Err(NetError.BrokenPipe) } off = off + n }
            Err(e) => { return Err(e) }
        }
    }
    Ok(())
}

/// Read up to `max` bytes, returning them as an owned `[]u8` (empty = EOF).
/// Byte-first convenience over the buffer-fill `@read`.
#stable(since = "0.1")
export fn TcpStream mut @read_to_vec(max int) Net -> Result[[]u8, NetError] {
    mut buf []u8 = []u8.new()
    buf.resize(max, 0 as u8)
    match Net.read(@, buf) {
        Ok(n)  => { buf.truncate(n) Ok(buf) }
        Err(e) => { Err(e) }
    }
}

/// Read up to `max` bytes and decode as UTF-8 text.
///
/// Text convenience over the bytes: `str.from_bytes -> Result[str, Utf8Error]`;
/// invalid UTF-8 surfaces as `NetError.IoError`.
#stable(since = "0.1")
export fn TcpStream mut @read_text(max int) Net -> Result[str, NetError] {
    match @read_to_vec(max) {
        Ok(bytes) => {
            match str.from_bytes(bytes) {
                Ok(s)  => Ok(s)
                Err(_) => Err(NetError.IoError("invalid utf-8 in stream"))
            }
        }
        Err(e) => Err(e)
    }
}

/// Write text as its UTF-8 bytes; returns `Ok(n)` bytes accepted.
#stable(since = "0.1")
export fn TcpStream mut @write_str(s str) Net -> Result[int, NetError] {
    Net.write(@, s.bytes())
}

/// Half-close the write side (TCP FIN); the read side stays open.
#stable(since = "0.1")
export fn TcpStream mut @shutdown() Net -> Result[(), NetError] { Net.shutdown(@) }

/// Local port of this stream.
#stable(since = "0.1")
export fn TcpStream @local_port() Net -> u16 { Net.stream_local_port(@) }

/// Remote peer port of this stream.
#stable(since = "0.1")
export fn TcpStream @peer_port() Net -> u16 { Net.stream_peer_port(@) }

/// Local address of this stream.
#stable(since = "0.1")
export fn TcpStream @local_addr() Net -> SocketAddr {
    mut b = _addr_image()
    Net.stream_local_addr(@, b)
    SocketAddr._from_image(b)
}

/// Remote peer address of this stream.
#stable(since = "0.1")
export fn TcpStream @peer_addr() Net -> SocketAddr {
    mut b = _addr_image()
    Net.stream_peer_addr(@, b)
    SocketAddr._from_image(b)
}

/// Set TCP_NODELAY (disable Nagle).
#stable(since = "0.1")
export fn TcpStream mut @set_nodelay(on bool) Net { Net.set_nodelay(@, on) }

/// Set TCP keepalive.
#stable(since = "0.1")
export fn TcpStream mut @set_keepalive(on bool) Net { Net.set_keepalive(@, on) }

/// Close the stream (consume).
#stable(since = "0.1")
export fn TcpStream consume @close() Net { Net.close_stream(@) }

/// Split into a read half and a write half (consume). The halves share the
/// connection but have independent park slots, so they may be moved into
/// separate fibers and used concurrently; the socket closes after BOTH close.
#stable(since = "0.1")
export fn TcpStream consume @split() Net -> (TcpReadHalf, TcpWriteHalf) {
    ro h = @handle
    Net.mark_split(TcpStream._from_raw(h))
    _split_pair(TcpReadHalf._from_raw(h), TcpWriteHalf._from_raw(h))
}

// ─── TcpReadHalf / TcpWriteHalf public API ───────────────────────────────────

/// Read up to `buf.len()` bytes into `buf`; `Ok(0)` = EOF.
#stable(since = "0.1")
export fn TcpReadHalf mut @read(buf mut []u8) Net -> Result[int, NetError] {
    Net.read(TcpStream._from_raw(@handle), buf)
}

/// Local port of this read half.
#stable(since = "0.1")
export fn TcpReadHalf @local_port() Net -> u16 {
    Net.stream_local_port(TcpStream._from_raw(@handle))
}

/// Close the read half (consume). Closes the socket if the write half is gone.
#stable(since = "0.1")
export fn TcpReadHalf consume @close() Net {
    Net.close_stream(TcpStream._from_raw(@handle))
}

/// Write `data` to the write half; returns `Ok(n)` bytes accepted.
#stable(since = "0.1")
export fn TcpWriteHalf mut @write(data []u8) Net -> Result[int, NetError] {
    Net.write(TcpStream._from_raw(@handle), data)
}

/// Local port of this write half.
#stable(since = "0.1")
export fn TcpWriteHalf @local_port() Net -> u16 {
    Net.stream_local_port(TcpStream._from_raw(@handle))
}

/// Close the write half (consume). Closes the socket if the read half is gone.
#stable(since = "0.1")
export fn TcpWriteHalf consume @close() Net {
    Net.close_stream(TcpStream._from_raw(@handle))
}

// ─── real_net: the unified Net handler (TCP + UDP + DNS) ──────────────────────

/// Concrete `Net` handler over libuv via the net2 C FFI. Install at the root of
/// an async program:
/// ```nova
/// with Net = real_net() { /* network code */ }
/// ```
#stable(since = "0.1")
export fn real_net() -> Effect[Net] => effect Net {
    // ── TCP ──────────────────────────────────────────────────────────────────
    tcp_bind(addr SocketAddr) {
        mut err int = 0                                   // &err → *mut int out-param
        ro h = unsafe { nova_net_tcp_listen(addr._ptr(), 128, &err) }
        if _is_null(h) { _err_listener(err) } else { _listener_ok(h) }
    }
    accept(listener TcpListener) {
        mut err int = 0
        ro h = unsafe { nova_net_tcp_accept(listener.handle, &err) }
        if _is_null(h) { _err_stream(err) } else { _stream_ok(h) }
    }
    connect(addr SocketAddr) {
        mut err int = 0
        ro h = unsafe { nova_net_tcp_connect(addr._ptr(), &err) }
        if _is_null(h) { _err_stream(err) } else { _stream_ok(h) }
    }
    read(stream TcpStream, buf mut []u8) {
        ro n = unsafe { nova_net_tcp_read(stream.handle, buf.ptr(), buf.len()) }
        if n < 0 { _int_err(n) } else { _int_ok(n) }
    }
    write(stream TcpStream, data []u8) {
        ro n = unsafe { nova_net_tcp_write(stream.handle, data.ptr(), data.len()) }
        if n < 0 { _int_err(n) } else { _int_ok(n) }
    }
    shutdown(stream TcpStream) {
        ro rc = unsafe { nova_net_tcp_shutdown(stream.handle) }
        if rc < 0 { _unit_err(rc) } else { _unit_ok() }
    }
    close_stream(stream TcpStream) { unsafe { nova_net_tcp_close(stream.handle) } }
    close_listener(listener TcpListener) { unsafe { nova_net_listener_close(listener.handle) } }
    mark_split(stream TcpStream) { unsafe { nova_net_tcp_mark_split(stream.handle) } }
    listener_local_port(listener TcpListener) => unsafe { nova_net_listener_local_port(listener.handle) }
    listener_local_addr(listener TcpListener, out mut []u8) {
        unsafe { nova_net_listener_local_addr(listener.handle, out.ptr()) }
    }
    stream_local_port(stream TcpStream) => unsafe { nova_net_tcp_local_port(stream.handle) }
    stream_peer_port(stream TcpStream)  => unsafe { nova_net_tcp_peer_port(stream.handle) }
    stream_local_addr(stream TcpStream, out mut []u8) {
        unsafe { nova_net_tcp_local_addr(stream.handle, out.ptr()) }
    }
    stream_peer_addr(stream TcpStream, out mut []u8) {
        unsafe { nova_net_tcp_peer_addr(stream.handle, out.ptr()) }
    }
    set_nodelay(stream TcpStream, on bool) => unsafe { nova_net_tcp_set_nodelay(stream.handle, on) }
    set_keepalive(stream TcpStream, on bool) => unsafe { nova_net_tcp_set_keepalive(stream.handle, on) }
    set_reuse_address(listener TcpListener, on bool) => unsafe { nova_net_listener_set_reuse_address(listener.handle, on) }

    // ── UDP ──────────────────────────────────────────────────────────────────
    udp_bind(addr SocketAddr) {
        mut err int = 0
        ro h = unsafe { nova_net_udp_bind(addr._ptr(), &err) }
        if _is_null(h) { _err_socket(err) } else { _socket_ok(h) }
    }
    send_to(sock UdpSocket, data []u8, addr SocketAddr) {
        ro n = unsafe { nova_net_udp_send_to(sock.handle, data.ptr(), data.len(), addr._ptr()) }
        if n < 0 { _int_err(n) } else { _int_ok(n) }
    }
    recv_from(sock UdpSocket, buf mut []u8, sender mut []u8) {
        ro n = unsafe { nova_net_udp_recv_from(sock.handle, buf.ptr(), buf.len(), sender.ptr()) }
        if n < 0 { _int_err(n) } else { _int_ok(n) }
    }
    close_socket(sock UdpSocket) { unsafe { nova_net_udp_close(sock.handle) } }
    socket_local_port(sock UdpSocket) => unsafe { nova_net_udp_local_port(sock.handle) }
    socket_local_addr(sock UdpSocket, out mut []u8) {
        unsafe { nova_net_udp_local_addr(sock.handle, out.ptr()) }
    }

    // ── DNS ──────────────────────────────────────────────────────────────────
    lookup(host []u8, port u16) {
        mut base int = 0    // C writes the GC-array base pointer here (via &base)
        mut err int = 0
        ro count = unsafe { nova_net_dns_lookup(host.ptr(), host.len(), port, (&base) as *(), &err) }
        if count < 0 { _err_lookup(err) } else { _lookup_ok(base, count) }
    }
}
