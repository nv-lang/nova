// SPDX-License-Identifier: MIT OR Apache-2.0
// DEPRECATED (план 183 Ф.3): модуль заменён std/net2; удаление после санации nova_tests (план 182).
// Plan 91.12 Ф.7 / Plan 178 Ф.0.5: std/net/mock.nv — in-memory mock handler.
//
// Lives in `module std.net` (same module as tcp.nv/udp.nv/addr.nv) so it
// can access priv fields and _from_raw factories without exposing them.
//
// Exports:
//   mock_net() — single `Net` handler (TCP + UDP + DNS) that never touches real
//                sockets. Replaces the ex-triad mock_tcp_net/mock_udp_net/
//                mock_dns_net (Plan 178 Ф.0.5 effect merge). Address ops are pure
//                now (addr.nv), so mock_addr_net is retired.

module std.net

/// In-memory `Net` handler for unit-testing Nova code that depends on `Net`.
///
/// - bind / connect / accept always succeed (return stub handles).
/// - write / send_to return the byte count of the input data.
/// - read / read_half_read return "mock-reply"; recv_from returns ("", loopback(0)).
/// - lookup returns a single loopback SocketAddr at port 0.
/// - local/peer ports return fixed stubs; all options are no-ops.
///
/// # Example
///
/// ```nova
/// import std.net.{SocketAddr, TcpStream, mock_net}
///
/// test "write echo without network" {
///     with Net = mock_net() {
///         mut s = TcpStream.connect(SocketAddr.loopback(0)).unwrap()
///         assert(s.write("hi").unwrap() == 2)
///         s.close()
///     }
/// }
/// ```
#stable(since = "0.1")
export fn mock_net() -> Effect[Net] => effect Net {
    // ── TCP ──────────────────────────────────────────────────────────────────
    tcp_bind(_addr)          => Ok(TcpListener._from_raw(CTcpListener(1 as *())))
    accept(_lst)             => Ok(TcpStream._from_raw(CTcpStream(2 as *())))
    connect(_addr)           => Ok(TcpStream._from_raw(CTcpStream(3 as *())))
    write(_stream, data)     => Ok(data.byte_len())
    write_all(_stream, _data) => Ok(())
    read(_stream, _max)      => Ok("mock-reply")
    close_stream(stream)     { ro _ = stream }
    close_listener(lst)      { ro _ = lst }
    listener_local_port(_lst)         => 4242
    listener_local_addr(_lst)         => SocketAddr._from_raw(socket_addr_loopback(4242))
    stream_local_port(_s)             => 5050
    stream_peer_port(_s)              => 6060
    stream_local_addr(_s)             => SocketAddr._from_raw(socket_addr_loopback(5050))
    stream_peer_addr(_s)              => SocketAddr._from_raw(socket_addr_loopback(6060))
    set_nodelay(_s, _on)              {}
    set_keepalive(_s, _on)            {}
    set_reuse_address(_lst, _on)      {}
    // ── Plan 91.16 / D300: split + half operations ──
    split_stream(_stream)             => _tcp_split_pair(TcpReadHalf._from_raw(CTcpStream(7 as *())), TcpWriteHalf._from_raw(CTcpStream(8 as *())))
    read_half_read(_half, _max)       => Ok("mock-reply")
    read_half_close(half)             { ro _ = half }
    read_half_local_port(_half)       => 5050
    read_half_peer_port(_half)        => 6060
    read_half_local_addr(_half)       => SocketAddr._from_raw(socket_addr_loopback(5050))
    read_half_peer_addr(_half)        => SocketAddr._from_raw(socket_addr_loopback(6060))
    write_half_write(_half, data)     => Ok(data.byte_len())
    write_half_write_all(_half, _data) => Ok(())
    write_half_close(half)            { ro _ = half }
    write_half_local_port(_half)      => 5050
    write_half_peer_port(_half)       => 6060
    write_half_local_addr(_half)      => SocketAddr._from_raw(socket_addr_loopback(5050))
    write_half_peer_addr(_half)       => SocketAddr._from_raw(socket_addr_loopback(6060))

    // ── UDP ──────────────────────────────────────────────────────────────────
    udp_bind(_addr)                => Ok(UdpSocket._from_raw(CUdpSocket(10 as *())))
    send_to(_sock, data, _addr)    => Ok(data.byte_len())
    recv_from(_sock, _max)         => Ok(("", SocketAddr._from_raw(socket_addr_loopback(0))))
    close_socket(sock)             { ro _ = sock }
    socket_local_port(_sock)       => 7070
    socket_local_addr(_sock)       => SocketAddr._from_raw(socket_addr_loopback(7070))

    // ── DNS ──────────────────────────────────────────────────────────────────
    lookup(_host, _port) => Ok([SocketAddr._from_raw(socket_addr_loopback(0))])
}
