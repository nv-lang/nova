// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Plan 118.1 Ф.4 closeout (2026-06-05) — CStr newtype для C-string FFI.
// Copy-based rewrite: Plan 199 Ф.2 (2026-07-11).
//
// Per D418 (retracts D26 §«Nul-termination»): Nova `str` carries NO
// trailing-NUL guarantee — `str` is a pure `{ptr,len}` UTF-8 view/buffer,
// full stop, for literals AND runtime-built strings AND slices alike. There
// is nothing to peek or reuse zero-copy: `s.as_cstr()` ALWAYS allocates a
// fresh GC-managed `len+1`-byte buffer, copies the `len` data bytes, and
// appends a `\0` terminator (after an O(n) embedded-NUL scan). The scan-free
// O(1) hatch is `s.as_cstr_unchecked()` — same copy shape, scan skipped.
//
// Lexical prefix `c"hello"` НЕ нужен — `as_cstr()` is the single canonical
// str → CStr entry point regardless of source (literal / concat / slice);
// there is no zero-copy special case to motivate a dedicated literal form.
//
// Marker closure: [M-118.1-cstr-literal] CLOSED 2026-06-05 — CStr API ships
// как str method, не как lexer extension (unaffected by Plan 199).

module ffi.cstr

/// Opaque C-string handle. Wraps raw `*u8` pointer; instances must
/// satisfy null-terminator invariant: `ptr[strlen(ptr)] == '\0'`. Unlike
/// pre-Plan-199 `str`, this invariant is established BY the `as_cstr()`
/// constructor (a fresh copy), never inherited from source `str` storage.
///
/// Created via `str.as_cstr()` / `str.as_cstr_unchecked()`.
/// ABI: FFI-marshalled to `const char*` (or `char*` for mutable C-string
/// contexts via dedicated mut variant — not in V1).
///
/// **Lifetime warning**: a CStr wraps a pointer into a freshly-allocated
/// GC-managed buffer (owned by the CStr's construction, not by the source
/// `str`) — conservative stack-scan keeps the buffer alive while the CStr
/// (or a copy of its raw pointer) is reachable from the stack. Pass
/// directly to a C-call or keep the CStr binding alive across the call; do
/// not extract and outlive the raw `*u8` past the point where the CStr
/// value itself would go out of scope. An owning always-copy constructor
/// with an explicit free API (`to_cstr()`) is deferred to Plan 118.2
/// ([M-118.1-cstr-to-cstr-distinct-copy]) — not provided in V1 (as_cstr()
/// is already a copy under Plan 199, so `to_cstr()` would be a redundant
/// alias; kept deferred pending a naming pass, not because of a technical
/// gap).
#stable(since = "0.1")
export type CStr(*u8)

// Plan 118.1 Ф.4 closeout — str → CStr conversions. Copy-based rewrite:
// Plan 199 Ф.2 (2026-07-11) — retracts the earlier zero-copy fast path that
// relied on D26's (now-retracted) NUL-termination invariant.
//
// @as_cstr() — scans bytes for an embedded NUL (which would truncate the
//   C-string) and panics if found, then ALWAYS allocates a fresh
//   `len+1`-byte GC-managed buffer, copies the `len` data bytes, and
//   appends a `\0` terminator (D418).
//
// @to_cstr() — NOT provided in V1. See the CStr doc comment above: as_cstr()
//   already returns an owned copy under Plan 199, so a separate `to_cstr()`
//   would be a redundant alias rather than a distinct owning form. Deferred
//   to Plan 118.2 ([M-118.1-cstr-to-cstr-distinct-copy]) pending a naming
//   pass, not a technical gap.
//
// @as_cstr_unchecked() — skips the embedded-NUL scan only; still performs
//   the same copy+terminate as @as_cstr(). Caller asserts no embedded NUL.
//   Marked unsafe per [M-118.1-unsafe-attr-on-external-fn] (Plan 118.1):
//   callers must wrap invocations in `unsafe { ... }` block.

// Embedded-NUL scan: @as_cstr() panics on the first byte==0 (an interior NUL
// would silently truncate the C-string). `panic` is an always-available
// compiler intrinsic ([panic-assert-intrinsic] 2026-07-11) — resolved here
// with no import/redeclaration needed, regardless of cstr.nv's prelude
// status; codegen lowers it to `nv_panic` by name.
// [M-118.1-cstr-nul-check] CLOSED.
// @as_cstr_unchecked() — unsafe escape hatch, scan-free (O(1) savings on the
// scan only — the copy itself is still O(n), same as @as_cstr()).

export fn str @as_cstr() -> CStr { // [M-d410-as-to-migration]
    ro bytes = @bytes()
    for b in bytes {
        if b == 0 {
            panic("as_cstr: embedded NUL byte in str (would truncate C-string)")
        }
    }
    // D418: always a fresh copy — no source-str invariant to reuse.
    mut buf = Vec[u8].new().cap(bytes.len() + 1)
    buf.append(bytes)
    buf.push(0)
    unsafe { CStr(buf.ptr()) }
}

export unsafe fn str @as_cstr_unchecked() -> CStr { // [M-d410-as-to-migration]
    // Scan-free hatch — caller asserts no embedded NUL. Still copies +
    // terminates (D418): there is no zero-copy path left to take, so this
    // differs from @as_cstr() only by skipping the O(n) scan pass.
    ro bytes = @bytes()
    mut buf = Vec[u8].new().cap(bytes.len() + 1)
    buf.append(bytes)
    buf.push(0)
    unsafe { CStr(buf.ptr()) }
}
