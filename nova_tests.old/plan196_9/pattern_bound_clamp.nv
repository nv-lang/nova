// Plan 196.9 [M-primitive-concrete-overload-receiver-dispatch] — positive
// control. A pattern-bound receiver whose concrete type DOES have the
// method (`int`/`f64 @clamp`, both real overloads) must still dispatch by
// TYPE, not silently collide — proves the match-arm scope fix (reusing
// `match_arm_bindings`) does not regress the legitimate-overload case.
module plan196_9.pattern_bound_clamp

fn clamp_some_int(x int, lo int, hi int) -> int =>
    match Some(x) {
        Some(r) => r.clamp(lo, hi),
        None => lo,
    }

fn clamp_some_f64(x f64, lo f64, hi f64) -> f64 =>
    match Some(x) {
        Some(r) => r.clamp(lo, hi),
        None => lo,
    }

test "pattern-bound int/f64 receiver still dispatches @clamp by its own type" {
    assert(clamp_some_int(15, 0, 10) == 10)
    assert(clamp_some_int(-5, 0, 10) == 0)
    assert(clamp_some_f64(1.5, 0.0, 1.0) == 1.0)
    assert(clamp_some_f64(-0.5, 0.0, 1.0) == 0.0)
}
