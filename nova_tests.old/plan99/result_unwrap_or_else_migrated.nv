// Plan 99.3 Ф.4: Result.unwrap_or_else lazy recovery.

module nova_tests.plan99

test "Result[int,str].unwrap_or_else — Ok skip closure" {
    ro r Result[int, str] = Ok(42)
    ro v = r ?? 0
    assert(v == 42)
}

test "Result[int,str].unwrap_or_else — Err invokes f(e)" {
    ro r Result[int, str] = Err("boom")
    // [M-unwrap-twins-retraction] (2026-07-07): `unwrap_or_else` с доступом к
    // error payload ретрактирован (D86 amend) — `??` его отбрасывает; когда
    // ошибка нужна, явный `match`.
    ro v = match r { Ok(x) => x, Err(e) => e.byte_len() }
    assert(v == 4)
}

test "Result[str,int].unwrap_or_else — reversed E type" {
    ro r Result[str, int] = Err(99)
    ro s = match r { Ok(x) => x, Err(n) => str.from(n) }
    assert(s == "99")
}
