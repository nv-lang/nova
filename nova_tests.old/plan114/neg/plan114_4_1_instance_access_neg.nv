// Plan 114.4.1 (D200) NEG: instance.NAME для assoc const → error.

// EXPECT_COMPILE_ERROR E_CONST_INSTANCE_ACCESS

module neg.plan114_4_1_instance_access_neg

type Config {
    name str
}

// [M-assoc-const-out-of-body-syntax] (окно №66): out-of-body каноническая форма.
const Config.VERSION int = 2

test "instance access на assoc const rejected" {
    ro c = Config { name: "x" }
    ro v = c.VERSION
    assert(v == 2)
}
