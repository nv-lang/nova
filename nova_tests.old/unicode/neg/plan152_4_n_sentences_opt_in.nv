// Plan 152.4.6 (criterion): sentence segmentation is part of the OPT-IN
// std.unicode module — NOT in the prelude. Without `import std.unicode`,
// `sentences` is not in scope: the program must not silently compile.
// D410 (2026-07-06): as_sentences → sentences (as_ prefix retracted).
//
// EXPECT_COMPILE_ERROR no field or method `sentences`
module neg.plan152_4_n_sentences_opt_in

test "sentences is undefined without import std.unicode" {
    ro x = "Hi. Bye.".sentences().count()
    assert(x == 2)
}
