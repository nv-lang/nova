// Plan 85.5 Ф.2 — Iterable[T]: str.chars() и str.bytes() в for-in.
//
// `str.chars() -> CharsIter` — codepoint'ы (lazy, D410); `str.bytes() -> ro []u8` —
// сырые UTF-8 байты (zero-copy view). Оба итерируются обычным for-in.
// D178 (Plan 91 Ф.2.6): renamed from chars()/bytes(). D410 (2026-07-06): retired
// as_chars/as_bytes prefix — bare noun names now.
// `.chars().collect()` (generic `Next[T] @collect()`, std.collections.vec_iter)
// materialises the codepoints into an owned `[]char`; it drives the blanket over
// the `value priv(type)` CharsIter — the regression target for
// [M-next-collect-value-record] (formerly a codegen gap that forced the explicit
// push-loop this file used to carry).

module iter.str_iters

import std.collections.vec_iter

fn to_char_vec(s str) -> []char => s.chars().collect()

test "str.chars() — обход codepoint'ов ASCII" {
    mut count = 0
    for c in "hello".chars() {
        count = count + 1
    }
    assert(count == 5)
}

test "str.chars() — Unicode codepoint'ы (не байты)" {
    mut count = 0
    for c in "Привет".chars() {
        count = count + 1
    }
    assert(count == 6)       // 6 codepoint'ов
}

test "str.chars() — значения codepoint'ов" {
    ro cs = to_char_vec("Abc")
    assert(cs.len() == 3)
    assert(cs[0] == 'A')
    assert(cs[1] == 'b')
    assert(cs[2] == 'c')
}

test "str.chars() — первый и последний Unicode codepoint" {
    ro cs = to_char_vec("Привет")
    assert(cs[0] == 'П')
    assert(cs[5] == 'т')
}

test "str.bytes() — сырые UTF-8 байты" {
    mut count = 0
    for b in "Hi".bytes() {
        count = count + 1
    }
    assert(count == 2)
}

test "str.bytes() — Unicode даёт больше байт чем codepoint'ов" {
    ro bs = "Я".bytes()
    assert(bs.len() == 2)        // 'Я' — 2 байта UTF-8
    assert(bs[0] == 0xD0)
    assert(bs[1] == 0xAF)
}

test "str.chars() — пустая строка" {
    mut count = 0
    for c in "".chars() {
        count = count + 1
    }
    assert(count == 0)
}

test "str.chars() — сумма codepoint-значений" {
    mut sum = 0
    for c in "ABC".chars() {
        sum = sum + (c as int)
    }
    assert(sum == 198)          // 65 + 66 + 67
}
