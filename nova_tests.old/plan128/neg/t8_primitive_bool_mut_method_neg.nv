// RETRACTED 2026-08-09 (closes №468, owner decision 2026-08-08/09):
// `E_PRIMITIVE_MUT_METHOD` (Plan 128 Ф.3) is RETIRED — see T6's header
// for the full rationale. `bool` mut @ methods now pass the receiver
// by-pointer (R5) and the mutation IS observable. Superseded by
// `spec_tests/conformance/standalone/p468_primitive_mut_method.nv`.

module neg.t8_primitive_bool_mut_method_neg

fn bool mut @flip() -> () {
    @ = !@
}

test "fn bool mut @flip observably mutates the caller's binding" {
    mut b = true
    b.flip()
    assert(b == false)
}
