// EXPECT_TIMEOUT_MS 20000
// [221.1 #38] repro38g: MINIMAL two-test file, exact copy of repro38b's
// test A (with outer supervised(timeout:) + accept-loop) followed by test C
// (single-shot accept, plain supervised{}, no loop) — dropping everything
// else to find the smallest failing pair.
module scratch38.repro38g

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.time.duration

type ReadAttempt enum
    | Bytes([]u8)
    | TimedOut
    | Errored

fn read_attempt(s mut TcpStream, deadline Monotonic) Net Time -> ReadAttempt {
    ro (tx, rx) = Channel.new(1)
    mut timed_out = false
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(deadline: deadline) {
            spawn consume ws = s.share() {
                match ws.read_to_vec(4096) {
                    Ok(chunk) => { ro _ = tx.try_send(chunk) }
                    Err(_)    => ()
                }
            }
        }
    }
    if timed_out {
        ReadAttempt.TimedOut
    } else {
        match rx.try_recv() {
            Some(chunk) => ReadAttempt.Bytes(chunk)
            None        => ReadAttempt.Errored
        }
    }
}

fn handle_one(stream mut TcpStream, tag str) Net Time {
    ro t0 = Monotonic.now()
    ro idle_dl = t0 + 60.to_seconds()
    ro result = read_attempt(stream, idle_dl)
    ro elapsed = Monotonic.now().elapsed_since(t0).millis()
    match result {
        ReadAttempt.Bytes(chunk) => print("ZZDBG ${tag} Bytes len=${chunk.len().to_str()} elapsed_ms=${elapsed.to_str()}")
        ReadAttempt.TimedOut => print("ZZDBG ${tag} TimedOut elapsed_ms=${elapsed.to_str()}")
        ReadAttempt.Errored => print("ZZDBG ${tag} Errored elapsed_ms=${elapsed.to_str()}")
    }
}

test "instance A: single-shot accept, plain supervised{}" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        supervised {
            spawn {
                consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                    Ok(consume l) => l
                    Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                }
                ro _ = port_tx.try_send(lst.local_port())
                match lst.accept() {
                    Ok(consume stream) => {
                        handle_one(stream, "A")
                        stream.close()
                    }
                    Err(_) => ()
                }
                lst.close()
            }
            spawn {
                ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                match TcpStream.connect(SocketAddr.loopback(port)) {
                    Ok(consume conn) => {
                        consume cli = conn
                        ro _ = cli.write_str("hi")
                        match cli.read_to_vec(4096) {
                            Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                            Err(_) => ()
                        }
                        cli.close()
                    }
                    Err(_) => ()
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        print("ZZDBG A test-done len=${got.len().to_str()}")
    }
}

test "instance C: single-shot accept, plain supervised{} (SECOND test)" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        supervised {
            spawn {
                consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                    Ok(consume l) => l
                    Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                }
                ro _ = port_tx.try_send(lst.local_port())
                match lst.accept() {
                    Ok(consume stream) => {
                        handle_one(stream, "C")
                        stream.close()
                    }
                    Err(_) => ()
                }
                lst.close()
            }
            spawn {
                ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                match TcpStream.connect(SocketAddr.loopback(port)) {
                    Ok(consume conn) => {
                        consume cli = conn
                        ro _ = cli.write_str("hi")
                        match cli.read_to_vec(4096) {
                            Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                            Err(_) => ()
                        }
                        cli.close()
                    }
                    Err(_) => ()
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        print("ZZDBG C test-done len=${got.len().to_str()}")
    }
}
