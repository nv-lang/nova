// EXPECT_TIMEOUT_MS 20000
// [221.1 #38] repro38d: like repro38c (no TcpStream.share()/read at all —
// spawn body just Time.sleep()s), but each test wraps its whole body in
// `with Net = real_net() { ... }` (repro38b's outer wrapper) to isolate
// whether merely ACTIVATING the Net effect handler per-test (independent of
// any actual socket I/O) is what breaks the SECOND supervised(deadline:)
// call.
module scratch38.repro38d

import std.net.{real_net}
import std.time.duration

fn try_once(tag str) Net Time {
    ro (tx, rx) = Channel.new(1)
    mut timed_out = false
    ro t0 = Monotonic.now()
    ro dl = t0 + 60.to_seconds()
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(deadline: dl) {
            spawn {
                (10).to_millis().sleep()
                ro _ = tx.try_send(true)
            }
        }
    }
    ro elapsed = Monotonic.now().elapsed_since(t0).millis()
    if timed_out {
        print("ZZDBG ${tag} TimedOut elapsed_ms=${elapsed.to_str()}")
    } else {
        match rx.try_recv() {
            Some(_v) => print("ZZDBG ${tag} got-value elapsed_ms=${elapsed.to_str()}")
            None     => print("ZZDBG ${tag} NO-VALUE-no-timeout(?!) elapsed_ms=${elapsed.to_str()}")
        }
    }
}

test "try_once A (with Net handler active, no actual sockets)" {
    with Net = real_net() {
        try_once("A")
    }
}

test "try_once B (second call, sequential, same process)" {
    with Net = real_net() {
        try_once("B")
    }
}
