// EXPECT_TIMEOUT_MS 20000
// [221.1 #38] minimal A/B repro: two IDENTICAL trivial serve-loop instances,
// same shape as nova-http's serve() accept loop (bind, `while running {
// match lst.accept() { Ok(consume s) => detach{...}  Err(_) => sleep+retry } }`,
// wrapped in supervised(timeout:)+Fail[TimeoutError] so the loop is bounded),
// run SEQUENTIALLY in one process/file. A is expected PASS; B (identical
// shape, fresh listener/port) is the one 222.7 found empty (got_len==0).
module scratch38.repro38

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.time.duration

test "serve-instance A: trivial connect gets HELLO-A" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        with Fail[TimeoutError] = |_e| {} {
            supervised(timeout: 2.to_seconds()) {
                spawn {
                    consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                        Ok(consume l) => l
                        Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                    }
                    ro _ = port_tx.try_send(lst.local_port())
                    mut running = true
                    while running {
                        match lst.accept() {
                            Ok(consume stream) => {
                                detach consume stream {
                                    ro _ = stream.write_str("HELLO-A")
                                    stream.close()
                                }
                            }
                            Err(_) => {
                                (20).to_millis().sleep()
                            }
                        }
                    }
                    lst.close()
                }
                spawn {
                    ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                    match TcpStream.connect(SocketAddr.loopback(port)) {
                        Ok(consume conn) => {
                            consume cli = conn
                            match cli.read_to_vec(64) {
                                Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                                Err(_) => ()
                            }
                            cli.close()
                        }
                        Err(_) => ()
                    }
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        ro s = unsafe { got.to_str_unchecked() }
        assert(s == "HELLO-A")
    }
}

test "serve-instance B: trivial connect gets HELLO-B (SEQUENTIAL, same process)" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        with Fail[TimeoutError] = |_e| {} {
            supervised(timeout: 2.to_seconds()) {
                spawn {
                    consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                        Ok(consume l) => l
                        Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                    }
                    ro _ = port_tx.try_send(lst.local_port())
                    mut running = true
                    while running {
                        match lst.accept() {
                            Ok(consume stream) => {
                                detach consume stream {
                                    ro _ = stream.write_str("HELLO-B")
                                    stream.close()
                                }
                            }
                            Err(_) => {
                                (20).to_millis().sleep()
                            }
                        }
                    }
                    lst.close()
                }
                spawn {
                    ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                    match TcpStream.connect(SocketAddr.loopback(port)) {
                        Ok(consume conn) => {
                            consume cli = conn
                            match cli.read_to_vec(64) {
                                Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                                Err(_) => ()
                            }
                            cli.close()
                        }
                        Err(_) => ()
                    }
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        ro s = unsafe { got.to_str_unchecked() }
        assert(s == "HELLO-B")
    }
}
