// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc MIR (`rustc_middle::mir::Body`) -- one lowered body per
// declaration: typed locals, basic blocks of statements that end in exactly
// one terminator, local `_0` as the return place; an instance is a pair
// `(DeclId, Substs)` and the substitution is applied when the body is printed,
// not when it is built. Not taken: the levels rustc stacks above it (HIR,
// THIR) -- Carina lowers the green tree once (architecture section 12).
// Role: layer `lower` of the map -- the backend-agnostic form the emitter
//   prints. Sub-plan 274.8, wave M0: the form itself and its one placement
//   door; waves M1-M3 move the emitter's value positions onto it.
// Used by: emit_c (prints it, from M1 on); mono (walks it for call sites, from
//   M3 on); lower_test (the holder that keeps the form compiling from M0 on).
// Guarded by: check-novac-deps.py (the edges lower -> tree / types / diag are
//   rows of section 3), check-novac-arch-class-proofs.py (the placement door is
//   declared here and nowhere else), check-novac-lowering-one-door.py (the
//   emitter's own placement arms only shrink, base moved by hand).

module novac.lower

import ../tree.{Node, AssignOp}
import ../types.{TyId}
import ../diag.{ice}
import ../sem.{VariantRow}

/// A local of the lowered body: `Local(0)` is the return place (rustc `_0`);
/// every other index is a source binding or a temporary, in creation order.
export type Local int

/// The index behind a `Local` -- for the printer and for tests.
export fn raw_local(l Local) -> int => l as int

/// A basic block of the lowered body, by its position in `Fn.blocks`.
export type BlockId int

/// The index behind a `BlockId` -- for the printer and for tests.
export fn raw_block(b BlockId) -> int => b as int

/// What ROLE a local plays -- the printer spells each differently: the return
/// place is `return <v>;`, a binding is declared where it is first assigned
/// (`T name = <v>;`), a temporary is declared by whoever created it and only
/// assigned here (`name = <v>;`).
export type LocalKind enum
    | Return // local 0, the value the body returns (rustc `_0`)
    | Binding // a source binding: declared at its first assignment
    | Temp // a temporary of the lowering: declared by its creator

/// What a local is: its type, its role, and its name. A binding's name is the
/// source name; a temporary's name is the label its creator chose (wave M1
/// keeps the emitter's legacy spellings such as `_novac_if_t7` so the C stays
/// byte-identical; M2 makes the printer name temporaries by index and the
/// label goes).
export type LocalDecl value {
    ty TyId /// the local's type, as the checker's channel recorded it
    kind LocalKind /// return place, binding or temporary -- see LocalKind
    name str /// the binding's source name, or the temporary's label; "" = unnamed
    zero_init bool /// declared as `(T){0}` -- see the note below; set by the LOWERING
}

/// WHY `zero_init` IS A FIELD AND NOT THE PRINTER'S GUESS (wave M2b-2, decision of
/// 2026-09-07). THREE forms declare a result temporary with a zero initialiser, and their
/// reasons are NOT the same -- counted by probe, not by memory (2026-09-08: removing the
/// initialiser changed 28 declarations in 17 corpus files, `_novac_match` 14, `_novac_qq` 8,
/// `_novac_if` 6):
///   * a `match` in value position -- a match on `int` may legally leave values uncovered
///     (274.3/F29) and the oracle answers 0 there; an uninitialised temporary answered
///     whatever the stack held. The zero is REQUIRED;
///   * an `if` in value position, for the same reason on the branch that falls through.
///     Also REQUIRED;
///   * a `??` -- and here the zero is DEFENSIVE, not required: both branches assign the
///     result (`take_payload` in the Some branch, the placement door in the None branch),
///     so no path reads it unassigned. It is kept because this wave's criterion is
///     byte-identical C, and dropping it would be a behaviour question decided in passing.
///     Whether it should stay is a followup of plan 274.8, not a silent choice.
/// Those THREE are the whole set today. The zeroing knows a REASON, and the reason is visible to what
/// sees the FORM -- the lowering. The printer cannot know it without deriving it again,
/// which is deciding twice in two places. A fourth client must NAME its reason, and
/// "by analogy with the others" is not one -- as the three above show, the analogy is
/// already false between them.

/// The local that is not one: the statement-position match hands it to arms
/// that assign nothing (the same shape as `no_ty()` and `no_node()`).
export fn no_local() -> Local => Local(-1)

/// The block that is not one -- the stop a walk of the whole body passes: the root chain
/// runs until a `Return`, so its stop must equal no block at all. Same shape as `no_local`.
export fn no_block() -> BlockId => BlockId(-1)

/// An operand: a read of a local, or -- until wave M2 -- a tree expression the
/// emitter still prints by itself. `Tree` is the bridge the waves of 274.8
/// shrink to nothing; it exists so the form can be adopted position by
/// position without the differential moving by one file.
export type Operand enum Place(Local) | Tree(Node)

/// The right side of an assignment: `Use` reads an operand; `Expr` is the same
/// bridge as `Operand.Tree` for a whole value expression -- the one shape every
/// value position of the language lowers to at M1; `SomePayload` reads the
/// value inside the Option a local holds -- the binder of an `if let` (wave
/// M2b-1b), the first rvalue that is not a tree.
export type Rvalue enum
    | Use(Operand) // a read of an operand
    | Expr(Node) // a tree expression, printed by the emitter (the M1 bridge)
    | SomePayload(Local) // the payload of the Some the local holds (if-let binder)
    | IndexPayload(ElemRead) // the element of a collection local at an index local (for-each binder)
    | VariantField(VariantRead) // field `index` of variant `vrow` of the sum in `scr` (match binder)

/// A payload field of a matched variant (wave M2b-1d): the arm's test proved
/// the sum in `scr` carries `vrow`, so field `index` of its payload is
/// readable -- the printer spells the shell's payload union (INTEROP, named
/// in emit_match.nv).
export type VariantRead value {
    scr Local /// the scrutinee local
    vrow VariantRow /// the variant the arm matched
    slot int /// the field's position in the variant's payload
}

/// The element read of a collection walk (wave M2b-1c): `vec` holds the
/// collection, `idx` the index; the printer spells the shell's `get` of the
/// collection's instance and takes `.value` -- the guard of the loop header
/// proved the index is in range, so the Option is always Some (INTEROP with
/// the shell's Option ABI, named in emit_option.nv).
export type ElemRead value {
    vec Local /// the collection local
    idx Local /// the index local
}

/// `dest = src` -- the ONE way a value reaches a place in the lowered body.
export type AssignStmt value {
    dest Local /// where the value lands
    src Rvalue /// what is computed
}

/// A store into a place the TREE still names -- `target = src` or
/// `target op= src` (wave M2a). The target stays a tree node (a name, a
/// `@field`) until M3 lowers places; the operator is the tree's own: a compound
/// store IS its binary operator plus a store, and the printer spells it from
/// the one form table.
export type StoreStmt value {
    target Node /// the place written, as the source spelled it
    op AssignOp /// `Set`, or `Update(op)` for a compound store
    src Node /// the value stored (the M1 bridge: printed from the tree until M3)
}

/// A statement: an assignment into a local, an expression evaluated for its
/// effects, or a store into a place the tree names.
export type Stmt enum
    | Assign(AssignStmt) // `local = value` -- through the placement door
    | Eval(Rvalue) // an expression in statement position, value dropped
    | Store(StoreStmt) // `place = value` / `place op= value`, place named by the tree
    | Decl(Local) // the local's declaration point (donor: rustc MIR `StorageLive`)

/// What an `If` tests (wave M2b-1b): a boolean expression as the tree spells
/// it (the M1 bridge until M3), or "the Option held by this local carries a
/// value" -- the test an `if let` runs, which the printer spells through the
/// one Option door (`option_some_test`) from the local's type and name.
export type Cond enum
    | Expr(Node) // a boolean expression, printed from the tree
    | IsSome(Local) // the Option in the local is Some

/// The blocks of one `if` (wave M2b-1): the branch entered on a true
/// condition, the branch entered otherwise -- the join itself when the source
/// wrote no `else` -- and the block both branches reach. An `else if` chain is
/// an `els` block with no statements whose own terminator is another `If`
/// with the SAME join (see `begin_else_if`).
export type IfTerm value {
    cond Cond /// what the branch tests -- see Cond
    then BlockId /// entered when `cond` holds
    els BlockId /// entered otherwise; equals `join` when there is no else
    join BlockId /// where both branches continue
    els_braced bool /// the else branch has its own `{ }` -- see the note below
}

/// WHY `els_braced` AND NOT "is this a chain" (wave M2b-2, decision of 2026-09-08). A printer
/// walking sealed blocks must know whether to open a brace after `} else `. The tempting field
/// was "was this opened as a chained if" -- and it is USELESS for printing, which a wave step
/// proved: a chained `if` and a chained `if let` are opened by the SAME door, yet the first
/// continues the `} else ` line while the second sits in braces, because C has no
/// `else <declaration>` and an if-let's first line IS the declaration of its Option temporary
/// (registry #991). The bit that actually decides is read off the TAIL's shape, and the
/// lowering knows it at the call: a block tail and an if-let tail are braced, a chained `if`
/// is not. Whether the head of a chained `if` carries an indent is NOT a field: it is the
/// walk's own state at the moment it recurses into an unbraced else.

/// `for v in lo..hi`: the loop variable -- a binding of the body, created
/// through `named` like any other -- and its bounds, as the tree spells them.
export type RangeHead value {
    var Local /// the loop variable, a `Binding` local of the body
    lo Node /// the lower bound, inclusive
    hi Node /// the upper bound, exclusive
}

/// `for v in <collection>` (wave M2b-1c): the collection's value lands in a
/// binding local ONCE (one evaluation is the contract -- a call head's
/// effects run once), the index is a binding local of int, and the element
/// is a binding local assigned at the top of every iteration from the
/// collection at the index (`Rvalue.IndexPayload`).
export type EachHead value {
    vec Local /// the collection, a binding local holding the head's value
    idx Local /// the index, a binding local of int
    elem Local /// the element binding, assigned at the top of each iteration
}

/// How a loop's header reads (wave M2b-1). The header CARRIES its source form
/// because the C printer spells `while (c)`, `for (nova_int v = lo; v < hi;
/// v++)` and the len/get walk of a collection with different words, and the
/// wave's criterion is byte-identical C.
export type LoopHead enum
    | While(Node) // `while cond`
    | Range(RangeHead) // `for v in lo..hi`
    | Each(EachHead) // `for v in <collection>`: index walk over len/get

/// A loop (wave M2b-1). The block carrying this terminator IS the header: it
/// holds no statements, tests the head, enters `body` or `exit`; the body's
/// last block jumps back to the header (`Goto(head)` -- the back edge is a
/// real edge of the graph, sealed by `end_loop`). Carina's tree has no
/// `break`/`continue` (measured 2026-09-06), so `exit` has one reader, the
/// printer, until those forms arrive.
export type LoopTerm value {
    head LoopHead /// the header's source form
    body BlockId /// entered while the head's test holds
    exit BlockId /// entered when it fails
}

/// What an arm of a `match` tests (wave M2b-1d). One level deep, as the
/// subset's patterns are: an int literal, a variant head (with the other
/// heads of a disjunction `A | B`), a plain binder (any value, under a new
/// name), the wildcard.
export type Pattern enum
    | Lit(Node) // an int literal, compared with the scrutinee
    | Variant(VariantMatch) // a variant head, plus the alternatives of a disjunction
    | Bind // a plain binder: matches anything, the scrutinee under a new name
    | Wild // `_`: matches anything, binds nothing

/// The variant heads an arm accepts: the first written and the rest of a
/// disjunction (empty when the pattern names one variant).
export type VariantMatch value {
    head VariantRow /// the variant written first
    also []VariantRow /// the other heads of `A | B | C`, in order
}

/// One arm of a `Switch`: its pattern, its guard as the tree spells it (the
/// M1 bridge; the guard is tested by an `If` inside the arm's block), and
/// the block its binders and body occupy.
export type SwitchArm value {
    pat Pattern /// what the arm tests
    guard Option[Node] /// the `if` after the pattern, if written
    body BlockId /// the arm's block: binders first, then the body
}

/// A `match` (wave M2b-1d): the first arm whose pattern (and guard) holds is
/// entered, every arm jumps to the join. FIRST-MATCH IS THE TERMINATOR'S
/// MEANING: the C printer emulates it with an if-chain and a `matched` flag,
/// and that flag is the printer's, not the form's.
export type SwitchTerm value {
    scrutinee Local /// the local the match tests
    arms []SwitchArm /// in source order
    join BlockId /// where every arm continues
    uniq int /// the number the printer's names are built from -- see the note below
}

/// WHY `uniq` IS A FIELD (wave M2b-2, decision of 2026-09-08). The C printer emulates
/// first-match with an if-chain and a `matched` flag, and both that flag and the scrutinee are
/// spelled from one number: `_novac_matched_t${uniq}`, `_novac_scr_t${uniq}`. A walk over
/// sealed blocks could recover it only by PARSING the scrutinee local's name -- taking apart a
/// string the lowering composed. A name is data to whoever built it and a riddle to whoever
/// reads it; the number travels as a number.

/// How a block ends. `Unreached` is the state of a block that was reserved
/// but not yet sealed; `finish` refuses a body that still carries one.
export type Terminator enum
    | Return // control leaves the body; the value is in local 0
    | Goto(BlockId) // control continues in the named block
    | If(IfTerm) // two-way branch with a named join (M2b-1)
    | Loop(LoopTerm) // header of a loop with a named exit (M2b-1)
    | Switch(SwitchTerm) // a match: first arm whose test holds, one join (M2b-1d)
    | Unreached // reserved, not yet sealed -- never survives `finish`

/// What `begin_if` hands back and `begin_else` / `end_if` take: the three
/// blocks of one `if`, so the caller never names a block id itself.
export type IfCtx value {
    then BlockId /// entered when the condition holds
    els BlockId /// the else branch, or the join when there is none
    join BlockId /// where the branches continue
}

/// What `begin_loop` hands back and `end_loop` takes.
export type LoopCtx value {
    head BlockId /// the block whose terminator is the `Loop`
    body BlockId /// the first block of the body
    exit BlockId /// where control continues after the loop
}

/// What `begin_switch` hands back and `begin_arm` / `end_arm` / `end_switch`
/// take: the header block (sealed with the `Switch` when the arms are known),
/// the scrutinee local and the join.
export type SwitchCtx value {
    head BlockId /// the block whose terminator becomes the `Switch`
    scr Local /// the scrutinee local
    join BlockId /// where every arm continues
    uniq int /// the number the printer's names are built from -- see SwitchTerm
}


/// A basic block: statements in order, then exactly one terminator.
export type Block {
    stmts []Stmt /// the block's statements, in order
    term Terminator /// how control leaves the block
}

/// One lowered body: its locals and its blocks. `locals[0]` is the return
/// place, `blocks[0]` the entry block.
export type Fn {
    locals []LocalDecl /// `locals[0]` is the return place
    blocks []Block /// `blocks[0]` is the entry block
}

/// Builds one `Fn` in program order. A block is RESERVED (gets its id) before
/// it is SEALED (gets its statements and terminator), so a `Goto` can name a
/// block that is filled later. Statements accumulate in `cur` and belong to
/// the CURRENT block `cur_id` -- the one the structured events below seal
/// when control leaves it (wave M2b-1; until then they belonged to whichever
/// block was sealed next, and no block ever was).
export type FnBuilder {
    locals []LocalDecl /// locals so far; index 0 is the return place
    blocks []Block /// reserved blocks, `Unreached` until sealed
    cur []Stmt /// statements placed since the last seal
    cur_id BlockId /// the reserved block the statements in `cur` belong to
    open_arms []SwitchArm /// arms of the open matches, innermost match last (M2b-1d)
    arm_start []int /// where each open match's arms begin in `open_arms`, innermost last
}

/// A builder whose local 0 is the return place of type `ret_ty` (rustc `_0`)
/// and whose entry block is reserved and current (rustc `START_BLOCK`).
export fn FnBuilder.new(ret_ty TyId) -> FnBuilder {
    mut locals = []LocalDecl.new()
    locals.push(LocalDecl { ty: ret_ty, kind: LocalKind.Return, name: "", zero_init: false })
    mut blocks = []Block.new()
    blocks.push(Block { stmts: []Stmt.new(), term: Terminator.Unreached })
    mut cur = []Stmt.new()
    mut open_arms = []SwitchArm.new()
    mut arm_start = []int.new()
    FnBuilder { locals, blocks, cur, cur_id: BlockId(0), open_arms, arm_start }
}

/// The block the next statement lands in.
export fn FnBuilder @current() -> BlockId => @cur_id

/// The return place of the body under construction.
export fn FnBuilder @ret_place() -> Local => Local(0)

/// A fresh temporary of type `ty`. ITS NAME COMES FROM ITS OWN INDEX (M2c), not from the
/// caller: the local already knows its number, so `_novac_l<i>` is built here, by one
/// scheme for all. Until M2c every site invented its own spelling (`_novac_if_t7`,
/// `_novac_match_t7`, `_novac_qq_t7`) out of the PRINT COUNTER `fresh_uniq` -- so a local's
/// name depended on the order of printing, which wave M2b-2 had just stopped treating as
/// significant. Two names could also collide: the same label handed to two locals printed
/// one C variable for both (measured in `examples_basics_coalesce.nv`).
export fn FnBuilder mut @temp(ty TyId) -> Local {
    ro name = "_novac_l${@locals.len()}"
    @local(ty, LocalKind.Temp, name)
}

/// A local for the source binding `name` of type `ty`.
export fn FnBuilder mut @named(ty TyId, name str) -> Local {
    if name == "" {
        ice("lower: a named local needs a non-empty name -- temporaries go through temp()")
    }
    @local(ty, LocalKind.Binding, name)
}

/// Appends a local and returns its index -- the one place locals are created. A local is
/// born WITHOUT a declaration point: `declare_zeroed` records that separately, the way
/// rustc MIR separates a local from its `StorageLive`.
fn FnBuilder mut @local(ty TyId, kind LocalKind, name str) -> Local {
    ro id = Local(@locals.len())
    @locals.push(LocalDecl { ty, kind, name, zero_init: false })
    id
}

/// The declaration point of a result temporary that starts at zero: the local is marked
/// and a `Decl` statement is recorded HERE, in the block being built. Only the two forms
/// named on `LocalDecl.zero_init` use it; a binding is still declared by its first
/// assignment, which spells its type and value in one line.
export fn FnBuilder mut @declare_zeroed(l Local) -> () {
    ro i = raw_local(l)
    if i < 0 || i >= @locals.len() {
        ice("lower: declaring a local the body never created")
    }
    ro d = @locals[i]
    @locals[i] = LocalDecl { ty: d.ty, kind: d.kind, name: d.name, zero_init: true }
    @cur.push(Stmt.Decl(l))
}

/// The declaration behind a local; an index the body never created is a
/// compiler bug, named as such.
export fn FnBuilder @decl_of(l Local) -> LocalDecl {
    ro i = raw_local(l)
    if i < 0 || i >= @locals.len() {
        ice("lower: asking the declaration of a local the body never created")
    }
    @locals[i]
}

/// The statement recorded last -- the streaming bridge of waves M1/M2a: the
/// emitter prints each statement as it is lowered, until M2b prints sealed
/// blocks. Asking with nothing recorded is a bug.
export fn FnBuilder @last_stmt() -> Stmt {
    if @cur.len() == 0 {
        ice("lower: last_stmt asked before any statement was recorded")
    }
    @cur[@cur.len() - 1]
}

/// Reserves the next block id. The block stays empty and `Unreached` until
/// `seal` fills it.
export fn FnBuilder mut @reserve() -> BlockId {
    ro id = BlockId(@blocks.len())
    @blocks.push(Block { stmts: []Stmt.new(), term: Terminator.Unreached })
    id
}

/// THE placement door (architecture section 3a, root "where a value lands"):
/// the value of `e` lands in `dest`, recorded as `dest = Expr(e)` in the block
/// sealed next. Every value position of the language -- block tail, `=>` body,
/// `return`, initialiser, `??`, if-value, match arm -- lowers through this one
/// function; the emitter's own per-position arms are what 274.8 removes.
export fn FnBuilder mut @place(e Node, dest Local) -> () {
    @cur.push(Stmt.Assign(AssignStmt { dest, src: Rvalue.Expr(e) }))
}

/// The binder of an `if let` (wave M2b-1b): `dest = payload of opt`, recorded
/// in the current block -- the then-branch the Some-test just opened, where
/// the read is safe by construction.
export fn FnBuilder mut @take_payload(dest Local, opt Local) -> () {
    @cur.push(Stmt.Assign(AssignStmt { dest, src: Rvalue.SomePayload(opt) }))
}

/// The element binding of a `for` over a collection (wave M2b-1c): `dest =
/// vec[idx]`, recorded in the current block -- the loop body the header
/// just opened, where the index is in range by the header's test.
export fn FnBuilder mut @take_elem(dest Local, vec Local, idx Local) -> () {
    @cur.push(Stmt.Assign(AssignStmt { dest, src: Rvalue.IndexPayload(ElemRead { vec, idx }) }))
}

/// A statement expression: evaluated, its value dropped.
export fn FnBuilder mut @eval(e Node) -> () {
    @cur.push(Stmt.Eval(Rvalue.Expr(e)))
}

/// A store into a place the tree names: `target = src`, or `target op= src`
/// when `op` is `Update`.
export fn FnBuilder mut @store(target Node, op AssignOp, src Node) -> () {
    @cur.push(Stmt.Store(StoreStmt { target, op, src }))
}

/// Seals block `b` with the statements accumulated since the last seal and
/// the terminator `term`. Sealing a block twice, or one never reserved, is a
/// compiler bug and is named as such.
export fn FnBuilder mut @seal(b BlockId, term Terminator) -> () {
    ro i = raw_block(b)
    if i < 0 || i >= @blocks.len() {
        ice("lower: sealing a block that was never reserved")
    }
    match @blocks[i].term {
        Unreached => { } // the only legal state to seal from
        Return => ice("lower: a block sealed twice (it already returns)")
        Goto(_) => ice("lower: a block sealed twice (it already jumps)")
        If(_) => ice("lower: a block sealed twice (it already branches)")
        Loop(_) => ice("lower: a block sealed twice (it already loops)")
        Switch(_) => ice("lower: a block sealed twice (it already switches)")
    }
    @blocks[i] = Block { stmts: @cur, term }
    @cur = []Stmt.new()
}

/// Seals the CURRENT block with `term` and makes `next` current: the one
/// primitive every structured event below is built from.
fn FnBuilder mut @close(term Terminator, next BlockId) -> () {
    @seal(@cur_id, term)
    @cur_id = next
}

/// Opens an `if`: the statements placed so far end the current block with
/// `If`, and what is placed next belongs to the `then` branch. `has_else`
/// decides whether the else branch is a block of its own or the join itself
/// -- the source knows, the builder does not guess.
export fn FnBuilder mut @begin_if(cond Cond, has_else bool, els_braced bool) -> IfCtx {
    ro join = @reserve()
    @open_if(cond, has_else, join, els_braced)
}

/// Opens an `if` whose join ALREADY exists: the current block ends with `If`
/// and the `then` branch becomes current. `begin_if` reserves the join and
/// comes here; `begin_else_if` comes here with the outer join, so a chain
/// shares one. The emitter calls it directly when it has to print the
/// condition after `begin_else` and before the branch opens.
export fn FnBuilder mut @begin_chained_if(cond Cond, has_else bool, join BlockId,
                                          els_braced bool) -> IfCtx {
    @open_if(cond, has_else, join, els_braced)
}

/// The ONE place an `If` terminator is built. Both public doors delegate here, which is
/// exactly why `els_braced` is a PARAMETER: from inside, the entry door is invisible, and
/// a bit inferred here would come out the same for both forms -- measured in step 3a of
/// wave M2b-2, where that mistake moved the C of one corpus file by one indent.
fn FnBuilder mut @open_if(cond Cond, has_else bool, join BlockId, els_braced bool) -> IfCtx {
    ro then = @reserve()
    ro els = if has_else { @reserve() } else { join }
    @close(Terminator.If(IfTerm { cond, then, els, join, els_braced }), then)
    IfCtx { then, els, join }
}

/// Moves from the `then` branch to the `else` branch: the branch ends with a
/// jump to the join, and what is placed next belongs to `els`. Asking it of
/// an `if` opened without an else branch is a compiler bug, named as such.
export fn FnBuilder mut @begin_else(c IfCtx) -> () {
    if c.els == c.join {
        ice("lower: begin_else on an if that was opened without an else branch")
    }
    @close(Terminator.Goto(c.join), c.els)
}

/// `else if`: the else branch of `outer` is a block with no statements whose
/// terminator is a second `If` sharing the outer join. Hands back the inner
/// context; its `end_if` closes onto the shared join, after which the outer
/// `end_if` finds the join current and has nothing to seal.
/// THE door for "an else followed by a chain". Until 2026-09-08 the emitter opened this
/// pair BY HAND in two places (`lower_if`, `lower_if_let`) and only a builder test called
/// the door -- one concept, two implementations, and the hand-written pair would not have
/// followed a change to the door (registry #991 is that class). The emitter now comes here.
export fn FnBuilder mut @begin_else_if(outer IfCtx, cond Cond, has_else bool,
                                       els_braced bool) -> IfCtx {
    @begin_else(outer)
    @begin_chained_if(cond, has_else, outer.join, els_braced)
}

/// Closes an `if`: the open branch jumps to the join, and what is placed next
/// belongs to the join. When the join is ALREADY current -- the else branch
/// was an `else if` chain that closed onto it -- there is nothing to seal.
export fn FnBuilder mut @end_if(c IfCtx) -> () {
    if @cur_id != c.join {
        @close(Terminator.Goto(c.join), c.join)
    } else {
        // The join is already current: the else branch was an `else if`
        // chain whose inner `end_if` closed onto this very join, so the
        // branch is sealed and there is nothing left to jump from.
    }
}

/// Opens a loop: the current block jumps to a fresh header block, the header
/// carries the `Loop` terminator, and what is placed next belongs to the body.
export fn FnBuilder mut @begin_loop(head LoopHead) -> LoopCtx {
    ro h = @reserve()
    ro body = @reserve()
    ro exit = @reserve()
    @close(Terminator.Goto(h), h)
    @close(Terminator.Loop(LoopTerm { head, body, exit }), body)
    LoopCtx { head: h, body, exit }
}

/// Closes a loop: the body's last block jumps back to the header (the back
/// edge), and what is placed next belongs to the exit.
export fn FnBuilder mut @end_loop(c LoopCtx) -> () {
    @close(Terminator.Goto(c.head), c.exit)
}

/// A binder of a matched variant (wave M2b-1d): `dest = field index of the
/// variant vrow in scr`, recorded in the current block -- the arm's block,
/// where the test just proved the variant.
export fn FnBuilder mut @take_field(dest Local, scr Local, vrow VariantRow, slot int) -> () {
    @cur.push(Stmt.Assign(AssignStmt { dest, src: Rvalue.VariantField(VariantRead { scr, vrow, slot }) }))
}

/// A plain binder (wave M2b-1d): `dest = src`, the scrutinee under a new name
/// -- the first use of the operand rvalue.
export fn FnBuilder mut @copy(dest Local, src Local) -> () {
    @cur.push(Stmt.Assign(AssignStmt { dest, src: Rvalue.Use(Operand.Place(src)) }))
}

/// Opens a `match` on the local `scr`: the current block jumps to a fresh
/// header block, which is sealed with the `Switch` by `end_switch` once the
/// arms are known; nothing is placed in the header meanwhile.
export fn FnBuilder mut @begin_switch(scr Local, uniq int) -> SwitchCtx {
    ro h = @reserve()
    ro join = @reserve()
    @close(Terminator.Goto(h), h)
    @arm_start.push(@open_arms.len())
    SwitchCtx { head: h, scr, join, uniq }
}

/// Opens an arm: a fresh block for its binders and body becomes current.
/// Asked while a previous arm is still open, or a match is not, it is a
/// compiler bug named as such.
export fn FnBuilder mut @begin_arm(c SwitchCtx, pat Pattern, guard Option[Node]) -> () {
    if @cur_id != c.head {
        ice("lower: begin_arm while the previous arm of the match is still open")
    }
    if @arm_start.len() == 0 {
        ice("lower: begin_arm outside of a match")
    }
    ro body = @reserve()
    @open_arms.push(SwitchArm { pat, guard, body })
    @cur_id = body
}

/// Closes an arm: its block jumps to the join; the header is current again.
export fn FnBuilder mut @end_arm(c SwitchCtx) -> () {
    @close(Terminator.Goto(c.join), c.head)
}

/// Closes a `match`: the header is sealed with the `Switch` over the arms
/// collected, and what is placed next belongs to the join.
export fn FnBuilder mut @end_switch(c SwitchCtx) -> () {
    if @arm_start.len() == 0 {
        ice("lower: end_switch without an open match")
    }
    ro start = @arm_start[@arm_start.len() - 1]
    ro _ = @arm_start.pop()
    mut arms = []SwitchArm.new()
    for i in start..@open_arms.len() {
        // The tail moves element by element on purpose: no vector bulk copy exists
        // in the subset novac compiles ITSELF with. Measured 2026-09-07 over all of
        // `novac/src`: a range slice appears only over strings (`lex.nv:476`),
        // `.clone()` has zero uses, `.extend(` has zero, and all 33 `.append(` are
        // string appends. Retired when the subset gains a one-door copy of a vector
        // slice.
        // nova:allow W_MANUAL_SLICE_COPY -- no vector bulk copy in novac's own subset yet
        arms.push(@open_arms[i])
    }
    while @open_arms.len() > start {
        ro _ = @open_arms.pop()
    }
    @seal(c.head, Terminator.Switch(SwitchTerm { scrutinee: c.scr, arms, join: c.join,
                                                 uniq: c.uniq }))
    @cur_id = c.join
}

/// A `return` in the middle of the body: the current block ends with
/// `Return`, and whatever the source wrote after it -- nothing, usually --
/// lands in a fresh block that the enclosing `end_if` / `end_loop` /
/// `end_body` seals (rustc does the same: statements after a return are
/// unreachable but still have a block).
export fn FnBuilder mut @ret() -> () {
    ro next = @reserve()
    @close(Terminator.Return, next)
}

/// The end of the body: the current block returns. After this `finish` holds.
export fn FnBuilder mut @end_body() -> () {
    @seal(@cur_id, Terminator.Return)
}

/// The finished body. Statements placed after the last seal, or a block that
/// was reserved and never sealed, are compiler bugs, named as such.
export fn FnBuilder @finish() -> Fn {
    if @cur.len() > 0 {
        ice("lower: statements were placed after the last sealed block")
    }
    for i in 0..@blocks.len() {
        match @blocks[i].term {
            Unreached => ice("lower: a reserved block was never sealed")
            Return => { } // sealed
            Goto(_) => { } // sealed
            If(_) => { } // sealed
            Loop(_) => { } // sealed
            Switch(_) => { } // sealed
        }
    }
    Fn { @locals, @blocks }
}
