// novac/src/lower -- tests beside the module. The lowered form is a pure data
// structure (wave M0 of sub-plan 274.8), so what is judged is its SHAPE: the
// return place, the one placement door, reserve-before-seal, and -- from wave
// M2b-1 -- the structured events that open and close an `if` and a loop. No
// pipeline, no files: a stand-in tree node is enough, the form does not look
// inside it.

module novac.lower
import ../tree.{Node, NodeKind, NodeId, AssignOp, branch}
import ../types.{TyId}

fn stand_in_expr() -> Node => branch(NodeId(0), NodeKind.Lit, []Node.new())

/// True when `t` is a jump to `to` -- the whole enum is named, so a variant
/// added later has to answer here too.
fn goes_to(t Terminator, to BlockId) -> bool {
    match t {
        Goto(b) => b == to
        Return => false
        If(_) => false
        Loop(_) => false
        Switch(_) => false
        Unreached => false
    }
}

/// True when `t` leaves the body.
fn returns(t Terminator) -> bool {
    match t {
        Return => true
        Goto(_) => false
        If(_) => false
        Loop(_) => false
        Switch(_) => false
        Unreached => false
    }
}

test "a body starts with its return place as local 0 (rustc _0) and its entry block current" {
    mut b = FnBuilder.new(TyId(3))
    assert(b.current() == BlockId(0))
    b.end_body()
    ro f = b.finish()
    assert(f.locals.len() == 1)
    assert(b.ret_place() == Local(0))
    assert(f.blocks.len() == 1)
    assert(f.blocks[0].stmts.len() == 0)
    assert(returns(f.blocks[0].term))
}

test "the placement door records dest = Expr(e) in the current block" {
    mut b = FnBuilder.new(TyId(3))
    ro t = b.temp(TyId(3))
    b.place(stand_in_expr(), t)
    match b.last_stmt() {
        Assign(a) => assert(a.dest == t)
        Eval(_) => assert(false)
        Store(_) => assert(false)
        Decl(_) => assert(false)
        Output(_) => assert(false)
        OutputEnd => assert(false)
    }
    b.end_body()
    ro f = b.finish()
    assert(f.locals.len() == 2)
    assert(t == Local(1))
    assert(f.blocks[0].stmts.len() == 1)
    match f.blocks[0].stmts[0] {
        Assign(a) => assert(a.dest == t)
        Eval(_) => assert(false)
        Store(_) => assert(false)
        Decl(_) => assert(false)
        Output(_) => assert(false)
        OutputEnd => assert(false)
    }
}

test "a store keeps the tree's target and operator; an evaluation keeps only the expression" {
    mut b = FnBuilder.new(TyId(3))
    b.store(stand_in_expr(), AssignOp.Set, stand_in_expr())
    match b.last_stmt() {
        Store(st) => match st.op {
            Set => { } // the operator recorded is the one handed in
            Update(_) => assert(false)
        }
        Assign(_) => assert(false)
        Eval(_) => assert(false)
        Decl(_) => assert(false)
        Output(_) => assert(false)
        OutputEnd => assert(false)
    }
    b.eval(stand_in_expr())
    b.end_body()
    ro f = b.finish()
    assert(f.blocks[0].stmts.len() == 2)
}

test "blocks are reserved before they are sealed, so a Goto names a block filled later" {
    mut b = FnBuilder.new(TyId(3))
    ro first = b.current()
    ro second = b.reserve()
    b.seal(first, Terminator.Goto(second))
    b.eval(stand_in_expr())
    b.seal(second, Terminator.Return)
    ro f = b.finish()
    assert(f.blocks.len() == 2)
    assert(f.blocks[0].stmts.len() == 0)
    assert(f.blocks[1].stmts.len() == 1)
    assert(goes_to(f.blocks[0].term, second))
}

test "a named local keeps its source name; a temporary is named by its own index" {
    mut b = FnBuilder.new(TyId(3))
    ro n = b.named(TyId(5), "count")
    ro t = b.temp(TyId(5))
    b.end_body()
    ro f = b.finish()
    assert(f.locals[raw_local(n)].name == "count")
    // M2c: the caller no longer spells a temporary. Local 0 is the return place, `n` is 1,
    // so `t` is 2 -- and the name follows the index, which is why two temporaries can no
    // longer be handed one and the same spelling.
    assert(f.locals[raw_local(t)].name == "_novac_l2")
    assert(raw_local(t) == 2)
    assert(f.locals[raw_local(n)].ty == TyId(5))
}

test "each local carries its role: the return place, a binding, a temporary" {
    mut b = FnBuilder.new(TyId(3))
    ro n = b.named(TyId(5), "count")
    ro t = b.temp(TyId(5))
    match b.decl_of(b.ret_place()).kind {
        Return => { } // the expected role of local 0
        Binding => assert(false)
        Temp => assert(false)
    }
    match b.decl_of(n).kind {
        Binding => { } // the expected role of a named local
        Return => assert(false)
        Temp => assert(false)
    }
    match b.decl_of(t).kind {
        Temp => { } // the expected role of a temporary
        Return => assert(false)
        Binding => assert(false)
    }
}

// ---- wave M2b-1: structured terminators ------------------------------------

test "an if without else: the else branch IS the join, and end_if seals the branch onto it" {
    mut b = FnBuilder.new(TyId(3))
    ro c = b.begin_if(Cond.Expr(stand_in_expr()), false, false)
    assert(c.els == c.join)
    assert(b.current() == c.then)
    b.eval(stand_in_expr())
    b.end_if(c)
    assert(b.current() == c.join)
    b.end_body()
    ro f = b.finish()
    assert(f.blocks.len() == 3)
    match f.blocks[0].term {
        If(t) => {
            assert(t.then == c.then)
            assert(t.els == c.join)
            assert(t.join == c.join)
        }
        Return => assert(false)
        Goto(_) => assert(false)
        Loop(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
    assert(f.blocks[raw_block(c.then)].stmts.len() == 1)
    assert(goes_to(f.blocks[raw_block(c.then)].term, c.join))
    assert(returns(f.blocks[raw_block(c.join)].term))
}

test "an if with else: three blocks of its own, both branches jump to the one join" {
    mut b = FnBuilder.new(TyId(3))
    // `els_braced: true` -- the else branch of this if is a BLOCK of statements, which is
    // what the printer wraps in its own braces. The chain test below passes false, and the
    // pair is what proves the field MEANS something rather than merely exists.
    ro c = b.begin_if(Cond.Expr(stand_in_expr()), true, true)
    assert(c.els != c.join)
    b.eval(stand_in_expr())
    b.begin_else(c)
    assert(b.current() == c.els)
    b.eval(stand_in_expr())
    b.eval(stand_in_expr())
    b.end_if(c)
    b.end_body()
    ro f = b.finish()
    assert(f.blocks.len() == 4)
    // THE HOLDER of `els_braced` on the TRUE side: the else branch here is a BLOCK of
    // statements, and the printer gives such a branch its own pair of braces. The false side
    // is held by the else-if chain test below. One side alone would prove only that the field
    // EXISTS -- a field hardwired to false would pass it.
    match f.blocks[0].term {
        If(t) => assert(t.els_braced)
        Return => assert(false)
        Goto(_) => assert(false)
        Loop(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
    assert(f.blocks[raw_block(c.then)].stmts.len() == 1)
    assert(f.blocks[raw_block(c.els)].stmts.len() == 2)
    assert(goes_to(f.blocks[raw_block(c.then)].term, c.join))
    assert(goes_to(f.blocks[raw_block(c.els)].term, c.join))
    assert(returns(f.blocks[raw_block(c.join)].term))
}

// ---- THE HOLE THE CORPUS FOUND ON 2026-09-08, CLOSED HERE ------------------
// The holder tested the `begin_else_if` door ALONE (the case below) and stayed
// green on a tree where the corpus iced: `lower_if_let` called `begin_else`
// BEFORE the door -- half of a pair the door does whole -- so the second
// `@close` hit a block already sealed by a `Goto`. Between a sound door and an
// unsound caller the holder had no case at all.
//
// A chained `if let` differs from a chained `if` by EXACTLY ONE thing: its else
// branch opens with a STATEMENT -- the declaration of the Option temporary --
// and only then opens the inner branch. So one door gets two cases here: an
// empty else (below) and an else carrying a statement (this one).
test "an if-let chain: the else block carries the Option temporary before its If, and the join is still shared" {
    mut b = FnBuilder.new(TyId(3))
    ro outer = b.begin_if(Cond.Expr(stand_in_expr()), true, true)
    b.eval(stand_in_expr()) // the then-branch of the outer if
    // THE CALLER'S ORDER, verbatim as `lower_if_let` does it after the fix: the temporary is
    // recorded FIRST, the else branch is opened BY THE DOOR, never by hand before it.
    ro lo = b.named(TyId(3), "_novac_tmp_t1")
    b.place(stand_in_expr(), lo)
    ro inner = b.begin_else_if(outer, Cond.IsSome(lo), true, true)
    assert(inner.join == outer.join)
    b.eval(stand_in_expr()) // the then-branch of the chained if-let
    b.begin_else(inner)
    b.eval(stand_in_expr()) // the final else
    b.end_if(inner)
    b.end_if(outer)
    b.end_body()
    ro f = b.finish()
    // The statement recorded before the door belongs to the block that PRECEDES the branch,
    // not to the else block: that is what the fix changed, and what the corpus judges.
    match f.blocks[raw_block(outer.els)].term {
        If(t) => {
            assert(t.then == inner.then)
            assert(t.join == outer.join)
            assert(t.els_braced)
        }
        Return => assert(false)
        Goto(_) => assert(false)
        Loop(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
}

test "an else-if chain: the else block carries no statement, its If shares the outer join" {
    mut b = FnBuilder.new(TyId(3))
    // `els_braced: false` -- the else branch of the OUTER if is a chained `if`, whose head
    // continues the `} else ` line and therefore needs no braces of its own.
    ro outer = b.begin_if(Cond.Expr(stand_in_expr()), true, false)
    b.eval(stand_in_expr())
    ro inner = b.begin_else_if(outer, Cond.Expr(stand_in_expr()), false, false)
    assert(inner.join == outer.join)
    assert(inner.els == outer.join)
    b.eval(stand_in_expr())
    b.end_if(inner)
    assert(b.current() == outer.join)
    b.end_if(outer) // the join is already current: nothing to seal, no ice
    assert(b.current() == outer.join)
    b.end_body()
    ro f = b.finish()
    // entry, then-outer, join, els-outer (the inner If), then-inner
    assert(f.blocks.len() == 5)
    assert(f.blocks[raw_block(outer.els)].stmts.len() == 0)
    match f.blocks[raw_block(outer.els)].term {
        If(t) => {
            assert(t.then == inner.then)
            assert(t.join == outer.join)
            // THE HOLDER of `els_braced` on the false side: a chained `if` in the else
            // branch is NOT braced. The true side is held by the test above. A field with
            // no reader is a field the next cleanup removes.
            assert(!t.els_braced)
        }
        Return => assert(false)
        Goto(_) => assert(false)
        Loop(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
    assert(goes_to(f.blocks[raw_block(inner.then)].term, outer.join))
}

test "a while loop: the header is its own empty block, the body jumps back to it, the exit continues" {
    mut b = FnBuilder.new(TyId(3))
    b.eval(stand_in_expr()) // before the loop: stays in the entry block
    ro c = b.begin_loop(LoopHead.While(stand_in_expr()))
    assert(b.current() == c.body)
    b.eval(stand_in_expr())
    b.end_loop(c)
    assert(b.current() == c.exit)
    b.end_body()
    ro f = b.finish()
    assert(f.blocks.len() == 4)
    assert(f.blocks[0].stmts.len() == 1)
    assert(goes_to(f.blocks[0].term, c.head))
    assert(f.blocks[raw_block(c.head)].stmts.len() == 0)
    match f.blocks[raw_block(c.head)].term {
        Loop(t) => {
            assert(t.body == c.body)
            assert(t.exit == c.exit)
            match t.head {
                While(_) => { } // the head handed in
                Range(_) => assert(false)
                Each(_) => assert(false)
            }
        }
        Return => assert(false)
        Goto(_) => assert(false)
        If(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
    assert(goes_to(f.blocks[raw_block(c.body)].term, c.head))
    assert(returns(f.blocks[raw_block(c.exit)].term))
}

test "a range loop keeps its variable -- a binding local -- and its bounds in the header" {
    mut b = FnBuilder.new(TyId(3))
    ro i = b.named(TyId(3), "i")
    ro c = b.begin_loop(LoopHead.Range(RangeHead { var: i, lo: stand_in_expr(), hi: stand_in_expr() }))
    b.end_loop(c)
    b.end_body()
    ro f = b.finish()
    match f.blocks[raw_block(c.head)].term {
        Loop(t) => match t.head {
            Range(r) => {
                assert(r.var == i)
                assert(f.locals[raw_local(r.var)].name == "i")
            }
            While(_) => assert(false)
            Each(_) => assert(false)
        }
        Return => assert(false)
        Goto(_) => assert(false)
        If(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
}

test "a for over a collection: the header carries vec/idx/elem locals, the body starts by reading vec[idx]" {
    mut b = FnBuilder.new(TyId(3))
    ro v = b.named(TyId(11), "_novac_tmp_t1")
    b.place(stand_in_expr(), v)
    ro i = b.named(TyId(3), "_novac_i_t2")
    ro e = b.named(TyId(7), "x")
    ro c = b.begin_loop(LoopHead.Each(EachHead { vec: v, idx: i, elem: e }))
    b.take_elem(e, v, i)
    match b.last_stmt() {
        Assign(a) => {
            assert(a.dest == e)
            match a.src {
                IndexPayload(r) => {
                    assert(r.vec == v)
                    assert(r.idx == i)
                }
                SomePayload(_) => assert(false)
                Expr(_) => assert(false)
                Use(_) => assert(false)
                VariantField(_) => assert(false)
                Read(_) => assert(false)
            }
        }
        Eval(_) => assert(false)
        Store(_) => assert(false)
        Decl(_) => assert(false)
        Output(_) => assert(false)
        OutputEnd => assert(false)
    }
    b.end_loop(c)
    b.end_body()
    ro f = b.finish()
    assert(f.blocks[0].stmts.len() == 1)
    match f.blocks[raw_block(c.head)].term {
        Loop(t) => match t.head {
            Each(h) => {
                assert(h.vec == v)
                assert(h.idx == i)
                assert(h.elem == e)
            }
            While(_) => assert(false)
            Range(_) => assert(false)
        }
        Return => assert(false)
        Goto(_) => assert(false)
        If(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
    assert(f.blocks[raw_block(c.body)].stmts.len() == 1)
    assert(goes_to(f.blocks[raw_block(c.body)].term, c.head))
}

test "an if-let: the Option lands in a binding, the If tests IsSome of it, the binder reads its payload" {
    mut b = FnBuilder.new(TyId(3))
    ro o = b.named(TyId(9), "_novac_tmp_t1")
    b.place(stand_in_expr(), o)
    ro c = b.begin_if(Cond.IsSome(o), false, false)
    ro v = b.named(TyId(3), "v")
    b.take_payload(v, o)
    match b.last_stmt() {
        Assign(a) => {
            assert(a.dest == v)
            match a.src {
                SomePayload(l) => assert(l == o)
                Expr(_) => assert(false)
                Use(_) => assert(false)
                IndexPayload(_) => assert(false)
                VariantField(_) => assert(false)
                Read(_) => assert(false)
            }
        }
        Eval(_) => assert(false)
        Store(_) => assert(false)
        Decl(_) => assert(false)
        Output(_) => assert(false)
        OutputEnd => assert(false)
    }
    b.end_if(c)
    b.end_body()
    ro f = b.finish()
    match f.blocks[0].term {
        If(t) => match t.cond {
            IsSome(l) => assert(l == o)
            Expr(_) => assert(false)
        }
        Return => assert(false)
        Goto(_) => assert(false)
        Loop(_) => assert(false)
        Switch(_) => assert(false)
        Unreached => assert(false)
    }
    assert(f.blocks[0].stmts.len() == 1)
    assert(f.blocks[raw_block(c.then)].stmts.len() == 1)
}

test "a return inside a branch ends the block; what follows lands in a fresh block the end_if seals" {
    mut b = FnBuilder.new(TyId(3))
    ro c = b.begin_if(Cond.Expr(stand_in_expr()), false, false)
    b.place(stand_in_expr(), b.ret_place())
    b.ret()
    ro dead = b.current()
    assert(dead != c.then)
    b.eval(stand_in_expr()) // unreachable in the source, still a statement of a block
    b.end_if(c)
    b.end_body()
    ro f = b.finish()
    assert(f.blocks.len() == 4)
    assert(f.blocks[raw_block(c.then)].stmts.len() == 1)
    assert(returns(f.blocks[raw_block(c.then)].term))
    assert(f.blocks[raw_block(dead)].stmts.len() == 1)
    assert(goes_to(f.blocks[raw_block(dead)].term, c.join))
}
