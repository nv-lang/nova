// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc's `mir_build::matches` -- the lowering of a match lives apart
// from the lowering of everything else, because its vocabulary is its own.
// Role: layer 8 (lower) -- how a `match` becomes a Switch of the lowered
// body: the match, its guard, what an arm's pattern IS, the arm, the body.
// Used by: lowering.nv (the statement and value doors call `@lower_match`).
// Guarded by: check-novac-file-size.py (this file exists because lowering.nv
// crossed 1000 lines after the F65 hoist landed in it).
// novac/src/lower/lower_match.nv -- a match, lowered.
//
// THE SEAM IS BY MEANING rather than by the count that revealed it: these
// five functions share `Pattern`, `SwitchCtx` and `VariantMatch`, and
// nothing else in the module names any of the three. A folder is one module
// of co-equal files, so nothing is exported and no caller changes.

module novac.lower

import ../sem.{arm_body_at}
import ../sem.{variant_in_sum, is_vrow, no_vrow, VariantRow}
import ../diag.{ice}
import ../sem.{branch_children, pattern_lit_leaf}
import ../sem.{raw_vrow}
import ../sem.{payload_as_seen}
import ../sem.{option_payload}
// The pattern tree's doors (D486): the shape asked ONCE, the parts through
// their own doors -- never slot arithmetic.
import ../sem.{PatShape, pattern_shape, pattern_head_text, pattern_subpatterns}
import ../sem.{pattern_fields, patfield_name, patfield_sub, pattern_rest}
import ../sem.{pattern_name_node, patfield_name_node}
import ../sem.{is_dotdot}
import ../tree.{NodeKind}

// `is_ty` (registry #TBD, the block-tail-arm wave): `@lower_arm_body` reads
// whether the checker recorded a type for a Block arm's body through the
// channel (`@out.type_if_known`), the same door `@lower_block_stmts_fn`
// (lowering.nv) already reads for a tail `MatchExpr`.
import ../types.{is_ty}

/// One `match`, in either position. `dest` is the local the arms' values land in -- a
/// TEMPORARY of the body, numbered by the builder -- or `no_local()` in statement
/// position, where the arms run for effect and nothing holds an answer; declaring a
/// variable for an answer nobody asked for is the shape this compiler keeps refusing
/// elsewhere (wave B5).
///
/// This doc used to say the caller declared `_novac_match_t<uniq>` and that `uniq` named
/// the scrutinee, the result AND the flag. Two of those three moved on 2026-09-09: the
/// scrutinee and the result are temporaries numbered by their own index, and only the
/// printer's `matched` flag is still spelled from `uniq` -- which the BUILDER now mints,
/// so this function no longer takes it. What has not changed is why the number exists at
/// all: it must be unique per body, because Nova lets a name be bound twice in one
/// scope (F30) and a C variable declared twice in one block is invalid C from legal
/// Nova.
///
/// WHAT HOLDS IT MECHANICALLY, and what does not. A number invented here can never
/// enter the author's door: `named` refuses invented names by guard
/// [INV-GUARD: check-novac-invented-name-not-named], which reddens on a literal, on an
/// interpolated name and on a missing door. The MIRROR half -- that a generated name
/// never coincides with a name the author wrote -- holds by construction today (every
/// generated name carries the `_novac_` prefix, which the checker forbids in source
/// identifiers) and is NOT machine-checked here; that is said out loud rather than
/// implied by the mark. [INV-TODO: 274.3 F30 -- nothing checks it]
fn Lowerer mut @lower_match(m Node, dest Local) -> () {
    ro kids = branch_children(m)
    ro scr = kids[1]
    ro scr_t = @out.type_of(scr.id_of())
    // The scrutinee lands in a binding ONCE through the one door: every arm
    // tests the same value, and a call in the scrutinee runs one time.
    // THE SCRUTINEE IS A TEMPORARY OF THE COMPILER, and it can finally say so (2026-09-09).
    // `_novac_scr_t7` was never a name the author wrote, yet `named` was the only door that
    // kept a declaration -- because `kind` decided both the name and the declaration point.
    // `DeclAt` now carries the point, so a `Temp` declared at its first assignment is
    // expressible, and this line stops lying about who invented the name.
    //
    // Slice M2c tried exactly this move and the C stopped compiling: `nova_int T1 = n;`
    // became `T1 = n;`, the declaration gone. That failure is the both-ways proof of the
    // separation -- the same edit is correct only after it.
    ro ls = @ir.temp(scr_t)
    @lower_place(scr, ls)
    if dest != no_local() {
        // The result temporary is declared with its type AND zero-initialised
        // (274.3/F29): a match on `int` may legally leave values uncovered --
        // both compilers accept `match n { 1 => 10  2 => 20 }` -- and the
        // oracle answers 0 there; an uninitialised temporary answered whatever
        // the stack held. `(T){0}` is C99 and fits scalars and structs alike.
        // The declaration is a statement of the body (274.8 M2b-2 step 2); the caller
        // created the local, this door records WHERE it is declared and that it starts
        // at zero -- the reason is on `DeclAt.Zeroed`.
        @ir.declare_zeroed(dest)
    } else {
        // Statement position: no result, nothing to declare.
    }
    // THE FLAG IS THE PRINTER'S: the if-chain needs it to stop at the first
    // arm that held; the `Switch` means first-match by construction.
    ro c = @ir.begin_switch(ls)
    for a in kids {
        if a.kind_of() != NodeKind.MatchArm { continue }
        @lower_arm(a, scr_t, ls, c, dest)
    }
    @ir.end_switch(c)
}

/// The guard of an arm, if the source wrote one -- found by walking the arm's
/// children once; a function with returns, so no Option local is ever
/// reassigned (the oracle miscompiles that shape today, check.nv notes it).
fn Lowerer @guard_of(ak []Node) -> Option[Node] {
    for g in ak {
        if g.kind_of() == NodeKind.Guard {
            return Some(branch_children(g)[1])
        }
    }
    None
}

/// What the arm's pattern IS -- decided once, before anything is printed. The
/// head is asked of the MATCHED SUM through the checker's own door (wave B6,
/// #964): the emitter does not consult the name table, so the two passes
/// cannot disagree on which row a head names. The shape is asked through the
/// ONE door of the pattern tree (D486) and matched exhaustively.
fn Lowerer @pattern_of(pat Node, scr_t TyId) -> Pattern {
    match pattern_shape(pat) {
        Lit => Pattern.Lit(pattern_lit_leaf(pat))
        Wild => Pattern.Wild
        Bind => {
            // A name the sum knows is a payload-less variant; any other name
            // binds the scrutinee.
            match variant_in_sum(@ctx, scr_t, pattern_head_text(pat)) {
                Some(vrow) => Pattern.Variant(VariantMatch { head: vrow, also: []VariantRow.new() })
                None => Pattern.Bind
            }
        }
        Variant => {
            ro found = variant_in_sum(@ctx, scr_t, pattern_head_text(pat))
            ro vrow = found ?? ice("lower: @pattern_of got a variant pattern naming no variant of the matched sum")
            Pattern.Variant(VariantMatch { head: vrow, also: []VariantRow.new() })
        }
        Disj => {
            // The checker held every alternative to a variant of this sum:
            // the first head is the test, the rest travel as `also`.
            mut also = []VariantRow.new()
            mut head = no_vrow()
            mut first = true
            for sub in pattern_subpatterns(pat) {
                match variant_in_sum(@ctx, scr_t, pattern_head_text(sub)) {
                    None => {}
                    Some(hrow) => {
                        if first { head = hrow; first = false } else { also.push(hrow) }
                    }
                }
            }
            Pattern.Variant(VariantMatch { head, also })
        }
        // A tuple or record pattern matches everything of its type: there is
        // no test, only the bindings the arm lays down.
        // A HEADED record pattern naming a variant (`Branch { .. }`) tests the
        // tag exactly as `Branch(..)` does; a head-less one names no variant.
        Tuple | Record => {
            match variant_in_sum(@ctx, scr_t, pattern_head_text(pat)) {
                Some(vrow) => Pattern.Variant(VariantMatch { head: vrow, also: []VariantRow.new() })
                None => Pattern.Wild
            }
        }
        Array => Pattern.ArrayP(array_match_of(pat))
    }
}

/// The LENGTH an array pattern requires of the scrutinee: exact when no
/// `..` is written, otherwise at least the written element count (the rest
/// covers the remainder). Asked of the same tree the checker judged.
fn array_match_of(pat Node) -> ArrayMatch {
    ro subs = pattern_subpatterns(pat)
    if pattern_rest(pat) {
        ArrayMatch { exact: -1, at_least: subs.len() }
    } else {
        ArrayMatch { exact: subs.len(), at_least: 0 }
    }
}

/// Bind whatever a pattern introduces, RECURSIVELY (D486): a binder reads
/// the base; a variant's payload, a tuple's components, a record's fields
/// and an array's elements each read their piece and hand it down. A
/// subpattern that is itself structured reads its piece into a TEMPORARY
/// first -- the same "scrutinee once" contract the destructuring binding
/// holds (M3c), one level per nesting.
fn Lowerer mut @lower_pattern_bind(pat Node, ty TyId, base Local) -> () =>
    @lower_pattern_bind_in(pat, ty, base, []str.new())

/// The same recursion, with the names a DISJUNCTION declared above it (`pre`):
/// a binder of that name assigns the local already declared instead of
/// declaring its own, so whichever alternative held, the arm reads ONE `x`
/// (`@lower_disj_bind`, lower_disj.nv). Empty everywhere else.
/// A position with NO nested tests: the binding, the conditions, the `for`
/// header and a disjunction's alternatives. The checker refuses a refutable
/// subpattern in the first three (D486 s4); a test opened here anyway has no
/// arm to fall through to, so it is a compiler bug named as such.
fn Lowerer mut @lower_pattern_bind_in(pat Node, ty TyId, base Local, pre []str) -> () {
    mut opened = []IfCtx.new()
    @lower_pattern_tests(pat, ty, base, pre, opened)
    if opened.len() > 0 {
        ice("lower: a nested pattern test in a position that has no arm to fall through to")
    }
}

/// THE recursion (registries 1534, 1542): whatever the pattern binds is read
/// out of `base`, and every subpattern with a head of its own -- a literal, a
/// variant, an array length -- opens a synthetic `If` on the value it was read
/// into, pushed on `opened` in the order the reads run. The arm closes them
/// after its body (`@lower_arm`); the root's own test is the arm head.
fn Lowerer mut @lower_pattern_tests(pat Node, ty TyId, base Local, pre []str, mut opened []IfCtx) -> () {
    match pattern_shape(pat) {
        Lit | Wild => {}
        Disj => @lower_disj_bind(pat, ty, base, pre)
        Bind => {
            ro nm = pattern_head_text(pat)
            if is_vrow(variant_in_sum(@ctx, ty, nm) ?? no_vrow()) { return }
            ro l = @binder_local(@out.type_of(pattern_name_node(pat).id_of()), nm, pre)
            @ir.copy(l, base)
        }
        Variant => {
            ro found = variant_in_sum(@ctx, ty, pattern_head_text(pat))
            ro vrow = found ?? ice("lower: @lower_pattern_bind got a variant pattern naming no variant of the sum")
            ro vr = @ctx.variant_rows[raw_vrow(vrow)]
            // THE PAYLOAD READ HAS TWO ABI DOORS (the differential's E1 smoke,
            // wave P3): a SHELL Option stores its payload as `.value`
            // (`take_payload`, emit_option's door), a novac sum as a union
            // member (`take_field`). The question is the SAME one typing
            // asked to let the pattern here at all (`option_payload`) --
            // one judgment, so the two passes cannot disagree. Before P3 no
            // caller reached this arm with a shell Option (match on applied
            // sums is refused, E2-b2), and the if-let read its payload by
            // hand -- which is exactly the second-tree shape the arc removes.
            ro as_option = is_ty(option_payload(@ctx, ty))
            mut i = 0
            for sub in pattern_subpatterns(pat) {
                if i >= vr.payload_cnt { break }
                // AS THE SCRUTINEE SEES IT, the same door the checker asks:
                // for `Option[int]` the payload `T` is `int`.
                ro pt = payload_as_seen(@ctx, ty, @ctx.payload_types[vr.payload_off + i])
                ro rd = if as_option { SubRead.ReadOption } else { SubRead.ReadPayload(vrow, i) }
                @lower_sub(sub, pt, base, rd, pre, opened)
                i += 1
            }
        }
        Tuple => {
            mut i = 0
            for sub in pattern_subpatterns(pat) {
                if i >= @ctx.tys.arg_count(ty) { break }
                ro et = @ctx.tys.arg(ty, i)
                @lower_sub(sub, et, base, SubRead.ReadProj(Projection.Elem(i)), pre, opened)
                i += 1
            }
        }
        Record => {
            match variant_in_sum(@ctx, ty, pattern_head_text(pat)) {
                Some(vrow) => {
                    @lower_variant_record_bind(pat, vrow, base, pre, opened)
                    return
                }
                None => {}
            }
            for f in pattern_fields(pat) {
                ro fname = patfield_name(f)
                // THE CHANNEL, and nothing else: the checker recorded the
                // field's type on the PatField node; this door only spells
                // the decision (the FieldAccess lesson -- the emitter may
                // not ask the field's row, and neither may the lowering).
                ro ft = @out.type_of(f.id_of())
                match patfield_sub(f) {
                    Some(sub) => @lower_sub(sub, ft, base, SubRead.ReadProj(Projection.Field(fname)), pre, opened)
                    None => {
                        ro l = @binder_local(@out.type_of(patfield_name_node(f).id_of()), fname, pre)
                        @ir.read(l, base, Projection.Field(fname))
                    }
                }
            }
        }
        Array => {
            ro elem_t = @ctx.tys.arg(ty, 0)
            // The suffix length first: elements after the `..` count from
            // the end, and their `len - k` needs the count up front.
            mut suffix = 0
            mut after = false
            for c in branch_children(pat) {
                match c {
                    Leaf(_) => {
                        // Elements before the rest count from the front.
                        if is_dotdot(c) { after = true } else { }
                    }
                    Branch { .. } => {
                        // A prefix element or a gap is not the suffix.
                        if after && c.kind_of() == NodeKind.Pattern { suffix += 1 } else { }
                    }
                }
            }
            mut idx = 0
            mut sj = 0
            mut seen_rest = false
            for c in branch_children(pat) {
                match c {
                    Leaf(_) => { if is_dotdot(c) { seen_rest = true } else { // Any other leaf keeps the current side.
                        }
                    }
                    Branch { .. } => {
                        if c.kind_of() == NodeKind.Pattern {
                            if seen_rest {
                                @lower_sub(c, elem_t, base, SubRead.ReadElemEnd(suffix - sj), pre, opened)
                                sj += 1
                            } else {
                                @lower_sub(c, elem_t, base, SubRead.ReadElemAt(idx), pre, opened)
                                idx += 1
                            }
                        } else { // A non-Pattern branch (a recovery gap) binds nothing.
                        }
                    }
                }
            }
        }
    }
}

/// HOW one subpattern's value is read out of its parent: a sum's payload slot
/// (`take_field`), a shell Option's payload (`take_payload`), a tuple element or
/// a record field (`read`), an array element from the front or the back. The
/// reads are the binders' own doors -- a nested test reads through the SAME
/// one, never a second spelling of the payload ABI.
type SubRead enum
    | ReadPayload(VariantRow, int)
    | ReadOption
    | ReadProj(Projection)
    | ReadElemAt(int)
    | ReadElemEnd(int)

/// One read, through the door `rd` names.
fn Lowerer mut @read_sub(dest Local, base Local, rd SubRead) -> () {
    match rd {
        ReadPayload(vrow, slot) => @ir.take_field(dest, base, vrow, slot)
        ReadOption => @ir.take_payload(dest, base)
        ReadProj(p) => @ir.read(dest, base, p)
        ReadElemAt(n) => @ir.take_elem_at(dest, base, n)
        ReadElemEnd(n) => @ir.take_elem_end(dest, base, n)
    }
}

/// ONE subpattern of type `ty`, read out of `base` through `rd` (registries
/// 1534, 1542). A subpattern with a head of its own goes to a temporary, its
/// test opens a synthetic `If` (`@open_sub_test`), and the recursion binds
/// what lies below it INSIDE that `If` -- a payload is read only once its tag
/// held. A plain name reads straight into the binder; a tuple, a plain record
/// or a disjunction goes to a temporary and the recursion.
fn Lowerer mut @lower_sub(sub Node, ty TyId, base Local, rd SubRead, pre []str, mut opened []IfCtx) -> () {
    if @sub_has_test(sub, ty) {
        ro t = @ir.temp(ty)
        @read_sub(t, base, rd)
        @open_sub_test(sub, ty, t, opened)
        @lower_pattern_tests(sub, ty, t, pre, opened)
        return
    } else {
        // No head of its own: the binder or the recursion below.
    }
    match @sub_bind_shape(sub) {
        SubNone => {}
        SubName => {
            ro l = @binder_local(@out.type_of(pattern_name_node(sub).id_of()), pattern_head_text(sub), pre)
            @read_sub(l, base, rd)
        }
        SubNested => {
            ro t = @ir.temp(ty)
            @read_sub(t, base, rd)
            @lower_pattern_tests(sub, ty, t, pre, opened)
        }
    }
}

/// Does the subpattern test something of its own? A literal, a variant head (a
/// bare payload-less one included -- `X(Q)` read `Q` as a binder and died on a
/// type nobody recorded, registry 1542), a record headed by a variant, and an
/// array (its length). A binder, `_`, a tuple and a plain record match any
/// value; a nested disjunction binds through its own switch (lower_disj.nv).
fn Lowerer @sub_has_test(sub Node, ty TyId) -> bool {
    match pattern_shape(sub) {
        Lit | Variant | Array => true
        Wild | Tuple | Disj => false
        Bind | Record => is_vrow(variant_in_sum(@ctx, ty, pattern_head_text(sub)) ?? no_vrow())
    }
}

/// Opens the synthetic `If` of one subpattern's own test on the temporary `t`.
/// A shell Option asks the ONE Option door (`IsSome` / `NotSome`, as the
/// if-let and the while-let do); every other head is the arm head's own test,
/// `Pattern`, printed by the same printer (`Cond.Holds`).
fn Lowerer mut @open_sub_test(sub Node, ty TyId, t Local, mut opened []IfCtx) -> () {
    ro cond = if is_ty(option_payload(@ctx, ty)) {
        ro found = variant_in_sum(@ctx, ty, pattern_head_text(sub))
        ro vrow = found ?? ice("lower: an Option subpattern naming no variant of Option")
        if @ctx.variant_rows[raw_vrow(vrow)].payload_cnt > 0 { Cond.IsSome(t) } else { Cond.NotSome(t) }
    } else {
        Cond.Holds(PatTest { pat: @pattern_of(sub, ty), scr: t })
    }
    opened.push(@ir.begin_if(cond, ElseShape.NoElse))
}

/// Lowers ONE arm of a `match`: records it into the IR, prints its head, then binds
/// whatever the pattern introduces -- a variant's payload fields, or the scrutinee
/// under a new name for a plain binder, or nothing at all for a literal or `_` --
/// emits the body into `dest`, and sets the printer's first-match flag. A guard, if
/// written, wraps the body in a branch of its own.
/// The order is deliberate -- recorded first, printed from the record (M2b-2 step 3a),
/// so that a single later walk can print every arm without reading the tree again.
fn Lowerer mut @lower_arm(arm Node, scr_t TyId, ls Local, c SwitchCtx, dest Local) -> () {
    ro ak = branch_children(arm)
    ro arm_e = ak[arm_body_at(ak) ?? ice("emit_c: a match arm with no body reached the emitter")]
    ro guard = @guard_of(ak)
    ro pattern = @pattern_of(ak[0], scr_t)
    // Recorded first, printed from the record (M2b-2 step 3a). The test itself already
    // read the IR -- `emit_pattern_test` takes the `Pattern` -- so what moves here is the
    // PLACE of the printing, which is what lets one walk print every arm later.
    @ir.begin_arm(c, pattern, guard)
    // THE BINDINGS, recursively: whatever the pattern introduces is read
    // out of the scrutinee local -- payload fields, tuple components,
    // record fields, array elements, or the scrutinee under a new name.
    // A subpattern's own test opens a synthetic `If` around everything below
    // it (registries 1534, 1542); the printer finds the innermost through
    // `checks` and sets the first-match flag there, as it does for a guard.
    mut opened = []IfCtx.new()
    @lower_pattern_tests(ak[0], scr_t, ls, []str.new(), opened)
    @ir.note_arm_checks(opened.len())
    match guard {
        Some(g) => {
            // The guard's head is an `if` like any other: it goes through the ONE head
            // door (`@print_if_head`, emit_flow.nv), which until this step was the third
            // place spelling `    if (` + condition + `) {` by hand.
            ro gcond = Cond.Expr(g)
            // A guard has no else branch at all, and that is now the whole answer: there
            // is no second bit to pass, and no default for anyone to interpret later.
            ro gi = @ir.begin_if(gcond, ElseShape.NoElse)
            @lower_arm_body(arm_e, dest)
            @ir.end_if(gi)
        }
        None => {
            @lower_arm_body(arm_e, dest)
        }
    }
    // The tests close innermost first: each `If` joins into the one around it.
    mut k = opened.len()
    while k > 0 {
        k -= 1
        @ir.end_if(opened[k])
    }
    @ir.end_arm(c)
}

/// The BODY of one arm: assigned to the result local in value position,
/// run for effect in statement position (wave B5). A statement arm's body
/// may be a block (`{}` included) or a single statement, and both go through
/// the doors that already print those shapes.
fn Lowerer mut @lower_arm_body(arm_e Node, dest Local) -> () {
    // AN ARM THAT LEAVES PRODUCES NO VALUE, and that is true in value position
    // too (registry 1191, found by the differential). `match k { A => return n
    // B => 7 }` has one arm of each kind: the checker already answers None for
    // the returning one and int for the other, so the match IS a value. This
    // door did not ask, assigned the `return` statement into the result local
    // as if it were an expression, and the value arm's 7 never arrived: the
    // function returned the local's zero. The oracle printed 7, novac 0, and
    // nothing in between said a word.
    // A BLOCK BODY MAY PLACE A VALUE TOO (registry #TBD, the block-tail-arm
    // wave): whether it does is asked of the CHANNEL, not recomputed here --
    // `lower` has no edge to `check` in the architecture table, and the
    // checker already recorded a type on this exact node when its tail was a
    // value form (`@type_arm`'s Block case, match_arms.nv). A Block that
    // leaves through `return` on every path, or whose tail is not a value
    // form, carries no recorded type, and `is_ty` below answers `false` for
    // it -- the same as before this door existed.
    ro block_places_value = arm_e.kind_of() == NodeKind.Block && is_ty(@out.type_if_known(arm_e.id_of()))
    ro leaves = arm_e.kind_of() == NodeKind.RetStmt || arm_e.kind_of() == NodeKind.LoopCtl ||
                (arm_e.kind_of() == NodeKind.Block && !block_places_value)
    if dest != no_local() && !leaves && !block_places_value {
        // The arm's value lands in the match local through the one door.
        @lower_place(arm_e, dest)
        return
    } else {
        // Statement position, an arm that leaves through `return`, or a Block
        // whose own door (below) already places the value: nothing more to
        // do above.
    }
    if dest != no_local() && block_places_value {
        // The block's tail is the value -- lowered through the same
        // generalized door `@lower_block_stmts_fn`'s own tail=true path
        // uses for a function body, adapted to write `dest` instead of
        // `@ir.ret_place()`.
        @lower_block_stmts_value(arm_e, dest)
        return
    } else {
        // Not a value-placing Block: the remaining shapes below answer.
    }
    // TERMINATOR, not an else: the two shape guards meet on a node-kind test
    // (274.5 section 2g), and a `return` satisfies both.
    if arm_e.kind_of() == NodeKind.Block {
        @lower_block_stmts_fn(arm_e, false)
        return
    }
    @lower_stmt(arm_e)
}
