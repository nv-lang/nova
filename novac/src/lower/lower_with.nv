// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Koka's evidence passing -- `with E = h { body }` evaluates the handler,
// installs it for the dynamic extent of the body and removes it on every exit;
// the slot swap and the interrupt frame are the runtime's ABI (interop), not a
// design taken from anywhere.
// Role: lowering of the `with` statement, the value form (a handler VALUE such
//   as `real_os()`), E.9 step 2 of plan 274.11: each binding's handler is
//   placed in a local, swapped into its effect's thread slot, and the body runs
//   under the scope `ir_with.nv` keeps -- which restores the slots on EVERY
//   exit. A handler LITERAL is step 3 and never reaches here as a literal: its
//   value is placed through the same `lower_place` door as any expression.
// Used by: lowering.nv -- `@lower_stmt`, the WithStmt arm.
// Guarded by: nova test novac/src/pipeline/with_test.nv, and
//   check-novac-differential.sh over novac/fixtures/with_value, with_return.

module novac.lower
import ../tree.{Node, NodeKind}
import ../diag.{ice_at}
import ../sem.{branch_children, leaf_text}

/// A `with` statement (E.9 step 2). The parser's geometry, read the way the
/// checker reads it (`check/with_typing.nv`): `with`, then per binding the
/// effect's name, `=`, the handler expression and an optional `,`; the body
/// Block last. The checker accepted every piece before lowering is asked.
fn Lowerer mut @lower_with(st Node) -> () {
    ro kids = branch_children(st)
    mut swaps = []HandlerSwap.new()
    mut bi = 1
    while bi + 2 < kids.len() {
        ro nm = kids[bi]
        if nm.kind_of() != NodeKind.LeafNode {
            ice_at(
                "novac/src/lower/lower_with.nv:32",
                "lower: a with binding without its effect name reached the lowering")
        }
        ro hexpr = kids[bi + 2]
        // The handler, evaluated ONCE into a local of its own type -- the
        // stack local is the GC root the thread slot is not (the runtime does
        // not scan thread-local storage).
        ro hty = @out.type_of(hexpr.id_of())
        ro h = @ir.temp(hty)
        @lower_place(hexpr, h)
        swaps.push(HandlerSwap { eff: leaf_text(nm), prev: @ir.temp(hty), handler: h })
        bi += 3
        // The checker's reading (`check/with_typing.nv`): a leaf here is the
        // `,` before the next binding; the body is a branch.
        if bi < kids.len() && kids[bi].kind_of() == NodeKind.LeafNode {
            bi += 1
        } else {
            // No `,`: the next child is the body, and the loop ends on its own.
        }
    }
    ro body = kids[kids.len() - 1]
    if body.kind_of() != NodeKind.Block {
        ice_at(
            "novac/src/lower/lower_with.nv:55",
            "lower: a with statement without its body block reached the lowering")
    }
    ro c = @ir.begin_with(swaps)
    @lower_block_stmts_fn(body, false)
    @ir.end_with(c)
}

/// `supervised { body }` (E.9 step 4): the scope opened, the body lowered, the
/// scope joined -- the builder joins it on every other exit too.
///
/// A statement that CARRIES NAMED ARGUMENTS (`timeout:`, `on_timeout:`) takes a
/// different door: its deadline, its handler and its join are ONE C protocol
/// the emitter owns (`emit_c/emit_supervised.nv`, `@emit_supervised_stmt`),
/// and dropping the arguments here was the acceptance's statement-args defect
/// (supervised-value rework). The whole statement is recorded as an
/// evaluation; the printer dispatches on the node's kind.
fn Lowerer mut @lower_supervised(st Node) -> () {
    ro kids = branch_children(st)
    ro body = kids[kids.len() - 1]
    assert(body.kind_of() == NodeKind.Block, "lower: a supervised statement without its body block reached the lowering")
    mut carries_args = false
    for c in kids {
        if c.kind_of() == NodeKind.NamedArg { carries_args = true } else {
            // The keyword leaf, the body Block, or a separator.
        }
    }
    if carries_args {
        @ir.eval(st)
        return
    }
    ro at = @ir.begin_supervised()
    @lower_block_stmts_fn(body, false)
    @ir.end_supervised(at)
}

/// A supervised VALUE body's NON-TAIL statements (supervised-value wave, D414
/// §4): every statement of the block except the last, which is the construct's
/// value and is placed POST-JOIN by the emitter (`@emit_supervised_value`), in
/// a builder of its own. The scope is pushed WITHOUT a `ScopeOpen` statement
/// (`@push_sup_scope`): the emitter prints the queue and the join itself, while
/// the body's `spawn`s still find `q` as their innermost scope (`@spawn_site`).
/// An early `return`/`break` INSIDE a supervised value body is outside this wave
/// -- the statement form and the carried value bodies have none.
fn Lowerer mut @lower_sup_body_non_tail(body Node, q int) -> () {
    ro at = @ir.push_sup_scope(q)
    ro kids = branch_children(body)
    mut last_branch = -1
    mut j = 0
    for c in kids {
        match c {
            Leaf(_) => {}
            Branch { .. } => { last_branch = j }
        }
        j += 1
    }
    mut j = 0
    for c in kids {
        match c {
            Leaf(_) => {} // the block's own braces -- trivia carriers, not statements
            Branch { .. } => {
                // The last statement is the value; the emitter places it after
                // the join, so only the statements before it are lowered here.
                if j != last_branch { @lower_stmt(c) }
            }
        }
        j += 1
    }
    @ir.pop_sup_scope(at)
}

/// A supervised body that runs EAGERLY, every statement before the join: the
/// statement form's shape (D442's deadline covers the block) and the
/// unit-valued construct's (there is no tail value to hold back). The scope is
/// pushed WITHOUT a `ScopeOpen` statement, exactly as in the value door: the
/// emitter prints the queue and the join itself, while the body's `spawn`s
/// still find `q` as their innermost scope (`@spawn_site`).
fn Lowerer mut @lower_sup_body_eager(body Node, q int) -> () {
    ro at = @ir.push_sup_scope(q)
    @lower_block_stmts_fn(body, false)
    @ir.pop_sup_scope(at)
}
