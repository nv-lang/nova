// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/lex — the tokenization door (architecture §2: module `lex`).
//
// Lossless: every byte of the input lands in exactly one token, either as
// leading trivia (whitespace, newlines, `//` comments) or as token text.
// The lead invariant of the whole frontend (architecture §5) starts here:
//     reserialize(lex(src)) == src, byte for byte, for EVERY input,
// including broken input — an unexpected byte becomes an ErrorTok that still
// carries its text. No Result in signatures (274 §4 p.1): lexing always
// returns tokens; brokenness is represented, not thrown.
//
// E1 deviation, recorded: trivia is LEADING-only (the Eof token carries the
// file's tail trivia). Roslyn-style trailing trivia arrives with the green
// tree, where the attachment rule matters for node boundaries; for the
// reserialization invariant leading-only is equivalent and simpler.
//
// Edge table §3: lex -> source only (currently unused: the token stores NO
// absolute positions at all — owner's correction 2026-08-14. Positions are
// DERIVED by prefix-summing leading+text lengths, which the lossless
// invariant makes exact; storing a span alongside would be a second copy of
// the truth with its own consistency invariant — exactly what §5 forbids the
// green layer: widths, not positions. Span stays the position CURRENCY,
// computed by the red layer for diagnostics). Lexer errors do not import
// diag: ErrorTok IS the representation (parse reports it with a position).

module novac.lex

export type TokenKind enum
    | KwModule
    | KwFn
    | Ident
    | IntLit
    | StrLit
    | LParen
    | RParen
    | LBrace
    | RBrace
    | Dot
    | Comma
    | Plus
    | Minus
    | Star
    | Slash
    | ErrorTok
    | Eof

export type Token {
    kind TokenKind
    leading str
    text str
}

fn is_space(b u8) -> bool => b == 32 || b == 9 || b == 13 || b == 10

fn is_digit(b u8) -> bool => b >= 48 && b <= 57

fn is_ident_start(b u8) -> bool =>
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95

fn is_ident_byte(b u8) -> bool => is_ident_start(b) || is_digit(b)

fn keyword_kind(t str) -> TokenKind {
    if t == "module" { return TokenKind.KwModule }
    if t == "fn" { return TokenKind.KwFn }
    TokenKind.Ident
}

fn punct_kind(b u8) -> TokenKind {
    if b == 40 { return TokenKind.LParen }
    if b == 41 { return TokenKind.RParen }
    if b == 123 { return TokenKind.LBrace }
    if b == 125 { return TokenKind.RBrace }
    if b == 46 { return TokenKind.Dot }
    if b == 44 { return TokenKind.Comma }
    if b == 43 { return TokenKind.Plus }
    if b == 45 { return TokenKind.Minus }
    if b == 42 { return TokenKind.Star }
    if b == 47 { return TokenKind.Slash }
    TokenKind.ErrorTok
}

/// Tokenize the whole input. Always succeeds; always covers every byte.
export fn lex(src str) -> []Token {
    ro b = src.bytes()
    ro n = src.byte_len()
    mut toks = []Token.new()
    mut i = 0
    while i < n {
        // Leading trivia: spaces, newlines, // comments (up to newline).
        ro trivia_start = i
        mut in_trivia = true
        while in_trivia && i < n {
            if is_space(b[i]) {
                i += 1
            } else if b[i] == 47 && i + 1 < n && b[i + 1] == 47 {
                while i < n && b[i] != 10 { i += 1 }
            } else {
                in_trivia = false
            }
        }
        ro leading = src[trivia_start..i]
        if i >= n {
            toks.push(Token { kind: TokenKind.Eof, leading, text: "" })
            return toks
        }
        // Token text.
        ro start = i
        ro c = b[i]
        mut kind = TokenKind.ErrorTok
        if is_ident_start(c) {
            while i < n && is_ident_byte(b[i]) { i += 1 }
            kind = keyword_kind(src[start..i])
        } else if is_digit(c) {
            while i < n && is_digit(b[i]) { i += 1 }
            kind = TokenKind.IntLit
        } else if c == 34 {
            // String literal: raw bytes between quotes, escapes kept verbatim
            // (lossless; meaning is parse/check business, not lex).
            //
            // Owner's catch 2026-08-14: Nova strings are CONTEXT-DEPENDENT --
            // "${expr}" nests real tokens (including strings) inside. A flat
            // scan-to-quote would tokenize that PLAUSIBLY BUT WRONG, which is
            // class K7 (silent half-capability). E1 therefore refuses
            // honestly: a string containing `${` lexes as ErrorTok (still
            // lossless), so parse wraps it in Err and the subset boundary is
            // visible. The mode-stack lexer (Roslyn interpolated-string
            // model: compound token, inner tokens recursive) is the E2 step.
            i += 1
            mut has_interp = false
            mut closed = false
            while i < n && !closed {
                if b[i] == 34 {
                    closed = true
                    i += 1
                } else if b[i] == 92 && i + 1 < n {
                    // An escape consumes BOTH bytes and, deliberately, does
                    // not look inside: `\${` is the escaped, literal form and
                    // must NOT flag interpolation (E1 review p.4 -- the old
                    // loop inspected the already-escaped byte).
                    i += 2
                } else {
                    if b[i] == 36 && i + 1 < n && b[i + 1] == 123 { has_interp = true }
                    i += 1
                }
            }
            kind = TokenKind.StrLit
            // Honest refusals, both K7-shaped (E1 review p.4): a string that
            // never closed is not a plausible StrLit, and interpolation is
            // outside the E1 subset (context-dependent lexing is the E2
            // mode-stack step). Either way the bytes stay ours -- lossless.
            if has_interp || !closed { kind = TokenKind.ErrorTok }
        } else {
            kind = punct_kind(c)
            i += 1
        }
        toks.push(Token { kind, leading, text: src[start..i] })
    }
    toks.push(Token { kind: TokenKind.Eof, leading: "", text: "" })
    toks
}

/// The reserialization half of the lead invariant: concatenating every
/// token's leading trivia and text reproduces the input byte for byte.
export fn reserialize(toks []Token) -> str {
    consume out = StringBuilder.new()
    for t in toks {
        out.append(t.leading)
        out.append(t.text)
    }
    out
}
