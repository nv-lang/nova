// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/lex — the tokenization door (architecture §2: module `lex`).
//
// Lossless: every byte of the input lands in exactly one token, either as
// leading trivia (whitespace, newlines, `//` comments) or as token text.
// The lead invariant of the whole frontend (architecture §5) starts here:
//     reserialize(lex(src)) == src, byte for byte, for EVERY input,
// including broken input — an unexpected byte becomes an ErrorTok that still
// carries its text. No Result in signatures (274 §4 p.1): lexing always
// returns tokens; brokenness is represented, not thrown.
//
// E1 deviation, recorded: trivia is LEADING-only (the Eof token carries the
// file's tail trivia). Roslyn-style trailing trivia arrives with the green
// tree, where the attachment rule matters for node boundaries; for the
// reserialization invariant leading-only is equivalent and simpler.
//
// Edge table §3: lex -> source only (currently unused: the token stores NO
// absolute positions at all — owner's correction 2026-08-14. Positions are
// DERIVED by prefix-summing leading+text lengths, which the lossless
// invariant makes exact; storing a span alongside would be a second copy of
// the truth with its own consistency invariant — exactly what §5 forbids the
// green layer: widths, not positions. Span stays the position CURRENCY,
// computed by the red layer for diagnostics). Lexer errors do not import
// diag: ErrorTok IS the representation (parse reports it with a position).

module novac.lex

export type TokenKind enum
    | KwModule
    | KwFn
    | KwIf
    | KwReturn
    | KwFor
    | KwIn
    | KwMut
    | Ident
    | IntLit
    | StrLit
    | LParen
    | RParen
    | LBrace
    | RBrace
    | Dot
    | Comma
    | Plus
    | Minus
    | Star
    | Slash
    | Lt
    | Le
    | Assign
    | PlusAssign
    | DotDot
    | Arrow
    | ErrorTok
    | Eof

export type Token {
    kind TokenKind
    leading str
    text str
}

// [LEGACY-#TBD-char-literal-permissive] TWO oracle inconsistencies around
// char literals, both found 2026-08-14 by dogfooding: (a) the backslash
// literal fails standalone ("expected closing ' in char literal") yet the
// same spelling inside this file was silently accepted and MISCOMPILED;
// (b) a char literal containing a RAW control byte (tab / CR / LF, even
// spanning lines) is silently accepted with garbage semantics -- that is how
// this very lexer shipped a broken is_space: the built binary looped
// allocating until Boehm died with "Too many heap sections" (the owner's
// screenshot). Canon per std (json.nv B_* consts): special bytes as hex
// constants, printable ones as ('x' as u8). Escalate to the integrator for
// the number and the registry row; self-expiring: when the checker REJECTS
// raw control bytes in char literals, the neg fixture will start passing.
const B_TAB u8 = 0x09
const B_LF u8 = 0x0A
const B_CR u8 = 0x0D
const B_BACKSLASH u8 = 0x5C
// UTF-8 continuation bytes (10xxxxxx). lex only ever sees VALID UTF-8 (main
// validates via to_str before the pipeline), so "next byte is not a
// continuation byte" is exactly "codepoint boundary".
const B_UTF8_TAIL_LO u8 = 0x80
const B_UTF8_TAIL_HI u8 = 0xBF

fn is_space(b u8) -> bool => b == (' ' as u8) || b == B_TAB || b == B_CR || b == B_LF

fn is_digit(b u8) -> bool => b >= ('0' as u8) && b <= ('9' as u8)

fn is_ident_start(b u8) -> bool =>
    (b >= ('a' as u8) && b <= ('z' as u8)) || (b >= ('A' as u8) && b <= ('Z' as u8)) || b == ('_' as u8)

fn is_ident_byte(b u8) -> bool => is_ident_start(b) || is_digit(b)

fn keyword_kind(t str) -> TokenKind {
    if t == "module" { return TokenKind.KwModule }
    if t == "fn" { return TokenKind.KwFn }
    if t == "if" { return TokenKind.KwIf }
    if t == "return" { return TokenKind.KwReturn }
    if t == "for" { return TokenKind.KwFor }
    if t == "in" { return TokenKind.KwIn }
    if t == "mut" { return TokenKind.KwMut }
    TokenKind.Ident
}

fn punct_kind(b u8) -> TokenKind {
    if b == ('(' as u8) { return TokenKind.LParen }
    if b == (')' as u8) { return TokenKind.RParen }
    if b == ('{' as u8) { return TokenKind.LBrace }
    if b == ('}' as u8) { return TokenKind.RBrace }
    if b == ('.' as u8) { return TokenKind.Dot }
    if b == (',' as u8) { return TokenKind.Comma }
    if b == ('+' as u8) { return TokenKind.Plus }
    if b == ('-' as u8) { return TokenKind.Minus }
    if b == ('*' as u8) { return TokenKind.Star }
    if b == ('/' as u8) { return TokenKind.Slash }
    TokenKind.ErrorTok
}

/// Tokenize the whole input. Always succeeds; always covers every byte.
export fn lex(src str) -> []Token {
    ro b = src.bytes()
    ro n = src.byte_len()
    mut toks = []Token.new()
    mut i = 0
    while i < n {
        // Leading trivia: spaces, newlines, // comments (up to newline).
        ro trivia_start = i
        mut in_trivia = true
        while in_trivia && i < n {
            if is_space(b[i]) {
                i += 1
            } else if b[i] == ('/' as u8) && i + 1 < n && b[i + 1] == ('/' as u8) {
                while i < n && b[i] != B_LF { i += 1 }
            } else {
                in_trivia = false
            }
        }
        ro leading = src[trivia_start..i]
        if i >= n {
            // The Eof text is the EMPTY SLICE ANCHORED AT THE END, not the ""
            // literal: every token text must be a real slice of src, or the
            // one position door (source.offset_of, pointer distance) gets a
            // foreign pointer and its contract assert fires — fuzzer catch
            // 2026-08-14: recovery at EOF puts this leaf into an Err branch
            // and check reports a position on it. text[n..n] is contract-legal
            // (str @index admits start == end == byte_len).
            toks.push(Token { kind: TokenKind.Eof, leading, text: src[n..n] })
            return toks
        }
        // Token text.
        ro start = i
        ro c = b[i]
        mut kind = TokenKind.ErrorTok
        if is_ident_start(c) {
            while i < n && is_ident_byte(b[i]) { i += 1 }
            kind = keyword_kind(src[start..i])
        } else if is_digit(c) {
            while i < n && is_digit(b[i]) { i += 1 }
            kind = TokenKind.IntLit
        } else if c == ('"' as u8) {
            // String literal: raw bytes between quotes, escapes kept verbatim
            // (lossless; meaning is parse/check business, not lex).
            //
            // Owner's catch 2026-08-14: Nova strings are CONTEXT-DEPENDENT --
            // "${expr}" nests real tokens (including strings) inside. A flat
            // scan-to-quote would tokenize that PLAUSIBLY BUT WRONG, which is
            // class K7 (silent half-capability). E1 therefore refuses
            // honestly: a string containing `${` lexes as ErrorTok (still
            // lossless), so parse wraps it in Err and the subset boundary is
            // visible. The mode-stack lexer (Roslyn interpolated-string
            // model: compound token, inner tokens recursive) is the E2 step.
            i += 1
            mut has_interp = false
            mut closed = false
            while i < n && !closed {
                if b[i] == ('"' as u8) {
                    closed = true
                    i += 1
                } else if b[i] == B_BACKSLASH && i + 1 < n {
                    // An escape consumes BOTH bytes and, deliberately, does
                    // not look inside: `\${` is the escaped, literal form and
                    // must NOT flag interpolation (E1 review p.4 -- the old
                    // loop inspected the already-escaped byte).
                    i += 2
                } else {
                    if b[i] == ('$' as u8) && i + 1 < n && b[i + 1] == ('{' as u8) { has_interp = true }
                    i += 1
                }
            }
            kind = TokenKind.StrLit
            // Honest refusals, both K7-shaped (E1 review p.4): a string that
            // never closed is not a plausible StrLit, and interpolation is
            // outside the E1 subset (context-dependent lexing is the E2
            // mode-stack step). Either way the bytes stay ours -- lossless.
            if has_interp || !closed { kind = TokenKind.ErrorTok }
        } else if c == ('<' as u8) && i + 1 < n && b[i + 1] == ('=' as u8) {
            i += 2
            kind = TokenKind.Le
        } else if c == ('<' as u8) {
            i += 1
            kind = TokenKind.Lt
        } else if c == ('+' as u8) && i + 1 < n && b[i + 1] == ('=' as u8) {
            i += 2
            kind = TokenKind.PlusAssign
        } else if c == ('-' as u8) && i + 1 < n && b[i + 1] == ('>' as u8) {
            i += 2
            kind = TokenKind.Arrow
        } else if c == ('.' as u8) && i + 1 < n && b[i + 1] == ('.' as u8) {
            i += 2
            kind = TokenKind.DotDot
        } else if c == ('=' as u8) {
            i += 1
            kind = TokenKind.Assign
        } else {
            kind = punct_kind(c)
            i += 1
            if c >= B_UTF8_TAIL_LO {
                // A non-ASCII byte outside every token class starts a
                // multi-byte codepoint: the ErrorTok must swallow the WHOLE
                // sequence, or the src[start..i] slice below splits the
                // codepoint and the str-slice contract panics (fuzzer catch
                // 2026-08-14: corruption byte ahead of a Cyrillic comment).
                while i < n && b[i] >= B_UTF8_TAIL_LO && b[i] <= B_UTF8_TAIL_HI { i += 1 }
            }
        }
        toks.push(Token { kind, leading, text: src[start..i] })
    }
    // Same end-anchored empty slices as the early return above — the Eof
    // leaf must point INTO src for the position door.
    toks.push(Token { kind: TokenKind.Eof, leading: src[n..n], text: src[n..n] })
    toks
}

/// The reserialization half of the lead invariant: concatenating every
/// token's leading trivia and text reproduces the input byte for byte.
export fn reserialize(toks []Token) -> str {
    consume out = StringBuilder.new()
    for t in toks {
        out.append(t.leading)
        out.append(t.text)
    }
    out
}
