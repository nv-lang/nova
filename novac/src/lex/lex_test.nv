// novac/src/lex — tests beside the module (project convention).
//
// The load-bearing test is reserialization identity: it is the lex half of
// the frontend's lead invariant (architecture §5) and the property the
// diff-gate will check on the whole corpus once the vertical slice closes.

module novac.lex

test "reserialization: hello program survives byte for byte" {
    ro src = "// greeting\nmodule basics.hello\n\nfn main() {\n    println(\"Hello, Nova!\")\n}\n"
    assert(reserialize(lex(src)) == src)
}

test "reserialization: broken input survives too" {
    ro src = "fn @@ ??? \"unterminated\n// tail comment"
    assert(reserialize(lex(src)) == src)
}

test "reserialization: empty and trivia-only inputs" {
    assert(reserialize(lex("")) == "")
    ro only_trivia = "   \n// just a comment\n\t\n"
    assert(reserialize(lex(only_trivia)) == only_trivia)
}

test "kinds: keywords, idents, ints, strings, punct" {
    ro toks = lex("module a.b\nfn main() { println(\"hi\", 42) }")
    assert(toks[0].kind == TokenKind.KwModule)
    assert(toks[1].kind == TokenKind.Ident)
    assert(toks[2].kind == TokenKind.Dot)
    assert(toks[3].kind == TokenKind.Ident)
    assert(toks[4].kind == TokenKind.KwFn)
    assert(toks[5].kind == TokenKind.Ident)
    assert(toks[5].text == "main")
}

test "trivia: comment lands in leading of the next token" {
    ro toks = lex("// c\nfn x")
    assert(toks[0].kind == TokenKind.KwFn)
    assert(toks[0].leading == "// c\n")
    assert(toks[0].text == "fn")
}

test "string literal keeps escapes verbatim and stays lossless" {
    ro src = "\"a\\\"b\" tail"
    ro toks = lex(src)
    assert(toks[0].kind == TokenKind.StrLit)
    assert(reserialize(toks) == src)
}

test "string literal's line-continuation backslash survives a CRLF source (registry #1229's sibling)" {
    // The continuation is `\` followed by the SOURCE's own line break (D467
    // §3). On a CRLF-terminated file that break is TWO bytes, and the scan
    // used to consume only the backslash and the `\r`, leaving a bare `\n`
    // that the newline-ends-the-scan rule (274.3/F19) cut the literal on --
    // corrupting everything after it. `\r`/`\n` here are VALUE escapes
    // (D467), building an actual CR+LF pair inside `src`, not the raw
    // newline D467 §4 forbids.
    ro src = "\"a\\\r\nb\""
    ro toks = lex(src)
    assert(toks[0].kind == TokenKind.StrLit)
    assert(reserialize(toks) == src)
}

test "unknown byte becomes ErrorTok, not a panic, and keeps its text" {
    // `?` used to stand for "a byte no rule claims" here -- it no longer
    // does (registry #1264: a lone `?` lexes its own `TokenKind.Question`
    // now, refused BY NAME in the checker instead of dying as an anonymous
    // ErrorTok). Backtick is still genuinely unclaimed by any rule in the
    // table.
    ro toks = lex("a ` b")
    assert(toks[1].kind == TokenKind.ErrorTok)
    assert(toks[1].text == "`")
}

test "positions derive by prefix sum, no span is stored (owner 2026-08-14)" {
    ro src = "fn  main"
    ro toks = lex(src)
    // lo of token k == sum of byte lengths of everything before it; the
    // lossless invariant makes this exact, so the green token needs no span.
    ro lo1 = toks[0].leading.byte_len() + toks[0].text.byte_len() + toks[1].leading.byte_len()
    assert(lo1 == 4)
    assert(lo1 + toks[1].text.byte_len() == 8)
}

test "interpolated string lexes as fragments and slot tokens (wave I2)" {
    // S9.4a kept the literal whole while the checker refused the form; I2
    // makes the form live, so the lexer splits it: a fragment with the
    // opening quote, the slot markers around REAL expression tokens, and a
    // closing fragment. Losslessness holds by concatenation, as everywhere.
    ro src = "f(\"hello \${x}\")"
    ro toks = lex(src)
    assert(toks[2].kind == TokenKind.StrFrag)
    assert(toks[3].kind == TokenKind.InterpOpen)
    assert(toks[4].kind == TokenKind.Ident)
    assert(toks[5].kind == TokenKind.InterpClose)
    assert(toks[6].kind == TokenKind.StrFrag)
    assert(reserialize(toks) == src)

    // An ESCAPED dollar does not open a slot: the literal stays whole.
    ro esc = lex("f(\"hello \\\${x}\")")
    assert(esc[2].kind == TokenKind.StrLit)
}

test "an UNTERMINATED string is still a lexer error, not a literal" {
    // The other half of the same decision: interpolation is a FORM of the
    // language, an unclosed run is not. Calling it a literal would hand the
    // parser a lie about what it holds.
    ro toks = lex("f(\"never closed")
    assert(toks[2].kind == TokenKind.ErrorTok)
}

test "arithmetic tokens: two-char operators split before one-char (E1 growth)" {
    ro toks = lex("if a <= b { return a < c } x += 1 .. 2 -> mut")
    assert(toks[0].kind == TokenKind.KwIf)
    assert(toks[2].kind == TokenKind.Le)
    assert(toks[5].kind == TokenKind.KwReturn)
    assert(toks[7].kind == TokenKind.Lt)
    assert(toks[11].kind == TokenKind.PlusAssign)
    assert(toks[13].kind == TokenKind.DotDot)
    assert(toks[15].kind == TokenKind.Arrow)
    assert(toks[16].kind == TokenKind.KwMut)
}

test "arithmetic file reserializes byte for byte" {
    ro src = "fn factorial(n int) -> int {\n\
    if n <= 1 {\n\
        return 1\n\
    }\n\
    n * factorial(n - 1)\n\
}\n\
"
    assert(reserialize(lex(src)) == src)
}

test "multi-byte codepoint outside every token class: one ErrorTok, lossless (fuzzer 2026-08-14)" {
    // An em-dash hits the punct fallback; eating it ONE byte at a time made
    // src[start..i] split the codepoint and the str-slice contract panicked.
    ro src = "a — b"
    ro toks = lex(src)
    assert(toks[1].kind == TokenKind.ErrorTok)
    assert(toks[1].text.byte_len() == 3)
    assert(reserialize(toks) == src)
}

test "eof token carries tail trivia" {
    ro toks = lex("x  // tail")
    ro last = toks[toks.len() - 1]
    assert(last.kind == TokenKind.Eof)
    assert(last.leading == "  // tail")
}

// --- 2026-08-17 closures (P10: a fixture for every fix) ------------------

test "F19: a string literal does not cross a line" {
    // The scan used to run to the next quote ANYWHERE in the file, so one
    // missing quote joined two lines into a literal and the diagnostic landed
    // dozens of bytes past the mistake.
    ro toks = lex("ro a = \"open\nro b = \"closed\"")
    // the unterminated literal ends at the newline, so the second line lexes
    // as code again: an Ident `ro` must appear after it
    mut saw_error = false
    mut saw_ident_after = false
    for t in toks {
        // Accumulating a flag is an EXPRESSION, not a branching: `||` says
        // "once true, stays true" without a second branch to explain (P31).
        saw_error = saw_error || t.kind == TokenKind.ErrorTok
        saw_ident_after = saw_ident_after || (saw_error && t.kind == TokenKind.Ident)
    }
    assert(saw_error, "an unterminated string must produce an error token")
    assert(saw_ident_after, "the next line must lex as code, not as literal text")
}

test "F21: a separated integer is ONE IntLit, never IntLit(1) plus a name" {
    // `1_000` used to lex as IntLit(1) plus identifier `_000` -- it parsed,
    // checked and COMPILED to the number one; then it was refused whole; since
    // #1605 it is the D44 literal it spells, separators kept in its text.
    for form in ["1_000", "0xFF_FF", "1_0", "0x1_0"] {
        ro toks = lex(form)
        assert(toks[0].kind == TokenKind.IntLit, "a separated integer must lex as one IntLit")
        assert(toks[0].text == form, "the integer token must carry the whole spelling")
        assert(toks[1].kind == TokenKind.Eof, "nothing may be left after the integer")
    }
    // A run touching an identifier byte is still one refusal.
    for broken in ["1abc", "1_", "100_", "0x_FF", "0xFF_", "1__0"] {
        assert(lex(broken)[0].kind == TokenKind.ErrorTok, "a malformed integer must be refused whole")
        assert(lex(broken)[1].kind == TokenKind.Eof, "the refusal must eat the whole run")
    }
}

test "#1605: every D44 float form is ONE FloatLit, its text whole" {
    // The exponent used to fall to the touching-identifier refusal: `1e20`
    // was one ErrorTok and `1.5e3` a float plus the name `e3`.
    for form in ["1e10", "1.5e-3", "2E+2", "1_000.5", "1_000.25e6", "1.0e1_0"] {
        ro toks = lex(form)
        assert(toks[0].kind == TokenKind.FloatLit, "a D44 float form must lex as one FloatLit")
        assert(toks[0].text == form, "the float token must carry the whole spelling")
        assert(toks[1].kind == TokenKind.Eof, "nothing may be left after the float")
    }
}

test "#1605: a broken exponent is refused, the hex digit and the range stay" {
    // D44 forbids `_` beside `e` and an exponent without digits; `0x1e5`
    // keeps its `e` as a hex digit and `0..3` keeps both dots.
    for broken in ["1e", "1e+", "1_e10", "1.5_", "1__0.5"] {
        assert(lex(broken)[0].kind == TokenKind.ErrorTok, "a malformed number must be refused whole")
    }
    assert(lex("0x1e5")[0].kind == TokenKind.IntLit, "a hex run takes no exponent")
    ro range = lex("0..3")
    assert(range[0].kind == TokenKind.IntLit && range[1].kind == TokenKind.DotDot)
}

test "char literal: one token, escapes whole, reserialize lossless (char wave)" {
    ro toks = lex("ro c = 'x'\nro n = '\\n'\nro q = '\\''")
    // 'x' after `ro c =` is one CharLit carrying its quotes verbatim.
    assert(toks[3].kind == TokenKind.CharLit)
    assert(toks[3].text == "'x'")
    // The escape consumes both bytes: '\n' is ONE token, and so is the
    // escaped quote -- it closes on the THIRD quote, not the second.
    assert(toks[7].kind == TokenKind.CharLit)
    assert(toks[11].kind == TokenKind.CharLit)
    ro src = "ro c = 'x'\nro n = '\\n'\nro q = '\\''"
    assert(reserialize(lex(src)) == src)

    // The empty pair and an unclosed run are NOT plausible literals: both
    // stay ErrorTok, lossless, exactly as every other lexer refusal.
    ro bad = lex("ro e = ''")
    assert(bad[3].kind == TokenKind.ErrorTok)
    ro open = lex("ro u = 'x")
    assert(open[3].kind == TokenKind.ErrorTok)
}

test "`??` and a lone `?` are two different tokens (coalesce wave, registry #1264)" {
    // `ro v = o ?? 0` -- ro(0) v(1) =(2) o(3) ??(4) 0(5).
    ro toks = lex("ro v = o ?? 0")
    assert(toks[4].kind == TokenKind.Question2)
    assert(toks[4].text == "??")
    ro src = "ro v = o ?? 0\n\
ro w = a ?? b"
    assert(reserialize(lex(src)) == src)

    // A LONE `?` is the Try operator (D85): legal Nova, refused BY
    // NAME in the checker (registry #1264), not an unclaimed byte -- it now
    // lexes its OWN token, not the `ErrorTok` it used to fall to before the
    // fix (the same reasoning `?? return` already established for its own
    // sibling form: a legal-but-unimplemented (D85) construct must reach
    // the tree, not die at the lexer as if it were not Nova).
    ro one = lex("ro v = o ? 1")
    assert(one[4].kind == TokenKind.Question)
    assert(one[4].text == "?")
}

test "F22: a non-ASCII run is ONE error token, not one per letter" {
    // A Cyrillic identifier used to produce six diagnostics for one cause.
    ro toks = lex("ro \u{43f}\u{440}\u{438}\u{432}\u{435}\u{442} = 1")
    mut errors = 0
    for t in toks {
        errors += if t.kind == TokenKind.ErrorTok { 1 } else { 0 }
    }
    assert(errors == 1, "one non-ASCII run must be one error token")
}

test "a line continuation splices the literal and adds no byte (D467 section 3)" {
    // The canon for long text: `\` before the break. Plan 277 phase 2 retires
    // the RAW newline inside `"..."`, and novac's own tests migrate to this
    // form -- so novac has to read it, or the migration cannot be canonical in
    // the tree novac itself reads.
    //
    // What is asserted is the CONTENT, not mere acceptance: the continuation
    // must splice the source lines and contribute nothing of its own, so the
    // spliced literal equals the same text written in one piece. A door that
    // accepted the form but kept the newline would pass an "is it accepted"
    // test and fail this one.
    //
    // Measured before the door was opened: the LEXER already survived the form
    // (its escape branch takes both bytes before the end-of-line test), the
    // emitter passes bytes through, and C splices backslash-newline in
    // translation phase 2 -- so the whole change was one byte in the checker's
    // escape set.
    ro spliced = "abc\
def"
    ro whole = "abcdef"
    assert(spliced.byte_len() == whole.byte_len())
    assert(spliced == whole)

    // The control: an explicit `\n` still means a newline, so the two forms
    // are not the same string. Without it this test would also pass on a
    // compiler that silently dropped every escape.
    ro with_nl = "abc\ndef"
    assert(with_nl.byte_len() == whole.byte_len() + 1)
}

test "a float exponent is one FloatLit token (registry 1605), and an `e` that starts none is not taken" {
    ro toks = lex("1e20 1.5e-3 2.5E2 4e+1 7")
    assert(toks[0].kind == TokenKind.FloatLit && toks[0].text == "1e20")
    assert(toks[1].kind == TokenKind.FloatLit && toks[1].text == "1.5e-3")
    assert(toks[2].kind == TokenKind.FloatLit && toks[2].text == "2.5E2")
    assert(toks[3].kind == TokenKind.FloatLit && toks[3].text == "4e+1")
    assert(toks[4].kind == TokenKind.IntLit)
    // CONTROL: no digit after the `e` (or after its sign) is no exponent, and
    // the run touching the letter is ONE refusal -- `1.5e` as a whole, as the
    // oracle's "invalid float literal" says (merge of sweep 6: the first
    // version of this control split it into `1.5` and a name `e`, the silent
    // misread `1.5_` had). The integer run is refused the same way.
    ro ctl = lex("1.5e x 3e- 0..3")
    assert(ctl[0].kind == TokenKind.ErrorTok && ctl[0].text == "1.5e")
    assert(ctl[1].kind == TokenKind.Ident && ctl[1].text == "x")
    assert(ctl[2].kind == TokenKind.ErrorTok && ctl[2].text == "3e")
    assert(ctl[4].kind == TokenKind.IntLit && ctl[5].kind == TokenKind.DotDot)
    assert(reserialize(ctl) == "1.5e x 3e- 0..3")
}
