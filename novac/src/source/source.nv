// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Roslyn `GreenNode.FullWidth` (widths, not positions) for \"no node stores
// a span\"; Donor: none for `offset_of` itself — pointer distance over the src
// slice (owner's design 2026-08-14), no reference does this; NOT taken: rustc
// `SourceMap`/`BytePos` line tables and Span interning — §7 speaks byte offsets
// only, line/col arrive with the LSP (E3).
// Role: the one position door — offsets are derived from the leaf's text slice, so no node stores a span.
// Used by: check for diagnostic spans (E1+), the LSP for hover ranges (E3); unchanged by generics.
// Guarded by: check-novac-frontend-shape.sh (positions derived, no stored span), check-novac-diag-schema.sh (every
// diagnostic carries a valid primary span), the position tests in lex_test.nv.
// (`offset_of` over the leaf's text slice) so no node stores a span; NOT taken:
// rustc's multi-file SourceMap and Span interning (one file per CU here).
// novac/src/source — the source-text door (architecture §2: module `source`).
//
// One class of task: representing input text and positions in it. Everything
// downstream speaks in byte offsets into the original text; nothing here
// knows about tokens or trees (edge table §3: `source` is a leaf).

module novac.source

/// Half-open byte range [lo, hi) into the source text.
export type Span {
    lo int /// start byte offset (inclusive)
    hi int /// end byte offset (exclusive)
}

/// Byte length of the span.
export fn Span @len() -> int => @hi - @lo

/// The compiler never reads files itself (274 §2: the driver hands text in),
/// so the source module carries only the text and derived facts about it.
export type SourceText {
    text str /// the whole input, handed in by the driver — never read here
}

/// Byte length of the whole text.
export fn SourceText @len() -> int => @text.byte_len()

/// The text under a span.
export fn SourceText @slice(sp Span) -> str => @text[sp.lo..sp.hi]

/// Byte offset of a slice of `@text` — O(1) via pointer distance (owner's
/// design 2026-08-14). PRECONDITION: `s` must be a slice of `@text`; a
/// foreign str gives a meaningless number (checked by the assert -- which
/// runs in release too, the language's stance; not by the type -- recorded
/// honestly). This is the ONE position door: nothing
/// else in the compiler computes offsets.
export fn SourceText @offset_of(s str) -> int {
    ro d = unsafe { s.ptr().dist(@text.ptr()) }
    // The WHOLE slice must lie inside the text (owner's question 2026-08-14:
    // why <=?). `d == len` is legal ONLY for the empty slice anchored at the
    // end: text[len..len] is admitted BY CONTRACT -- str @index requires
    // `0 <= r.start && r.start <= r.end && r.end <= @byte_len()`
    // (std/src/runtime/string/slice.nv), and start == end == len satisfies
    // it. This assert mirrors that same contract shape for the recovered
    // offset: empty-at-end passes (d + 0 <= len), garbage edges fail.
    assert(d >= 0 && d + s.byte_len() <= @text.byte_len())
    d
}
