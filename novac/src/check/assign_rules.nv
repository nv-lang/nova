// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `check_binop_assign` -- a compound assignment is typed as the
// binary operation on the TARGET's type, the literal adapting to it, a mismatch
// refused at the operator; NOT taken: C's usual arithmetic conversions as a
// typing rule (they are what this door exists to keep out of the emission).
// Role: layer 7 (check) -- the ASSIGNMENT DOOR (274.7 B7, registry #932): the
// type a compound assignment runs in. Set apart from typing.nv when that file
// crossed 1000 lines with the wave; the cut is the rule, by meaning.
// Used by: typing.nv (the AssignStmt arm records what this door answers).
// Guarded by: check-novac-file-size.py (this file exists because typing.nv
// crossed 1000 lines), check-novac-no-silent-skip.py, and the fixtures
// compound_target/ through check-novac-no-cascade and the differential.
// novac/src/check/assign_rules.nv -- the target's row decides.

module novac.check

import ../tree.{Node, NodeKind, assign_op_of}
import ../types.{TyId, no_ty, is_ty}
import ../builtins.{TypeKind, RECV_BINDING}
import ../lex.{TokenKind}
import ../sem.{leaf_kind, carrier_of, is_numeric_prim, ty_source_name, expr_leaf_name, branch_children, ParamMode}

/// The root NAME of an assignment TARGET -- the identifier at the bottom of
/// any field/index chain (`b.n`, `arr[0].n`), or the target itself when it
/// already IS a bare name. `None` when the chain bottoms out on anything
/// else (a call's result, an owned temporary) -- such a target is not a
/// BOUND PLACE at all, and the mode gate below has nothing to ask about it.
fn assign_target_root(e Node) -> Option[str] {
    ro k = e.kind_of()
    if k == NodeKind.Name { return Some(expr_leaf_name(e)) }
    if k == NodeKind.FieldAccess || k == NodeKind.Index {
        return assign_target_root(branch_children(e)[0])
    }
    None
}

/// THE BINDING-MODE GATE (registry #1254): a target the ASSIGNMENT DOOR below
/// accepts by TYPE may still be forbidden by MODE -- `ro x = 1; x = 2` types
/// clean (int = int) and the oracle refuses it all the same. The mode is
/// already tracked (`scope.nv:131`, `Scope @mode_of_name`) and already read at
/// a CALL's key (`type_of.nv:129`, `class_of_binding`); this door is the first
/// to ask it at an ASSIGNMENT's target. One question, two shapes: the target
/// IS the root -- a bare name, or a non-`mut` parameter (bound the same way,
/// `params.nv:152`) -- answers `E_LOCAL_NOT_MUT`; the target REACHES the root
/// through a field or index (`b.n` -- D175's "binding dominates") answers
/// `E_READONLY_FIELD`, the oracle's own naming for the same two cases (Plan
/// 124.8 / D175 amend). A target with no bound root at all (a call's result,
/// an owned temporary's own field) is not this door's question and passes.
fn Checker mut @report_if_assign_target_not_writable(kids []Node) -> bool {
    if @report_if_write_through_ro_view(kids) { return true }
    if Some(name) = assign_target_root(kids[0]) {
        if !@scope.is_bound(name) { return false }
        match @scope.mode_of_name(name) {
            ModeMut => false
            ModeRo | ModeConsume => {
                ro msg = if kids[0].kind_of() == NodeKind.Name {
                    "cannot assign to `${name}` -- it is bound `ro`, and only a `mut` binding may be reassigned; declare it `mut ${name}` if it needs to change (D184, E_LOCAL_NOT_MUT)"
                } else {
                    "cannot mutate through `${name}` -- it is bound `ro`, and the binding governs every field or index reached through it; declare it `mut ${name}` if it needs to change (D175, E_READONLY_FIELD)"
                }
                match kids[1] {
                    Leaf(tk) => @refuse(tk, msg)
                    Branch { .. } => {}
                }
                true
            }
        }
    } else {
        false
    }
}

/// Does this expression READ THROUGH a `ro` VIEW (D176, registry 1458)? A call
/// whose row returns `-> ro T`, a field declared `f ro T`, and anything reached
/// by an index or a field from such a view -- the content is frozen all the way
/// down, whoever holds it. Answered from decisions the walk already recorded
/// (the callee, the owner's type); an undecided node answers false, because its
/// own refusal has spoken. A `ro`-BOUND name is not this question: the binding
/// gate below answers it.
fn Checker @hands_ro_view(e Node) -> bool {
    ro k = e.kind_of()
    if k == NodeKind.Paren { return @hands_ro_view(branch_children(e)[1]) }
    if k == NodeKind.Call || k == NodeKind.MethodCall { return call_hands_ro_view(e, @ctx, @chan) }
    if k == NodeKind.Index { return @hands_ro_view(branch_children(e)[0]) }
    if k == NodeKind.FieldAccess {
        ro kids = branch_children(e)
        if @hands_ro_view(kids[0]) { return true }
        if kids.len() < 3 { return false }
        return @field_is_ro_view(@chan.type_if_known(kids[0].id_of()), kids[2])
    }
    if k == NodeKind.SelfField {
        ro kids = branch_children(e)
        if kids.len() < 2 || !@scope.is_bound(RECV_BINDING) { return false }
        return @field_is_ro_view(@scope.type_of_name(RECV_BINDING), kids[1])
    }
    false
}

/// Is the field named by `name_leaf` of `owner` declared `ro`? An unknown owner
/// or a non-leaf name answers false: the field door refused it already.
fn Checker @field_is_ro_view(owner TyId, name_leaf Node) -> bool {
    if !is_ty(owner) { return false }
    match name_leaf {
        Leaf(t) => @fres.field_is_ro(@ctx.fields, owner, t.text)
        Branch { .. } => false
    }
}

/// A WRITE THROUGH A `ro` VIEW (D176, registry 1458): `view[i] = x` and
/// `view.f = x`, where the indexed or accessed operand is a `ro` view, are
/// refused with the oracle's code for the index form, `E_READONLY_CONTENT`
/// ("cannot write through index on `ro` array"). The oracle stays silent on
/// the FIELD form through a `ro` record view (`bx().n = 2`) -- its defect,
/// filed in the registry row; novac follows the spec, which forbids both.
/// Reassigning a `ro` FIELD itself (`w.f = other`) is not a write through the
/// view and passes (measured: the oracle accepts it, D176 freezes content).
fn Checker mut @report_if_write_through_ro_view(kids []Node) -> bool {
    ro t = kids[0]
    ro tk = t.kind_of()
    if tk != NodeKind.Index && tk != NodeKind.FieldAccess { return false }
    if !@hands_ro_view(branch_children(t)[0]) { return false }
    ro msg = if tk == NodeKind.Index {
        "cannot write through index on a `ro` view -- its content is read-only (D176, E_READONLY_CONTENT); take a mutable copy with `.clone()` (D230) if it must change"
    } else {
        "cannot write a field through a `ro` view -- its content is read-only (D176, E_READONLY_CONTENT); take a mutable copy with `.clone()` (D230) if it must change"
    }
    match kids[1] {
        Leaf(tk2) => @reject(tk2, msg)
        Branch { .. } => {}
    }
    true
}

/// A `ro` VIEW BOUND `mut` (D176, registry 1458): `mut x = view()` would hand
/// the binding a write the view forbids. The oracle's code and position: the
/// initializer, `E_READONLY_COERCE`. Judged after the binding is typed, from
/// the decisions the walk recorded; a typed local (`mut x T = ...`) is refused
/// by the subset walk before it reaches here.
fn Checker mut @report_if_ro_view_into_mut(st Node) -> () {
    ro kids = branch_children(st)
    if kids.len() < 2 { return }
    if kids[0].kind_of() != NodeKind.LeafNode || leaf_kind(kids[0]) != TokenKind.KwMut { return }
    ro init = kids[kids.len() - 1]
    if !@hands_ro_view(init) { return }
    @reject_first_leaf_of([]Node.of(init), "cannot bind a `ro` view to a `mut` binding -- removing readonly is not allowed (D176, E_READONLY_COERCE); bind it `ro`, or take a mutable copy with `.clone()` (D230)")
}

/// THE TYPE A COMPOUND ASSIGNMENT RUNS IN, or `no_ty()` when the operand was
/// refused here (274.7 B7, #932). `a op= b` is `a = a op b`, so D405's operand
/// rule applies as at every other numeric operator: a bare literal takes the
/// TARGET's carrier type (`x += 2` on an `f64` is a float addition -- the int
/// helper picked from the literal printed 3 where the oracle prints 3.5), and
/// two NAMED numeric operands of different types are refused
/// (spec/conversions.md names compound assignment; the oracle accepts -- its
/// #926). A plain `=` keeps the operand's own type. What the caller RECORDS for
/// the right operand is the answer here, and the emitter reads that and
/// nothing else -- no second table of target types in emission.
fn Checker mut @assigned_operand_type(kids []Node) -> TyId {
    if @report_if_assign_target_not_writable(kids) { return no_ty() }
    ro rt0 = type_of(kids[2], @ctx, @scope, @chan)
    match assign_op_of(leaf_kind(kids[1])) {
        Set => @assigned_value_type(kids, rt0)
        Update(_) => {
            ro tc = carrier_of(@ctx, type_of(kids[0], @ctx, @scope, @chan))
            ro adapted = adapt_operand(kids[2], rt0, tc, @ctx.tys)
            if adapted != rt0 {
                if !@lit_fits_or_refuse(kids[2], adapted) { return no_ty() }
            } else {
                // Not a bare literal, or one already of the target's type.
            }
            if is_numeric_prim(@ctx.tys, adapted) && is_numeric_prim(@ctx.tys, tc) && adapted != tc {
                match kids[1] {
                    Leaf(t) => @reject(t, MIXED_NUMERIC_MSG)
                    Branch { .. } => {}
                }
                return no_ty()
            } else {
                // The same numeric type by name, or not numeric at all: the
                // operator's own emission handles it.
            }
            adapted
        }
    }
}

/// THE ASSIGNMENT DOOR (274.7 B8): the value written by `x = e` must be the
/// target's type, BY NAME -- the third position of one rule after the argument
/// (the call key) and the return (return_rules.nv). A bare numeric literal
/// takes the TARGET's carrier type (D227 rule 2 / D55: `x = 2` on an f64 stores
/// 2.0) and is judged for fit before it is recorded; anything else must match
/// the target exactly. Until 2026-09-05 novac recorded whatever the right side
/// was: `x = y` with `x f64`, `y int` compiled to a silent C conversion, and
/// `x = "s"` on an int reached the C compiler (the oracle's `check` says ok on
/// both -- its assignment door is #926 / a row of its own). The names are the
/// oracle's for the same position: E_IMPLICIT_NARROWING for an integer
/// narrowing, E7301 for every other mismatch. Answers `no_ty()` when it refused.
fn Checker mut @assigned_value_type(kids []Node, rt0 TyId) -> TyId {
    ro tt = type_of(kids[0], @ctx, @scope, @chan)
    if !is_ty(tt) || !is_ty(rt0) { return rt0 }
    ro adapted = adapt_operand(kids[2], rt0, carrier_of(@ctx, tt), @ctx.tys)
    if adapted != rt0 {
        if !@lit_fits_or_refuse(kids[2], adapted) { return no_ty() }
    } else {
        // Not a bare literal, or one already of the target's type.
    }
    ro t = @concrete(adapted)
    ro want = @concrete(tt)
    if @ctx.tys.kind_of(t) == TypeKind.TkParam || @ctx.tys.kind_of(want) == TypeKind.TkParam {
        // A type parameter is not judged: the instance judges its own body.
        return adapted
    } else {
        // Both concrete: compared by name below.
    }
    if t == want { return adapted }
    ro from = ty_source_name(@ctx, t)
    ro to = ty_source_name(@ctx, want)
    ro msg = if differ_numeric(@ctx, t, want) {
        numeric_position_msg(@ctx, t, want, "on the right of `=` (the target is `${to}`)")
    } else {
        "cannot assign value of type `${from}` to a target of type `${to}` (E7301): no implicit conversion between named types (D405, spec/conversions.md) -- convert with `as`, or change the target"
    }
    // A LANGUAGE error (D491 / E7301), as at the return.
    match kids[1] {
        Leaf(tk) => @reject(tk, msg)
        Branch { .. } => {}
    }
    no_ty()
}
