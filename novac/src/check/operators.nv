// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_hir_typeck::op` -- operator dispatch is its own corner
// of the checker, beside expression typing, not inside it.
// Role: layer 6 (check) -- WHICH CALLABLE an operator dispatches to. Today
// exactly one operator of the subset lowers to a call: `==`/`!=` on `str`
// (D46 rule 3 derives `!=` from the same method).
// Used by: typing.nv (the Bin arm calls the one door here).
// Guarded by: check-novac-channel-one-writer.py (rule E: resolution doors
// only in check/ and resolve/), check-novac-file-size.py (this file exists
// because typing.nv crossed 1000 lines on 2026-08-29 -- the cut sem.nv took),
// and the str_eq.nv fixture through check-novac-differential.sh.
// novac/src/check/operators.nv -- the operator-to-callable decision.

module novac.check

import ../tree.{Node, BinOp, bin_op_of, un_op_of}
import ../sem.{LitArg, leaf_kind, leaf_text}
import ../sem.{carrier_of, is_int_prim, is_numeric_prim, prim_row_of}
import ../types.{TyId, no_ty, is_ty}
import ../builtins.{EQUAL_METHOD, EQUAL_PROTO, BuiltinType, TypeKind}
import ../sem.{gate_names, decl_of_ty, is_value_sum}
import ../resolve.{FnLookup}
import ../sem.{ArgSpec, ArgClass, CallForm, CalleeTarget, ty_source_name, c_shell_method}
import ../sem.{identity_slots, branch_children, ParamMode}

/// One expression: record what the emitter asks about, walk what it emits.
/// Equality on `str` is a method call, not a C operator: the
/// subset lowers it to `str.equal` (D46 rule 3 derives `!=`
/// from the same method). The CHECKER picks the row and writes
/// it into the channel; ambiguity is refused HERE, by name,
/// instead of being resolved silently at emission (274.4 §1).
///
/// Every other operator-operand pair lowers to a C operator and
/// records no callee -- the ABSENCE is the decision, and the
/// emitter reads it as one.
fn Checker mut @record_operator_callee(e Node, kids []Node) -> () {
    ro op = bin_op_of(leaf_kind(kids[1]))
    if !is_equality(op) { return }
    ro lhs_t = type_of(kids[0], @ctx, @scope, @chan)
    if lhs_t != @ctx.prims.str_id { return }
    // P18: a door that ASKS the table builds no text -- the
    // messages live in the refusers below, each with its own
    // reason.
    ro key = equality_key(lhs_t, type_of(kids[2], @ctx, @scope, @chan))
    match @res.lookup(@ctx.fns, @ctx.tys, EQUAL_METHOD, key, CallForm.MethodCall) {
        FnFound(row) => @accept_equality_row(e, kids, lhs_t, row)
        FnOverloaded(_) => @refuse_equality_overloaded(kids, key)
        // The typed key fit nothing. The M1 ladder's question, one rung of
        // it: does SOME `equal` of this receiver exist at all? If yes, the
        // right operand's type is the established cause (the key is typed
        // since M3, so `"a" == 5` lands here) -- saying "no such method"
        // would send the reader hunting a declaration that is right there.
        FnUnknown => {
            match @res.lookup(@ctx.fns, @ctx.tys, EQUAL_METHOD, equality_key(lhs_t, no_ty()), CallForm.MethodCall) {
                FnUnknown => @refuse_equality_unknown(kids)
                FnFound(_) | FnOverloaded(_) => @refuse_equality_rhs(kids)
            }
        }
    }
}

/// The typed key fit nothing while SOME `equal` of this receiver exists:
/// the right operand's TYPE is the established cause (the key is typed
/// since M3), and "no such method" would send the reader hunting a
/// declaration that is right there. Its own refuser, like its siblings:
/// the door that asks the table builds no text (P18).
fn Checker mut @refuse_equality_rhs(kids []Node) -> () {
    @report_first_leaf_of(kids, "outside the subset: `==` on `str` takes a `str` right-hand side, and this operand's type is not one `${EQUAL_METHOD}` declares")
}

/// More than one `equal` fits a TYPED key: a real D84 tie, refused by
/// name -- unless an operand novac could not type matched every row,
/// which is ignorance, not ambiguity (the M1 guard, one rule for every
/// call form the subset synthesises).
fn Checker mut @refuse_equality_overloaded(kids []Node, key []ArgSpec) -> () {
    if key_fully_typed(key) {
        @reject_first_leaf_of(kids, "`==` on `str` fits more than one `${EQUAL_METHOD}` method and none is more specific -- an ambiguity is refused, never chosen (D84)")
    } else {
        @report_first_leaf_of(kids, "outside the subset: an operand's type is not decided yet, so the `${EQUAL_METHOD}` overloads are not narrowed")
    }
}

/// The method is not among the declarations novac was handed,
/// so there is nothing to emit `==` on strings with -- and the
/// compiler must say so, not the linker.
fn Checker mut @refuse_equality_unknown(kids []Node) -> () {
    @report_first_leaf_of(kids, "outside the subset: `==` on `str` needs the `${EQUAL_METHOD}` method, and it is not among the declarations novac was handed")
}

/// The row is found; the question left is WHO carries its body.
/// Ours -- we print our own name; std's (as `str.equal` is) --
/// the body lives in the SHELL, and the shell must carry it. The
/// surface is asked BEFORE printing, as it is for a literal and
/// for instance methods: otherwise the refusal comes from the
/// linker rather than the compiler (measured 2026-08-28:
/// `undefined symbol: novac_fn_equal__...`).
fn Checker mut @accept_equality_row(e Node, kids []Node, lhs_t TyId, row FnRow) -> () {
    if !@ctx.fns.compiles_body(row) {
        ro sym = c_shell_method(@ctx, lhs_t, EQUAL_METHOD)
        if !@ctx.interop.has(sym) {
            @report_first_leaf_of(kids, "outside the subset: `==` on `${ty_source_name(@ctx, lhs_t)}` needs `${sym}`, and the shell it links into does not carry it -- the interop surface is novac/probe/shell_probe.nv")
            return
        } else {
            // Carried: the emitter prints exactly this name.
        }
    } else {
        // Our own body: our own name, no shell involved.
    }
    @chan.record_callee(e.id_of(), CalleeTarget.CalleeFn(row), []TyId.new(), identity_slots(2))
}

/// The operators D52's newtype rule covers: arithmetic and comparison (its
/// amendment of 2026-09-04, rule 1). Logic and bits are outside it.
fn is_arith_or_compare(op BinOp) -> bool {
    match op {
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | Equal | NotEqual => true
        AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// True for `==` and `!=` -- the pair that dispatches through
/// the `Equal` protocol (D46).
fn is_equality(op BinOp) -> bool {
    match op {
        Equal | NotEqual => true
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// The key of the synthesised `equal` call: the receiver in
/// position zero, the right-hand side after it. Both positions
/// are `ro` -- `equal` READS its operands, and `ro` is the class
/// every mode accepts, so the synthesised call cannot pick a
/// mutating overload by accident. The right side carries its own
/// TYPE since E2-b3 M3: with it the lookup narrows an `equal`
/// overload set itself, and what stays overloaded is a tie.
fn equality_key(lhs_t TyId, rhs_t TyId) -> []ArgSpec => [
    ArgSpec { type_id: lhs_t, cls: ArgClass.ArgRo, name: "", lit: LitArg.NotLit },
    ArgSpec { type_id: rhs_t, cls: ArgClass.ArgRo, name: "", lit: LitArg.NotLit },
]

// ---- The operator JUDGES: which operand types an operator is compiled for ----
// Moved here from exprs.nv on 2026-09-04, when the ten-widths wave pushed that
// file past a thousand lines (decision 12: cut by meaning into co-equal files
// of the module). This file owns operators; the judges are the operator half
// of the checker, the dispatch decision above is the other half.

/// In Nova EVERY operator dispatches through a protocol on a user type
/// (D46/D363: `a + b` is `a.@plus(b)`, `a < b` is `a.@compare(b) < 0`,
/// `a == b` is `a.@equal(b)`), and the subset does not do that dispatch yet.
/// So the C form is a function of the operator AND the operand type, not of
/// the operator alone -- owner's correction 2026-08-16.
///
/// Until the protocol path exists (it needs bounds, E2-b3), an operator whose
/// operands are not the primitives the subset can emit is an honest refusal
/// at the operator's own position -- not the ice the lattice would raise one
/// level down, and not a silently wrong primitive emission.
/// Returns whether it refused.
fn Checker mut @report_if_operator_needs_protocol(kids []Node) -> bool {
    ro lt0 = type_of(kids[0], @ctx, @scope, @chan)
    ro rt0 = type_of(kids[2], @ctx, @scope, @chan)
    // A POISONED OPERAND is a cause already spoken (one cause, one diagnostic):
    // no type means it was refused where it was typed -- or it is a name bound
    // poisoned after its initializer's refusal. Answering "dispatches through
    // a protocol" about it named the wrong cause a second time: measured
    // 2026-09-25, `kids.len() < 2` over `ro kids = branch_children(st)` (a body
    // of another module, refused) drew it in every function of check/. The
    // operator counts as refused, so nothing downstream records it.
    if !is_ty(lt0) || !is_ty(rt0) { return true }
    // D227/D405: a bare numeric literal takes the OTHER operand's type. The
    // lattice's door decides (adapt_operand, one door for both readers); the
    // walk RECORDS the decision here and judges the literal's range against
    // its new type before anything else is asked about the pair.
    ro lt = adapt_operand(kids[0], lt0, rt0, @ctx.tys)
    ro rt = adapt_operand(kids[2], rt0, lt0, @ctx.tys)
    if lt != lt0 {
        if !@lit_fits_or_refuse(kids[0], lt) { return true }
        @record(kids[0], lt)
    } else {
        // The left operand kept its own type: nothing was decided for it here.
    }
    if rt != rt0 {
        if !@lit_fits_or_refuse(kids[2], rt) { return true }
        @record(kids[2], rt)
    } else {
        // The right operand kept its own type: nothing was decided for it here.
    }
    ro op = bin_op_of(leaf_kind(kids[1]))
    ro both_numeric = @is_numeric(lt) && @is_numeric(rt)
    // D405 + spec/conversions.md: two NAMED numeric operands of different
    // TYPES are a USER error, not a subset limit and not protocol dispatch.
    // No pair is exempt: `int` beside `f64` was, on the oracle's measured
    // behaviour, until 2026-09-05 -- the spec says otherwise, and the spec
    // outranks the oracle (wave 274.7 B4; the oracle's side is #926).
    if both_numeric && lt != rt {
        match kids[1] {
            Leaf(t) => @reject(t, MIXED_NUMERIC_MSG)
            Branch { .. } => {}
        }
        return true
    }
    ro numeric = both_numeric
    ro ints = lt == rt && is_int_prim(@ctx.tys, lt)
    ro bools = lt == @ctx.prims.bool_id && rt == @ctx.prims.bool_id
    ro same_prim = lt == rt && @is_primitive(lt)
    // A NEWTYPE OVER A NUMBER (D52 amendment 2026-09-04). Rule 1: arithmetic and
    // comparison are defined between operands of ONE newtype -- the operators of
    // its representation, no impl written. Rule 3: the newtype beside another
    // newtype, or beside a value of its representation, is a LANGUAGE error
    // naming `as` -- a bare literal was already adapted above (rule 2), so what
    // reaches this test mixed is a real mix.
    ro lt_nt = @ctx.tys.kind_of(lt) == TypeKind.TkNewtype && @is_numeric(numeric_rep(@ctx.tys, lt))
    ro rt_nt = @ctx.tys.kind_of(rt) == TypeKind.TkNewtype && @is_numeric(numeric_rep(@ctx.tys, rt))
    ro same_nt = lt == rt && lt_nt
    if (lt_nt || rt_nt) && lt != rt && is_arith_or_compare(op) {
        match kids[1] {
            Leaf(t) => @reject(t, NEWTYPE_MIX_MSG)
            Branch { .. } => {}
        }
        return true
    } else {
        // No newtype mix: the table below decides.
    }
    // A SUM UNDER `==` / `!=` (274.7 wave R): no `Equal` is a language error,
    // said here; with it the table below admits a payload-free sum.
    ro one_sum = lt == rt && @ctx.tys.kind_of(lt) == TypeKind.TkSum
    if is_equality(op) && one_sum && @report_if_sum_lacks_equal(kids[1], lt) {
        return true
    } else {
        // Not equality over one sum, or the sum declares Equal: the table decides.
    }
    ro tag_eq = one_sum && is_value_sum(@ctx, lt)
    // Each operator states WHICH operands the subset can emit for it. The
    // match is exhaustive, so a new operator cannot slip in without an
    // answer -- and the answer is a refusal, never a guess.
    match op {
        Add | Sub | Mul | Div | Modulo => { if numeric || same_nt { return false } }
        Less | LessEq | Greater | GreaterEq => { if numeric || same_nt { return false } }
        Equal | NotEqual => { if same_prim || same_nt || tag_eq { return false } }
        AndAlso | OrElse => { if bools { return false } }
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => { if ints { return false } }
        Range => { if numeric { return false } }
    }
    match kids[1] {
        Leaf(t) => @refuse(t, "outside the subset: this operator on these operands dispatches through a protocol (D46: @plus / @compare / @equal), and protocol dispatch arrives with bounds")
        Branch { .. } => {}
    }
    true
}

/// Does the subset know how to print this type? The emitter has one printer
/// per type and no generic path; a type outside the set is a refusal here,
/// never an ice there.
fn Checker @has_printer(t TyId) -> bool => @is_printable_carrier(carrier_of(@ctx, t))

/// The printer set, asked of the CARRIER: a newtype prints as what it holds
/// (`println(Row(7))` prints 7, which is what the oracle does), so the peel
/// happens once, here, and not at each comparison. Every NUMERIC primitive
/// prints (the oracle prints each width with its own printer -- the emitter's
/// table), plus `str` and `bool`; `char` is the char wave's.
fn Checker @is_printable_carrier(t TyId) -> bool =>
    is_numeric_prim(@ctx.tys, t) || t == @ctx.prims.str_id || t == @ctx.prims.bool_id

/// What arithmetic and ordering accept in the subset: every numeric primitive
/// of the universe (D363: primitives dispatch built in), asked of the FAMILY
/// door and not of two ids -- ten widths fell out of this rule while it named
/// `int` and `f64` by id (#910).
fn Checker @is_numeric(t TyId) -> bool => is_numeric_prim(@ctx.tys, t)

/// Every primitive of novac's universe but the unit -- equality accepts any of
/// them, as long as both sides are the SAME one (mixed-type equality is a
/// conversion question the subset does not answer).
fn Checker @is_primitive(t TyId) -> bool {
    match prim_row_of(@ctx.tys, t) {
        Some(r) => family_has_values(r)
        None => false
    }
}

/// Every family but the unit has VALUES two of which can be equal; a nested
/// `match` inside an arm is a form novac does not read about itself yet, so the
/// inner question lives in its own function.
fn family_has_values(r BuiltinType) -> bool {
    match r.family {
        PfUnit => false
        PfInt | PfFloat | PfStr | PfBool | PfChar => true
    }
}

/// The prefix operators the subset can emit: `!` on bool, `-` on SIGNED
/// numbers (ints and floats), `~` on int. `-` on an unsigned integer is a
/// USER error by the spec (conversions.md, wave 274.7 B4), refused with its
/// own text before the protocol question is asked. Everything else is
/// protocol dispatch (`@neg`, `@bitnot`) and is refused at the operator's own
/// position. Returns whether it refused.
fn Checker mut @report_if_unary_needs_protocol(kids []Node) -> bool {
    ro t = type_of(kids[1], @ctx, @scope, @chan)
    match un_op_of(leaf_kind(kids[0])) {
        Not => { if t == @ctx.prims.bool_id { return false } }
        Negate => {
            match prim_row_of(@ctx.tys, t) {
                None => {}
                Some(row) => {
                    if row.family == PfInt && !row.signed {
                        match kids[0] {
                            Leaf(tk) => @refuse(tk, NEG_UNSIGNED_MSG)
                            Branch { .. } => {}
                        }
                        return true
                    }
                    if @is_numeric(t) { return false }
                }
            }
        }
        BitNot => { if is_int_prim(@ctx.tys, t) { return false } }
    }
    match kids[0] {
        Leaf(tk) => @refuse(tk, "outside the subset: this prefix operator on this operand dispatches through a protocol (D46: @neg / @bitnot), and protocol dispatch arrives with bounds")
        Branch { .. } => {}
    }
    true
}

/// `==` / `!=` over ONE sum with no `Equal` in its `#impl(...)` (274.7 wave R):
/// a LANGUAGE error, and true when said. D363 routes equality through `Equal`,
/// and a sum is a value type (D477, AMEND D32 of 2026-09-25): it opts in and gets
/// no identity fallback. A sum that DOES declare Equal goes on to the table: a
/// payload-free one compiles as a tag compare (emit_expr.nv); one with payload,
/// a generic or a runtime-ABI one keeps the protocol-dispatch refusal -- its
/// `@equal` compares payloads, and novac does not synthesize it yet.
fn Checker mut @report_if_sum_lacks_equal(op_leaf Node, t TyId) -> bool {
    ro td = decl_of_ty(@ctx, t)
    if gate_names(@ctx.gates, td.gate_off, td.gate_cnt, EQUAL_PROTO) {
        return false
    }
    @reject_first_leaf_of([]Node.of(op_leaf), SUM_EQ_NEEDS_EQUAL_MSG)
    true
}
