// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `check_expr_cast` / `CastCheck` for the SHAPE of the question --
// a cast is judged by the PAIR (source type, target type) in the one door of
// this file, `@type_cast(e)`, not by the target
// alone. The RULE is Nova's own: a newtype and its representation are the same
// value, so unwrapping is free and everything else is not a cast at all.
// NOT taken: rustc's cast kinds and its coercion lattice (D55 says widening is
// not a cast in Nova, and the numeric family arrives with its own rules).
// Role: layer 7 -- the ONE rule for `expr as T` in the subset.
// Used by: typing.nv (the walk) and type_of.nv (the lattice reads the target).
// Guarded by: check-novac-file-size.py (this file exists because typing.nv crossed 1000 lines), the newtype fixtures,
// check-novac-no-cascade.sh.
// novac/src/check/casts.nv -- what a cast may do in the subset.
//
// A co-equal file of the `check` module, cut along MEANING: the cast rule is one
// subject with one pair of legal types, and it arrived whole on 2026-08-21 --
// wrapping the registry indices in newtypes (plan 274 section 9.1g) needs the
// UNWRAP, because an index that cannot be handed back to a vector is a type
// without a purpose.

module novac.check

import ../tree.{Node}
import ../builtins.{TypeKind}
import ../sem.{Ctx, carrier_of, decl_of_ty, representation_of, branch_children, ty_of_type_ref, raw_row}
import ../sem.{leaf_kind, prim_row_of}
import ../lex.{TokenKind}
import ../types.{TyId, no_ty, is_ty}

/// A CAST, and the one shape the subset compiles: unwrapping a NEWTYPE into its
/// representation (`r as int` for `type Row int`).
///
/// That direction is the inverse of the constructor, and it is what makes a
/// wrapped index usable at all -- an index that cannot be handed back to a
/// vector is a type without a purpose (plan 274 section 9.1g). The opposite
/// direction is NOT this form: `7 as Row` would be the constructor written
/// sideways, and the constructor is `Row(7)`.
///
/// A cast between two PRIMITIVES is D54's table and lives in cast_pairs.nv
/// (the numeric family, the char pairs, the forbidden pairs). Everything else
/// keeps the named refusal: a cast between unrelated types is a hole the
/// language does not have.
fn Checker mut @type_cast(e Node) -> () {
    ro kids = branch_children(e)
    if kids.len() < 3 {
        // `x as` with nothing after it: a recovery shape, refused at the
        // keyword rather than typed.
        @report_first_leaf_of(kids, CAST_MSG)
        return
    } else {
        // Operand, `as`, and a target: the shape is whole.
    }
    ro before = @out.len()
    @type_expr(kids[0])
    if @out.len() > before { return }
    ro from = type_of(kids[0], @ctx, @scope, @chan)
    if !is_ty(from) && reads_poisoned(kids[0], @scope) {
        // SILENT-OK: the operand reads a name whose initializer was refused --
        // that refusal is the one cause (task 4: `out[i] as int` in std's
        // `to_ascii_lower`, made from its body, after `[]u8.new(cap: n)`).
        return
    } else {
        // An operand with a type, or one novac could not type on its own.
    }
    // A POINTER target (`0 as *mut T`, `p as *mut T`) is a type REFERENCE, read
    // through the one door with the instance's parameters in scope (274.11 E.10
    // step 4c-2: std's `Vec[T].new` writes `0 as *mut T`); a plain name is the
    // newtype rule's target, below.
    if is_ptr_ref(kids) {
        @type_ptr_cast(e, kids, from)
        // SILENT-OK: the pointer cast's own door recorded the type or refused it.
        return
    } else {
        // A named target: the newtype rule.
    }
    ro target = cast_target_of(e, @ctx)
    if !is_ty(target) {
        @report_cast_target_unknown(kids)
        return
    } else {
        // A target the registry holds: the pair decides.
    }
    // TWO PRIMITIVES: the numeric family and its neighbours (D54's table),
    // judged pair by pair in cast_pairs.nv. A newtype on either end is not a
    // primitive and goes on to the unwrap rule below.
    if prim_row_of(@ctx.tys, from).is_some() && prim_row_of(@ctx.tys, target).is_some() {
        @type_prim_cast(e, kids, from, target)
        // SILENT-OK: the pair's own door recorded the type or refused it.
        return
    } else {
        // A newtype, a record, a sum: the unwrap rule decides.
    }
    // The ONE legal pair: a newtype unwrapped into what it is laid out as. The
    // carrier door answers transitively, so `type A B` over `type B int` may be
    // cast to `int` as well as to `B`.
    ro legal = from != target && (target == carrier_of(@ctx, from) ||
        target == @representation_of_or_self(from))
    if !legal {
        @report_first_leaf_of(kids, CAST_MSG)
        return
    } else {
        // A newtype and its representation: the value is unchanged, and the
        // emitter writes the operand.
    }
    @record(e, target)
}

/// The representation of a newtype, or the type itself when it is not one.
///
/// A TOLERANT half beside `representation_of`, which asserts: the cast rule asks
/// about a type that may well be an ordinary one, and "it is not a newtype" is
/// an ANSWER here rather than a broken invariant.
fn Checker @representation_of_or_self(t TyId) -> TyId {
    if !is_ty(t) { return t }
    match @ctx.tys.kind_of(t) {
        TkNewtype => representation_of(@ctx, t)
        // TkEffect: an effect is not a newtype -- nothing to unwrap, itself.
        TkPrim | TkRecord | TkSum | TkApp | TkParam | TkInfer | TkTuple | TkEffect | TkPtr => t
    }
}

/// Is the cast's target written as a pointer type (`*T`, `*mut T`)?
fn is_ptr_ref(kids []Node) -> bool => kids.len() > 2 && leaf_kind(kids[2]) == TokenKind.Star

/// `x as *T` / `x as *mut T` (D214, D216): from an `int` -- a handle or the
/// null pointer `0` -- or from another pointer, which may change the pointee
/// but never GAIN the right to write (`*T as *mut T` is retracted, D216). The
/// target reads the instance's type parameters as their substitution, so
/// `*mut T` in `Vec[Pt]`'s instance is `*mut Pt`.
fn Checker mut @type_ptr_cast(e Node, kids []Node, from TyId) -> () {
    mut tps = []str.new()
    if raw_row(@inst_row) >= 0 {
        ro fd = @ctx.fns.rows[raw_row(@inst_row)]
        tps.append(@ctx.fns.tparams[fd.tparam_off..fd.tparam_off + fd.tparam_cnt])
    } else {
        // A body of the file: no generic is typed outside an instance.
    }
    ro target = ty_of_type_ref(kids, 2, no_ty(), tps, @substs, @ctx.types, @ctx.defs, @ctx.tys)
    if !is_ty(target) || @ctx.tys.kind_of(target) != TypeKind.TkPtr {
        @report_cast_target_unknown(kids)
        return
    } else {
        // A pointer type: the source decides.
    }
    ro from_ptr = is_ty(from) && @ctx.tys.kind_of(from) == TypeKind.TkPtr
    ro legal = from == @ctx.prims.int_id ||
        (from_ptr && (!@ctx.tys.ptr_is_mut(target) || @ctx.tys.ptr_is_mut(from)))
    if !legal {
        @report_first_leaf_of(kids, CAST_MSG)
        return
    } else {
        // An integer, or a pointer that keeps or drops the right to write.
    }
    @record(e, target)
}

/// A cast whose target names no type novac knows: ONE door for the named and
/// the pointer target.
fn Checker mut @report_cast_target_unknown(kids []Node) -> () {
    @report_first_leaf_of(kids, CAST_UNKNOWN_TYPE_MSG)
}
