// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check/methods.nv - WHICH row a METHOD call goes to, and the name of
// its refusal (plan 274, decision 12 cut).
//
// Donor: rustc `probe`/`pick` for the ORDER -- the receiver's type decides the
//        candidate set, then the arguments narrow it; taken. Swift's two-name
//        argument labels are NOT taken: D102 gives Nova one name per parameter.
// Role: layer 7 -- resolution of a method call. `calls.nv` is its sibling for a
//       FREE call, and the split is the language's own: it keeps the two
//       spellings apart, so resolution keeps them apart too.
// Used by: typing.nv (the one caller, from the expression walk).
// Guarded by: check-novac-file-size.py (this file exists because typing.nv
//             crossed a thousand lines), check-novac-no-cascade.sh, the pipeline
//             module tests.
//
// A co-equal file of module `novac.check` (folder = one module). The cut is by
// MEANING: everything here answers one question -- which declaration a
// `recv.name(args)` names, and what to say when nothing does.

module novac.check

import ../tree.{Node, NodeKind}
import ../lex.{Token}
import ../types.{TyId, is_ty}
import ../builtins.{TypeKind}
import ../diag.{ice}
import ../names.{raw_decl}
import ../resolve.{FnLookup}
import ../sem.{LitArg, branch_children, ArgSpec, ArgClass, CallForm, FnRow, CalleeTarget, raw_row, no_row, bind_slots}
import ../sem.{is_expr_kind}
import ../sem.{c_method_symbol, impl_of_proto, ty_source_name, decl_of_ty}
import ../sem.{option_payload}
import ../sem.{expr_leaf_name, type_admits}

/// The lookup key of a method call: the receiver's type in position ZERO, then
/// one slot per written argument, each carrying its TYPE (E2-b3 M1).
///
/// Plan 273 §4.4 fixes the receiver at position zero, so a method call and a
/// free call build the SAME kind of key and ask the SAME door — the only
/// difference is that one of them has a position zero to fill. There is no
/// receiver-shaped path left in resolution (owner, 2026-08-19).
///
/// The 274.3/C9 gap closed here: argument positions used to be `no_ty()`
/// because the judge ran before the arguments were walked. The walk goes
/// first now (the free-call order of 2026-08-21, exprs.nv), so the same door
/// the generic method path already used answers for every method call.
fn Checker @method_call_key(kids []Node, recv_t TyId) -> []ArgSpec {
    // A receiver typed by a PROTOCOL looks its methods up on the implementor
    // (interop pair, 274.7 B1b-1): `f.write(b)` on `mut f Fmt` finds
    // `FmtCtx.write`. The door is the same one the C spellings ask.
    typed_call_key(kids, 3, kids[0], impl_of_proto(@ctx, recv_t), @ctx, @scope, @chan)
}

/// The same key with the argument TYPES removed — the diagnostic's tool, not
/// resolution's (the free call's `free_call_key` split, calls.nv): it answers
/// "does any method of this receiver take this many arguments", which is what
/// separates a wrong arity from a wrong type when the typed key fit nothing.
/// The receiver stays typed — a method that exists on some OTHER type is
/// "no such method" here, not "wrong arguments".
fn Checker @method_arity_key(kids []Node, recv_t TyId) -> []ArgSpec {
    mut out = []ArgSpec.new()
    // The receiver is parameter zero (plan 273) and carries a CLASS: `mut b`
    // then `b.m()` selects the `mut @m` overload, which is the precedent the
    // whole mode axis generalizes from (P14 rule 2).
    ro recv_it = impl_of_proto(@ctx, recv_t)
    out.push(ArgSpec { type_id: recv_it, cls: arg_class(kids[0], @scope), name: "", lit: LitArg.NotLit })
    out.append(unknown_args(kids, 3, @scope))
    out
}

/// Every position of this key carries a decided type. What separates a real
/// D84 ambiguity from a set novac merely could not narrow: an untyped slot
/// fits every overload, and a tie built on one is ignorance, not ambiguity.
fn key_fully_typed(key []ArgSpec) -> bool {
    for a in key {
        if !is_ty(a.type_id) { return false }
    }
    true
}

/// Decide WHICH row a method call goes to, and record the decision.
///
/// Finding C9 of 274.3: the pair (receiver type, method name) was resolved
/// nowhere -- check asked only whether the name existed in some declaration,
/// and the emitter rebuilt the C name out of the receiver's type. Two answers
/// to one question, with the second one winning in silence: exactly the shape
/// plan 196 spends its waves removing from the current compiler.
///
/// The key is TYPED since E2-b3 M1, so the lookup narrows an overload set by
/// the argument types and modes; what it cannot narrow is a real D84 tie,
/// refused in the verdict below.
fn Checker mut @record_method_callee(e Node, kids []Node, recv_t TyId) -> () {
    if kids.len() < 3 {
        return
    } else {
        // Three children are the receiver, the dot and the name: fewer
        // than that is a recovery shape check has already refused.
    }
    match kids[2] {
        Branch { .. } => {}
        // The key is built ONCE and handed on: the verdict needs it to record
        // the binding, and its refusal needs it to name which rule failed.
        Leaf(t) => {
            ro key = @method_call_key(kids, recv_t)
            @judge_method_lookup(e, t, key, @res.lookup(@ctx.fns, @ctx.tys, t.text, key, CallForm.MethodCall))
        }
    }
}

/// The refusal a method call that fits nothing deserves, judged in the free
/// call's order (D420: name the cause you ESTABLISHED): the BINDING rule when
/// the name carries one declaration; then the same lookup with the argument
/// types removed — if a row of this receiver and arity exists, the TYPES are
/// the cause and `refuse_arg_type` names the first differing position.
fn Checker mut @refuse_method_call(e Node, t Token, key []ArgSpec) -> () {
    ro kids = branch_children(e)
    mut single_row = no_row()
    if Some(row) = @res.only_row_of(t.text) {
        if Some(why) = @binding_refusal(row, key) {
            @refuse(t, why)
            return
        } else {
            // It binds -- so the receiver's type, an argument's type, or an
            // argument's BINDING CLASS is the cause, named below.
            single_row = row
        }
    } else {
        // Unknown or overloaded: the arity question below answers.
    }
    match @res.lookup(@ctx.fns, @ctx.tys, t.text, @method_arity_key(kids, key[0].type_id), CallForm.MethodCall) {
        FnUnknown => {
            // registry #1255's twin door: `@method_arity_key` erases every
            // argument's TYPE the same way `free_call_key` does, but not its
            // CLASS -- so a receiver-and-arity match whose only fault is a
            // `mut`/`ro`/`consume` mismatch (P14) reached this arm too, and
            // "no such method" named the wrong axis. When the one known
            // method's own receiver already fits (checked by `only_row_of` +
            // `@binding_refusal` above), `@refuse_arg_type` names the real
            // slot -- type or class.
            if raw_row(single_row) >= 0 {
                @refuse_arg_type(kids, single_row, key, CallForm.MethodCall)
            } else {
                @refuse(t,
                    "outside the subset: this type has no such method in the declarations novac was handed")
            }
        }
        // Several rows take this receiver and this many arguments, and none of
        // them fits the types. Naming a position would mean naming ONE
        // candidate as the intended one, and which was intended is unknown.
        FnOverloaded(_) => @refuse(t,
            "outside the subset: no overload of this method accepts these argument types")
        FnFound(row) => @refuse_arg_type(kids, row, key, CallForm.MethodCall)
    }
}

/// The whole verdict of one method lookup, in one place: record it, or decline
/// it BY NAME. THREE outcomes and three answers -- no arm falls through.
///
/// `FnOverloaded` was RECORDED here until 2026-08-20 (the untyped key made
/// every pick the same C name), then REFUSED BY NAME until E2-b3 M1 (the key
/// carried no argument types, so narrowing would be a guess). The key is typed
/// now, so what remains of `FnOverloaded` is the real thing: two rows fit and
/// neither is more specific — D84 says refuse the tie, never choose ("there is
/// no silent choice"). The oracle silently picks one here (registry #857); the
/// spec outranks the oracle, so the divergence is novac being RIGHT.
///
/// `compiles_body` is the other refusal, and it is the same kind of statement:
/// novac read the signature of a std method but does not emit its body, so
/// there is no symbol to call. Owner's decision 2026-08-20 -- refuse by name,
/// and lower the corpus baseline in the same wave rather than emit C that
/// cannot link.
fn Checker mut @judge_method_lookup(e Node, t Token, key []ArgSpec, found FnLookup) -> () {
    match found {
        // NOT FOUND may mean "no such method" or "this method, reached wrongly"
        // (wave 4): `@peek(nope: 1)` and `@peek(1)` both fit no row, and telling
        // the reader the method does not exist would send them hunting a name
        // that is right there. The ladder names the rule it established.
        FnUnknown => @refuse_method_call(e, t, key)
        FnOverloaded(_) => {
            if key_fully_typed(key) {
                // A LANGUAGE refusal, not a subset limit: the oracle refuses
                // this too -- by the spec's word if not yet by its own (#857).
                @refuse(t,
                    "this call fits more than one method and none is more specific -- an ambiguity is refused, never chosen (D84)")
            } else {
                // An argument novac could not type matches EVERY overload, so
                // the set did not narrow -- novac's ignorance, not the
                // program's ambiguity, and the message must not claim D84.
                @refuse(t,
                    "outside the subset: an argument's type is not decided yet, so this overloaded method is not narrowed")
            }
        }
        FnFound(row) => {
            if @ctx.fns.rows[raw_row(row)].tparam_cnt > 0 {
                @record_instance_method(e, t, row, key)
            } else if @ctx.fns.compiles_body(row) {
                // The target carries its OWN row: no unwrap here, and no
                // `DefKind` beside it. Until 2026-08-21 this line handed the
                // channel a bare int whose meaning depended on a second
                // argument -- the pair that made a variant row indistinguishable
                // from a callable one.
                ro mfd = @ctx.fns.rows[raw_row(row)]
                @chan.record_callee(e.id_of(), CalleeTarget.CalleeFn(row), []TyId.new(),
                    bind_slots(@ctx.fns.params, mfd.param_off, mfd.param_cnt, key))
            } else {
                // A HANDED method of a PLAIN type (274.7 B1b-1, 2026-09-05): callable
                // when the shell carries its symbol -- the very rule the generic
                // instance path applied to `v.len()` all along, now through the one
                // symbol door (`c_method_symbol`: plain vs instance spelling). Until
                // this day every such call was refused as "no body", which was true
                // of novac and false of the program: the shell links the body.
                // INTEROP, with the same end condition as the instance path.
                ro mfd = @ctx.fns.rows[raw_row(row)]
                ro sym = c_method_symbol(@ctx, key[0].type_id, t.text)
                // `@link_check`: a `with` handler value is typed but never
                // linked this wave (Checker field doc) — the shell question
                // is not asked in handler position, the callee is recorded
                // like any other.
                if @ctx.interop.has(sym) || !@link_check {
                    @chan.record_callee(e.id_of(), CalleeTarget.CalleeFn(row), []TyId.new(),
                        bind_slots(@ctx.fns.params, mfd.param_off, mfd.param_cnt, key))
                    @record(e, mfd.ret_id)
                } else {
                    @refuse(t,
                        "outside the subset: the shell novac links into carries no `${t.text}` for ${ty_source_name(@ctx, key[0].type_id)} -- novac read the signature but has no body to emit")
                    // A refusal is ALSO a decision (274.4 step 2): the row is
                    // known, so its declared return goes into the channel. The
                    // walk continues past a refusal (poisoning discipline), and
                    // the parent asking this node's type must read the checker's
                    // answer -- type_of re-resolving the name was the second door.
                    @chan.record_type(e.id_of(), mfd.ret_id)
                }
            }
        }
    }
}

/// A GENERIC method resolved on an instance receiver -- `v.len()` with `v` a
/// `Vec[int]` (sub-plan L2). The type arguments are deduced from the typed key
/// by structural matching (the same door the free generic calls of wave B1
/// use); the row has no body of ours, so the callee is the SHELL's instance
/// method -- interop, checked against the lifted surface before anything is
/// printed, and gone the day novac emits the whole prelude. The call's type is
/// DECIDED here: `tys.subst` interns the substituted return, the one write to
/// the lattice this path makes, and `type_of` reads it from the channel.
fn Checker mut @record_instance_method(e Node, t Token, row FnRow, key []ArgSpec) -> () {
    ro kids = branch_children(e)
    // The key IS the typed key since E2-b3 M1 -- this path built its own
    // second one while the caller's was untyped; one door, built once.
    ro ids = match @deduce_from_args(row, key, kids) {
        None => return
        Some(v) => v
    }
    ro fd = @ctx.fns.rows[raw_row(row)]
    if @ctx.fns.compiles_body(row) {
        @refuse(t, "outside the subset: a generic method declared in this file -- mono instantiates functions, not methods, yet")
        return
    }
    ro sym = c_method_symbol(@ctx, key[0].type_id, t.text)
    // `@link_check`: a `with` handler value is typed but never linked this
    // wave (Checker field doc) — the shell question is not asked in handler
    // position; the instance recording below runs like any other.
    if !@ctx.interop.has(sym) && @link_check {
        // THE ADVICE IS TRUE FOR A HANDED TYPE AND IMPOSSIBLE FOR THIS FILE'S
        // OWN, so it is given only where it can be followed. "The method
        // arrives when the probe calls it" is exactly how `Option[int]` was
        // closed (2026-09-19: one call added to `shell_probe.nv`, shell
        // regenerated, the refusal gone) -- but the probe is a program
        // compiled BEFORE the user's, and it can never call a blanket method
        // on a type the user's file declares. Sending that reader to the probe
        // sends them nowhere, and a refusal that spends the reader's time
        // pretending to help is worse than one that spends none (the class of
        // the two rows filed this night).
        ro rname = ty_source_name(@ctx, key[0].type_id)
        if @ctx.defs.declared_by_file(rname) {
            @refuse(t, "outside the subset: `${t.text}` on `${rname}`, a type THIS FILE declares, is not compiled yet -- a generic method reaches novac only through the shell, and the shell cannot carry one for a type it has never seen (274.7 B1b-2)")
        } else {
            @refuse(t, "outside the subset: the shell novac links into carries no `${t.text}` for ${rname} -- the interop surface is the probe program (novac/probe/shell_probe.nv); the method arrives when the probe calls it (274.7 B1b-2)")
        }
        // Refused, but judged: the deduced return is this node's type
        // (274.4 §2 -- a refusal records its decision too).
        @record(e, @ctx.tys.subst(fd.ret_id, ids))
        return
    }
    ro ret = @ctx.tys.subst(fd.ret_id, ids)
    if @ctx.tys.kind_of(ret) == TypeKind.TkApp && decl_of_ty(@ctx, ret).kind == TypeKind.TkSum {
        // OPTION took its family spelling with the if-let wave (NovaOpt_<elem>,
        // the mangle door) -- so an Option-returning instance method is now an
        // ordinary interop call. Every OTHER sum family keeps the refusal
        // until its carrier arrives.
        if !is_ty(option_payload(@ctx, ret)) {
            @refuse(t, "outside the subset: this method returns `${ty_source_name(@ctx, ret)}` -- an instance of a sum, whose family spelling novac does not take yet")
            // Refused, but judged: the substituted return is known (274.4 s2).
            @record(e, ret)
            return
        } else {
            // Option: falls through to the ordinary interop recording below.
        }
    }
    @chan.record_callee(e.id_of(), CalleeTarget.CalleeFn(row), ids,
        bind_slots(@ctx.fns.params, fd.param_off, fd.param_cnt, key))
    @record(e, ret)
}

/// `Sum.Variant(x)`. Lifted out of `@type_expr` on 2026-09-15 when exprs.nv passed the
/// 1000-line limit (274, decision 12); moved again 2026-09-21 from `calls.nv`, which
/// crossed the same limit -- to its own sibling file, matching this file's own header:
/// "calls.nv is its sibling for a FREE call, and the split is the language's own". The
/// cut is by SUBJECT, not by size: a method call's home is this file.
fn Checker mut @type_method_call(e Node) -> () {
    ro kids = branch_children(e)
    if kids.len() < 3 {
        @report_first_leaf_of(kids, "outside the subset: a method call needs a name after the dot")
        return
    }
    // `Sum.Variant(x)` WEARS THIS SHAPE and is not a method call. Asked
    // before the receiver is walked, because a type name is no bound value
    // and the name walk would refuse it as unknown -- the first of the two
    // refusals this spelling used to collect.
    // Same question one line earlier than the variant door, and for the same
    // reason it names: a type name is no bound value, so the name walk would
    // refuse it as unknown and say nothing about types (registry #1150).
    if @report_if_path_head_unknown(kids) { return }
    // AN EFFECT-OPERATION CALL is judged BEFORE the variant door below:
    // `Fs.read("p")` wears this shape with an EFFECT name as its head, and
    // the variant judge would name a non-sum head ("not one of its
    // variants") instead of asking the effect schema. Measured 2026-09-23:
    // without this door the call refused as "no such method" (walk) or as
    // a non-sum variant head (typing), while the oracle types it green.
    if @type_effect_op_call(e, kids) {
        // SILENT-OK: the door DECIDED -- it recorded the call's type, or
        // refused by name (unknown operation, arity, an argument's type).
        // The variant and ordinary-method paths below answer questions
        // this shape does not ask.
        return
    } else {
        // The head is no effect: an ordinary call, judged below.
    }
    if @judge_type_head_variant(e, kids, 3) {
        // SILENT-OK: the door DECIDED -- it recorded the construction and
        // its type, or refused the shape. Nothing is left for the method
        // path to say about this node.
        return
    } else {
        // Not a variant construction: an ordinary method call, judged below.
    }
    // ARGUMENTS FIRST -- the free-call rule of 2026-08-21, arriving here
    // with the typed method key (E2-b3 M1). The key of a call IS its
    // argument types, and the walk is what VERIFIES each argument before
    // the lattice is asked; a refusal anywhere in the children stops the
    // resolution, because the type the key would carry is not trustworthy.
    ro before = @out.len()
    @type_expr(kids[0])
    mut i = 0
    for c in kids {
        if i > 2 && is_expr_kind(c.kind_of()) {
            @type_expr(c)
        } else {
            // Children 0..2 are the receiver, the dot and the method
            // name, and a punctuation leaf is no expression: nothing to
            // walk, and the cursor still has to advance.
        }
        i += 1
    }
    // The mark, not the file's count (274.4 step 2): the file-wide
    // `== 0` guard silenced the judge for every method call after the
    // FIRST refusal anywhere in the file -- no refusal, no recorded
    // type, and the silence was covered by type_of re-resolving the
    // name (the second door). The question is about THIS call's children.
    if @out.len() == before {
        // The arguments' types, for the hoist that orders their effects
        // (F65). From slot 3: receiver, dot and name come first, exactly as
        // the typing loop above says with `i > 2`.
        @record_arg_types(kids, 3)
        ro recv_t = type_of(kids[0], @ctx, @scope, @chan)
        @record(kids[0], recv_t)
        if !is_ty(recv_t) {
            // The receiver's own type never arrived -- not from THIS
            // call's children (the mark above stayed put), but from an
            // EARLIER refusal at its bind site, poisoning it with
            // no_ty(); a bare-name re-read raises no new diagnostic,
            // which is exactly why the mark alone let this reach here.
            // A key built over that would resolve on a type nobody
            // trusts, the same invariant the else branch below already
            // states about its own case (poisoned_recv_match/neg_1.nv).
            // SILENT-OK: the earlier refusal already spoke.
            return
        } else {
            // A real type: the lookup below may proceed.
        }
        // The DECISION, not a hint: which row this method call goes to.
        // Until 2026-08-18 nobody made it -- check only asked whether the
        // NAME existed anywhere, and the emitter rebuilt the C name from
        // the receiver's type. That is two answers to one question, the
        // shape plan 196 exists to remove, and it is why the mangling door
        // had to be two doors. Same lookup door the diagnostics use.
        @record_method_callee(e, kids, recv_t)
        // D227 rule 2: a bare literal argument now takes the type of the
        // parameter the binding gave it (and rule 3 judges its range).
        @adapt_literal_args(e, kids, 3, 1)
    } else {
        // The receiver or an argument was refused: the walk above already
        // spoke, and a key built over a refused child would resolve on a
        // type nobody trusts. One run still shows every mistake -- the
        // children were all walked before this mark was read.
    }
}


/// Does this qualified-call shape carry an EFFECT name as its head? The ONE
/// question both halves of the judgement ask: the shape walk (which must
/// not call an operation a missing METHOD) and the typing door below (which
/// judges the call against the effect's schema). A bound value of the same
/// name wins -- `fn f(Fs SomeRec) { Fs.read("p") }` is an ordinary method
/// call on the parameter, and the nearer scope is the authority the
/// path-head door already defers to (registry #1150's rule, one domain
/// over).
fn Checker @effect_op_head(kids []Node) -> bool {
    if kids.len() < 3 { return false }
    if kids[0].kind_of() != NodeKind.Name { return false }
    ro head_name = expr_leaf_name(kids[0])
    if @scope.is_bound(head_name) { return false }
    match @ctx.defs.type_decl(head_name) {
        None => false
        Some(d) => @ctx.types[raw_decl(d)].kind == TypeKind.TkEffect
    }
}

/// AN EFFECT-OPERATION CALL, `Fs.read("p")` (E.4 item 2, plan 274.11): the
/// method-call shape with an EFFECT name as its head. The head names no
/// value -- it names the effect whose schema declares the operation -- so
/// the ordinary method path (type the receiver as an expression, resolve
/// the name on the callable table) has nothing to stand on. This door
/// answers the three questions the schema CAN answer: the operation
/// exists, the arity fits, the arguments fit the declared parameter types.
///
/// THE HANDLER QUESTION IS DELIBERATELY NOT ASKED. The oracle's acceptance
/// (E.4 item 2) types the call with or WITHOUT an installed handler, and a
/// missing handler is a RUNTIME panic there, not a check error -- a green
/// check on `Fs.read("p")` with no `with` in sight is the acceptance, not a
/// hole in it.
///
/// Returns true when THIS node was decided (recorded with the operation's
/// return type, or refused by name); false when the head is no effect and
/// the caller's ordinary paths apply. HOW THE CALL LOWERS (handler
/// dispatch) is not this wave: like the with statement, the call is typed
/// but not emitted, and an emit-side ice there is the same standing debt.
fn Checker mut @type_effect_op_call(e Node, kids []Node) -> bool {
    // SILENT-OK: a head that is no effect is not this door's subject --
    // the caller's variant and ordinary-method paths decide that node, and
    // returning false only hands the shape on, it decides nothing here.
    if !@effect_op_head(kids) { return false }
    ro head_name = expr_leaf_name(kids[0])
    ro edecl = @ctx.defs.type_decl(head_name) ?? ice("check: the effect-op head lost its declaration between two reads of one Option")
    ro onm = match kids[2] {
        Leaf(t) => t
        Branch { .. } => { return false }
    }
    ro opname = onm.text
    ro schema = @ctx.effects.def_of(head_name) ?? ice("check: an effect declaration with no op schema reached the effect-op call door")
    // (a) THE OPERATION MUST BE IN THE SCHEMA -- the call-side sibling of
    // the handler literal's E_HANDLER_OP_UNKNOWN (one family, two
    // positions; the literal's door names the same shape). The oracle's
    // exact wording for a bad operation CALL was not probed -- this is the
    // family wording, and a direct probe is filed for the followup.
    mut sig_at = -1
    for i in schema.op_off..schema.op_off + schema.op_cnt {
        if @ctx.effects.ops[i].name == opname {
            sig_at = i
        } else {
            // Not this one; the next operation may carry the name.
        }
    }
    if sig_at < 0 {
        ro what = effect_op_list(@ctx.effects, schema)
        @refuse(onm, "`${head_name}.${opname}` is not an operation of effect `${head_name}` -- it declares: ${what}. An operation call may only name operations the effect declares: check the spelling, or the operation may have been removed from `${head_name}` while this call kept using it. (E4, wave 274.11)")
        return true
    }
    ro sig = @ctx.effects.ops[sig_at]
    // ARGUMENTS FIRST, the free-call order of 2026-08-21: each argument is
    // typed through the ordinary expression walk, so every refusal
    // machinery that already exists for arguments answers here without a
    // copy. The mark is this call's, not the file's (#902's rule). Named
    // arguments are not the measured grammar of an operation call and are
    // not counted -- a file that writes one meets the arity refusal below,
    // which names the counts and so is not silent about the shape.
    ro before = @out.len()
    mut args = []Node.new()
    mut i = 0
    for c in kids {
        if i > 2 && is_expr_kind(c.kind_of()) {
            @type_expr(c)
            args.push(c)
        } else {
            // Children 0..2 are the head, the dot and the operation name,
            // and a punctuation leaf is no expression: nothing to walk,
            // and the cursor still has to advance.
        }
        i += 1
    }
    if @out.len() > before {
        // SILENT-OK: an argument's own refusal already spoke; the type a
        // comparison would use is not trustworthy, the same invariant the
        // ordinary call paths state at their own marks.
        return true
    }
    // (b) ARITY, named with both counts -- a body judged against the wrong
    // arity would answer questions the operation never asked.
    if args.len() != sig.param_cnt {
        @refuse(onm, "effect operation `${head_name}.${opname}` takes ${sig.param_cnt} parameter(s), but this call passes ${args.len()} -- operation calls must match the effect's declaration exactly. (E4, wave 274.11)")
        return true
    }
    // (c) EACH ARGUMENT against the schema's parameter type, through the
    // ONE unification door (`type_admits`) -- int where the operation
    // declares str is refused here with both types named, the same lattice
    // every other position asks. A schema parameter novac could not read
    // (a handed declaration with an unresolvable type) is not compared --
    // the ProtoSig precedent: the declaration's own gap owns that sentence,
    // not the caller. Bare literals are NOT adapted to the parameter width
    // this wave: the D227 literal-adaptation machinery belongs to the
    // ordinary call paths, and copying it here would be the second door.
    for a in 0..args.len() {
        ro got = type_of(args[a], @ctx, @scope, @chan)
        if !is_ty(got) {
            // SILENT-OK: an argument whose type never arrived was poisoned
            // by an earlier refusal at its own bind site; the mark above
            // stayed put, and comparing on no_ty would ice the lattice.
            return true
        }
        ro want = @ctx.effects.op_params[sig.param_off + a]
        if is_ty(want) && !type_admits(@ctx.tys, want, got) {
            @refuse(onm, "effect operation `${head_name}.${opname}` argument ${a + 1} is `${ty_source_name(@ctx, got)}`, but the operation declares `${ty_source_name(@ctx, want)}` -- operation calls must match the effect's declaration exactly. (E4, wave 274.11)")
            return true
        }
    }
    @record_arg_types(kids, 3)
    // THE CALL'S TYPE is the operation's declared return -- recorded for
    // every reader of the channel, the same decision a resolved call
    // writes. What the emitter DOES with the call is the lowering wave's
    // question, not this door's.
    @record(e, sig.ret_id)
    true
}
