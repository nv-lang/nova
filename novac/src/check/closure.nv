// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check/closure.nv -- the CLOSURE-LIGHT typist (D22), the
// supervised-value wave's contextual literal.
//
// Donor: none -- the form is the language's own (D22); the body-typing
//   discipline is the handler-op typist's (check/handler.nv), reused door
//   for door so a closure body judges `return` and its tail exactly as a fn
//   body does -- one return discipline, not a closure-flavoured copy.
// Role: layer 7 (check) -- types `|params| body` against a signature the
//   CONTEXT gives (the supervised-value wave: `on_timeout:` of a `supervised`
//   value, `fn(TimeoutError) -> T`). The literal carries no types of its own
//   (D22): params are bare names, the result is the context's.
// Used by: check/with_typing.nv (@type_supervised_value types the on_timeout
//   closure here). The subset walk admits the form only in that slot
//   (closure_pos, check/check.nv); @type_expr refuses it by name elsewhere.
// Guarded by: check-novac-file-size.py, pipeline/concurrency_test.nv.
//
// A co-equal file of module `novac.check` (folder = one module), cut by
// MEANING under decision 12: handler.nv judges the literal that carries
// effect-op declarations, this one the literal that carries a single body
// under a contextual signature.

module novac.check

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind, no_node}
import ../sem.{branch_children, leaf_text, leaf_kind, closure_param_count, ParamMode, FnRow, raw_row, slot_binding_in}
import ../builtins.{TypeKind}
import ../types.{TyId, is_ty, no_ty}

/// ONE closure-light literal against the signature the context gives. `sig`
/// is a `TkFn` term (types.nv `@fn_type`): the head is the arity, the args
/// carry the params in order with the RESULT LAST (`@arg(sig, arity)`). The
/// params bind read-only (D22: a closure captures primitives by copy, objects
/// by managed ref; a `mut` capture shares a slot -- the capture-mark stack
/// records it, exprs.nv's Name arm, exactly as a handler op's captures). The
/// body is judged against the result through the fn body's own doors
/// (`@ret_expect` / `@tail_value_body` / `@judge_return`), saved and restored
/// so the enclosing fn's return expectation survives -- the handler-op
/// precedent, door for door.
fn Checker mut @type_closure_lit(e Node, sig TyId) -> () {
    ro lexical = @scope.lexical
    @scope.lexical = binding_scope_of(e)
    @type_closure_lit_in_scope(e, sig)
    @scope.lexical = lexical
}

fn Checker mut @type_closure_lit_in_scope(e Node, sig TyId) -> () {
    ro kids = branch_children(e)
    // SILENT-OK: a literal with no body is the parser's recovery marker in a
    // shape the walk already reported -- nothing to type against the sig.
    if kids.len() < 2 { return }
    ro before = @out.len()
    // `arg_count` is the FULL args length (params + result, types.nv `@intern`
    // sets `arg_cnt: args.len()`); the head is the arity. So the param count is
    // `arg_count - 1` and the result sits at that index -- the mangle.nv TkFn
    // reader's own arithmetic (`arity = arg_count(t) - 1`, result `arg(t, arity)`).
    ro arity = @ctx.tys.arg_count(sig) - 1
    ro result = @ctx.tys.arg(sig, arity)
    mut cps = []TyId.new()
    for i in 0..arity {
        cps.push(@ctx.tys.arg(sig, i))
    }
    ro _ = @type_closure_core(e, cps, result, false)
    if @out.len() == before {
        // The literal's own type IS the context's signature: a closure value
        // carries `fn(TimeoutError) -> T`, the term the emitter spells as a
        // `NovaClosBase*` (mangle.nv's TkFn layout, the interop precedent).
        @record(e, sig)
    } else {
        // SILENT-OK: the body refused itself; a second word about its type
        // would be the second death over one cause.
    }
}

/// THE ONE CLOSURE-TYPING PATH (D22): params bind read-only from `cps`, the
/// capture mark records every outer binding the body reads, and the body is
/// judged by the fn body's own doors with the return state saved and restored.
/// `infer` is the FREE-RETURN mode the argument door uses (E.11): the result is
/// not given, the body types against no expectation (`@judge_return` says nothing
/// when `@ret_expect` is absent) and the tail's type R is read back for the caller
/// to bind the result slot to. The KNOWN mode (`infer` false) judges the body
/// against `ret_expect` exactly as the supervised-value wave's `on_timeout`
/// typist always has -- one door, two modes, not two diverging typists. Returns
/// the tail's type (the known mode's caller records the given sig instead).
fn Checker mut @type_closure_core(e Node, cps []TyId, ret_expect TyId, infer bool) -> TyId {
    ro kids = branch_children(e)
    if kids.len() < 2 { return no_ty() }
    ro body = kids[kids.len() - 1]
    ro before = @out.len()
    ro arity = cps.len()
    ro pcnt = closure_param_count(e)
    if pcnt != arity {
        @report_first_leaf_of(kids, "a closure literal takes ${arity} parameter(s) here -- the context's signature is `fn(...) -> ...` with ${arity}, and this one writes ${pcnt} (D22: a closure's signature comes from its context, the supervised-value wave)")
        return no_ty()
    }
    ro lexical = @scope.lexical
    @scope.lexical = binding_scope_of(e)
    // THE CAPTURE MARK (E.9 step 3's discipline): every binding that exists
    // now is outside this literal, so a read of one from the body is a
    // capture, recorded by exprs.nv's Name arm against this owner.
    @cap_marks.push(@scope.row_count())
    @cap_owners.push(e.id_of())
    ro pmark = @scope.mark()
    // The params ride the children between the pipes: Ident leaves in order,
    // Comma leaves skipped, the closing Pipe and the body excluded. `_` binds
    // nothing (D22's wildcard param); a named one takes its parameter's type.
    mut pi = 0
    for i in 1..kids.len() - 1 {
        ro c = kids[i]
        if c.kind_of() == NodeKind.LeafNode && leaf_kind(c) == TokenKind.Ident {
            ro pname = leaf_text(c)
            if pname != "_" {
                @bind_source(e.id_of(), pname, cps[pi], ParamMode.ModeRo)
            } else {
                // The wildcard param: a position with no binding.
            }
            pi += 1
        } else {
            // A Comma separator or the closing Pipe leaf.
        }
    }
    ro saved_ret = @ret_expect
    ro saved_tail = @tail_value_body
    ro saved_unit = @ret_unit
    ro saved_ro = @ret_ro
    // A closure body is a FUNCTION OF ITS OWN: a `return` written in it
    // belongs to the closure, so the split boundary of a supervised value
    // around the literal does not cross in (remark 6/7, function boundaries).
    ro saved_split = @sup_split_depth
    ro saved_ve = @value_expect
    @sup_split_depth = 0
    @ret_ro = false
    @ret_expect = ret_expect
    @ret_unit = if infer { false } else { @returns_unit(ret_expect) }
    @value_expect = if infer { no_ty() } else { saved_ve }
    mut r = no_ty()
    match body.kind_of() {
        NodeKind.Block => {
            if infer {
                // Free return: the block-value walk returns its tail's type, the
                // same door a value `if` branch uses; required, the result is a value.
                @tail_value_body = body.id_of()
                r = @type_block_value(body, true)
            } else {
                // The closure writes no `-> T` (D22), so `value_body_of` -- which reads
                // a written RetType -- cannot mark the tail; the result decides: a
                // value result makes the block's tail the returned value, a unit
                // result demands none. The fn body's own tail door does the judging.
                if @ret_unit {
                    @tail_value_body = no_node()
                } else {
                    @tail_value_body = body.id_of()
                }
                ro tmark = @out.len()
                @type_block(body)
                if !@ret_unit && @out.len() == tmark {
                    // A VALUE body that ends without a value used to pass here and
                    // emit a numeric C function that falls off its end (remark 4).
                    // The fn body's own rule, with the closure's own text (D22: the
                    // result is the context's, there is no written declaration).
                    @report_if_block_tail_has_no_value(body, CLOSURE_NO_VALUE_MSG)
                } else {
                    // A unit result demands none; or the block refused itself, and a
                    // second cause would be the second death.
                }
            }
        }
        // ANY other kind is the body's own expression form, read by the
        // parser's `@expr()` -- an OPEN set of value kinds (parse/closure.nv),
        // so all of them are typed by the one tail door, not enumerated.
        other => {
            ro bmark = @out.len()
            @type_tail_value(body)
            if @out.len() == bmark {
                r = @tail_type_of(body)
                @judge_return(body, r)
            } else {
                // Refused while typing: the walk already spoke.
            }
        }
    }
    @ret_expect = saved_ret
    @tail_value_body = saved_tail
    @ret_unit = saved_unit
    @ret_ro = saved_ro
    @sup_split_depth = saved_split
    @value_expect = saved_ve
    @scope.release(pmark)
    ro _ = @cap_marks.pop()
    ro _ = @cap_owners.pop()
    @scope.lexical = lexical
    if @out.len() > before { return no_ty() }
    r
}

/// THE CLOSURE-ARGUMENT DOOR (the E.11 remainder, D22 context 1): a closure
/// literal standing at a fn-typed CALL PARAMETER takes its signature from that
/// parameter -- the sem table's row, no name hardcoded (П5). A generic std
/// method's callable parameter (`map_err[F](err_fn fn(E) -> F)`) mentions the
/// receiver's slots in its params and a fresh slot in its result: the receiver
/// fixes the first, the closure body's own return fixes the last. So bind the
/// receiver's slots, substitute them into the parameter types (TOTAL for them --
/// they mention only receiver slots), type the body with a FREE return and read
/// its type R, then substitute the FULL vector into the parameter. The result is
/// the concrete signature the literal carries and the call's own deduction reads
/// back (`@deduce_from_args` walks the TkFn argument through `slot_binding_in`).
/// `@subst` is total by contract (types.nv:501): a partial vector is the
/// C++-template model of generics this project rejects, so F is bound BEFORE the
/// substitution, never left dangling inside it.
fn Checker mut @type_closure_arg(c Node, row FnRow, at int, recv_t TyId, pre []TyId) -> () {
    ro kids = branch_children(c)
    if raw_row(row) < 0 || at < 0 {
        @report_first_leaf_of(kids, CLOSURE_ARG_NEEDS_FN_MSG)
        return
    }
    ro fd = @ctx.fns.rows[raw_row(row)]
    if at >= fd.param_cnt {
        @report_first_leaf_of(kids, CLOSURE_ARG_NEEDS_FN_MSG)
        return
    }
    ro p = @ctx.fns.params[fd.param_off + at].type_id
    if !is_ty(p) || @ctx.tys.kind_of(p) != TypeKind.TkFn {
        @report_first_leaf_of(kids, CLOSURE_ARG_NEEDS_FN_MSG)
        return
    }
    // The receiver's slots, merged with what the call's position already fixed
    // (`pre`, arg_expect.nv): a slot the return-expectation bound keeps that
    // binding, else the receiver's structural deduction fixes it.
    mut bindings = []TyId.new()
    ro recv_p = if fd.has_recv { @ctx.fns.params[fd.param_off].type_id } else { no_ty() }
    for slot in 0..fd.tparam_cnt {
        mut b = if slot < pre.len() { pre[slot] } else { no_ty() }
        if !is_ty(b) && fd.has_recv {
            b = slot_binding_in(@ctx.tys, recv_p, recv_t, slot)
        }
        bindings.push(b)
    }
    ro arity = @ctx.tys.arg_count(p) - 1
    // The parameter types, receiver-substituted: total for them, they mention
    // only receiver slots. A parameter that still names an unbound slot has no
    // concrete type to bind -- the context cannot give this literal a signature.
    // (The param-COUNT check is the core's, one door for both modes.)
    mut cps = []TyId.new()
    for i in 0..arity {
        ro pt = @ctx.tys.subst(@ctx.tys.arg(p, i), bindings)
        if !is_ty(pt) || !@ctx.tys.is_concrete(pt) {
            @report_first_leaf_of(kids, CLOSURE_ARG_NEEDS_FN_MSG)
            return
        }
        cps.push(pt)
    }
    ro raw_ret = @ctx.tys.arg(p, arity)
    if @ctx.tys.kind_of(raw_ret) == TypeKind.TkParam {
        // The result is a bare type parameter: the receiver/position may already
        // have bound it, else the body's own return fixes it (inference).
        ro fslot = @ctx.tys.param_slot_of(raw_ret)
        if fslot < bindings.len() && is_ty(bindings[fslot]) {
            cps.push(bindings[fslot])
            @type_closure_lit(c, @ctx.tys.fn_type(cps))
            return
        }
        ro r = @type_closure_core(c, cps, no_ty(), true)
        if !is_ty(r) {
            // SILENT-OK: the body refused itself or produced no value; the walk spoke.
            return
        }
        bindings[fslot] = r
        @record(c, @ctx.tys.subst(p, bindings))
        return
    }
    // A composite result (`Result[T, F]`, `flat_map_err`): concrete only when the
    // receiver/position bound every slot it mentions; a still-unbound composite is
    // a later door -- named, not silent.
    ro ret_b = @ctx.tys.subst(raw_ret, bindings)
    if is_ty(ret_b) && @ctx.tys.is_concrete(ret_b) {
        cps.push(ret_b)
        @type_closure_lit(c, @ctx.tys.fn_type(cps))
        return
    }
    @report_first_leaf_of(kids, CLOSURE_ARG_NEEDS_FN_MSG)
}