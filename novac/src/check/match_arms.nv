// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `check_match` / Go `types2.stmt` for "an arm binds, then its
// body is typed, then the arms must agree"; NOT taken: exhaustiveness by
// witness construction (rustc's usefulness algorithm) — the subset's sums are
// small and the counted-coverage rule answers the same question here.
// Role: layer 4 — everything about a `match`: what an arm binds, what its body
//   is worth, and whether the arms agree on one type.
// Used by: the typing walk of check, at every stage from E2-a on.
// Guarded by: check-novac-match-exhaustive.py (every match over a sum is
// complete), check-novac-no-default-branch.py (no catch-all on a closed set),
// the module tests of check.
//
// WHY A FILE OF ITS OWN. `typing.nv` crossed 1000 lines (decision 12), and the
// answer is a cut along a seam rather than an exception. The seam is real: the
// rest of the file types declarations, statements and expressions, while these
// functions answer ONE question — what an arm is.

module novac.check

import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, bin_op_of, un_op_of, raw_node}
import ../diag.{ice}
import ../builtins.{ENTRY_FN, PRINT_FN, is_bool_literal, is_true_literal}
import ../names.{NameTable, NamespaceId}
import ../sem.{decl_of_ty, decl_fn_row, arm_body_at, Ctx, CheckOut, param_name_at, param_type_at}
import ../sem.{ty_source_name, is_never_ty}
// The ONE list of applied sums whose tags the shell spells -- asked here and by
// the emitter's tag test (emit_applied_sum.nv), so the two cannot part.
import ../sem.{is_shell_applied_sum}
// The pattern tree's doors (D486): the shape asked ONCE, the head and the
// parts through their own doors -- never slot arithmetic (registry 1191's
// class: a slot count and the meaning of what sits there are two doors).
import ../sem.{PatShape, pattern_shape, pattern_head_text, pattern_qualifier, pattern_subpatterns}
import ../sem.{pattern_lit_leaf, pattern_is_interp}
import ../sem.{pattern_fields, patfield_name, patfield_sub, pattern_rest, pattern_mode_word}
import ../sem.{pattern_name_node, patfield_name_node, rest_is_trailing}
import ../sem.{shape_of, field_range_of, no_frow}
import ../builtins.{SLICE_HEAD}
// The payload of an APPLIED sum, with the application's arguments put in.
import ../sem.{payload_as_seen, variant_is_record}
import ../sem.{branch_children, call_callee_text, is_expr_kind, leaf_text, leaf_kind, expr_leaf_name, raw_vrow, no_vrow}
import ../sem.{is_vrow, variant_range_of, variant_in_sum, variants_named, VariantRow}
import ../types.{TyId, no_ty, is_ty}

/// A match in STATEMENT position (274.5 wave B5): the scrutinee is typed and
/// recorded, the binders bound, the guards typed, the bodies walked AS
/// STATEMENTS, and coverage judged -- but no value question is asked: the
/// arms run for effect, and demanding that `{}` agree in type with
/// `{ println(x) }` would refuse legal code the census counts five files of.
/// IS THIS SCRUTINEE AN APPLIED SUM NOVAC CANNOT SPELL -- and if so, say it ONCE.
///
/// The head of an arm is found through the DECLARATION since 2026-09-20, so
/// `Some` over an `Option[int]` is no longer called a variant of ANOTHER sum
/// -- which was false and sent the reader looking for a mix-up not in their
/// code. An applied sum comes from the SHELL with the oracle's tag names and
/// value semantics (measured: `_novac_l2->tag` against a value struct, and an
/// undeclared `NOVAC_TAG_..._Option_Some`), so the emitter needs the shell's
/// spelling, not its own.
///
/// SINCE 2026-10-01 TWO OF THEM HAVE IT: `Option[T]` and `Result[T, E]`, whose
/// instances the shell spells by name -- the tag test through
/// emit_applied_sum.nv, the payload through the reads the lowering already had
/// (`.value` for Option, the `->payload.<V>._<i>` union for Result). The arms
/// of such a match are judged exactly as a plain sum's: the variant through
/// the declaration, the payload through `payload_as_seen`, coverage counted.
/// The question is ONE door (`is_shell_applied_sum`) that the emitter asks
/// too, so the two passes cannot disagree on which sums pass.
///
/// What stays refused, by name: every other applied sum the declarations hand
/// over -- `Outcome[T]` of the prelude is the one reachable today -- because the
/// shell spells it without a per-instance struct, and novac has no reading of
/// that spelling yet. A user's OWN generic sum never reaches this door: its
/// declaration is refused earlier (E2-b2, generic parameters).
///
/// AT THE MATCH AND NOT AT THE ARM, because the fact is a property of the
/// SCRUTINEE: at the arm it fired once per arm and said one thing twice.
fn Checker mut @report_if_applied_sum(kids []Node, scr_t TyId) -> bool {
    if !is_ty(scr_t) { return false }
    if @ctx.tys.kind_of(scr_t) != TypeKind.TkApp { return false }
    // TkApp alone only says "a generic type is applied" -- true for
    // `Vec[int]` (and `[]int`, its alias) and `HashMap[K, V]` exactly as
    // much as for `Option[T]`. The applied-sum refusal is honest only when
    // the HEAD DECLARATION itself is a sum (registry: match-on-slice was
    // misrouted through this door and refused with an unrelated `Option[int]`
    // message it never named).
    if decl_of_ty(@ctx, scr_t).kind != TypeKind.TkSum { return false }
    // The two the shell spells per instance pass; the arms are judged below.
    if is_shell_applied_sum(@ctx, scr_t) { return false }
    // Registry #1233's remaining half: the message used to be a static
    // string with `Option[int]` WRITTEN IN, regardless of which applied
    // sum actually triggered this gate -- honest for the shell's own
    // `Option`, a lie for any other applied sum reaching here. `scr_t` is
    // already resolved and checked above; naming it costs one call to the
    // same door every sibling message in this file already reads through
    // (`ty_source_name`, line 341).
    @report_applied_sum(kids, "a `match`", scr_t)
    true
}

/// An APPLIED sum novac cannot spell (`Outcome[int]`), under either form that
/// tests its tags -- `form` is "a `match`" (above) or "`is`" (is_expr.nv). ONE
/// refusal for the two doors, because the cause is one: the shell spells per
/// instance only `Option` and `Result` (`is_shell_applied_sum`), and a second
/// copy of the sentence would be a second debt line for one debt.
fn Checker mut @report_applied_sum(kids []Node, form str, sum_t TyId) -> () {
    @report_first_leaf_of(kids, "outside the subset: ${form} on an applied sum (`${ty_source_name(@ctx, sum_t)}`) is read but not compiled yet -- novac spells the shell's tags only for `Option` and `Result`, and this sum's belong to the shell too (E2-b2, with generics)")
}

/// THE SHARED HEAD of both match doors (`@type_match_stmt`, `@type_match`):
/// the scrutinee typed and recorded, then the two refusals the whole match
/// earns -- an applied sum (said once, at the match) and no arms at all (a
/// match with none covers no case, in either position). None = refused.
fn Checker mut @match_head(kids []Node) -> Option[TyId] {
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a match needs a scrutinee")
        return None
    }
    ro scr = kids[1]
    // RELATIVE to THIS call, not absolute (registry #1242, found by a peer
    // window's instrumented trap): `Checker.out` accumulates for the whole
    // FILE, not per-match, so a bare `@out.len() > 0` is true the moment
    // ANYTHING earlier in the file was refused -- every later match in that
    // same file then returns here silently, typing no arm at all, and a
    // LATER reader asking `type_of()` about an untyped arm body ICEs far
    // from the actual cause. Every sibling gate in `check/` (exprs.nv,
    // typing.nv, binds.nv, calls.nv, casts.nv, destructure.nv, rules.nv,
    // variant_rules.nv) already marks `@out.len()` BEFORE the call it is
    // judging and compares against THAT mark; this door and the one below
    // were the only two that compared against a literal `0`.
    ro before = @out.len()
    @type_expr(scr)
    if @out.len() > before { return None }
    ro scr_t = type_of(scr, @ctx, @scope, @chan)
    @record(scr, scr_t)
    if @report_if_applied_sum(kids, scr_t) { return None }
    if !has_match_arm(kids) {
        @reject_first_leaf_of(kids, EMPTY_MATCH_MSG)
        return None
    }
    Some(scr_t)
}

/// A `match` in STATEMENT position: its arms run for effect and none of
/// them yields a value to anyone.
///
/// Its pair is `@type_match`, the value door; they differ in what they do
/// with an arm's type and in nothing else, which is why the applied-sum
/// question is asked identically in both.
fn Checker mut @type_match_stmt(m Node) -> () {
    ro kids = branch_children(m)
    mut scr_t = no_ty()
    match @match_head(kids) {
        Some(t) => { scr_t = t }
        // SILENT-OK: the head refused the match by name already.
        None => return
    }
    ro before_arms = @out.len()
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        @type_arm_stmt(c, scr_t)
    }
    if @out.len() > before_arms { return }
    @report_if_not_exhaustive(kids, scr_t)
}

/// One statement-position arm: the value path minus the value -- binders and
/// guards through the same door (`@type_arm` owns them), the BODY walked as
/// a block or a statement, and the answer deliberately not asked.
fn Checker mut @type_arm_stmt(arm Node, scr_t TyId) -> () {
    ro mark = @scope.mark()
    ro ak = branch_children(arm)
    if ak.len() < 1 {
        @report_first_leaf_of(ak, ARM_PATTERN_VALUE_MSG)
        return
    }
    @bind_arm_pattern(ak, scr_t)
    for g in ak {
        if g.kind_of() != NodeKind.Guard { continue }
        ro gk = branch_children(g)
        if gk.len() < 2 { continue }
        @type_expr(gk[1])
        @refuse_block_form_in_guard(gk[1])
    }
    ro body = ak[arm_body_at(ak) ?? ice("check: a statement-position match arm with no body reached the checker")]
    @type_body(body)
    @scope.release(mark)
}

/// Does the match carry at least one arm?
fn has_match_arm(kids []Node) -> bool {
    for c in kids {
        if c.kind_of() == NodeKind.MatchArm { return true }
    }
    false
}

/// No arm typed yet. A function, not a bare `None` in the binding: the oracle
/// refuses an unannotated `None` (registry 221.1 #1517 -- nothing fixes its `T`),
/// and a declared local type is outside novac's subset (E2-b3).
fn no_arm_type() -> Option[TyId] => None

/// A match: the scrutinee's type is the answer the emitter needs (it declares
/// the C temporary with it); the arms bind their binders and are typed after.
fn Checker mut @type_match(m Node) -> () {
    ro kids = branch_children(m)
    mut scr_t = no_ty()
    // THE POSITION'S EXPECTATION IS THE ARMS', NOT THE SCRUTINEE'S (274.7
    // E2-b3): a tail match of a `-> Option[T]` fn lets an arm's bare `None`
    // take the declared return, and the scrutinee is a value of its own
    // type -- an expectation leaking into it would resolve a bare variant
    // name by the fn's return. Cleared for the head, restored for the arms.
    ro arm_expect = @value_expect
    @value_expect = no_ty()
    ro head = @match_head(kids)
    @value_expect = arm_expect
    match head {
        Some(t) => { scr_t = t }
        // SILENT-OK: the head refused the match by name already.
        None => return
    }
    ro before_arms = @out.len()
    mut first_t = no_arm_type()
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        // EVERY arm starts from the position's expectation: an arm's body may
        // clear it on its way (a statement, an `if`), and the next arm must not
        // inherit that -- `Branch { .. } => None` after a block arm was refused.
        @value_expect = arm_expect
        first_t = @fold_arm_type(c, scr_t, first_t, before_arms)
    }
    @value_expect = arm_expect
    if @out.len() > before_arms { return }
    // The agreed type is RECORDED here, where every arm was typed with its
    // binders in scope; `type_of` reads it back instead of re-asking an arm
    // body whose binders are gone.
    if Some(t) = first_t { @record(m, t) } else { // No arm yields a value: nothing to record.
    }
    @report_if_not_exhaustive(kids, scr_t)
}

/// (rule lives in @type_match now) Every arm of a match must produce the SAME type -- and until 2026-08-17
/// nobody checked, because `type_of` took the FIRST arm's type and the
/// comment beside it said the arms "agree by construction".
///
/// They do not. Probe -- and it must be written MULTI-LINE, because the
/// one-line form (arms separated by `,`, spec syntax.ru.md:115) is legal Nova
/// that this subset does not parse yet:
///
///     ro r = match n {
///         1 => 10
///         _ => 2.5
///     }
///
/// in a `-> f64` fn.
/// The emitted C declared `nova_int _novac_match_r`, then assigned
/// `((nova_f64)2.5)` into it, so the program returned 2 where the oracle
/// returns 2.5 -- valid C, wrong answer, no diagnostic anywhere. That is the
/// worst shape a defect can take (class K-C), and it survived because a
/// comment stood where a check belongs.
///
/// The subset REFUSES disagreement rather than unifying it. Unification here
/// would mean an expected type flowing down into the arms (the oracle has
/// it: the `-> f64` return coerces the integer literal), and that is
/// bidirectional inference -- E2-b3 work, not a patch. Refusing is the safe
/// direction: narrower than the language, never wider.

/// Fold one arm's type into the answer the arms agreed on so far.
///
/// Every arm of a `match` must carry the SAME type, and the first arm that has
/// one sets it. Both "no answer" cases are None and neither is a number: the
/// arm whose body the walk refused has no type to compare, and before the first
/// such arm there is nothing to compare AGAINST — two facts that shared the
/// value -1 until 2026-08-19 and were told apart by their position in the code.
fn Checker mut @fold_arm_type(arm Node, scr_t TyId, first Option[TyId], before_arms int) -> Option[TyId] {
    // No type: the arm reported a diagnostic and has nothing to offer, so the
    // fold carries the first one through.
    if Some(at) = @type_arm(arm, scr_t) { @agree_arm_type(arm, at, first, before_arms) } else { first }
}

/// The same fold once THIS arm has a type: agree with the first one or report.
///
/// `before_arms` (registry #1249, the #1242 class): the RELATIVE mark taken
/// by the caller before the arm-folding loop started, not literal zero. Was
/// `@out.len() == 0` -- true only when NOTHING in the whole FILE had ever
/// been refused, so a match placed anywhere after the file's first refusal
/// silently stopped reporting disagreeing arm types (K-C: the oracle refuses
/// `match n { 0 => 1  _ => "s" }`, novac accepted it once an earlier,
/// unrelated declaration had already been refused).
fn Checker mut @agree_arm_type(arm Node, at TyId, first Option[TyId], before_arms int) -> Option[TyId] {
    match first {
        // The first arm with a type sets what the rest must match.
        None => Some(at)
        Some(f) => {
            // An arm of type `never` (D26, B10 part 3) produces no value, so it
            // does not vote: `TkParam => ice(..)` beside `TkPrim => row.head_id`
            // is a match of `int`. A `never` first arm yields to the first arm
            // that has a value; a match whose every arm is `never` is `never`.
            if is_never_ty(@ctx.tys, f) {
                Some(at)
            } else {
                if at != f && !is_never_ty(@ctx.tys, at) && @out.len() == before_arms {
                    @report_first_leaf_of([]Node.of(arm), ARMS_DISAGREE_MSG)
                } else {
                    // The arm agrees, is `never`, or a diagnostic already
                    // stands: the answer is the first arm's type either way.
                }
                first
            }
        }
    }
}

/// One arm: binders first (payload fields of a variant pattern, or the whole
/// scrutinee under a plain binder), then the guard and the arm's value --
/// the emitter's order exactly.
/// Returns the arm BODY's type, and the return value is the whole point:
/// the binders of a pattern live only until `release(mark)` below, so the
/// body's type can be computed HERE and nowhere later. The first version of
/// the arm-agreement rule (F36) asked for it after the walk, outside the
/// scope, and turned a clean `match s { A(r) => r  B(w, h) => w * h }` into
/// a diagnostic -- the binders were gone by then.
/// Bind one arm's PATTERN into the scope. ONE recursive judgment over the
/// pattern tree (D486 §2): the flat slot walk this replaces was one of three
/// readers of a single grammar, and the tree is what lets the destructuring
/// binding, the conditions and the for header share this door as the arc
/// reaches them. Answers false when the pattern is refused.
fn Checker mut @bind_arm_pattern(ak []Node, scr_t TyId) -> bool {
    if ak[0].kind_of() != NodeKind.Pattern {
        @report_first_leaf_of(ak, "outside the subset: a match arm needs a pattern")
        return false
    }
    if @bind_pattern(ak[0], scr_t, ak, ParamMode.ModeRo, PatPos.PosArm) { return true }
    // A REFUSED arm pattern still binds its names, with no type: a statement arm
    // walks its body regardless, and `z` there said "unknown name" a second time
    // (registry 1382's `(a, .., z)`) -- the destructuring binding's own rule.
    @bind_names_untyped(ak[0])
    false
}

/// ONE pattern against ONE type. `ak` travels for report POSITIONS only:
/// every refusal of the arm points at the arm's first leaf, exactly as the
/// flat walk pointed. `dmode` is the DEFAULT binder mode of the POSITION
/// (D486 §4's single mode rule): the match arm's is `ro`, the destructuring
/// binding's is its own keyword, and a binder's mode word overrides it.
/// The shape is asked through the one door
/// (sem/pattern.nv) and matched exhaustively -- a form the subset cannot
/// judge is refused BY NAME in its own arm below, never fallen through
/// (the #652 class: a silent default on a closed set).
///
/// `pos` is WHERE the pattern stands (D486 §4, amendment 2026-09-30 p.1): the
/// position's predicate is judged at EVERY node of the tree, not at the root
/// alone (registry 1379) -- `ro (a, Some(b)) = p` is as refutable as
/// `ro Some(b) = p`, and `if Some(3) = o` compares a value exactly as `if 3 = o`.
/// The callers name the position once; none of them repeats the predicate.
fn Checker mut @bind_pattern(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    if @refused_at_position(pat, ak, pos) { return false }
    match pattern_shape(pat) {
        Lit => @bind_lit_pattern(pat, ty, ak)
        Wild => true
        Bind => @bind_name_pattern(pat, ty, ak, dmode, pos)
        Variant => @bind_variant_pattern(pat, ty, ak, dmode, pos)
        Record => @bind_record_pattern(pat, ty, ak, dmode, pos)
        Tuple => @bind_tuple_pattern(pat, ty, ak, dmode, pos)
        Array => @bind_array_pattern(pat, ty, ak, dmode, pos)
        Disj => @bind_disj_pattern(pat, ty, ak, dmode, pos)
    }
}

/// A LITERAL pattern. Each literal kind compares with a value of ITS OWN
/// type (`LIT_PATTERN_TYPE_MSG`): a string with a `str`, by content -- the
/// spec's "by value" (syntax.ru.md, pattern kinds), the oracle's `len` plus
/// `memcmp` -- and a char with a `char`, by codepoint. Until the string
/// family (E2-b) both were refused by name: the lowering could compare
/// neither, and the form used to die in the emitter with an ice.
/// A literal BELOW the arm's root is legal at any depth (D486 s2): the
/// lowering reads the value it stands on and tests it by a synthetic condition
/// (registry 1534, lower_match.nv `@lower_sub`). Until then it tested the root
/// only -- `A(3)` took `A(4)` -- and string and char literals there were
/// refused by name rather than handed the same wrong answer.
/// The integer magnitude door is asked here too (#1251): a `Pattern` node is
/// never a `Lit` node, so the generic literal walk never visits it, and a
/// 23-digit text once reached the C comparison verbatim, which clang refused
/// -- the failure #810 exists to prevent, at one position nobody had visited.
/// The same holds for the char and string judges: their walks never reach a
/// pattern either, so this door asks them itself.
fn Checker mut @bind_lit_pattern(pat Node, ty TyId, ak []Node) -> bool {
    if pattern_is_interp(pat) {
        @reject_first_leaf_of(ak, INTERP_PATTERN_MSG)
        return false
    } else {
        // A plain literal: its token answers below.
    }
    ro p0 = pattern_lit_leaf(pat)
    ro lk0 = leaf_kind(p0)
    // `true` / `false`: a LITERAL of `bool` (sem/pattern.nv), never a binder
    // named `true` (check x K4 hunt 2026-09-30: `nova_bool true = ...` in C).
    if is_bool_literal(leaf_text(p0)) {
        if ty == @ctx.prims.bool_id { return true }
        @reject_first_leaf_of(ak, BOOL_PATTERN_TYPE_MSG)
        return false
    }
    if lk0 == TokenKind.StrLit || lk0 == TokenKind.CharLit {
        return @bind_text_lit_pattern(p0, lk0, ty, ak)
    }
    if ty == @ctx.prims.str_id || ty == @ctx.prims.char_id {
        // An integer literal over a `str` has no comparison at all (the
        // oracle prints `scr == 3LL` on a `nova_str`, and clang refuses);
        // over a `char` it is the mixing D128 and D405 forbid in an
        // expression, and a pattern is no loophole (D486 s2, amendment
        // 2026-10-01). The oracle runs `97` over `char` -- registry 1535.
        @reject_first_leaf_of(ak, LIT_PATTERN_TYPE_MSG)
        return false
    } else {
        // An integer scrutinee, or one the rows below do not judge.
    }
    // THE ROW DOOR IS DELIBERATELY NOT ASKED: the oracle itself does not
    // apply D227 rule 3 at a pattern's position (`match x { 300 => .. }` on
    // `x u8` compiles clean on BOTH compilers), so this position asks only
    // what fits the widest row at all.
    if !int_text_fits(leaf_text(p0)) {
        @report_first_leaf_of(ak, INT_TOO_LARGE_MSG)
        return false
    }
    true
}

/// A STRING or CHAR literal pattern: the scrutinee must be of the literal's
/// own type, and the literal itself passes the judge its kind passes in an
/// expression -- the escape alphabet for a string, one codepoint for a char.
/// A POISONED scrutinee says nothing more: its refusal stands where it was
/// typed (the cascade rule of `@bind_variant_pattern`).
fn Checker mut @bind_text_lit_pattern(p0 Node, lk0 TokenKind, ty TyId, ak []Node) -> bool {
    if !is_ty(ty) {
        // SILENT-OK: a POISONED scrutinee -- refused where it was typed.
        return false
    } else {
        // A typed scrutinee: the literal's own type judges it.
    }
    ro own = if lk0 == TokenKind.StrLit { @ctx.prims.str_id } else { @ctx.prims.char_id }
    if ty != own {
        @reject_first_leaf_of(ak, LIT_PATTERN_TYPE_MSG)
        return false
    }
    ro before = @out.len()
    if lk0 == TokenKind.StrLit {
        @report_if_bad_escape([p0])
    } else {
        @judge_char_leaf(p0, ak)
    }
    @out.len() == before
}

/// A NAME-WRAPPED pattern: a binder, or a payload-less variant head -- the
/// names table decides which (D19). A variant of ANOTHER sum is refused by
/// the same text the qualified case uses: one rule, two spellings.
/// The binder is recorded with its type ON the Name node -- the emitter has
/// no scope and reads the channel, which is the discipline the record keeps.
fn Checker mut @bind_name_pattern(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    ro nm = pattern_head_text(pat)
    // BINDER OR VARIANT through the one door (registry 1380).
    match @name_in_pattern(nm, ty) {
        // A payload-less variant binds nothing -- and it IS a variant pattern:
        // as refutable as `A(x)` where the position takes irrefutable forms
        // only, at any depth (registry 1379: `ro (a, None) = p`, `for B in xs`).
        NameOwnVariant(_) => { return !@refused_unit_variant(ak, pos) }
        NameForeignVariant(_) => {
            if is_ty(ty) {
                @report_first_leaf_of(ak, WRONG_SUM_ARM_MSG)
            } else {
                // SILENT-OK: a POISONED scrutinee has no sum to compare with --
                // its refusal was said where it was typed, and "a different
                // sum" here was its cascade (26 of novac's own arms, 2026-10-01).
            }
            return false
        }
        NameBinder => {}
    }
    // The `ro` word is refused BY NAME here (wave P3): it stands only in an
    // if/while condition, and the mapping below would otherwise read it as
    // `consume` -- the `else` arm's silent default.
    match pattern_mode_word(pat) {
        Some(k) => {
            if k == TokenKind.KwRo {
                @reject_first_leaf_of(ak, RO_WORD_PATTERN_MSG)
                return false
            } else { // `mut`/`consume` are mapped by the door below.
            }
        }
        None => {}
    }
    ro mode = match pattern_mode_word(pat) {
        Some(k) => if k == TokenKind.KwMut { ParamMode.ModeMut } else { ParamMode.ModeConsume }
        None => dmode
    }
    @record(pattern_name_node(pat), ty)
    @scope.bind(nm, ty, mode)
    true
}

/// A VARIANT pattern with a payload: the head is judged against the MATCHED
/// SUM (wave B6, #964), then every payload position is bound RECURSIVELY --
/// a position may itself be a tuple, record or variant pattern (D157), which
/// is the nesting the flat walk read as one long run of binders.
fn Checker mut @bind_variant_pattern(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    ro head = pattern_head_text(pat)
    // THE TYPE IS ASKED ONLY WHEN THERE IS ONE: a poisoned scrutinee is
    // `TyId(-1)`, and asking the interner for its name walked off the end
    // (measured within a minute of writing the line that did). The qualifier
    // is compared with the DECLARATION's head name, not the applied spelling:
    // `ty_source_name` of `Option[int]` answers "Option[int]", which no
    // source qualifier ever writes (wave P3, if-let on `Option.Some`).
    ro wrong_qualifier = pattern_qualifier(pat) != "" && is_ty(ty) &&
                         pattern_qualifier(pat) != decl_of_ty(@ctx, ty).name
    if !is_ty(ty) {
        // SILENT-OK: a POISONED scrutinee -- the same cascade as a bare
        // variant name above; its refusal stands where it was typed.
        return false
    } else {
        // A typed scrutinee: its sum judges the head.
    }
    ro vrow = variant_in_sum(@ctx, ty, head) ?? no_vrow()
    if wrong_qualifier || (!is_vrow(vrow) && variants_named(@ctx, head).1 > 0) {
        @report_first_leaf_of(ak, WRONG_SUM_ARM_MSG)
        return false
    }
    if !is_vrow(vrow) {
        // `Foo(x)` where Foo is no variant of anything: the flat walk bound
        // Foo as a catch-all binder and silently dropped the payload -- a
        // refusal names the form instead (the #652 class again).
        @report_first_leaf_of(ak, VARIANT_PATTERN_MSG)
        return false
    }
    ro vr = @ctx.variant_rows[raw_vrow(vrow)]
    ro subs = pattern_subpatterns(pat)
    // A sub-pattern is a payload typed: the lost one refuses by its type's
    // name, before the arity rule below counts it (registry 1512).
    if subs.len() > 0 && @refused_lost_payload(ak, vrow) { return false }
    // A RECORD-FORM variant read POSITIONALLY (`Circle(r)` of `| Circle {
    // radius int }`): D54 makes the brace form normative, and the oracle refuses
    // it by name (E_RECORD_VARIANT_POSITIONAL_PATTERN, registry 719). `Circle(..)`
    // names no position and stays legal, as it does there.
    if subs.len() > 0 && variant_is_record(@ctx, vrow) {
        @reject_first_leaf_of(ak, RECORD_VARIANT_POSITIONAL_MSG)
        return false
    } else {
        // A positional variant, or no position named: the rules below.
    }
    // `..` IN A PAYLOAD STANDS ALONE (D486 §2, registry 1382): the constructor
    // pattern lists its positions, and `Cons(..)` is D59's one partial form.
    // `Pr(.., z)` bound z to the FIRST payload.
    if pattern_rest(pat) && subs.len() > 0 {
        @reject_first_leaf_of(ak, PAYLOAD_REST_MSG)
        return false
    } else {
        // No rest, or the rest alone: the arity rule below decides.
    }
    // `Cons(..)` -- D59's positional partial -- takes any payload arity.
    if subs.len() != vr.payload_cnt && !pattern_rest(pat) {
        @report_first_leaf_of(ak, PAYLOAD_ARITY_MSG)
        return false
    }
    mut i = 0
    mut ok = true
    for sub in subs {
        if i >= vr.payload_cnt { break }
        // AS THE SCRUTINEE SEES IT: for `Option[int]` the payload `T` is
        // `int`, and binding the parameter instead made the arms disagree
        // and the mangler assert.
        ro pt = payload_as_seen(@ctx, ty, @ctx.payload_types[vr.payload_off + i])
        if !@bind_pattern(sub, pt, ak, dmode, pos) { ok = false } else { // The position bound; the arm stays sound.
        }
        i += 1
    }
    ok
}

/// A TUPLE pattern against a structural tuple: positions bind by index, the
/// same door the destructuring binding asks (`tys.arg`). A round pattern on
/// anything named is refused -- D486: the round form is the positional
/// tuple's own, a named tuple is destructured by the brace form.
fn Checker mut @bind_tuple_pattern(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    ro anon_positional = match shape_of(@ctx, ty) {
        AnonPositionalTuple => true
        Record | ValueRecord | NamedTuple | PositionalTuple | AnonNamedTuple => false
    }
    if !anon_positional {
        @report_first_leaf_of(ak, TUPLE_PATTERN_MSG)
        return false
    }
    ro subs = pattern_subpatterns(pat)
    // `..` IN A TUPLE STANDS LAST (D486 §2, registry 1382): positions bind from
    // the front, so a binder after the rest named the wrong element.
    if pattern_rest(pat) && !rest_is_trailing(pat) {
        @reject_first_leaf_of(ak, REST_LAST_MSG)
        return false
    } else {
        // No rest, or a trailing one: the arity rule below decides.
    }
    if subs.len() != @ctx.tys.arg_count(ty) && !pattern_rest(pat) {
        @report_first_leaf_of(ak, TUPLE_ARITY_MSG)
        return false
    }
    mut i = 0
    mut ok = true
    for sub in subs {
        if i >= @ctx.tys.arg_count(ty) { break }
        if @bind_pattern(sub, @ctx.tys.arg(ty, i), ak, dmode, pos) {
            // The position bound; the arm stays sound.
        } else { ok = false }
        i += 1
    }
    ok
}

/// A RECORD pattern. A head (`Circle { radius }`) names a record-form
/// VARIANT, or the record's own type: that judgment is
/// `@bind_headed_record_pattern` (record_variant.nv), which comes back here
/// for the record's own name. Head-less, the pattern reads the scrutinee itself,
/// and the judgment is the destructuring binding's own (D411/D486): every
/// named field must exist, a partial list needs `..`, a renamed or nested
/// field binds its subpattern against the field's type.
fn Checker mut @bind_record_pattern(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    if pattern_head_text(pat) != "" { return @bind_headed_record_pattern(pat, ty, ak, dmode, pos) }
    @bind_record_fields(pat, ty, ak, dmode, pos)
}

/// The FIELDS of a record pattern against a record type -- the head-less form,
/// and the head that names the record itself (`Point { x, y }`).
fn Checker mut @bind_record_fields(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    ro named_form = match shape_of(@ctx, ty) {
        Record | ValueRecord | NamedTuple | AnonNamedTuple => true
        PositionalTuple | AnonPositionalTuple => false
    }
    if !named_form {
        @report_first_leaf_of(ak, RECORD_PATTERN_MSG)
        return false
    }
    mut named = 0
    mut ok = true
    for f in pattern_fields(pat) {
        ro fname = patfield_name(f)
        ro ft = if @fres.has_field(@ctx.fields, ty, fname) {
            @fres.field_type(@ctx.fields, ty, fname)
        } else {
            @report_first_leaf_of(ak, DESTR_NO_FIELD_PATTERN_MSG)
            ok = false
            no_ty()
        }
        // THE PATFIELD NODE CARRIES THE TYPE TOO: the lowering reads it for
        // the temporary a nested subpattern is read into (the channel is the
        // only table it may ask). On the refusal path `ft` is no_ty() and the
        // run stops here -- recording it would poison the channel instead.
        if is_ty(ft) { @record(f, ft) } else { // The refusal above already said it.
        }
        match patfield_sub(f) {
            Some(sub) => {
                if !@bind_pattern(sub, ft, ak, dmode, pos) { ok = false } else { // The field bound, the arm sound.
                }
            }
            None => {
                if !@bind_field_shorthand(f, ft, ak, dmode) { ok = false } else { // Bound under its own name.
                }
            }
        }
        named += 1
    }
    if !ok { return false }
    // THE `..` RULE (D411, D486 §3 -- in every position now): a partial field
    // list is legal only when the pattern says the rest is meant.
    ro fr = field_range_of(decl_of_ty(@ctx, ty)) ?? (no_frow(), 0)
    if named < fr.1 && !pattern_rest(pat) {
        @report_first_leaf_of(ak, destr_needs_rest_msg(named, fr.1))
        return false
    }
    true
}

/// A SHORTHAND field (`{ radius }`, `{ mut n }`): the field binds under its own
/// name, in the mode its word gives or the position's default. False when the
/// `ro` word was refused. One door for the record and the record-form variant.
fn Checker mut @bind_field_shorthand(f Node, ft TyId, ak []Node, dmode ParamMode) -> bool {
    // The `ro`-word refusal, the bind_name_pattern twin (wave P3).
    match pattern_mode_word(f) {
        Some(k) => {
            if k == TokenKind.KwRo {
                @reject_first_leaf_of(ak, RO_WORD_PATTERN_MSG)
                return false
            } else { // `mut`/`consume` are mapped by the door below.
            }
        }
        None => {}
    }
    ro mode = match pattern_mode_word(f) {
        Some(k) => if k == TokenKind.KwMut { ParamMode.ModeMut } else { ParamMode.ModeConsume }
        None => dmode
    }
    @record(patfield_name_node(f), ft)
    @scope.bind(patfield_name(f), ft, mode)
    true
}

/// An ARRAY pattern (D59): the scrutinee must be a slice, elements bind
/// against the element type, and the `..rest` binder -- a subpattern written
/// ADJACENT to its DotDot, with no comma between -- binds the remainder as a
/// slice of the same type. One `..` at most; the length question (exact, or
/// at-least with a rest) is the emitter's, asked of the same tree.
fn Checker mut @bind_array_pattern(pat Node, ty TyId, ak []Node, dmode ParamMode, pos PatPos) -> bool {
    // The HEAD DECLARATION's name, not the source spelling: `ty_source_name`
    // of an application answers "Vec[int]", which is why the first version of
    // this test refused every real slice.
    ro is_slice = is_ty(ty) && @ctx.tys.kind_of(ty) == TypeKind.TkApp &&
                  decl_of_ty(@ctx, ty).name == SLICE_HEAD
    if !is_slice {
        @report_first_leaf_of(ak, ARRAY_PATTERN_MSG)
        return false
    }
    ro elem_t = @ctx.tys.arg(ty, 0)
    mut rests = 0
    mut prev_dotdot = false
    mut ok = true
    for c in branch_children(pat) {
        match c {
            Leaf(t) => {
                if t.kind != TokenKind.DotDot {
                    // Only the rest marker opens a rest position.
                } else { rests += 1; prev_dotdot = true }
                if t.kind != TokenKind.Comma {
                    // Without a comma the next element still follows its `..`.
                } else { prev_dotdot = false }
            }
            Branch { .. } => {
                if c.kind_of() == NodeKind.Pattern {
                    if prev_dotdot {
                        // A `..rest` BINDER needs the shell's slice call
                        // wired (`Vec @index(Range)`), which the subset has
                        // not grown -- refused BY NAME until it has (the
                        // LITERAL_ARM_MSG precedent). The length test and
                        // the prefix/suffix elements are compiled today.
                        @report_first_leaf_of(ak, ARRAY_REST_BIND_MSG)
                        ok = false
                    } else {
                        if @bind_pattern(c, elem_t, ak, dmode, pos) {
                            // The element bound; the arm stays sound.
                        } else { ok = false }
                    }
                    prev_dotdot = false
                } else { // A non-Pattern branch (a recovery gap) binds nothing.
                }
            }
        }
    }
    if rests > 1 {
        @report_first_leaf_of(ak, ARRAY_REST_TWICE_MSG)
        return false
    }
    ok
}

/// A match arm's Block body, typed for its VALUE when the tail places one --
/// unlike `@type_branch_value` (tail_rules.nv, a tail `if`'s branch, where a
/// value is MANDATORY and a non-expression tail is a named refusal), a value
/// here is OPTIONAL: `@type_match` folds every arm's type unconditionally,
/// whether the match itself stands in a statement or a value position, so a
/// Block arm whose tail is not an expression must NOT be refused here -- it
/// is typed as an ordinary statement, exactly as `@type_block` already does
/// for it, and offers `no_ty()` to the fold, precisely what happened before
/// this door existed (registry #TBD, the block-tail-arm wave).
fn Checker mut @type_arm_block_value(b Node) -> TyId {
    ro kids = branch_children(b)
    ro last = last_branch_of(kids)
    mut i = 0
    mut out_t = no_ty()
    // The arm's expectation belongs to the block's TAIL, which is the arm's
    // value; the statements before it are not (a `ro x = None` there is not
    // the arm's `None`).
    ro tail_expect = @value_expect
    for c in kids {
        match c {
            Leaf(_) => {}
            Branch { .. } => {
                @value_expect = if i == last { tail_expect } else { no_ty() }
                if i == last && is_expr_kind(c.kind_of()) {
                    ro before = @out.len()
                    if !is_ty(@branch_literal_tail(c)) {
                        @type_expr(c)
                    } else {
                        // A bare literal took the arm's written type: the `if` branch's door.
                    }
                    if @out.len() == before {
                        out_t = type_of(c, @ctx, @scope, @chan)
                    } else {
                        // Refused inside: no type, and the refusal already
                        // is the diagnostic -- nothing invented here.
                    }
                } else {
                    @type_stmt(c)
                }
            }
        }
        i += 1
    }
    @value_expect = tail_expect
    out_t
}

/// One arm in VALUE position: bind its pattern, type its guards, type its
/// body, and answer the body's type -- which the fold compares against the
/// first arm's. None means the arm reported a diagnostic and has no type to
/// offer.
fn Checker mut @type_arm(arm Node, scr_t TyId) -> Option[TyId] {
    // An arm's binders live in the arm and nowhere else.
    ro mark = @scope.mark()
    ro ak = branch_children(arm)
    if ak.len() < 1 {
        @report_first_leaf_of(ak, ARM_PATTERN_VALUE_MSG)
        return None
    }
    // The pattern and the guard are not the arm's VALUE: the position's
    // expectation (a tail match's declared return) is the body's alone.
    ro body_expect = @value_expect
    @value_expect = no_ty()
    if !@bind_arm_pattern(ak, scr_t) {
        @value_expect = body_expect
        // SILENT-OK: the pattern door refused the arm by name already.
        return None
    }
    for g in ak {
        if g.kind_of() != NodeKind.Guard { continue }
        ro gk = branch_children(g)
        // A guard is `if expr` -- two children. A shorter one is a parse
        // remnant with nothing to type; the next arm child is next.
        if gk.len() < 2 { continue }
        @type_expr(gk[1])
        @refuse_block_form_in_guard(gk[1])
    }
    @value_expect = body_expect
    ro body = ak[arm_body_at(ak) ?? ice("check: a match arm with no body reached the checker")]
    // A BLOCK BODY IN VALUE POSITION (274.5 wave B9): `0 => { return 1 }` is
    // statements that leave through `return`, so the arm yields NO value to
    // the fold -- typed as a block, answered as None. The statement variant
    // has read a block body since wave B5; this is the same route for the
    // value variant, and the None is what keeps the fold honest instead of
    // inventing a type for an arm that never produces one.
    // A `return` BODY LEAVES THROUGH THE FUNCTION, so the arm yields no
    // value either -- the same answer a block body gets, for the same
    // reason, and written beside it so the pair cannot drift.
    //
    // MEASURED 2026-09-20. The parser learnt `None => return no_ty()` an
    // hour before this line existed, and the form immediately reached the
    // type rules as a kind they had no case for: `check: expression kind
    // without a type rule`. An ice, and mine -- the same shape as the
    // qualified arm earlier tonight, where reading a form opened a path
    // into a place that had never been asked. Teaching the parser a form
    // is half the work; the other half is every judge the form now
    // reaches.
    // `None => continue` leaves the same way (274.7 B10): no value to offer either.
    if body.kind_of() == NodeKind.RetStmt || body.kind_of() == NodeKind.LoopCtl {
        @type_stmt(body)
        @scope.release(mark)
        // SILENT-OK: the statement judged itself, and the arm has no type
        // to offer the fold -- which is what None says. A type invented
        // here would be a value the program never produces.
        return None
    } else {
        // Not a return: the block and expression routes below answer.
    }
    if body.kind_of() == NodeKind.Block {
        if block_terminates(body) {
            @type_block(body)
            @scope.release(mark)
            // SILENT-OK: the block WAS judged just above -- every statement
            // in it recorded its own answers -- and the arm itself yields no
            // value to the fold, which is exactly what None says here.
            // Nothing is skipped: the only thing not recorded is a type this
            // arm never produces (it leaves through `return` on every path).
            return None
        } else {
            // Does not always terminate: the tail may place a value
            // (registry #TBD, the block-tail-arm wave) -- judged below,
            // through the same door a binding initializer's own tail-if
            // branch uses, adapted so a non-value tail is a statement, not
            // a refusal (see @type_arm_block_value's own comment).
        }
        ro bt = @type_arm_block_value(body)
        @scope.release(mark)
        if is_ty(bt) {
            // RECORDED ON THE BLOCK ITSELF, not just answered to the fold:
            // `lower` cannot ask `check` "does this arm place a value" (the
            // architecture table gives `lower` no edge to `check` at all) --
            // it reads the answer already recorded on this node through the
            // shared channel instead, the same door `@lower_arm_body` already
            // reads other bodies' recorded types through.
            @record(body, bt)
            // SILENT-OK: the decision IS the recorded type handed back --
            // this early return only skips the no-value fallthrough below,
            // which the `else` names for its own case.
            return Some(bt)
        } else {
            // SILENT-OK: the tail was not a value form (or was refused
            // inside, which already spoke); every statement in the block
            // was still judged, by @type_arm_block_value itself.
            return None
        }
    }
    // A `match` AS THE ARM'S BODY goes through the MATCH door, not the lattice
    // (2026-09-20). The walk admitted the position and the typing had no route
    // for it, so nothing was recorded and the lowering died asking -- `sem: no
    // type recorded`. Teaching a POSITION is half the work; the other half is
    // every judge the position now reaches, and this is the third time tonight.
    if body.kind_of() == NodeKind.MatchExpr {
        ro mmark = @out.len()
        @type_match(body)
        @scope.release(mark)
        if @out.len() > mmark {
            // Refused inside, by name: the arm has no type to offer.
            return None
        } else {
            // Typed: the nested match's own type is this arm's.
        }
        ro mt = type_of(body, @ctx, @scope, @chan)
        if is_ty(mt) {
            @record(body, mt)
        } else {
            // Untypeable: the fold is told so rather than guessing.
        }
        // SILENT-OK: the type was recorded a line above when there was one,
        // and `None` is not the answer here -- the arm HAS a value, the
        // nested match's. What travels is the type, and the fold reads it.
        return Some(mt)
    } else {
        // Any other expression: the lattice answers below.
    }
    // TERMINATOR above, no `else` (the intersection rule of 274.5 s2g, fourth
    // application): an expression body falls through to the lattice, as it
    // always has.
    // RELATIVE to THIS call, not absolute (registry #1249, the #1242 class
    // grepped elsewhere in `check/`): `Checker.out` accumulates for the whole
    // FILE, not per-arm, so a bare `@out.len() > 0` was true the moment
    // ANYTHING earlier in the file was refused -- every later arm's own,
    // cleanly-typed body then answered `None` too, and the arms-agree fold
    // silently stopped comparing types it never received. Proven both ways:
    // `match n { 0 => 1  _ => "s" }` alone is refused by name
    // ("match arms produce different types"); the same match placed after an
    // unrelated earlier refusal in the same file passed with zero diagnostics
    // about it -- a K-C silent widening, not a crash.
    ro before = @out.len()
    if !is_ty(@branch_literal_tail(body)) {
        @type_expr(body)
    } else {
        // `false => 0` in a `-> u8` match: the literal took the arm's written type.
    }
    // None is "this arm has no type to compare": the walk refused something in
    // the body, so the lattice must not be asked about it (its miss is an ice).
    // Written as a terminator rather than an if-else: the shape guard reads an
    // `else` here as the wildcard of the KIND test above (it is a count test,
    // a different subject) -- and the early exit says the same thing plainly.
    if @out.len() > before {
        @scope.release(mark)
        return None
    }
    ro bt = type_of(body, @ctx, @scope, @chan)
    @scope.release(mark)
    // A poisoned body raises no NEW diagnostic here (the second door,
    // `type_of` on a name/call whose own declaration was already refused
    // elsewhere) but still has no type to compare -- Some(no_ty()) would
    // read as "this arm has a type" to the fold and produce the exact
    // spurious ARMS_DISAGREE_MSG this comment block above warns against,
    // just one level up from the file-wide `@out.len()` class it names.
    if is_ty(bt) { Some(bt) } else { None }
}

/// Two or more sums in scope declare a variant of this name, and the position
/// names no sum (a bare value, a bare call, a binder): the checker refuses
/// rather than pick one (274.7 B6, #964; the oracle's #962 picks the last one
/// read). The spec names no rule for the case -- an open question to the owner
/// with this refusal as the default -- so the text asks for the qualified form.
const AMBIGUOUS_VARIANT_MSG = "this variant name is declared by more than one sum in scope -- qualify it as `Type.Variant` so the sum is named (D406; registry #964)"

/// A match arm's head names a variant of ANOTHER sum than the one matched on:
/// until 2026-09-05 the head was looked up by bare name and the match was then
/// refused as non-exhaustive -- the wrong cause. Refused HERE, at the arm; the
/// exhaustiveness rule then says nothing (one cause, one diagnostic).
const ARRAY_REST_BIND_MSG = "outside the subset: a `..rest` binding in an array pattern needs the shell's slice view wired -- the length test and prefix/suffix elements compile today (E2-b, with the slice view)"
const DISJ_ALT_MSG = "outside the subset: a `|` pattern takes variant alternatives only -- a literal, `_`, binder, parenthesized, array or nested `|` alternative is not compiled yet (E2-b, with the general or-test)"
const VARIANT_PATTERN_MSG = "a pattern with a payload names no variant of the matched sum -- a plain binder pattern takes no payload"
const PAYLOAD_ARITY_MSG = "the pattern's payload count disagrees with the variant's declaration -- match every payload field, or mark the rest with `..` (D59)"
const TUPLE_PATTERN_MSG = "a tuple pattern needs a positional tuple scrutinee -- a named form is destructured by name, with braces (D486)"
const TUPLE_ARITY_MSG = "the tuple pattern's arity disagrees with the scrutinee's type (D123's arity class)"
const RECORD_PATTERN_MSG = "a brace pattern needs a record or named-tuple scrutinee -- a positional tuple is destructured by position, with parens (D486)"
const DESTR_NO_FIELD_PATTERN_MSG = "a brace pattern names a field this type does not declare (D411)"
const ARRAY_PATTERN_MSG = "an array pattern needs a slice scrutinee (`[]T`)"
const ARRAY_REST_TWICE_MSG = "an array pattern takes one `..` at most (D59) -- a second one is ambiguous"
const WRONG_SUM_ARM_MSG = "this arm names a variant of a different sum than the value matched on (registry #964) -- write a variant of the matched sum, or a binder"

/// A match arm missing its pattern or its value -- one refusal, asked at two doors.
const ARM_PATTERN_VALUE_MSG = "outside the subset: a match arm needs a pattern and a value"
