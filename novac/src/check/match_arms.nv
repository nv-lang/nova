// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `check_match` / Go `types2.stmt` for "an arm binds, then its
// body is typed, then the arms must agree"; NOT taken: exhaustiveness by
// witness construction (rustc's usefulness algorithm) — the subset's sums are
// small and the counted-coverage rule answers the same question here.
// Role: layer 4 — everything about a `match`: what an arm binds, what its body
//   is worth, and whether the arms agree on one type.
// Used by: the typing walk of check, at every stage from E2-a on.
// Guarded by: check-novac-match-exhaustive.py (every match over a sum is
// complete), check-novac-no-default-branch.py (no catch-all on a closed set),
// the module tests of check.
//
// WHY A FILE OF ITS OWN. `typing.nv` crossed 1000 lines (decision 12), and the
// answer is a cut along a seam rather than an exception. The seam is real: the
// rest of the file types declarations, statements and expressions, while these
// functions answer ONE question — what an arm is.

module novac.check

import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, bin_op_of, un_op_of, raw_node}
import ../diag.{ice}
import ../builtins.{ENTRY_FN, PRINT_FN, is_bool_literal}
import ../names.{NameTable, NamespaceId}
import ../sem.{decl_of_ty, decl_fn_row, arm_body_at, Ctx, CheckOut, param_name_at, param_type_at}
import ../sem.{disj_head_slots, pattern_has_disj}
// The head of a flat pattern, through the one door (registry 1190).
import ../sem.{pattern_head_slot, ty_source_name}
// The payload of an APPLIED sum, with the application's arguments put in.
import ../sem.{payload_as_seen}
import ../sem.{branch_children, call_callee_text, is_expr_kind, leaf_text, leaf_kind, expr_leaf_name, raw_vrow, no_vrow}
import ../sem.{is_vrow, variant_range_of, variant_in_sum, variants_named}
import ../types.{TyId, no_ty, is_ty}

/// A match in STATEMENT position (274.5 wave B5): the scrutinee is typed and
/// recorded, the binders bound, the guards typed, the bodies walked AS
/// STATEMENTS, and coverage judged -- but no value question is asked: the
/// arms run for effect, and demanding that `{}` agree in type with
/// `{ println(x) }` would refuse legal code the census counts five files of.
/// IS THIS SCRUTINEE AN APPLIED SUM -- and if so, say it ONCE.
///
/// The head of an arm is found through the DECLARATION since 2026-09-20, so
/// `Some` over an `Option[int]` is no longer called a variant of ANOTHER sum
/// -- which was false and sent the reader looking for a mix-up not in their
/// code. What it is instead: a form novac READS and cannot EMIT, because an
/// applied sum comes from the SHELL with the oracle's tag names and value
/// semantics (measured: `_novac_l2->tag` against a value struct, and an
/// undeclared `NOVAC_TAG_..._Option_Some`).
///
/// AT THE MATCH AND NOT AT THE ARM, because the fact is a property of the
/// SCRUTINEE: at the arm it fired once per arm and said one thing twice.
fn Checker mut @report_if_applied_sum(kids []Node, scr_t TyId) -> bool {
    if !is_ty(scr_t) { return false }
    if @ctx.tys.kind_of(scr_t) != TypeKind.TkApp { return false }
    // TkApp alone only says "a generic type is applied" -- true for
    // `Vec[int]` (and `[]int`, its alias) and `HashMap[K, V]` exactly as
    // much as for `Option[T]`. The applied-sum refusal is honest only when
    // the HEAD DECLARATION itself is a sum (registry: match-on-slice was
    // misrouted through this door and refused with an unrelated `Option[int]`
    // message it never named).
    if decl_of_ty(@ctx, scr_t).kind != TypeKind.TkSum { return false }
    // Registry #1233's remaining half: the message used to be a static
    // string with `Option[int]` WRITTEN IN, regardless of which applied
    // sum actually triggered this gate -- honest for the shell's own
    // `Option`, a lie for any other applied sum reaching here. `scr_t` is
    // already resolved and checked above; naming it costs one call to the
    // same door every sibling message in this file already reads through
    // (`ty_source_name`, line 341).
    @report_first_leaf_of(kids, "outside the subset: a `match` on an applied sum (`${ty_source_name(@ctx, scr_t)}`) is read but not compiled yet -- its tags belong to the shell (E2-b2, with generics)")
    true
}

/// A `match` in STATEMENT position: its arms run for effect and none of
/// them yields a value to anyone.
///
/// Its pair is `@type_match`, the value door; they differ in what they do
/// with an arm's type and in nothing else, which is why the applied-sum
/// question is asked identically in both.
fn Checker mut @type_match_stmt(m Node) -> () {
    ro kids = branch_children(m)
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a match needs a scrutinee")
        return
    }
    ro scr = kids[1]
    // RELATIVE to THIS call, not absolute (registry #1242, found by a peer
    // window's instrumented trap): `Checker.out` accumulates for the whole
    // FILE, not per-match, so a bare `@out.len() > 0` is true the moment
    // ANYTHING earlier in the file was refused -- every later match in that
    // same file then returns here silently, typing no arm at all, and a
    // LATER reader asking `type_of()` about an untyped arm body ICEs far
    // from the actual cause. Every sibling gate in `check/` (exprs.nv,
    // typing.nv, binds.nv, calls.nv, casts.nv, destructure.nv, rules.nv,
    // variant_rules.nv) already marks `@out.len()` BEFORE the call it is
    // judging and compares against THAT mark; this door and the one below
    // were the only two that compared against a literal `0`.
    ro before = @out.len()
    @type_expr(scr)
    if @out.len() > before { return }
    ro scr_t = type_of(scr, @ctx, @scope, @chan)
    @record(scr, scr_t)
    // No `else` is owed after a terminator (P31 form 2): what follows IS
    // the plain-sum case, and an empty else here says it twice.
    if @report_if_applied_sum(kids, scr_t) { return }
    ro before_arms = @out.len()
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        @type_arm_stmt(c, scr_t)
    }
    if @out.len() > before_arms { return }
    @report_if_not_exhaustive(kids, scr_t)
}

/// One statement-position arm: the value path minus the value -- binders and
/// guards through the same door (`@type_arm` owns them), the BODY walked as
/// a block or a statement, and the answer deliberately not asked.
fn Checker mut @type_arm_stmt(arm Node, scr_t TyId) -> () {
    ro mark = @scope.mark()
    ro ak = branch_children(arm)
    if ak.len() < 1 {
        @report_first_leaf_of(ak, "outside the subset: a match arm needs a pattern and a value")
        return
    }
    @bind_arm_pattern(ak, scr_t)
    for g in ak {
        if g.kind_of() != NodeKind.Guard { continue }
        ro gk = branch_children(g)
        if gk.len() < 2 { continue }
        @type_expr(gk[1])
    }
    ro body = ak[arm_body_at(ak) ?? ice("check: a statement-position match arm with no body reached the checker")]
    @type_body(body)
    @scope.release(mark)
}

/// A match: the scrutinee's type is the answer the emitter needs (it declares
/// the C temporary with it); the arms bind their binders and are typed after.
fn Checker mut @type_match(m Node) -> () {
    ro kids = branch_children(m)
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a match needs a scrutinee")
        return
    }
    ro scr = kids[1]
    // RELATIVE to THIS call (registry #1242) -- see @type_match_stmt's own
    // comment above for the full story: `Checker.out` is per-FILE, and a
    // bare `> 0` made every match after the file's first refusal silently
    // type no arm at all.
    ro before = @out.len()
    @type_expr(scr)
    if @out.len() > before { return }
    ro scr_t = type_of(scr, @ctx, @scope, @chan)
    @record(scr, scr_t)
    // No `else` is owed after a terminator (P31 form 2): what follows IS
    // the plain-sum case, and an empty else here says it twice.
    if @report_if_applied_sum(kids, scr_t) { return }
    ro before_arms = @out.len()
    mut first_t = None
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        first_t = @fold_arm_type(c, scr_t, first_t, before_arms)
    }
    if @out.len() > before_arms { return }
    @report_if_not_exhaustive(kids, scr_t)
}

/// A match on a sum must cover every variant -- the rule novac did not have
/// AT ALL until 2026-08-17, which made it WIDER than the language in the one
/// direction a subset must never be wide. [INV-GUARD: check-novac-differential]
/// -- the corpus judges the OUTCOME against the oracle on every file, so a
/// subset that accepts what the language refuses reddens there, not here.
///
/// Measured: `match c { Red(x) => x + 1  Green(x) => x + 2 }` on a three-variant
/// sum is refused by the oracle (E_MATCH_NON_EXHAUSTIVE, registry #703) and
/// was accepted by novac with rc=0. The emitted C declares the result
/// temporary UNINITIALISED, walks the arm chain, and returns it: a program the
/// oracle refuses to compile became, through novac, a read of uninitialised
/// automatic storage. Two defects in one -- a divergence from the language and
/// a silent miscompilation (class K-C).
///
/// A wildcard or a plain binder arm covers everything by construction, so the
/// scan stops there; a guard does NOT count as coverage, because a guard can
/// be false (the oracle judges it the same way).
fn Checker mut @report_if_not_exhaustive(kids []Node, scr_t TyId) -> () {
    // The KIND comes from the interner, and the bound with it. Until wave B8
    // this line read `raw_ty(scr_t) >= @ctx.types.len()` -- a bound against the
    // DECLARATION table, which stopped meaning anything the moment a type id
    // became an interner row: interner ids run past the declaration count, so
    // the guard started returning early and this rule stopped judging. That is
    // how a check gets QUIETER without anyone touching it.
    if !is_ty(scr_t) { return }
    if @ctx.tys.kind_of(scr_t) != TypeKind.TkSum { return }
    // The count comes from the arm that HOLDS a variant range: a sum with no
    // variants is a shape check does not judge here, and so is anything whose
    // rows are not variants at all.
    ro vcnt = (variant_range_of(decl_of_ty(@ctx, scr_t)) ?? (no_vrow(), 0)).1
    if vcnt < 1 { return }
    mut covered = 0
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        ro ak = branch_children(c)
        if ak.len() < 1 { continue }
        mut has_guard = false
        for g in ak {
            has_guard = has_guard || g.kind_of() == NodeKind.Guard
        }
        if has_guard { continue }
        ro pat = branch_children(ak[0])
        if pat.len() < 1 { continue }
        // `is_ident` and not `ident_str` HERE: the answer to "not an
        // identifier" is `continue`, and `continue` is not an expression, so
        // the Option form would have to be a manual match -- which the linter
        // reads as drift from `X ?? D` (W_MANUAL_COALESCE), and rightly.
        // THE HEAD, through the one door (registry 1190). Reading slot 0 made
        // a qualified arm look like a non-variant -- which this scan reads as
        // "a binder covering everything" and RETURNS, so a match missing half
        // its variants passed exhaustiveness in silence.
        ro hs = pattern_head_slot(pat)
        if !pat[hs].is_ident() { continue }
        // EVERY alternative head of a disjunction counts too (the
        // pattern-alternatives wave): heads stand right after each pipe.
        // Heads are asked of the MATCHED SUM (wave B6, #964): a head that is
        // no variant of it is a binder (covers everything -- done) or a
        // variant of another sum, which `@bind_arm_pattern(ak, scr_t)` refused
        // already; this rule says nothing on top (one cause, one diagnostic).
        for hi in disj_head_slots(pat) {
            match variant_in_sum(@ctx, scr_t, leaf_text(pat[hi])) {
                None => {}
                Some(_) => { covered += 1 }
            }
        }
        match variant_in_sum(@ctx, scr_t, leaf_text(pat[hs])) {
            None => return
            Some(_) => { covered += 1 }
        }
    }
    if covered >= vcnt { return }
    @reject_first_leaf_of(kids, NOT_EXHAUSTIVE_MSG)
}

/// (rule lives in @type_match now) Every arm of a match must produce the SAME type -- and until 2026-08-17
/// nobody checked, because `type_of` took the FIRST arm's type and the
/// comment beside it said the arms "agree by construction".
///
/// They do not. Probe -- and it must be written MULTI-LINE, because the
/// one-line form (arms separated by `,`, spec syntax.ru.md:115) is legal Nova
/// that this subset does not parse yet:
///
///     ro r = match n {
///         1 => 10
///         _ => 2.5
///     }
///
/// in a `-> f64` fn.
/// The emitted C declared `nova_int _novac_match_r`, then assigned
/// `((nova_f64)2.5)` into it, so the program returned 2 where the oracle
/// returns 2.5 -- valid C, wrong answer, no diagnostic anywhere. That is the
/// worst shape a defect can take (class K-C), and it survived because a
/// comment stood where a check belongs.
///
/// The subset REFUSES disagreement rather than unifying it. Unification here
/// would mean an expected type flowing down into the arms (the oracle has
/// it: the `-> f64` return coerces the integer literal), and that is
/// bidirectional inference -- E2-b3 work, not a patch. Refusing is the safe
/// direction: narrower than the language, never wider.

/// Fold one arm's type into the answer the arms agreed on so far.
///
/// Every arm of a `match` must carry the SAME type, and the first arm that has
/// one sets it. Both "no answer" cases are None and neither is a number: the
/// arm whose body the walk refused has no type to compare, and before the first
/// such arm there is nothing to compare AGAINST — two facts that shared the
/// value -1 until 2026-08-19 and were told apart by their position in the code.
fn Checker mut @fold_arm_type(arm Node, scr_t TyId, first Option[TyId], before_arms int) -> Option[TyId] {
    // No type: the arm reported a diagnostic and has nothing to offer, so the
    // fold carries the first one through.
    if Some(at) = @type_arm(arm, scr_t) { @agree_arm_type(arm, at, first, before_arms) } else { first }
}

/// The same fold once THIS arm has a type: agree with the first one or report.
///
/// `before_arms` (registry #1249, the #1242 class): the RELATIVE mark taken
/// by the caller before the arm-folding loop started, not literal zero. Was
/// `@out.len() == 0` -- true only when NOTHING in the whole FILE had ever
/// been refused, so a match placed anywhere after the file's first refusal
/// silently stopped reporting disagreeing arm types (K-C: the oracle refuses
/// `match n { 0 => 1  _ => "s" }`, novac accepted it once an earlier,
/// unrelated declaration had already been refused).
fn Checker mut @agree_arm_type(arm Node, at TyId, first Option[TyId], before_arms int) -> Option[TyId] {
    match first {
        // The first arm with a type sets what the rest must match.
        None => Some(at)
        Some(f) => {
            if at != f && @out.len() == before_arms {
                @report_first_leaf_of([]Node.of(arm), ARMS_DISAGREE_MSG)
            } else {
                // The arm agrees, or a diagnostic already stands: the answer
                // is the first arm's type either way.
            }
            first
        }
    }
}

/// One arm: binders first (payload fields of a variant pattern, or the whole
/// scrutinee under a plain binder), then the guard and the arm's value --
/// the emitter's order exactly.
/// Returns the arm BODY's type, and the return value is the whole point:
/// the binders of a pattern live only until `release(mark)` below, so the
/// body's type can be computed HERE and nowhere later. The first version of
/// the arm-agreement rule (F36) asked for it after the walk, outside the
/// scope, and turned a clean `match s { A(r) => r  B(w, h) => w * h }` into a
/// diagnostic -- the binders were gone by then.
/// Bind one arm's PATTERN into the scope: the variant's payload binders, or
/// the whole scrutinee under a plain binder. ONE door for both arm variants
/// (value and statement, 274.5 wave B5) -- the second copy of this walk is
/// exactly what would drift. Answers false when the pattern is refused.
fn Checker mut @bind_arm_pattern(ak []Node, scr_t TyId) -> bool {
    ro pat = branch_children(ak[0])
    if pat.len() < 1 {
        @report_first_leaf_of(ak, "outside the subset: a match arm needs a pattern")
        return false
    }
    // THE HEAD, through the one door (registry 1190): a qualified arm keeps
    // its variant in slot 2, and reading slot 0 found the TYPE name -- which
    // is a variant of nothing, so the arm became a catch-all binder.
    ro hslot = pattern_head_slot(pat)
    ro p0 = pat[hslot]
    // A STRING OR CHAR LITERAL PATTERN is refused BY NAME until the lowering
    // can compare one (registry 1190). Until 2026-09-20 08:11 it passed here
    // and died in the emitter with `emit_c: match pattern is neither an int
    // literal nor an identifier` -- an ice on a program whose only fault was
    // being ahead of the emitter. A refusal names the form; an ice names the
    // compiler and tells the reader nothing about their code.
    ro lk0 = leaf_kind(p0)
    if lk0 == TokenKind.StrLit || lk0 == TokenKind.CharLit {
        @report_first_leaf_of(ak, LITERAL_ARM_MSG)
        return false
    } else if lk0 == TokenKind.IntLit {
        // THE MAGNITUDE DOOR, ASKED HERE TOO (registry #1251) -- and
        // deliberately NOT the row door (`@lit_fits_or_refuse`, #1249's
        // sibling for out-of-range values): the oracle itself does not apply
        // D227 rule 3 at a pattern's position (`match x { 300 => .. }` on
        // `x u8` compiles clean on BOTH compilers today, an always-false
        // comparison the oracle tolerates -- the neighbour the hunt measured
        // and did not file, because there the oracle agrees with novac).
        // What the oracle DOES refuse is a literal too wide for ANY row at
        // all -- 23 decimal digits, `E_LIT` at the oracle's own check -- and
        // that is exactly `int_text_fits`'s question (#1250: bounded by
        // `u64`, the widest row), asked everywhere else from the generic
        // `Lit` walk. A `Pattern` node is never a `Lit` node, so that walk
        // never visits it; `check` stayed clean and the EMITTER wrote the
        // 23-digit text verbatim into a C comparison, which clang then
        // refused outright -- the exact failure #810 exists to prevent,
        // reopened at one position nobody had visited yet.
        if !int_text_fits(leaf_text(p0)) {
            @report_first_leaf_of(ak, INT_TOO_LARGE_MSG)
            return false
        } else {
            // Within the widest row's bound: this position asks no more.
        }
    } else {
        // An identifier head or punctuation: judged below.
    }
    ro is_ident = leaf_kind(p0) == TokenKind.Ident
    // A QUALIFIER NAMING ANOTHER TYPE, asked here and answered by the SAME
    // door as the bare case below -- they are one rule ('this arm belongs to
    // another sum') and two spellings of it. Two `@report` sites would be two
    // places one text can leave from, which is what the debt measure counts
    // and, more to the point, what drifts.
    //
    // THE TYPE IS ASKED ONLY WHEN THERE IS ONE: `ty_source_name` reads the
    // interner by id, and a poisoned scrutinee is `TyId(-1)` -- asking it for
    // a name walked off the end and the checker died with "index 211 out of
    // bounds for length 211" on a program whose only fault was a qualified
    // arm. Measured within a minute of writing the line, which is the whole
    // argument for probing a fix instead of reading it.
    ro wrong_qualifier = hslot > 0 && is_ty(scr_t) &&
                         leaf_text(pat[0]) != ty_source_name(@ctx, scr_t)
    // ONE question about the pattern head, asked once: which variant row does
    // it name? -1 answers "none" for every other shape (a plain binder, `_`,
    // a punctuation leaf), and both branches below read that one answer.
    // Asked of the MATCHED SUM (wave B6, #964). A head that names a variant of
    // ANOTHER sum is refused here, at the arm -- until 2026-09-05 it fell
    // through as a binder and the match was refused as non-exhaustive instead.
    ro vrow = if is_ident { variant_in_sum(@ctx, scr_t, leaf_text(p0)) ?? no_vrow() } else { no_vrow() }
    if wrong_qualifier ||
       (is_ident && !is_vrow(vrow) && variants_named(@ctx, leaf_text(p0)).1 > 0) {
        @report_first_leaf_of(ak, WRONG_SUM_ARM_MSG)
        return false
    } else {
        // A variant of this sum, or a plain binder: both bind below.
    }
    if pattern_has_disj(pat) {
        // A disjunction binds NOTHING: two alternatives would have to agree
        // on the binder's name AND payload type, and no carrier needs that.
        // Any identifier of the pattern that is neither `_` nor a variant
        // head refuses by name; `_` slots leave nothing to put in scope.
        for c in pat {
            match c.ident_str() {
                Some(nm) => {
                    if nm == "_" { continue }
                    ro is_var = is_vrow(variant_in_sum(@ctx, scr_t, nm) ?? no_vrow())
                    if !is_var {
                        @report_first_leaf_of(ak, DISJ_BINDER_MSG)
                        return false
                    }
                }
                None => {}
            }
        }
        return true
    }
    if is_vrow(vrow) {
        mut pi = 0
        // `for` over the RANGE, not a hand-advanced cursor (owner 2026-08-22):
        // the walk advances by exactly one every time, so the counter carried no
        // information -- and a hand-advanced cursor makes "forgot to advance" a
        // possible bug, which the range form deletes rather than documents.
        // FROM THE HEAD, not from slot two (registry 1190). A payload binder
        // sits after the head and its `(`, which is slot 2 for a bare head and
        // slot 4 for a qualified one. Counting from a constant made `Kind.B`
        // hand its own variant name to the payload table as a binder, and a
        // variant with no payload indexed one past its end: the checker died
        // with "index 211 out of bounds for length 211" on three correct lines.
        for j in hslot + 2..pat.len() {
            ro pj = pat[j]
            // ONE question -- is this child a binder leaf? Two nested ifs
            // asked it in two steps and neither named its second branch.
            // Punctuation leaves of the pattern name no binder; a guard says
            // it without branching on a variant test (no-default-branch keeps
            // that shape for `match`).
            // The test and the TEXT are one question, so one door answers
            // both: `ident_str` gives the name or None, and None is exactly
            // the pattern's parentheses and commas -- leaves that bind
            // nothing, so the payload cursor must not move.
            match pj.ident_str() {
                Some(binder) => {
                    // A payload binder holds a value of the arm, read-only:
                    // nothing in the subset writes through it.
                    // AS THE SCRUTINEE SEES IT: for `Option[int]` the payload
                    // `T` is `int`, and binding the parameter instead made the
                    // arms disagree and the mangler assert.
                    ro praw = @ctx.payload_types[@ctx.variant_rows[raw_vrow(vrow)].payload_off + pi]
                    @scope.bind(binder, payload_as_seen(@ctx, scr_t, praw), ParamMode.ModeRo)
                    pi += 1
                }
                None => {}
            }
        }
    } else if is_ident && leaf_text(p0) != "_" {
        // The scrutinee under a new name: the arm reads it, so `ro`.
        @scope.bind(leaf_text(p0), scr_t, ParamMode.ModeRo)
    } else {
        // `_` and a non-identifier head bind nothing by definition: an arm
        // sees the scrutinee only through a name, and there is no name here.
    }
    true
}

/// A match arm's Block body, typed for its VALUE when the tail places one --
/// unlike `@type_branch_value` (tail_rules.nv, a tail `if`'s branch, where a
/// value is MANDATORY and a non-expression tail is a named refusal), a value
/// here is OPTIONAL: `@type_match` folds every arm's type unconditionally,
/// whether the match itself stands in a statement or a value position, so a
/// Block arm whose tail is not an expression must NOT be refused here -- it
/// is typed as an ordinary statement, exactly as `@type_block` already does
/// for it, and offers `no_ty()` to the fold, precisely what happened before
/// this door existed (registry #TBD, the block-tail-arm wave).
fn Checker mut @type_arm_block_value(b Node) -> TyId {
    ro kids = branch_children(b)
    ro last = last_branch_of(kids)
    mut i = 0
    mut out_t = no_ty()
    for c in kids {
        match c {
            Leaf(_) => {}
            Branch { .. } => {
                if i == last && is_expr_kind(c.kind_of()) {
                    ro before = @out.len()
                    @type_expr(c)
                    if @out.len() == before {
                        out_t = type_of(c, @ctx, @scope, @chan)
                    } else {
                        // Refused inside: no type, and the refusal already
                        // is the diagnostic -- nothing invented here.
                    }
                } else {
                    @type_stmt(c)
                }
            }
        }
        i += 1
    }
    out_t
}

/// One arm in VALUE position: bind its pattern, type its guards, type its
/// body, and answer the body's type -- which the fold compares against the
/// first arm's. None means the arm reported a diagnostic and has no type to
/// offer.
fn Checker mut @type_arm(arm Node, scr_t TyId) -> Option[TyId] {
    // An arm's binders live in the arm and nowhere else.
    ro mark = @scope.mark()
    ro ak = branch_children(arm)
    if ak.len() < 1 {
        @report_first_leaf_of(ak, "outside the subset: a match arm needs a pattern and a value")
        return None
    }
    if !@bind_arm_pattern(ak, scr_t) { return None }
    for g in ak {
        if g.kind_of() != NodeKind.Guard { continue }
        ro gk = branch_children(g)
        // A guard is `if expr` -- two children. A shorter one is a parse
        // remnant with nothing to type; the next arm child is next.
        if gk.len() < 2 { continue }
        @type_expr(gk[1])
    }
    ro body = ak[arm_body_at(ak) ?? ice("check: a match arm with no body reached the checker")]
    // A BLOCK BODY IN VALUE POSITION (274.5 wave B9): `0 => { return 1 }` is
    // statements that leave through `return`, so the arm yields NO value to
    // the fold -- typed as a block, answered as None. The statement variant
    // has read a block body since wave B5; this is the same route for the
    // value variant, and the None is what keeps the fold honest instead of
    // inventing a type for an arm that never produces one.
    // A `return` BODY LEAVES THROUGH THE FUNCTION, so the arm yields no
    // value either -- the same answer a block body gets, for the same
    // reason, and written beside it so the pair cannot drift.
    //
    // MEASURED 2026-09-20. The parser learnt `None => return no_ty()` an
    // hour before this line existed, and the form immediately reached the
    // type rules as a kind they had no case for: `check: expression kind
    // without a type rule`. An ice, and mine -- the same shape as the
    // qualified arm earlier tonight, where reading a form opened a path
    // into a place that had never been asked. Teaching the parser a form
    // is half the work; the other half is every judge the form now
    // reaches.
    // `None => continue` leaves the same way (274.7 B10): no value to offer either.
    if body.kind_of() == NodeKind.RetStmt || body.kind_of() == NodeKind.LoopCtl {
        @type_stmt(body)
        @scope.release(mark)
        // SILENT-OK: the statement judged itself, and the arm has no type
        // to offer the fold -- which is what None says. A type invented
        // here would be a value the program never produces.
        return None
    } else {
        // Not a return: the block and expression routes below answer.
    }
    if body.kind_of() == NodeKind.Block {
        if block_terminates(body) {
            @type_block(body)
            @scope.release(mark)
            // SILENT-OK: the block WAS judged just above -- every statement
            // in it recorded its own answers -- and the arm itself yields no
            // value to the fold, which is exactly what None says here.
            // Nothing is skipped: the only thing not recorded is a type this
            // arm never produces (it leaves through `return` on every path).
            return None
        } else {
            // Does not always terminate: the tail may place a value
            // (registry #TBD, the block-tail-arm wave) -- judged below,
            // through the same door a binding initializer's own tail-if
            // branch uses, adapted so a non-value tail is a statement, not
            // a refusal (see @type_arm_block_value's own comment).
        }
        ro bt = @type_arm_block_value(body)
        @scope.release(mark)
        if is_ty(bt) {
            // RECORDED ON THE BLOCK ITSELF, not just answered to the fold:
            // `lower` cannot ask `check` "does this arm place a value" (the
            // architecture table gives `lower` no edge to `check` at all) --
            // it reads the answer already recorded on this node through the
            // shared channel instead, the same door `@lower_arm_body` already
            // reads other bodies' recorded types through.
            @record(body, bt)
            // SILENT-OK: the decision IS the recorded type handed back --
            // this early return only skips the no-value fallthrough below,
            // which the `else` names for its own case.
            return Some(bt)
        } else {
            // SILENT-OK: the tail was not a value form (or was refused
            // inside, which already spoke); every statement in the block
            // was still judged, by @type_arm_block_value itself.
            return None
        }
    }
    // A `match` AS THE ARM'S BODY goes through the MATCH door, not the lattice
    // (2026-09-20). The walk admitted the position and the typing had no route
    // for it, so nothing was recorded and the lowering died asking -- `sem: no
    // type recorded`. Teaching a POSITION is half the work; the other half is
    // every judge the position now reaches, and this is the third time tonight.
    if body.kind_of() == NodeKind.MatchExpr {
        ro mmark = @out.len()
        @type_match(body)
        @scope.release(mark)
        if @out.len() > mmark {
            // Refused inside, by name: the arm has no type to offer.
            return None
        } else {
            // Typed: the nested match's own type is this arm's.
        }
        ro mt = type_of(body, @ctx, @scope, @chan)
        if is_ty(mt) {
            @record(body, mt)
        } else {
            // Untypeable: the fold is told so rather than guessing.
        }
        // SILENT-OK: the type was recorded a line above when there was one,
        // and `None` is not the answer here -- the arm HAS a value, the
        // nested match's. What travels is the type, and the fold reads it.
        return Some(mt)
    } else {
        // Any other expression: the lattice answers below.
    }
    // TERMINATOR above, no `else` (the intersection rule of 274.5 s2g, fourth
    // application): an expression body falls through to the lattice, as it
    // always has.
    // RELATIVE to THIS call, not absolute (registry #1249, the #1242 class
    // grepped elsewhere in `check/`): `Checker.out` accumulates for the whole
    // FILE, not per-arm, so a bare `@out.len() > 0` was true the moment
    // ANYTHING earlier in the file was refused -- every later arm's own,
    // cleanly-typed body then answered `None` too, and the arms-agree fold
    // silently stopped comparing types it never received. Proven both ways:
    // `match n { 0 => 1  _ => "s" }` alone is refused by name
    // ("match arms produce different types"); the same match placed after an
    // unrelated earlier refusal in the same file passed with zero diagnostics
    // about it -- a K-C silent widening, not a crash.
    ro before = @out.len()
    @type_expr(body)
    // None is "this arm has no type to compare": the walk refused something in
    // the body, so the lattice must not be asked about it (its miss is an ice).
    // Written as a terminator rather than an if-else: the shape guard reads an
    // `else` here as the wildcard of the KIND test above (it is a count test,
    // a different subject) -- and the early exit says the same thing plainly.
    if @out.len() > before {
        @scope.release(mark)
        return None
    }
    ro bt = type_of(body, @ctx, @scope, @chan)
    @scope.release(mark)
    // A poisoned body raises no NEW diagnostic here (the second door,
    // `type_of` on a name/call whose own declaration was already refused
    // elsewhere) but still has no type to compare -- Some(no_ty()) would
    // read as "this arm has a type" to the fold and produce the exact
    // spurious ARMS_DISAGREE_MSG this comment block above warns against,
    // just one level up from the file-wide `@out.len()` class it names.
    if is_ty(bt) { Some(bt) } else { None }
}

/// Two or more sums in scope declare a variant of this name, and the position
/// names no sum (a bare value, a bare call, a binder): the checker refuses
/// rather than pick one (274.7 B6, #964; the oracle's #962 picks the last one
/// read). The spec names no rule for the case -- an open question to the owner
/// with this refusal as the default -- so the text asks for the qualified form.
const AMBIGUOUS_VARIANT_MSG = "this variant name is declared by more than one sum in scope -- qualify it as `Type.Variant` so the sum is named (D406; registry #964)"

/// A match arm's head names a variant of ANOTHER sum than the one matched on:
/// until 2026-09-05 the head was looked up by bare name and the match was then
/// refused as non-exhaustive -- the wrong cause. Refused HERE, at the arm; the
/// exhaustiveness rule then says nothing (one cause, one diagnostic).
const WRONG_SUM_ARM_MSG = "this arm names a variant of a different sum than the value matched on (registry #964) -- write a variant of the matched sum, or a binder"
