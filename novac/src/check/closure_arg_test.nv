// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check/closure_arg_test.nv -- the E.11 wave's LATCH (274.11,
// captured 2026-11-18): what the closure-argument door admits, what it
// refuses by name, and where the next wave starts.
//
// The wave opened ONE position -- D22 context 1, the fn-typed call parameter
// -- and the three probes of the wave's step 1b moved from the position bar
// to three DIFFERENT doors: a fn-typed parameter in a DECLARATION, the
// shell's missing Result instance, and the expression form of `spawn`.
// Door A (2026-11-20, plan 274.11, D43/D22) OPENED the declaration door:
// its front pin converts to a CLEAN check, and the local-call door's own
// refusals are pinned below. The Result instance and `spawn` remain the
// next doors. These tests pin the achieved front so a later change cannot
// roll it back silently, and pin each next door by the text that now
// answers first, so the next wave starts from a measured place.
//
// Donor: none -- the door is D22's own rule; the test shape is check_test.nv's.
// Guarded by: check-novac-module-tests.sh.
module novac.check

import ../source.{SourceText}
import ../lex.{lex}
import ../parse.{parse}
import ../sem.{collect, InteropTable, branch_children}
import ../tree.{Node}

/// The FIRST diagnostic's message for `text`, or "" when the text is clean.
fn cam_first_msg(text str) -> str {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro (diags, _) = check(tree, src, collect(tree, []Node.new(), InteropTable.new()))
    if diags.len() == 0 { return "" }
    diags[0].message
}

/// ALL diagnostic messages for `text` against declarations HANDED in `handed`,
/// joined by newlines (a bodyless signature is harvested as a method row). The
/// join lets a control find the core's arity refusal even when the declaration
/// door speaks first -- the argument door's reach is proven by the core message
/// appearing ANYWHERE, not only at diags[0].
fn cam_msgs_handed(text str, handed str) -> str {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro htree = parse(lex(handed))
    mut decls = []Node.new()
    for c in branch_children(htree) {
        match c {
            Branch { .. } => { decls.push(c) }
            Leaf(_) => {}
        }
    }
    ro (diags, _) = check(tree, src, collect(tree, decls, InteropTable.new()))
    mut acc = ""
    for d in diags {
        acc = "${acc}${d.message}\n"
    }
    acc
}

test "closure-arg: a literal outside every door keeps the position bar" {
    ro src = "module m\n\nfn g() -> int {\n    ro h = |x| x\n    1\n}\n"
    ro m = cam_first_msg(src)
    assert(m.contains("is compiled only where its signature is given by the context"), m)
}

test "closure-arg: a non-fn parameter refuses by name, not by position" {
    ro src = "module m\n\nfn f(n int) -> int => n\n\nfn g() -> int => f(|x| x)\n"
    ro m = cam_first_msg(src)
    assert(m.contains("takes its signature from the call's parameter"), m)
    assert(m.contains("is not a function type"), m)
}

test "closure-arg: a fn-typed parameter binds and the body calls through it (door A, D43/D22)" {
    // The declaration door's front pin CONVERTED: before door A this very
    // text was refused ("a parameter of function type", measured RED on the
    // base seed 2026-11-20). Now the parameter binds, the literal takes its
    // signature from door B, and `f(v)` calls through the value -- clean.
    ro src = "module m\n\nfn apply(f fn(int) -> int, v int) -> int => f(v)\n\nfn g() -> int => apply(|x| x * 2, 5)\n"
    ro m = cam_first_msg(src)
    assert(m == "", m)
}

test "closure-arg: `spawn(|| ...)` moves past the position bar to the spawn-expression door" {
    ro src = "module m\n\nfn g() -> () {\n    spawn(|| println(1))\n}\n"
    ro m = cam_first_msg(src)
    assert(m.contains("`spawn` is not a callable novac knows in an expression"), m)
    assert(!m.contains("|params|"), m)
}

test "closure-arg: a fn-typed call parameter gives the literal its signature (E.11 door B, reg 2010)" {
    // A bodyless method on the builtin int is HANDED and harvested as a method
    // row: @twice(f fn(int) -> int). The receiver 5 fixes the parameter type,
    // the literal |x| x * 2 carries fn(int) -> int. Before door B the argument
    // expectation returned no_ty for the composite fn parameter (is_concrete
    // false) and the literal was refused by name: "takes its signature from the
    // call's parameter ... is not a function type". Door B (@type_closure_arg)
    // substitutes the receiver bindings into the parameter, types the body and
    // records the concrete signature -- the refusal is left behind.
    //
    // The GENERIC inference (U read back from the body, F=R bound before the
    // total substitution types.nv:501) is the same door's TkParam-result arm;
    // it is pinned on the corpus by the optmap fixture (std Option.map, binary
    // port1 CLOSURE_ARG_NEEDS_FN_MSG -> port4 declaration door), because a
    // freshly-handed GENERIC declaration meets the E2-b2 generic-decl bar in
    // this harness before the argument door -- a separate subset front.
    ro handed = "module hand\n\nfn int @twice(f fn(int) -> int) -> int\n"
    ro src = "module m\n\nfn g() -> () {\n    ro r = 5.twice(|x| x * 2)\n    println(r)\n}\n"
    ro m = cam_msgs_handed(src, handed)
    assert(!m.contains("takes its signature from the call's parameter"), m)
    assert(!m.contains("is compiled only where its signature is given by the context"), m)
    // NON-VACUITY CONTROL: a wrong-arity literal at the SAME fn parameter must
    // reach the core's arity door ("takes 1 parameter(s) here ... writes 2").
    // That message is spoken ONLY by @type_closure_core, which door B calls
    // after admitting the literal -- so its presence proves the argument door
    // actually typed this closure, not that the probe died earlier unresolved.
    ro bad = "module m\n\nfn g() -> () {\n    ro r = 5.twice(|x, y| x)\n    println(r)\n}\n"
    ro mb = cam_msgs_handed(bad, handed)
    assert(mb.contains("parameter(s) here"), mb)
}


test "local-call: a non-fn local is a language error, the binding itself is clean" {
    ro src = "module m\n\nfn g() -> () {\n    ro x = 5\n    println(x(1))\n}\n"
    ro m = cam_first_msg(src)
    assert(m.contains("is bound to a non-function type"), m)
    // NON-VACUITY CONTROL: the same binding WITHOUT the call is clean -- the
    // refusal is the call door's, not the binding's.
    ro ok = "module m\n\nfn g() -> () {\n    ro x = 5\n    println(x)\n}\n"
    assert(cam_first_msg(ok) == "", cam_first_msg(ok))
}

test "local-call: arity is the value's signature, counted positionally" {
    ro src = "module m\n\nfn apply(f fn(int) -> int, x int) -> int => f(x, x)\n\nfn g() -> int => apply(|x| x, 1)\n"
    ro m = cam_first_msg(src)
    assert(m.contains("writes 2 argument(s)"), m)
    assert(m.contains("signature takes 1"), m)
}

test "local-call: a named argument has no parameter name to bind (E4)" {
    ro src = "module m\n\nfn apply(f fn(int) -> int, x int) -> int => f(x: x)\n\nfn g() -> int => apply(|x| x, 1)\n"
    ro m = cam_first_msg(src)
    assert(m.contains("a named argument to a local function value"), m)
    assert(m.contains("(E4)"), m)
}

test "local-call: type arguments on a bound signature are a language error" {
    ro src = "module m\n\nfn apply(f fn(int) -> int, x int) -> int => f[int](x)\n\nfn g() -> int => apply(|x| x, 1)\n"
    ro m = cam_first_msg(src)
    assert(m.contains("type arguments on a local function value"), m)
}

test "local-call: a fn-typed parameter SHADOWS a declared namesake (the scope outranks the registry)" {
    // The declared `f` takes TWO ints; the local `f` is fn(int) -> int. A
    // one-argument call `f(v)` is clean ONLY if the local outranks the
    // registry -- the registry row would refuse the arity. That is the
    // discriminating control: the same call against the declaration alone
    // (no local) must refuse.
    ro src = "module m\n\nfn f(a int, b int) -> int => a + b\n\nfn g(f fn(int) -> int, v int) -> int => f(v)\n"
    ro m = cam_first_msg(src)
    assert(m == "", m)
    ro bare = "module m\n\nfn f(a int, b int) -> int => a + b\n\nfn g(v int) -> int => f(v)\n"
    ro mb = cam_first_msg(bare)
    assert(mb != "", mb)
}

test "local-call: a fn-typed parameter shadows a VARIANT of the same name (reg 2014)" {
    // The constructor used to win: the local step stood AFTER the variant
    // dispatch, and the call was refused by the constructor's return type
    // (measured on the door-A pin, 2026-11-21). Scope is what the body reads.
    ro src = "module m\n\ntype Choice enum\n    | Pick(int)\n\nfn call_pick(Pick fn(int) -> int, x int) -> int => Pick(x)\n\nfn g() -> int => call_pick(|x| x + 2, 5)\n"
    ro m = cam_first_msg(src)
    assert(m == "", m)
    // CONTROL: without the fn-typed parameter the same call is the ordinary
    // constructor in an int position -- the constructor door still refuses.
    ro bare = "module m\n\ntype Choice enum\n    | Pick(int)\n\nfn call_pick(x int) -> int => Pick(x)\n"
    ro mb = cam_first_msg(bare)
    assert(mb.contains("cannot return value of type"), mb)
}

test "local-call: a captured fn value is callable through the capture (reg 2013)" {
    // A fn-typed parameter captured into a literal and called there is a
    // clean CHECK. The emit side of this class (a raw reader iced at
    // lower/ir.nv:748) is carried by pos_3's smoke, not by this pin: the
    // check door never refused the captured call, the EMITTER misprinted it.
    ro src = "module m\n\nfn apply(f fn(int) -> int, x int) -> int => f(x)\n\nfn nested(f fn(int) -> int) -> int => apply(|x| f(x), 5)\n\nfn g() -> int => nested(|x| x * 2)\n"
    ro m = cam_first_msg(src)
    assert(m == "", m)
}