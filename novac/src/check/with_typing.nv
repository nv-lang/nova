// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: none -- the language's own statement forms (D61 `with`, D439
// `supervised`/`spawn`), typed by the doors this module already has.
// Role: layer 7 (check) -- the E4 wave's STATEMENT doors (274.11 Э.7/Э.8): a
// `with` binding is resolved and its handler value judged, its body typed as
// a block; `supervised { spawn { ... } }` bodies are typed as ordinary blocks.
// Used by: typing.nv (`@type_stmt` dispatches the two statement kinds here).
// Guarded by: check-novac-file-size.py (this file exists because typing.nv
// crossed 1000 lines at the nova-kim acceptance -- the cut is the wave's block,
// by meaning, the precedent of return_rules.nv), pipeline/with_test.nv and
// pipeline/concurrency_test.nv.
// novac/src/check/with_typing.nv -- the E4 statements: `with` and `supervised`/`spawn`.

module novac.check

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}
import ../builtins.{TypeKind, TIMEOUT_ERROR_TYPE}
import ../names.{raw_decl}
import ../sem.{branch_children, leaf_text}
import ../sem.{leaf_kind}
import ../sem.{is_unit_ty, is_value_tail_kind}
import ../sem.{ty_source_name, decl_of_ty}
import ../types.{TyId, is_ty, no_ty}

/// Type a `with` statement (E4 wave, 274.11): the effect bindings resolve, the
/// handler value is judged against the effect, and the body is a block.
fn Checker mut @type_with_stmt(st Node) -> () {
    ro kids = branch_children(st)
    // Geometry from the parser: `with`, name, `=`, handler expr, then
    // (`,`, name, `=`, handler expr)*, then the body Block. A malformed
    // binding piece is an Err leaf the subset walk already reports, and
    // the refusal is the decision (P17) -- the same discipline as the
    // if/while arms above.
    if kids.len() < 5 {
        assert(@out.len() > 0, "check: a malformed with reached typing with no refusal")
        return
    }
    // Bindings: name at bi, `=` at bi+1, handler expr at bi+2, optional
    // `,` at bi+3. The body is the LAST child; a missing body is an
    // error node the walk reported, and typing leaves it alone.
    mut bi = 1
    while bi + 2 < kids.len() {
        ro nm = kids[bi]
        if nm.kind_of() != NodeKind.LeafNode || leaf_kind(nm) != TokenKind.Ident {
            // A planted Err (missing name): the walk already spoke.
            break
        }
        ro name = leaf_text(nm)
        match @ctx.defs.type_decl(name) {
            None => {
                match nm {
                    Leaf(t) => @refuse(t, "unknown name: nothing with this name is bound at this point (E4, wave 274.11)")
                    Branch { .. } => {}
                }
            }
            Some(d) => {
                // The binding names a type that is not an effect: a
                // `with` binding installs a HANDLER, and the name must
                // be an effect declaration. Refused at the name leaf,
                // naming what the name actually is -- the same
                // word-the-cause rule as the other binding doors.
                ro dk = @ctx.types[raw_decl(d)].kind
                if dk != TypeKind.TkEffect {
                    ro what = if dk == TypeKind.TkSum {
                        "a sum"
                    } else if dk == TypeKind.TkNewtype {
                        "a newtype"
                    } else {
                        "a record"
                    }
                    match nm {
                        Leaf(t) => @refuse(t, "a `with` binding names an effect, and `${name}` is ${what}, not one (E4, wave 274.11)")
                        Branch { .. } => {}
                    }
                } else {
                    // A TkEffect kind: the name is a valid handler
                    // target, and the handler expression is typed below
                    // regardless of which arm of this match ran.
                }
            }
        }
        // The handler value is typed either way: its own refusals are
        // the answer about the value. When typing refused nothing, a
        // KNOWN non-handler type is refused here -- `with Fs = 42`
        // diverges from the oracle if it passes. Unknown and
        // application types (the `Effect[Fs]` a `real_fs()`-style
        // value carries, resolved since the Effect seed -- the named
        // debt that remains is the 2-argument D87/D88 form) are
        // accepted: the handler-type machinery is deferred by E.5 of
        // the plan.
        //
        // THE HANDLER IS LINK-CHECKED LIKE ANY CALL (E.9 step 1, 274.11).
        // Until 2026-09-30 the W6 shell-symbol refusal was switched off
        // for this one expression, on the premise that no probe could put
        // `nova_fn_3std2fs7real_fs` into the shell. The premise was false:
        // the probe lacked only the import, and with it the shell carries
        // the factories, NovaVtable_Fs/_Os and their registration. So a
        // factory the shell does not carry is refused here by W6's own
        // text, as in every other position (pipeline/with_test.nv).
        ro hmark = @out.len()
        @type_expr(kids[bi + 2])
        if @out.len() == hmark {
            ro hty = @tail_type_of(kids[bi + 2])
            if is_ty(hty) {
                ro hk = @ctx.tys.kind_of(hty)
                // A VALUE-TYPE kind is refused. The condition names the kinds
                // that MAY carry a handler instead, so a kind added later is
                // refused -- loud -- until someone judges it, rather than
                // accepted in silence by a list that forgot it.
                if hk != TypeKind.TkApp && hk != TypeKind.TkParam && hk != TypeKind.TkInfer &&
                    hk != TypeKind.TkEffect {
                    @report_first_leaf_of(branch_children(kids[bi + 2]), "a `with` binding takes a handler for its effect, and `${ty_source_name(@ctx, hty)}` is a value type -- pass a handler (E4, wave 274.11)")
                } else {
                    // Not a value-type kind: a protocol/generic/unknown
                    // instance is accepted this wave, per the deferred
                    // handler-type machinery noted above (E.5). Its type is
                    // RECORDED when typing did not (a call records its callee,
                    // not always its value): the lowering holds the handler in
                    // a local of this type (E.9 step 2, lower/lower_with.nv).
                    if !is_ty(@chan.type_if_known(kids[bi + 2].id_of())) {
                        @record(kids[bi + 2], hty)
                    } else {
                        // Typing recorded it already.
                    }
                }
            } else {
                // No tail type recorded -- an unresolved or deferred
                // handler type (e.g. `Effect[Fs]`) is accepted this
                // wave; see the comment above this match.
            }
        } else {
            // SILENT-OK: the handler expression already refused itself
            // while typing; asking whether its type is a value type
            // would be the second death over the same cause.
        }
        bi += 3
        if bi < kids.len() && kids[bi].kind_of() == NodeKind.LeafNode {
            bi += 1
        } else {
            // No trailing `,` leaf here: either the bindings ended (the
            // next child is the body Block) or the loop condition below
            // stops on its own -- either way `bi` already sits where
            // the next piece is read from.
        }
    }
    ro body = kids[kids.len() - 1]
    if body.kind_of() == NodeKind.Block {
        @type_block(body)
    } else {
        // A missing body is the parser's error node, reported by the
        // shape walk's generic Err arm, `@report_err_branch`
        // (check/rules.nv:791, called from check/check.nv:185).
    }
}

/// A `spawn` body (E.9 step 4). It stands inside a `supervised` body (D50:
/// the oracle refuses a bare one in codegen, measured 2026-09-30), and it
/// runs in a NEW fiber, so what it reads from outside is a CAPTURE -- the
/// capture-mark stack of the handler literal (step 3), with this spawn as
/// the owner. A `mut` capture crosses the fiber boundary only for a type
/// vouched mut-alias-safe (`#share`, 06-concurrency.md:7370 section 2).
fn Checker mut @type_spawn_body(skids []Node, st Node, sbody Node) -> () {
    if @sup_depth == 0 {
        @reject_first_leaf_of(skids, SPAWN_OUTSIDE_SUPERVISED_MSG)
        return
    }
    @cap_marks.push(@scope.row_count())
    @cap_owners.push(st.id_of())
    // A spawn body runs in a NEW FIBER: a `return` written in it leaves THAT
    // body, not the fn holding the `spawn`, so a split boundary around the
    // latter does not cross in (remark 6/7, function boundaries).
    ro saved_split = @sup_split_depth
    @sup_split_depth = 0
    @type_block(sbody)
    @sup_split_depth = saved_split
    ro _ = @cap_marks.pop()
    ro _ = @cap_owners.pop()
    for c in @chan.captures_of(st.id_of()) {
        // A POISONED binding (no type) was refused where it was bound: one
        // cause, one diagnostic -- "not safe" about it would be the second.
        if !is_ty(c.type_id) { continue }
        if c.by_ref && !@is_mut_alias_safe(c.type_id) {
            @reject_first_leaf_of(skids, concurrent_mut_capture_msg(c.name))
            return
        } else {
            // A copy (`ro`), or a `mut` of a vouched type: it may cross.
        }
    }
}

/// May a `mut` binding of type `t` be aliased for mutation from another
/// fiber? Only a declaration vouched `#share` answers yes; everything else
/// -- a primitive (`mut int` is the motivating race), an unvouched record,
/// a generic application -- answers no. Conservative V1 (06-concurrency.md
/// section 1): the memberwise derivation for records is not read yet.
fn Checker @is_mut_alias_safe(t TyId) -> bool {
    ro k = @ctx.tys.kind_of(t)
    if k == TypeKind.TkRecord || k == TypeKind.TkNewtype || k == TypeKind.TkSum {
        return decl_of_ty(@ctx, t).share
    }
    false
}

/// Type a `supervised` or `spawn` statement (E4 wave, 274.11 Э.7 item 4): its
/// one body Block is typed as an ordinary block.
fn Checker mut @type_supervised_stmt(st Node) -> () {
    // SUPERVISION AND SPAWN (E4 wave, 274.11 Э.7 item 4): `supervised
    // { spawn { ... } }`. Each is its keyword leaf plus ONE body
    // Block, and the body is typed as an ORDINARY block -- D439
    // (direct blocking ops in a supervised body) is explicitly not
    // this task, per the plan record. The parser's door guarantees the
    // body brace, so the short shape is a broken invariant, not a form.
    ro skids = branch_children(st)
    if skids.len() < 2 {
        assert(@out.len() > 0, "check: a malformed supervised/spawn reached typing with no refusal")
        return
    }
    // THE NAMED ARGUMENTS in statement position (supervised-value wave):
    // `cancel:` (D441) is a later wave -- refused by name, never silently
    // dropped (relay.nv's `supervised(cancel: tok)` is the carrier). An
    // `on_timeout:` makes the construct a VALUE (D449: the handler produces
    // the result), so even with the value discarded it goes to the value
    // door, which types the body tail and the handler against one type.
    mut has_ot = false
    for c in skids {
        if c.kind_of() != NodeKind.NamedArg { continue }
        ro ak = branch_children(c)
        if ak.len() < 3 { continue }
        ro aname = leaf_text(ak[0])
        if aname == "cancel" {
            @report_first_leaf_of(ak, SUPERVISED_CANCEL_MSG)
            return
        } else if aname == "on_timeout" {
            has_ot = true
        } else {
            // timeout/deadline/unknown: typed below (or by the value door).
        }
    }
    if has_ot {
        // A STATEMENT gives the construct no expectation of its own: the body's
        // tail decides its type, and the handler is held to that (D449). A stale
        // expectation left by an enclosing position must not leak in.
        ro saved_expect = @value_expect
        @value_expect = no_ty()
        @type_supervised_value(st, as_value: false)
        @value_expect = saved_expect
        // SILENT-OK: the value door typed the body tail and the handler; the
        // statement discards the result it recorded.
        return
    }
    // No handler: the deadline expressions are values the emitter reads, so
    // their callees must be reached (a `100.to_millis()` left untyped vanishes
    // from mono's reach). The body stays an ORDINARY block -- no value tail is
    // demanded of the statement form (std's `supervised(timeout:) { spawn }`).
    for c in skids {
        if c.kind_of() != NodeKind.NamedArg { continue }
        ro ak = branch_children(c)
        if ak.len() < 3 { continue }
        @type_expr(ak[2])
    }
    ro sbody = skids[skids.len() - 1]
    if sbody.kind_of() == NodeKind.Block {
        if st.kind_of() == NodeKind.SpawnStmt {
            @type_spawn_body(skids, st, sbody)
            // SILENT-OK: the spawn body was typed and judged by its own door.
            return
        }
        @sup_depth += 1
        @type_block(sbody)
        @sup_depth -= 1
    } else {
        // A missing body is the parser's error node, reported by the
        // shape walk's generic Err arm, `@report_err_branch`
        // (check/rules.nv:791, called from check/check.nv:185).
    }
}

/// Type a `supervised` standing as a VALUE (the supervised-value wave: D414
/// §4, D442, D449): the tail of a value body, or a binding initializer. The
/// construct's type is the BODY's tail type POST-JOIN -- the body runs to a
/// value, the scope joins its spawned fibers, and that value is the result.
/// `on_timeout:` (D449) is a closure-light returning that SAME type, called
/// instead of throwing `Fail[TimeoutError]` when the deadline passes; its one
/// parameter is `TimeoutError`. `cancel:` (D441) is a later wave -- refused by
/// name here, not silently dropped. The body is typed through the fn body's
/// own tail door (`@tail_value_body`), so a tail call/match/if/literal is
/// judged exactly as a fn body judges it; the enclosing return expectation is
/// saved and restored around the body and the closure alike.
///
/// `as_value` separates the two POSITIONS: `true` for a value (a tail, an
/// initializer, an argument), where a body without a tail value is refused;
/// `false` for the statement form that carries a handler, whose body may yield
/// nothing -- the construct is then UNIT and the handler returns nothing.
fn Checker mut @type_supervised_value(st Node, as_value bool) -> () {
    ro skids = branch_children(st)
    if skids.len() < 2 {
        assert(@out.len() > 0, "check: a malformed supervised reached typing with no refusal")
        return
    }
    ro sbody = skids[skids.len() - 1]
    if sbody.kind_of() != NodeKind.Block {
        // A missing body is the parser's marker; the walk named it.
        return
    }
    // THE NAMED ARGUMENTS (D442/D449): `timeout:`/`deadline:` give the
    // deadline, `on_timeout:` the handler, `cancel:` is out of wave. The
    // timeout expression is typed like any value (a Duration the emitter
    // reads); the handler is typed below, against the body's own type.
    mut has_deadline = false
    mut ot_at = 0 - 1
    mut i = 0
    for c in skids {
        if c.kind_of() != NodeKind.NamedArg {
            i += 1
            continue
        }
        ro ak = branch_children(c)
        if ak.len() < 3 {
            i += 1
            continue
        }
        ro aname = leaf_text(ak[0])
        if aname == "timeout" || aname == "deadline" {
            has_deadline = true
            @type_expr(ak[2])
        } else if aname == "on_timeout" {
            ot_at = i
        } else if aname == "cancel" {
            @report_first_leaf_of(ak, SUPERVISED_CANCEL_MSG)
            return
        } else {
            // An unknown named argument: resolution owns the question of
            // which names a form takes; the value is typed so its own
            // refusals surface, and the emitter reads only what it knows.
            @type_expr(ak[2])
        }
        i += 1
    }
    // THE BODY AS A VALUE: its tail is the construct's type, judged against
    // the EXPECTATION OF ITS POSITION -- a fn body's declared return, a
    // written binding type, a call's parameter -- never against whatever
    // return expectation the enclosing fn happens to leave lying around.
    // Until the rework `@ret_expect` LEAKED in: `fn f() -> str { ro r =
    // supervised { ... 42 } ... }` judged the numeric tail against `str` and
    // refused a correct program (accepted by the oracle; registry 221.1,
    // supervised-value rework remark 3). The swap is the closure body's own
    // protocol, and it is restored on the way out, so the enclosing fn's
    // real return checks are untouched.
    ro want = @value_expect
    ro saved_expect = @ret_expect
    ro saved_unit = @ret_unit
    ro saved_ro = @ret_ro
    ro saved_tail = @tail_value_body
    @ret_expect = want
    @ret_unit = is_ty(want) && is_unit_ty(@ctx, want)
    @ret_ro = false
    @tail_value_body = sbody.id_of()
    @sup_depth += 1
    // A `return` in this body cannot leave the enclosing fn: the body is
    // SPLIT at the join and its exit boundary is a later wave. Refused by
    // name (typing.nv, RetStmt) rather than emitted as a jump past the
    // queue's cleanup (remark 6).
    @sup_split_depth += 1
    ro bmark = @out.len()
    @type_block(sbody)
    @sup_split_depth -= 1
    @sup_depth -= 1
    @tail_value_body = saved_tail
    @ret_ro = saved_ro
    @ret_unit = saved_unit
    @ret_expect = saved_expect
    // A BODY THAT REFUSED ITSELF stops the read below: the tail it leaves is a
    // node the lattice cannot answer about, and asking anyway is an ice (#902,
    // the mark rule every other tail entrance in typing.nv keeps). Measured on
    // `supervised(...) { println("body") }`: the walk refused the tail and this
    // door still asked `type_of` about it.
    if @out.len() > bmark {
        return
    } else {
        // Nothing refused: the body's tail is a value to read.
    }
    ro bkids = branch_children(sbody)
    ro tail_at = last_branch_of(bkids)
    mut body_ty = no_ty()
    if tail_at >= 0 {
        ro tail = bkids[tail_at]
        body_ty = @chan.type_if_known(tail.id_of())
        // The tail door records what it decided; a kind it does not type
        // (a binding, a loop) is asked of `type_of` only when it is a VALUE
        // tail -- `type_of` would otherwise name the statement's unit and
        // turn a missing value into a false success. A statement-only call
        // (`println`) is a STATEMENT: it stays unread, and the body yields
        // nothing (`tail_is_stmt_only`, tail_rules.nv).
        if !is_ty(body_ty) && is_value_tail_kind(tail.kind_of()) && !tail_is_stmt_only(tail) {
            body_ty = type_of(tail, @ctx, @scope, @chan)
        } else {
            // Recorded by the tail door, or not a value tail at all.
        }
    } else {
        // A body of leaves only: no value tail.
    }
    if !is_ty(body_ty) {
        if as_value {
            @report_first_leaf_of(skids, SUPERVISED_VALUE_NO_TAIL_MSG)
            return
        }
        // The statement form's body may end without a value: the construct
        // is UNIT and the handler returns nothing.
        body_ty = @ctx.prims.unit_id
    }
    // THE on_timeout HANDLER (D449): a closure returning the body's type, its
    // one parameter TimeoutError. A handler with no deadline is refused -- there
    // is no timeout to handle. The signature is interned through the one fn-type
    // door (params in order, result LAST); the closure typist binds the param
    // and judges the body against the result, exactly as a handler op does.
    if ot_at >= 0 {
        if !has_deadline {
            @report_first_leaf_of(branch_children(skids[ot_at]), SUPERVISED_ON_TIMEOUT_NO_DEADLINE_MSG)
            return
        }
        ro te_ty = timeout_error_ty(@ctx)
        ro sig = @ctx.tys.fn_type([]TyId.of(te_ty, body_ty))
        ro ot_expr = branch_children(skids[ot_at])[2]
        if ot_expr.kind_of() == NodeKind.ClosureLit {
            @type_closure_lit(ot_expr, sig)
        } else {
            // D449's handler is a closure-light this wave; a named fn value
            // would need the first-class closure machinery E.5 defers. Typed
            // so its own refusals surface, then named for the position.
            @type_expr(ot_expr)
            @report_first_leaf_of(branch_children(skids[ot_at]), CLOSURE_LIT_POSITION_MSG)
            return
        }
    } else {
        // No handler: a timeout throws Fail[TimeoutError] outward (D449), the
        // construct still has the body's type.
    }
    @record(st, body_ty)
}

/// The prelude's TimeoutError term (D449), resolved from the handed std
/// interface like every other prelude type -- the shell carries
/// `Nova_TimeoutError`, the registry carries the declaration. `no_ty()` when
/// the interface did not hand it: the closure param then binds poisoned and
/// its reads refuse by name, never a silent guess (the #652 class).
fn timeout_error_ty(ctx Ctx) -> TyId {
    match ctx.defs.type_decl(TIMEOUT_ERROR_TYPE) {
        None => no_ty()
        Some(d) => ctx.types[raw_decl(d)].ty_id
    }
}
