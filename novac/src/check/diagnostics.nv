// SPDX-License-Identifier: MIT OR Apache-2.0
// Role: the ONE place a refusal diagnostic is built (span rule, code choice
//   between SubsetDebt/LangError), plus the position doors every reporter in
//   the module reads through (first/last leaf offset, line number).
// Used by: every refusal site in `check` -- `@walk`, the typing walk, and the
//   match/return doors, through `@refuse`/`@reject`/`@refuse_span` and the two
//   leaf-offset doors.
// Guarded by: the module tests of check; check-novac-file-size.py (decision 12
//   -- this file exists because check.nv crossed 1000 lines and the cut was
//   made along a real seam, the same reason match_arms.nv/typing.nv split off).
//
// WHY A FILE OF ITS OWN. `check.nv` crossed 1000 lines (decision 12) with
// `@walk`'s own match over every NodeKind taking most of it; the seam is
// real: everything below answers ONE question -- where a refusal's bytes are
// and which of the two codes it carries -- and nothing here dispatches on a
// node's kind the way `@walk` does.

module novac.check

import ../lex.{Token}
import ../tree.{Node}
import ../diag.{Diagnostic, Severity}

/// WHAT KIND OF REFUSAL THIS IS -- and the two kinds answer different questions, which
/// is why one code could not carry both (plan 274 section 7, amendment 2026-09-14).
///
/// `SubsetDebt` says "this form is legal Nova and novac does not compile it YET". It is a
/// promise, and a promise owes a date: such a refusal must carry its stage, and
/// `check-novac-subset-debt-dated` holds that.
///
/// `LangError` says "the spec forbids this form" -- there is nothing to wait for, and a
/// stage on it would be a lie. Until 2026-09-14 both went out under the subset code, so an
/// author meeting a permanent error had every reason to expect the next wave to fix it.
/// The census of 2026-09-13 found 43 refusal texts carrying the debt wording and 29 not,
/// most of the 29 being permanent errors wearing the debt's code.
export type DiagKind enum
    | SubsetDebt /// legal form, not compiled yet -- owes a stage
    | LangError /// the spec forbids it -- nothing to wait for

/// Record one refusal at the token's exact bytes. THE one place that knows the code, the
/// severity and how a span is derived from a leaf — it used to be copied into five
/// reporters, so a change to the span rule had five chances to be applied four times
/// (owner's review 2026-08-16). The KIND is a parameter for the same reason: a second
/// door would be a second copy of that rule.
fn Checker mut @refuse_kind(t Token, msg str, kind DiagKind) -> () {
    ro lo = @src.offset_of(t.text)
    @refuse_span_kind(lo, lo + t.text.byte_len(), msg, kind)
}

/// The subset-debt door: the shape every existing caller already uses.
fn Checker mut @refuse(t Token, msg str) -> () {
    @refuse_kind(t, msg, DiagKind.SubsetDebt)
}

/// The PERMANENT-ERROR door at a token. Its twin exists so a caller moving from debt to
/// permanent changes ONE thing -- the code -- and not the position of the refusal as well:
/// without it those callers would have to be rewritten onto the walk-to-first-leaf shape,
/// and then a shifted diagnostic could not be told from a shifted code.
fn Checker mut @reject(t Token, msg str) -> () {
    @refuse_kind(t, msg, DiagKind.LangError)
}

/// The same door with an EXPLICIT span, for a refusal whose subject is a run
/// of tokens rather than one (274.3/F24). A junk run of five tokens used to be
/// underlined at its first byte: the editor squiggle covered `%` and left the
/// other four looking accepted, which is a lie about what was rejected. The
/// span rule stays in ONE place -- the reason @refuse exists at all.
fn Checker mut @refuse_span(lo int, hi int, msg str) -> () {
    @refuse_span_kind(lo, hi, msg, DiagKind.SubsetDebt)
}

/// THE one place a refusal diagnostic is built, for both kinds. The code is chosen HERE
/// from the kind and nowhere else: a caller that picked the string itself would be the
/// fifth copy of the rule this door exists to hold.
fn Checker mut @refuse_span_kind(lo int, hi int, msg str, kind DiagKind) -> ()
    requires lo >= 0, "check: refusal span starts before the file"
    requires hi >= lo, "check: refusal span ends before it starts" {
    ro code = match kind {
        DiagKind.SubsetDebt => "E_NOVAC_SUBSET"
        DiagKind.LangError => "E_NOVAC_LANG"
    }
    @out.push(Diagnostic {
        code,
        severity: Severity.ErrorSev,
        lo,
        hi,
        message: msg,
    })
}

/// The source offset of the FIRST leaf under `e`, or -1 for a leafless
/// recovery shape -- the left edge of a run (the contract note's writer is
/// the one caller today).
fn Checker @first_leaf_offset(e Node) -> int {
    match e {
        Leaf(t) => @src.offset_of(t.text)
        Branch { children, .. } => {
            for c in children {
                ro lo = @first_leaf_offset(c)
                if lo >= 0 { return lo }
            }
            -1
        }
    }
}

/// The 1-based line of a byte offset: newlines counted once, here -- the
/// diagnostics keep raw offsets (LSP maps them itself, E3), but a contract
/// panic prints a line the way the oracle does (#874).
fn Checker @line_at(lo int) -> int {
    ro b = @src.text.bytes()
    mut line = 1
    for i in 0..lo {
        if b[i] == LF_BYTE {
            line += 1
        } else {
            // Any other byte stays on its line.
        }
    }
    line
}

/// The newline byte the line counter reads.
const LF_BYTE u8 = 0x0A

/// Extends `best` to the end of the LAST leaf under `children` -- the right
/// edge of a run, in source offsets.
///
/// It takes the current best and returns a bigger one instead of answering
/// "the last leaf, if any": a run always has at least the leaf its caller
/// already found, so absence is not a case here, and the monotone form needs
/// neither an Option nor an int sentinel. (The Option form was written first
/// and did not survive: `Option[Token]` -- a record inside an Option -- and a
/// mut local of `Option[int]` reassigned in a match arm BOTH miscompile under
/// the current oracle, the second one emitting Nova source text verbatim into
/// the C. Escalated separately; this shape does not need the feature at all.)
fn Checker @run_end_of(children []Node, best int) -> int {
    mut e = best
    for c in children {
        match c {
            Leaf(t) => { e = e.max(@src.offset_of(t.text) + t.text.byte_len()) }
            Branch { children: inner, .. } => { e = @run_end_of(inner, e) }
        }
    }
    e
}
