// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `check_return_expr` -- the value a body produces is checked
// against the declared return AT THE EXPRESSION (E0308), the same check for a
// tail and for `return`; NOT taken: coercion at that site (Nova has none
// between named types, D405 amendment) and the `!` type (a `panic` tail has
// no type here and the door says nothing).
// Role: layer 7 (check) -- the RETURN DOOR (274.7 B5, registry #960): the
// declared return a body must produce, the literal rule at a value tail, and
// the one judge every exit of a value passes through (`=>` body, block tail,
// `return e`). The typing walk in typing.nv calls it at each of those sites.
// Used by: typing.nv (type_fn sets the expectation, the tail sites judge).
// Guarded by: check-novac-file-size.py (this file exists because typing.nv
// crossed 1000 lines with wave B5 -- the cut is the wave's block, by meaning),
// check-novac-branch-complete.py, check-novac-no-silent-skip.py, and the
// fixtures return_mismatch/ and return_narrowing/ through check-novac-no-cascade.
// novac/src/check/return_rules.nv -- what a fn declares, its body returns.

module novac.check

import ../tree.{Node, NodeKind}
import ../types.{TyId, no_ty, is_ty, Interner, same_ty}
import ../sem.{FnRow, raw_row, branch_children, ty_source_name, prim_row_of, LitArg}
import ../sem.{Ctx, expr_leaf_name, is_value_record}
import ../builtins.{TypeKind, RECV_BINDING}

/// THE RETURN A BODY MUST PRODUCE, or `no_ty()` when nothing is judged: no
/// declared value (unit, or none), or a type PARAMETER -- the instance types
/// its own body under its substitution, and the generic shape answers "I do
/// not judge" rather than guessing (the oracle's #959 fix takes the same
/// stance). Concrete for an instance through the same door every other type
/// of the body takes (`@concrete`).
fn Checker @return_expectation(row FnRow) -> TyId {
    ro rid = @ctx.fns.rows[raw_row(row)].ret_id
    if !is_ty(rid) { return no_ty() }
    if rid == @ctx.prims.unit_id { return no_ty() }
    ro cr = @concrete(rid)
    // THE TWIN OF THE GUARD IN `judge_return`, and finding it here is what
    // turned one fix into a rule: `is_ty(rid)` above says the DECLARED type
    // is real, and says nothing about what `@concrete` gives back. An
    // unresolved inference variable resolves to an absence, and the door
    // below refuses it by contract.
    //
    // Both sites read as guarded to a reader -- and to a scan -- because an
    // `is_ty` stands a line or two above. The question that separates them
    // is whether the guard is on the value HANDED to the door or on the one
    // it was derived from.
    if !is_ty(cr) { return no_ty() } else {}
    if @ctx.tys.kind_of(cr) == TypeKind.TkParam { return no_ty() }
    cr
}

/// Type a value that flows OUT of the fn -- a tail expression or a `return`
/// operand. A bare numeric literal takes the DECLARED return type (D227 rule 2,
/// D55 at the return position: `fn f() -> f64 => 1`, `fn g() -> u8 => 200`),
/// judged for fit before it is recorded -- the very rule the argument door
/// applies, through the same two doors (`adapt_operand`, `lit_fits_or_refuse`).
/// Anything else is typed as an expression and judged afterwards.
fn Checker mut @type_tail_value(e Node) -> () {
    if is_ty(@ret_expect) {
        // Only a BARE LITERAL is asked about before it is typed: the lattice
        // ices on a name the registry does not carry (#902), so an unknown
        // callee in the tail must reach the expression walk's refusal first.
        match lit_arg_of(e) {
            NotLit => {}
            IntLitArg | FloatLitArg => {
                ro own = type_of(e, @ctx, @scope, @chan)
                ro adapted = adapt_operand(e, own, @ret_expect, @ctx.tys)
                if @lit_fits_or_refuse(e, adapted) {
                    @record(e, adapted)
                } else {
                    // The literal does not fit the declared width: the fit
                    // door refused it at its own token (E_LIT_OUT_OF_RANGE).
                }
                // SILENT-OK: the literal was recorded, or refused by the fit door
                // just above -- a decision either way, and nothing else to type.
                return
            }
        }
    } else {
        // Nothing to adapt to: the fn declares no value to judge against.
    }
    // THE EXPECTATION FLOWS INTO THE VALUE (wave W4): a bare `None` in the tail
    // -- or in an arm of a tail match/if -- is an instance of the declared
    // return; a call CLEARS it around its arguments (option_rules), so
    // `f(None)` in the tail is not typed as the fn's own return.
    @value_expect = same_ty(@ret_expect)
    @type_expr(e)
    @value_expect = no_ty()
}

/// The type of a value tail AFTER it was typed, for the return door: what the
/// channel recorded when it recorded anything (a literal adapted to the return,
/// a tail `if`/`match` folded to its agreed type), else the lattice's answer.
/// Asked only when typing refused nothing (the caller's mark), for #902's reason.
fn Checker @tail_type_of(e Node) -> TyId {
    ro rec = @chan.type_if_known(e.id_of())
    if is_ty(rec) { return same_ty(rec) }
    // An ANONYMOUS constructor (`=> { n: 1 }` for `-> Bytes`) has no type of its
    // own: the language types it by its expectation, and the lattice, asked
    // about it, ices ("anonymous constructor without a spread"). Its type IS the
    // declared return; the field door judges its fields against that record.
    if e.kind_of() == NodeKind.RecordCtor {
        ro ck = branch_children(e)
        if ck.len() > 0 && ck[0].kind_of() != NodeKind.Name { return same_ty(@ret_expect) }
        // A NAMED constructor (`Bytes { n: 1 }`) has its own type: the lattice answers.
    } else {
        // Any other expression: the lattice answers.
    }
    type_of(e, @ctx, @scope, @chan)
}

/// THE RETURN DOOR (274.7 B5, registry #960; the oracle's is #959): the value a
/// body produces is the type the fn declares, BY NAME -- D405's amendment and
/// spec/conversions.md admit no implicit conversion between named types, so
/// `int` for `-> f64`, `f64` for `-> int`, `n int` for `-> u8`, a `str` for
/// `-> int` and a newtype's representation for the newtype are all refused.
/// Until 2026-09-05 neither compiler had this door: the argument and binding
/// positions refused what the return position let through, and the C
/// compiler or a silent truncation (`-> u8 => 300` printed 44) said the rest.
///
/// The type comes from the CALLER -- the one typing just computed or recorded
/// (`tail_type_of`) -- and only when typing refused nothing; an untypeable
/// tail (`no_ty()`: a `panic(...)` tail, the language's `never`, has no value
/// to type) makes the door say nothing on top. Two names, matched to the oracle's `assignable`
/// so the differential compares by NAME: an integer narrowing is
/// E_IMPLICIT_NARROWING, everything else E7301.
fn Checker mut @judge_return(e Node, t0 TyId) -> () {
    if !is_ty(@ret_expect) { return }
    if !is_ty(t0) { return }
    // An instance's body may still name the PARAMETER (`x T` bound as written):
    // the comparison is between concrete types, through the same door every
    // type of the body takes; a parameter that stays a parameter is not judged.
    ro t = @concrete(t0)
    // `is_ty(t0)` ABOVE DOES NOT IMPLY `is_ty(t)` HERE, and the gap is the
    // whole of this line. `@concrete` resolves an inference variable to what
    // it was bound to, and an unresolved one has nothing to give back -- so a
    // type that WAS real arrives as an absence, and `kind_of` refuses it by
    // contract.
    //
    // MEASURED 2026-09-20 (registry No. 1168 family). Reading two new arm
    // forms tonight let the walk reach this judge on shapes it had never
    // seen, and `check/return_rules.nv` iced where it used to produce
    // diagnostics. Third time in one night that a form becoming readable
    // opened a path into a door that asks the interner about a type nobody
    // guaranteed.
    //
    // WORTH KNOWING FOR THE NEXT AUDIT: a scan for unguarded `kind_of` that
    // looks for an `is_ty` anywhere earlier in the function calls this site
    // GUARDED and misses it. The guard has to be on the value actually
    // handed to the door, not on its ancestor.
    if !is_ty(t) { return } else {}
    if @ctx.tys.kind_of(t) == TypeKind.TkParam { return }
    if t == @ret_expect {
        // Same type as the result. What is left is HOW the value is bound (#1309).
        @judge_ro_param_return(e, t)
        return
    }
    ro from = ty_source_name(@ctx, t)
    ro to = ty_source_name(@ctx, @ret_expect)
    ro msg = if int_narrows(@ctx.tys, t, @ret_expect) {
        "cannot return value of type `${from}` from a function declared `-> ${to}` -- implicit int narrowing loses range; use an explicit `... as ${to}` cast (D54, E_IMPLICIT_NARROWING)"
    } else {
        "cannot return value of type `${from}` from a function declared `-> ${to}` (E7301): no implicit conversion between named types (D405, spec/conversions.md) -- convert with `as`, or fix the declaration"
    }
    @report_first_leaf_of([]Node.of(e), msg)
}

/// A `ro` PARAMETER HANDED OUT THROUGH A NON-`ro` RESULT (D246 amendment,
/// E_READONLY_COERCE; registry #1309). A parameter written without `mut` is bound
/// `ro` (D176), and returning it as a plain `-> T` lets the caller's
/// `mut w = f(x)` write what the parameter froze. The oracle refuses exactly this;
/// until 2026-09-23 novac accepted it without a word.
///
/// MEASURED against the oracle, and this door mirrors it and nothing wider
/// (`docs/plans/repro/1309-ro-param-return/`): a record without `value`, a sum --
/// a payload-free enum too --, an applied type (`[]T`, `Option[T]`) and an effect
/// handler are refused; a primitive, a `value` record and a newtype are accepted,
/// and so are the receiver `@`, a `mut` or `consume` parameter, a pattern binder
/// and a field of the parameter. THE ALIAS `ro y = x` then `y` the oracle refuses
/// and this door does not see -- the named rest of #1309.
fn Checker mut @judge_ro_param_return(e Node, t TyId) -> () {
    if e.kind_of() != NodeKind.Name {
        // Not a bare name: a call, a field, a literal -- a fresh value, or one the
        // oracle does not freeze (measured, see above).
    } else if !ro_return_freezes(@ctx, t) {
        // A type the language copies: nothing is shared with the caller.
    } else {
        ro name = expr_leaf_name(e)
        if name != RECV_BINDING && @scope.is_ro_param(name) {
            @report_first_leaf_of([]Node.of(e), ro_param_return_msg(name))
        } else {
            // The receiver, a `mut`/`consume` parameter, or a local.
        }
    }
}

/// Does a value of this type stay SHARED with its source when it is returned --
/// the types E_READONLY_COERCE is about? The measured list of the door above; a
/// kind added later is ACCEPTED here until it is measured, and #1309 says so.
fn ro_return_freezes(ctx Ctx, t TyId) -> bool {
    ro k = ctx.tys.kind_of(t)
    if k == TypeKind.TkRecord { return !is_value_record(ctx, t) }
    k == TypeKind.TkSum || k == TypeKind.TkApp || k == TypeKind.TkEffect
}

/// The refusal text, outside the door so the door builds nothing (P18).
fn ro_param_return_msg(name str) -> str =>
    "cannot return `${name}` through a result that is not `ro`: the parameter is bound `ro` (written without `mut`, D176), and `mut w = f(...)` at the caller would write what it froze (D246 amendment, E_READONLY_COERCE) -- take `mut ${name}`, return a copy, or declare the result `-> ro T`"

/// Is `to` a NARROWER integer than `from` -- fewer bits, or the same bits with the
/// other signedness (D54's table: every such pair loses range)? Two integer rows
/// only; any other pair is a plain mismatch.
#realtime nogc
fn int_narrows(tys Interner, from TyId, to TyId) -> bool {
    ro fr = match prim_row_of(tys, from) {
        None => return false
        Some(r) => r
    }
    ro tr = match prim_row_of(tys, to) {
        None => return false
        Some(r) => r
    }
    ro from_int = match fr.family {
        PfInt => true
        PfFloat | PfStr | PfBool | PfChar | PfUnit => false
    }
    ro to_int = match tr.family {
        PfInt => true
        PfFloat | PfStr | PfBool | PfChar | PfUnit => false
    }
    if !from_int || !to_int { return false }
    tr.bits < fr.bits || (tr.bits == fr.bits && tr.signed != fr.signed)
}

/// `return <value>` IS AN INITIALIZER POSITION (2026-09-21, moved from
/// check.nv's subset walk when that file crossed 1000 lines the same night --
/// check-novac-file-size.py): the lowering places the value through
/// `@lower_place` into the return slot (`@lower_return`, `lower/lowering.nv`)
/// -- the same door a binding's own initializer goes through -- so a record
/// constructor or a `match` here has the exact tmp-scheme `init_pos` exists
/// to permit. Found by narrowing: `return Point { .. }` and `return match
/// k {..}` both refused before this arm existed, while the same values as a
/// binding's initializer already compiled (274.5 sec.5g). A bare `return`
/// has one child (the keyword leaf) and marking it init_pos is harmless --
/// a leaf does not read the flag.
///
/// THIS WALK DECIDES POSITION ONLY -- it does not type anything, and an
/// earlier version of this fix called `@type_match` right here, from inside
/// the STRUCTURAL walk, before any function's parameters are bound into
/// `@scope`. It refused the match's own scrutinee as "unknown name": not a
/// double-typing bug, but asking the typing question in the wrong PASS.
/// Typing a `return`'s match value is typing.nv's job (RetStmt branch),
/// which runs later, after scope is populated -- see the mirror of
/// `FnExprBody`'s dispatch there.
fn Checker mut @walk_ret_stmt(children []Node) -> () {
    mut i = 0
    for c in children {
        @walk(c, init_pos: i == children.len() - 1)
        i += 1
    }
}
