// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check — the E1 mini-checker (architecture §2: module `check`).
//
// The subset rule is ONE: everything the parser had to recover from is
// outside the E1 subset, and every such place is reported HONESTLY as
// E_NOVAC_SUBSET with its exact byte position — computed through the one
// position door (source.offset_of on the leaf's text slice). One Err branch
// produces exactly one diagnostic: no cascades by construction, which is what
// check-novac-no-cascade.sh will hold once fixtures exist.
//
// Poisoning discipline (§7): an Err branch is already-reported by definition;
// nothing else looks inside it. There is no permissive unknown here to
// swallow anything (the №652 lesson) — the subset checker either understands
// a node kind or reports it, an exhaustive match with no silent default.

module novac.check

import ../source.{SourceText}
import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind}
import ../diag.{Diagnostic, Severity}
import ../builtins.{ENTRY_FN, PRINT_FN}
import ../sem.{Ctx, branch_children, call_callee_text, is_expr_kind}

/// State of one check run: the source (for positions), the semantic context
/// and the diagnostics collected so far. A receiver, not a triple of
/// parameters on every function — the shape of every reference (Go
/// `*Checker`, Roslyn `Binder`, rustc `FnCtxt`, Zig `*Sema`).
///
/// WHY NOT AN EFFECT (owner's question, 2026-08-16). Nova's effects model
/// CAPABILITIES and control — `Fs`, `Os`, `Fail`, `Supervisor`; the
/// compilation context is pure data. An ambient context (a) hides the data
/// flow, and the §3/§4 map rests on that flow being visible ("what flows
/// along the edge" is guarded), (b) pays a TLS-vtable cost on every read
/// in the hot `type_of` loop, under П14 "speed is priority #1", (c)
/// diverges from the references: rustc keeps `TyCtxt` explicit, and the
/// ambient `ty::tls` is left only for diagnostics and debugging.
type Checker {
    src SourceText /// the file text: the one source of positions
    ctx Ctx /// type registry and callable table, read from the declarations
    out []Diagnostic /// diagnostics collected by this run
}

/// Check a parsed file against the E1 subset. Always returns the full list;
/// no Result (274 §4 item 1).
///
/// WHY THIS IS A FREE FUNCTION AND NOT A METHOD ON `Ctx` (owner's question,
/// 2026-08-16). `Ctx` is DATA — the type registry and the callable table.
/// Hanging a pass on it would make the registry own the pass, and then
/// `emit` would want to hang there too: `Ctx` becomes the object that knows
/// every backend, which is exactly the ownership the architecture keeps
/// apart (the rustc_middle model — `TyCtxt` holds data, passes consume it).
/// It would also invert an edge of the §3 table: `Ctx` lives in `sem`, so a
/// method on it would make `sem` reference `Diagnostic` and the checker,
/// and `check-novac-deps.sh` refuses that edge by construction. What the
/// entry point IS, is a constructor plus a run — the same shape `emit_c`
/// uses for `Emitter`: the module has one door, and the receiver lives
/// behind it.
export fn check(file Node, src SourceText, ctx Ctx) -> []Diagnostic {
    mut c = Checker { src, ctx, out: []Diagnostic.new() }
    c.walk(file)
    c.out
}

/// Record one subset refusal at the token's exact bytes. THE one place that
/// knows the code, the severity and how a span is derived from a leaf — it
/// used to be copied into five reporters, so a change to the span rule had
/// five chances to be applied four times (owner's review 2026-08-16).
fn Checker mut @refuse(t Token, msg str) -> () {
    ro lo = @src.offset_of(t.text)
    @out.push(Diagnostic {
        code: "E_NOVAC_SUBSET",
        severity: Severity.ErrorSev,
        lo,
        hi: lo + t.text.byte_len(),
        message: msg,
    })
}

/// Walk the tree and collect subset diagnostics.
///
/// init_pos: record constructors and match expressions are subset forms ONLY
/// in an initializer position — the direct init of a binding or the body of
/// an expression-bodied fn. The emitter's tmp-schemes have exactly those
/// shapes; anywhere else (argument, nested field value, condition, arm) the
/// form is an honest E_NOVAC_SUBSET, not an emitter ice later. The default
/// is the common case, so only the two places that actually open an
/// initializer position say so.
fn Checker mut @walk(n Node, init_pos bool = false) -> () {
    match n {
        Leaf(t) => @report_if_error_token(t)
        Branch { kind, children } => {
            if kind == NodeKind.Err {
                @report_err_branch(children)
                return
            }
            if kind == NodeKind.Block { @report_if_bad_call_stmt(children) }
            if kind == NodeKind.MethodCall { @report_if_unknown_method(children) }
            if kind == NodeKind.Call || kind == NodeKind.MethodCall { @report_if_ordered_args(children) }
            if kind == NodeKind.FnDecl { @report_if_missing_ret(children) }
            if kind == NodeKind.Field { @report_if_missing_type(children, "outside the E1 subset: field must declare a type") }
            if kind == NodeKind.Param { @report_if_missing_type(children, "outside the E1 subset: parameter must declare a type") }
            if kind == NodeKind.RecordCtor && !init_pos {
                @report_first_leaf_of(children, "outside the E1 subset: record constructor only as a binding initializer")
                return
            }
            if kind == NodeKind.ArrayLit {
                // Owner's rollback 2026-08-15: []int was taken as a hard-coded
                // std instance (one seed row + C_VEC_INT_* constants) — a K7
                // half-capability (novac 'knows' []int, silently not []str).
                // Arrays return with generics through `mono` (E2-b); until
                // then this is an honest subset refusal, not a fake take.
                @report_first_leaf_of(children, "outside the subset: arrays arrive with generics (E2-b), not as one hard-coded instance")
                return
            }
            if kind == NodeKind.MatchExpr && !init_pos {
                @report_first_leaf_of(children, "outside the E1 subset: match only as a binding initializer or an expression fn body")
                return
            }
            if kind == NodeKind.BindStmt || kind == NodeKind.FnExprBody {
                mut i = 0
                for c in children {
                    @walk(c, init_pos: i == children.len() - 1)
                    i += 1
                }
                return
            }
            for c in children {
                @walk(c)
            }
        }
    }
}

// No silent type defaults (owner's rule 2026-08-14, the #652 class: a
// quiet nova_int fallback bred a bug family in the current compiler). A
// shape with a missing type is refused HERE — the emitter's matching ice
// is the second floor, never the first answer.

/// [name, type-ident, ...] — the second child must be an Ident leaf.
fn Checker mut @report_if_missing_type(kids []Node, msg str) -> () {
    if kids.len() >= 2 {
        match kids[1] {
            Leaf(t) => { if t.kind == TokenKind.Ident { return } }
            Branch { .. } => {}
        }
    }
    @report_first_leaf_of(kids, msg)
}

/// Every fn except main must declare `-> T` in the subset.
fn Checker mut @report_if_missing_ret(kids []Node) -> () {
    if kids.len() < 2 { return }
    match kids[1] {
        Leaf(t) => {
            if t.text == ENTRY_FN { return }
            for c in kids {
                match c {
                    Leaf(_) => {}
                    Branch { kind, .. } => { if kind == NodeKind.RetType { return } }
                }
            }
            @refuse(t, "outside the E1 subset: fn requires a declared return type")
        }
        Branch { .. } => {}
    }
}

/// Report `msg` at the first leaf found under `children` (depth-first).
fn Checker mut @report_first_leaf_of(children []Node, msg str) -> () {
    for c in children {
        match c {
            Leaf(t) => {
                @refuse(t, msg)
                return
            }
            Branch { children: inner, .. } => {
                ro before = @out.len()
                @report_first_leaf_of(inner, msg)
                if @out.len() > before { return }
            }
        }
    }
}

/// Does this subtree call anything? An argument that calls something is an
/// argument whose evaluation ORDER is observable.
fn contains_call(n Node) -> bool {
    match n {
        Leaf(_) => false
        Branch { kind, children } => {
            if kind == NodeKind.Call || kind == NodeKind.MethodCall { return true }
            for c in children {
                if contains_call(c) { return true }
            }
            false
        }
    }
}

/// Two arguments that BOTH call something are two side effects whose order
/// the emitter does not fix: it prints the call straight into C, and C
/// leaves argument evaluation order unspecified at any calling convention.
/// Probe 2026-08-16 (finding F65): the oracle evaluates such a call
/// RIGHT-to-left, while the spec calls left-to-right normative and
/// observable. Until the emitter hoists arguments into temporaries in source
/// order, this is an honest subset refusal — the same choice the arrays
/// rollback made, and the opposite of quietly emitting order-dependent code.
/// One effectful argument is fine: a single effect has no order to get wrong.
fn Checker mut @report_if_ordered_args(kids []Node) -> () {
    mut effectful = 0
    for c in kids {
        if is_expr_kind(c.kind_of()) {
            if contains_call(c) { effectful += 1 }
        }
    }
    if effectful >= 2 {
        @report_first_leaf_of(kids, "outside the E1 subset: two arguments that both call something, and the emitter does not fix their order yet (F65)")
    }
}

/// A CALL in statement position is `println` and nothing else in the subset.
/// Owner's question 2026-08-16 ("does every Call really become a println?"):
/// it did, and the emitter's ice was the FIRST answer for `helper()` as a
/// statement — the #652 class again, where the boundary belongs in check and
/// the ice is only the second floor. Expression-position calls are a
/// different question and go through the emitter's Call branch.
fn Checker mut @report_if_bad_call_stmt(stmts []Node) -> () {
    for st in stmts {
        match st {
            Leaf(_) => {}
            Branch { kind, children } => {
                if kind == NodeKind.Call {
                    if call_callee_text(children) != PRINT_FN {
                        @report_first_leaf_of(children, "outside the E1 subset: a call in statement position is println only")
                    }
                }
            }
        }
    }
}

/// MethodCall kids: [recv, '.', name, '(', args..., ')'] — the name leaf is
/// judged against the ONE subset table. An unknown method is an honest
/// E_NOVAC_SUBSET at the method name, not an emitter ice later. (The
/// receiver's TYPE is not judged here — the type checker is a later wave;
/// the named risk lives in the divergence registry next to #652.)
fn Checker mut @report_if_unknown_method(kids []Node) -> () {
    if kids.len() < 3 { return }
    match kids[2] {
        Leaf(t) => {
            // novac knows a method ONLY from declarations it has read
            // (П5: it does not know std names). At this stage there are
            // no locals yet, so the receiver's type is unknown and only
            // the name's existence is judged; the exact pair (receiver
            // type, name) is finding C9 of plan 274.3, wave 3.
            if !@ctx.fns.has_name(t.text) {
                @refuse(t, "outside the subset: no such method in the declarations handed to novac (or the name is overloaded)")
            }
        }
        Branch { .. } => {}
    }
}

/// An ErrorTok leaf is a lexer refusal: report it at its position.
fn Checker mut @report_if_error_token(t Token) -> () {
    if t.kind == TokenKind.ErrorTok {
        @refuse(t, "outside the E1 subset: unrecognized or context-dependent token")
    }
}

/// An Err branch is ONE recovered mistake: one diagnostic at its first leaf.
fn Checker mut @report_err_branch(children []Node) -> () {
    // One Err branch — one diagnostic, at its FIRST leaf. The leaf can nest:
    // parse wraps a stray non-header module declaration as a whole ModuleDecl
    // branch inside Err (fuzzer catch 2026-08-14); the old flat scan found no
    // direct leaf there and reported NOTHING — a silent pass on a broken file.
    ro before = @out.len()
    for c in children {
        if @out.len() > before { return } // the one diagnostic is out already
        match c {
            Leaf(t) => {
                @refuse(t, "outside the E1 subset: construct not in the MVP grammar")
                return
            }
            Branch { children: inner, .. } => @report_err_branch(inner)
        }
    }
}
