// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Go `types2` `*Checker` (one receiver holding pass state) + rustc `FnCtxt`
// for the walk; rustc `TyKind::Error(ErrorGuaranteed)` / Roslyn `IsErrorType`
// suppression for no-cascade (an Err branch is already reported, nothing looks
// inside); rustc keeps `TyCtxt` explicit (`ty::tls` only for diagnostics) —
// context is data, not an effect; Go `types2` `Checker.errorf` for the single
// `refuse` reporter; Donor: none for the subset refusals (init_pos for ctor/match,
// F65 ordered args, arrays rollback, statement-call = println only) — an honest
// E_NOVAC_SUBSET instead of a silently wrong emission (П27 p.3 class); NOT taken:
// rustc obligation solver (E2-b3), local typing in check (274.3 wave 3 / C9).
// Role: layer 7 — the subset judge; publishes diagnostics, will publish the type channel (resolved_types) at E2-b1
// tail.
// Used by: pipeline (E1+); the LSP at E3 reads its channel instead of re-walking; emit_c reads its verdicts, never
// re-derives.
// Guarded by: check-novac-no-cascade.sh, check-novac-diag-schema.sh, check-novac-differential.sh (verdicts match the
// oracle on the corpus), check-novac-no-default-branch.sh (kind dispatch is exhaustive), the pipeline tests (one cause,
// one diagnostic).
// rustc `FnCtxt` for the walk shape; poisoning discipline from rustc
// `TyKind::Error` — an already-reported node yields nothing further; NOT taken:
// rustc's obligation solver (arrives with bounds, E2-b3).
// novac/src/check — the E1 mini-checker (architecture §2: module `check`).
//
// The subset rule is ONE: everything the parser had to recover from is
// outside the E1 subset, and every such place is reported HONESTLY as
// E_NOVAC_SUBSET with its exact byte position — computed through the one
// position door (source.offset_of on the leaf's text slice). One Err branch
// produces exactly one diagnostic: no cascades by construction, which is what
// check-novac-no-cascade.sh will hold once fixtures exist.
//
// Poisoning discipline (§7): an Err branch is already-reported by definition;
// nothing else looks inside it. There is no permissive unknown here to
// swallow anything (the №652 lesson) — the subset checker either understands
// a node kind or reports it, an exhaustive match with no silent default.

module novac.check

import ../source.{SourceText}
import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, BinOp, UnOp, bin_op_of, un_op_of}
import ../diag.{Diagnostic, Severity, ice}
import ../builtins.{ENTRY_FN, PRINT_FN, is_bool_literal}
import ../sem.{Ctx, CheckOut, DefKind, branch_children, call_callee_text, is_expr_kind, leaf_text, leaf_kind, expr_leaf_name}

/// State of one check run: the source (for positions), the semantic context
/// and the diagnostics collected so far. A receiver, not a triple of
/// parameters on every function — the shape of every reference (Go
/// `*Checker`, Roslyn `Binder`, rustc `FnCtxt`, Zig `*Sema`).
///
/// WHY NOT AN EFFECT (owner's question, 2026-08-16). Nova's effects model
/// CAPABILITIES and control — `Fs`, `Os`, `Fail`, `Supervisor`; the
/// compilation context is pure data. An ambient context (a) hides the data
/// flow, and the §3/§4 map rests on that flow being visible ("what flows
/// along the edge" is guarded), (b) pays a TLS-vtable cost on every read
/// in the hot `type_of` loop, under П14 "speed is priority #1", (c)
/// diverges from the references: rustc keeps `TyCtxt` explicit, and the
/// ambient `ty::tls` is left only for diagnostics and debugging.
type Checker {
    src SourceText /// the file text: the one source of positions
    ctx Ctx /// type registry and callable table, read from the declarations
    out []Diagnostic /// diagnostics collected by this run
    chan CheckOut /// THE channel this run publishes: what the checker decided (sem.CheckOut)
    scope Scope /// locals of the function body being typed; reset per function
    /// One-entry table reused by the self-initializer check (274.3/F28). It is
    /// a FIELD and not a local because the lookup door must not build anything
    /// (P18/P14): a table allocated per binding turns an O(1) question into an
    /// allocation on the hot path of every `ro`/`mut` in the file.
    self_probe NameTable
}

/// Check a parsed file against the E1 subset. Always returns the full list;
/// no Result (274 §4 item 1).
///
/// WHY THIS IS A FREE FUNCTION AND NOT A METHOD ON `Ctx` (owner's question,
/// 2026-08-16). `Ctx` is DATA — the type registry and the callable table.
/// Hanging a pass on it would make the registry own the pass, and then
/// `emit` would want to hang there too: `Ctx` becomes the object that knows
/// every backend, which is exactly the ownership the architecture keeps
/// apart (the rustc_middle model — `TyCtxt` holds data, passes consume it).
/// It would also invert an edge of the §3 table: `Ctx` lives in `sem`, so a
/// method on it would make `sem` reference `Diagnostic` and the checker,
/// and `check-novac-deps.sh` refuses that edge by construction. What the
/// entry point IS, is a constructor plus a run — the same shape `emit_c`
/// uses for `Emitter`: the module has one door, and the receiver lives
/// behind it.
/// The channel comes back WITH the diagnostics, from ONE door: a second
/// entry point ("check, and this time also record") would be two passes
/// disagreeing about one file, which is the disease the channel cures.
///
/// The typing walk runs only on a CLEAN subset verdict. That is not a
/// convenience: the emitter's contract is already "never called on broken
/// input" (pipeline), the lattice remaining ices are user errors under
/// [LEGACY-#700-user-error-as-ice until:E2b3], and typing a file that the
/// subset already refused would turn a refusal into an ice. When #700 lands
/// the walk becomes unconditional, because then its answer on bad input is a
/// diagnostic and not a death.
export fn check(file Node, src SourceText, ctx Ctx) -> ([]Diagnostic, CheckOut) {
    mut c = Checker {
        src, ctx,
        out: []Diagnostic.new(),
        chan: CheckOut.new(file.id_of() + 1),
        scope: Scope.new(), self_probe: NameTable.new(NamespaceId.NsLocals),
    }
    c.walk(file)
    if c.out.len() == 0 {
        c.type_file(file)
        c.chan.assert_disjoint()
    } else {
        // A refused file is not typed: the walk's answer on broken input is an
        // ice today ([LEGACY-#700-user-error-as-ice]), so the refusals already
        // collected ARE the verdict, and the channel goes back as the walk left it.
    }
    (c.out, c.chan)
}

/// Record one subset refusal at the token's exact bytes. THE one place that
/// knows the code, the severity and how a span is derived from a leaf — it
/// used to be copied into five reporters, so a change to the span rule had
/// five chances to be applied four times (owner's review 2026-08-16).
fn Checker mut @refuse(t Token, msg str) -> () {
    ro lo = @src.offset_of(t.text)
    @refuse_span(lo, lo + t.text.byte_len(), msg)
}

/// The same door with an EXPLICIT span, for a refusal whose subject is a run
/// of tokens rather than one (274.3/F24). A junk run of five tokens used to be
/// underlined at its first byte: the editor squiggle covered `%` and left the
/// other four looking accepted, which is a lie about what was rejected. The
/// span rule stays in ONE place -- the reason @refuse exists at all.
fn Checker mut @refuse_span(lo int, hi int, msg str) -> ()
    requires lo >= 0, "check: refusal span starts before the file"
    requires hi >= lo, "check: refusal span ends before it starts" {
    @out.push(Diagnostic {
        code: "E_NOVAC_SUBSET",
        severity: Severity.ErrorSev,
        lo,
        hi,
        message: msg,
    })
}

/// Extends `best` to the end of the LAST leaf under `children` -- the right
/// edge of a run, in source offsets.
///
/// It takes the current best and returns a bigger one instead of answering
/// "the last leaf, if any": a run always has at least the leaf its caller
/// already found, so absence is not a case here, and the monotone form needs
/// neither an Option nor an int sentinel. (The Option form was written first
/// and did not survive: `Option[Token]` -- a record inside an Option -- and a
/// mut local of `Option[int]` reassigned in a match arm BOTH miscompile under
/// the current oracle, the second one emitting Nova source text verbatim into
/// the C. Escalated separately; this shape does not need the feature at all.)
fn Checker @run_end_of(children []Node, best int) -> int {
    mut e = best
    for c in children {
        match c {
            Leaf(t) => { e = e.max(@src.offset_of(t.text) + t.text.byte_len()) }
            Branch { children: inner, .. } => { e = @run_end_of(inner, e) }
        }
    }
    e
}

/// Walk the tree and collect subset diagnostics.
///
/// init_pos: record constructors and match expressions are subset forms ONLY
/// in an initializer position — the direct init of a binding or the body of
/// an expression-bodied fn. The emitter's tmp-schemes have exactly those
/// shapes; anywhere else (argument, nested field value, condition, arm) the
/// form is an honest E_NOVAC_SUBSET, not an emitter ice later. The default
/// is the common case, so only the two places that actually open an
/// initializer position say so.
fn Checker mut @walk(n Node, init_pos bool = false) -> () {
    match n {
        Leaf(t) => @report_if_error_token(t)
        Branch { kind, children, .. } => {
            // ONE subject, ONE match (P31 p.2, owner 2026-08-17: "combine
            // several ifs into a match"). The chain this replaces had
            // fourteen `if kind == ...` in a row, each a decision about the
            // same value, and a node kind nobody handled fell through in
            // silence -- which is how four defects arrived this shift.
            //
            // Every NodeKind is listed, with no wildcard: adding a kind to
            // the tree now makes THIS match a compile error, and the author
            // has to say what the checker does about it. That is the whole
            // reason a match is worth more than a chain -- exhaustion is
            // machine-checked, not remembered.
            //
            // Arms that fall through to the generic walk below say `{}` and
            // the comment above covers why: the kind carries no rule of its
            // own, its children are walked like anyone else's.
            match kind {
                Err => {
                    @report_err_branch(children)
                    return
                }
                Block => @report_if_bad_call_stmt(children)
                MethodCall => {
                    @report_if_unknown_method(children)
                    @report_if_ordered_args(children)
                }
                Call => @report_if_ordered_args(children)
                FnDecl => {
                    @report_if_generic(children)
                    @report_if_tail_has_no_value(children)
                    @report_if_return_type_undeclared(children)
                }
                TypeDecl | SumDecl => @report_if_generic(children)
                ForStmt => @report_if_bad_for_head(children)
                Field => {
                    @report_if_missing_type(children, "outside the E1 subset: field must declare a type")
                }
                RetType => {
                    // The return type is a type reference too, and it was
                    // judged by nobody: `fn make() -> []int => 1` was ACCEPTED
                    // while the body returns an int literal (2026-08-17).
                    @report_if_return_form(children)
                }
                Param => {
                    @report_if_missing_type(children, "outside the E1 subset: parameter must declare a type")
                }
                RecordCtor => {
                    if !init_pos {
                        @report_first_leaf_of(children, "outside the E1 subset: record constructor only as a binding initializer")
                        return
                    } else {
                        // In initializer position the constructor is legal;
                        // its children are walked below like any other node.
                    }
                }
                ArrayLit => {
                    // Owner's rollback 2026-08-15: []int was taken as a
                    // hard-coded std instance (one seed row + C_VEC_INT_*
                    // constants) -- a K7 half-capability (novac 'knows'
                    // []int, silently not []str). Arrays return with generics
                    // through `mono` (E2-b); until then this is an honest
                    // subset refusal, not a fake take.
                    @report_first_leaf_of(children, "outside the subset: arrays arrive with generics (E2-b), not as one hard-coded instance")
                    return
                }
                MatchExpr => {
                    if !init_pos {
                        @report_first_leaf_of(children, "outside the E1 subset: match only as a binding initializer")
                        return
                    } else {
                        // Initializer position: legal, walked below.
                    }
                }
                BindStmt | FnExprBody => {
                    // The LAST child is the initializer, and only there are a
                    // record constructor and a match legal -- that is what
                    // `init_pos` carries.
                    mut i = 0
                    for c in children {
                        @walk(c, init_pos: i == children.len() - 1)
                        i += 1
                    }
                    return
                }
                LeafNode | File | ModuleDecl | Args | Bin | Lit | IfStmt | RetStmt => {}
                AssignStmt | WhileStmt | FieldAccess | CtorField | CtorSpread => {}
                Variant | MatchArm | Pattern | ArraySpread | Guard => {}
                Recv | Generics | Unary | Paren | Name => {}
            }
            for c in children {
                @walk(c)
            }
        }
    }
}

// No silent type defaults (owner's rule 2026-08-14, the #652 class: a
// quiet nova_int fallback bred a bug family in the current compiler). A
// shape with a missing type is refused HERE — the emitter's matching ice
// is the second floor, never the first answer.

/// [name, type-ident, ...] — the second child must be an Ident leaf. Whether
/// that identifier NAMES a type novac knows is judged in the typing walk, not
/// here: this pass also runs over recovered junk, and `fn main junk here ()`
/// would otherwise produce two diagnostics for one mistake (the Err branch's
/// and this one) — a cascade, which the no-cascade rule forbids.
fn Checker mut @report_if_missing_type(kids []Node, msg str) -> () {
    for c in kids {
        if c.kind_of() == NodeKind.Generics {
            @report_first_leaf_of(kids, TYPE_FORM_MSG)
            return
        }
    }
    if kids.len() >= 2 {
        match kids[1] {
            Leaf(t) => {
                if t.kind == TokenKind.Ident { return }
                // The parser reads the whole type reference now (owner
                // 2026-08-17: "a type can be more complex, generics for
                // instance"), so a slice, a qualifier or a function type
                // arrives here as its FIRST token instead of an identifier.
                // Saying "must declare a type" about `xs []int` is a lie --
                // the type is right there, it is the SHAPE that is not
                // compiled yet, and the message must say which.
                ro is_form = t.kind == TokenKind.LBracket ||
                t.kind == TokenKind.EmptyBrackets ||
                    t.kind == TokenKind.KwRo ||
                    t.kind == TokenKind.KwMut ||
                    t.kind == TokenKind.KwFn ||
                    t.kind == TokenKind.LParen
                if is_form {
                    @report_first_leaf_of(kids, TYPE_FORM_MSG)
                    return
                }
            }
            Branch { .. } => {}
        }
    } else {
        // Fewer than two children means there is no type slot to look at, so this
        // branch has nothing of its own to judge: the refusal just below is the
        // one answer for that shape, exactly as it is for a leaf of any other kind.
    }
    @report_first_leaf_of(kids, msg)
}

/// The SHAPE of a declared return type: `-> []int`, `-> Vec[T]`, `-> (a, b)`,
/// `-> fn(int) -> str` are read by the parser and refused by name here.
fn Checker mut @report_if_return_form(kids []Node) -> () {
    if kids.len() < 2 { return }
    // `-> Vec[int]`: the head is an identifier and the application arrives as
    // a Generics branch after it, so the leaf test below never sees it.
    for c in kids {
        if c.kind_of() == NodeKind.Generics {
            @report_first_leaf_of(kids, TYPE_FORM_MSG)
            return
        }
    }
    match kids[1] {
        Leaf(t) => {
            ro is_form = t.kind == TokenKind.LBracket ||
                t.kind == TokenKind.EmptyBrackets ||
                t.kind == TokenKind.KwRo ||
                t.kind == TokenKind.KwMut ||
                t.kind == TokenKind.KwFn ||
                t.kind == TokenKind.LParen
            if !is_form { return }
            @report_first_leaf_of(kids, TYPE_FORM_MSG)
        }
        Branch { .. } => {}
    }
}

/// A declared type whose SHAPE the subset does not compile yet -- a slice, a
/// tuple, a function type, a qualified type. The parser reads them all (plan
/// 9.4: the grammar is the language's, the subset is the checker's), so the
/// refusal names the shape instead of pretending the type is missing.
const TYPE_FORM_MSG = "outside the subset: this type form is not compiled yet (slices, tuples, fn types and qualifiers arrive with generics, E2-b)"


/// The head of a `for` must be a RANGE, and the subset says so out loud.
///
/// Found by the adversarial review of the operator wave, 2026-08-16: neither
/// check nor the emitter ever looked at the head's operator. `for i in 0 < 3`
/// and `for i in 1 + 3` were silently emitted as range loops (the emitter
/// reads children [0] and [2] and never [1]), and `for i in n` reached an ice.
/// The oracle refuses all three. This is the exact class P21 names -- a
/// dispatch that never happened is weaker than a wrong `else` -- and it is
/// the inverse of the ice that already guards `Range` in expression position.
fn Checker mut @report_if_bad_for_head(kids []Node) -> () {
    if kids.len() < 4 { return }
    ro head = kids[3]
    if head.kind_of() != NodeKind.Bin {
        @report_first_leaf_of(kids, "outside the subset: the head of a for must be a range `lo..hi`")
        return
    }
    ro hk = branch_children(head)
    if hk.len() < 3 { return }
    match bin_op_of(leaf_kind(hk[1])) {
        Range => {}
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => {
            @report_first_leaf_of(kids, "outside the subset: the head of a for must be a range `lo..hi`, not another binary operator")
        }
    }
}

/// One text for the two doors of the rule (an empty body and a statement
/// tail): the reader must not have to wonder whether they are two limits.
const TAIL_NO_VALUE_MSG = "fn declares a return type but its body ends without a value"

/// A fn that declares a value must END with one -- unless the end is
/// UNREACHABLE. The oracle started judging this on 2026-08-17 as
/// `E_MISSING_RETURN`, and novac accepted what it rejects (class K7).
///
/// The rule was mirrored crudely at first and the adversarial pass caught it
/// the same day: `fn f() -> int { return 1  <NL>  ro x = 2 }` was refused by
/// novac and accepted by the oracle. Both are right about their halves --
/// the tail IS a binding, and it is also DEAD, because an unconditional
/// `return` stands before it. A refusal that fires on correct code is a
/// defect even when it errs "towards strictness": it sends the reader to fix
/// what is not broken.
///
/// Boundary re-measured across fourteen shapes (2026-08-17). Refused: a
/// binding or assignment tail, and an empty body, WHEN no unconditional
/// terminator stands at the top level of the body. Accepted: a tail
/// expression, a `return`, an `if` whose branches return, a tail `while`/
/// `for`, and anything at all after an unconditional `return` -- the oracle
/// accepts each of these. A CONDITIONAL return does not save the tail
/// (`if c { return 1 }` then a binding is E_MISSING_RETURN for the oracle
/// too), which is why the scan looks at top-level statements only and does
/// not walk into branches.
fn Checker mut @report_if_tail_has_no_value(kids []Node) -> () {
    mut declares_value = false
    for c in kids {
        if c.kind_of() != NodeKind.RetType { continue }
        // `-> ()` parses as the arrow alone: the unit return declares no value.
        declares_value = declares_value || branch_children(c).len() > 1
    }
    if !declares_value { return }
    for c in kids {
        if c.kind_of() != NodeKind.Block { continue }
        ro bk = branch_children(c)
        mut last_stmt = -1
        mut i = 0
        mut terminates = false
        for b in bk {
            terminates = terminates || b.kind_of() == NodeKind.RetStmt
            last_stmt = if b.kind_of() == NodeKind.LeafNode { last_stmt } else { i }
            i += 1
        }
        // The end is unreachable: whatever stands last, it is dead code and
        // the oracle says nothing about it. Neither do we.
        if terminates { return }
        if last_stmt < 0 {
            @report_first_leaf_of([]Node.of(c), TAIL_NO_VALUE_MSG)
            return
        }
        // [LEGACY-#676] var-index-method: `bk[i].kind_of()` with a VARIABLE
        // index miscompiles -- the emitter takes the Vec itself for the
        // receiver (E_RECV_METHOD_MISMATCH). The binding walks around it and
        // goes when #676 closes.
        ro tail_node = bk[last_stmt]
        ro k = tail_node.kind_of()
        // ALLOW-list, and it mirrors the emitter's condition exactly
        // (emit_c.nv:454 `is_expr_kind(kind) && kind != Call`): the tail
        // produces a value iff the emitter writes `return` for it. The first
        // version asked the opposite question -- "is the tail a binding or an
        // assignment?" -- and four shapes walked past it: a tail `if` without
        // `else`, a tail `while`, a tail `for`, and a tail unit call like
        // `println(...)`. The oracle refuses all four; novac emitted a
        // function that falls off its end. Asking a deny-list about an open
        // set is how a rule looks complete while covering two cases of six.
        if k == NodeKind.RetStmt || (is_expr_kind(k) && k != NodeKind.Call) { return }
        @report_first_leaf_of([]Node.of(tail_node), TAIL_NO_VALUE_MSG)
        return
    }
}


/// Generic parameters are outside the subset -- and the refusal says so.
///
/// Until this wave the parser could not see `[T]`, so the signature derailed
/// and the user was told the return type was missing while it was written
/// right there. Class recorded in the divergence registry as "the refusal
/// names the consequence, not the cause": a diagnostic that misattributes
/// sends the reader to fix code that is correct. E2-b2 replaces this refusal
/// with monomorphisation; the node it needs is already parsed.
fn Checker mut @report_if_generic(kids []Node) -> () {
    for c in kids {
        if c.kind_of() == NodeKind.Generics {
            @report_first_leaf_of([]Node.of(c), GENERIC_MSG)
            return
        }
        if c.kind_of() != NodeKind.Recv { continue }
        for r in branch_children(c) {
            if r.kind_of() == NodeKind.Generics {
                @report_first_leaf_of([]Node.of(r), GENERIC_MSG)
                return
            }
        }
    }
}

/// Every fn except main must declare `-> T` in the subset.
fn Checker mut @report_if_return_type_undeclared(kids []Node) -> () {
    if kids.len() < 2 { return }
    match kids[1] {
        Leaf(t) => {
            if t.text == ENTRY_FN { return }
            for c in kids {
                match c {
                    Leaf(_) => {}
                    Branch { kind, .. } => { if kind == NodeKind.RetType { return } }
                }
            }
            @refuse(t, "outside the E1 subset: fn requires a declared return type")
        }
        Branch { .. } => {}
    }
}

/// One text for both doors (fn and type): the reader must not have to
/// wonder whether two wordings mean two different limits.
const GENERIC_MSG = "outside the E1 subset: generic parameters are not compiled yet (planned for E2-b2)"

/// Report `msg` at the first leaf found under `children` (depth-first).
fn Checker mut @report_first_leaf_of(children []Node, msg str) -> () {
    for c in children {
        match c {
            Leaf(t) => {
                @refuse(t, msg)
                return
            }
            Branch { children: inner, .. } => {
                ro before = @out.len()
                @report_first_leaf_of(inner, msg)
                if @out.len() > before { return }
            }
        }
    }
}

/// Does this subtree call anything? An argument that calls something is an
/// argument whose evaluation ORDER is observable.
fn contains_call(n Node) -> bool {
    match n {
        Leaf(_) => false
        Branch { kind, children, .. } => {
            if kind == NodeKind.Call || kind == NodeKind.MethodCall { return true }
            for c in children {
                if contains_call(c) { return true }
            }
            false
        }
    }
}

/// Two arguments that BOTH call something are two side effects whose order
/// the emitter does not fix: it prints the call straight into C, and C
/// leaves argument evaluation order unspecified at any calling convention.
/// Probe 2026-08-16 (finding F65): the oracle evaluates such a call
/// RIGHT-to-left, while the spec calls left-to-right normative and
/// observable. Until the emitter hoists arguments into temporaries in source
/// order, this is an honest subset refusal — the same choice the arrays
/// rollback made, and the opposite of quietly emitting order-dependent code.
/// One effectful argument is fine: a single effect has no order to get wrong.
fn Checker mut @report_if_ordered_args(kids []Node) -> () {
    mut effectful = 0
    for c in kids {
        if !is_expr_kind(c.kind_of()) { continue }
        if !contains_call(c) { continue }
        effectful += 1
    }
    if effectful < 2 { return }
    @report_first_leaf_of(kids, "outside the E1 subset: two arguments that both call something, and the emitter does not fix their order yet (F65)")
}

/// A CALL in statement position is `println` and nothing else in the subset.
/// Owner's question 2026-08-16 ("does every Call really become a println?"):
/// it did, and the emitter's ice was the FIRST answer for `helper()` as a
/// statement — the #652 class again, where the boundary belongs in check and
/// the ice is only the second floor. Expression-position calls are a
/// different question and go through the emitter's Call branch.
fn Checker mut @report_if_bad_call_stmt(stmts []Node) -> () {
    for st in stmts {
        match st {
            Leaf(_) => {}
            Branch { kind, children, .. } => {
                if kind != NodeKind.Call { continue }
                if call_callee_text(children) == PRINT_FN { continue }
                @report_first_leaf_of(children, "outside the E1 subset: a call in statement position is println only")
            }
        }
    }
}

/// MethodCall kids: [recv, '.', name, '(', args..., ')'] — the name leaf is
/// judged against the ONE subset table. An unknown method is an honest
/// E_NOVAC_SUBSET at the method name, not an emitter ice later. (The
/// receiver's TYPE is not judged here — the type checker is a later wave;
/// the named risk lives in the divergence registry next to #652.)
fn Checker mut @report_if_unknown_method(kids []Node) -> () {
    if kids.len() < 3 { return }
    match kids[2] {
        Leaf(t) => {
            // novac knows a method ONLY from declarations it has read
            // (П5: it does not know std names). At this stage there are
            // no locals yet, so the receiver's type is unknown and only
            // the name's existence is judged; the exact pair (receiver
            // type, name) is finding C9 of plan 274.3, wave 3.
            if @ctx.fns.has_name(t.text) { return }
            @refuse(t, "outside the subset: no such method in the declarations handed to novac (or the name is overloaded)")
        }
        Branch { .. } => {}
    }
}

/// An ErrorTok leaf is a lexer refusal: report it at its position.
fn Checker mut @report_if_error_token(t Token) -> () {
    if t.kind != TokenKind.ErrorTok { return }
    @refuse(t, "outside the E1 subset: unrecognized or context-dependent token")
}

/// An Err branch is ONE recovered mistake: one diagnostic at its first leaf.
fn Checker mut @report_err_branch(children []Node) -> () {
    // One Err branch — one diagnostic, at its FIRST leaf. The leaf can nest:
    // parse wraps a stray non-header module declaration as a whole ModuleDecl
    // branch inside Err (fuzzer catch 2026-08-14); the old flat scan found no
    // direct leaf there and reported NOTHING — a silent pass on a broken file.
    ro before = @out.len()
    for c in children {
        if @out.len() > before { return } // the one diagnostic is out already
        match c {
            Leaf(t) => {
                // The whole run is the subject, so the whole run is underlined.
                ro lo = @src.offset_of(t.text)
                ro hi = @run_end_of(children, lo + t.text.byte_len())
                @refuse_span(lo, hi, "outside the E1 subset: construct not in the MVP grammar")
                return
            }
            Branch { children: inner, .. } => @report_err_branch(inner)
        }
    }
}
