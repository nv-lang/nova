// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check — the E1 mini-checker (architecture §2: module `check`).
//
// The subset rule is ONE: everything the parser had to recover from is
// outside the E1 subset, and every such place is reported HONESTLY as
// E_NOVAC_SUBSET with its exact byte position — computed through the one
// position door (source.offset_of on the leaf's text slice). One Err branch
// produces exactly one diagnostic: no cascades by construction, which is what
// check-novac-no-cascade.sh will hold once fixtures exist.
//
// Poisoning discipline (§7): an Err branch is already-reported by definition;
// nothing else looks inside it. There is no permissive unknown here to
// swallow anything (the №652 lesson) — the subset checker either understands
// a node kind or reports it, an exhaustive match with no silent default.

module novac.check

import ../source.{SourceText}
import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind}
import ../diag.{Diagnostic, Severity}

/// Check a parsed file against the E1 subset. Always returns the full list;
/// no Result (274 §4 п.1).
export fn check(file Node, src SourceText) -> []Diagnostic {
    mut out = []Diagnostic.new()
    walk(file, src, out)
    out
}

/// The ONE table of subset methods (E2-strings wave). check owns the subset
/// knowledge; emit_c IMPORTS this door for its print dispatch (edge
/// `emit_c -> check` recorded in the architecture table the same commit).
/// Return codes mirror the emitter's tiny type lattice: 0=int 1=str 2=bool,
/// -1 = not in the subset (check reports it, the emitter never sees it).
export fn subset_method_ret(name str) -> int {
    if name == "byte_len" { return 0 }
    if name == "to_ascii_upper" { return 1 }
    if name == "starts_with" { return 2 }
    if name == "contains" { return 2 }
    // E2-arrays (demo.nv): []int methods. Codes 3/4 = "typed by the
    // receiver in sem" — this name-only table cannot say Vec's return
    // types; sem answers len -> int, get -> Option[int]. The receiver-keyed
    // method table that replaces this one is the E4 checker's job.
    if name == "len" { return 3 }
    if name == "get" { return 4 }
    -1
}

/// Walk the whole tree and collect subset diagnostics.
fn walk(n Node, src SourceText, mut out []Diagnostic) -> () {
    walk_in(n, src, out, false)
}

/// init_pos: record constructors and match expressions are subset forms ONLY
/// in an initializer position — the direct init of a binding or the body of
/// an expression-bodied fn. The emitter's tmp-schemes have exactly those
/// shapes; anywhere else (argument, nested field value, condition, arm) the
/// form is an honest E_NOVAC_SUBSET, not an emitter ice later.
fn walk_in(n Node, src SourceText, mut out []Diagnostic, init_pos bool) -> () {
    match n {
        Leaf(t) => report_if_error_token(t, src, out)
        Branch { kind, children } => {
            if kind == NodeKind.Err {
                report_err_branch(children, src, out)
                return
            }
            if kind == NodeKind.MethodCall { report_if_unknown_method(children, src, out) }
            if kind == NodeKind.FnDecl { report_if_missing_ret(children, src, out) }
            if kind == NodeKind.Field { report_if_missing_type(children, src, out, "outside the E1 subset: field must declare a type") }
            if kind == NodeKind.Param { report_if_missing_type(children, src, out, "outside the E1 subset: parameter must declare a type") }
            if kind == NodeKind.RecordCtor && !init_pos {
                report_first_leaf_of(children, src, out, "outside the E1 subset: record constructor only as a binding initializer")
                return
            }
            if kind == NodeKind.MatchExpr && !init_pos {
                report_first_leaf_of(children, src, out, "outside the E1 subset: match only as a binding initializer or an expression fn body")
                return
            }
            if kind == NodeKind.BindStmt || kind == NodeKind.FnExprBody {
                mut i = 0
                for c in children {
                    walk_in(c, src, out, i == children.len() - 1)
                    i += 1
                }
                return
            }
            for c in children {
                walk_in(c, src, out, false)
            }
        }
    }
}

// No silent type defaults (owner's rule 2026-08-14, the #652 class: a
// quiet nova_int fallback bred a bug family in the current compiler). A
// shape with a missing type is refused HERE — the emitter's matching ice
// is the second floor, never the first answer.

/// [name, type-ident, ...] — the second child must be an Ident leaf.
fn report_if_missing_type(kids []Node, src SourceText, mut out []Diagnostic, msg str) -> () {
    if kids.len() >= 2 {
        match kids[1] {
            Leaf(t) => { if t.kind == TokenKind.Ident { return } }
            Branch { .. } => {}
        }
    }
    report_first_leaf_of(kids, src, out, msg)
}

/// Every fn except main must declare `-> T` in the subset.
fn report_if_missing_ret(kids []Node, src SourceText, mut out []Diagnostic) -> () {
    if kids.len() < 2 { return }
    match kids[1] {
        Leaf(t) => {
            if t.text == "main" { return }
            for c in kids {
                match c {
                    Leaf(_) => {}
                    Branch { kind, .. } => { if kind == NodeKind.RetType { return } }
                }
            }
            ro lo = src.offset_of(t.text)
            out.push(Diagnostic {
                code: "E_NOVAC_SUBSET",
                severity: Severity.ErrorSev,
                lo,
                hi: lo + t.text.byte_len(),
                message: "outside the E1 subset: fn requires a declared return type",
            })
        }
        Branch { .. } => {}
    }
}

/// Report `msg` at the first leaf found under `children` (depth-first).
fn report_first_leaf_of(children []Node, src SourceText, mut out []Diagnostic, msg str) -> () {
    for c in children {
        match c {
            Leaf(t) => {
                ro lo = src.offset_of(t.text)
                out.push(Diagnostic {
                    code: "E_NOVAC_SUBSET",
                    severity: Severity.ErrorSev,
                    lo,
                    hi: lo + t.text.byte_len(),
                    message: msg,
                })
                return
            }
            Branch { children: inner, .. } => {
                ro before = out.len()
                report_first_leaf_of(inner, src, out, msg)
                if out.len() > before { return }
            }
        }
    }
}

/// MethodCall kids: [recv, '.', name, '(', args..., ')'] — the name leaf is
/// judged against the ONE subset table. An unknown method is an honest
/// E_NOVAC_SUBSET at the method name, not an emitter ice later. (The
/// receiver's TYPE is not judged here — the type checker is a later wave;
/// the named risk lives in the divergence registry next to #652.)
fn report_if_unknown_method(kids []Node, src SourceText, mut out []Diagnostic) -> () {
    if kids.len() < 3 { return }
    match kids[2] {
        Leaf(t) => {
            if subset_method_ret(t.text) < 0 {
                ro lo = src.offset_of(t.text)
                out.push(Diagnostic {
                    code: "E_NOVAC_SUBSET",
                    severity: Severity.ErrorSev,
                    lo,
                    hi: lo + t.text.byte_len(),
                    message: "outside the E1 subset: method not in the subset table",
                })
            }
        }
        Branch { .. } => {}
    }
}

/// An ErrorTok leaf is a lexer refusal: report it at its position.
fn report_if_error_token(t Token, src SourceText, mut out []Diagnostic) -> () {
    if t.kind == TokenKind.ErrorTok {
        ro lo = src.offset_of(t.text)
        out.push(Diagnostic {
            code: "E_NOVAC_SUBSET",
            severity: Severity.ErrorSev,
            lo,
            hi: lo + t.text.byte_len(),
            message: "outside the E1 subset: unrecognized or context-dependent token",
        })
    }
}

/// An Err branch is ONE recovered mistake: one diagnostic at its first leaf.
fn report_err_branch(children []Node, src SourceText, mut out []Diagnostic) -> () {
    // One Err branch — one diagnostic, at its FIRST leaf. The leaf can nest:
    // parse wraps a stray non-header module declaration as a whole ModuleDecl
    // branch inside Err (fuzzer catch 2026-08-14); the old flat scan found no
    // direct leaf there and reported NOTHING — a silent pass on a broken file.
    ro before = out.len()
    for c in children {
        if out.len() > before { return } // the one diagnostic is out already
        match c {
            Leaf(t) => {
                ro lo = src.offset_of(t.text)
                out.push(Diagnostic {
                    code: "E_NOVAC_SUBSET",
                    severity: Severity.ErrorSev,
                    lo,
                    hi: lo + t.text.byte_len(),
                    message: "outside the E1 subset: construct not in the MVP grammar",
                })
                return
            }
            Branch { children: inner, .. } => report_err_branch(inner, src, out)
        }
    }
}
