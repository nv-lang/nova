// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Go `types2` `*Checker` (one receiver holding pass state) + rustc `FnCtxt`
// for the walk; rustc `TyKind::Error(ErrorGuaranteed)` / Roslyn `IsErrorType`
// suppression for no-cascade (an Err branch is already reported, nothing looks
// inside); rustc keeps `TyCtxt` explicit (`ty::tls` only for diagnostics) —
// context is data, not an effect; Go `types2` `Checker.errorf` for the single
// `refuse` reporter; Donor: none for the subset refusals (init_pos for ctor/match,
// F65 ordered args, arrays rollback, statement-call = println only) — an honest
// E_NOVAC_SUBSET instead of a silently wrong emission (П27 p.3 class); NOT taken:
// rustc obligation solver (E2-b3), local typing in check (274.3 wave 3 / C9).
// Role: layer 7 — the subset judge; publishes diagnostics, will publish the type channel (resolved_types) at E2-b1
// tail.
// Used by: pipeline (E1+); the LSP at E3 reads its channel instead of re-walking; emit_c reads its verdicts, never
// re-derives.
// Guarded by: check-novac-no-cascade.sh, check-novac-diag-schema.sh, check-novac-differential.sh (verdicts match the
// oracle on the corpus), check-novac-no-default-branch.py (kind dispatch is exhaustive), the pipeline tests (one cause,
// one diagnostic).
// rustc `FnCtxt` for the walk shape; poisoning discipline from rustc
// `TyKind::Error` — an already-reported node yields nothing further; NOT taken:
// rustc's obligation solver (arrives with bounds, E2-b3).
// novac/src/check — the E1 mini-checker (architecture §2: module `check`).
//
// The subset rule is ONE: everything the parser had to recover from is
// outside the E1 subset, and every such place is reported HONESTLY as
// E_NOVAC_SUBSET with its exact byte position — computed through the one
// position door (source.offset_of on the leaf's text slice). One Err branch
// produces exactly one diagnostic: no cascades by construction, which is what
// check-novac-no-cascade.sh will hold once fixtures exist.
//
// Poisoning discipline (§7): an Err branch is already-reported by definition;
// nothing else looks inside it. There is no permissive unknown here to
// swallow anything (the №652 lesson) — the subset checker either understands
// a node kind or reports it, an exhaustive match with no silent default.

module novac.check

import ../source.{SourceText}
import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, NodeId, no_node, bin_op_of, un_op_of, raw_node}
import ../diag.{Diagnostic, Severity, ice}
import ../builtins.{ENTRY_FN, PRINT_FN, is_bool_literal, COERCE_ATTR, REALTIME_ATTR}
import ../sem.{Ctx, CheckOut, param_type_at, branch_children, call_callee_text, is_expr_kind, leaf_text, leaf_kind}
import ../sem.{expr_leaf_name, attr_kids_name, recv_type_name, is_value_record}
import ../types.{TyId, no_ty, is_ty}
import ../resolve.{FnIndex, FieldIndex}

/// State of one check run: the source (for positions), the semantic context
/// and the diagnostics collected so far. A receiver, not a triple of
/// parameters on every function — the shape of every reference (Go
/// `*Checker`, Roslyn `Binder`, rustc `FnCtxt`, Zig `*Sema`).
///
/// WHY NOT AN EFFECT (owner's question, 2026-08-16). Nova's effects model
/// CAPABILITIES and control — `Fs`, `Os`, `Fail`, `Supervisor`; the
/// compilation context is pure data. An ambient context (a) hides the data
/// flow, and the §3/§4 map rests on that flow being visible ("what flows
/// along the edge" is guarded), (b) pays a TLS-vtable cost on every read
/// in the hot `type_of` loop, under П14 "speed is priority #1", (c)
/// diverges from the references: rustc keeps `TyCtxt` explicit, and the
/// ambient `ty::tls` is left only for diagnostics and debugging.
type Checker {
    src SourceText /// the file text: the one source of positions
    ctx Ctx /// type registry and callable table, read from the declarations
    /// THE name index over ctx.fns (274.4 step 2): built here, held here, and
    /// nowhere else -- emit_c and mono get a Ctx and no index, so resolution
    /// after the checker is not merely forbidden, there is nothing to call.
    res FnIndex
    /// THE name index over ctx.fields (274.4 step 3): the same lock for the
    /// field root -- fields resolve only through a receiver type, and only
    /// the checker can ask.
    fres FieldIndex
    /// The FIRST gap seen in this file — a refusal whose run has zero width,
    /// that is, a token the grammar required and nobody wrote. Held rather
    /// than said at once: a gap points at nothing the author typed, so it is
    /// the LAST thing worth saying about a file, and only when nothing with
    /// width was said. `gap_at < 0` means none seen.
    gap_at int
    /// WHAT was wanted at `gap_at`, when the door that planted the gap knew.
    /// `TokenKind.ErrorTok` means it did not: gaps planted by recovery carry no
    /// expectation, and the refusal then says only that the text is not a form
    /// of the language -- the message this field exists to improve on (#850).
    gap_kind TokenKind
    out []Diagnostic /// diagnostics collected by this run
    chan CheckOut /// THE channel this run publishes: what the checker decided (sem.CheckOut)
    scope Scope /// locals of the function body being typed; reset per function
    /// One-entry table reused by the self-initializer check (274.3/F28). It is
    /// a FIELD and not a local because the lookup door must not build anything
    /// (P18/P14): a table allocated per binding turns an O(1) question into an
    /// allocation on the hot path of every `ro`/`mut` in the file.
    self_probe NameTable
    /// Top-level names already seen in THIS file (#811). sem cannot report --
    /// it holds no diagnostics -- and it silently keeps the FIRST declaration
    /// of a repeated name, so the second one has to be refused here or not at
    /// all. One table per run, the same shape `self_probe` is.
    seen_decls NameTable
    /// The instance's substitution: `substs[i]` is the concrete type standing
    /// in type-parameter slot `i`. EMPTY for an ordinary run over a file, and
    /// that emptiness is what tells `type_fn` to skip a generic body -- there
    /// is nothing to type it under. One copy of the body is typed per
    /// instance (Go stenciling), so nothing here is parametric afterwards.
    substs []TyId
    /// The ONE block whose tail call is a returned value: the body of the fn
    /// being walked, when that fn declares a return type (274.5 wave B4). Set
    /// by the FnDecl arm of each phase, read by the Block arm; there are no
    /// nested fns, so one slot is the whole state.
    tail_value_body NodeId
}

/// Check a parsed file against the E1 subset. Always returns the full list;
/// no Result (274 §4 item 1).
///
/// WHY THIS IS A FREE FUNCTION AND NOT A METHOD ON `Ctx` (owner's question,
/// 2026-08-16). `Ctx` is DATA — the type registry and the callable table.
/// Hanging a pass on it would make the registry own the pass, and then
/// `emit` would want to hang there too: `Ctx` becomes the object that knows
/// every backend, which is exactly the ownership the architecture keeps
/// apart (the rustc_middle model — `TyCtxt` holds data, passes consume it).
/// It would also invert an edge of the §3 table: `Ctx` lives in `sem`, so a
/// method on it would make `sem` reference `Diagnostic` and the checker,
/// and `check-novac-deps.py` refuses that edge by construction. What the
/// entry point IS, is a constructor plus a run — the same shape `emit_c`
/// uses for `Emitter`: the module has one door, and the receiver lives
/// behind it.
/// The channel comes back WITH the diagnostics, from ONE door: a second
/// entry point ("check, and this time also record") would be two passes
/// disagreeing about one file, which is the disease the channel cures.
///
/// The typing walk runs only on a CLEAN subset verdict. That is not a
/// convenience: the emitter's contract is already "never called on broken
/// input" (pipeline), the lattice remaining ices are user errors under
/// [LEGACY-#700-user-error-as-ice until:E2b3], and typing a file that the
/// subset already refused would turn a refusal into an ice. When #700 lands
/// the walk becomes unconditional, because then its answer on bad input is a
/// diagnostic and not a death.
export fn check(file Node, src SourceText, ctx Ctx) -> ([]Diagnostic, CheckOut) {
    mut c = Checker {
        src, ctx,
        res: FnIndex.build(ctx.fns),
        fres: FieldIndex.build(ctx.fields),
        gap_at: -1,
        gap_kind: TokenKind.ErrorTok,
        out: []Diagnostic.new(),
        chan: CheckOut.new(raw_node(file.id_of()) + 1),
        scope: Scope.new(), self_probe: NameTable.new(NamespaceId.NsLocals),
        seen_decls: NameTable.new(NamespaceId.NsDefs),
        tail_value_body: no_node(),
        substs: []TyId.new(),
    }
    c.walk(file)
    c.tell_gap_if_silent()
    if c.out.len() == 0 {
        // THE ENTRY IS A RESOLUTION (274.4 step 2): a name chain is walked to
        // find it, and after the checker nobody resolves -- mono reads the
        // channel instead of asking the registry itself.
        match c.res.entry_row(c.ctx.fns) {
            Some(r) => { c.chan.record_entry(r) }
            None => {
                // A file with no entry point: nothing to record, and mono
                // answers "nothing reachable" from the same silence.
            }
        }
        c.type_file(file)
        // The disjointness walk that stood here is gone (2026-08-18): the
        // channel holds ONE sum per node now, so "a call and an
        // instantiation at once" is not a state that can be built.
    } else {
        // A refused file is not typed: the walk's answer on broken input is an
        // ice today ([LEGACY-#700-user-error-as-ice until:E2b3]), so the refusals already
        // collected ARE the verdict, and the channel goes back as the walk left it.
    }
    (c.out, c.chan)
}

/// Type ONE declaration under a substitution -- one instance of a generic
/// callable (E2-b2; donor: Go stenciling, one copy of the body per instance,
/// each typed on its own).
///
/// WHY A SEPARATE CHANNEL. The channel is keyed by `NodeId`: one node, one
/// type. Two instances of one body cannot both live in it, and the alternative
/// -- keeping the body's types parametric and substituting in every reader --
/// spreads one decision across every consumer of the channel (P18). So each
/// instance gets its own channel, sized like the file's, and the emitter reads
/// the one belonging to the instance it emits.
///
/// `cap` is the file's node capacity, not the declaration's: node ids are
/// handed out per FILE, so a declaration's nodes sit anywhere in that range.
export fn check_instance(decl Node, src SourceText, ctx Ctx, substs []TyId, cap int) -> ([]Diagnostic, CheckOut)
    requires cap > 0, "check: an instance channel needs the file's node capacity"
{
    mut c = Checker {
        src, ctx,
        res: FnIndex.build(ctx.fns),
        fres: FieldIndex.build(ctx.fields),
        // SILENT-OK: an instance never TELLS its gap, and that is not an
        // omission. A gap is a syntax hole, and syntax was judged when the
        // FILE was checked -- by the time an instance is typed the same hole
        // has already been told there, or already suppressed there. Telling
        // it again would report one hole once per instantiation. The field is
        // still initialised so both entries share one shape; only
        // `tell_gap_if_silent` belongs to the file alone.
        gap_at: -1,
        gap_kind: TokenKind.ErrorTok,
        out: []Diagnostic.new(),
        chan: CheckOut.new(cap),
        scope: Scope.new(), self_probe: NameTable.new(NamespaceId.NsLocals),
        seen_decls: NameTable.new(NamespaceId.NsDefs),
        tail_value_body: no_node(),
        substs,
    }
    c.type_fn(decl)
    (c.out, c.chan)
}

/// Record one subset refusal at the token's exact bytes. THE one place that
/// knows the code, the severity and how a span is derived from a leaf — it
/// used to be copied into five reporters, so a change to the span rule had
/// five chances to be applied four times (owner's review 2026-08-16).
fn Checker mut @refuse(t Token, msg str) -> () {
    ro lo = @src.offset_of(t.text)
    @refuse_span(lo, lo + t.text.byte_len(), msg)
}

/// The same door with an EXPLICIT span, for a refusal whose subject is a run
/// of tokens rather than one (274.3/F24). A junk run of five tokens used to be
/// underlined at its first byte: the editor squiggle covered `%` and left the
/// other four looking accepted, which is a lie about what was rejected. The
/// span rule stays in ONE place -- the reason @refuse exists at all.
fn Checker mut @refuse_span(lo int, hi int, msg str) -> ()
    requires lo >= 0, "check: refusal span starts before the file"
    requires hi >= lo, "check: refusal span ends before it starts" {
    @out.push(Diagnostic {
        code: "E_NOVAC_SUBSET",
        severity: Severity.ErrorSev,
        lo,
        hi,
        message: msg,
    })
}

/// Extends `best` to the end of the LAST leaf under `children` -- the right
/// edge of a run, in source offsets.
///
/// It takes the current best and returns a bigger one instead of answering
/// "the last leaf, if any": a run always has at least the leaf its caller
/// already found, so absence is not a case here, and the monotone form needs
/// neither an Option nor an int sentinel. (The Option form was written first
/// and did not survive: `Option[Token]` -- a record inside an Option -- and a
/// mut local of `Option[int]` reassigned in a match arm BOTH miscompile under
/// the current oracle, the second one emitting Nova source text verbatim into
/// the C. Escalated separately; this shape does not need the feature at all.)
fn Checker @run_end_of(children []Node, best int) -> int {
    mut e = best
    for c in children {
        match c {
            Leaf(t) => { e = e.max(@src.offset_of(t.text) + t.text.byte_len()) }
            Branch { children: inner, .. } => { e = @run_end_of(inner, e) }
        }
    }
    e
}

/// Walk the tree and collect subset diagnostics.
///
/// init_pos: record constructors and match expressions are subset forms ONLY
/// in an initializer position — the direct init of a binding or the body of
/// an expression-bodied fn. The emitter's tmp-schemes have exactly those
/// shapes; anywhere else (argument, nested field value, condition, arm) the
/// form is an honest E_NOVAC_SUBSET, not an emitter ice later. The default
/// is the common case, so only the two places that actually open an
/// initializer position say so.
fn Checker mut @walk(n Node, init_pos bool = false, stmt_pos bool = false, arg_pos bool = false) -> () {
    match n {
        Leaf(t) => @report_if_error_token(t)
        Branch { kind, children, .. } => {
            // ONE subject, ONE match (P31 p.2, owner 2026-08-17: "combine
            // several ifs into a match"). The chain this replaces had
            // fourteen `if kind == ...` in a row, each a decision about the
            // same value, and a node kind nobody handled fell through in
            // silence -- which is how four defects arrived this shift.
            //
            // Every NodeKind is listed, with no wildcard: adding a kind to
            // the tree now makes THIS match a compile error, and the author
            // has to say what the checker does about it. That is the whole
            // reason a match is worth more than a chain -- exhaustion is
            // machine-checked, not remembered.
            //
            // Arms that fall through to the generic walk below say `{}` and
            // the comment above covers why: the kind carries no rule of its
            // own, its children are walked like anyone else's.
            match kind {
                Err => {
                    @report_err_branch(children)
                    return
                }
                // A block used to be judged for ONE thing here -- a call in
                // statement position that was not `println`. Wave B12 made
                // that a form of the language, so the arm has nothing of its
                // own to say and the children are walked like anyone else's.
                Block => {}
                MethodCall => {
                    @report_if_unknown_method(children)
                    @report_if_ordered_args(children)
                }
                Call => @report_if_ordered_args(children)
                FnDecl => {
                    if @report_if_extern_decl(children) {
                        // The whole FORM is refused, so the rules below have
                        // nothing left to judge: they ask about the return type
                        // and the tail of a declaration novac will not compile,
                        // and the walk of the children would name every unknown
                        // FFI type on top of that. One cause, one diagnostic.
                        return
                    } else {
                        // An ordinary declaration: the three shape rules below
                        // are its business as before.
                    }
                    // A METHOD ON A VALUE RECORD, refused by name. The fixed
                    // point takes such a receiver BY POINTER (`NovaValue_X*` in
                    // the shell it emits) precisely so a `mut` method can write
                    // to the caller's record; novac passes a value receiver by
                    // VALUE, which is what the word means everywhere else in its
                    // emission -- so `@field` through it does not address
                    // anything. clang said it first ("member reference type
                    // 'NovaValue_Counter' ... is not a pointer"), and a form we
                    // accept and then fail to compile is the class a named
                    // refusal exists to prevent.
                    if is_value_record(@ctx, @ctx.ty_of_name(recv_type_name(children) ?? "") ?? no_ty()) {
                        @report_first_leaf_of(children, VALUE_METHOD_MSG)
                        return
                    } else {
                        // A free function, or a method on a pointer record.
                    }
                    @tail_value_body = value_body_of(children)
                    @report_if_default_order(children)
                    @report_if_generic_decl(children)
                    @report_if_tail_has_no_value(children)
                    @report_if_return_type_undeclared(children)
                }
                ConstDecl => {
                    // A CONSTANT IS JUDGED BY ITS INITIALIZER, and the walk
                    // has nothing of its own to refuse here: the name goes
                    // into the registry at collection, the type comes from
                    // the initializer at the point of USE (274.5 wave B2),
                    // and an initializer the subset cannot compile is refused
                    // where it is used, with the position the user can see.
                }
                TypeDecl | SumDecl => {
                    // ONE NAME, ONE DECLARATION (#811): a repeat is refused
                    // here because sem keeps the FIRST body and drops the
                    // second in silence -- the program then reads as though
                    // the second were never written, and a constructor
                    // resolves against a body its author did not mean.
                    @report_if_name_repeats(children)
                    // A PROTOCOL DECLARATION IS JUDGED, NOT REFUSED (wave 3b).
                    // Wave 3a refused it by name -- honest while nothing could
                    // check a contract; now the registry holds the required
                    // signatures and the call site filters by them, so refusing
                    // the declaration would refuse every correct program that
                    // declares one. The three wrong answers this line went
                    // through are kept in the module test: "not a form of the
                    // language", then silent acceptance, then a named refusal.
                    // A generic TYPE is not in the subset at all: position
                    // first, so a misplaced form is named as misplaced.
                    @report_if_misplaced_generics(children)
                    @report_if_generic_form(children)
                }
                ForStmt => {
                    @report_if_bad_for_head(children)
                    // The head is walked SEPARATELY, skipping index 3: a range
                    // is legal there and nowhere else in the subset, and the
                    // rule below would otherwise refuse the very form this
                    // statement exists for.
                    mut i = 0
                    for c in children {
                        if i != 3 {
                            @walk(c)
                        } else {
                            // Index 3 is the HEAD, and a range is legal
                            // only there: walking it would hand it to the
                            // rule that refuses ranges as values.
                        }
                        i += 1
                    }
                    return
                }
                Field => {
                    @report_if_missing_type(children, "outside the E1 subset: field must declare a type")
                }
                RetType => {
                    // The return type is a type reference too, and it was
                    // judged by nobody: `fn make() -> []int => 1` was ACCEPTED
                    // while the body returns an int literal (2026-08-17).
                    @report_if_qualifier_misplaced(children, "result")
                    @report_if_return_form(children)
                }
                IfExpr => {
                    @report_first_leaf_of(children, IF_EXPR_MSG)
                    return
                }
                SelfField => {
                    // Judged, not refused (wave 3g): the receiver is a binding
                    // (`@`) and `@field` is a field access on it. Outside a
                    // method that binding does not exist, and the TYPER names
                    // that -- refusing here would refuse the legal case too.
                }
                ImportDecl => {
                    // THE FORM IS READ, not refused (2026-08-23). What an import
                    // BRINGS still has to resolve -- a name no declaration
                    // answers is refused at its USE, by name, exactly as before.
                    // What changed is that the file after the import is no longer
                    // swallowed: the refusal used to be the first of a cascade
                    // whose rest said nothing (29 of novac's own 34 files).
                    //
                    // The ALIAS is the one part still refused: it is a statement
                    // about identity (section 9.1d point 2), and there is nothing to
                    // point it at until cross-file resolution lands.
                    if import_renames(children) {
                        @report_first_leaf_of(children, IMPORT_ALIAS_MSG)
                    } else {
                        // A plain import: nothing here to judge.
                    }
                    // The FORM is not judged, but a GAP inside it still has to
                    // be seen: `import` with no path at all parsed clean and
                    // compiled with exit code 0 (registry #815, probe
                    // `import_no_path`). This arm ends the walk, so the
                    // question is asked here or nowhere.
                    //
                    // ONLY THE Err CHILDREN, and the difference is a defect I
                    // shipped closing #815. `@report_err_branch` takes the
                    // children of an Err BRANCH -- "one Err branch, one
                    // diagnostic at its FIRST leaf" -- and this arm handed it
                    // the children of a HEALTHY import. The first leaf of an
                    // import is the keyword, which has width, so the
                    // width-bearing path fired every time: every `import` in
                    // every file was refused as "not a form of the language".
                    // Measured on novac's own source: the first refusal of 28
                    // of its 57 files was their import line.
                    for c in children {
                        if c.kind_of() == NodeKind.Err {
                            @report_err_branch(branch_children(c))
                        } else {
                            // The import's own tokens. This arm does not judge
                            // the form, and saying so is the whole point above.
                        }
                    }
                    return
                }
                ExportDecl => {
                    // JUDGED BY ITS CONTENTS, not refused (2026-08-23). Inside
                    // ONE compilation unit `export` says nothing novac has to
                    // act on -- it is what makes a name reachable from ANOTHER
                    // module, and that question arrives with `import`. Refusing
                    // the wrapper refused the declaration under it, which is how
                    // four of novac's own files stopped at their first line.
                    // The walk continues into the children below.
                }
                AttrDecl => {
                    // TWO attributes are read (274.5 wave B6). `#coerce` is
                    // JUDGED: it declares a PAIR (D429) the collector reads.
                    // `#realtime` (with or without `nogc`) is READ AND NOT
                    // ENFORCED: the guarantee is about what a body may call,
                    // the subset compiles no effect machinery, and the oracle
                    // -- measured 2026-08-29 on an allocating body -- does not
                    // enforce it on these shapes either. Any OTHER attribute
                    // stays outside the subset: an unknown attribute may
                    // change what the declaration means, and accepting it
                    // unread is how a subset becomes WIDER than the language.
                    if attr_kids_name(children, COERCE_ATTR) {
                        // The pair attribute: the collector owns it.
                    } else if attr_kids_name(children, REALTIME_ATTR) {
                        // Read, not enforced [INV-GUARD: check-novac-differential]
                        // -- the corpus compares OUTCOMES against the oracle on
                        // every file, so the day the oracle starts policing the
                        // guarantee, this decision reddens there. See the doc of
                        // REALTIME_ATTR for the measurement behind it.
                    } else {
                        @report_first_leaf_of(children, ATTR_MSG)
                    }
                    return
                }
                TestDecl => {
                    // READ, not refused wholesale (274.5 B10). A `test` block
                    // is a name and a body, and the body is statements like
                    // any other -- refusing the whole block hid every mistake
                    // inside it behind one diagnostic.
                    //
                    // Not emitting it is CORRECT rather than a silent drop,
                    // and that is the oracle's behaviour, not an argument:
                    // `nova build` leaves test bodies out of the program and
                    // `nova test` is what runs them. So the emitter's loop
                    // skipping a TestDecl matches, and what was actually
                    // missing was the READING -- which is the whole subject of
                    // sub-plan 274.5.
                    //
                    // The walk continues into the children below.
                }
                NamedArg => {
                    // JUDGED, NOT REFUSED (wave 4): `f(by: 2)` is how D102 says
                    // a defaulted parameter is reached, so the form is in the
                    // subset. Whether THIS name is a parameter of THAT callable
                    // is a question about the binding, and resolution answers it
                    // by name -- refusing the shape here would refuse the legal
                    // call along with the wrong one.
                }
                Cast => {
                    // NOT refused by SHAPE any more: whether a cast is inside
                    // the subset depends on the operand's TYPE -- unwrapping a
                    // newtype into its representation is the one legal case,
                    // and only typing knows the type. The refusal moved there
                    // (`type_cast`), which is also where the reason can be
                    // named instead of the whole form being turned away.
                }
                Param => {
                    // The two forms below are refused whole, and the rules
                    // after them are skipped on purpose: a variadic already
                    // carries a slice type, so the type-form rule would add a
                    // second diagnostic about the same parameter.
                    if has_variadic_mark(children) {
                        @report_first_leaf_of(children, VARIADIC_MSG)
                        return
                    } else {
                        // Not a variadic: judged as an ordinary parameter.
                    }
                    // The default's FORM is in the subset (wave 4); what is
                    // judged is its EXPRESSION, and the ORDER rule belongs to
                    // the declaration and is asked there. A refused default
                    // STOPS the walk: typing its expression would name a second
                    // cause for one mistake.
                    if @report_if_default_not_value(children) {
                        return
                    } else {
                        // No default, or one the subset takes.
                    }
                    @report_if_qualifier_misplaced(children, "parameter")
                    @report_if_missing_type(children, "outside the E1 subset: parameter must declare a type")
                }
                RecordCtor => {
                    // AN ARGUMENT IS A LEGAL POSITION TOO (wave B13). The
                    // emitter builds a constructor into a numbered temporary
                    // and reads the temporary where the value is wanted, which
                    // is exactly what an array literal has done since B8 -- so
                    // `arg_pos` is answered here the same way `ArrayLit`
                    // answers it a few arms below.
                    if !init_pos && !arg_pos {
                        @report_first_leaf_of(children, "outside the E1 subset: record constructor only as a binding initializer or a call argument")
                        return
                    } else {
                        // Initializer or argument: legal, and the children are
                        // walked below like any other node's.
                    }
                }
                DepthErr => {
                    // NAMED, not generic (#807/#808): the form is legal Nova
                    // that simply nests deeper than the compiler reads. The
                    // limit and the wording are the oracle's, because they are
                    // normative there (E_NESTING_TOO_DEEP) -- a subset that
                    // invented its own number would refuse what the language
                    // accepts. ONE diagnostic for the whole over-deep run: the
                    // parser drained it into this single node.
                    @report_first_leaf_of(children, NESTING_TOO_DEEP_MSG)
                    return
                }
                Unsafe => {
                    // READ, and refused BY NAME (274.5 B10). The parser gives
                    // `unsafe { ... }` its own node now, so the refusal finally
                    // names the form: before this, one line produced TWO wrong
                    // refusals -- a syntax error plus a record-constructor
                    // complaint -- and neither said `unsafe`.
                    //
                    // Compiling it is not this wave: the emitter has no arm for
                    // it, and letting the form through check while emission
                    // drops it is the silent-acceptance class this compiler
                    // keeps closing (#809, #812, #815).
                    @report_first_leaf_of(children, UNSAFE_MSG)
                    return
                }
                Index => {
                    // NOT TYPED HERE (fix 2026-08-31). This walk judges the
                    // FORM of a file against the subset; it holds no scope --
                    // the word `@scope` does not appear in this file once --
                    // and `@type_index` reads one. So typing an index here
                    // asked an empty scope and answered "unknown name" about a
                    // name that WAS bound: `ro v = xs` was clean while
                    // `ro v = xs[0]` refused, and `xs.len()` was clean too.
                    //
                    // The arm now lives in the typing pass (`exprs.nv`), where
                    // `@type_fn` has already bound the parameters. The door
                    // itself is not split: the subset refusals it carries
                    // (a receiver that is not an application, an index that is
                    // not `int`, a type applied to arguments) are part of the
                    // same one question and travel with it.
                }
                ArrayLit => {
                    // JUDGED, not refused wholesale (sub-plan L, 2026-08-26).
                    // The owner's rollback of 2026-08-15 stands: no hard-coded
                    // instance -- the element type is resolved like any other
                    // and the SHELL'S surface, read as an input, decides whether
                    // the instance can be built. Initializer position only, the
                    // same threshold the record constructor has.
                    // Three legal positions since wave B8: an initializer, a
                    // call argument, and a constructor field -- the census
                    // counted 12 field carriers and 9 argument carriers in
                    // novac's own sources, and zero bare tails or assignments,
                    // so those two stay out by measurement, not symmetry.
                    if !init_pos && !arg_pos {
                        @report_first_leaf_of(children, "outside the E1 subset: array literal only as an initializer, a call argument, or a constructor field")
                        return
                    } else {
                        // A legal position; typing judges the elements and
                        // the shell's surface.
                    }
                }
                MatchExpr => {
                    // Three legal positions since 274.5 wave B5: a binding
                    // initializer, a STATEMENT (a direct child of a block --
                    // the arms run for effect), and through init_pos also the
                    // tail of a value body (`=>` bodies took it earlier; the
                    // `{...}` tail is a statement position plus the typing
                    // route of wave B4's tail machinery).
                    if !init_pos && !stmt_pos {
                        @report_first_leaf_of(children, "outside the E1 subset: match only as an initializer, a statement, or a body tail")
                        return
                    } else {
                        // A legal position: walked below.
                    }
                }
                BindStmt => {
                    // A plain binding is FOUR children -- keyword, name,
                    // `=`, initializer -- so a declared type makes it five.
                    // Written as `> 3` at first, the rule fired on every
                    // ordinary binding in the language and reported a
                    // declared type where none was written. Counting is a
                    // measurement too, and this one went unmeasured.
                    if children.len() > 4 {
                        @report_first_leaf_of(children, TYPED_LOCAL_MSG)
                        return
                    } else {
                        // No declared type: the ordinary binding.
                    }
                    mut i = 0
                    for c in children {
                        @walk(c, init_pos: i == children.len() - 1)
                        i += 1
                    }
                    return
                }
                FnExprBody => {
                    // The LAST child is the initializer, and only there are a
                    // record constructor and a match legal -- that is what
                    // `init_pos` carries.
                    mut i = 0
                    for c in children {
                        @walk(c, init_pos: i == children.len() - 1)
                        i += 1
                    }
                    return
                }
                Lit => {
                    // MAGNITUDE FIRST (#810): a literal too large for `int`
                    // is a silent miscompile downstream -- the emitter prints
                    // its text with an `LL` suffix and C wraps it -- so the
                    // refusal comes before anything else this literal could
                    // be judged for.
                    @report_if_int_too_large(children)
                    @report_if_bad_escape(children)
                    // `"n=${n}"` reaches the tree as ONE literal leaf -- the
                    // lexer keeps the string whole -- so the interpolation is
                    // found in its text and named here.
                    @report_if_interpolated(children)
                }
                Variant => {
                    // A record-form variant carries a brace run among its
                    // leaves; the ordinary variant does not.
                    @report_if_record_variant(children)
                }
                Bin => {
                    // F35: `ro a = 0..3` used to reach an ice ("a range is not
                    // an expression outside a for-head"). It is legal Nova --
                    // the oracle accepts it -- so the subset refuses it BY NAME
                    // instead of dying on it. Inside a for-head the walk never
                    // gets here: that arm walks its children itself.
                    @report_if_range_outside_for(children)
                }
                LeafNode | File | ModuleDecl | Args | IfStmt | RetStmt => {}
                AssignStmt | WhileStmt | FieldAccess | CtorField | CtorSpread => {}
                MatchArm | Pattern | ArraySpread | Guard => {}
                Recv | Generics | Unary | Paren | Name => {}
                // A protocol's signatures are judged together with the
                // declaration (refused by name until the predicate lands),
                // so walking into them would report the same thing twice.
                ProtoMethod => {}
            }
            for c in children {
                // STATEMENT POSITION is "a direct child of a Block" (274.5
                // wave B5) and ARGUMENT POSITION is "a direct child of a call
                // or a constructor field" (wave B8): both flags are computed
                // in this ONE recursion, the same way init_pos is computed at
                // its two call sites -- a position has a single definition.
                @walk(c, stmt_pos: kind == NodeKind.Block,
                      arg_pos: kind == NodeKind.Call || kind == NodeKind.MethodCall ||
                               kind == NodeKind.CtorField)
            }
        }
    }
}

// No silent type defaults (owner's rule 2026-08-14, the #652 class: a
// quiet nova_int fallback bred a bug family in the current compiler). A
// shape with a missing type is refused HERE — the emitter's matching ice
// is the second floor, never the first answer.
