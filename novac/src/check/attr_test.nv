// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check/attr_test.nv -- the E.12 wave of 274.11 (charter
// 2026-11-18): declaration attributes WITHOUT behaviour are read and ignored,
// and an attribute outside the known set is refused by its own class text.
//
// WHY IT IS A WAVE OF ITS OWN: the refusal `ATTR_MSG` used to call every such
// attribute an "effect attribute", which is false for the carriers -- the
// aggregator's three inputs read `#stable(since = ...)`, a freeze marker with
// no compiled behaviour (D460), and `#doc` is documentation metadata
// (D101/D105). The oracle accepts both on a module and on a `fn` (measured
// 2026-11-18, oracle 0.1.5); the subset refused them one layer later.
//
// Donor: none -- D460 and D101/D105 are the norm; the test shape follows
//   check/check_test.nv.
// Guarded by: check-novac-module-tests.sh.
module novac.check

import ../source.{SourceText}
import ../lex.{lex}
import ../parse.{parse}
import ../sem.{collect, InteropTable}
import ../tree.{Node}

/// The FIRST diagnostic's message for `text`, or "" when the text is clean.
fn dat_first_msg(text str) -> str {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro (diags, _) = check(tree, src, collect(tree, []Node.new(), InteropTable.new()))
    if diags.len() == 0 { return "" }
    diags[0].message
}

test "decl-attr: #stable on a module is read and ignored" {
    ro src = "#stable(since = \"0.1\")\nmodule m\n\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: #stable on a fn is read and ignored" {
    ro src = "module m\n\n#stable(since = \"0.1\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: an unknown attribute is refused by the CLASS text" {
    ro src = "module m\n\n#sparkle\nfn f() -> int => 1\n"
    ro m = dat_first_msg(src)
    assert(m.contains("a declaration attribute outside the set the subset reads"), m)
    assert(m.contains("#stable"), m)
}

test "decl-attr: control -- #impl(Deserialize) keeps its own refusal" {
    ro src = "module m\n\n#impl(Deserialize)\ntype T value { n int }\n"
    ro m = dat_first_msg(src)
    assert(m.contains("not synthesized yet"), m)
}

// THE ACCEPTANCE FINDINGS (2026-11-18, independent review): the canonical
// string form of D101 must parse; typed arguments must be validated, not just
// the attribute name; and the name question must read the OWN name only.
test "decl-attr: the module form `#doc \"text\"` parses and is accepted" {
    ro src = "#doc \"module docs\"\nmodule m\n\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: #stable(since = 123) is refused -- a string literal is the form" {
    ro src = "module m\n\n#stable(since = 123)\nfn f() -> int => 1\n"
    ro m = dat_first_msg(src)
    assert(m.contains("string literal"), m)
}

test "decl-attr: #doc(summary = 123) is refused -- a string literal is the form" {
    ro src = "module m\n\n#doc(summary = 123)\nfn f() -> int => 1\n"
    ro m = dat_first_msg(src)
    assert(m.contains("string literal"), m)
}

test "decl-attr: the name question reads the OWN name -- #unstable stable is not #stable" {
    ro src = "module m\n\n#unstable stable\nfn f() -> int => 1\n"
    ro m = dat_first_msg(src)
    assert(m.contains("a declaration attribute outside the set the subset reads"), m)
}


// THE FULL MALFORMED MATRIX of the second acceptance (2026-11-18).

test "decl-attr: malformed s1 is refused" {
    ro src = "module m\n\n#stable(123)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s2 is refused" {
    ro src = "module m\n\n#stable(true)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s3 is refused" {
    ro src = "module m\n\n#stable(1 + 2)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s4 is refused" {
    ro src = "module m\n\n#stable(since = \"0.1\", 123)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s5 is refused" {
    ro src = "module m\n\n#stable(since = 123, \"0.1\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s6 is refused" {
    ro src = "module m\n\n#stable(= \"0.1\" since)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s7 is refused" {
    ro src = "module m\n\n#stable(since = \"0.1\" + \"0.2\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed s8 is refused" {
    ro src = "module m\n\n#stable(feature = \"x\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d1 is refused" {
    ro src = "module m\n\n#doc(sparkle)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d2 is refused" {
    ro src = "module m\n\n#doc(summary)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d3 is refused" {
    ro src = "module m\n\n#doc(sparkle = \"x\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d4 is refused" {
    ro src = "module m\n\n#doc(summary = 123, \"padding\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d5 is refused" {
    ro src = "module m\n\n#doc(summary = \"x\", section = 123, \"padding\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d6 is refused" {
    ro src = "module m\n\n#doc(summary \"x\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d7 is refused" {
    ro src = "module m\n\n#doc(summary = \"x\" + 123)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d8 is refused" {
    ro src = "module m\n\n#doc inline\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: malformed d9 is refused" {
    ro src = "#doc \"".concat("$").concat("{123}\"").concat("\nmodule m\n\nfn f() -> int => 1\n")
    assert(dat_first_msg(src) != "", src)
}

test "decl-attr: legal l1 is accepted" {
    ro src = "#stable\nmodule m\n\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: legal l2 is accepted" {
    ro src = "module m\n\n#stable(since = \"0.1\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: legal l3 is accepted" {
    ro src = "#doc \"module docs\"\nmodule m\n\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: legal l4 is accepted" {
    ro src = "#doc \"\"\nmodule m\n\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: legal l5 is accepted" {
    ro src = "module m\n\n#doc(summary = \"text\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: legal l6 is accepted" {
    ro src = "module m\n\n#doc(section = \"Name\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
