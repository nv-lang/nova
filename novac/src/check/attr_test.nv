test "decl-attr: legal l7 is accepted" {
    ro src = "module m\n\n#doc(test_handlers = \"my.handlers\")\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
}

test "decl-attr: legal l8 is accepted" {
    ro src = "module m\n\n#doc(inline)\nfn f() -> int => 1\n"
    assert(dat_first_msg(src) == "", dat_first_msg(src))
