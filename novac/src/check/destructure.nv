// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_hir_typeck` handling of an irrefutable `let` pattern --
// the pattern is judged against the scrutinee's type and each binder gets its
// type from the place it names; NOT taken: its match-arm exhaustiveness
// machinery, because an irrefutable binding has one arm and building a tree
// for it would be a mechanism with no question (K7).
// Role: layer 4 -- the checker's judgment of a DESTRUCTURING binding. The
//   pattern is read by the ONE grammar door (`@pattern()`, D486) and judged
//   by the ONE recursive binder (`@bind_pattern`, match_arms.nv); what is
//   left HERE is the position's own predicate (D486 §4): a binding takes an
//   irrefutable pattern only, because it has no `else` for a failed match.
// Used by: check/typing.nv -- the statement walk, on NodeKind.DestructureBind.
// Guarded by: check-novac-differential.sh (corpus carrier
//   destructure_record.nv), the subset_test.nv holder, and
//   check-novac-second-door.py (the SHAPE question lives once, in sem).
//
// Split out of typing.nv on 2026-09-04; re-seamed on 2026-09-29 (wave P2b of
// plan 274.5): the two flat readings (round-by-position, brace-by-name) died
// with the flat tree they walked, and the file keeps only what the position
// adds over the shared judgment -- irrefutability and the no-cascade binds.

module novac.check

import ../tree.{Node, NodeKind}
import ../sem.{branch_children, bind_mode_at, pattern_shape, pattern_head_text}
import ../sem.{pattern_subpatterns, pattern_fields, patfield_name, patfield_sub}
import ../sem.{pattern_name_node, patfield_name_node}
import ../sem.{ParamMode}
import ../types.{TyId, no_ty, is_ty}

/// The POSITION's refusal (D486 §4, E_REFUTABLE_BINDING): a variant, a
/// literal, an array or a disjunction can fail to match, and a binding has
/// no `else` to take the failure down. The text carries D486's own
/// diagnostic code -- the rule is the language's, so the code the reader
/// searches for has to be the language's too (the DESTR_NO_FIELD lesson).
const REFUTABLE_BINDING_MSG = "a destructuring binding takes an irrefutable pattern -- this form can fail to match, and a binding has no `else` (D486 §4, E_REFUTABLE_BINDING)"

/// D411's `..` rule, shared by the record-pattern judgment (match_arms.nv)
/// and this position. The counts are IN the text because the reader has to
/// know how far off the pattern is without counting fields by hand -- the
/// oracle names them too, and a refusal that says only "some" sends the
/// reader to the declaration (D420).
fn destr_needs_rest_msg(named int, total int) -> str =>
    "record-pattern binding lists ${named} of ${total} field(s) without `..` (D411, E_RECORD_PATTERN_NEEDS_REST)"

/// A destructuring binding `ro (a, b) = expr` / `ro { x, .. } = e`: the
/// initializer is typed first, the pattern is judged against its type by the
/// ONE door (`@bind_pattern`), under the position's own predicate. The
/// binding's mode word is the DEFAULT for binders without their own
/// (D486 §4's single mode rule: `ro (mut a, b)` overrides per binder).
fn Checker mut @type_destructure_bind(st Node) -> () {
    ro kids = branch_children(st)
    ro init = kids[kids.len() - 1]
    ro before = @out.len()
    match init {
        Leaf(_) => {
            // SILENT-OK: a recovery shape -- the parser could not read an
            // initializer, and the gap it planted already says what was
            // expected; a second report here would be the cascade.
            return
        }
        Branch { .. } => @type_expr(init)
    }
    if @out.len() > before { return }
    ro pt = type_of(init, @ctx, @scope, @chan)
    // RECORDED, not merely computed (the FieldAccess lesson): the emitter
    // reads the initializer node through the strict door to spell the
    // temporary, and the lattice answer above is not a record.
    @record(init, pt)
    ro pat = kids[1]
    if pat.kind_of() != NodeKind.Pattern {
        // SILENT-OK: a recovery gap stands where the pattern should be --
        // the parser's own marker already said what was expected here.
        return
    }
    // THE POSITION'S PREDICATE (D486 §4) is judged by `@bind_pattern` at every
    // node (PatPos.PosBind, registry 1379): the root-only check that stood here
    // let `ro (a, Some(b)) = p` through. A refusal binds the names untyped below.
    if !@bind_pattern(pat, pt, kids, bind_mode_at(kids), PatPos.PosBind) {
        // The shared judgment refused (a wrong scrutinee shape, an arity or
        // field disagreement); the binds below keep the uses from cascading
        // over the one mistake it already named.
        @bind_names_untyped(pat)
    } else {
        // Every name bound with its decided type, recorded on its node.
    }
}

/// Bind every name of a refused pattern to NO type, recursively: the
/// refusal above is the decision, and these binds are what keeps one
/// mistake from echoing as a run of "unknown name" downstream.
/// A name the shared judgment already recorded keeps its answer -- the
/// channel refuses a second, different one BY ASSERT, and rightly: the
/// record here is the no-cascade fallback, not a new decision.
fn Checker mut @bind_names_untyped(pat Node) -> () {
    match pattern_shape(pat) {
        Bind => {
            ro nn = pattern_name_node(pat)
            if is_ty(@chan.type_if_known(nn.id_of())) {
                // Already recorded by the shared judgment.
            } else { @record(nn, no_ty()) }
            @scope.bind(pattern_head_text(pat), no_ty(), ParamMode.ModeRo)
        }
        Variant | Tuple | Array | Disj => {
            for sub in pattern_subpatterns(pat) {
                @bind_names_untyped(sub)
            }
        }
        Record => {
            for f in pattern_fields(pat) {
                match patfield_sub(f) {
                    Some(sub) => @bind_names_untyped(sub)
                    None => {
                        ro nn = patfield_name_node(f)
                        if is_ty(@chan.type_if_known(nn.id_of())) {
                            // Already recorded by the shared judgment.
                        } else { @record(nn, no_ty()) }
                        @scope.bind(patfield_name(f), no_ty(), ParamMode.ModeRo)
                    }
                }
            }
        }
        Lit | Wild => {}
    }
}
