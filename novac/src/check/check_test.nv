// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check — tests beside the module (project convention).
//
// The checker had no test file at all until 2026-08-17, which the adversarial
// conformance pass found the same day it found what these tests pin: the
// mirror of the oracle's E_MISSING_RETURN. The rule is easy to get wrong in
// BOTH directions -- too wide lets uninitialised memory through, too narrow
// refuses correct code -- so both directions are pinned here.

module novac.check

import ../source.{SourceText}
import ../lex.{lex}
import ../parse.{parse}
import ../sem.{collect, InteropTable}
import ../tree.{Node}

/// One door for every case below: text in, number of diagnostics out. The
/// std declaration list is empty on purpose -- these tests judge the SHAPE
/// rule, and an empty method table cannot influence it.
fn diagnose(text str) -> int {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro (diags, _) = check(tree, src, collect(tree, []Node.new(), InteropTable.new()))
    diags.len()
}

/// The FIRST diagnostic's message, or "" when the file was clean -- for the
/// tests that judge WHAT a refusal says, not just whether one fired.
fn diagnose_first_msg(text str) -> str {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro (diags, _) = check(tree, src, collect(tree, []Node.new(), InteropTable.new()))
    if diags.len() == 0 { return "" }
    diags[0].message
}

test "tail rule: a binding tail in a value-returning fn is refused" {
    ro src = "module m\n\nfn f() -> int {\n    ro x = 1\n}\n"
    assert(diagnose(src) > 0, "a body that ends without a value must be refused")
}

test "tail rule: an assignment tail is refused" {
    ro src = "module m\n\nfn f() -> int {\n    mut x = 1\n    x = 2\n}\n"
    assert(diagnose(src) > 0, "an assignment tail leaves no value")
}

test "tail rule: an empty body is refused" {
    ro src = "module m\n\nfn f() -> int {\n}\n"
    assert(diagnose(src) > 0, "an empty body of a value-returning fn is refused")
}

test "tail rule: a tail expression is accepted" {
    ro src = "module m\n\nfn f() -> int {\n    7\n}\n"
    assert(diagnose(src) == 0, "a tail expression IS the value")
}

test "tail rule: dead code after an unconditional return is accepted" {
    // The first mirror refused this and the oracle accepts it: the tail IS a
    // binding, and it is also unreachable. A refusal that fires on correct
    // code is a defect even when it errs towards strictness.
    ro src = "module m\n\nfn f() -> int {\n    return 1\n    ro x = 2\n}\n"
    assert(diagnose(src) == 0, "an unconditional return makes the tail dead")
}

test "tail rule: a CONDITIONAL return does not save the tail" {
    // The oracle answers E_MISSING_RETURN here too -- the branch may not run.
    ro src = "module m\n\nfn f() -> int {\n    if 1 == 1 { return 1 }\n    ro x = 2\n}\n"
    assert(diagnose(src) > 0, "a conditional return leaves the end reachable")
}

test "tail rule: a fn that declares no value is exempt" {
    // In the E1 subset every fn but `main` must declare `-> T`, and `-> ()`
    // is not in the grammar at all -- probed 2026-08-17, it comes back as
    // the syntax-error text. So the only shape that declares no
    // value is main itself, and the rule must not touch it: a binding tail
    // there is ordinary code, not a missing return.
    ro src = "module m\n\nfn main() {\n    ro x = 1\n}\n"
    assert(diagnose(src) == 0, "main declares no value, so nothing is missing")
}

test "match exhaustiveness: a later match is still checked after an earlier one's own refusal (registry #1242)" {
    // @type_match/@type_match_stmt compared `@out.len()` against a LITERAL
    // 0 (absolute -- "has anything at all been refused in this file since
    // check() started") instead of a mark taken right before the call
    // being judged, unlike every sibling gate in check/ (exprs.nv,
    // typing.nv, binds.nv, calls.nv, casts.nv, destructure.nv, rules.nv,
    // variant_rules.nv all mark-and-compare). `Checker.out` accumulates
    // for the WHOLE file, so the moment `first`'s own non-exhaustive
    // match pushed its one diagnostic, `second`'s match returned at that
    // same absolute check before ever reaching its own exhaustiveness
    // door -- silently WIDENING the subset (the oracle refuses `second`
    // too; novac's old behaviour let it through with rc=0 and read
    // uninitialised storage, the exact K-C class `@report_if_not_exhaustive`'s
    // own header warns about). Two non-exhaustive matches, in two
    // different functions, must both be named.
    ro src = "module m\n\ntype S enum A | B\n\nfn first(s S) -> int {\n    match s {\n        A => 1\n    }\n}\n\nfn second(s S) -> int {\n    match s {\n        A => 1\n    }\n}\n"
    assert(diagnose(src) == 2, "each function's own non-exhaustive match must be named, not just the first")
}

test "arg position: a typed array literal's `.of(...)` arguments get it too (registry #1239)" {
    // `[]Point.of(a, b)` is ONE `ArrayLit` node (sub-plan L), not a `Call`
    // wrapping the array -- the generic `arg_pos` check (kind == Call/
    // MethodCall/CtorField) never sees it, so a record-constructor
    // argument of `.of(...)` used to be refused as "compiled only as a
    // binding initializer or a call argument" even though it plainly IS
    // a call argument. `array_of_lparen_at` names the `(`'s slot; every
    // child after it now gets the same argument position a `Call`'s own
    // children get for free.
    ro src = "module m\n\ntype Point value {\n    x int\n    y int\n}\n\nro pts = []Point.of(Point { x: 1, y: 2 }, Point { x: 3, y: 4 })\n"
    assert(diagnose(src) == 0, "a record constructor as a `.of(...)` argument is a call argument")
}

test "match agreement: a later match's disagreeing arms are still checked after an earlier one's own (registry #1249)" {
    // The #1242 class, one door over: `@agree_arm_type` compared `@out.len()`
    // against a LITERAL 0 too (found grepping `check/` for the same shape
    // after #1242 closed), so `first`'s own arm-type disagreement pushed one
    // diagnostic, and `second`'s equally-disagreeing arms answered `first`
    // (its type) instead of reporting -- the fold's own comment even named
    // the bug's excuse ("a diagnostic already stands") without noticing the
    // excuse was checking the wrong file-wide slate. Fixed by threading the
    // caller's own `before_arms` mark (`@type_match`'s, already taken for
    // its OWN exhaustiveness door) through `@fold_arm_type` into
    // `@agree_arm_type`, mirroring #1242's mark-not-absolute fix.
    ro src = "module m\n\nfn first(n int) -> int {\n    match n {\n        0 => 1\n        _ => \"x\"\n    }\n}\n\nfn second(n int) -> int {\n    match n {\n        0 => 1\n        _ => \"s\"\n    }\n}\n"
    assert(diagnose(src) == 2, "each function's own arm-type disagreement must be named, not just the first")
}

test "generic receiver: refused after an unrelated earlier refusal too (registry #1249, third door)" {
    // `@report_if_generic_decl`'s OWN gate, one door short of the two above:
    // `@report_if_misplaced_generics(kids)` is called, then `if @out.len()
    // > 0 { return }` -- absolute again, so `broken`'s `unsafe` block
    // (refused by the SUBSET walk, same pass that calls this door for
    // every FnDecl in file order) made `dup`'s OWN, unrelated
    // receiver-generics check answer "the position rule already
    // reported" and skip the receiver loop that names `fn[T] []T @dup` --
    // the real carrier is std's own `serde.nv:319`,
    // `fn[T Serialize] []T @serialize[S Serializer](...)`. Fixed the same
    // way: `before = @out.len()` taken right before the call this gate
    // judges.
    ro src = "module m\n\nfn broken() -> int {\n    unsafe {\n    }\n}\n\nfn[T] []T @dup(n int) -> []T {\n    @\n}\n"
    assert(diagnose(src) == 3, "broken's two refusals plus dup's own generic-receiver refusal, not just broken's")
}

test "diagnostic naming: an unknown-in-expression refusal names the ACTUAL callee (hunt check x K4, N7)" {
    // The message used to say "println is a statement here, not a value"
    // UNCONDITIONALLY, regardless of which name actually failed -- true
    // for the case the door's own comment was written about, false for a
    // tail `panic(...)` (the oracle accepts it; novac refuses it for an
    // unrelated, honest reason -- panic outside the subset -- but used to
    // blame a name, `println`, that this file never even writes).
    ro src = "module m\n\nfn f(ok bool) -> int {\n    if ok {\n        1\n    } else {\n        panic(\"no\")\n    }\n}\n"
    ro msg = diagnose_first_msg(src)
    assert(msg.contains("`panic`"), "the refusal must name the callee that actually failed")
}

test "termination: an infinite `while true { return }` is a terminator, no dead-tail refusal (hunt check x K6, N4, registry #1253)" {
    // `stmt_terminates` enumerated the terminating FORMS (`RetStmt`,
    // `IfLet`, `IfStmt`) rather than answering the PROPERTY "control does
    // not fall through this statement" -- `while` was simply never on
    // the list, so a value-returning fn whose ONLY body is `while true {
    // return n }` was refused as ending without a value, even though the
    // oracle accepts it and there is no way to fall through: `break` is
    // not a form novac reads at all.
    ro src = "module m\n\nfn f(n int) -> int {\n    while true {\n        return n\n    }\n}\n"
    assert(diagnose(src) == 0, "an infinite `while true` with a `return` inside never falls through")
    // Control: a NON-literal condition can still fall through when it
    // turns false, so it must NOT be treated as a terminator.
    ro src2 = "module m\n\nfn g(n int) -> int {\n    while n > 0 {\n        return n\n    }\n}\n"
    assert(diagnose(src2) > 0, "a `while` with a real condition can exit without returning")
}

test "binding mode: assignment to a `ro` target is refused in all four shapes (registry #1254)" {
    // The ASSIGNMENT DOOR (assign_rules.nv) used to judge only the value's
    // TYPE, never the target's MODE -- `ro x = 1; x = 2` typed clean (int =
    // int) and novac accepted it silently, although the mode was already
    // tracked (`scope.nv`) and already read at a call's key
    // (`type_of.nv:class_of_binding`). Four independent shapes reach the
    // same untouched door: a plain `ro` local, a compound assignment to
    // one, a parameter without `mut`, and a field written through a `ro`
    // -bound receiver (caught by NEITHER shape's own message).
    ro simple = "module m\n\nfn f() -> int {\n    ro x = 1\n    x = 2\n    x\n}\n"
    assert(diagnose(simple) > 0, "assigning to a `ro` local must be refused")

    ro compound = "module m\n\nfn f() -> int {\n    ro x = 1\n    x += 2\n    x\n}\n"
    assert(diagnose(compound) > 0, "a compound assignment to a `ro` local must be refused too")

    ro param = "module m\n\nfn f(x int) -> int {\n    x = 5\n    x\n}\n"
    assert(diagnose(param) > 0, "a non-`mut` parameter is bound `ro` the same way a local is")

    ro field = "module m\n\ntype Pt value { n int }\n\nfn f() -> int {\n    ro b = Pt { n: 1 }\n    b.n = 2\n    b.n\n}\n"
    ro field_msg = diagnose_first_msg(field)
    assert(field_msg.contains("E_READONLY_FIELD"), "a field written through a `ro`-bound receiver names the field code, not the local one")

    // Control: a `mut` local (and a `mut`-bound field owner) must stay clean.
    ro ctrl = "module m\n\nfn f() -> int {\n    mut x = 1\n    x = 2\n    x\n}\n"
    assert(diagnose(ctrl) == 0, "a `mut` local must stay assignable")
    ro ctrl_field = "module m\n\ntype Pt value { n int }\n\nfn f() -> int {\n    mut b = Pt { n: 1 }\n    b.n = 2\n    b.n\n}\n"
    assert(diagnose(ctrl_field) == 0, "a field through a `mut`-bound receiver must stay writable")
}

test "qualified module constant: `Type.NAME` resolves through its own registry key (D200 amend #66)" {
    // `const BigInt.ZERO BigInt = zero()` then a use site `BigInt.ZERO.sign`
    // -- the SAME dotted shape a bare-variant read uses (`@judge_type_head_variant`),
    // so the qualified-constant branch has to answer BEFORE the "not a sum"
    // refusal would otherwise claim the read. Proven the other way too: with
    // the resolution branch removed, this same source refused twice (the
    // qualified-name read AND, upstream, the parser's own `E_NOVAC_SUBSET`
    // fallback before `@const_decl`/`@let_decl` learned the `.` branch).
    ro src = "module m\n\ntype BigInt value {\n    sign int\n}\n\nfn zero() -> BigInt => BigInt { sign: 0 }\n\nconst BigInt.ZERO BigInt = zero()\n\nfn use_it() -> int {\n    BigInt.ZERO.sign\n}\n"
    assert(diagnose(src) == 0, "a qualified constant's own type must answer its use site, not the sum-variant refusal")
}

test "qualified module constant: an unknown qualified name still falls through to the sum refusal" {
    // The registry lookup answers `None` for a name nobody declared, and the
    // pre-existing "not a sum" refusal below still has to fire -- the new
    // branch must not swallow every dotted read on a non-sum type, only the
    // ones a `const Type.NAME` actually claims.
    ro src = "module m\n\ntype BigInt value {\n    sign int\n}\n\nfn use_it() -> int {\n    BigInt.NOPE\n}\n"
    assert(diagnose(src) > 0, "an undeclared qualified name is not a free pass past the sum-variant refusal")
}

test "literal magnitude: the eager Lit-walk door defers to the row door, not `int`'s own bound (registry #1250)" {
    // `int_text_fits` used to bound EVERY literal by `int`'s own 64-bit
    // signed range, before the literal's own position (a call argument, a
    // return) ever named a row -- so a `u64` parameter refused its own
    // maximum, and `int` itself refused its own minimum (the magnitude door
    // never looks at a preceding `-`, only at the digit run). The row door
    // (`int_text_fits_row`, asked once the position's type is known) already
    // answered both correctly; the eager door just never let it run.
    ro u64_max = "module m\n\nfn take(x u64) -> u64 => x\n\nfn f() -> u64 {\n    take(18446744073709551615)\n}\n"
    assert(diagnose(u64_max) == 0, "u64's own maximum must fit a u64 parameter")

    ro int_min = "module m\n\nfn take(x int) -> int => x\n\nfn f() -> int {\n    take(-9223372036854775808)\n}\n"
    assert(diagnose(int_min) == 0, "int's own minimum must fit an int parameter")

    ro u64_max_hex = "module m\n\nfn take(x u64) -> u64 => x\n\nfn f() -> u64 {\n    take(0xFFFFFFFFFFFFFFFF)\n}\n"
    assert(diagnose(u64_max_hex) == 0, "the same maximum written in hex must fit too")

    // Control: a magnitude no row could EVER hold stays refused -- the eager
    // door still catches what the row door will never even get asked about.
    ro too_wide = "module m\n\nfn f() -> int {\n    99999999999999999999999999999999\n}\n"
    assert(diagnose(too_wide) > 0, "a literal wider than u64 fits no row at all and must stay refused")

    // Control: a narrow row's own bound must still be enforced -- widening
    // the EAGER door must not have widened the ROW door underneath it.
    ro u8_overflow = "module m\n\nfn take(x u8) -> u8 => x\n\nfn f() -> u8 {\n    take(300)\n}\n"
    assert(diagnose(u8_overflow) > 0, "a u8 parameter must still refuse a value past 255")
}

test "literal magnitude: a match pattern's own literal is judged too (registry #1251)" {
    // Neither magnitude door ever visited a `Pattern` node: not the eager one
    // (only the generic `Lit` walk called it, and a match pattern is never a
    // `Lit`) and not the row one (only ever asked from an assignment/call/
    // return position). `check` stayed clean on a 23-digit pattern literal
    // and the EMITTER wrote it verbatim into a C comparison clang refused
    // outright -- registry #810's own failure, reopened at a position
    // nobody had visited.
    ro too_wide_pattern = "module m\n\nfn f(x int) -> int {\n    match x {\n        99999999999999999999999 => 1\n        _ => 2\n    }\n}\n"
    assert(diagnose(too_wide_pattern) > 0, "a match pattern literal wider than u64 fits no row and must be refused")

    // Control, named explicitly by the hunt: the ORACLE ITSELF does not
    // apply D227 rule 3 (the per-row bound) at a pattern's position --
    // `match x { 300 => .. }` on `x u8` compiles clean on both compilers,
    // an always-false comparison the oracle tolerates. Refusing it here
    // would be a NEW divergence in the opposite direction (novac stricter
    // than the oracle), not a fix -- only the "fits ANY row" question
    // belongs at this position, not "fits THIS row".
    ro u8_300_pattern = "module m\n\nfn f(x u8) -> int {\n    match x {\n        300 => 1\n        _ => 2\n    }\n}\n"
    assert(diagnose(u8_300_pattern) == 0, "a pattern literal out of the SCRUTINEE's own row must stay accepted, matching the oracle")

    ro small_pattern = "module m\n\nfn f(x int) -> int {\n    match x {\n        7 => 1\n        _ => 2\n    }\n}\n"
    assert(diagnose(small_pattern) == 0, "an ordinary small pattern literal must stay clean")
}

test "tail if: a tail `if` whose branches both return needs no value (registry #1252)" {
    // `tail_rules.nv`'s own `stmt_terminates`/`block_terminates` already
    // answers correctly that this `if` ends the function -- both branches
    // `return`. `typing.nv`'s tail-value walk asked the SAME tail a second
    // time, through `@type_if_value` -> `@type_branch_value`, which only
    // understands a tail as an expression and refused EACH `return`-ending
    // branch as "ends without a value" -- two refusals for code the oracle
    // accepts outright, and the ordinary way to write such a function.
    ro src = "module m\n\nfn classify(n int) -> int {\n    if n > 0 {\n        return 1\n    } else {\n        return 2\n    }\n}\n"
    assert(diagnose(src) == 0, "both branches returning is not a missing tail value")
}

test "tail if: one branch returns, the other's value is the if's value (registry #1252, mixed)" {
    // The narrower case `stmt_terminates` on the WHOLE `if` answers false for
    // (only one branch terminates), so the `if` still needs a value -- but
    // the terminating branch must not be asked for one either: only the
    // branch that can fall through carries the type.
    ro ok = "module m\n\nfn classify(n int) -> int {\n    if n > 0 {\n        return 1\n    } else {\n        2\n    }\n}\n"
    assert(diagnose(ok) == 0, "the non-terminating branch's type is the if's type, unconditionally")
    ro mismatch = "module m\n\nfn classify(n int) -> int {\n    if n > 0 {\n        return 1\n    } else {\n        \"s\"\n    }\n}\n"
    assert(diagnose(mismatch) > 0, "the non-terminating branch's type must still agree with the fn's own return type")
}

/// The message half of `diagnose()`: the first diagnostic's own text, for
/// tests that judge WORDING, not just count -- registry #1255 is a wording
/// bug (the vardict is already right; the CAUSE it names is not).
fn diagnose_msg(text str) -> str {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro (diags, _) = check(tree, src, collect(tree, []Node.new(), InteropTable.new()))
    if diags.len() == 0 { return "" }
    diags[0].message
}

test "free call refusal: a binding-CLASS mismatch is named by its own rule, not by arity (registry #1255)" {
    // `fn bump(mut x int)` called `bump(x)` with a `ro x`: one parameter, one
    // argument -- the untyped-but-CLASSED key `free_call_key` still fails
    // (P14: `mut` needs a mutable place), so the arity-shaped lookup answers
    // `FnUnknown` for a call whose count was never wrong. Before this fix the
    // text said so anyway ("no function of this name takes this many
    // arguments"), because nothing between the binding-shape door
    // (`@binding_refusal`, which only reads POSITIONAL/NAMED/DEFAULT faults,
    // not class) and the arity-lookup door asked P14's own question. Fixed by
    // routing the single-known-declaration case straight to
    // `@refuse_arg_type`, itself taught to ask `mode_admits` per slot.
    ro src = "module m\n\nfn bump(mut x int) -> int => x\n\nfn use_it() -> int {\n    ro x = 1\n    bump(x)\n}\n"
    ro msg = diagnose_msg(src)
    assert(!msg.contains("takes this many arguments"), "the count was never the cause: one parameter, one argument")
    assert(msg.contains("mutable place") || msg.contains("P14"), "the real cause -- the argument's binding class -- must be named")
}

test "free call refusal: a matching binding class still checks cleanly (registry #1255, control)" {
    // The same declaration, called with a `mut` binding: admits by P14, and
    // the call resolves with no refusal at all.
    ro src = "module m\n\nfn bump(mut x int) -> int => x\n\nfn use_it() -> int {\n    mut x = 1\n    bump(x)\n}\n"
    assert(diagnose(src) == 0, "a mut argument for a mut parameter binds; nothing to refuse")
}

test "method call refusal: a mut-receiver method on a ro binding is named by its own rule (registry #1255 twin)" {
    // `@refuse_method_call`'s own copy of the same shape `@refuse_free_call`
    // had (registry #1255): the receiver is parameter zero (plan 273) and
    // carries a class exactly like any other argument, so `@method_arity_key`
    // erasing TYPE (not CLASS) means a `mut`-receiver method called through a
    // `ro` binding fails the arity-shaped lookup too -- confirmed on the
    // UNFIXED code: the message was "outside the subset: this type has no
    // such method in the declarations novac was handed", naming a method
    // that plainly exists, over an arity that was never one argument short.
    // Fixed the same way as the free-call door: routed to `@refuse_arg_type`,
    // which now asks `mode_admits` for the receiver slot too.
    ro src = "module m\n\ntype Pt { n int }\n\nfn Pt mut @bump() -> int {\n    @n = @n + 1\n    @n\n}\n\nfn use_it() -> int {\n    ro p = Pt { n: 0 }\n    p.bump()\n}\n"
    ro msg = diagnose_msg(src)
    assert(!msg.contains("no such method"), "the method plainly exists; naming it missing lied about the cause")
    assert(msg.contains("mutable"), "the real cause -- the receiver's binding class -- must be named")
}

test "lone ? (Try operator): named refusal, not the anonymous parser fallback (registry #1264)" {
    // `a?` (D85) is legal Nova -- the oracle compiles it as
    // early-return propagation on Option/Result -- but novac does not
    // implement its semantics yet. Before this fix a lone `?` lexed
    // straight to `ErrorTok` (lex.nv's own comment used to say so
    // explicitly) and the parser's generic fallback refused it with no
    // name at all, the same "novac did not parse this" text a genuinely
    // malformed program gets. Now it reaches the tree as its own
    // `NodeKind.Try` and is refused BY NAME in the checker, mirroring the
    // established rule for the sibling `?? return` form (D86, expr.nv).
    ro src = "module m\n\nfn maybe() -> int {\n    5\n}\n\nfn use_it() -> int {\n    ro v = maybe()?\n    v\n}\n"
    ro msg = diagnose_msg(src)
    assert(!msg.contains("did not parse"), "a legal form must not read as a syntax error")
    assert(msg.contains("not compiled yet"), "the refusal must name the operator, not stay anonymous")
}

test "if-let: a QUALIFIED head naming a non-Some variant reaches the same named refusal as a bare one (registry #1259)" {
    // The positive half of #1259 (a qualified `Option.Some(v)` head parsing
    // and type-checking) needs `Option` DECLARED to reach `option_payload`
    // at all -- this file's `diagnose()` deliberately runs against an EMPTY
    // interop table (see its own doc comment) and cannot resolve `Option`,
    // so that half lives in `pipeline/iflet_test.nv` instead, where
    // `compile_to_c` injects real `std` declarations. What IS testable here,
    // with no `Option` involved at all: a qualified head naming a variant of
    // a SELF-DECLARED sum (no std dependency) reaches the SAME named
    // "Some(name) only" refusal a bare non-Some head already gives -- not
    // the unnamed parser fallback the qualified form used to fall into
    // before this fix.
    ro qualified_wrong_variant = "module m\n\ntype Shape enum\n    | Circle(int)\n    | Square(int)\n\nfn f(s Shape) -> int {\n    if Shape.Circle(r) = s {\n        r\n    } else {\n        0\n    }\n}\n"
    ro msg = diagnose_first_msg(qualified_wrong_variant)
    assert(msg.contains("Some(name)"), "a qualified non-Some head must name the same subset boundary the bare form already refuses with")

    // Control: the bare non-Some form gives the identical message -- the fix
    // did not change WHAT is said, only WHICH heads can reach the door that
    // says it.
    ro bare_wrong_variant = "module m\n\ntype Shape enum\n    | Circle(int)\n    | Square(int)\n\nfn f(s Shape) -> int {\n    if Circle(r) = s {\n        r\n    } else {\n        0\n    }\n}\n"
    assert(diagnose_first_msg(bare_wrong_variant) == msg, "the qualified and bare forms must be refused with the identical message")
}

test "interpolation format spec `:?`: named refusal, not the anonymous parser fallback (registry #1231)" {
    // `${expr:?}` (D229 V1) is legal Nova -- until this fix the parser's
    // slot loop had no branch for the `:` after the expression at all, so
    // the form fell into the unnamed "did not parse this" fallback. Now the
    // `:` `?` pair reads as two extra leaves of the slot and the checker
    // refuses the slot BY NAME before the ordinary Display route below would
    // otherwise silently ignore the spec and print the value plain.
    ro src = "module m\n\nfn f(s str) -> str {\n    \"\${s:?}\"\n}\n"
    ro msg = diagnose_first_msg(src)
    assert(!msg.contains("did not parse"), "a legal form (D229 V1) must not read as a syntax error")
    assert(msg.contains("format specifier"), "the refusal must name the format specifier, not stay anonymous")

    // Control: plain interpolation (no spec) is the already-working form and
    // must not regress -- zero diagnostics, same as before this fix.
    ro control = "module m\n\nfn f(s str) -> str {\n    \"\${s}\"\n}\n"
    assert(diagnose(control) == 0, "plain interpolation must stay clean")
}
