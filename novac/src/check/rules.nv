// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc_ast_passes -- feature gating lives apart from the AST walk
// there for the same reason: the walk is one subject, and what each form is
// allowed to be is another.
//
// Role: the REFUSAL rules of the subset -- every `report_if_*` and the text
//   it speaks. Each names the form and the stage it arrives at, which is
//   the whole point of S9.4: the parser reads the language, the checker
//   decides what the subset compiles.
// Used by: check.nv -- its walk calls these and nothing else does.
// Guarded by: check-novac-file-size.py (this split), check-novac-deps.py,
//   check-novac-no-grammar-excuse.py (the texts), check-novac-doc-language.py.
//
// Split out of check.nv on 2026-08-18, when the expression batch and the
// K-C wave together pushed that file past a thousand lines.

module novac.check

import ../source.{SourceText}
import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, bin_op_of, un_op_of, raw_node}
import ../diag.{Diagnostic, Severity, ice}
import ../builtins.{ENTRY_FN, PRINT_FN, is_bool_literal}
import ../sem.{Ctx, CheckOut, declares_receiver, generics_have_consume, generics_have_protocol_bound, param_type_at}
import ../sem.{branch_children, call_callee_text, is_expr_kind, leaf_text, leaf_kind, expr_leaf_name, generic_bounds}
import ../sem.{ret_is_unit, param_default_slot}
import ../types.{TyId, no_ty, is_ty}


/// [name, type-ident, ...] — the second child must be an Ident leaf. Whether
/// that identifier NAMES a type novac knows is judged in the typing walk, not
/// here: this pass also runs over recovered junk, and `fn main junk here ()`
/// would otherwise produce two diagnostics for one mistake (the Err branch's
/// and this one) — a cascade, which the no-cascade rule forbids.
fn Checker mut @report_if_missing_type(kids []Node, msg str) -> () {
    // The TYPE is located by the shared door, not by index: a parameter may
    // carry a leading MODE leaf (`fn take(consume v int)`), and `kids[1]`
    // then reads the NAME as the type. Same class as the method-declaration
    // ice this morning -- a fixed index into a tree whose shape just grew.
    // No type declared at all, or a slot at 0/1 (no MODE leaf before the type):
    // the ordinary path below is the one answer for both shapes, so neither is a
    // BRANCH here -- `if Some(...)` says that, where a two-armed match had to
    // spell an arm that does nothing (owner 2026-08-22).
    if Some(at) = param_type_at(kids) {
        // A slot at 0 or 1 means no MODE leaf stands before the type, and
        // then the ordinary path below answers as well.
        if at > 1 {
            match kids[at] {
                Leaf(t) => {
                    // EXHAUSTIVE, not a chain of `||` (owner's question
                    // 2026-08-20): a disjunction over a closed set answers
                    // "no" SILENTLY, so a new TokenKind that starts a type
                    // form would slip through here and be found weeks
                    // later. A match makes it an error at this line -- the
                    // same reason lex.nv's three delta functions list
                    // every kind (P21, P31).
                    ro is_form = match t.kind {
                        // These START a type FORM the subset does not read
                        // in a parameter that already carries a mode.
                        // `EmptyBrackets` LEFT this list with step B2: `[]T`
                        // is an application through the D239 sugar, and the
                        // resolver reads it -- so `mut xs []int` is a shape,
                        // not a refusal.
                        LBracket | Star | KwRo | KwMut | KwFn | LParen => true
                        // Everything else cannot start one: a keyword of a
                        // declaration or statement, a literal, an operator,
                        // a separator, or the file's end.
                        // `consume` is a MODE word, not a type qualifier: `ro T`
                        // and `mut T` name types, `consume T` does not, so a
                        // second mode word after the first is a different
                        // mistake and must not be called a type form.
                        EmptyBrackets |
                        KwConsume | KwModule | KwIf | KwReturn | KwFor | KwIn | KwWhile | KwType | KwMatch |
                        KwAs | KwImport | KwUse | KwExport | KwTest | KwElse | KwExtern |
                        KwUnsafe | Hash | Ident | IntLit | FloatLit | StrLit | RParen | LBrace |
                        RBrace | RBracket | Dot | Comma | Plus | Minus | Slash | Lt | Le | Gt |
                        Ge | Percent | EqEq | BangEq | AmpAmp | PipePipe | Amp | Caret | Shl |
                        Shr | Tilde | Bang | Pipe | FatArrow | Assign | PlusAssign |
                        MinusAssign | StarAssign | SlashAssign | PercentAssign | AmpAssign |
                        PipeAssign | CaretAssign | ShlAssign | ShrAssign | DotDot | Ellipsis |
                        Colon | At | Arrow | ErrorTok | Eof => false
                    }
                    if is_form {
                        @report_first_leaf_of(kids, TYPE_FORM_MSG)
                    } else {
                        // A plain named type in a parameter carrying a
                        // mode: the shape is fine and the name resolution
                        // judges the rest.
                    }
                    return
                }
                Branch { .. } => {
                    // A generics node after the name: judged by the loop
                    // below.
                    return
                }
            }
        } else {
            // No mode leaf: the ordinary path below answers.
        }
    }
    // A Generics branch in a parameter stopped being a refusal with step B2:
    // `xs Vec[int]` is an APPLICATION, and the resolver reads it -- the door
    // answers no_ty for a wrong arity or an unknown head, and check names that
    // at the point of use instead of this walk refusing the shape wholesale.
    if kids.len() >= 2 {
        match kids[1] {
            Leaf(t) => {
                // `EmptyBrackets` counts as a DECLARED type since step B2: the
                // slice sugar is an application, and the resolver reads it.
                if t.kind == TokenKind.Ident || t.kind == TokenKind.EmptyBrackets { return }
                // The parser reads the whole type reference now (owner
                // 2026-08-17: "a type can be more complex, generics for
                // instance"), so a slice, a qualifier or a function type
                // arrives here as its FIRST token instead of an identifier.
                // Saying "must declare a type" about `xs []int` is a lie --
                // the type is right there, it is the SHAPE that is not
                // compiled yet, and the message must say which.
                // `EmptyBrackets` left with step B2 -- `[]T` is the D239
                // sugar over `Vec[T]`, and the resolver reads it.
                ro is_form = t.kind == TokenKind.LBracket ||
                t.kind == TokenKind.Star ||
                    t.kind == TokenKind.KwRo ||
                    t.kind == TokenKind.KwMut ||
                    t.kind == TokenKind.KwFn ||
                    t.kind == TokenKind.LParen
                if is_form {
                    @report_first_leaf_of(kids, TYPE_FORM_MSG)
                    return
                }
            }
            Branch { .. } => {}
        }
    } else {
        // Fewer than two children means there is no type slot to look at, so this
        // branch has nothing of its own to judge: the refusal just below is the
        // one answer for that shape, exactly as it is for a leaf of any other kind.
    }
    @report_first_leaf_of(kids, msg)
}

/// The SHAPE of a declared return type: `-> []int`, `-> Vec[T]`, `-> (a, b)`,
/// `-> fn(int) -> str` are read by the parser and refused by name here.
fn Checker mut @report_if_return_form(kids []Node) -> () {
    if kids.len() < 2 { return }
    // THE UNIT IS NOT A TUPLE. `-> ()` and `-> (a, b)` both start with `(`, and
    // lumping them together refused the form novac's OWN source is written in --
    // hundreds of signatures -- which is stage 5 locked behind one rule
    // (measured 2026-08-23, plan 9.1e W3g-2).
    if ret_is_unit(kids) { return } else { }
    // `-> Vec[int]` and `-> []int` stopped being refusals with step B2: both
    // are APPLICATIONS (the second through the D239 sugar), and the one
    // reference door reads them at collection -- so the Generics branch and
    // `EmptyBrackets` pass through here, and an unreadable head is named at
    // the point of use instead of the shape being turned away wholesale.
    match kids[1] {
        Leaf(t) => {
            ro is_form = t.kind == TokenKind.LBracket ||
                t.kind == TokenKind.Star ||
                t.kind == TokenKind.KwRo ||
                t.kind == TokenKind.KwMut ||
                t.kind == TokenKind.KwFn ||
                t.kind == TokenKind.LParen
            if !is_form { return }
            @report_first_leaf_of(kids, TYPE_FORM_MSG)
        }
        Branch { .. } => {}
    }
}

/// Which leading qualifier is legal in WHICH position -- MEASURED against the
/// oracle 2026-08-17, not guessed:
///
///     v ro int         E_REDUNDANT_PARAM_RO        `ro` is the default
///     v mut int        E_PARAM_TYPE_POS_MUT_RETRACTED
///     v consume int    expected type, got `consume` -- it is a parameter
///                      MODE and stands before the NAME
///     consume v int    accepted, builds, runs
///     v uninit int     E_UNSAFE_T_READ_REQUIRES_WRAP
///     -> ro int        accepted
///     -> mut int       E_REDUNDANT_RETURN_MUT
///
/// The `consume`/`uninit` rows were WRONG in an earlier version of this table:
/// the probe left the parameter unused and the grep swallowed the diagnostic.
/// A probe that does not USE what it declares proves less than it looks.
///
/// The parser reads every qualifier in every position (plan 9.4), so this is
/// where a misplaced one is named -- as a POSITION mistake, not as a form the
/// subset cannot compile yet, because those are different sentences to a
/// reader who has to fix the code.
fn Checker mut @report_if_qualifier_misplaced(kids []Node, pos str) -> () {
    if kids.len() < 2 { return }
    match kids[1] {
        Leaf(t) => {
            ro is_ro = t.kind == TokenKind.KwRo
            ro is_mut = t.kind == TokenKind.KwMut
            ro bad = (pos == "parameter" && is_ro) || (pos == "result" && is_mut)
            if bad {
                @report_first_leaf_of(kids, QUALIFIER_POSITION_MSG)
            } else {
                // The qualifier belongs in this position, or there is none.
            }
        }
        Branch { .. } => {
            // A branch in type position is a generics node, judged elsewhere.
        }
    }
}

/// One text for the position rule.
const QUALIFIER_POSITION_MSG = "this qualifier is not legal here (`ro` is the default and redundant on a parameter; type-position `mut` is retracted there and redundant on a result)"

/// A declared type whose SHAPE the subset does not compile yet -- a slice, a
/// tuple, a function type, a qualified type. The parser reads them all (plan
/// 9.4: the grammar is the language's, the subset is the checker's), so the
/// refusal names the shape instead of pretending the type is missing.
const TYPE_FORM_MSG = "outside the subset: this type form is not compiled yet (slices, tuples, fn types and qualifiers arrive with generics, E2-b)"


/// `if c { a } else { b }` standing where a VALUE is expected. The STATEMENT
/// form is compiled -- including its `else` since 2026-08-18 -- but as a value
/// it needs a temporary the emitter does not build yet, exactly like `match`
/// outside an initializer.
const IF_EXPR_MSG = "outside the subset: an `if` in value position is not compiled yet"

/// `@field` -- the receiver's own field. It can only appear inside a method
/// body, and novac does not declare methods yet, so this refusal and the
/// method-declaration one are two doors of the same limit.
const SELF_FIELD_MSG = "outside the subset: `@field` arrives with methods"

/// `ro x int = 1` -- a local with a DECLARED type. The subset infers the type
/// from the initializer; honouring a written one means checking the two agree,
/// and that is the inference stage's work (E2-b3).
const TYPED_LOCAL_MSG = "outside the subset: a declared local type is not compiled yet (E2-b3)"

/// `"n=${n}"` -- string interpolation. The lexer keeps the literal whole, so
/// nothing is lost; compiling it means emitting a format call.
const INTERP_MSG = "outside the subset: string interpolation is not compiled yet"

/// `| Circle { radius f64 }` -- a record-form variant. D54 (#719) rules on how
/// it may be destructured; the form itself arrives with records in sums.
const RECORD_VARIANT_MSG = "outside the subset: a record-form variant is not compiled yet"

/// `import a.b.{X}` and `use a.b.c`. The parser reads both spellings; the
/// subset compiles ONE module, so there is nothing for an import to name yet.
const IMPORT_MSG = "outside the subset: `import`/`use` arrive with modules (E3)"

/// `export` in front of a declaration. Nearly every declaration in std wears
/// it, and until 2026-08-18 novac answered the most common form in the
/// language with "construct not in the MVP grammar" -- `export` was not even a
/// keyword, so the token fell into the top-level junk bucket.
const EXPORT_MSG = "outside the subset: `export` arrives with modules (E3)"

/// An `import` that RENAMES what it brings (`import a.b as c`, `import a.{X as Y}`).
///
/// Refused by name and not accepted silently, because section 9.1d point 2 is
/// IDENTITY: a C name is a function of the DECLARATION, never of the importer, so
/// an alias must change the spelling in the caller's source and nothing else.
/// Until cross-file resolution exists there is no declaration to point the alias
/// at, and accepting the word would leave a promise novac does not keep.
const IMPORT_ALIAS_MSG = "outside the subset: an `import ... as ...` alias arrives with cross-file resolution -- a C name is a function of the DECLARATION, not of the importer (274 section 9.1d point 2)"

/// Does this import RENAME anything -- `as` anywhere inside it?
fn import_renames(kids []Node) -> bool {
    for c in kids {
        if c.kind_of() != NodeKind.LeafNode { continue }
        if leaf_kind(c) == TokenKind.KwAs { return true }
    }
    false
}

/// `#realtime nogc` and its kin.
const ATTR_MSG = "outside the subset: an effect attribute is read but not compiled yet"

/// `test "name" { ... }`.
const TEST_MSG = "outside the subset: a `test` block arrives with the test runner"

/// A VALUE record -- `type Point value { x int, y int }`.
///
/// THE FORM IS READ (the parser learned it 2026-08-23, and six of novac's own
/// files stop here rather than on a syntax lie), and it is REFUSED because the
/// layout is what the word means. Measured the same hour, and this is why the
/// refusal exists instead of silence:
///
///     type Pt value { n int }
///     mut a = Pt { n: 1 }   ro b = a   a.n = 11
///     println(a.n)  println(b.n)
///
/// The fixed point prints `11` then `1` -- `b` is a COPY. novac, emitting the
/// record as a GC pointer like any other, printed `11` and `11`: the copy became
/// an alias. Accepting a form and miscompiling it is worse than naming it, and a
/// divergence in the PERMISSIVE direction is the worse kind of divergence.
///
/// What the layout wave owes: `NovaValue_<name>` by value (not `Nova_<name>*`),
/// `.` where a pointer takes `->`, construction on the stack instead of
/// `nova_alloc`, and the same for `@field` on a value receiver.
const VALUE_METHOD_MSG = "outside the subset: a method on a `value` record needs the receiver taken by POINTER (the fixed point writes `NovaValue_X*`), and novac passes a value receiver by value -- so a `mut` method would write to a copy"

/// A VARIADIC parameter, `fn total(...args []int)`. The parser reads it (S9.4:
/// the grammar is the language's), and D69 -- it must be last -- is a position
/// rule the checker owns. Until 2026-08-18 the `...` broke the parameter list
/// apart and the refusal read "fn requires a declared return type", about a
/// signature that declares one.
const VARIADIC_MSG = "outside the subset: a variadic parameter `...args []T` arrives with generics (E2-b)"

/// A DEFAULT parameter value whose expression is not a NUMBER or a boolean.
///
/// The form itself is in the subset since wave 4; this is the one narrowing, and
/// it follows from what D102 says a default IS: an expression evaluated AT THE
/// CALL SITE, each call anew, allowed to mention preceding parameters and
/// module-level `const`. Emitting such an expression means writing it inside the
/// CALLER, where those names mean the caller's own bindings or nothing at all --
/// so what the subset takes is the values that mean the same in both places: a
/// numeric literal and a boolean. A STRING is refused with them, because a Nova
/// string literal may interpolate (`"${x}"`) and the interpolation would read
/// the caller's scope; nothing about the wave needs it (novac's own defaults are
/// `skip int = 0`, measured), and a refusal by name can be relaxed later.
const DEFAULT_EXPR_MSG = "outside the subset: a default parameter value is a number or a boolean here (D102 evaluates it at the call site, and any other form would be read in the caller's scope)"

/// D102 declaration-rule 1: defaulted parameters come AFTER the required ones.
/// Not a subset limit -- the language forbids it, and so does the oracle.
const DEFAULT_ORDER_MSG = "a parameter with a default value stands before one without (D102: defaulted parameters come last)"

/// D102 declaration-rule 1, judged over the LIST: once a parameter carries a
/// default, every parameter after it must carry one too.
///
/// Judged of the DECLARATION and not of a parameter, because it is a statement
/// about the ORDER -- a single parameter cannot break it.
fn Checker mut @report_if_default_order(kids []Node) -> () {
    mut seen_default = false
    for c in kids {
        if c.kind_of() != NodeKind.Param { continue }
        ro pk = branch_children(c)
        if param_default_slot(pk).len() > 0 {
            seen_default = true
        } else {
            if seen_default {
                @report_first_leaf_of(pk, DEFAULT_ORDER_MSG)
                return
            } else {
                // Still inside the run of required parameters.
            }
        }
    }
}

/// The default's EXPRESSION, judged against the subset: a numeric literal
/// (`= 0`, `= -1`) or a boolean (`= false`).
/// [INV-GUARD: check-novac-no-cascade.sh] Answers whether it REPORTED, and the
/// caller stopping is held by a MECHANISM rather than by memory: a caller that
/// walks on emits a second diagnostic for one mistake, and the cascade guard
/// judges exactly that on every `neg_*` fixture -- which is how this was found in
/// the first place (`by int = "s".len()` came out twice).
///
/// The walk
/// into a refused default would type its expression and name a second cause for
/// the same mistake -- `by int = "s".len()` came out as the subset refusal AND
/// as "no such method", which is the cascade check-novac-no-cascade.sh forbids.
fn Checker mut @report_if_default_not_value(pk []Node) -> bool {
    ro d = param_default_slot(pk)
    if d.len() == 0 {
        return false
    } else {
        // A default is written: its shape decides.
    }
    if default_is_value(d[0]) {
        return false
    } else {
        // Any other expression would be read in the caller's scope.
    }
    @report_first_leaf_of(pk, DEFAULT_EXPR_MSG)
    true
}

/// Is this default expression a value that means the same at every call site?
///
/// A numeric literal (the `Lit` node, with or without the unary minus the parser
/// folds into it) or a boolean, which is a NAME in the tree and a C keyword in
/// the emission -- so neither reads a scope.
fn default_is_value(d Node) -> bool {
    ro k = d.kind_of()
    // A boolean is a NAME in the tree and a C keyword in the emission, so it
    // reads no scope. Every refusal below is a terminator, which is why no
    // `else` is written: an `else` closing a check by KIND has to be a refusal
    // (P21), and these are answers, not refusals.
    if k == NodeKind.Name { return is_bool_literal(expr_leaf_name(d)) }
    if k != NodeKind.Lit { return false }
    ro kids = branch_children(d)
    if kids.len() == 0 { return false }
    // The token stands LAST: the unary minus, when written, stands before it.
    ro t = kids[kids.len() - 1]
    if t.kind_of() != NodeKind.LeafNode { return false }
    leaf_kind(t) == TokenKind.IntLit || leaf_kind(t) == TokenKind.FloatLit
}

/// A CAST, `1 as u8`. `as` was not a keyword of this lexer until 2026-08-18, so
/// the cast lexed as two names and the refusal read "unknown name" -- the
/// reader was sent looking for a binding that was never meant to exist.
const CAST_MSG = "outside the subset: a cast `expr as T` is not compiled yet (E2-b, with the numeric family)"

/// A record-form variant (`| Circle { radius f64 }`) shows up as a brace among
/// the variant's leaves.
fn Checker mut @report_if_record_variant(kids []Node) -> () {
    for c in kids {
        if c.kind_of() != NodeKind.LeafNode { continue }
        // The terminator ends this branching (P31 form 2); an `else` after
        // it would be dead text, and an `else` closing a test BY VARIANT is
        // what P21 refuses -- both rules point the same way here.
        if leaf_kind(c) == TokenKind.LBrace {
            @report_first_leaf_of(kids, RECORD_VARIANT_MSG)
            return
        }
    }
}

/// `...args []T`: the variadic marker stands before the parameter's name.
fn has_variadic_mark(kids []Node) -> bool {
    if kids.len() == 0 { return false }
    ro first = kids[0]
    if first.kind_of() != NodeKind.LeafNode { return false }
    leaf_kind(first) == TokenKind.Ellipsis
}

/// `by int = 1`: a default value shows up as an `=` among the leaves.
fn has_default_value(kids []Node) -> bool {
    for c in kids {
        if c.kind_of() != NodeKind.LeafNode { continue }
        if leaf_kind(c) == TokenKind.Assign { return true }
    }
    false
}

/// A range that is not the head of a `for`.
const RANGE_MSG = "outside the subset: a range is a `for` head here, not a value (E2-b)"

/// `0..3` outside a for-head: refused by name, never iced.
fn Checker mut @report_if_range_outside_for(kids []Node) -> () {
    if kids.len() < 2 { return }
    ro op = kids[1]
    if op.kind_of() != NodeKind.LeafNode { return }
    if leaf_kind(op) == TokenKind.DotDot {
        @report_first_leaf_of(kids, RANGE_MSG)
    } else {
        // Any other binary operator: an ordinary expression.
    }
}

/// The ONE text of the rule, so that the two doors cannot drift apart.
const FOR_HEAD_MSG = "outside the subset: the head of a `for` is a range `lo..hi` here; a collection head arrives with generics (E2-b)"

/// The head of a `for` must be a RANGE, and the subset says so out loud.
///
/// Found by the adversarial review of the operator wave, 2026-08-16: neither
/// check nor the emitter ever looked at the head's operator. `for i in 0 < 3`
/// and `for i in 1 + 3` were silently emitted as range loops (the emitter
/// reads children [0] and [2] and never [1]), and `for i in n` reached an ice.
/// The oracle refuses all three. This is the exact class P21 names -- a
/// dispatch that never happened is weaker than a wrong `else` -- and it is
/// the inverse of the ice that already guards `Range` in expression position.
fn Checker mut @report_if_bad_for_head(kids []Node) -> () {
    if kids.len() < 4 { return }
    ro head = kids[3]
    if head.kind_of() != NodeKind.Bin {
        // A head that is not a binary operator is EITHER a collection --
        // legal Nova, and it arrives with generics -- or a scalar, which the
        // oracle refuses too. The message names both instead of implying the
        // language itself requires a range.
        @report_first_leaf_of(kids, FOR_HEAD_MSG)
        return
    }
    ro hk = branch_children(head)
    if hk.len() < 3 { return }
    match bin_op_of(leaf_kind(hk[1])) {
        Range => {}
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => {
            @report_first_leaf_of(kids, "outside the subset: the head of a for must be a range `lo..hi`, not another binary operator")
        }
    }
}

/// Does this statement END the function on every path?
///
/// A `return` does. So does an `if` whose branches ALL return -- and that
/// second half only became possible on 2026-08-18, when the parser learned
/// `else`: before it, an if-statement had no else branch to judge. The rule
/// missed it and refused `fn classify(n int) -> int { if .. { return 3 }
/// else { return 1 } }`, which the oracle accepts and which is the ordinary
/// way to write such a function.
///
/// An `if` WITHOUT an else never terminates: the false path falls through,
/// and that is exactly the shape the oracle refuses too.
fn stmt_terminates(st Node) -> bool {
    ro k = st.kind_of()
    if k == NodeKind.RetStmt { return true }
    if k != NodeKind.IfStmt { return false }
    ro kids = branch_children(st)
    if kids.len() <= 4 { return false }
    ro then_b = kids[2]
    ro else_b = kids[4]
    block_terminates(then_b) && block_terminates(else_b)
}

/// Does this block end the function on every path? An `else if` chain
/// arrives here as a nested IfStmt rather than a Block, and it answers
/// through the same door.
fn block_terminates(b Node) -> bool {
    ro k = b.kind_of()
    if k == NodeKind.IfStmt { return stmt_terminates(b) }
    if k != NodeKind.Block { return false }
    for s in branch_children(b) {
        if stmt_terminates(s) { return true }
    }
    false
}
/// Does this RetType promise a VALUE? `-> int` does; `-> ()` and a bare arrow
/// do not.
fn declares_a_value(rk []Node) -> bool {
    if rk.len() <= 1 { return false }
    if rk.len() != 3 { return true }
    ro l = rk[1]
    ro r = rk[2]
    if l.kind_of() != NodeKind.LeafNode { return true }
    if r.kind_of() != NodeKind.LeafNode { return true }
    ro is_unit = leaf_kind(l) == TokenKind.LParen && leaf_kind(r) == TokenKind.RParen
    !is_unit
}

/// One text for the two doors of the rule (an empty body and a statement
/// tail): the reader must not have to wonder whether they are two limits.
const TAIL_NO_VALUE_MSG = "fn declares a return type but its body ends without a value"

/// A fn that declares a value must END with one -- unless the end is
/// UNREACHABLE. The oracle started judging this on 2026-08-17 as
/// `E_MISSING_RETURN`, and novac accepted what it rejects (class K7).
///
/// The rule was mirrored crudely at first and the adversarial pass caught it
/// the same day: `fn f() -> int { return 1  <NL>  ro x = 2 }` was refused by
/// novac and accepted by the oracle. Both are right about their halves --
/// the tail IS a binding, and it is also DEAD, because an unconditional
/// `return` stands before it. A refusal that fires on correct code is a
/// defect even when it errs "towards strictness": it sends the reader to fix
/// what is not broken.
///
/// Boundary re-measured across fourteen shapes (2026-08-17). Refused: a
/// binding or assignment tail, and an empty body, WHEN no unconditional
/// terminator stands at the top level of the body. Accepted: a tail
/// expression, a `return`, an `if` whose branches return, a tail `while`/
/// `for`, and anything at all after an unconditional `return` -- the oracle
/// accepts each of these. A CONDITIONAL return does not save the tail
/// (`if c { return 1 }` then a binding is E_MISSING_RETURN for the oracle
/// too), which is why the scan looks at top-level statements only and does
/// not walk into branches.
fn Checker mut @report_if_tail_has_no_value(kids []Node) -> () {
    mut declares_value = false
    for c in kids {
        if c.kind_of() != NodeKind.RetType { continue }
        // `-> ()` is the UNIT return, and unit is not a value. It used to
        // parse as the arrow ALONE, and the length test below was enough;
        // since type_ref reads `()` as a balanced run (the tuple form), the
        // pair reaches the tree and the old test called it a value. The result
        // was a refusal that told `fn nothing() -> () { }` its body ends
        // without a value -- a body that is not supposed to produce one.
        declares_value = declares_value || declares_a_value(branch_children(c))
    }
    if !declares_value { return }
    for c in kids {
        if c.kind_of() != NodeKind.Block { continue }
        ro bk = branch_children(c)
        mut last_stmt = -1
        mut i = 0
        mut terminates = false
        for b in bk {
            terminates = terminates || stmt_terminates(b)
            last_stmt = if b.kind_of() == NodeKind.LeafNode { last_stmt } else { i }
            i += 1
        }
        // The end is unreachable: whatever stands last, it is dead code and
        // the oracle says nothing about it. Neither do we.
        if terminates { return }
        if last_stmt < 0 {
            @report_first_leaf_of([]Node.of(c), TAIL_NO_VALUE_MSG)
            return
        }
        // [LEGACY-#676] var-index-method: `bk[i].kind_of()` with a VARIABLE
        // index miscompiles -- the emitter takes the Vec itself for the
        // receiver (E_RECV_METHOD_MISMATCH). The binding walks around it and
        // goes when #676 closes.
        ro tail_node = bk[last_stmt]
        ro k = tail_node.kind_of()
        // ALLOW-list, and it mirrors the emitter's condition exactly
        // (emit_c.nv:454 `is_expr_kind(kind) && kind != Call`): the tail
        // produces a value iff the emitter writes `return` for it. The first
        // version asked the opposite question -- "is the tail a binding or an
        // assignment?" -- and four shapes walked past it: a tail `if` without
        // `else`, a tail `while`, a tail `for`, and a tail unit call like
        // `println(...)`. The oracle refuses all four; novac emitted a
        // function that falls off its end. Asking a deny-list about an open
        // set is how a rule looks complete while covering two cases of six.
        if k == NodeKind.RetStmt || (is_expr_kind(k) && k != NodeKind.Call) { return }
        @report_first_leaf_of([]Node.of(tail_node), TAIL_NO_VALUE_MSG)
        return
    }
}


/// Generic parameters are outside the subset -- and the refusal says so.
///
/// Until this wave the parser could not see `[T]`, so the signature derailed
/// and the user was told the return type was missing while it was written
/// right there. Class recorded in the divergence registry as "the refusal
/// names the consequence, not the cause": a diagnostic that misattributes
/// sends the reader to fix code that is correct. E2-b2 replaces this refusal
/// with monomorphisation; the node it needs is already parsed.
fn Checker mut @report_if_misplaced_generics(kids []Node) -> () {
    // Type parameters BEFORE the name of a FREE function are not a subset
    // limit, they are a misplaced form. `fn[T]` binds the RECEIVER -- the
    // spec's own examples show `fn[T] []T @map[U]`, T for the receiver and U
    // for the method -- while a free function declares them after its name,
    // `fn box_iter[T](...)`. std proves the split by usage: 55 receiver-form
    // declarations against 18 free ones, and the mixed shape never (measured
    // 2026-08-17, owner's observation). Reported first so the reader learns
    // the POSITION is wrong, not that generics are unsupported.
    ro has_recv = declares_receiver(kids)
    mut seen_name = false
    mut i = 0
    for c in kids {
        ro ck = c.kind_of()
        ro misplaced = !has_recv && ck == NodeKind.Generics && !seen_name && i > 0
        if misplaced {
            @report_first_leaf_of([]Node.of(c), GENERIC_POSITION_MSG)
            return
        } else {
            // A receiver is present (the position is then correct), or this
            // child is not a generics node standing before the name.
        }
        seen_name = seen_name || (i > 0 && c.is_ident())
        i += 1
    }
    // A BOUND is refused by name. novac neither dispatches a protocol nor
    // verifies a constraint -- both arrive with E2-b3 -- and compiling
    // `fn pick[T Compare](a T)` as if the bound were not written would ACCEPT
    // programs the oracle rejects: the over-acceptance direction, the dangerous
    // one. Until 2026-08-21 the bound was worse than unjudged: the collector
    // counted it as a second type PARAMETER, so `pick[int](3)` was refused with
    // "the call gives a different number of type arguments than the declaration
    // binds" -- a lie about a legal program.
    // The full form of an entry is `T [consume] [Protocol + ...]`, and the two
    // constraints get two refusals: linearity is a gap of novac as a whole
    // (D133/D156 are not tracked anywhere) [INV-TODO: 274 9.1g.3 -- deferred by a
    // recorded marker until E2-b3; the plan owns it, no number self-assigned]
    // , a protocol bound waits for dispatch
    // (D122, E2-b3). Naming one cause for both would name a cause that was not
    // established.
    if generics_have_consume(kids) {
        @report_first_leaf_of(kids, GENERIC_CONSUME_MSG)
        return
    } else {
        // No linearity constraint written.
    }
    // A BOUND NAMING A KNOWN PROTOCOL IS NO LONGER A REFUSAL (wave 3b). The
    // constraint is checked where it can be checked -- at the CALL, against the
    // type the arguments deduced -- and refusing the declaration would mean
    // refusing every correct program that uses one. A bound naming something
    // novac does not know keeps its refusal, and it says WHICH name.
    if generics_have_protocol_bound(kids) && !@bounds_are_known(kids) {
        @report_first_leaf_of(kids, GENERIC_BOUND_MSG)
    } else {
        // Nothing but names: that is what E2-b2 compiles.
    }
}

/// The BLANKET refusal — for declarations where type parameters are not in the
/// subset at all: a generic TYPE (`type Box[T]`) and a generic RECEIVER
/// (`fn[T] []T @map`). A free function's own parameters are admitted with
/// E2-b2 (mono over explicit type arguments) and do NOT come here.
fn Checker mut @report_if_generic_form(kids []Node) -> () {
    for c in kids {
        if c.kind_of() == NodeKind.Generics {
            @report_first_leaf_of([]Node.of(c), GENERIC_MSG)
            return
        }
        if c.kind_of() != NodeKind.Recv { continue }
        for r in branch_children(c) {
            if r.kind_of() == NodeKind.Generics {
                @report_first_leaf_of([]Node.of(r), GENERIC_MSG)
                return
            }
        }
    }
}

/// A FN DECLARATION with type parameters: the FREE-function form is admitted
/// with E2-b2, the receiver form is not.
///
/// `fn box_iter[T](..)` declares its parameters after the name, and that is the
/// form mono over explicit type arguments needs. `fn[T] []T @map[U]` binds T to
/// the RECEIVER, and a method's own parameters arrive with E2-b3: refusing it
/// here keeps the boundary of the subset NAMED instead of guessed.
///
/// The POSITION rule runs first either way, so a misplaced form is told it is
/// misplaced rather than unsupported.
fn Checker mut @report_if_generic_decl(kids []Node) -> () {
    @report_if_misplaced_generics(kids)
    if @out.len() > 0 {
        // The position rule already reported: one mistake, one diagnostic.
        return
    } else {
        // The position is fine, so the receiver form is the next question.
    }
    for c in kids {
        if c.kind_of() != NodeKind.Recv { continue }
        for r in branch_children(c) {
            if r.kind_of() == NodeKind.Generics {
                @report_first_leaf_of([]Node.of(r), GENERIC_MSG)
                return
            }
        }
    }
}

/// An `extern "ABI" fn` declaration: READ by the parser since 2026-08-20,
/// refused here by name.
///
/// The form is the language's (D282, plan 91.12 F.-1) and std's whole FFI layer
/// is written in it. What novac does not have is the EMISSION: an extern
/// declaration says "the body is a C or runtime symbol", and nothing in the
/// subset emits a call to one. Refusing the DECLARATION rather than its calls
/// is deliberate -- the declaration is where the reader wrote the form, and one
/// diagnostic at the form beats one per call site.
///
/// Answers `true` when it reported, so the caller can skip the rules that judge
/// PARTS of a declaration novac will not compile at all: a second diagnostic
/// about a part of a refused form is the cascade the no-cascade guard forbids.
fn Checker mut @report_if_extern_decl(kids []Node) -> bool {
    for c in kids {
        match c {
            Leaf(t) => {
                if t.kind == TokenKind.KwExtern {
                    @refuse(t,
                        "outside the subset: an `extern` declaration is read, but novac emits no FFI call yet")
                    return true
                } else {
                    // Another leaf of the same declaration: `fn`, the name,
                    // the ABI string. Only the keyword marks the form.
                }
            }
            Branch { .. } => {}
        }
    }
    false
}

/// Every fn except main must declare `-> T` in the subset.
fn Checker mut @report_if_return_type_undeclared(kids []Node) -> () {
    if kids.len() < 2 { return }
    match kids[1] {
        Leaf(t) => {
            if t.text == ENTRY_FN { return }
            for c in kids {
                match c {
                    Leaf(_) => {}
                    Branch { kind, .. } => { if kind == NodeKind.RetType { return } }
                }
            }
            @refuse(t, "outside the E1 subset: fn requires a declared return type")
        }
        Branch { .. } => {}
    }
}

/// Does every bound in this generics list name a protocol the registry holds?
///
/// Split from the refusal itself so the two questions stay apart: "is there a
/// bound at all" is about the SOURCE, "is it a contract we know" is about the
/// registry. Answering both in one condition is what made the old refusal cover
/// correct programs.
fn Checker @bounds_are_known(kids []Node) -> bool {
    for b in generic_bounds(kids) {
        if b == "" { continue }
        if @ctx.protos.row_of(b) < 0 { return false }
    }
    true
}

/// Type parameters in the wrong PLACE -- a different mistake from type
/// parameters not being compiled yet, and the message must not confuse them.
const GENERIC_POSITION_MSG = "type parameters before the name belong to a method receiver; a free function declares them after its name"

/// A BOUND on a type parameter (`[T Compare]`, `[K Equal + Hash]`).
const GENERIC_BOUND_MSG = "outside the subset: a bound on a type parameter dispatches through a protocol (D122), and that arrives with E2-b3 -- the parameter itself is compiled, the constraint is not"

/// A LINEARITY constraint on a type parameter (`[T consume]`).
const GENERIC_CONSUME_MSG = "outside the subset: a generic over a must-consume type (`[T consume]`) needs linearity, and novac tracks none yet (D133/D156) -- the parameter itself is compiled, the obligation is not"

/// One text for both doors (fn and type): the reader must not have to
/// wonder whether two wordings mean two different limits.
const GENERIC_MSG = "outside the E1 subset: generic parameters are not compiled yet (planned for E2-b2)"

/// Report `msg` at the first leaf found under `children` (depth-first).
fn Checker mut @report_first_leaf_of(children []Node, msg str) -> () {
    for c in children {
        match c {
            Leaf(t) => {
                @refuse(t, msg)
                return
            }
            Branch { children: inner, .. } => {
                ro before = @out.len()
                @report_first_leaf_of(inner, msg)
                if @out.len() > before { return }
            }
        }
    }
}

/// Does this subtree call anything? An argument that calls something is an
/// argument whose evaluation ORDER is observable.
fn contains_call(n Node) -> bool {
    match n {
        Leaf(_) => false
        Branch { kind, children, .. } => {
            if kind == NodeKind.Call || kind == NodeKind.MethodCall { return true }
            for c in children {
                if contains_call(c) { return true }
            }
            false
        }
    }
}

/// Two arguments that BOTH call something are two side effects whose order
/// the emitter does not fix: it prints the call straight into C, and C
/// leaves argument evaluation order unspecified at any calling convention.
/// Probe 2026-08-16 (finding F65): the oracle evaluates such a call
/// RIGHT-to-left, while the spec calls left-to-right normative and
/// observable. Until the emitter hoists arguments into temporaries in source
/// order, this is an honest subset refusal — the same choice the arrays
/// rollback made, and the opposite of quietly emitting order-dependent code.
/// One effectful argument is fine: a single effect has no order to get wrong.
fn Checker mut @report_if_ordered_args(kids []Node) -> () {
    mut effectful = 0
    for c in kids {
        if !is_expr_kind(c.kind_of()) { continue }
        if !contains_call(c) { continue }
        effectful += 1
    }
    if effectful < 2 { return }
    @report_first_leaf_of(kids, "outside the E1 subset: two arguments that both call something, and the emitter does not fix their order yet (F65)")
}

/// A CALL in statement position is `println` and nothing else in the subset.
/// Owner's question 2026-08-16 ("does every Call really become a println?"):
/// it did, and the emitter's ice was the FIRST answer for `helper()` as a
/// statement — the #652 class again, where the boundary belongs in check and
/// the ice is only the second floor. Expression-position calls are a
/// different question and go through the emitter's Call branch.
fn Checker mut @report_if_bad_call_stmt(stmts []Node) -> () {
    for st in stmts {
        match st {
            Leaf(_) => {}
            Branch { kind, children, .. } => {
                if kind != NodeKind.Call { continue }
                if call_callee_text(children) == PRINT_FN { continue }
                @report_first_leaf_of(children, "outside the E1 subset: a call in statement position is println only")
            }
        }
    }
}

/// MethodCall kids: [recv, '.', name, '(', args..., ')'] — the name leaf is
/// judged against the ONE subset table. An unknown method is an honest
/// E_NOVAC_SUBSET at the method name, not an emitter ice later. (The
/// receiver's TYPE is not judged here — the type checker is a later wave;
/// the named risk lives in the divergence registry next to #652.)
fn Checker mut @report_if_unknown_method(kids []Node) -> () {
    if kids.len() < 3 { return }
    match kids[2] {
        Leaf(t) => {
            // novac knows a method ONLY from declarations it has read
            // (П5: it does not know std names). At this stage there are
            // no locals yet, so the receiver's type is unknown and only
            // the name's existence is judged; the exact pair (receiver
            // type, name) is finding C9 of plan 274.3, wave 3.
            if @ctx.fns.has_name(t.text) { return }
            @refuse(t, "outside the subset: no such method in the declarations handed to novac (or the name is overloaded)")
        }
        Branch { .. } => {}
    }
}

/// An ErrorTok leaf is a lexer refusal: report it at its position.
fn Checker mut @report_if_error_token(t Token) -> () {
    if t.kind != TokenKind.ErrorTok { return }
    @refuse(t, "outside the E1 subset: unrecognized or context-dependent token")
}

/// A run the parser could not read at all.
///
/// Every FORM of the language is parsed since S9.4a, so this is no longer
/// a way of saying "the subset does not go that far" -- it says the text is
/// not Nova. Whatever the subset declines, it declines BY NAME somewhere
/// else, and `check-novac-no-grammar-excuse.py` keeps that true.
const SYNTAX_MSG = "syntax error: this is not a form of the language"

/// An Err branch is ONE recovered mistake: one diagnostic at its first leaf.
fn Checker mut @report_err_branch(children []Node) -> () {
    // One Err branch — one diagnostic, at its FIRST leaf. The leaf can nest:
    // parse wraps a stray non-header module declaration as a whole ModuleDecl
    // branch inside Err (fuzzer catch 2026-08-14); the old flat scan found no
    // direct leaf there and reported NOTHING — a silent pass on a broken file.
    ro before = @out.len()
    for c in children {
        if @out.len() > before { return } // the one diagnostic is out already
        match c {
            Leaf(t) => {
                // The whole run is the subject, so the whole run is underlined.
                ro lo = @src.offset_of(t.text)
                ro hi = @run_end_of(children, lo + t.text.byte_len())
                // NOT "outside the subset" any more (S9.4a closed on
                // 2026-08-18): the parser reads the whole LANGUAGE, so a run
                // it could not read is a SYNTAX error and the message says
                // that. The old text blamed the subset for the parser's own
                // ignorance -- and it was the last carrier of that class.
                @refuse_span(lo, hi, SYNTAX_MSG)
                return
            }
            Branch { children: inner, .. } => @report_err_branch(inner)
        }
    }
}
