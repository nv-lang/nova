// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check/binds.nv -- a BINDING and its initializer: how `ro x = ...`
// gets its type, and the initializer forms that decide their own (the array
// literal, the record constructor, the match).
//
// Donor: rustc `check_decl_local` for the ROLE -- the initializer is typed and
//        the pattern bound in one place; taken as a seam. NOT taken: bidirectional
//        expectation from an annotation -- the subset reads no binding annotation
//        yet, and inventing the half of it would be the K7 shape.
// Role: layer 7 (check) -- the statement that introduces names into a scope.
// Used by: typing.nv (the statement walk, its one caller).
// Guarded by: check-novac-file-size.py (this file exists because typing.nv
//             crossed a thousand lines again), check-novac-no-silent-skip.py
//             (every exit of the channel pass decides), the pipeline module
//             tests (the literal's six shapes, the self-initializer refusal).
//
// A co-equal file of module `novac.check` (folder = one module), cut by MEANING
// under decision 12: typing.nv keeps the walk over statements and expressions,
// this file keeps the one statement whose initializer decides a type.

module novac.check

import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, bin_op_of, un_op_of, raw_node}
import ../diag.{ice}
import ../builtins.{ENTRY_FN, PRINT_FN, TypeKind, is_bool_literal, RECV_BINDING, LITERAL_CTOR, LITERAL_PUSH, SLICE_HEAD}
import ../names.{NameTable, NamespaceId}
import ../sem.{CallForm, CalleeTarget, ty_of_decl, decl_fn_row, declares_receiver, generic_names, arm_body_at}
import ../sem.{is_paren_form_record}
import ../sem.{Ctx, CheckOut, param_name_at, param_type_at, branch_children, call_callee_text, is_expr_kind, leaf_text}
import ../sem.{leaf_kind, expr_leaf_name, subst_type, decl_name_at, coerce_row, param_mode_at, bind_mode_at, carrier_of}
import ../sem.{representation_of, raw_row, FnRow, ArgSpec, ArgClass, ParamMode, raw_vrow, no_vrow, is_vrow, is_arg_node}
import ../sem.{arg_expr_of, arg_name_of, bind_slots, identity_slots, arg_count, no_row, file_decls, generic_head_cnt}
import ../sem.{literal_elems, literal_head_name, literal_ctor_name, slice_term_of, c_instance_ctor, c_instance_method}
import ../sem.{ty_source_name}
import ../types.{TyId, no_ty, is_ty}

/// A binding. The initializer's type is decided BEFORE the initializer's own
/// binders exist -- the emitter's order, kept because changing it would change
/// which programs compile (a match whose first arm uses its binders is
/// refused today, and that refusal is a fact of the subset, not an accident
/// of this walk).
fn Checker mut @type_bind(st Node) -> () {
    ro kids = branch_children(st)
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a binding needs a name and an initializer")
        return
    }
    ro vname = leaf_text(kids[1])
    // A NAME that is a visible payload-less variant is not a binder in the
    // language: the binding is a refutable one-variant pattern, and the
    // oracle refuses it (D411; hunt var_shadow, #875). Judged before the
    // initializer -- the shadowing itself is the mistake.
    match @ctx.defs.def_of(vname) {
        None => {}
        Some(vd0) => match vd0.target {
            DefVariant(vrow) => {
                if @ctx.variant_rows[raw_vrow(vrow)].payload_cnt == 0 {
                    @report_first_leaf_of(kids, REFUTABLE_BIND_MSG)
                    return
                } else {
                    // A payload-carrying variant's name is no pattern
                    // without its parens; the binding stands.
                }
            }
            DefType(_) | DefFn(_) | DefConst(_) => {}
        }
    }
    ro init = kids[kids.len() - 1]
    ro ik = init.kind_of()
    // A plain expression initializer is verified before it is typed. A match
    // initializer is NOT: the emitter decides its type before the arms bind
    // their binders, and that order is what makes "a match whose first arm
    // uses its binders" a refusal of the subset rather than a silent success.
    if ik != NodeKind.MatchExpr && ik != NodeKind.RecordCtor && ik != NodeKind.ArrayLit && is_expr_kind(ik) {
        ro before = @out.len()
        @type_expr(init)
        // The mark, not the file's count: a refusal in an EARLIER declaration
        // used to stop this walk too, and `@type_bind` then skipped its
        // `@scope.bind` -- every later name came out "unknown" (probe
        // 2026-08-20). The question is about THIS expression.
        if @out.len() > before { return }
    } else {
        // A match or record-ctor initializer is walked BELOW, after its type is
        // decided; any other form was refused by the subset walk. Neither has
        // anything to verify here.
    }
    // A binding whose initializer mentions the name it binds is REFUSED
    // (274.3/F28). Measured 2026-08-17, and the measurement is why this is a
    // refusal and not a fix: `ro x = 7` then, inside a block,
    // `ro x = x < 3` prints `true` for x = 7 AND for x = 1, while
    // `ro x = x + 100` prints exactly 100. The inner name is visible in its
    // own initializer and reads as ZERO -- in the ORACLE, not only here. Both
    // compilers agree, so the differential gate is green while the answer is
    // wrong; that is the shape a silent miscompilation takes.
    //
    // Until the spec says what the form means (escalated with the probe), the
    // subset refuses it. Rust reads the OUTER binding here (`let x = x + 1`),
    // which is the reading I expect to win, but expecting is not knowing.
    @self_probe.clear()
    @self_probe.put(vname, 0)
    if @init_reads_self(init) {
        @report_first_leaf_of([]Node.of(init), SELF_INIT_MSG)
        return
    }
    // AN ARRAY LITERAL DECIDES ITS OWN TYPE HERE, before the lattice is asked:
    // the term `Vec[elem]` may not exist yet (no signature mentioned it), and
    // interning it is a WRITE the lattice must not do. The literal's type goes
    // into the channel like any other, and the lattice reads it back.
    if ik == NodeKind.ArrayLit {
        ro lit_t = @type_array_lit(init)
        // SILENT-OK: the refusal was already reported inside type_array_lit, by
        // name; a literal with no type has nothing to record and binds no name.
        if !is_ty(lit_t) { return }
        @record(init, lit_t)
        @scope.bind(vname, lit_t, bind_mode_at(kids))
        // SILENT-OK: recorded and bound above, the literal is fully decided; the
        // lattice path below is for the other initializer kinds.
        return
    } else {
        // Every other initializer: the lattice answers -- except the one below.
    }
    // A TUPLE LITERAL routes explicitly for the same reason the array literal
    // does: TupleExpr is NOT in is_expr_kind (wave B13 lesson -- that list
    // feeds every general arm), so the verify-then-read path above never sees
    // it. Typing interns the pair term (B15 step 3) and records it; the bind
    // reads exactly what was recorded.
    if ik == NodeKind.TupleExpr {
        ro before2 = @out.len()
        @type_expr(init)
        if @out.len() > before2 { return }
        ro pt = @chan.type_if_known(init.id_of())
        // SILENT-OK: a pair with an unanswerable component was already refused
        // (or the hole is named) inside type_expr; nothing to bind.
        if !is_ty(pt) { return }
        @scope.bind(vname, pt, bind_mode_at(kids))
        return
    }
    // AN INDEX DECIDES ITS OWN TYPE HERE for the same reason the literal above
    // does: the answer comes from a DOOR (`@type_index` asks the receiver's
    // application for its element) and carries every subset refusal about an
    // index with it. The lattice cannot be asked instead -- it reads what was
    // recorded, and nothing has recorded this yet.
    //
    // This half was missed when the arm moved out of the subset walk on
    // 2026-08-31, and the module test caught it: `ro v = nosuch(i)[0]` stopped
    // being refused AT ALL, because this path never calls `@type_expr`.
    // AN `if` DECIDES ITS OWN TYPE HERE (wave B14, initializer position):
    // the doors were written for the tail form and the type comes from them --
    // both branches typed, forced to AGREE, the agreed type recorded. The
    // lattice cannot answer instead: it reads what was recorded, and nothing
    // has recorded this yet. Same reason, same shape as the two arms below.
    if ik == NodeKind.IfExpr {
        @type_if_value(init)
        ro if_t = @chan.type_if_known(init.id_of())
        // SILENT-OK: a refused `if` (no else, disagreeing branches, a branch
        // without a value) was reported inside `@type_if_value`, by name; it
        // has nothing to record and binds no name.
        if !is_ty(if_t) { return }
        @scope.bind(vname, if_t, bind_mode_at(kids))
        return
    } else {
        // Not an `if`: the arms below decide.
    }
    if ik == NodeKind.Index {
        ro idx_t = @type_index(init)
        // SILENT-OK: refused inside `@type_index`, by name; an index with no
        // type has nothing to record and binds no name.
        if !is_ty(idx_t) { return }
        @record(init, idx_t)
        @scope.bind(vname, idx_t, bind_mode_at(kids))
        return
    } else {
        // Not an index: the lattice answers below.
    }
    ro vtype = type_of(init, @ctx, @scope, @chan)
    @record(init, vtype)
    if ik == NodeKind.MatchExpr {
        @type_match(init)
    } else if ik == NodeKind.RecordCtor {
        @judge_record_ctor(init, vtype)
    } else {
        // A plain expression initializer was walked above and its type is
        // recorded; it has no sub-form left to visit.
    }
    // The BINDING's own mode, read from the keyword the author wrote: `ro x`,
    // `mut x` and `consume x` are three different classes at every call site
    // that passes `x` on (P14).
    @scope.bind(vname, vtype, bind_mode_at(kids))
}


/// Judge one record construction: its fields against the declaration, and the
/// expressions inside them.
///
/// ONE DOOR, called from both positions the subset allows -- a binding's
/// initializer and, since wave B13, a call argument. The two used to be one
/// place only, and when the argument position arrived the obvious move was to
/// copy these four steps into the expression walk. That would be a second door
/// to one root: the construction would be judged twice, by two texts that drift
/// apart on the first amendment to either.
///
/// The type is a PARAMETER and not derived here, because both callers already
/// know it and deriving it again would be the same mistake one level down
/// (#812: the walk in check.nv sees the node but not the type).
fn Checker mut @judge_record_ctor(ctor Node, vtype TyId) -> () {
    // A NAMED-TUPLE record (`type Pair(x int, y int)`) is CONSTRUCTED BY CALL,
    // not by brace: the oracle accepts `Pair { x: 1 }` at check but fails to
    // emit it (measured 2026-09-03, step 0 of plan 274.6 V2 -- `undeclared
    // identifier 'Nova_Pair'`), so novac refuses the brace form by name rather
    // than emit a struct the fixed point does not. The call form arrives in
    // V2b; until then this type constructs with `Pair(1, 2)`.
    if is_paren_form_record(@ctx, vtype) {
        @report_first_leaf_of(branch_children(ctor), PAREN_FORM_BRACE_MSG)
        return
    } else {
        // A plain or value record: the brace form is its construction.
    }
    @report_if_ctor_fields_wrong(ctor, vtype)
    for c in branch_children(ctor) {
        ro ck = c.kind_of()
        if ck == NodeKind.CtorSpread {
            ro sk = branch_children(c)
            if sk.len() < 2 { continue }
            @type_expr(sk[1])
        } else if ck == NodeKind.CtorField {
            ro fk = branch_children(c)
            if fk.len() < 3 { continue }
            @type_expr(fk[2])
        } else {
            // The type name and the braces of the ctor are children too, and
            // they hold no expression to type.
        }
    }
}

/// The type of `xs[i]` — the ELEMENT of the receiver's application (274.5 B10).
///
/// The door was already there: an applied type keeps its arguments in the
/// interner, so `Vec[int]`'s element is `tys.arg(t, 0)` and nothing new had to
/// be built. What this adds is the JUDGEMENT around it.
///
/// Everything the subset cannot do stays refused BY NAME rather than accepted
/// in silence -- a receiver that is not an application (so not a Vec), an index
/// that is not an integer, an element type nobody knows. Registry #815 was
/// exactly the other choice, and it cost thirteen probes.
fn Checker mut @type_index(e Node) -> TyId {
    ro kids = branch_children(e)
    if kids.len() < 3 {
        // SILENT-OK: recv, '[' and an index are the very least this node can
        // hold, so fewer children means the parser planted a gap right here.
        // The gap IS the diagnostic, and saying a second thing about it would
        // describe one mistake twice.
        return no_ty()
    } else {
        // A whole index expression: judged below.
    }
    // A TYPE on the left makes this an APPLICATION, not an index -- the
    // decision recorded in plan 274.5 s2sh before any of this was written. The
    // token after `]` cannot tell `xs[0].len()` from `HashMap[str, int].new()`,
    // because both carry `.NAME(`; only what the left name RESOLVES TO can, and
    // resolution is the checker's root. So the question is asked here, of the
    // registry, and not guessed at by the parser.
    if kids[0].kind_of() == NodeKind.Name {
        ro head = expr_leaf_name(kids[0])
        if Some(_) = @ctx.ty_of_name(head) {
            // A type applied to arguments. novac reads the form now; compiling
            // it (a static method on the applied type) is the next step of this
            // wave, so the refusal NAMES the form instead of calling the head
            // an unbound value -- which is what it used to say, and it was a
            // lie about which thing was missing.
            @report_first_leaf_of(kids, "outside the subset: a type applied to arguments is read but not compiled yet")
            return no_ty()
        } else {
            // Not a type: an ordinary receiver, typed below.
        }
    } else {
        // A computed receiver: not a type name by construction.
    }
    // THE MARK, not the file's count: the question is about THIS receiver.
    // Without it the door asked `type_of` for a receiver the line above had
    // just refused -- and `type_of` on a call whose name is not in the registry
    // raises an ice, not a diagnostic. Probe: `nosuch(i)[0]`, one of the five
    // ICEs novac had on its own source. The same guard is written a file away
    // in `@type_call_stmt`, and this door was the one place that skipped it.
    ro before = @out.len()
    @type_expr(kids[0])
    if @out.len() > before {
        // SILENT-OK: the receiver was refused just now, by name. One cause,
        // one diagnostic; asking its type after refusing it is asking about a
        // thing that was already said not to exist.
        return no_ty()
    } else {
        // Nothing said about the receiver: its type is a fair question.
    }
    ro recv_t = type_of(kids[0], @ctx, @scope, @chan)
    if !is_ty(recv_t) {
        // SILENT-OK: the receiver was refused already, and one cause gets one
        // diagnostic. Its refusal names the position; a second one here would
        // point at the same mistake from the other side.
        return no_ty()
    } else {
        // A typed receiver: its shape decides.
    }
    if @ctx.tys.kind_of(recv_t) != TypeKind.TkApp {
        @report_first_leaf_of(kids, "outside the subset: indexing is compiled for `[]T` only -- this receiver is not an applied type")
        return no_ty()
    } else {
        // An application: `Vec[T]` and its `[]T` spelling both land here.
    }
    if @ctx.tys.arg_count(recv_t) != 1 {
        @report_first_leaf_of(kids, "outside the subset: indexing is compiled for a ONE-argument application (`[]T`), and this receiver has more")
        return no_ty()
    } else {
        // One argument: it is the element.
    }
    @type_expr(kids[2])
    ro idx_t = type_of(kids[2], @ctx, @scope, @chan)
    // The comparison goes through `prims`, the door to the seeded primitive ids
    // (the CommonTypes model) -- comparing against a number or against the
    // spelling of a name would be the hard-coded shape this compiler refuses.
    //
    // And the refusal says SUBSET, not language, because the language is wider:
    // measured 2026-08-30, the oracle accepts `xs[i]` with `i` of type `u8`.
    // The earlier wording ("an index must be `int`") stated a rule that does
    // not exist -- the same defect this window spent the day removing from
    // other refusals, written by hand into a new one.
    if is_ty(idx_t) && idx_t != @ctx.prims.int_id {
        @report_first_leaf_of(kids, "outside the subset: only an `int` index is compiled yet -- the language allows other integer types here")
        return no_ty()
    } else {
        // Either an int, or already refused where it was typed.
    }
    // READ, BUT NOT COMPILED YET -- and said by name rather than accepted.
    //
    // The element type above is correct and the receiver is a real vector; what
    // is missing is on the EMITTER's side: the interop shell carries no `index`
    // for this instance. Measured 2026-08-31 -- `grep Vec____nova_int_method_index
    // novac/src/emit_c/shell.tpl.c` finds nothing, while `_method_get` (which
    // answers `Option[T]`) and `_method_len` are there. `@index(i int) -> T`
    // does exist in std (`std/src/collections/vec/access.nv:30`); the shell only
    // carries what the probe program uses.
    //
    // Accepting the form anyway is the shape the differential guard calls the
    // worst kind of green: `check` clean, `emit` an ICE ("binding initializer is
    // neither a match, a ctor nor an expression"). So the subset refuses, and the
    // refusal names WHAT is missing and WHERE -- the fix is a wider probe, not a
    // change to the program being compiled.
    @report_first_leaf_of(kids, "outside the subset: indexing is read but not compiled yet (E2-b) -- the interop shell carries no `index` for this instance, so widen novac/probe/shell_probe.nv")
    no_ty()
}

/// The type of an array literal, or `no_ty()` after a NAMED refusal.
///
/// Four refusals, each its own text (D420): an empty literal (the oracle
/// COMPILES it and panics at run time on `of`'s contract -- accepting it here and
/// not panicking would diverge in behaviour, so the subset refuses); elements of
/// differing types; a form the subset does not take (spread, a named argument, a
/// constructor other than `of`); and the one this wave exists for -- an element
/// type for which the SHELL carries no instance. That last refusal names the
/// shell and the type, because the fix is not in the program: the interop surface
/// is the probe program, and widening it is a visible edit.
fn Checker mut @type_array_lit(init Node) -> TyId {
    ro kids = branch_children(init)
    ro elems = literal_elems(kids)
    if Some(ctor) = literal_ctor_name(kids) {
        if ctor != LITERAL_CTOR {
            @report_first_leaf_of(kids, "outside the subset: a typed array literal is written `[]T.${LITERAL_CTOR}(...)` -- this constructor is not the literal form")
            return no_ty()
        } else {
            // The literal constructor: judged as a literal below.
        }
    } else {
        // The bracket form has no constructor to judge.
    }
    if elems.len() == 0 {
        @report_first_leaf_of(kids, "outside the subset: an empty array literal -- the oracle panics on it at run time (`${LITERAL_CTOR}` requires at least one element), and novac refuses rather than diverge")
        return no_ty()
    } else {
        // At least one element: its type leads.
    }
    for e in elems {
        if e.kind_of() == NodeKind.ArraySpread {
            @report_first_leaf_of(kids, "outside the subset: a spread `...xs` inside an array literal is not compiled yet")
            return no_ty()
        } else if e.kind_of() == NodeKind.NamedArg {
            @report_first_leaf_of(kids, "outside the subset: an array literal takes positional elements only")
            return no_ty()
        } else {
            // An expression element: typed below.
        }
    }
    // ELEMENT TYPE: the written one for `[]T.of`, the first element's for `[..]`.
    mut elem_t = no_ty()
    if Some(hn) = literal_head_name(kids) {
        elem_t = @ctx.ty_of_name(hn) ?? no_ty()
        if !is_ty(elem_t) {
            @report_first_leaf_of(kids, "outside the subset: novac does not know this element type yet")
            return no_ty()
        } else {
            // A known element type: every element must be of it.
        }
    } else {
        // Bracket form: decided by the first element below.
    }
    mut i = 0
    for e in elems {
        ro before = @out.len()
        @type_expr(e)
        if @out.len() > before { return no_ty() }
        ro et = type_of(e, @ctx, @scope, @chan)
        if !is_ty(elem_t) {
            elem_t = et
        } else if et != elem_t {
            @report_first_leaf_of(kids, "outside the subset: element ${i + 1} is ${ty_source_name(@ctx, et)}, but the literal's elements are ${ty_source_name(@ctx, elem_t)}")
            return no_ty()
        } else {
            // Same type as the literal's: fine.
        }
        i += 1
    }
    ro lit_t = slice_term_of(elem_t, @ctx.types, @ctx.defs, @ctx.tys)
    if !is_ty(lit_t) {
        @report_first_leaf_of(kids, "outside the subset: the slice head `${SLICE_HEAD}` is not among the declarations novac was handed")
        return no_ty()
    } else {
        // The term exists; whether the SHELL can build it is the last question.
    }
    // THE SHELL DECIDES, by name (sub-plan L). Both the constructor and the
    // push must be carried: a literal is built with exactly those two, and
    // asking for one would let the other fail in clang.
    ro ctor = c_instance_ctor(@ctx, lit_t)
    ro push = c_instance_method(@ctx, lit_t, LITERAL_PUSH)
    if !@ctx.interop.has(ctor) || !@ctx.interop.has(push) {
        @report_first_leaf_of(kids, "outside the subset: the shell novac links into carries no `${SLICE_HEAD}` instance for ${ty_source_name(@ctx, elem_t)} -- the interop surface is the probe program (novac/probe/shell_probe.nv); a literal of this element type arrives when the probe uses one, or with the prelude")
        return no_ty()
    } else {
        // Carried: the emitter prints exactly these two names.
    }
    lit_t
}

/// One text for the rule.
const SELF_INIT_MSG = "outside the subset: a binding's initializer refers to the name it binds"

/// Does the initializer read the binding that is being declared?
///
/// The question is asked through the NAME DOOR, not by comparing identifier
/// text: `names.NameTable` is the one place where a name becomes an id
/// (rule 1 of the resolve discipline, and its guard is right to insist --
/// my first version compared identifier TEXT against the declared name in
/// a walk, which is the linear resolve the rule bans). The declared name
/// goes into a one-entry table owned by the Checker, every identifier leaf
/// is asked for its id, and the comparison is on integers.
#realtime nogc
fn Checker @init_reads_self(n Node) -> bool {
    match n {
        Leaf(t) => leaf_kind(n) == TokenKind.Ident && @self_probe.find(t.text) >= 0
        Branch { children, .. } => {
            mut found = false
            for c in children {
                // A flag that only turns on IS a disjunction (P31).
                found = found || @init_reads_self(c)
            }
            found
        }
    }
}


/// A match: the scrutinee's type is the answer the emitter needs (it declares
/// the C temporary with it); the arms bind their binders and are typed after.
/// One text for the method-declaration limit. novac does not DECLARE methods
/// in the subset (it reads std's declarations to build the method table, P5);
/// the form is parsed so the refusal can name it.
const METHOD_DECL_MSG = "outside the subset: novac does not declare methods yet (the form is read from std declarations only)"

/// One text for the exhaustiveness rule; the oracle's own code is named so a
/// reader can find the other half of the story.
const NOT_EXHAUSTIVE_MSG = "outside the subset: match on a sum leaves a variant uncovered (oracle: E_MATCH_NON_EXHAUSTIVE, registry 703)"

/// One text for the rule: the reader must not guess whether two wordings
/// mean two limits.
const ARMS_DISAGREE_MSG = "outside the subset: match arms produce different types (no arm coercion before E2-b3)"

