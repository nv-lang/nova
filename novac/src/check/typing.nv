// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `FnCtxt` (the pass that types a body and WRITES its results
// into per-body side tables) and Go `types2.Checker` walking statements with
// one receiver holding the scope; rustc `Rib` for "a block is a frame you
// push and pop" (taken as an undo trail, not a chain of tables, so the name
// door stays one integer lookup); Donor: none for the mirroring rule -- that
// this walk records exactly what the emitter asks, node for node, is an
// E2-b1 decision so that "the corpus behaves identically" is a property of
// construction rather than of luck; NOT taken: rustc `InferCtxt` and its
// unification (E2-b3), Go `types2` block-scoped Scope objects.
// Role: layer 7's writing half — the pass that types a clean file and publishes the channel.
// Used by: check (the subset walk calls it once the verdict is clean); nothing else may call it — the channel is the
// interface.
// Guarded by: check-novac-no-silent-skip.sh (no branch decides nothing), check-novac-channel-one-writer.sh (only this
// module writes the channel), check-novac-match-exhaustive.sh (every sum answered), check-novac-file-size.sh (this file
// exists because check.nv crossed 1000 lines).
// novac/src/check/typing.nv — the typing walk and the lattice it uses.
//
// Split out of check.nv when that file crossed the thousand-line limit
// (2026-08-16). The seam is honest rather than arithmetic: check.nv judges
// the SHAPE of a file against the subset, this file decides its TYPES and
// records them. Both are the same module (a folder is one module of co-equal
// files), so `Checker` and its state are shared without exporting anything.

module novac.check

import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, BinOp, UnOp, bin_op_of, un_op_of}
import ../diag.{ice}
import ../builtins.{ENTRY_FN, PRINT_FN, is_bool_literal}
import ../names.{NameTable, NamespaceId}
import ../sem.{Ctx, CheckOut, DefKind, candidates_from, branch_children, call_callee_text, is_expr_kind, leaf_text, leaf_kind, expr_leaf_name}

// ---- the type channel: what the checker decided ---------------------------
//
// The walk below MIRRORS the emitter's demand, node for node and in the same
// order, and records the answer instead of letting the backend ask later.
// Mirroring is deliberate and stated: at E2-b1 the channel's job is to move
// the ANSWER, not to change it, so "the corpus behaves identically" is a
// property of construction rather than of luck. The total walk over every
// node (which the LSP needs) arrives with the real checker at E2-b3; until
// then a node the emitter never asks about carries no entry, and the reader
// doors are total so that a wrong assumption dies loudly instead of quietly
// re-deriving.
//
// Scope discipline is the emitter's, exactly: one flat Scope per function
// body, last bind wins, nothing is ever unbound. Block scoping arrives with
// the real checker; copying today's rule is what keeps the recorded types
// identical to the computed ones.

/// Every function of the file, in source order.
fn Checker mut @type_file(file Node) -> () {
    match file {
        Leaf(_) => {}
        Branch { kind, children, .. } => {
            assert(kind == NodeKind.File, "check: the typing walk was handed a root that is not a File")
            for c in children {
                if c.kind_of() == NodeKind.FnDecl { @type_fn(c) }
            }
        }
    }
}

/// One function: fresh scope, parameters bound, then the body.
fn Checker mut @type_fn(f Node) -> () {
    ro kids = branch_children(f)
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a fn declaration needs a name")
        return
    }
    ro name = leaf_text(kids[1])
    @scope = Scope.new()
    if name != ENTRY_FN {
        for c in kids {
            if c.kind_of() == NodeKind.Param {
                ro pk = branch_children(c)
                if pk.len() > 1 && pk[1].kind_of() == NodeKind.LeafNode {
                    if leaf_kind(pk[1]) == TokenKind.Ident {
                        // FIRST FLOOR for a type novac does not know (owner
                        // 2026-08-16, "not all builtin types are parsed --
                        // does that make sense?"). Its universe is four
                        // primitives; the language has the integer family,
                        // f32, char and byte besides. A `u8` parameter used
                        // to pass the shape test, get silently dropped by the
                        // collector, and then die as an ICE -- a compiler-bug
                        // message on valid Nova the oracle accepts. A narrow
                        // subset is legitimate; a subset whose boundary is an
                        // ice is not.
                        ro pt = @ctx.defs.type_id(leaf_text(pk[1]))
                        if pt < 0 {
                            match pk[1] {
                                Leaf(tt) => @refuse(tt, "outside the subset: novac does not know this type yet (its universe is int, str, bool, f64 and the types this file declares)")
                                Branch { .. } => {}
                            }
                            return
                        }
                        @scope.bind(leaf_text(pk[0]), pt)
                    }
                }
            }
        }
    }
    for c in kids {
        if c.kind_of() == NodeKind.Block { @type_block(c) }
        if c.kind_of() == NodeKind.FnExprBody {
            ro ek = branch_children(c)
            ro e = ek[ek.len() - 1]
            if e.kind_of() == NodeKind.MatchExpr {
                @type_match(e)
            } else if is_expr_kind(e.kind_of()) {
                @type_expr(e)
            }
        }
    }
}

/// Statements of a block, in order.
fn Checker mut @type_block(b Node) -> () {
    ro mark = @scope.mark()
    for c in branch_children(b) {
        match c {
            Leaf(_) => {}
            Branch { .. } => @type_stmt(c)
        }
    }
    @scope.release(mark)
}

/// One statement. A kind the subset does not know is NOT typed and NOT iced:
/// the emitter refuses it at its own door, and a second death here would only
/// move the message.
fn Checker mut @type_stmt(st Node) -> () {
    ro k = st.kind_of()
    if k == NodeKind.Call {
        @type_call_stmt(st)
    } else if k == NodeKind.IfStmt || k == NodeKind.WhileStmt {
        ro kids = branch_children(st)
        if kids.len() > 2 {
            @type_expr(kids[1])
            @type_block(kids[2])
        }
    } else if k == NodeKind.RetStmt {
        ro kids = branch_children(st)
        if kids.len() > 1 { @type_expr(kids[1]) }
    } else if k == NodeKind.BindStmt {
        @type_bind(st)
    } else if k == NodeKind.AssignStmt {
        ro kids = branch_children(st)
        if kids.len() > 2 {
            @type_expr(kids[2])
            // The emitter needs the value's type to pick the form of a
            // compound assignment (int helper, raw C, or fmod), and it may
            // only READ it.
            if @out.len() == 0 { @record(kids[2], type_of(kids[2], @ctx, @scope)) }
        }
    } else if k == NodeKind.ForStmt {
        ro kids = branch_children(st)
        if kids.len() > 4 {
            ro range = branch_children(kids[3])
            if range.len() > 2 {
                @type_expr(range[0])
                @type_expr(range[2])
            }
            // The loop variable is bound AFTER the range is typed and BEFORE
            // the body -- the emitter's order (a range expression cannot see
            // the variable it defines).
            ro mark = @scope.mark()
            @scope.bind(leaf_text(kids[1]), @ctx.prims.int_id)
            @type_block(kids[4])
            @scope.release(mark)
        }
    } else if is_expr_kind(k) {
        @type_expr(st)
    }
}

/// A println statement: each argument carries its own printer, so each
/// argument's type is a recorded answer. The callee is not resolved --
/// println is the subset's one builtin and lives in no registry.
fn Checker mut @type_call_stmt(call Node) -> () {
    ro kids = branch_children(call)
    // SILENT-OK: a statement call that is not println was already refused by
    // report_if_bad_call_stmt in the subset walk, so this walk has nothing
    // left to decide about it.
    if call_callee_text(kids) != PRINT_FN { return }
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Lit {
            // A string literal argument goes to the literal pool by SHAPE, not
            // by type; the emitter never asks its type, and the channel holds
            // answers, not decoration. A numeric literal does get asked, so
            // the shape test below is on the literal's own token.
            if leaf_kind(branch_children(c)[0]) != TokenKind.StrLit {
                @record(c, type_of(c, @ctx, @scope))
            }
        } else if is_expr_kind(ck) {
            // Children FIRST: the walk is what verifies that every name and
            // field in this argument exists, and only a verified expression
            // may be handed to the lattice (whose miss is an ice, not a
            // diagnostic, until #700).
            @type_expr(c)
            if @out.len() > 0 { return }
            ro at = type_of(c, @ctx, @scope)
            // The printer set is int/str/bool/f64. Every other primitive is
            // NAMEABLE (the universe holds all fifteen) but not yet
            // printable, and that boundary belongs here -- the emitter's ice
            // for a missing printer must never be the first answer.
            if !@has_printer(at) {
                @report_first_leaf_of(branch_children(c), "outside the subset: println covers int, str, bool and f64 today")
                return
            }
            @record(c, at)
        }
    }
}

/// A binding. The initializer's type is decided BEFORE the initializer's own
/// binders exist -- the emitter's order, kept because changing it would change
/// which programs compile (a match whose first arm uses its binders is
/// refused today, and that refusal is a fact of the subset, not an accident
/// of this walk).
fn Checker mut @type_bind(st Node) -> () {
    ro kids = branch_children(st)
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a binding needs a name and an initializer")
        return
    }
    ro vname = leaf_text(kids[1])
    ro init = kids[kids.len() - 1]
    ro ik = init.kind_of()
    // A plain expression initializer is verified before it is typed. A match
    // initializer is NOT: the emitter decides its type before the arms bind
    // their binders, and that order is what makes "a match whose first arm
    // uses its binders" a refusal of the subset rather than a silent success.
    if ik != NodeKind.MatchExpr && ik != NodeKind.RecordCtor && is_expr_kind(ik) {
        @type_expr(init)
        if @out.len() > 0 { return }
    }
    // A binding whose initializer mentions the name it binds is REFUSED
    // (274.3/F28). Measured 2026-08-17, and the measurement is why this is a
    // refusal and not a fix: `ro x = 7` then, inside a block,
    // `ro x = x < 3` prints `true` for x = 7 AND for x = 1, while
    // `ro x = x + 100` prints exactly 100. The inner name is visible in its
    // own initializer and reads as ZERO -- in the ORACLE, not only here. Both
    // compilers agree, so the differential gate is green while the answer is
    // wrong; that is the shape a silent miscompilation takes.
    //
    // Until the spec says what the form means (escalated with the probe), the
    // subset refuses it. Rust reads the OUTER binding here (`let x = x + 1`),
    // which is the reading I expect to win, but expecting is not knowing.
    @self_probe.clear()
    @self_probe.put(vname, 0)
    if @init_reads_self(init) {
        @report_first_leaf_of([]Node.of(init), SELF_INIT_MSG)
        return
    }
    ro vtype = type_of(init, @ctx, @scope)
    @record(init, vtype)
    if ik == NodeKind.MatchExpr {
        @type_match(init)
    } else if ik == NodeKind.RecordCtor {
        for c in branch_children(init) {
            ro ck = c.kind_of()
            if ck == NodeKind.CtorSpread {
                ro sk = branch_children(c)
                if sk.len() > 1 { @type_expr(sk[1]) }
            } else if ck == NodeKind.CtorField {
                ro fk = branch_children(c)
                if fk.len() > 2 { @type_expr(fk[2]) }
            }
        }
    }
    @scope.bind(vname, vtype)
}

/// One text for the rule.
const SELF_INIT_MSG = "outside the subset: a binding's initializer refers to the name it binds"

/// Does the initializer read the binding that is being declared?
///
/// The question is asked through the NAME DOOR, not by comparing identifier
/// text: `names.NameTable` is the one place where a name becomes an id
/// (rule 1 of the resolve discipline, and its guard is right to insist --
/// my first version compared identifier TEXT against the declared name in
/// a walk, which is the linear resolve the rule bans). The declared name
/// goes into a one-entry table owned by the Checker, every identifier leaf
/// is asked for its id, and the comparison is on integers.
#realtime nogc
fn Checker @init_reads_self(n Node) -> bool {
    match n {
        Leaf(t) => leaf_kind(n) == TokenKind.Ident && @self_probe.find(t.text) >= 0
        Branch { children, .. } => {
            mut found = false
            for c in children {
                if @init_reads_self(c) { found = true }
            }
            found
        }
    }
}


/// A match: the scrutinee's type is the answer the emitter needs (it declares
/// the C temporary with it); the arms bind their binders and are typed after.
/// One text for the rule: the reader must not guess whether two wordings
/// mean two limits.
const ARMS_DISAGREE_MSG = "outside the subset: match arms produce different types (no arm coercion before E2-b3)"

/// A match: the scrutinee's type is the answer the emitter needs (it declares
/// the C temporary with it); the arms bind their binders and are typed after.
fn Checker mut @type_match(m Node) -> () {
    ro kids = branch_children(m)
    if kids.len() < 2 {
        @report_first_leaf_of(kids, "outside the subset: a match needs a scrutinee")
        return
    }
    ro scr = kids[1]
    @type_expr(scr)
    if @out.len() > 0 { return }
    ro scr_t = type_of(scr, @ctx, @scope)
    @record(scr, scr_t)
    mut first_t = -1
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        ro at = @type_arm(c, scr_t)
        if at < 0 { continue }
        if first_t < 0 {
            first_t = at
        } else if at != first_t && @out.len() == 0 {
            @report_first_leaf_of([]Node.of(c), ARMS_DISAGREE_MSG)
        }
    }
}

/// (rule lives in @type_match now) Every arm of a match must produce the SAME type -- and until 2026-08-17
/// nobody checked, because `type_of` took the FIRST arm's type and the
/// comment beside it said the arms "agree by construction".
///
/// They do not. Probe: `match n { 1 => 10  _ => 2.5 }` in a `-> f64` fn.
/// The emitted C declared `nova_int _novac_match_r`, then assigned
/// `((nova_f64)2.5)` into it, so the program returned 2 where the oracle
/// returns 2.5 -- valid C, wrong answer, no diagnostic anywhere. That is the
/// worst shape a defect can take (class K-C), and it survived because a
/// comment stood where a check belongs.
///
/// The subset REFUSES disagreement rather than unifying it. Unification here
/// would mean an expected type flowing down into the arms (the oracle has
/// it: the `-> f64` return coerces the integer literal), and that is
/// bidirectional inference -- E2-b3 work, not a patch. Refusing is the safe
/// direction: narrower than the language, never wider.

/// One arm: binders first (payload fields of a variant pattern, or the whole
/// scrutinee under a plain binder), then the guard and the arm's value --
/// the emitter's order exactly.
/// Returns the arm BODY's type, and the return value is the whole point:
/// the binders of a pattern live only until `release(mark)` below, so the
/// body's type can be computed HERE and nowhere later. The first version of
/// the arm-agreement rule (F36) asked for it after the walk, outside the
/// scope, and turned a clean `match s { A(r) => r  B(w, h) => w * h }` into a
/// diagnostic -- the binders were gone by then.
fn Checker mut @type_arm(arm Node, scr_t int) -> int {
    // An arm's binders live in the arm and nowhere else.
    ro mark = @scope.mark()
    ro ak = branch_children(arm)
    if ak.len() < 1 {
        @report_first_leaf_of(ak, "outside the subset: a match arm needs a pattern and a value")
        return -1
    }
    ro pat = branch_children(ak[0])
    if pat.len() < 1 {
        @report_first_leaf_of(ak, "outside the subset: a match arm needs a pattern")
        return -1
    }
    ro p0 = pat[0]
    mut vrow = -1
    if leaf_kind(p0) == TokenKind.Ident {
        ro d = @ctx.defs.find(leaf_text(p0))
        if d >= 0 {
            ro def = @ctx.defs.rows[d]
            if def.kind == DefKind.DefVariant { vrow = def.payload }
        }
    }
    if vrow >= 0 {
        mut pi = 0
        mut j = 2
        while j < pat.len() {
            ro pj = pat[j]
            if pj.kind_of() == NodeKind.LeafNode {
                if leaf_kind(pj) == TokenKind.Ident {
                    @scope.bind(leaf_text(pj), @ctx.payload_types[@ctx.variant_rows[vrow].payload_off + pi])
                    pi += 1
                }
            }
            j += 1
        }
    } else if leaf_kind(p0) == TokenKind.Ident && leaf_text(p0) != "_" {
        @scope.bind(leaf_text(p0), scr_t)
    }
    for g in ak {
        if g.kind_of() == NodeKind.Guard {
            ro gk = branch_children(g)
            if gk.len() > 1 { @type_expr(gk[1]) }
        }
    }
    ro body = ak[ak.len() - 1]
    @type_expr(body)
    mut body_t = -1
    if @out.len() == 0 { body_t = type_of(body, @ctx, @scope) }
    @scope.release(mark)
    body_t
}

/// One expression: record what the emitter asks about, walk what it emits.
fn Checker mut @type_expr(e Node) -> () {
    ro k = e.kind_of()
    if k == NodeKind.Name {
        // FIRST FLOOR. An unbound name is a USER mistake, and check is where a
        // user mistake becomes a diagnostic with a position. Before this, the
        // lattice met it and called it a compiler bug (an ice) -- caught by
        // the mutation fuzzer on truncated files, three of 192.
        ro nk = branch_children(e)
        if nk.len() > 0 {
            match nk[0] {
                Leaf(t) => {
                    if !is_bool_literal(t.text) && !@scope.is_bound(t.text) {
                        @refuse(t, "unknown name: nothing with this name is bound at this point")
                    }
                }
                Branch { .. } => {}
            }
        }
    } else if k == NodeKind.FieldAccess {
        // REACHABLE, unlike the three above: `s.` with nothing after the dot
        // gives two children (parse stops rather than inventing a name), and
        // that is a USER mistake -- so it is a refusal, at the dot.
        ro kids = branch_children(e)
        if kids.len() < 3 {
            @report_first_leaf_of(kids, "outside the subset: a field access needs a name after the dot")
            return
        }
        @type_expr(kids[0])
        if @out.len() > 0 { return }
        // Same first floor for a field: the owner is known now, so "this type
        // has no such field" is answerable here, at the field's own position.
        ro owner = type_of(kids[0], @ctx, @scope)
        match kids[2] {
            Leaf(t) => {
                if !@ctx.fields.has_field(owner, t.text) {
                    @refuse(t, "unknown field: this type has no field with this name")
                }
            }
            Branch { .. } => {}
        }
    } else if k == NodeKind.MethodCall {
        ro kids = branch_children(e)
        if kids.len() < 3 {
            @report_first_leaf_of(kids, "outside the subset: a method call needs a name after the dot")
            return
        }
        // The receiver's type is what the mangling door takes; the callee row
        // itself is NOT recorded yet, because the door still mangles from the
        // receiver type rather than from a declaration (that flip is the
        // instance door of E2-b2).
        @type_expr(kids[0])
        if @out.len() == 0 { @record(kids[0], type_of(kids[0], @ctx, @scope)) }
        mut i = 0
        for c in kids {
            if i > 2 && is_expr_kind(c.kind_of()) { @type_expr(c) }
            i += 1
        }
    } else if k == NodeKind.Call {
        ro kids = branch_children(e)
        ro cname = call_callee_text(kids)
        ro d = @ctx.defs.find(cname)
        // FIRST FLOOR, found by probing the guards above (2026-08-16): a
        // trailing `1 +` or `!` swallows the NEXT statement as its operand,
        // so `println(...)` lands in expression position -- and `println` is
        // the subset's one builtin, present in no registry. The lattice then
        // called that a compiler bug and panicked `novac check`. It is a user
        // mistake: an unknown callee in a value position is refused here, at
        // the call's own name.
        if d < 0 {
            @report_first_leaf_of(kids, "outside the subset: this name is not a callable novac knows in an expression (println is a statement here, not a value)")
            return
        }
        if d >= 0 {
            ro def = @ctx.defs.rows[d]
            if def.kind == DefKind.DefVariant || def.kind == DefKind.DefFn {
                @chan.record_callee(e.id_of(), def.kind, def.payload)
            }
        }
        for c in kids {
            if is_expr_kind(c.kind_of()) { @type_expr(c) }
        }
    } else if k == NodeKind.Paren {
        // The parser builds `( expr )` with three children ALWAYS (the
        // closing paren is a zero-width MissingToken when absent), so a
        // shorter one is a broken invariant, not a shape to skip. A silent
        // `return` here used to leave the node untyped, and the hole then
        // surfaced as "no type recorded" from the channel -- an ice about the
        // wrong thing, in the wrong module, one pass later (owner's question
        // 2026-08-16: "what does this return mean?" -- it meant nothing good).
        ro kids = branch_children(e)
        assert(kids.len() >= 3, "check: a parenthesised expression without its three parts")
        @type_expr(kids[1])
        if @out.len() == 0 { @record(e, type_of(e, @ctx, @scope)) }
    } else if k == NodeKind.Unary {
        // Same reasoning: the parser builds `op operand`, two children, always.
        ro kids = branch_children(e)
        assert(kids.len() >= 2, "check: a prefix operator without its operand")
        @type_expr(kids[1])
        if @out.len() > 0 { return }
        if @report_if_unary_needs_protocol(kids) { return }
        @record(e, type_of(e, @ctx, @scope))
    } else if k == NodeKind.Bin {
        // And again: `left op right`, three children, by construction.
        ro kids = branch_children(e)
        assert(kids.len() >= 3, "check: a binary expression without its three parts")
        // Operands first (they are what can be unknown), then the answer for
        // THIS node: the whole expression's type decides the emitted shape
        // (f64 is raw C, int is the checked helper).
        @type_expr(kids[0])
        @type_expr(kids[2])
        if @out.len() > 0 { return }
        if @report_if_operator_needs_protocol(kids) { return }
        // The OPERANDS' types are recorded too: equality on `str` is a method
        // call, not a C operator, so the emitter must know what it compares —
        // and it may only READ that, never work it out (the channel rule).
        @record(kids[0], type_of(kids[0], @ctx, @scope))
        @record(kids[2], type_of(kids[2], @ctx, @scope))
        @record(e, type_of(e, @ctx, @scope))
    }
}

/// In Nova EVERY operator dispatches through a protocol on a user type
/// (D46/D363: `a + b` is `a.@plus(b)`, `a < b` is `a.@compare(b) < 0`,
/// `a == b` is `a.@equal(b)`), and the subset does not do that dispatch yet.
/// So the C form is a function of the operator AND the operand type, not of
/// the operator alone -- owner's correction 2026-08-16.
///
/// Until the protocol path exists (it needs bounds, E2-b3), an operator whose
/// operands are not the primitives the subset can emit is an honest refusal
/// at the operator's own position -- not the ice the lattice would raise one
/// level down, and not a silently wrong primitive emission.
/// Returns whether it refused.
fn Checker mut @report_if_operator_needs_protocol(kids []Node) -> bool {
    ro lt = type_of(kids[0], @ctx, @scope)
    ro rt = type_of(kids[2], @ctx, @scope)
    ro op = bin_op_of(leaf_kind(kids[1]))
    ro numeric = @is_numeric(lt) && @is_numeric(rt)
    ro ints = lt == @ctx.prims.int_id && rt == @ctx.prims.int_id
    ro bools = lt == @ctx.prims.bool_id && rt == @ctx.prims.bool_id
    ro same_prim = lt == rt && @is_primitive(lt)
    // Each operator states WHICH operands the subset can emit for it. The
    // match is exhaustive, so a new operator cannot slip in without an
    // answer -- and the answer is a refusal, never a guess.
    match op {
        Add | Sub | Mul | Div | Modulo => { if numeric { return false } }
        Less | LessEq | Greater | GreaterEq => { if numeric { return false } }
        Equal | NotEqual => { if same_prim { return false } }
        AndAlso | OrElse => { if bools { return false } }
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => { if ints { return false } }
        Range => { if numeric { return false } }
    }
    match kids[1] {
        Leaf(t) => @refuse(t, "outside the subset: this operator on these operands dispatches through a protocol (D46: @plus / @compare / @equal), and protocol dispatch arrives with bounds")
        Branch { .. } => {}
    }
    true
}

/// Does the subset know how to print this type? The emitter has one printer
/// per type and no generic path; a type outside the set is a refusal here,
/// never an ice there.
fn Checker @has_printer(t int) -> bool =>
    t == @ctx.prims.int_id || t == @ctx.prims.str_id || t == @ctx.prims.bool_id || t == @ctx.prims.f64_id

/// The two types arithmetic and ordering accept in the subset.
fn Checker @is_numeric(t int) -> bool => t == @ctx.prims.int_id || t == @ctx.prims.f64_id

/// Every primitive of novac's universe -- equality accepts any of them, as
/// long as both sides are the SAME one (mixed-type equality is a conversion
/// question the subset does not answer).
fn Checker @is_primitive(t int) -> bool =>
    t == @ctx.prims.int_id || t == @ctx.prims.f64_id || t == @ctx.prims.bool_id || t == @ctx.prims.str_id

/// The prefix operators the subset can emit: `!` on bool, `-` and `~` on int
/// (and `-` on f64). Everything else is protocol dispatch (`@neg`, `@bitnot`)
/// and is refused at the operator's own position. Returns whether it refused.
fn Checker mut @report_if_unary_needs_protocol(kids []Node) -> bool {
    ro t = type_of(kids[1], @ctx, @scope)
    match un_op_of(leaf_kind(kids[0])) {
        Not => { if t == @ctx.prims.bool_id { return false } }
        Negate => { if @is_numeric(t) { return false } }
        BitNot => { if t == @ctx.prims.int_id { return false } }
    }
    match kids[0] {
        Leaf(tk) => @refuse(tk, "outside the subset: this prefix operator on this operand dispatches through a protocol (D46: @neg / @bitnot), and protocol dispatch arrives with bounds")
        Branch { .. } => {}
    }
    true
}

/// Record a node's type through the channel's one writer door.
fn Checker mut @record(n Node, t int) -> () {
    @chan.record_type(n.id_of(), t)
}

// ---- the type lattice: the checker's own, not the registry's --------------
//
// Moved here from `sem` in the E2-b1 tail (2026-08-16). It never was registry
// matter: a registry answers "what is declared", a lattice answers "what does
// THIS expression mean here", and the second question is the checker's by
// definition (rustc `FnCtxt`, Go `types2.Checker`). Keeping it in `sem` made
// the backend able to ask it -- which it did, until the channel above took
// that away. Nothing outside `check` may call it now, and nothing does: the
// surface ratchet counts the names `sem` exports, and this move is what the
// baseline note demanded of E2-b1 ("must NARROW it, not widen it").
//
// It is the E1 lattice, unchanged in behaviour: every kind judged positively,
// no silent int default (the #652 class), the remaining ices on user mistakes
// marked and dated under [LEGACY-#700-user-error-as-ice until:E2b3].
/// Function-local scope: the NsLocals name door and the type of each
/// binding — one record, they only travel together. Shadowing = last bind
/// wins (the door's put overwrites).
type Scope {
    names NameTable /// name -> row in `types` (NsLocals namespace).
    types []int /// Type id of each binding row.
    /// The undo trail: for every binding made, the row its name pointed at
    /// BEFORE. Leaving a block restores them, which is what makes a block a
    /// scope. Donor: rustc `Rib` (a scope is a frame you push and pop) and
    /// Go `types2.Scope` parent chains -- taken as an undo trail rather than
    /// a chain of tables, because the door must stay one integer lookup
    /// (P18) and novac's blocks are shallow.
    shadowed []int
    /// The name whose previous row each trail entry belongs to, in the same
    /// order -- names and rows travel together, so the pair is two vectors
    /// addressed by one index, not a second table.
    shadowed_names []str
}

/// Empty scope with the NsLocals namespace.
fn Scope.new() -> Scope =>
    {
        names: NameTable.new(NamespaceId.NsLocals),
        types: []int.new(),
        shadowed: []int.new(),
        shadowed_names: []str.new(),
    }

/// Bind `name` to type id `t` (shadowing allowed).
fn Scope mut @bind(name str, t int) -> () {
    // Remember what this name meant before, so leaving the block can put it
    // back. A name bound for the first time remembers -1, which the door
    // reads as "unbound" -- the same sentinel `find` already returns.
    @shadowed_names.push(name)
    @shadowed.push(@names.find(name))
    @names.put(name, @types.len())
    @types.push(t)
}

/// Where the scope is right now. Entering a block takes a mark; leaving it
/// gives the mark back and every binding made in between disappears.
///
/// WHY THIS EXISTS (owner's question 2026-08-16: "a bound by name? does that
/// actually work?"). It did not. The scope was FLAT and never released, so
/// a binding made inside an `if` block stayed visible after it: novac
/// ACCEPTED `if c { ro x = 5 } println(x)` while the oracle rejects it --
/// novac accepting what the oracle refuses is the K7 half-capability class,
/// the most dangerous cell of the differential table.
fn Scope @mark() -> int => @shadowed.len()

/// Leave a block: undo every binding made since the mark, in reverse order,
/// restoring what each name meant before.
fn Scope mut @release(mark int) -> () {
    while @shadowed.len() > mark {
        ro i = @shadowed.len() - 1
        ro name = @shadowed_names[i]
        ro prev = @shadowed[i]
        @names.put(name, prev)
        ro _ = @shadowed.pop()
        ro _n = @shadowed_names.pop()
    }
}

/// Is this name bound in the current scope? The TOLERANT half of the pair
/// (the same shape as `type_id`/`type_id_of`, 274.3/F-B4): `check` asks
/// before it types, so an unbound name becomes a DIAGNOSTIC at the name's own
/// position instead of an ice from inside the lattice. Without it the first
/// floor is the second floor (the class the owner named #652).
#realtime nogc
fn Scope @is_bound(name str) -> bool => @names.find(name) >= 0

/// Type id of a bound name; an unbound name past check is an ice.
#realtime nogc
fn Scope @type_of_name(name str) -> int {
    ro row = @names.find(name)
    // [LEGACY-#700-user-error-as-ice until:E2b3] an unbound name is a USER error.
    assert(row >= 0, "check: unbound name — resolve is check's ground, no silent int default (#652 class)")
    @types[row]
}

/// Type of an expression over the tiny registry lattice. Every kind is
/// judged positively; the residual is an ice, never an int (#652 class).
#realtime nogc
fn type_of(e Node, ctx Ctx, scope Scope) -> int {
    ro k = e.kind_of()
    if k == NodeKind.Lit {
        // A negated literal is [Minus, lit] — judge the LAST leaf.
        ro lk_kids = branch_children(e)
        ro lk = leaf_kind(lk_kids[lk_kids.len() - 1])
        // A table maps, so it is a match -- and its leftover branch is a
        // REFUSAL, not a guess (P21: the wildcard may only carry `None` where
        // the type declares partiality; here it carries an ice).
        match lk {
            StrLit => { return ctx.prims.str_id }
            FloatLit => { return ctx.prims.f64_id }
            IntLit => { return ctx.prims.int_id }
            _ => { ice("check: literal token kind without a type rule (#652 class)") }
        }
    }
    if k == NodeKind.Name {
        ro nm = expr_leaf_name(e)
        if is_bool_literal(nm) { return ctx.prims.bool_id }
        return scope.type_of_name(nm)
    }
    if k == NodeKind.MethodCall {
        ro kids = branch_children(e)
        assert(kids.len() >= 3, "check: method call without a name")
        ro mname = leaf_text(kids[2])
        // The return type — from the READ signature (П5): the
        // compiler does not know std method names, it reads them. Only
        // what check has already accepted reaches here, so a rejection
        // here is an ice (a poisoning-discipline violation).
        ro recv_t = type_of(kids[0], ctx, scope)
        match ctx.fns.lookup(recv_t, mname) {
            FnFound(row) => { return ctx.fns.rows[row].ret_id }
            // The set narrows BY ARGUMENT TYPES -- the language overloads on
            // parameters, so the pair (receiver, name) was never enough, and
            // now that check types the arguments it can finish the job
            // (274.3/C9, brought forward because the full primitive set let a
            // second std signature into the table: `str.contains` has both
            // `(needle str)` and `(c char)`, and until `char` existed the
            // type system filtered the second one out by accident).
            FnOverloaded(first) => {
                ro chosen = narrow_overload(kids, ctx, scope, first, recv_t)
                if chosen >= 0 { return ctx.fns.rows[chosen].ret_id }
                // [LEGACY-#700-user-error-as-ice until:E2b3] a call the user
                // wrote that matches none or several candidates is a USER
                // situation; check reports it once it owns the candidate set.
                ice("check: overload set not narrowed past check")
            }
            // [LEGACY-#700-user-error-as-ice until:E2b3] a method the user misspelled is a USER error.
            FnUnknown => { ice("check: method not in the read declarations past check") }
        }
    }
    if k == NodeKind.FieldAccess {
        ro kids = branch_children(e)
        assert(kids.len() >= 3, "check: field access without a name")
        ro recv_t = type_of(kids[0], ctx, scope)
        return ctx.fields.field_type(recv_t, leaf_text(kids[2]))
    }
    if k == NodeKind.RecordCtor {
        ro kids = branch_children(e)
        if kids[0].kind_of() == NodeKind.Name {
            return ctx.defs.type_id_of(expr_leaf_name(kids[0]))
        }
        // Anonymous `{ ...src, ... }`: the record type is the spread's.
        for c in kids {
            if c.kind_of() == NodeKind.CtorSpread {
                return type_of(branch_children(c)[1], ctx, scope)
            }
        }
        ice("check: anonymous constructor without a spread")
    }
    if k == NodeKind.Paren {
        // Parens carry no meaning of their own: the type is the inner
        // expression's, and the emitter reprints them for grouping.
        return type_of(branch_children(e)[1], ctx, scope)
    }
    if k == NodeKind.Unary {
        ro kids = branch_children(e)
        ro operand = type_of(kids[1], ctx, scope)
        match un_op_of(leaf_kind(kids[0])) {
            // `!` is strictly logical on bool and is NOT overloadable
            // (D46 AMEND 2026-08-02, @not retracted), so its answer is bool
            // and nothing else.
            Not => { return ctx.prims.bool_id }
            // `-` and `~` keep the operand's type (@neg / @bitnot on a user
            // type return Self by convention; the subset only emits the
            // primitive path and check refuses the rest).
            Negate | BitNot => { return operand }
        }
    }
    if k == NodeKind.Bin {
        ro kids = branch_children(e)
        // The RESULT type is a property of the operator, so it is decided by
        // an exhaustive match on the decision -- not by asking the token
        // whether it happens to be one of three comparisons.
        match bin_op_of(leaf_kind(kids[1])) {
            Less | LessEq | Greater | GreaterEq => { return ctx.prims.bool_id }
            Equal | NotEqual => { return ctx.prims.bool_id }
            AndAlso | OrElse => { return ctx.prims.bool_id }
            BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => { return ctx.prims.int_id }
            Range => { ice("check: a range is not an expression outside a for-head") }
            Add | Sub | Mul | Div | Modulo => {}
        }
        ro lt = type_of(kids[0], ctx, scope)
        ro rt = type_of(kids[2], ctx, scope)
        if lt == ctx.prims.f64_id || rt == ctx.prims.f64_id { return ctx.prims.f64_id }
        // Both sides must be PROVEN int — arithmetic on str/bool/records is
        // not a silent int (#652 class), it is an invariant break here.
        if lt == ctx.prims.int_id && rt == ctx.prims.int_id { return ctx.prims.int_id }
        // [LEGACY-#700-user-error-as-ice until:E2b3] `"a" + 1` is a USER error; check
        // has no operand typing yet, so today it reaches here.
        ice("check: binary arithmetic on non-numeric operands past check (#652 class)")
    }
    if k == NodeKind.MatchExpr {
        // The match's value type: its FIRST arm expression (the corpus arms
        // agree by construction; the type checker wave will judge).
        for c in branch_children(e) {
            if c.kind_of() == NodeKind.MatchArm {
                ro ak = branch_children(c)
                return type_of(ak[ak.len() - 1], ctx, scope)
            }
        }
        // [LEGACY-#700-user-error-as-ice until:E2b3] `match x { }` is a USER error;
        // neither parse nor check refuses it today.
        ice("check: match without arms past check")
    }
    if k == NodeKind.Call {
        // ONE lookup answers "what is this name" (the rustc Res model),
        // then the kind decides.
        ro d = ctx.defs.find(call_callee_text(branch_children(e)))
        assert(d >= 0, "check: call target not in the registry — no silent int default (#652 class)")
        ro def = ctx.defs.rows[d]
        if def.kind == DefKind.DefVariant { return ctx.variant_rows[def.payload].sum_id }
        if def.kind == DefKind.DefFn {
            ro ret = ctx.fns.rows[def.payload].ret_id
            assert(ret >= 0, "check: call of a fn without a declared return type (#652 class)")
            return ret
        }
        ice("check: call target is a type, not a callable (#652 class)")
    }
    ice("check: expression kind without a type rule — no silent int default (#652 class)")
}

/// The one candidate whose parameters match the call's arguments, or -1.
///
/// Overloading in Nova is by parameters (D84), so a set is narrowed by the
/// ARGUMENT TYPES and by nothing else here: no ranking, no "most specific"
/// -- either exactly one candidate takes these arguments or the caller
/// reports the situation. That is the same shape D464 gives bounds (a filter,
/// not an ordering).
fn narrow_overload(kids []Node, ctx Ctx, scope Scope, first int, recv_t int) -> int {
    mut chosen = -1
    mut hits = 0
    for row in candidates_from(ctx.fns, first, recv_t) {
        if candidate_takes(kids, ctx, scope, row) {
            chosen = row
            hits += 1
        }
    }
    if hits == 1 { return chosen }
    -1
}

/// Does this candidate take exactly the arguments written at the call site?
/// The receiver is `params[param_off]` (plan 273), so the arguments start one
/// past it.
///
/// EXACT arity is correct only while the table holds no DEFAULTED parameter
/// (owner's note 2026-08-17: "we do have parameters with default values").
/// std has them -- `str @to_int(radix int = 10)` -- and a call that omits a
/// defaulted argument passes FEWER arguments than the row has parameters, so
/// this test would reject a valid candidate. It does not bite today because
/// the parser refuses a default in the subset, so such a signature never
/// enters the table; the moment defaults are parsed, this comparison must
/// become "at least the required count, at most the declared one", and the
/// row must carry how many parameters are required. Recorded in the plan for
/// E2-b3 rather than left as a surprise.
fn candidate_takes(kids []Node, ctx Ctx, scope Scope, row int) -> bool {
    ro fd = ctx.fns.rows[row]
    mut i = 0
    mut argn = 0
    for c in kids {
        if i > 2 && is_expr_kind(c.kind_of()) {
            ro slot = fd.param_off + 1 + argn
            if argn + 1 >= fd.param_cnt { return false }
            if ctx.fns.params[slot] != type_of(c, ctx, scope) { return false }
            argn += 1
        }
        i += 1
    }
    argn + 1 == fd.param_cnt
}
