// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `FnCtxt::resolve_fully_qualified_call` -- `Type::f(args)` is a
// path resolved against the type's associated functions, then checked like
// any call; NOT taken: rustc's trait-associated lookup (a static method of a
// Nova type is a declaration of that type, nothing more).
// Role: typing of a call on a TYPE, `Type.f(args)` -- a STATIC method (274.11
//   E.10 step 4c-2): std's bodies call `RawMem.alloc(n)` and
//   `RawMem.copy_n_nonoverlapping(src, dst, n)`, which a `Vec[T]` instance over
//   a type of the program has to compile. The row is chosen among the type's
//   static methods of that name by the written arity; a generic one is
//   deduced from its arguments and made from its body when the shell lacks it.
// Used by: check/methods.nv `@type_method_call`, before the variant door (the
//   two share the spelling `Type.name(args)`).
// Guarded by: nova test novac/src/pipeline/handed_free_test.nv (the static
//   call tests), check-novac-no-silent-skip.py.

module novac.check

import ../tree.{Node, NodeKind}
import ../lex.{TokenKind}
import ../sem.{is_arg_node, arg_expr_of}
import ../sem.{branch_children, leaf_text, leaf_kind, expr_leaf_name, ty_of_decl, raw_row, no_row, FnRow}
import ../sem.{CalleeTarget, bind_slots, is_arg_value_kind, c_static_symbol}
import ../sem.{ArgSpec, ty_source_name, mode_admits}
import ../resolve.{args_misfit, ARGS_FIT, ARGS_UNBOUND}
import ../diag.{ice}
import ../types.{TyId, no_ty, is_ty}
import ../names.{raw_decl}

/// `Type.f(args)` where `Type` names a type with a STATIC method `f`: typed,
/// recorded, and answered true -- or false when the head names no type, or the
/// type declares no static `f`, and the other doors of this spelling (a sum's
/// variant, a method) judge it.
fn Checker mut @type_static_call(e Node, kids []Node) -> bool {
    // SILENT-OK: not the spelling `Name.name(args)` -- the other doors judge it.
    if kids.len() < 4 || kids[2].kind_of() != NodeKind.LeafNode { return false }
    // THE HEAD: a type's name, or a type APPLIED to arguments --
    // `HashMap[str, int].new()` (274.5 P4, `names.NameTable.new`): the parser
    // reads the run as an `Index` and leaves the judgment to the name it
    // starts with (parse/expr.nv). `applied` holds the written arguments; empty
    // for a bare head.
    mut head = kids[0]
    mut applied = []TyId.new()
    if kids[0].kind_of() == NodeKind.Index {
        match @applied_head(kids[0]) {
            // SILENT-OK: no type applied to type names -- an index, which the method door types.
            None => return false
            Some(ha) => {
                head = ha.0
                applied = ha.1
            }
        }
    } else if kids[0].kind_of() != NodeKind.Name {
        // SILENT-OK: a computed receiver is no type -- the method door judges it.
        return false
    } else {
        // A bare name: asked of the registry below.
    }
    mut head_t = no_ty()
    match @ctx.defs.def_of(expr_leaf_name(head)) {
        // SILENT-OK: the head names nothing -- the path-head door refused it already.
        None => return false
        Some(hd) => match hd.target {
            DefType(decl) => {
                head_t = if applied.len() == 0 {
                    ty_of_decl(@ctx, decl)
                } else if applied.len() == @ctx.types[raw_decl(decl)].tparam_cnt {
                    @ctx.tys.app(decl, applied)
                } else {
                    no_ty()
                }
            }
            // SILENT-OK: a function or a constant head is no type: the method door judges.
            DefFn(_) | DefConst(_) => return false
        }
    }
    // SILENT-OK: a head that is no type has no static methods to ask.
    if !is_ty(head_t) { return false }
    // A PRIMITIVE head (`str.new()`, std's `str.alloc_copy(p, n)`) names no
    // declaration: its static methods are the rows OWNED by that very type
    // (registry 1631). Until then the door answered "not mine" for it, and the
    // variant door below called it the program's error -- "this type declares
    // no static method of this name" about `fn str.new()`, which std declares.
    ro head_nominal = @ctx.tys.names_a_decl(head_t)
    ro mname = leaf_text(kids[2])
    // THE ROW, by name and written arity among the type's static methods --
    // asked BEFORE the arguments are walked, so a spelling that is not a static
    // call leaves them to the door that owns it.
    mut written = 0
    mut at = 0
    for c in kids {
        // A NAMED argument is written too (registry 1650: `Tb.row(h: "s")`
        // counted none, and the row was refused as taking no such call).
        written += if at > 2 && is_arg_node(c) { 1 } else { 0 }
        at += 1
    }
    mut row = no_row()
    mut cnt = 0
    mut named = 0
    for i in 0..@ctx.fns.rows.len() {
        ro fd = @ctx.fns.rows[i]
        if fd.name != mname || !is_ty(fd.owner) { continue }
        // A nominal head matches by its declaration (`Vec[T]` and `Vec[int]`
        // are one head); a primitive one (`int.max_value()`) by the type itself.
        if head_nominal {
            if !@ctx.tys.names_a_decl(fd.owner) { continue }
            if @ctx.tys.decl_head_of(fd.owner) != @ctx.tys.decl_head_of(head_t) { continue }
        } else if fd.owner != head_t {
            continue
        } else {
            // A static method of this very primitive.
        }
        named += 1
        // The written arguments fill the leading parameters; the rest must
        // carry defaults (D102: `Vec[T].new(cap int = 0)` takes `new()`).
        if written > fd.param_cnt { continue }
        mut rest_defaulted = true
        for k in written..fd.param_cnt {
            rest_defaulted = rest_defaulted && @ctx.fns.params[fd.param_off + k].default_expr.is_some()
        }
        if !rest_defaulted { continue }
        row = FnRow(i)
        cnt += 1
    }
    // SILENT-OK: no static method of this name -- the variant and method doors judge it.
    if named == 0 { return false }
    if cnt == 0 {
        @reject_first_leaf_of(kids, "this type declares a static method of this name, but none takes these arguments")
        return true
    } else {
        // At least one static method takes this many arguments.
    }
    ro before = @out.len()
    // The tail's expectation stays outside the call, as the free and the method
    // call have it (part 6 of p274-carina-k1): it reached the arguments, and
    // `=> Tb.id(if m { 1 } else { 0 })` in a `-> Row` body deduced `T = Row`.
    ro saved_expect = @value_expect
    @value_expect = no_ty()
    at = 0
    for c in kids {
        if at > 2 && is_arg_node(c) {
            // A NAMED argument's value too (registry 1630: std's
            // `StringBuilder.new(cap: s.byte_len() + 2)` in `str @pad_start`).
            @type_expr(arg_expr_of(c))
        } else {
            // The head, the dot, the name and the punctuation: nothing to type.
        }
        at += 1
    }
    @value_expect = saved_expect
    // SILENT-OK: an argument's own refusal is the call's one cause.
    if @out.len() > before { return true }
    // An effectful argument is hoisted into a local, and a local needs its
    // type (F65) -- the method and free call doors record them the same way.
    @record_arg_types(kids, 3)
    if cnt > 1 {
        @report_first_leaf_of(kids, "outside the subset: this type declares several static methods of this name and arity, and novac does not narrow them by argument type yet (E2-b3)")
        return true
    } else {
        // One static method: judged below.
    }
    ro fd = @ctx.fns.rows[raw_row(row)]
    // AN `unsafe fn` is called inside `unsafe { }` only, and the call is the
    // operation that makes the block necessary (D216).
    if @is_unsafe_row(row) {
        if @unsafe_depth == 0 {
            @reject_first_leaf_of(kids, UNSAFE_REQUIRED_MSG)
            return true
        } else {
            @unsafe_ops += 1
        }
    } else {
        // A safe static method: callable anywhere.
    }
    ro key = typed_args(kids, 3, @ctx, @scope, @chan)
    // THE ROW IS JUDGED, chosen or alone (registry 1650): the arguments pass
    // the question every candidate of a lookup passes (`args_misfit`, the
    // resolver's own) -- binding, type, mode. One row of the name and arity
    // used to be taken unjudged, and `Tb.row("s")` for `fn Tb.row(h int)`
    // compiled where the oracle says E7301.
    // SILENT-OK: a misfit was refused by name inside `@static_args_fit`.
    if !@static_args_fit(kids, row, key) { return true }
    mut ids = []TyId.new()
    if fd.tparam_cnt > 0 && applied.len() > 0 {
        // The instance is WRITTEN: `HashMap[str, int].new()` names its
        // arguments, and a constructor without parameters of that type has
        // nothing to deduce them from. A static method with type parameters
        // of its own beyond the type's is not compiled on this spelling yet.
        if fd.tparam_cnt != applied.len() {
            // A static method with type parameters of its OWN beyond the
            // type's: the rest of the form this wave does not compile yet.
            @report_first_leaf_of(kids, APPLIED_TYPE_MSG)
            return true
        } else {
            ids = applied
        }
    } else if fd.tparam_cnt > 0 {
        ids = match @deduce_from_args(row, key, kids) {
            // SILENT-OK: the deduction door named which of its cases it was.
            None => return true
            Some(v) => v
        }
    } else {
        // Not generic: no substitution.
    }
    // The instance's signature is interned FIRST (registry 1666): the
    // whose-body question below spells the shell's symbol, and that spelling
    // substitutes the owner (`Gbx[T]` -> `Gbx[str]`) through the door that
    // only READS the interner -- asked before the term existed, it iced
    // ("a substituted type the checker never interned") on every generic
    // static call that fit.
    @intern_instance_sig(row, ids)
    // WHOSE BODY: the PROGRAM's (another module of it -- `ConstTable.new()`
    // from novac's own `sem` in the self-build; its owner unit compiles it, as
    // a method of a program module, 274.11 E.10 step 2a), the shell's, or one
    // this unit makes from the body it was handed -- refused by the shell's
    // name when none.
    if !@ctx.in_program(row) && !@ctx.instantiates(row, ids) && !@ctx.interop.has(c_static_symbol(@ctx, row, ids)) {
        @report_first_leaf_of(kids, no_shell_method_msg(mname, expr_leaf_name(head)))
        return true
    } else {
        // Callable: recorded below.
    }
    @chan.record_callee(e.id_of(), CalleeTarget.CalleeFn(row), ids,
        bind_slots(@ctx.fns.params, fd.param_off, fd.param_cnt, key))
    @record(e, @ctx.tys.subst(fd.ret_id, ids))
    true
}

/// The refusal of a type applied to arguments where novac does not compile it
/// yet: an index run whose head is a type (binds.nv `@type_index`), and a static
/// method on one with type parameters of its own (`@type_static_call`).
const APPLIED_TYPE_MSG = "outside the subset: a type applied to arguments is read but not compiled yet (274.5 P4)"

/// The HEAD of a type applied to arguments, `HashMap[str, int]`, read from the
/// parser's `Index` run: the head's name node and the written arguments, each
/// a type's name -- or None when any argument is no type's name (an index, or a
/// form this door does not read), and the method door judges the node.
fn Checker @applied_head(ix Node) -> Option[(Node, []TyId)] {
    ro ik = branch_children(ix)
    if ik.len() < 4 || ik[0].kind_of() != NodeKind.Name { return None }
    mut args = []TyId.new()
    for i in 2..ik.len() {
        ro c = ik[i]
        if c.kind_of() == NodeKind.LeafNode { continue }
        if c.kind_of() != NodeKind.Name { return None }
        ro t = @ctx.ty_of_name(expr_leaf_name(c)) ?? no_ty()
        if !is_ty(t) { return None }
        args.push(t)
    }
    if args.len() == 0 { return None }
    Some((ik[0], args))
}

/// Intern the CONCRETE signature of instance `(row, ids)`: every parameter
/// type and the return under the substitution (274.11 E.10 step 4c-2). Mono
/// rewrites an instance's signature with `sem.subst_type`, which READS the
/// interner and calls a missing term a checker hole -- so the checker, which
/// may intern, interns it where it decides the instance exists. A `*T`
/// parameter handed a `*mut Pt` names `*Pt`, a term no expression wrote.
fn Checker mut @intern_instance_sig(row FnRow, ids []TyId) -> () {
    if ids.len() == 0 { return }
    ro fd = @ctx.fns.rows[raw_row(row)]
    for i in 0..fd.param_cnt {
        ro _ = @ctx.tys.subst(@ctx.fns.params[fd.param_off + i].type_id, ids)
    }
    if is_ty(fd.ret_id) {
        ro _ = @ctx.tys.subst(fd.ret_id, ids)
    } else {
        // No declared return: nothing to intern.
    }
    if is_ty(fd.owner) {
        ro _ = @ctx.tys.subst(fd.owner, ids)
    } else {
        // Not a static method: no owner term.
    }
}

/// Is this row an `unsafe fn` -- the keyword stands among the leaves of its
/// declaration before the name? A row read from no declaration (a builtin, a
/// constructor) is not.
fn Checker @is_unsafe_row(row FnRow) -> bool {
    ro decl = @ctx.handed.decl_of(row) ?? return false
    decl_is_unsafe(branch_children(decl))
}

/// Do these declaration children write `unsafe` before `fn`?
fn decl_is_unsafe(kids []Node) -> bool {
    for c in kids {
        if c.kind_of() != NodeKind.LeafNode { continue }
        if leaf_kind(c) == TokenKind.KwUnsafe { return true }
        if leaf_kind(c) == TokenKind.KwFn { return false }
    }
    false
}

/// Do the call's arguments fit the static method `row` -- or, refused here by
/// the slot that does not, by its cause: the binding (D102), the argument's type
/// (E7301, the oracle's word for it), or the parameter's mode (P14).
fn Checker mut @static_args_fit(kids []Node, row FnRow, key []ArgSpec) -> bool {
    ro miss = args_misfit(@ctx.fns, @ctx.tys, row, key)
    if miss == ARGS_FIT { return true }
    if miss == ARGS_UNBOUND {
        // The binding's own words, the door every call form asks (D102).
        match @binding_refusal(row, key) {
            Some(m) => @reject_first_leaf_of(kids, m)
            None => ice("check: a static call's arguments do not bind, and the binding names no fault")
        }
        return false
    } else {
        // One slot does not take its argument: named below.
    }
    ro fd = @ctx.fns.rows[raw_row(row)]
    ro p = @ctx.fns.params[fd.param_off + miss]
    ro at = bind_slots(@ctx.fns.params, fd.param_off, fd.param_cnt, key)[miss].arg_row
    ro got = key[at]
    if mode_admits(p.mode, got.cls) {
        ro gn = ty_source_name(@ctx, got.type_id)
        ro wn = ty_source_name(@ctx, p.type_id)
        @reject_first_leaf_of(kids, "cannot pass `${gn}` as argument `${p.name}` of type `${wn}` (E7301)")
    } else {
        @reject_first_leaf_of(kids, mode_refusal_msg(p, got.cls))
    }
    false
}
