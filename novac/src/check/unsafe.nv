// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_mir_build::check_unsafety` -- an unsafe block opens a
// context, an operation that needs one is checked against it, and a block that
// opened one for nothing is reported (`unused_unsafe`); NOT taken: rustc's
// unused_unsafe is a LINT, Nova's E_UNSAFE_UNUSED is an error (D216 s21).
// Role: typing of `unsafe { ... }` and of a raw pointer's `read_at` (274.11
//   E.10 step 3c; D216): the block's value is its tail (s8), a pointer
//   operation outside a block is E_UNSAFE_REQUIRED, a block with none inside is
//   E_UNSAFE_UNUSED -- both LANGUAGE errors, the oracle's own.
// Used by: exprs.nv (`@type_expr`'s Unsafe arm) and methods.nv (a method call
//   whose receiver is a raw pointer), while a body is typed.
// Guarded by: nova test novac/src/check/check_test.nv (the unsafe tests) and
//   check-novac-differential.sh over novac/fixtures/unsafe_block.

module novac.check

import ../tree.{Node}
import ../builtins.{PTR_WRITE_AT, PTR_WRITE_CONSUME_AT, PTR_OFFSET, PTR_DIST, is_ptr_method, TypeKind}
import ../sem.{branch_children, leaf_text, is_expr_kind}
import ../types.{TyId, is_ty}

/// `unsafe { ... }`: the block typed inside an unsafe context; its value, when
/// its tail is one, recorded on the node.
fn Checker mut @type_unsafe(e Node) -> () {
    ro uk = branch_children(e)
    assert(uk.len() >= 2, "check: an unsafe block without its body reached typing")
    ro ops_before = @unsafe_ops
    // A refusal INSIDE the block is its one cause: the operation it refused
    // may be the one that needed the context, so "unused" would be a second
    // diagnostic, and a guess (registry: the cascade under an instance body,
    // `"ABC".eq_ignore_ascii_case(..)` -- an unknown field, then E_UNSAFE_UNUSED).
    ro out_before = @out.len()
    @unsafe_depth += 1
    ro mark = @scope.mark()
    ro bt = @type_arm_block_value(uk[1])
    @scope.release(mark)
    @unsafe_depth -= 1
    // So is a name read POISONED (its initializer was refused earlier): the
    // operation on it was skipped in silence, not found absent (`to_ascii_lower`
    // made from std's body: `[]u8.new(cap: n)` refused, then
    // `unsafe { out.into_str_unchecked() }` called "unused").
    if @unsafe_ops == ops_before && @out.len() == out_before && !reads_poisoned(uk[1], @scope) {
        @reject_first_leaf_of(uk, UNSAFE_UNUSED_MSG)
        return
    } else {
        // An operation inside needed the context.
    }
    if is_ty(bt) {
        @record(e, bt)
    } else {
        // SILENT-OK: a statement-shaped block -- its tail is no value, and
        // every statement in it was judged by the block's own typing.
    }
}

/// A method call on a RAW POINTER (D216): `read_at` -- one `int` index, the
/// pointee's type -- inside `unsafe { }`; every other method refused by name.
fn Checker mut @type_ptr_method(e Node, kids []Node, recv_t TyId) -> () {
    // `read_at(i) -> T` and `write_at(i, v)` (D216; `write_at` from 274.11 E.10
    // step 4c-2 -- std's `Vec[T] @push` writes the element with it).
    // `write_consume_at` moves the value in: the same store, judged the same way.
    ro writes = leaf_text(kids[2]) == PTR_WRITE_AT || leaf_text(kids[2]) == PTR_WRITE_CONSUME_AT
    // `offset(n) -> *T` (D216): address arithmetic in elements, the type kept
    // (registry 1557 -- std's `Vec[T] @index(r Range)` builds its view with it).
    ro offsets = leaf_text(kids[2]) == PTR_OFFSET
    // `dist(q) -> int` (D216): the signed element count between two pointers
    // to the same pointee -- the one method whose argument is a POINTER.
    ro dists = leaf_text(kids[2]) == PTR_DIST
    if !is_ptr_method(leaf_text(kids[2])) {
        // A pointer method IS an operation that needs the context, compiled
        // or not: without the count the enclosing block was also called
        // unused -- a second diagnostic, and a false one, for one cause.
        @unsafe_ops += 1
        @report_first_leaf_of(kids, PTR_METHOD_MSG)
        return
    } else {
        // `read_at`, `read_consume_at` or a write: judged below.
    }
    if writes && !@ctx.tys.ptr_is_mut(recv_t) {
        @reject_first_leaf_of(kids, PTR_WRITE_RO_MSG)
        return
    } else {
        // A pointer this method may go through.
    }
    if @unsafe_depth == 0 {
        @reject_first_leaf_of(kids, UNSAFE_REQUIRED_MSG)
        return
    } else {
        @unsafe_ops += 1
    }
    ro elem = @ctx.tys.arg(recv_t, 0)
    mut args = 0
    mut i = 0
    for c in kids {
        if i > 2 && is_expr_kind(c.kind_of()) {
            args += 1
            ro at = type_of(c, @ctx, @scope, @chan)
            // The FIRST argument is the index; `write_at`'s second is the value,
            // of the pointee's type. `dist`'s one argument is the other pointer.
            if dists {
                if is_ty(at) && !@points_to(at, elem) {
                    @reject_first_leaf_of([]Node.of(c), "`dist` measures to a pointer of the same pointee (D216)")
                    return
                } else {
                    // A pointer to the same pointee, or one already refused.
                }
                i += 1
                continue
            } else {
                // An index or a value: judged below.
            }
            ro want = if args == 1 { @ctx.prims.int_id } else { elem }
            if is_ty(at) && at != want {
                if args == 1 {
                    @reject_first_leaf_of([]Node.of(c), INT_INDEX_MSG)
                } else {
                    @reject_first_leaf_of([]Node.of(c), "`write_at` stores a value of the pointee's type (D216)")
                }
                return
            } else {
                // The type this argument position wants, or one already refused.
            }
        } else {
            // The receiver, the dot, the name and the punctuation.
        }
        i += 1
    }
    if writes && args != 2 {
        @reject_first_leaf_of(kids, "`write_at` takes an index and a value (D216)")
        return
    } else if offsets && args != 1 {
        @reject_first_leaf_of(kids, "`offset` takes one element count (D216)")
        return
    } else if dists && args != 1 {
        @reject_first_leaf_of(kids, "`dist` takes one pointer (D216)")
        return
    } else if !writes && args != 1 {
        @reject_first_leaf_of(kids, "`read_at` takes one index (D216)")
        return
    } else {
        // The arity the method has.
    }
    if offsets {
        // The pointer moved: the same pointer type (D216).
        @record(e, recv_t)
    } else if dists {
        // A count of elements, signed (D216).
        @record(e, @ctx.prims.int_id)
    } else {
        @record(e, if writes { @ctx.prims.unit_id } else { elem })
    }
}

/// Is `t` a raw pointer to `elem` -- `*elem` or `*mut elem`? What `dist`'s
/// argument must be (D216): the count is in elements, so the pointees agree.
fn Checker @points_to(t TyId, elem TyId) -> bool {
    @ctx.tys.kind_of(t) == TypeKind.TkPtr && @ctx.tys.arg(t, 0) == elem
}
