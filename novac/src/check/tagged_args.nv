// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: ordinary call argument expectation (calls.nv); D48 specifies the sugar.
// Role: types the implicit empty args vector of a text-only tagged literal.
// Used by: type_free_call; no tag-specific overload or naming mechanism.
// Guarded by: nova test spec_tests — runtime fixture carina_text_backtick_tag.nv;
// task 137 targeted negative probes cover the refused boundaries.
module novac.check

import ../tree.{Node}
import ../types.{TyId, is_ty}
import ../builtins.{TypeKind, SLICE_HEAD, EMPTY_CTOR}
import ../sem.{decl_of_ty, ty_source_name, branch_children, leaf_text}
import ../tree.{Node, NodeKind}

/// Only the tag parser creates a leafless ArrayLit; explicit [] has brackets.
/// The expected type is the ordinary parameter's, not a hardcoded str default.
fn Checker mut @type_tag_args(arg Node, want TyId, call_kids []Node) -> () {
    if !is_ty(want) || !@ctx.tys.is_concrete(want) ||
        @ctx.tys.kind_of(want) != TypeKind.TkApp ||
        decl_of_ty(@ctx, want).name != SLICE_HEAD || @ctx.tys.arg_count(want) != 1 {
        @report_first_leaf_of(call_kids, "outside the subset: a text-only tag requires a uniquely resolved concrete vector parameter for its empty args (D48, 274.14 F2)")
        return
    }
    if !@vec_op_carried(want, EMPTY_CTOR) {
        @report_first_leaf_of(call_kids, no_shell_vec_msg(ty_source_name(@ctx, @ctx.tys.arg(want, 0))))
        return
    }
    @record(arg, want)
}

/// Is this a `NamedArg` whose name leaf is `want`? The walk's positional
/// gates open for ONE named argument at a time (`on_timeout:` of a
/// supervised, remark 5): opening them for every named argument made
/// `timeout: |_e| 0` pass the walk and die in emit as an ICE.
fn named_arg_is(c Node, want str) -> bool {
    if c.kind_of() != NodeKind.NamedArg { return false }
    ro ak = branch_children(c)
    if ak.len() < 3 { return false }
    if ak[0].kind_of() != NodeKind.LeafNode { return false }
    leaf_text(ak[0]) == want
}
