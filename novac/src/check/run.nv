// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/check/run.nv -- the RUN doors: `check` (the module's ONE entry),
// `check_instance` (one generic body under one substitution), and the one
// file-level judge that must see the file's children before any walk --
// `@reject_repeated_impl`.
//
// Donor: none -- mechanical extraction from check.nv along an existing seam
//   (decision 12's 1000-line cap), not a borrowed design: the entry doors
//   were always "a constructor plus a run" (the doc below says so), and the
//   neighbour-judge was always filed separately from the per-node walk.
// Role: layer 7 -- how a check RUN starts and ends: build the Checker, run
//   the shape walk, type the file only on a clean verdict, hand back the
//   (diagnostics, channel) pair.
// Used by: pipeline (compile/compile_with/check_instance); nothing else may
//   enter the module -- a second entry would be a second answer to one file.
// Guarded by: check-novac-file-size.py (this file exists because check.nv
//   crossed 1000 lines -- 1048 with the E4 wave's additions -- and the cap's
//   remedy is a by-meaning cut, not a baseline), the pipeline tests.
//
// A co-equal file of module `novac.check` (folder = one module), cut by
// MEANING under decision 12: check.nv keeps the Checker state and the shape
// walk; this file keeps the doors that START a run. Every name below is
// still module-private where it was -- the cut moves bodies, not borders.

module novac.check

import ../source.{SourceText}
import ../lex.{TokenKind}
import ../tree.{Node, NodeId, NodeKind, no_node, raw_node}
import ../diag.{Diagnostic}
import ../builtins.{IMPL_ATTR}
import ../sem.{Ctx, CheckOut, branch_children, file_decls, attr_kids_name, FnRow, no_row, raw_row, module_dotted}
import ../sem.{leaf_text}
import ../names.{NameTable, NamespaceId}
import ../resolve.{FnIndex, FieldIndex, PRELUDE_ASKER}
import ../types.{TyId, no_ty}

/// Check a parsed file against the E1 subset. Always returns the full list;
/// no Result (274 §4 item 1).
///
/// WHY THIS IS A FREE FUNCTION AND NOT A METHOD ON `Ctx` (owner's question,
/// 2026-08-16). `Ctx` is DATA — the type registry and the callable table.
/// Hanging a pass on it would make the registry own the pass, and then
/// `emit` would want to hang there too: `Ctx` becomes the object that knows
/// every backend, which is exactly the ownership the architecture keeps
/// apart (the rustc_middle model — `TyCtxt` holds data, passes consume it).
/// It would also invert an edge of the §3 table: `Ctx` lives in `sem`, so a
/// method on it would make `sem` reference `Diagnostic` and the checker,
/// and `check-novac-deps.py` refuses that edge by construction. What the
/// entry point IS, is a constructor plus a run — the same shape `emit_c`
/// uses for `Emitter`: the module has one door, and the receiver lives
/// behind it.
/// The channel comes back WITH the diagnostics, from ONE door: a second
/// entry point ("check, and this time also record") would be two passes
/// disagreeing about one file, which is the disease the channel cures.
///
/// The typing walk runs only on a CLEAN subset verdict. That is not a
/// convenience: the emitter's contract is already "never called on broken
/// input" (pipeline), the lattice remaining ices are user errors under
/// [LEGACY-#700-user-error-as-ice until:E2b3], and typing a file that the
/// subset already refused would turn a refusal into an ice. When #700 lands
/// the walk becomes unconditional, because then its answer on bad input is a
/// diagnostic and not a death.
export fn check(file Node, src SourceText, ctx Ctx) -> ([]Diagnostic, CheckOut) {
    // One state per constant-table row (274.5 S6): module values are typed
    // in dependency order, and this is where the walk keeps its place.
    mut mv_state = []int.new()
    for _ in 0..ctx.consts.rows.len() {
        mv_state.push(0)
    }
    mut c = Checker {
        src, ctx,
        // #1493: the file's imports; #1521: the file asks from its own module.
        res: FnIndex.build_for(ctx.fns, import_parts(file, false), import_parts(file, true),
                               module_dotted(file), module_dotted(file)),
        fres: FieldIndex.build(ctx.fields),
        gap_at: -1,
        gap_kind: TokenKind.ErrorTok,
        out: []Diagnostic.new(),
        chan: CheckOut.new(raw_node(file.id_of()) + 1),
        scope: Scope.new(), self_probe: NameTable.new(NamespaceId.NsLocals),
        seen_decls: NameTable.new(NamespaceId.NsDefs),
        tail_value_body: no_node(),
        ret_expect: no_ty(),
        value_expect: no_ty(),
        consume_kinds: []TyId.new(),
        loop_depth: 0,
        mv_state,
        mv_stack: []int.new(),
        cap_marks: []int.new(),
        cap_owners: []NodeId.new(),
        sup_depth: 0,
        unsafe_depth: 0,
        unsafe_ops: 0,
        mv_decl_rows: []int.new(),
        mv_decl_nodes: []Node.new(),
        ret_unit: false,
        ret_ro: false,
        self_ty: no_ty(),
        substs: []TyId.new(),
        inst_row: no_row(),
        home_sums: NameTable.new(NamespaceId.NsDefs),
        ret_self: false,
    }
    // THROUGH THE DOOR (P18): a raw walk over a file's children does not see
    // what sits inside an `export` wrapper, so `export #impl` would have been
    // invisible to this judge -- and invisible, not refused. `file_decls`
    // unwraps it and keeps the order, which is what a run of attributes needs.
    c.reject_repeated_impl(file_decls(file))
    // D341: a Serialize opt-in the synthesis did not spell is refused by its cause.
    c.judge_serde_fields(file_decls(file))
    c.walk(file)
    c.tell_gap_if_silent()
    if c.out.len() == 0 {
        // THE ENTRY IS A RESOLUTION (274.4 step 2): a name chain is walked to
        // find it, and after the checker nobody resolves -- mono reads the
        // channel instead of asking the registry itself.
        match c.res.entry_row(c.ctx.fns) {
            Some(r) => { c.chan.record_entry(r) }
            None => {
                // A file with no entry point: nothing to record, and mono
                // answers "nothing reachable" from the same silence.
            }
        }
        // The must-consume types, known before typing: the `mut` door asks (D476).
        c.consume_kinds = c.consume_kinds_of(file)
        c.type_file(file)
        // A non-literal default of another file, left to a call (registry 1578),
        // asked once the callees are recorded.
        c.refuse_foreign_defaults(file)
        // The consumption obligation of the file's own must-consume types (D133
        // steps 1-2), asked once every node's type and callee is recorded -- and
        // only over a file typing accepted: the join of two arms reads every
        // statement's type, and a refused one (an unknown `panic`) is not trusted.
        if c.out.len() == 0 {
            c.check_consume_flow(file)
        } else {
            // Typing refused: the types the obligation would read are not trusted.
        }
        // The disjointness walk that stood here is gone (2026-08-18): the
        // channel holds ONE sum per node now, so "a call and an
        // instantiation at once" is not a state that can be built.
    } else {
        // A refused file is not typed: the walk's answer on broken input is an
        // ice today ([LEGACY-#700-user-error-as-ice until:E2b3]), so the refusals already
        // collected ARE the verdict, and the channel goes back as the walk left it.
    }
    (c.out, c.chan)
}

/// Type ONE declaration under a substitution -- one instance of a generic
/// callable (E2-b2; donor: Go stenciling, one copy of the body per instance,
/// each typed on its own).
///
/// WHY A SEPARATE CHANNEL. The channel is keyed by `NodeId`: one node, one
/// type. Two instances of one body cannot both live in it, and the alternative
/// -- keeping the body's types parametric and substituting in every reader --
/// spreads one decision across every consumer of the channel (P18). So each
/// instance gets its own channel, sized like the file's, and the emitter reads
/// the one belonging to the instance it emits.
///
/// `cap` is the file's node capacity, not the declaration's: node ids are
/// handed out per FILE, so a declaration's nodes sit anywhere in that range.
///
/// WHOSE SCOPE (registry 221.1 #1521): `body_file` is the tree the body was
/// written in and `file_mod` the COMPILED file's module. The body's free names
/// are resolved from the body's module with its file's imports -- `helper()` in
/// a method of `hp.geo` is `hp.geo`'s helper even when the unit compiling the
/// instance (`hp`) declares one of its own.
export fn check_instance(decl Node, src SourceText, ctx Ctx, row FnRow, substs []TyId,
                         cap int, body_file Node, file_mod str) -> ([]Diagnostic, CheckOut)
    requires cap > 0, "check: an instance channel needs the file's node capacity"
{
    ro fd = ctx.fns.rows[raw_row(row)]
    ro asker = if ctx.fns.compiles_body(row) {
        file_mod
    } else if fd.handed_from == "" {
        PRELUDE_ASKER
    } else {
        fd.handed_from
    }
    mut c = Checker {
        src, ctx,
        res: FnIndex.build_for(ctx.fns, import_parts(body_file, false), import_parts(body_file, true),
                               asker, file_mod),
        fres: FieldIndex.build(ctx.fields),
        // An instance of the FILE's own body never tells its gap: syntax was
        // judged when the file was checked, and telling it again would report
        // one hole once per instantiation. A HANDED body is the other case
        // (below, after the walk): novac never compiles std's files as files of
        // their own, so its hole was told nowhere, and typing it reached the lattice with a
        // gap inside -- `Ok(())` in std's `JsonSerializer @begin_struct`, the
        // unit value novac does not parse, iced "expression kind without a
        // type rule" (task #14, 2026-10-06, registry 221.1 #1740).
        gap_at: -1,
        gap_kind: TokenKind.ErrorTok,
        out: []Diagnostic.new(),
        chan: CheckOut.new(cap),
        scope: Scope.new(), self_probe: NameTable.new(NamespaceId.NsLocals),
        seen_decls: NameTable.new(NamespaceId.NsDefs),
        tail_value_body: no_node(),
        ret_expect: no_ty(),
        value_expect: no_ty(),
        consume_kinds: []TyId.new(),
        loop_depth: 0,
        mv_state: []int.new(),
        mv_stack: []int.new(),
        cap_marks: []int.new(),
        cap_owners: []NodeId.new(),
        sup_depth: 0,
        unsafe_depth: 0,
        unsafe_ops: 0,
        mv_decl_rows: []int.new(),
        mv_decl_nodes: []Node.new(),
        ret_unit: false,
        ret_ro: false,
        self_ty: no_ty(),
        substs,
        inst_row: row,
        home_sums: if ctx.fns.compiles_body(row) {
            NameTable.new(NamespaceId.NsDefs)
        } else {
            sums_declared_in(body_file)
        },
        ret_self: false,
    }
    // THE SAME TWO PASSES AS THE FILE, over the BODY (registry 221.1 #1539): the
    // shape walk, then typing on a clean verdict. An instance used to be TYPED
    // only, so a form the subset walk refuses in a file of its own -- `ro s str
    // = @len()`, "a declared local type is not compiled yet" -- passed in an
    // instance and was emitted (printed 0; the oracle says E7301). The BODY and
    // not the declaration: the declaration's own judges (a generic declaration
    // is not compiled, the extern form, the tail rule) belong to the file that
    // wrote it, and an instance is generic by definition.
    c.tail_value_body = value_body_of(branch_children(decl))
    for k in branch_children(decl) {
        if k.kind_of() == NodeKind.Block || k.kind_of() == NodeKind.FnExprBody {
            c.walk(k)
        } else {
            // The name, the receiver, the parameters, the return type, a
            // contract: the declaration's, judged where it was written.
        }
    }
    if !ctx.fns.compiles_body(row) {
        // A handed body's hole was told nowhere else (see `gap_at` above).
        c.tell_gap_if_silent()
    } else {
        // The file's own body: its file pass told the gap already.
    }
    if c.out.len() == 0 {
        c.consume_kinds = c.consume_kinds_of(body_file)
        c.type_fn(decl)
        // The consumption obligation of the instance's body (D133 step 1): the
        // file pass skipped the generic declaration, whose types exist only here.
        if c.out.len() == 0 {
            c.check_consume_flow_instance(decl, body_file)
        } else {
            // Typing refused: the types the obligation would read are not trusted.
        }
    } else {
        // Refused by the walk: the refusals are the verdict, as for the file.
    }
    (c.out, c.chan)
}

/// `#impl` stands over a declaration ONCE (D186). Judged here and not in the
/// walk's `AttrDecl` arm, by construction: the walk sees ONE node, and this form
/// is about NEIGHBOURS. The same shape `coerce_marked` uses -- an attribute
/// belongs to the declaration that follows it, so the question is positional and
/// is asked over the file's children.
fn Checker mut @reject_repeated_impl(kids []Node) -> () {
    mut prev_impl = false
    for c in kids {
        if c.kind_of() != NodeKind.AttrDecl {
            prev_impl = false
            continue
        } else {
            // An attribute: it either starts a run or continues one.
        }
        ro is_impl = attr_kids_name(branch_children(c), IMPL_ATTR)
        if is_impl && prev_impl {
            @reject_first_leaf_of(branch_children(c), IMPL_REPEATED_MSG)
        } else {
            // First `#impl` of a run, or another attribute entirely.
        }
        prev_impl = is_impl
    }
}

/// What THIS file imported (registry 221.1 #1493, D29), for `FnIndex.build_for`:
/// with `seg` false every name in a brace list, with `seg` true the last segment
/// of the module path each of them came from -- two parallel lists, one walk
/// each. Read from the import DECLARATIONS, never from the source text, where
/// `import` in a comment would count. An import without a brace list brings the
/// module's name, not its functions; `file_decls` unwraps `export import`.
fn import_parts(file Node, seg bool) -> []str {
    mut out = []str.new()
    for d in file_decls(file) {
        if d.kind_of() != NodeKind.ImportDecl { continue }
        out.append(import_parts_of(branch_children(d), seg))
    }
    out
}

/// The parts of ONE import: the last identifier of the path before the brace
/// list, once per name inside it (`seg`), or the names themselves. An aliased
/// import is refused before typing (`@walk_import`), so `as` never reaches a
/// lookup.
fn import_parts_of(kids []Node, seg bool) -> []str {
    mut res = []str.new()
    mut last = ""
    mut in_braces = false
    mut first = true
    for c in kids {
        if c.kind_of() != NodeKind.LeafNode { continue }
        ro t = leaf_text(c)
        if first {
            first = false // the keyword: `import` / `use`
        } else if t == "{" {
            in_braces = true
        } else if t == "}" {
            in_braces = false
        } else if in_braces {
            if t != "," && t != "as" {
                res.push(if seg { last } else { t })
            } else {
                // The separator, or the `as` before an alias.
            }
        } else if t != "." && t != ".." && t != "/" {
            last = t
        } else {
            // Path punctuation.
        }
    }
    res
}

/// The NAMES of the sums a tree declares at its top level, exported or not:
/// the "own module" a handed body's bare variant names resolve in first
/// (`Checker.home_sums`, registry 1678). The parser builds a sum as its own
/// node kind, `SumDecl`, its name the leaf after `type`.
fn sums_declared_in(file Node) -> NameTable {
    mut out = NameTable.new(NamespaceId.NsDefs)
    mut n = 0
    for d in file_decls(file) {
        if d.kind_of() != NodeKind.SumDecl { continue }
        ro nk = branch_children(d)
        if nk.len() < 2 || nk[1].kind_of() != NodeKind.LeafNode { continue }
        out.put(leaf_text(nk[1]), n)
        n += 1
    }
    out
}
