// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/resolve — tests beside the module (project convention).
//
// WHAT THESE TESTS HOLD: the structural satisfaction predicate of E2-b3 wave 3b
// -- does a type have every method a protocol requires, and when it does not,
// WHICH signature is missing.
//
// WHY A UNIT TEST AND NOT A FIXTURE, measured 2026-08-23: novac does not declare
// methods in the compiled file yet ("novac does not declare methods yet -- the
// form is read from std declarations only"), so no type in a fixture can satisfy
// a contract, and the predicate would be unobservable through the parser. An
// unobserved mechanism is the K7 class this project names out loud: a capability
// with no obligation. So the predicate is observed HERE, against a registry
// built by hand, until method declarations land.

module novac.resolve
import ../tree.{Node, NodeKind, branch}
import ../types.{TyId}
import ../sem.{collect_types, Ctx, ProtoSig, ParamDef, ParamMode}
import ../sem.{ArgSpec, ArgClass, CallForm}

/// An empty file node: the predicate needs a Ctx with primitives seeded and
/// nothing else. Same reason as in mangle_test -- `sem` must not import the
/// parser, and a test is not a licence to add an edge.
fn empty_file_p() -> Node => branch(0, NodeKind.File, []Node.new())

/// A plain `ro` parameter of this type -- same helper mangle_test carries:
/// `ro` is the language's default, so this is what "just a parameter" means.
fn ro_param(t TyId) -> ParamDef =>
    { name: "p", type_id: t, mode: ParamMode.ModeRo, default_expr: []Node.new() }


test "a type WITH the required method satisfies the contract" {
    mut ctx = collect_types(empty_file_p())
    // A protocol requiring exactly `@size() -> int`, seeded inline: a mut
    // aggregate must not travel as a parameter (274 rule 4.5), and each test
    // owns its registry anyway.
    ro sized_off = ctx.protos.sigs.len()
    ctx.protos.sigs.push(ProtoSig { name: "size", ret_id: ctx.prims.int_id,
                                    param_off: 0, param_cnt: 0 })
    ro prow = ctx.protos.add("Sized", sized_off, 1)
    // A method row: the receiver is parameter ZERO (plan 273), so `int @size()`
    // is a row named `size` whose only parameter is int.
    ctx.fns.add("size", ctx.prims.int_id, true,
                []ParamDef.of(ro_param(ctx.prims.int_id)), []str.new(), []str.new())
    assert(!missing_sig_of(ctx, FnIndex.build(ctx.fns), ctx.prims.int_id, prow).is_some())
}

test "a type WITHOUT it is refused, and the MISSING signature is named" {
    mut ctx = collect_types(empty_file_p())
    // A protocol requiring exactly `@size() -> int`, seeded inline: a mut
    // aggregate must not travel as a parameter (274 rule 4.5), and each test
    // owns its registry anyway.
    ro sized_off = ctx.protos.sigs.len()
    ctx.protos.sigs.push(ProtoSig { name: "size", ret_id: ctx.prims.int_id,
                                    param_off: 0, param_cnt: 0 })
    ro prow = ctx.protos.add("Sized", sized_off, 1)
    // `str` has no `size` row registered, so the contract is unmet -- and the
    // answer carries the signature, not merely "unsatisfied": the bar is the
    // oracle's own message, "`Plain` is missing: size() -> int".
    ro missing = missing_sig_of(ctx, FnIndex.build(ctx.fns), ctx.prims.str_id, prow) ?? "none"
    assert(missing == "size() -> int")
}

test "the RETURN TYPE is part of the requirement, not decoration" {
    mut ctx = collect_types(empty_file_p())
    // A protocol requiring exactly `@size() -> int`, seeded inline: a mut
    // aggregate must not travel as a parameter (274 rule 4.5), and each test
    // owns its registry anyway.
    ro sized_off = ctx.protos.sigs.len()
    ctx.protos.sigs.push(ProtoSig { name: "size", ret_id: ctx.prims.int_id,
                                    param_off: 0, param_cnt: 0 })
    ro prow = ctx.protos.add("Sized", sized_off, 1)
    // Same name, same arity, WRONG return type: a row that answers `str` where
    // the contract wants `int` does not satisfy it. Without this the predicate
    // would be a name check wearing a signature's clothes.
    ctx.fns.add("size", ctx.prims.str_id, true,
                []ParamDef.of(ro_param(ctx.prims.int_id)), []str.new(), []str.new())
    assert(missing_sig_of(ctx, FnIndex.build(ctx.fns), ctx.prims.int_id, prow).is_some())
}

test "a FREE function of the same name does not satisfy a method requirement" {
    mut ctx = collect_types(empty_file_p())
    // A protocol requiring exactly `@size() -> int`, seeded inline: a mut
    // aggregate must not travel as a parameter (274 rule 4.5), and each test
    // owns its registry anyway.
    ro sized_off = ctx.protos.sigs.len()
    ctx.protos.sigs.push(ProtoSig { name: "size", ret_id: ctx.prims.int_id,
                                    param_off: 0, param_cnt: 0 })
    ro prow = ctx.protos.add("Sized", sized_off, 1)
    // `has_recv: false` -- a free `size(x int)` is not a method, and the two
    // spellings are kept apart by the language, so the predicate keeps them
    // apart too (the same rule `@fits` lives by).
    ctx.fns.add("size", ctx.prims.int_id, false,
                []ParamDef.of(ro_param(ctx.prims.int_id)), []str.new(), []str.new())
    assert(missing_sig_of(ctx, FnIndex.build(ctx.fns), ctx.prims.int_id, prow).is_some())
}


/// A parameter of this type in this mode -- the overload tests vary only modes,
/// so the type is the same int everywhere and the mode is the whole story.
fn mode_param(t TyId, m ParamMode) -> ParamDef =>
    { name: "p", type_id: t, mode: m, default_expr: []Node.new() }

/// An argument of this type in this class, passed positionally.
fn class_arg(t TyId, c ArgClass) -> ArgSpec => { type_id: t, cls: c, name: "" }

test "two candidates specific in DIFFERENT positions are an overload set (not a winner by sum)" {
    mut ctx = collect_types(empty_file_p())
    ro i = ctx.prims.int_id
    // `f(consume a, ro b, ro c)` and `f(ro a, ro b, mut c)`. Neither is more
    // specific everywhere: the first wins position 0, the second position 2.
    ctx.fns.add("f", i, false,
                []ParamDef.of(mode_param(i, ParamMode.ModeConsume),
                              mode_param(i, ParamMode.ModeRo),
                              mode_param(i, ParamMode.ModeRo)),
                []str.new(), []str.new())
    ctx.fns.add("f", i, false,
                []ParamDef.of(mode_param(i, ParamMode.ModeRo),
                              mode_param(i, ParamMode.ModeRo),
                              mode_param(i, ParamMode.ModeMut)),
                []str.new(), []str.new())
    // An owned temporary, a `ro` place, a mutable place: BOTH rows admit this
    // tuple position by position, which is what makes the set a real one.
    ro args = []ArgSpec.of(class_arg(i, ArgClass.ArgOwnedTemp),
                           class_arg(i, ArgClass.ArgRo),
                           class_arg(i, ArgClass.ArgMut))
    ro got = FnIndex.build(ctx.fns).lookup(ctx.fns, ctx.tys, "f", args, CallForm.FreeCall)
    // THE POINT OF THIS TEST. A sum of mode weights scores these 2 and 1 and
    // hands back a winner; the spec says a set varying two parameters' modes
    // oppositely is rejected -- "there is no silent choice" (D84, the mode-axis
    // amendment). So this assertion is red on any implementation that compares
    // by a total instead of position by position.
    if FnLookup.FnOverloaded(_) = got {
        assert(true)
    } else {
        assert(false)
    }
}

test "a set varying ONE parameter's mode still has a unique winner" {
    mut ctx = collect_types(empty_file_p())
    ro i = ctx.prims.int_id
    // `f(ro a)` beside `f(mut a)` -- the ordinary case the amendment exists for.
    ctx.fns.add("f", i, false, []ParamDef.of(mode_param(i, ParamMode.ModeRo)),
                []str.new(), []str.new())
    ctx.fns.add("f", i, false, []ParamDef.of(mode_param(i, ParamMode.ModeMut)),
                []str.new(), []str.new())
    ro args = []ArgSpec.of(class_arg(i, ArgClass.ArgMut))
    ro got = FnIndex.build(ctx.fns).lookup(ctx.fns, ctx.tys, "f", args, CallForm.FreeCall)
    // Without this half the rule could pass by calling EVERYTHING ambiguous,
    // which would be a refusal machine rather than a resolver.
    if FnLookup.FnFound(_) = got {
        assert(true)
    } else {
        assert(false)
    }
}
