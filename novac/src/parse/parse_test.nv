// novac/src/parse — tests beside the module. The load-bearing property is the
// tree-level reserialization identity: parse may group however it likes, but
// it may not lose, reorder or invent a single byte — on ANY input.

module novac.parse

import ../lex.{lex}
import ../tree.{Node, NodeKind, tree_reserialize}

fn roundtrip(src str) -> bool => tree_reserialize(parse(lex(src))) == src

test "tree reserialization: hello program survives byte for byte" {
    assert(roundtrip("// greeting\nmodule basics.hello\n\nfn main() {\n    println(\"Hello, Nova!\")\n}\n"))
}

test "tree reserialization: arithmetic and calls survive" {
    assert(roundtrip("fn main() { f(1 + 2 * 3, \"x\") }"))
}

test "tree reserialization: broken input survives -- recovery loses nothing" {
    assert(roundtrip("?? fn ) main ( { +++ \"unterminated"))
    assert(roundtrip(""))
    assert(roundtrip("module"))
    assert(roundtrip("fn main() { } trailing ?? garbage"))
}

test "shape: file holds module decl, fn decl, eof" {
    ro f = parse(lex("module a.b\nfn main() { }"))
    match f {
        Branch { kind, children, .. } => {
            assert(kind == NodeKind.File)
            assert(children[0].kind_of() == NodeKind.ModuleDecl)
            assert(children[1].kind_of() == NodeKind.FnDecl)
        }
        Leaf(_) => assert(false)
    }
}

test "shape: module-level `ro` parses as LetDecl (registry TBD, D184 Item::Let)" {
    // Before this door existed, EVERY module-level `ro` -- not just array
    // literals or record constructors, as the failing carrier's shape
    // suggested -- fell into the parser's unnamed fallback. Narrowed by
    // probe down to `ro x = 5` alone.
    ro f = parse(lex("module a\n\nro x = 5"))
    match f {
        Branch { children, .. } => {
            assert(children[1].kind_of() == NodeKind.LetDecl)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == "module a\n\nro x = 5")
}

test "shape: module-level `ro` with a declared type still parses (D184 type_opt)" {
    ro f = parse(lex("module a\n\nro x int = 5"))
    match f {
        Branch { children, .. } => {
            assert(children[1].kind_of() == NodeKind.LetDecl)
        }
        Leaf(_) => assert(false)
    }
}

test "shape: unexpected top-level token becomes an Err branch, then parsing continues" {
    ro f = parse(lex("42 fn main() { }"))
    match f {
        Branch { children, .. } => {
            assert(children[0].kind_of() == NodeKind.Err)
            assert(children[1].kind_of() == NodeKind.FnDecl)
        }
        Leaf(_) => assert(false)
    }
}

test "arithmetic grammar: full file reserializes and shapes parse" {
    ro src = "module basics.a\n\
\n\
fn factorial(n int) -> int {\n\
    if n <= 1 {\n\
        return 1\n\
    }\n\
    n * factorial(n - 1)\n\
}\n\
\n\
fn main() {\n\
    println(\"5! = \", factorial(5))\n\
    mut sum = 0\n\
    for i in 0..11 {\n\
        sum += i\n\
    }\n\
    println(\"sum = \", sum)\n\
}\n\
"
    assert(roundtrip(src))
    ro f = parse(lex(src))
    match f {
        Branch { children, .. } => {
            assert(children[0].kind_of() == NodeKind.ModuleDecl)
            assert(children[1].kind_of() == NodeKind.FnDecl)
            assert(children[2].kind_of() == NodeKind.FnDecl)
        }
        Leaf(_) => assert(false)
    }
}

test "shape: binary chain is left-associative" {
    // 1 + 2 * 3 in the subset is ((1+2)*3) -- precedence is deliberately NOT
    // in the E1 grammar; recorded so the divergence ledger catches it when
    // the check slice compares against the oracle.
    ro f = parse(lex("fn m() { 1 + 2 * 3 }"))
    assert(tree_reserialize(f) == "fn m() { 1 + 2 * 3 }")
}

/// The Block of the first FnDecl in a File.
fn ret_test_fn_block(f Node) -> ro Node {
    match f {
        Branch { children, .. } => {
            for c in children {
                if c.kind_of() == NodeKind.FnDecl {
                    match c {
                        Branch { children: fc, .. } => {
                            for cc in fc {
                                if cc.kind_of() == NodeKind.Block { return cc }
                            }
                        }
                        Leaf(_) => {}
                    }
                }
            }
        }
        Leaf(_) => {}
    }
    f
}

test "shape: a bare `return` at a match arm's end does not swallow the next arm (registry TBD)" {
    // `if @peek() != RBrace { ... }` used to be the whole check for "does
    // this bare `return` have a value" -- true for anything but `}`, so
    // the NEXT arm's pattern (not `}`) got read as the return's value.
    // The block below must still hold exactly one statement: one MatchExpr.
    ro src = "fn m() {\n    match o {\n        None => return\n        Some(_) => {}\n    }\n}\n"
    ro f = parse(lex(src))
    match ret_test_fn_block(f) {
        Branch { children, .. } => {
            // The block's children are LOSSLESS (the `{`/`}` leaves sit
            // beside the statement), so the match is found by kind, not by
            // a fixed index.
            mut found = false
            for c in children {
                if c.kind_of() != NodeKind.MatchExpr { continue }
                found = true
                match c {
                    Branch { children: mk, .. } => {
                        mut arms = 0
                        for m in mk {
                            if m.kind_of() == NodeKind.MatchArm { arms += 1 }
                        }
                        assert(arms == 2)
                    }
                    Leaf(_) => assert(false)
                }
            }
            assert(found)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == src)
}

test "shape: a leading `..` (open-left slice) parses as an Index, not the parser's fallback (registry #1241)" {
    // `..` is a BINARY operator only (is_binop/binding_power); it never
    // appears as a prefix, so `t[..2]` used to give `@primary()` no branch
    // to take and fall into generic Err recovery, eating the `..` as one
    // stray token. `t[a..]` (open-right) worked all along, but only by
    // accident -- its `a` gives `@primary()` a real left, the same binop
    // loop reads `..` normally, and the ABSENT right becomes its own
    // recovered node. This fixes the missing left the same way.
    ro src = "fn m() {\n    t[..2]\n}\n"
    ro f = parse(lex(src))
    match ret_test_fn_block(f) {
        Branch { children, .. } => {
            mut found = false
            for c in children {
                if c.kind_of() != NodeKind.Index { continue }
                found = true
            }
            assert(found)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == src)
}

test "shape: an `else if` chain in value position parses as nested IfExpr (registry #1243)" {
    // The value-`if` reader's `else` arm checked ONLY `LBrace` for the else
    // branch -- no case for a chained `else if` at all, unlike the
    // statement-`if` reader right next to it (`@stmt()`), which already
    // recurses on `KwIf` to build the chain. `ro want = if c1 {1} else if
    // c2 {2} else {3}` used to leave the `else if` unconsumed and fall
    // apart downstream. Fixed by recursing into the same value-`if` reader
    // (`@atom()`) the outer call itself went through, mirroring `@stmt()`.
    ro src = "fn m() {\n    ro want = if c1 {\n        1\n    } else if c2 {\n        2\n    } else {\n        3\n    }\n}\n"
    ro f = parse(lex(src))
    match ret_test_fn_block(f) {
        Branch { children, .. } => {
            mut ifs = 0
            for c in children {
                if c.kind_of() != NodeKind.BindStmt { continue }
                match c {
                    Branch { children: bk, .. } => {
                        for b in bk {
                            if b.kind_of() != NodeKind.IfExpr { continue }
                            ifs += 1
                            match b {
                                Branch { children: ik, .. } => {
                                    for i in ik {
                                        if i.kind_of() == NodeKind.IfExpr { ifs += 1 }
                                    }
                                }
                                Leaf(_) => {}
                            }
                        }
                    }
                    Leaf(_) => {}
                }
            }
            assert(ifs == 2)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == src)
}

test "shape: an effect_list before `->` parses as EffectItem siblings (registry #1244)" {
    // The signature reader checked ONLY `@peek() == Arrow` right after `)` --
    // no case for an effect_list (D3/D209) standing between `)` and `->` at
    // all, so `fn f() Fs Net -> int` used to decide there was no return type
    // the moment it saw `Fs` (an Ident, not Arrow), and the whole effect
    // list fell into the parser's fallback further down. Two effects here,
    // both must arrive as their own `EffectItem` child, in order, and the
    // `RetType` must still be found afterward.
    ro src = "fn f() Fs Net -> int {\n    0\n}\n"
    ro f = parse(lex(src))
    match f {
        Branch { children, .. } => {
            mut found_fn = false
            for c in children {
                if c.kind_of() != NodeKind.FnDecl { continue }
                found_fn = true
                match c {
                    Branch { children: fk, .. } => {
                        mut effects = 0
                        mut found_ret = false
                        for e in fk {
                            if e.kind_of() == NodeKind.EffectItem { effects += 1 }
                            if e.kind_of() == NodeKind.RetType { found_ret = true }
                        }
                        assert(effects == 2)
                        assert(found_ret)
                    }
                    Leaf(_) => assert(false)
                }
            }
            assert(found_fn)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == src)
}

test "shape: a with statement parses as one WithStmt, bindings and body intact (274.11 Э.4)" {
    // `with Fs = h, Os = h2 { body }` used to fall apart into THREE
    // plausible statements -- a `with` name, an assignment, and a record
    // constructor -- and check refused none of them by name. The door is
    // spelling + shape (Ident Ident `=` at 0..2 can only be this form),
    // and every byte must round-trip: two bindings, two commas worth of
    // `=` signs, one body block.
    ro src = "fn g(h Fs, o Os) -> int {\n    with Fs = h, Os = o {\n        1\n    }\n}\n"
    ro f = parse(lex(src))
    match ret_test_fn_block(f) {
        Branch { children, .. } => {
            mut found_with = false
            for c in children {
                if c.kind_of() != NodeKind.WithStmt { continue }
                found_with = true
                match c {
                    Branch { children: wk, .. } => {
                        mut names = 0
                        mut body = false
                        for k in wk {
                            if k.kind_of() == NodeKind.Name { names += 1 }
                            if k.kind_of() == NodeKind.Block { body = true }
                        }
                        // Geometry: `with`, Name, `=`, expr, `,`, Name, `=`, expr, Block.
                        assert(wk.len() == 9)
                        assert(names == 2)
                        assert(body)
                    }
                    Leaf(_) => assert(false)
                }
            }
            assert(found_with)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == src)
}

test "shape: a comma between brace-record fields parses, not just a newline (registry #1227)" {
    // The field loop's condition (`Ident` or a mode word) never matched a
    // `,` -- so the SECOND field of a one-line record looked like the end
    // of the body, and the mismatched `}` expectation fell into the
    // parser's own recovery. Two fields here, both must arrive as their
    // own `Field` child, and the comma must round-trip losslessly (the
    // tree keeps every byte, it does not merely accept and drop it).
    ro src = "type Point { x f64, y f64 }\n"
    ro f = parse(lex(src))
    match f {
        Branch { children, .. } => {
            mut found_type = false
            for c in children {
                if c.kind_of() != NodeKind.TypeDecl { continue }
                found_type = true
                match c {
                    Branch { children: fk, .. } => {
                        mut fields = 0
                        for e in fk {
                            if e.kind_of() == NodeKind.Field { fields += 1 }
                        }
                        assert(fields == 2)
                    }
                    Leaf(_) => assert(false)
                }
            }
            assert(found_type)
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(f) == src)
}

test "shape: bare `unsafe fn` parses as FnDecl through both entry doors (registry #1226)" {
    // `unsafe` was only ever read as extern_decl's OPTIONAL leaf
    // (`extern "ABI" unsafe fn`, #815) -- a bare `unsafe fn`, with no
    // `extern` in front, matched no branch of either the top-level loop
    // (parse.nv) or the `export` wrapper (decls.nv's `@export_decl`), and
    // fell into the parser's own fallback in both places. Both doors must
    // now recognise it, each on its own carrier.
    ro bare_src = "unsafe fn risky() -> int {\n    0\n}\n"
    ro bare = parse(lex(bare_src))
    match bare {
        Branch { children, .. } => {
            mut found = false
            for c in children {
                if c.kind_of() == NodeKind.FnDecl { found = true }
            }
            assert(found, "a bare `unsafe fn` at top level must reach FnDecl, not the parser's fallback")
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(bare) == bare_src)

    ro exported_src = "export unsafe fn risky() -> int {\n    0\n}\n"
    ro exported = parse(lex(exported_src))
    match exported {
        Branch { children, .. } => {
            mut found = false
            for c in children {
                if c.kind_of() != NodeKind.ExportDecl { continue }
                match c {
                    Branch { children: ek, .. } => {
                        for e in ek {
                            if e.kind_of() == NodeKind.FnDecl { found = true }
                        }
                    }
                    Leaf(_) => assert(false)
                }
            }
            assert(found, "`export unsafe fn` must reach FnDecl inside ExportDecl, not the fallback")
        }
        Leaf(_) => assert(false)
    }
    assert(tree_reserialize(exported) == exported_src)
}

/// How many `NodeKind.Err` nodes stand anywhere in this tree -- a recovery
/// count, not a shape check: a form the parser reads cleanly plants none.
fn count_err(n Node) -> int {
    match n {
        Leaf(_) => 0
        Branch { kind, children, .. } => {
            mut c = if kind == NodeKind.Err { 1 } else { 0 }
            for k in children {
                c += count_err(k)
            }
            c
        }
    }
}

test "shape: a nested positional/record sub-pattern in a variant payload parses, not the parser's fallback (registry #1240, D157)" {
    // `Some((first, cnt))` used to fall through the payload loop entirely --
    // it read only a flat, comma-separated run of `Ident`, so the leading
    // `(` of the nested tuple matched no branch and the whole arm dropped
    // into the parser's unnamed fallback (three cascaded Err nodes for one
    // mistake). D157 already named the form legal on 2026-07-21; the spec
    // amendment for #1240 (2026-09-21) made D184's grammar say so too.
    // `mut b` inside the nested pattern is the oracle-confirmed sibling
    // form (per-element consume mode, D157's own reason for existing).
    ro src = "fn m(p Pos) -> int {\n    match p {\n        Nowhere => 0\n        Point((first, mut cnt)) => first\n    }\n}\n"
    ro f = parse(lex(src))
    assert(tree_reserialize(f) == src, "the tree must reserialize byte for byte -- no token lost to recovery")
    assert(count_err(f) == 0, "a form the parser reads cleanly plants no NodeKind.Err -- a nonzero count means some part still fell into the fallback")

    mut found_match = false
    match ret_test_fn_block(f) {
        Branch { children, .. } => {
            for c in children {
                if c.kind_of() == NodeKind.MatchExpr { found_match = true }
            }
        }
        Leaf(_) => {}
    }
    assert(found_match, "the match expression itself must parse as MatchExpr, not fall into recovery before reaching the arms")

    // Control: the record sub-pattern form (`{first, second}`, D157's other
    // half) parses the same way, on its own probe.
    ro rec_src = "fn m(p Pos) -> int {\n    match p {\n        Nowhere => 0\n        Boxed({w, h}) => w\n    }\n}\n"
    ro rf = parse(lex(rec_src))
    assert(tree_reserialize(rf) == rec_src, "the record sub-pattern form must reserialize byte for byte too")
    assert(count_err(rf) == 0, "the record sub-pattern form must plant no NodeKind.Err either")
}
