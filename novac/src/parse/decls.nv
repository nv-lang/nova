// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc_parse `item.rs` -- item parsing lives apart from expression
// and type parsing there along the same seam, and for the same reason: an
// item is recognised by its leading keyword and nothing else.
//
// Role: the readers of TOP-LEVEL declarations -- `export`, `import`/`use`,
//   the `#...` attribute line, the `test` block. These are forms of the
//   LANGUAGE that the subset does not compile yet, and the parser must read
//   them all the same (S9.4: the grammar is the language's, the subset is
//   the checker's).
// Used by: parse.nv -- its top-level loop, and export_decl for the
//   declaration it wraps.
// Guarded by: check-novac-file-size.py (this split), check-novac-deps.py, check-novac-doc-language.py.
//
// Split out of parse.nv on 2026-08-18 when the declarations batch of S9.4a
// pushed that file past the thousand-line limit -- the same seam type_ref.nv
// came out of a day earlier.

module novac.parse

import ../lex.{Token, TokenKind, brace_delta, paren_delta}
import ../tree.{Node, NodeKind}

/// `export <declaration>` -- the visibility WRAPS the declaration.
///
/// A wrapper and not a prefix leaf inside the declaration: `export` says
/// something about the declaration as a whole, and every reader of a FnDecl
/// (the method harvest, the emitter, the checker's shape rules) keeps working
/// on exactly the shape it knew. Until 2026-08-18 `export` was not a keyword
/// at all, so the token fell into the top-level junk bucket -- and since std
/// writes `export` in front of nearly everything, the most common declaration
/// form in the language was answered with "construct not in the MVP grammar".
fn Cursor mut @export_decl() -> Node {
    mut kids = []Node.of(@take()) // KwExport
    ro k = @peek()
    if k == TokenKind.KwFn {
        kids.push(@fn_decl([]Node.new()))
    } else if k == TokenKind.KwExtern {
        // `export extern "nova" unsafe fn RawMem.copy(...)` -- std writes it
        // this way, so the wrapper has to know the form (nv-coding-style §18).
        kids.push(@extern_decl())
    } else if k == TokenKind.KwType {
        kids.push(@type_decl())
    } else if k == TokenKind.KwImport || k == TokenKind.KwUse {
        kids.push(@import_decl())
    } else if k == TokenKind.KwConst {
        kids.push(@const_decl())
    } else if k == TokenKind.KwRo {
        // `export ro NAME = expr` (D184's module-level `Item::Let`) -- the
        // wrapper knew `const` but not its own `ro` twin, so EVERY exported
        // module-level `ro` (qualified or not) fell to the `else` below and
        // came back as an unnamed parser fallback, however that binding was
        // itself perfectly readable by `@let_decl` alone (df13dff0d taught
        // the bare, unwrapped form; this teaches the wrapper the same word).
        kids.push(@let_decl())
    } else if k == TokenKind.KwUnsafe && @peek(skip: 1) == TokenKind.KwFn {
        // `export unsafe fn ...` (registry #1226), no `extern` in front --
        // the same gap `parse.nv`'s top-level loop had, and for the same
        // reason: `unsafe` was only ever read as extern_decl's optional
        // leaf (#815), never as a lead of its own here.
        kids.push(@fn_decl([]Node.of(@take())))
    } else {
        // `export` in front of something that is not a declaration. The leaf is
        // already in the tree (nothing is lost); naming the mistake is check's
        // job, and it has the span.
        kids.push(@error_node(TokenKind.ErrorTok))
    }
    @node(NodeKind.ExportDecl, kids)
}

/// `extern "nova" fn ...` / `extern "C" unsafe fn ...` -- the FFI declaration
/// form (D282, plan 91.12 F.-1).
///
/// The ABI string and the optional `unsafe` become LEAVES OF THE FnDecl, not a
/// wrapper node: the oracle keeps the ABI as a tag on the same item
/// (`FnDecl.extern_abi`), so no reader of a FnDecl has to learn a new shape and
/// no new NodeKind appears. WHICH ABI is legal (`"nova"` or `"C"`) is not asked
/// here -- the parser reads the LANGUAGE, and every judgement is check's
/// (S9.4). A declaration in this form has no body, which this door already
/// reads: `@fn_decl` treats a missing brace as a real form.
///
/// Until 2026-08-20 the word was not even a keyword, so the entire FFI layer of
/// std was answered with "this is not a form of the language" -- the worst
/// member of class A in the inventory (§9.4а): a refusal naming a false cause.
fn Cursor mut @extern_decl() -> Node {
    mut lead = []Node.of(@take()) // KwExtern
    // The ABI string is REQUIRED (`extern "nova" fn`); `unsafe` is not,
    // and that is why the two lines use different doors (#815).
    @push_expected(lead, TokenKind.StrLit)
    @push_if(lead, TokenKind.KwUnsafe)
    if @peek() == TokenKind.KwFn {
        return @fn_decl(lead)
    } else {
        // `extern` before something that is not `fn`. The leaves are in the
        // tree (nothing is lost) and check has the span: the oracle allows
        // `type` here too, and that form arrives with the type work.
        lead.push(@error_node(TokenKind.ErrorTok))
        return @node(NodeKind.Err, lead)
    }
}

/// `import a.b.c` / `import a.b.{X, Y}` / `use a.b.{X}`.
///
/// The path is spelled with DOTS (measured 2026-08-18: a slash is
/// "expected newline or end of input, got `/`"), and the optional brace list
/// names what is taken. Both keywords build the same node -- they differ in
/// meaning, not in shape, and the keyword leaf is right there for whoever
/// needs to tell them apart.
fn Cursor mut @import_decl() -> Node {
    mut kids = []Node.of(@take()) // KwImport or KwUse
    // THE PATH MAY BE RELATIVE, and the spec writes it with a SLASH:
    // `import ./sibling.{Name}`, `import ../neighbor.{Name}`
    // (07-modules.md, rev-4). The loop took only identifiers and dots, so it
    // stopped at the `/` -- and the rest of the line became top-level junk. That
    // is why 29 of novac's own 34 files reported a SECOND, meaningless refusal
    // right after the import: the parser had swallowed the file (measured
    // 2026-08-23).
    // `..` IS ONE TOKEN (`DotDot`, the range operator's), and that is why the
    // first fix here was not enough: the loop learned the slash and still stopped
    // dead at the two dots in front of it.
    ro before_path = kids.len()
    while @peek() == TokenKind.Ident || @peek() == TokenKind.Dot ||
        @peek() == TokenKind.DotDot || @peek() == TokenKind.Slash {
        kids.push(@take())
    }
    if kids.len() == before_path {
        // AN EMPTY PATH is not an import, and a loop with no minimum said it
        // was: bare `import` compiled with exit code 0 and no diagnostic
        // (registry #815, probe `import_no_path`). This is the SECOND shape of
        // that class -- the first is a required token taken by the optional
        // door -- and a grep for `@push_if` never finds it, which is why it
        // outlived the door fix by one measurement.
        //
        // The gap is planted, not said: whether it is worth saying is the
        // checker's one decision for every gap in the file.
        kids.push(@error_node(TokenKind.ErrorTok))
    } else {
        // A path was read; how well-formed it is, `check` judges.
    }
    if @peek() == TokenKind.LBrace {
        mut depth = 0
        while !@at_eof() {
            ro k = @peek()
            ro delta = brace_delta(k)
            depth += delta
            kids.push(@take())
            if depth == 0 { break }
        }
    } else {
        // No brace list: the whole module is imported under its own name.
    }
    @node(NodeKind.ImportDecl, kids)
}

/// `#realtime nogc`, `#impl(Display)` -- an attribute line before a declaration.
///
/// Newlines are trivia in this lexer, so the line's end is not a token: the
/// attribute runs while identifiers follow, and the next declaration keyword
/// ends it.
///
/// AN ARGUMENT LIST IS PART OF THE ATTRIBUTE, and until 2026-09-18 this door
/// stopped at the identifier. The doc here used to say the identifier run "is
/// enough for every attribute the language writes today (`#realtime nogc`,
/// `#inline`)" -- and that was false while it was being read: `#impl(P)` is
/// D186, and it stands in novac's OWN source (`diag/diag.nv:52,60`). What the
/// gap did was not refuse the form but MISPLACE the refusal: `#impl(Display)`
/// produced TWO diagnostics, one about the unknown attribute and a second where
/// `(Display)` fell to the parser's fallback as an unparsed form. Measured by
/// OFFSETS rather than by counting: d0 at the `#`, d1 spanning `(Display)`.
///
/// Taking the run does not admit the attribute -- the checker still refuses any
/// attribute it does not read (`ATTR_MSG`). It makes the refusal name ONE cause
/// instead of two, which is the promise the subset makes everywhere else.
fn Cursor mut @attr_decl() -> Node {
    mut kids = []Node.of(@take()) // '#'
    while @peek() == TokenKind.Ident {
        kids.push(@take())
    }
    if @peek() == TokenKind.LParen {
        // The same balanced-run shape the import's brace list uses above, with
        // the paren counter instead: the tree keeps every leaf, and the form
        // inside is the checker's question, not the cursor's.
        mut depth = 0
        while !@at_eof() {
            ro k = @peek()
            ro delta = paren_delta(k)
            depth += delta
            kids.push(@take())
            if depth == 0 { break }
        }
    } else {
        // No argument list: `#realtime nogc`, `#inline`.
    }
    @node(NodeKind.AttrDecl, kids)
}

/// `test "name" { ... }`.
/// A module-level constant: `const NAME = expr` and `const NAME Type = expr`.
///
/// THE TYPE IS OPTIONAL, and that is a measurement rather than a preference:
/// D200 spells the full form (`const <name> <Type> = <value>`), while every
/// constant in our own sources omits it (`export const TYPE_KIND_COUNT = 7`,
/// builtins.nv:48) and the oracle compiles them. The parser reads the language
/// the oracle accepts; which of the two the SPEC should carry is the
/// integrator's question, filed in plan 274.5.
///
/// The value is an EXPRESSION, read by the same door every initializer uses --
/// there is no second grammar for constants, and a literal is just the shape
/// most of them happen to have.
fn Cursor mut @const_decl() -> Node {
    mut kids = []Node.of(@take()) // KwConst
    @push_expected(kids, TokenKind.Ident) // the name, or the TYPE of a qualified name
    // A QUALIFIED module-level name (D200 amend #66): `const Type.NAME` reads
    // exactly like `Type.method` does everywhere else in the grammar -- a
    // `Dot` right after the leading identifier, with another identifier
    // after it. Read here, not deferred to a generic "name" door, because
    // this cursor already holds the two leaves losslessly; the checker
    // decides whether the qualifier resolves to a real type, this door only
    // reads the shape the language has.
    if @peek() == TokenKind.Dot && @peek(skip: 1) == TokenKind.Ident {
        kids.push(@take()) // '.'
        kids.push(@take()) // the qualified name itself
    } else {
        // An unqualified name: the ordinary door below answers.
    }
    if @peek() != TokenKind.Assign {
        // A declared type stands between the name and `=`, read by the ONE
        // type-reference door (274.5 wave B1 put fields on it too).
        kids.append(@type_ref())
    } else {
        // No type written: the initializer carries it.
    }
    @push_expected(kids, TokenKind.Assign)
    kids.push(@expr())
    @node(NodeKind.ConstDecl, kids)
}

/// A module-level binding: `ro NAME [Type] = expr` (D184's `Item::Let`).
///
/// Grammar and shape mirror `@const_decl` exactly (D184, precise diff:
/// `module_item ::= "export"? "ro" IDENT type_opt "=" expr | const_decl`,
/// same `type_opt` door as scope-local `ro`) -- the parser reads `ro` and
/// `const` symmetrically here; which of the two a value belongs in is a
/// constexpr question the checker asks after parsing (D184 "Strict
/// module-level partition"), never the parser's.
///
/// `mut`/`consume` at module level are NOT read by this door (registry
/// TBD): D184 names a diagnostic for each (`E_MUT_AT_MODULE_LEVEL`,
/// `E_CONSUME_AT_MODULE_LEVEL`), but wiring that refusal is its own
/// follow-up, not bundled into this fix for `ro`.
fn Cursor mut @let_decl() -> Node {
    mut kids = []Node.of(@take()) // KwRo
    @push_expected(kids, TokenKind.Ident) // the name, or the TYPE of a qualified name
    // A QUALIFIED module-level name (D200 amend #66, `ro` twin of the
    // `const` form right above -- see its own comment for the reason this
    // reads `Dot Ident` directly rather than through a generic name door).
    if @peek() == TokenKind.Dot && @peek(skip: 1) == TokenKind.Ident {
        kids.push(@take()) // '.'
        kids.push(@take()) // the qualified name itself
    } else {
        // An unqualified name: the ordinary door below answers.
    }
    if @peek() != TokenKind.Assign {
        kids.append(@type_ref())
    } else {
        // No type written: the initializer carries it.
    }
    @push_expected(kids, TokenKind.Assign)
    kids.push(@expr())
    @node(NodeKind.LetDecl, kids)
}

/// A `test "name" { ... }` block: read whole, judged by the subset walk.
fn Cursor mut @test_decl() -> Node {
    mut kids = []Node.of(@take()) // KwTest
    @push_expected(kids, TokenKind.StrLit)
    if @peek() == TokenKind.LBrace {
        kids.push(@block())
    } else {
        // A test without a body: the marker is what turns silent acceptance
        // into one honest refusal, exactly as for a bodiless `if`.
        kids.push(@error_node(TokenKind.ErrorTok))
    }
    @node(NodeKind.TestDecl, kids)
}
