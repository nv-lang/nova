// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/parse — tokens to green tree (architecture §2: module `parse`).
//
// E1 subset grammar: module declaration, fn declarations with empty parameter
// lists, blocks, call expressions, string/int literals, names, left-assoc
// +-*/ binary chains. Everything else is RECOVERED, never fatal: an
// unexpected token becomes an Err branch holding exactly that token, and
// parsing continues with the next one. The parser can therefore never lose a
// byte and never stop early — the lead invariant holds through the tree:
//     tree_reserialize(parse(lex(src))) == src, for every input.
//
// No Result in signatures (274 §4 п.1): parse always returns a File node.
// Diagnostics for Err nodes are the next slice (edge parse -> diag is in the
// table; the node IS the representation, the report is separate).

module novac.parse

import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, branch, leaf}

type Cursor {
    toks []Token
    i int
    // Go's composite-literal rule: inside an if/while/for HEAD a record
    // constructor is not parsed — `if x {` must read the brace as the
    // block, not as `x { ... }`. Set for the head expression only; block
    // bodies parse with it clear.
    no_ctor bool
}

// Safe past the end: peek answers Eof forever once the stream is exhausted.
// Together with the advancing take below this kills two latent doors at
// once (E1 review p.2, 2026-08-14): an unguarded loop can no longer hang on
// a non-advancing cursor, and recovery that consumes the Eof leaf (its
// leading carries the file's TAIL trivia) can no longer lead to that trivia
// being emitted twice -- the final push in parse() is conditional now.
fn Cursor @peek() -> TokenKind {
    if @i >= @toks.len() { return TokenKind.Eof }
    @toks[@i].kind
}

fn Cursor mut @take() -> Node {
    // Never hands out the same token twice; the assert makes the contract
    // loud instead of latent (asserts run in release too -- the language's
    // stance). Callers that might legitimately stand past the end go
    // through peek()/at_eof() first, which are safe there.
    assert(@i < @toks.len())
    ro n = leaf(@toks[@i])
    @i += 1
    n
}

fn Cursor @at_eof() -> bool => @peek() == TokenKind.Eof

/// Parse a whole token stream (as produced by lex: Eof-terminated).
export fn parse(toks []Token) -> Node {
    mut p = Cursor { toks, i: 0, no_ctor: false }
    mut items = []Node.new()
    if p.peek() == TokenKind.KwModule {
        items.push(p.module_decl())
    }
    while !p.at_eof() {
        if p.peek() == TokenKind.KwFn {
            items.push(p.fn_decl())
        } else if p.peek() == TokenKind.KwType {
            items.push(p.type_decl())
        } else if p.peek() == TokenKind.KwModule {
            // A module declaration that is NOT the file header is outside
            // the language shape — wrap it in Err so check reports it. It
            // MUST be consumed here: both junk buckets stop at KwModule as
            // a sync point, so a loop iteration that never eats it does not
            // advance (fuzzer catch 2026-08-14: a doubled file hung forever
            // pushing empty Err branches until the GC died).
            items.push(branch(NodeKind.Err, []Node.of(p.module_decl())))
        } else {
            // Panic-mode bucket, same rule as inside fn_decl (E1 review p.1,
            // 2026-08-14): a RUN of stray top-level tokens is ONE seeded
            // mistake and collects into ONE Err branch -- one diagnostic --
            // instead of an Err per token (a file starting `1 2 3` used to
            // produce three diagnostics for one cause, a cascade by the
            // no-cascade guard's own definition).
            mut junk = []Node.new()
            while !p.at_eof() && p.peek() != TokenKind.KwFn
                && p.peek() != TokenKind.KwModule && p.peek() != TokenKind.KwType {
                junk.push(p.take())
            }
            items.push(branch(NodeKind.Err, junk))
        }
    }
    // The Eof leaf carries the file's tail trivia -- emit it exactly ONCE.
    // Recovery inside a broken expression (e.g. `1 +` at end of file) may
    // already have consumed it into an Err branch; pushing unconditionally
    // here would duplicate the tail trivia and break reserialization.
    if p.i < p.toks.len() {
        items.push(p.take())
    }
    branch(NodeKind.File, items)
}

// `type Name { field type ... }` — fields are newline-separated pairs of
// idents, no commas. Sum types (`type X enum ...` / leading `|`) are the
// match_demo wave; a non-brace after the name falls into the fn_decl-style
// junk rules via the top loop's recovery on the next token.
fn Cursor mut @type_decl() -> Node {
    mut kids = []Node.of(@take()) // KwType
    if @peek() == TokenKind.Ident { kids.push(@take()) }
    if @peek() == TokenKind.LBrace {
        kids.push(@take())
        while @peek() == TokenKind.Ident {
            mut fk = []Node.of(@take()) // field name
            if @peek() == TokenKind.Ident { fk.push(@take()) } // field type
            kids.push(branch(NodeKind.Field, fk))
        }
        if @peek() == TokenKind.RBrace { kids.push(@take()) }
    }
    branch(NodeKind.TypeDecl, kids)
}

fn Cursor mut @module_decl() -> Node {
    mut kids = []Node.of(@take()) // KwModule
    if @peek() == TokenKind.Ident {
        kids.push(@take())
        while @peek() == TokenKind.Dot {
            kids.push(@take())
            if @peek() == TokenKind.Ident { kids.push(@take()) } else { break }
        }
    }
    branch(NodeKind.ModuleDecl, kids)
}

fn Cursor mut @fn_decl() -> Node {
    mut kids = []Node.of(@take()) // KwFn
    if @peek() == TokenKind.Ident { kids.push(@take()) }
    if @peek() == TokenKind.LParen { kids.push(@take()) }
    while @peek() == TokenKind.Ident {
        mut pk = []Node.of(@take()) // имя параметра
        if @peek() == TokenKind.Ident { pk.push(@take()) } // тип (E1: int)
        if @peek() == TokenKind.Comma { pk.push(@take()) }
        kids.push(branch(NodeKind.Param, pk))
    }
    if @peek() == TokenKind.RParen { kids.push(@take()) }
    if @peek() == TokenKind.Arrow {
        mut rt = []Node.of(@take())
        if @peek() == TokenKind.Ident { rt.push(@take()) }
        kids.push(branch(NodeKind.RetType, rt))
    }
    if @peek() != TokenKind.LBrace {
        // Panic-mode bucket (no-cascade guard's catch, 2026-08-14): garbage
        // between the signature and the block collects into ONE Err branch —
        // one seeded mistake, one diagnostic — instead of leaking token by
        // token into the top level.
        mut junk = []Node.new()
        while !@at_eof() && @peek() != TokenKind.LBrace
            && @peek() != TokenKind.KwFn && @peek() != TokenKind.KwModule {
            junk.push(@take())
        }
        if junk.len() > 0 { kids.push(branch(NodeKind.Err, junk)) }
    }
    if @peek() == TokenKind.LBrace { kids.push(@block()) }
    branch(NodeKind.FnDecl, kids)
}

fn Cursor mut @block() -> Node {
    mut kids = []Node.of(@take()) // LBrace
    while !@at_eof() && @peek() != TokenKind.RBrace {
        kids.push(@stmt())
    }
    if @peek() == TokenKind.RBrace { kids.push(@take()) }
    branch(NodeKind.Block, kids)
}

// Head expression of if/while/for: record constructors OFF for its extent.
fn Cursor mut @head_expr() -> Node {
    @no_ctor = true
    ro e = @expr()
    @no_ctor = false
    e
}

fn Cursor mut @stmt() -> Node {
    if @peek() == TokenKind.KwIf {
        mut kids = []Node.of(@take())
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace { kids.push(@block()) }
        return branch(NodeKind.IfStmt, kids)
    }
    if @peek() == TokenKind.KwReturn {
        mut kids = []Node.of(@take())
        if @peek() != TokenKind.RBrace { kids.push(@expr()) }
        return branch(NodeKind.RetStmt, kids)
    }
    if @peek() == TokenKind.KwMut || @peek() == TokenKind.KwRo {
        // One BindStmt for both: the first leaf keeps KwMut/KwRo, C locals
        // are identical either way (the oracle emits no const).
        mut kids = []Node.of(@take())
        if @peek() == TokenKind.Ident { kids.push(@take()) }
        if @peek() == TokenKind.Assign { kids.push(@take()) }
        kids.push(@expr())
        return branch(NodeKind.BindStmt, kids)
    }
    if @peek() == TokenKind.KwWhile {
        mut kids = []Node.of(@take())
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace { kids.push(@block()) }
        return branch(NodeKind.WhileStmt, kids)
    }
    if @peek() == TokenKind.KwFor {
        mut kids = []Node.of(@take())
        if @peek() == TokenKind.Ident { kids.push(@take()) }
        if @peek() == TokenKind.KwIn { kids.push(@take()) }
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace { kids.push(@block()) }
        return branch(NodeKind.ForStmt, kids)
    }
    ro e = @expr()
    if @peek() == TokenKind.PlusAssign || @peek() == TokenKind.Assign {
        mut kids = []Node.of(e, @take())
        kids.push(@expr())
        return branch(NodeKind.AssignStmt, kids)
    }
    e
}

fn is_binop(k TokenKind) -> bool =>
    k == TokenKind.Plus || k == TokenKind.Minus || k == TokenKind.Star || k == TokenKind.Slash || k == TokenKind.Lt || k == TokenKind.Le || k == TokenKind.DotDot

fn Cursor mut @expr() -> Node {
    mut left = @primary()
    while is_binop(@peek()) {
        ro op = @take()
        ro right = @primary()
        left = branch(NodeKind.Bin, []Node.of(left, op, right))
    }
    left
}

fn Cursor mut @primary() -> Node {
    mut e = @atom()
    // Postfix loop: `.name(args)` chains left-to-right — `s.trim().len()`
    // nests MethodCall inside MethodCall; a dot WITHOUT a call is field
    // access (E2-records). Both are subset forms now; check judges the
    // method name against the one subset table.
    while @peek() == TokenKind.Dot {
        mut kids = []Node.of(e, @take()) // recv, '.'
        if @peek() == TokenKind.Ident { kids.push(@take()) }
        if @peek() == TokenKind.LParen {
            kids.push(@take())
            while !@at_eof() && @peek() != TokenKind.RParen {
                kids.push(@expr())
                if @peek() == TokenKind.Comma { kids.push(@take()) }
            }
            if @peek() == TokenKind.RParen { kids.push(@take()) }
            e = branch(NodeKind.MethodCall, kids)
        } else {
            e = branch(NodeKind.FieldAccess, kids)
        }
    }
    e
}

// Constructor field list after the opening brace: `name: expr`, punning
// `name`, spread `...expr` — comma-separated; the closing brace ends it.
fn Cursor mut @ctor_fields(mut kids []Node) -> () {
    while !@at_eof() && @peek() != TokenKind.RBrace {
        if @peek() == TokenKind.Ellipsis {
            mut sk = []Node.of(@take())
            sk.push(@expr())
            kids.push(branch(NodeKind.CtorSpread, sk))
        } else if @peek() == TokenKind.Ident {
            mut fk = []Node.of(@take())
            if @peek() == TokenKind.Colon {
                fk.push(@take())
                fk.push(@expr())
            }
            kids.push(branch(NodeKind.CtorField, fk))
        } else {
            // Recovery inside a constructor: one Err, one token, advance.
            kids.push(branch(NodeKind.Err, []Node.of(@take())))
        }
        if @peek() == TokenKind.Comma { kids.push(@take()) }
    }
    if @peek() == TokenKind.RBrace { kids.push(@take()) }
}

fn Cursor mut @atom() -> Node {
    if @peek() == TokenKind.IntLit || @peek() == TokenKind.FloatLit || @peek() == TokenKind.StrLit {
        return branch(NodeKind.Lit, []Node.of(@take()))
    }
    if @peek() == TokenKind.LBrace && !@no_ctor {
        // Anonymous constructor `{ ...p, y: 10.0 }` — the record type comes
        // from the spread's expression (type inference is the emitter's
        // tiny lattice for now).
        mut kids = []Node.of(@take())
        @ctor_fields(kids)
        return branch(NodeKind.RecordCtor, kids)
    }
    if @peek() == TokenKind.Ident {
        ro name = @take()
        if @peek() == TokenKind.LParen {
            mut kids = []Node.of(name, @take())
            while !@at_eof() && @peek() != TokenKind.RParen {
                kids.push(@expr())
                if @peek() == TokenKind.Comma { kids.push(@take()) }
            }
            if @peek() == TokenKind.RParen { kids.push(@take()) }
            return branch(NodeKind.Call, kids)
        }
        if @peek() == TokenKind.LBrace && !@no_ctor {
            mut kids = []Node.of(branch(NodeKind.Name, []Node.of(name)), @take())
            @ctor_fields(kids)
            return branch(NodeKind.RecordCtor, kids)
        }
        return branch(NodeKind.Name, []Node.of(name))
    }
    // Recovery: unexpected token — one Err branch, one token, move on.
    branch(NodeKind.Err, []Node.of(@take()))
}
