// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Roslyn `LanguageParser` (hand-written recursive descent by token kind;
// `MissingToken` zero-width leaves; `IsTerminator` stop set; `IsMakingProgress`
// non-advancement guard; `PeekToken(1)` for `fn Recv @name`) + rustc
// `Parser::expect_one_of`; Pratt (1973) precedence climbing for binary operators,
// as rustc spells it in `parse_expr_assoc_with` and Go in `binaryExpr(prec)`, with
// the powers taken verbatim from the spec's precedence table (03-syntax);
// Dragon Book (2nd ed.) §4.1.4 panic mode for the junk buckets; Go spec \"Composite literals\" ambiguity rule (go/parser `exprLev`) for
// no_ctor; rustc `AssocOp::DotDot` for `..` as a binary node; NOT taken: Roslyn
// incremental reparse.
// Role: layer 2 — the syntax door with recovery; one seeded mistake yields one Err branch, never a cascade.
// Used by: pipeline (E1+); the no-cascade and grammar-coverage guards; the LSP at E3 reads the same tree.
// Guarded by: check-novac-no-cascade.sh (one seeded mistake, one diagnostic), check-novac-grammar-fixture-coverage.sh, novac-fuzz-mutations.sh (recovery never panics or hangs).
// branch that KEEPS the tokens, so the tree stays byte-exact under any input;
// NOT taken: Roslyn's incremental reparse (a batch compiler needs none).
// novac/src/parse — tokens to green tree (architecture §2: module `parse`).
//
// E1 subset grammar: module declaration, fn declarations with empty parameter
// lists, blocks, call expressions, string/int literals, names, binary
// expressions with the spec's precedence (Pratt, see `expr_bp`). Everything else is RECOVERED, never fatal: an
// unexpected token becomes an Err branch holding exactly that token, and
// parsing continues with the next one. The parser can therefore never lose a
// byte and never stop early — the lead invariant holds through the tree:
//     tree_reserialize(parse(lex(src))) == src, for every input.
//
// No Result in signatures (274 §4 item 1): parse always returns a File node.
// Diagnostics for Err nodes are the next slice (edge parse -> diag is in the
// table; the node IS the representation, the report is separate).

module novac.parse

import ../lex.{Token, TokenKind}
import ../tree.{Node, NodeKind, BinOp, branch, leaf, is_binop, bin_op}

/// The parser's walking state over one Eof-terminated token stream.
type Cursor {
    toks []Token /// the lex output being parsed
    i int /// next-token index; take() is the only advancer
    /// Next branch identity. The parser is the ONE pass that sees every node
    /// exactly once, so it is the honest place to name them (Zig `Ast`,
    /// Carbon `Parse::Tree`); ids are dense and per-parse, and the checker's
    /// channel is sized from the last one handed out.
    next_id int
    /// Go's composite-literal rule: inside an if/while/for HEAD a record
    /// constructor is not parsed — `if x {` must read the brace as the
    /// block, not as `x { ... }`. Set for the head expression only; block
    /// bodies parse with it clear.
    no_ctor bool
}

/// Build a branch node and give it its identity — the ONE place ids are
/// handed out, so "dense and in creation order" is a fact of this function
/// rather than a rule every builder has to remember.
fn Cursor mut @node(kind NodeKind, children []Node) -> Node {
    ro id = @next_id
    @next_id += 1
    branch(id, kind, children)
}

/// Safe past the end: peek answers Eof forever once the stream is exhausted.
/// Together with the advancing take below this kills two latent doors at
/// once (E1 review p.2, 2026-08-14): an unguarded loop can no longer hang on
/// a non-advancing cursor, and recovery that consumes the Eof leaf (its
/// leading carries the file's TAIL trivia) can no longer lead to that trivia
/// being emitted twice -- the final push in parse() is conditional now.
fn Cursor @peek() -> TokenKind {
    if @i >= @toks.len() { return TokenKind.Eof }
    @toks[@i].kind
}

/// Take the current token as a leaf and advance; the only advancer.
fn Cursor mut @take() -> Node {
    // Past the end of the stream, take() returns an EMPTY leaf and does
    // NOT move the cursor (274.3/F16, the Roslyn MissingToken model):
    // there used to be an assert here, and one future recovery edit
    // turned a truncated file into a process death with no diagnostic.
    // The empty leaf carries the slice src[n..n] — the positions door
    // gets a real pointer, not someone else's.
    if @i >= @toks.len() {
        ro last = @toks[@toks.len() - 1]
        return leaf(Token { kind: TokenKind.Eof, leading: "", text: last.text })
    }
    ro n = leaf(@toks[@i])
    @i += 1
    n
}

/// A missing token: a ZERO-WIDTH leaf at the position of the current
/// token (the Roslyn MissingToken model). The cursor does not move,
/// reserialization does not change (empty text adds nothing), but the
/// diagnostic gets an exact position — without it, recovery at a
/// terminator gave an Err with no leaves, that is SILENT acceptance of
/// broken input (caught by the fuzzer right after terminator input was
/// added, 274.3/F15).
fn Cursor @missing() -> Node {
    if @i >= @toks.len() {
        ro last = @toks[@toks.len() - 1]
        return leaf(Token { kind: TokenKind.ErrorTok, leading: "", text: last.text })
    }
    ro t = @toks[@i]
    leaf(Token { kind: TokenKind.ErrorTok, leading: "", text: t.text[..0] })
}

/// Tokens that CLOSE the enclosing construct: recovery must not eat
/// them (274.3/F15, the Roslyn IsTerminator / rustc expect_one_of
/// model). An eaten closing bracket used to drag away the whole rest
/// of the file: `g(1 + )` gave four diagnostics, and declarations
/// after the broken spot stopped existing in the tree at all.
fn is_terminator(k TokenKind) -> bool =>
    k == TokenKind.RParen || k == TokenKind.RBrace || k == TokenKind.RBracket || k == TokenKind.KwFn || k == TokenKind.KwType || k == TokenKind.KwModule || k == TokenKind.Eof

/// True once the stream is exhausted.
fn Cursor @at_eof() -> bool => @peek() == TokenKind.Eof

/// The kind of the token one AHEAD — needed exactly where the form is
/// told apart by a pair: `fn <Recv> @<name>` (method) versus
/// `fn <name>` (function). Like peek(), safe past the end of the
/// stream.
fn Cursor @peek2() -> TokenKind {
    if @i + 1 >= @toks.len() { return TokenKind.Eof }
    @toks[@i + 1].kind
}

/// Parse a whole token stream (as produced by lex: Eof-terminated).
export fn parse(toks []Token) -> Node {
    mut p = Cursor { toks, i: 0, no_ctor: false, next_id: 0 }
    mut items = []Node.new()
    if p.peek() == TokenKind.KwModule {
        items.push(p.module_decl())
    }
    while !p.at_eof() {
        if p.peek() == TokenKind.KwFn {
            items.push(p.fn_decl())
        } else if p.peek() == TokenKind.KwType {
            items.push(p.type_decl())
        } else if p.peek() == TokenKind.KwModule {
            // A module declaration that is NOT the file header is outside
            // the language shape — wrap it in Err so check reports it. It
            // MUST be consumed here: both junk buckets stop at KwModule as
            // a sync point, so a loop iteration that never eats it does not
            // advance (fuzzer catch 2026-08-14: a doubled file hung forever
            // pushing empty Err branches until the GC died).
            items.push(p.node(NodeKind.Err, []Node.of(p.module_decl())))
        } else {
            // Panic-mode bucket, same rule as inside fn_decl (E1 review p.1,
            // 2026-08-14): a RUN of stray top-level tokens is ONE seeded
            // mistake and collects into ONE Err branch -- one diagnostic --
            // instead of an Err per token (a file starting `1 2 3` used to
            // produce three diagnostics for one cause, a cascade by the
            // no-cascade guard's own definition).
            mut junk = []Node.new()
            while !p.at_eof() && p.peek() != TokenKind.KwFn
                && p.peek() != TokenKind.KwModule && p.peek() != TokenKind.KwType {
                junk.push(p.take())
            }
            items.push(p.node(NodeKind.Err, junk))
        }
    }
    // The Eof leaf carries the file's tail trivia -- emit it exactly ONCE.
    // Recovery inside a broken expression (e.g. `1 +` at end of file) may
    // already have consumed it into an Err branch; pushing unconditionally
    // here would duplicate the tail trivia and break reserialization.
    if p.i < p.toks.len() {
        items.push(p.take())
    }
    p.node(NodeKind.File, items)
}

/// `type Name { field type ... }` — fields are newline-separated pairs of
/// idents, no commas. `type Name` followed by leading `|` variants is a sum
/// (the corpus form on the pin; the oracle accepts it — divergence registry,
/// prediction 1). A non-brace, non-pipe tail falls into the top loop's
/// recovery on the next token.
fn Cursor mut @type_decl() -> Node {
    mut kids = []Node.of(@take()) // KwType
    if @peek() == TokenKind.Ident { kids.push(@take()) }
    if @peek() == TokenKind.Pipe {
        while @peek() == TokenKind.Pipe {
            mut vk = []Node.of(@take()) // '|'
            if @peek() == TokenKind.Ident { vk.push(@take()) }
            if @peek() == TokenKind.LParen {
                vk.push(@take())
                while @peek() == TokenKind.Ident {
                    vk.push(@take()) // payload type name
                    if @peek() == TokenKind.Comma { vk.push(@take()) }
                }
                if @peek() == TokenKind.RParen { vk.push(@take()) }
            }
            kids.push(@node(NodeKind.Variant, vk))
        }
        return @node(NodeKind.SumDecl, kids)
    }
    if @peek() == TokenKind.LBrace {
        kids.push(@take())
        while @peek() == TokenKind.Ident {
            mut fk = []Node.of(@take()) // field name
            if @peek() == TokenKind.Ident { fk.push(@take()) } // field type
            kids.push(@node(NodeKind.Field, fk))
        }
        if @peek() == TokenKind.RBrace { kids.push(@take()) }
    }
    @node(NodeKind.TypeDecl, kids)
}

/// Parse `module a.b.c`.
fn Cursor mut @module_decl() -> Node {
    mut kids = []Node.of(@take()) // KwModule
    if @peek() == TokenKind.Ident {
        kids.push(@take())
        while @peek() == TokenKind.Dot {
            kids.push(@take())
            if @peek() == TokenKind.Ident { kids.push(@take()) } else { break }
        }
    }
    @node(NodeKind.ModuleDecl, kids)
}

/// Parse `fn name(params) -> T { body }` or `=> expr`, with junk recovery.
fn Cursor mut @fn_decl() -> Node {
    mut kids = []Node.of(@take()) // KwFn
    // Method declaration `fn <Recv> @<name>(...)`: the receiver is a
    // separate node, the name is read after '@'. This form is not for the
    // subset (novac does not declare methods), but for READING std
    // signatures: the subset method table is built from declarations, not
    // from a list of names in the compiler (П5).
    if @peek() == TokenKind.Ident && @peek2() == TokenKind.At {
        mut rk = []Node.of(@take()) // receiver type
        rk.push(@take())            // '@'
        kids.push(@node(NodeKind.Recv, rk))
    }
    if @peek() == TokenKind.Ident { kids.push(@take()) }
    if @peek() == TokenKind.LParen { kids.push(@take()) }
    while @peek() == TokenKind.Ident {
        mut pk = []Node.of(@take()) // parameter name
        if @peek() == TokenKind.Ident { pk.push(@take()) } // type (E1: int)
        if @peek() == TokenKind.Comma { pk.push(@take()) }
        kids.push(@node(NodeKind.Param, pk))
    }
    if @peek() == TokenKind.RParen { kids.push(@take()) }
    if @peek() == TokenKind.Arrow {
        mut rt = []Node.of(@take())
        if @peek() == TokenKind.Ident { rt.push(@take()) }
        kids.push(@node(NodeKind.RetType, rt))
    }
    if @peek() != TokenKind.LBrace && @peek() != TokenKind.FatArrow {
        // Panic-mode bucket (no-cascade guard's catch, 2026-08-14): garbage
        // between the signature and the body collects into ONE Err branch —
        // one seeded mistake, one diagnostic — instead of leaking token by
        // token into the top level. FatArrow is a body form (`=> expr`),
        // not junk — the bucket stops on it like on LBrace.
        mut junk = []Node.new()
        while !@at_eof() && @peek() != TokenKind.LBrace
            && @peek() != TokenKind.FatArrow
            && @peek() != TokenKind.KwFn && @peek() != TokenKind.KwModule {
            junk.push(@take())
        }
        if junk.len() > 0 { kids.push(@node(NodeKind.Err, junk)) }
    }
    if @peek() == TokenKind.FatArrow {
        // Expression-bodied fn: `fn area(...) -> f64 => match ...`
        mut ek = []Node.of(@take())
        ek.push(@expr())
        kids.push(@node(NodeKind.FnExprBody, ek))
        return @node(NodeKind.FnDecl, kids)
    }
    if @peek() == TokenKind.LBrace { kids.push(@block()) }
    @node(NodeKind.FnDecl, kids)
}

/// Parse `{ stmt* }`.
fn Cursor mut @block() -> Node {
    mut kids = []Node.of(@take()) // LBrace
    while !@at_eof() && @peek() != TokenKind.RBrace {
        // Guard against non-advancement (274.3/F15-F16): recovery can
        // return a zero-width node without moving the cursor — then the loop
        // must exit, not spin. This role used to be played by an assert in
        // take(), which meant death.
        ro before = @i
        kids.push(@stmt())
        if @i == before { break }
    }
    if @peek() == TokenKind.RBrace { kids.push(@take()) }
    @node(NodeKind.Block, kids)
}

/// Head expression of if/while/for: record constructors OFF for its extent.
fn Cursor mut @head_expr() -> Node {
    @no_ctor = true
    ro e = @expr()
    @no_ctor = false
    e
}

/// Parse one statement: if/while/return/mut/ro/for, or an expression (assignment).
fn Cursor mut @stmt() -> Node {
    if @peek() == TokenKind.KwIf {
        mut kids = []Node.of(@take())
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace { kids.push(@block()) }
        return @node(NodeKind.IfStmt, kids)
    }
    if @peek() == TokenKind.KwReturn {
        mut kids = []Node.of(@take())
        if @peek() != TokenKind.RBrace { kids.push(@expr()) }
        return @node(NodeKind.RetStmt, kids)
    }
    if @peek() == TokenKind.KwMut || @peek() == TokenKind.KwRo {
        // One BindStmt for both: the first leaf keeps KwMut/KwRo, C locals
        // are identical either way (the oracle emits no const).
        mut kids = []Node.of(@take())
        if @peek() == TokenKind.Ident { kids.push(@take()) }
        if @peek() == TokenKind.Assign { kids.push(@take()) }
        kids.push(@expr())
        return @node(NodeKind.BindStmt, kids)
    }
    if @peek() == TokenKind.KwWhile {
        mut kids = []Node.of(@take())
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace { kids.push(@block()) }
        return @node(NodeKind.WhileStmt, kids)
    }
    if @peek() == TokenKind.KwFor {
        mut kids = []Node.of(@take())
        if @peek() == TokenKind.Ident { kids.push(@take()) }
        if @peek() == TokenKind.KwIn { kids.push(@take()) }
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace { kids.push(@block()) }
        return @node(NodeKind.ForStmt, kids)
    }
    ro e = @expr()
    if @peek() == TokenKind.PlusAssign || @peek() == TokenKind.Assign {
        mut kids = []Node.of(e, @take())
        kids.push(@expr())
        return @node(NodeKind.AssignStmt, kids)
    }
    e
}

/// Binding power of a binary operator: the DECISION decides, not the token.
///
/// The numbers ARE the spec's precedence table (03-syntax, the operator
/// precedence hierarchy): levels 12, 11, 6 of it, and the range level 2.
/// The match is exhaustive on purpose -- a new operator does not compile
/// until this table says where it binds, which is the property the old
/// token-keyed if-chain could not have.
fn binding_power(op BinOp) -> int {
    match op {
        Mul | Div | Modulo => 12
        Add | Sub => 11
        Less | LessEq | Greater | GreaterEq => 6
        Range => 2
    }
}

/// Parse an expression -- precedence climbing (Pratt 1973; the shape rustc
/// spells `parse_expr_assoc_with` and Go spells `binaryExpr(prec)`).
///
/// WHAT THIS REPLACED, and why it was a defect rather than a subset limit
/// (owner asked 2026-08-16; recorded as 274.3/F18 when it was found). The
/// first parser built a FLAT left-associative chain over every operator, so
/// `1 + 2 * 3` parsed as `(1 + 2) * 3` and the emitted C computed 9 where
/// the language says 7. Nothing above the parser could repair it: by the
/// time check or the emitter sees the tree, the grouping is already wrong,
/// and both faithfully emit the wrong answer. A wrong number is not a
/// subset boundary -- the subset may REFUSE a form, never mis-compute it.
///
/// `..` is non-associative in the table: `a .. b .. c` is not a Nova
/// expression, so after one range operator the loop stops rather than
/// chaining, and the leftover `..` is refused by the caller's grammar.
fn Cursor mut @expr() -> Node => @expr_bp(1)

/// The climbing loop: consume operators whose binding power is at least
/// `min_bp`, and parse their right side at `bp + 1` (left associativity).
fn Cursor mut @expr_bp(min_bp int) -> Node {
    mut left = @primary()
    while is_binop(@peek()) {
        ro bp = binding_power(bin_op(@peek()))
        if bp < min_bp { return left }
        ro op = @take()
        // Non-associative range: its right side must not swallow another
        // `..`, so it is parsed one level ABOVE its own power, like every
        // left-associative operator -- and then the loop refuses to take a
        // second `..` at the same level.
        ro right = @expr_bp(bp + 1)
        left = @node(NodeKind.Bin, []Node.of(left, op, right))
        if bp == 2 { return left }
    }
    left
}

/// Parse an atom with its postfix chain: `.method(args)` and `.field`.
fn Cursor mut @primary() -> Node {
    mut e = @atom()
    // Postfix loop: `.name(args)` chains left-to-right — `s.trim().len()`
    // nests MethodCall inside MethodCall; a dot WITHOUT a call is field
    // access (E2-records). Both are subset forms now; check judges the
    // method name against the one subset table.
    while @peek() == TokenKind.Dot {
        mut kids = []Node.of(e, @take()) // recv, '.'
        if @peek() == TokenKind.Ident { kids.push(@take()) }
        if @peek() == TokenKind.LParen {
            kids.push(@take())
            while !@at_eof() && @peek() != TokenKind.RParen {
                ro before = @i
                kids.push(@expr())
                if @peek() == TokenKind.Comma { kids.push(@take()) }
                if @i == before { break }
            }
            if @peek() == TokenKind.RParen { kids.push(@take()) }
            e = @node(NodeKind.MethodCall, kids)
        } else {
            e = @node(NodeKind.FieldAccess, kids)
        }
    }
    e
}

/// `match scrutinee { arm* }` — an arm is `pattern [if guard] => expr`.
/// Patterns of the subset: int literal · binder ident (`_` included — the
/// emitter treats any binder named `_` as bindless) · `Variant(b1, b2)`.
/// Arm separators are newlines (D452 land); the tree does not care — arms
/// run to the closing brace, lossless either way.
fn Cursor mut @match_expr() -> Node {
    mut kids = []Node.of(@take()) // KwMatch
    kids.push(@head_expr())       // scrutinee: `match s {` — brace is the body
    if @peek() == TokenKind.LBrace { kids.push(@take()) }
    while !@at_eof() && @peek() != TokenKind.RBrace {
        ro before = @i
        mut ak = []Node.new()
        // pattern
        if @peek() == TokenKind.IntLit {
            ak.push(@node(NodeKind.Pattern, []Node.of(@take())))
        } else if @peek() == TokenKind.LBracket {
            // Array pattern: `[]` (empty) or `[b1, b2, ..]` (prefix binders
            // + optional rest). Leaves in order; the emitter reads binders
            // as Ident leaves and `..` as the rest marker.
            mut pk = []Node.of(@take())
            while !@at_eof() && @peek() != TokenKind.RBracket {
                if @peek() == TokenKind.Ident || @peek() == TokenKind.DotDot {
                    pk.push(@take())
                } else {
                    pk.push(@node(NodeKind.Err, []Node.of(@take())))
                }
                if @peek() == TokenKind.Comma { pk.push(@take()) }
            }
            if @peek() == TokenKind.RBracket { pk.push(@take()) }
            ak.push(@node(NodeKind.Pattern, pk))
        } else if @peek() == TokenKind.Ident {
            mut pk = []Node.of(@take())
            if @peek() == TokenKind.LParen {
                pk.push(@take())
                while @peek() == TokenKind.Ident {
                    pk.push(@take())
                    if @peek() == TokenKind.Comma { pk.push(@take()) }
                }
                if @peek() == TokenKind.RParen { pk.push(@take()) }
            }
            ak.push(@node(NodeKind.Pattern, pk))
        } else {
            // Recovery: one Err, one token, keep the arm loop advancing.
            kids.push(@node(NodeKind.Err, []Node.of(@take())))
            continue
        }
        if @peek() == TokenKind.KwIf {
            mut gk = []Node.of(@take())
            gk.push(@expr())
            ak.push(@node(NodeKind.Guard, gk))
        }
        if @peek() == TokenKind.FatArrow { ak.push(@take()) }
        ak.push(@expr())
        kids.push(@node(NodeKind.MatchArm, ak))
        if @i == before { break }
    }
    if @peek() == TokenKind.RBrace { kids.push(@take()) }
    @node(NodeKind.MatchExpr, kids)
}

/// Constructor field list after the opening brace: `name: expr`, punning
/// `name`, spread `...expr` — comma-separated; the closing brace ends it.
fn Cursor mut @ctor_fields(mut kids []Node) -> () {
    while !@at_eof() && @peek() != TokenKind.RBrace {
        ro before = @i
        if @peek() == TokenKind.Ellipsis {
            mut sk = []Node.of(@take())
            sk.push(@expr())
            kids.push(@node(NodeKind.CtorSpread, sk))
        } else if @peek() == TokenKind.Ident {
            mut fk = []Node.of(@take())
            if @peek() == TokenKind.Colon {
                fk.push(@take())
                fk.push(@expr())
            }
            kids.push(@node(NodeKind.CtorField, fk))
        } else {
            // Recovery inside a constructor: one Err, one token, advance.
            kids.push(@node(NodeKind.Err, []Node.of(@take())))
        }
        if @peek() == TokenKind.Comma { kids.push(@take()) }
        if @i == before { break }
    }
    if @peek() == TokenKind.RBrace { kids.push(@take()) }
}

/// Parse a literal, match, array/record constructor, call or name; recover otherwise.
fn Cursor mut @atom() -> Node {
    if @peek() == TokenKind.IntLit || @peek() == TokenKind.FloatLit || @peek() == TokenKind.StrLit {
        return @node(NodeKind.Lit, []Node.of(@take()))
    }
    if @peek() == TokenKind.Minus {
        // Unary minus on a numeric literal only (`describe(-3)`); anything
        // else after `-` recovers as Err through the literal branch below.
        mut kids = []Node.of(@take())
        if @peek() == TokenKind.IntLit || @peek() == TokenKind.FloatLit {
            kids.push(@take())
            return @node(NodeKind.Lit, kids)
        }
        return @node(NodeKind.Err, kids)
    }
    if @peek() == TokenKind.KwMatch { return @match_expr() }
    if @peek() == TokenKind.LBracket {
        // Array literal `[e, ...spread, e]` — comma-separated; a spread
        // element is ArraySpread [Ellipsis, expr].
        mut kids = []Node.of(@take())
        while !@at_eof() && @peek() != TokenKind.RBracket {
            ro before = @i
            if @peek() == TokenKind.Ellipsis {
                mut sk = []Node.of(@take())
                sk.push(@expr())
                kids.push(@node(NodeKind.ArraySpread, sk))
            } else {
                kids.push(@expr())
            }
            if @peek() == TokenKind.Comma { kids.push(@take()) }
            if @i == before { break }
        }
        if @peek() == TokenKind.RBracket { kids.push(@take()) }
        return @node(NodeKind.ArrayLit, kids)
    }
    if @peek() == TokenKind.LBrace && !@no_ctor {
        // Anonymous constructor `{ ...p, y: 10.0 }` — the record type comes
        // from the spread's expression (type inference is the emitter's
        // tiny lattice for now).
        mut kids = []Node.of(@take())
        @ctor_fields(kids)
        return @node(NodeKind.RecordCtor, kids)
    }
    if @peek() == TokenKind.Ident {
        ro name = @take()
        if @peek() == TokenKind.LParen {
            mut kids = []Node.of(name, @take())
            while !@at_eof() && @peek() != TokenKind.RParen {
                ro before = @i
                kids.push(@expr())
                if @peek() == TokenKind.Comma { kids.push(@take()) }
                if @i == before { break }
            }
            if @peek() == TokenKind.RParen { kids.push(@take()) }
            return @node(NodeKind.Call, kids)
        }
        if @peek() == TokenKind.LBrace && !@no_ctor {
            mut kids = []Node.of(@node(NodeKind.Name, []Node.of(name)), @take())
            @ctor_fields(kids)
            return @node(NodeKind.RecordCtor, kids)
        }
        return @node(NodeKind.Name, []Node.of(name))
    }
    // Recovery: an unexpected token — one Err, one token, move on. But a
    // CLOSING token is not consumed: it belongs to the enclosing form
    // (274.3/F15). A zero-width Err — the cursor does not move, and the
    // enclosing loop must notice this (see the non-advancement guard in
    // block/args).
    if is_terminator(@peek()) {
        return @node(NodeKind.Err, []Node.of(@missing()))
    }
    @node(NodeKind.Err, []Node.of(@take()))
}
