// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: same as parse.nv (Roslyn LanguageParser statement walk).
// Role: layer 2's statement half -- the block walk and the statement
//       forms (`if`/`while`/`for` heads, bindings, the bare block,
//       `defer`). Split out of parse.nv by MEANING (decision 12) when the
//       file crossed a thousand lines on 2026-10-31 (task 134): parse.nv
//       keeps the cursor machinery and the declaration half, this file
//       keeps what lives INSIDE a body. Same module (novac.parse): the
//       cursor and its doors need no import.
// Used by: parse.nv's @fn_decl (every body is parsed through @block here).
// Guarded by: check-novac-file-size.py (this split), check-novac-deps.py,
//   check-novac-doc-language.py.
// novac/src/parse/stmt.nv -- the statement walk.

module novac.parse

import ../lex.{TokenKind}
import ../builtins.{WITH_WORD, SUPERVISED_WORD, SPAWN_WORD}
import ../tree.{Node, NodeKind, branch, leaf, is_assign_op}
/// Parse `{ stmt* }`.
fn Cursor mut @block() -> Node {
    mut kids = []Node.of(@take()) // LBrace
    while !@at_eof() && @peek() != TokenKind.RBrace {
        // Guard against non-advancement (274.3/F15-F16): recovery can
        // return a zero-width node without moving the cursor — then the loop
        // must exit, not spin. This role used to be played by an assert in
        // take(), which meant death.
        ro before = @i
        // A BARE `;` IS NOT A STATEMENT -- D49's own line: "Empty `;` are
        // forbidden -- always a bug" (spec/decisions/03-syntax.md:3430), found
        // by the spec-reader during this wave after the oracle measured
        // ACCEPTING `fn main() { ; }` (2026-09-28; the divergence of the
        // oracle from its own spec is registry 221.1 #TBD). The byte is
        // still TAKEN here, into an Err node: with no door at all the
        // Semicolon leaf stalls @stmt and the block loop spins forever on
        // exactly this input (measured on a broken build during the wave).
        // One Err, one token, the checker's error-node door names it.
        // RECOVERY-BOUNDED: only a Semicolon is ever taken here -- the
        // @peek() guard above admits nothing else, so no enclosing closer
        // can be eaten by this take.
        if @peek() == TokenKind.Semicolon {
            kids.push(@node(NodeKind.Err, []Node.of(@take())))
            continue
        } else {
            // A real statement: parsed below.
        }
        kids.push(@stmt())
        // `;` IS A STATEMENT END (D85's grammar: `statement-end = ';' |
        // NEWLINE | look-ahead '}'`). The newline form never surfaces here
        // (trivia), so without this line the byte was a Semicolon leaf with
        // no door and the second statement of `{ i += 2; kind = Tilde }`
        // fell to the parser's fallback -- forty carriers in lex.nv alone.
        // Kept in the tree, as every other separator is.
        @push_if(kids, TokenKind.Semicolon)
        if @i == before { break }
    }
    @push_expected(kids, TokenKind.RBrace)
    @node(NodeKind.Block, kids)
}

/// Head expression of if/while/for: record constructors OFF for its extent.
///
/// SAVE and restore, not set-and-clear (274.3/F23). The old pair wrote `true`
/// then `false` unconditionally, so a head nested inside another head came
/// back with the flag already cleared and the outer head started accepting
/// `{` as a constructor again. Go's composite-literal rule -- which this
/// implements -- is a STACK discipline in every implementation of it (go/parser
/// exprLev, rustc restrictions bitflags), for the same reason.
fn Cursor mut @head_expr() -> Node {
    ro saved = @no_ctor
    @no_ctor = true
    ro e = @expr()
    @no_ctor = saved
    e
}

/// IF-LET OR PLAIN IF, asked in ONE place (D486 §4, wave P3): take the KwIf,
/// read a PATTERN through the one door (`@pattern`, expr.nv), and if the
/// token after it is `=` the statement is an if-let -- otherwise rewind and
/// read an ordinary `if`. An `=` can never follow a condition expression
/// (assignment is a statement, D-grammar), so the question has exactly one
/// honest answer. The rewind restores BOTH counters: `i` (tokens) and
/// `next_id` (node identities) -- the trial parse spent both, and ids must
/// stay dense and in creation order (the checker's channel is sized from the
/// last one). `@pattern` touches no other cursor state: it never recurses
/// into `@expr`, so `no_ctor`, `depth` and `depth_told` are untouched by the
/// trial. The cost is a double read of a short prefix, measured against the
/// alternatives (a hand-rolled lookahead per form was registry #1259's second
/// tree, which this wave exists to delete).
fn Cursor mut @iflet_try(in_value bool = false) -> Option[Node] {
    if @peek() != TokenKind.KwIf { return None }
    ro save_i = @i
    ro save_id = @next_id
    mut kids = []Node.of(@take())
    ro pat = @pattern()
    if @peek() != TokenKind.Assign {
        @i = save_i
        @next_id = save_id
        return None
    }
    kids.push(pat)
    kids.push(@take()) // `=`
    // The initializer is a HEAD expression (wave W1, 274.7): a `{` after it
    // opens the then-block, never a record constructor.
    kids.push(@head_expr())
    kids.push(@block())
    // `else` after an if-let (wave W1): [.. then-block, KwElse, <Block |
    // IfStmt | IfLet>]. The layout is FIXED now -- the pattern is one child
    // wherever its head stood -- so the slots are plain constants
    // (sem/slots.nv), and registry #1259's qualifier shift is gone with the
    // second tree that needed it.
    if @peek() == TokenKind.KwElse {
        kids.push(@take())
        if @peek() == TokenKind.KwIf {
            // A chained `if` in VALUE position is an IfExpr/IfLet (the value
            // door's own chain, registry #1243), in statement position an
            // IfStmt/IfLet -- each chain recurses into ITS door.
            if in_value { kids.push(@atom()) } else { kids.push(@stmt()) }
        } else if @peek() == TokenKind.LBrace {
            kids.push(@block())
        } else {
            // `else` with neither a block nor a chained `if`: incomplete,
            // and the tree must SAY so or check finds nothing wrong.
            kids.push(@error_node(TokenKind.ErrorTok))
        }
    } else {
        // No else branch: the if-let is complete on its own.
    }
    Some(@node(NodeKind.IfLet, kids))
}

/// WHILE-LET OR PLAIN WHILE (wave P4): the same one question as `@iflet_try`
/// -- a PATTERN through the one door, then `=` -- over the same rewind
/// discipline (both counters restored; D486 s8). A while-let has no `else`:
/// the None path is the loop's exit, not a branch.
fn Cursor mut @whilelet_try() -> Option[Node] {
    if @peek() != TokenKind.KwWhile { return None }
    ro save_i = @i
    ro save_id = @next_id
    mut kids = []Node.of(@take())
    ro pat = @pattern()
    if @peek() != TokenKind.Assign {
        @i = save_i
        @next_id = save_id
        return None
    }
    kids.push(pat)
    kids.push(@take()) // `=`
    // The initializer is a HEAD expression for the same reason as the
    // if-let's (wave W1): the `{` after it opens the body.
    kids.push(@head_expr())
    kids.push(@block())
    Some(@node(NodeKind.WhileLet, kids))
}

/// Does the identifier under the cursor open a PATTERN (D486)? Asked by the
/// binding dispatch: after `ro`/`mut`/`consume` an identifier can start an
/// ordinary binding (`ro x = ...`, `ro x int = ...`, `ro x mod.Type = ...`)
/// or a pattern with a head (`ro Some(x) = ...`, `ro Shape.Circle { r } = ...`,
/// `ro A | B = ...`). A head is the identifier plus a qualified run that a
/// `(`, `{` or `|` closes; the walk over `. ident` pairs is what keeps a
/// qualified TYPE of an ordinary binding from being taken for a head.
fn Cursor @pattern_head_ahead() -> bool {
    mut skip = 1
    while @peek(skip: skip) == TokenKind.Dot && @peek(skip: skip + 1) == TokenKind.Ident {
        skip += 2
    }
    @peek(skip: skip) == TokenKind.LParen || @peek(skip: skip) == TokenKind.LBrace ||
        @peek(skip: skip) == TokenKind.Pipe
}

/// Cursor at a statement's leading `{`: does the brace open an ANONYMOUS
/// RECORD CONSTRUCTOR (a legal tail/argument/initializer expression) rather
/// than a bare block? The constructor's first entry gives it away: `name:`,
/// the `name` shorthand (a `,` or the closing `}` right after it), the
/// `@name` receiver punning (D52 rule 1) or the `...base` spread (D60 --
/// Ellipsis, never DotDot). No statement opens with any of those, so the
/// peek is the whole answer -- and `{ x }` keeps reading as a one-field
/// constructor, exactly as the statement chain read it before 2026-10-31.
/// The same question the expression doors ask before gluing `Name {` /
/// `a.b {` (expr.nv) -- ONE predicate, the oracle's looks_like_record_lit
/// discipline; an empty `{}` is a block, never a constructor (Plan 52.2,
/// D55 §5).
fn Cursor @anon_ctor_ahead() -> bool {
    ro t1 = @peek(skip: 1)
    if t1 == TokenKind.Ellipsis { return true }
    if t1 == TokenKind.At { return @peek(skip: 2) == TokenKind.Ident }
    if t1 != TokenKind.Ident { return false }
    ro t2 = @peek(skip: 2)
    t2 == TokenKind.Colon || t2 == TokenKind.Comma || t2 == TokenKind.RBrace
}

/// Cursor at the `{` after a record HEAD (`Pt {`, `Node.Branch {`): does the
/// brace open the constructor? The anonymous question (@anon_ctor_ahead)
/// plus the EMPTY constructor: `Pt { }` after a head is a construction,
/// judged against its declaration (registry #812, the pipeline contract),
/// while a bare `{ }` in statement position is an empty block (Plan 52.2,
/// D55 §5).
fn Cursor @named_ctor_ahead() -> bool {
    @anon_ctor_ahead() || @peek(skip: 1) == TokenKind.RBrace
}

/// Parse one statement: if/while/return/mut/ro/for, or an expression (assignment).
fn Cursor mut @stmt() -> Node {
    // IF-LET (wave P3, D486): the one question -- a PATTERN through the one
    // door, then `=` -- lives in `@iflet_try` above and is shared with the
    // value door (`@atom`, expr.nv).
    match @iflet_try() {
        Some(n) => return n
        None => {}
    }
    if @peek() == TokenKind.KwIf {
        mut kids = []Node.of(@take())
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace {
            kids.push(@block())
        } else {
            // `if cond` with no body: the statement is incomplete and the
            // tree must SAY so. Without a marker check finds nothing wrong
            // and the emitter reaches for a third child that is not there.
            kids.push(@error_node(TokenKind.ErrorTok))
        }
        // `else` and the `else if` chain. Both shapes hang off the SAME
        // node: [KwIf, cond, block, KwElse, <Block | IfStmt>], so a reader
        // that knows the first three children keeps working unchanged.
        if @peek() == TokenKind.KwElse {
            kids.push(@take())
            if @peek() == TokenKind.KwIf {
                kids.push(@stmt())
            } else if @peek() == TokenKind.LBrace {
                kids.push(@block())
            } else {
                // `else` with neither a block nor a chained `if`: incomplete,
                // and the tree must SAY so or check finds nothing wrong.
                kids.push(@error_node(TokenKind.ErrorTok))
            }
        } else {
            // No else branch: the if is complete on its own.
        }
        return @node(NodeKind.IfStmt, kids)
    }
    if @peek() == TokenKind.KwBreak || @peek() == TokenKind.KwContinue {
        // BARE, as the language has them (274.7 wave B10): no label and no
        // value (labels are an open question, Q-labeled-loops; a `break`
        // value is outside the language). The keyword is the node's one child.
        return @node(NodeKind.LoopCtl, []Node.of(@take()))
    }
    if @peek() == TokenKind.KwReturn {
        mut kids = []Node.of(@take())
        if @peek() != TokenKind.RBrace && @peek_same_line() {
            kids.push(@expr())
        } else {
            // A bare `return` at the end of a block returns unit: the value
            // is absent, and the emitter writes NOVA_UNIT for a RetStmt of
            // one child. An expression node here would invent a value.
            //
            // `@peek_same_line()` (registry TBD): the ORIGINAL guard only
            // asked "is the next token `}`", so a bare `return` at the end
            // of a match arm -- followed by a NEWLINE and the next arm's
            // pattern, not `}` -- glued that pattern on as the return's
            // value (`return\nSome(_) => {}` read as `return Some(_)`, then
            // choked on the `=>` right after). D49's own separator rule
            // ends a statement at a newline unless a specific continuation
            // token follows; `return` with nothing after it on its own
            // line is exactly the bare form, same as before `}`.
        }
        return @node(NodeKind.RetStmt, kids)
    }
    // `consume x = …` is a BINDING too, and its keyword is a contextual word
    // rather than a token kind -- so the head is asked BY MECHANISM, exactly as
    // a parameter's mode is (`@at_mode_word`). It joins the pair here because
    // the mode of a binding is what rule P14 filters a call by: until
    // 2026-08-21 novac did not read the form at all, and the refusal that came
    // out said "unknown name" about the USE -- blaming the reader for a form
    // the parser had silently dropped.
    ro binds_here = @peek() == TokenKind.KwMut || @peek() == TokenKind.KwRo ||
        (@peek() == TokenKind.KwConsume &&
         (@peek(skip: 1) == TokenKind.Ident || @peek(skip: 1) == TokenKind.LParen ||
          @peek(skip: 1) == TokenKind.LBrace || @peek(skip: 1) == TokenKind.LBracket))
    if binds_here {
        // One BindStmt for all three: the first leaf keeps the keyword, C
        // locals are identical either way (the oracle emits no const). The
        // kind is recorded BEFORE the take: the scope-block door below asks
        // it, and a leaf's kind is not re-read in this layer (the parser
        // decides while the cursor is live -- that is what the door is for).
        ro kw_kind = @peek()
        mut kids = []Node.of(@take())
        // DESTRUCTURING (D486): after the keyword comes ONE pattern, read by
        // the same `@pattern()` door the match arm reads -- there is no
        // second, flat grammar for the binding position. The checker refuses
        // the refutable forms by POSITION (D486 §4, E_REFUTABLE_BINDING);
        // what parses here is the whole grammar. The dispatch is LL(1) on
        // `(` / `{` / `[`, plus the head lookahead for an identifier (a
        // qualified head, a payload or record opener, a disjunction) --
        // anything else after an identifier is an ordinary binding.
        ro opens_pattern = @peek() == TokenKind.LParen || @peek() == TokenKind.LBrace ||
            @peek() == TokenKind.LBracket ||
            (@peek() == TokenKind.Ident && @pattern_head_ahead())
        if opens_pattern {
            kids.push(@pattern())
            @push_expected(kids, TokenKind.Assign)
            kids.push(@expr())
            return @node(NodeKind.DestructureBind, kids)
        } else {
            // Not a pattern: an ordinary binding, read below.
        }
        @push_name(kids)
        // A DECLARED type: `ro x int = 1`. It stands between the name and the
        // `=`, and reading it here is what keeps `=` from looking absent.
        if @peek() != TokenKind.Assign {
            kids.append(@type_ref())
        } else {
            // No declared type: the initializer carries it.
        }
        @push_expected(kids, TokenKind.Assign)
        kids.push(@expr())
        // The D188 SCOPE BLOCK: `consume x = EXPR { BODY }` on ONE line --
        // the binding lives exactly for BODY, and its cleanup runs where
        // BODY ends (D188's binding form; the re-consume and multi-var
        // spellings are their own amendments and stay unread here). The tree
        // spells the form as a Block whose FIRST statement is the binding:
        // the scope IS a block for every layer that already exists (typing's
        // scope walk, the consume flow's mark-and-settle at scope end, the
        // lowering's cleanups at the block's site), so no layer learns a new
        // shape. Only `consume` may take the block -- `ro`/`mut` have
        // nothing to discharge at a scope's end. Until 2026-10-31 the brace
        // fell out as the NEXT statement and read as a record constructor
        // (the 118-corpus sweep's ffi_sqlite_consumable, tasks 133/134).
        if kw_kind == TokenKind.KwConsume
            && @peek() == TokenKind.LBrace
            && @peek_same_line() {
            ro body = @block()
            match body {
                Branch { children: bc, .. } => {
                    // The binding becomes the scope's first statement:
                    // [ `{`, BindStmt, ...BODY's statements, `}` ]. The block
                    // node @block minted is re-minted with the prepended
                    // children; its first id is discarded before any later
                    // pass records anything against it -- typing, flow and
                    // lowering all key their records off the FINAL tree.
                    mut sk = []Node.of(bc[0])
                    sk.push(@node(NodeKind.BindStmt, kids))
                    // The canon `bc[1..]` is an open-end slice: it lowers to
                    // Vec[Node].end_index, which the self-compile shell does
                    // not carry (CI novac-gate self-accepted, 2026-10-31).
                    for i in 1..bc.len() {
                        // nova:allow W_MANUAL_SLICE_COPY -- slice not compiled yet, registry 1170
                        sk.push(bc[i])
                    }
                    return @node(NodeKind.Block, sk)
                }
                Leaf(_) => {
                    // Unreachable (@block never returns a leaf); recovery-safe.
                    return body
                }
            }
        }
        return @node(NodeKind.BindStmt, kids)
    }
    if @peek() == TokenKind.KwWhile {
        // WHILE-LET (wave P4, D486): the one question lives in
        // `@whilelet_try` above -- the same door the if-let asks through.
        match @whilelet_try() {
            Some(n) => return n
            None => {}
        }
        mut kids = []Node.of(@take())
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace {
            kids.push(@block())
        } else {
            // `while cond` with no body: same as the if above -- the marker
            // is what turns silent acceptance into one honest refusal.
            kids.push(@error_node(TokenKind.ErrorTok))
        }
        return @node(NodeKind.WhileStmt, kids)
    }
    if @peek() == TokenKind.KwFor {
        mut kids = []Node.of(@take())
        // The header reads its pattern through the ONE door (wave P5, D486
        // s1/s4: the for-header is a binding position, and no binding
        // position has its own grammar) -- `for x`, `for (k, v)`, `for
        // { a, .. }`, `for mut x` are the same tree the match arm reads.
        kids.push(@pattern())
        @push_expected(kids, TokenKind.KwIn)
        kids.push(@head_expr())
        if @peek() == TokenKind.LBrace {
            kids.push(@block())
        } else {
            // `for x in r` with no body: the marker is the only thing that
            // stops a bodyless loop from reaching the emitter unrefused.
            kids.push(@error_node(TokenKind.ErrorTok))
        }
        return @node(NodeKind.ForStmt, kids)
    }
    // WITH (wave 274.11 Э.4): `with Fs = real_fs(), Os = real_os() { ... }`.
    // `with` is a CONTEXTUAL word, not a lexer keyword (D61; the keyword
    // table stays closed), so the door is spelling + shape: an ordinary
    // expression statement can never have Ident Ident `=` at offsets 0..2
    // (`with` alone, `with.x`, `with(...)` all stay expression statements).
    // Before this arm the form fell apart into THREE plausible statements --
    // a `with` name, an assignment, a record constructor -- and check
    // answered with refusals that named none of them.
    ro with_stmt = @peek_ident(WITH_WORD) &&
        @peek(skip: 1) == TokenKind.Ident && @peek(skip: 2) == TokenKind.Assign
    if with_stmt {
        mut kids = []Node.of(@take()) // `with`
        while true {
            @push_expected(kids, TokenKind.Ident) // the effect's name
            kids.push(@take()) // `=`
            // THE HANDLER VALUE GOES THROUGH @head_expr, not @expr --
            // measured 2026-09-22: `with Fs = h, Os = o { body }` let the
            // LAST binding's expression swallow the body as a record
            // constructor (`o { 1 }`), and the with-statement ended up
            // bodyless. Same discipline as the if/while head: a brace after
            // a value at this position is the BODY, never a ctor.
            kids.push(@head_expr())
            if @peek() == TokenKind.Comma {
                kids.push(@take())
            } else {
                break
            }
        }
        if @peek() == TokenKind.LBrace {
            kids.push(@block())
        } else {
            // `with X = h` with no body: the same marker discipline as
            // if/while above -- a bodyless with must not reach the emitter
            // unrefused.
            kids.push(@error_node(TokenKind.ErrorTok))
        }
        return @node(NodeKind.WithStmt, kids)
    }
    // SUPERVISED (wave 274.11 Э.7 item 4): `supervised { body }` -- the
    // D13 supervision statement the carrier writes (main.nv:286). The door
    // is the with-statement's own class: a CONTEXTUAL word plus shape, not
    // a lexer keyword (D13 keeps the keyword table closed). `supervised`
    // alone, `supervised.x`, `supervised(...)` all stay ordinary
    // expressions; only `supervised {` can be this form.
    // THE NAMED HAZARD, probed and void: `Name {` is also the record-ctor
    // expression shape, so this door would shadow a bare statement
    // constructor of a type literally NAMED `supervised` -- but the ORACLE
    // RESERVES the word (probed 2026-09-23: `type supervised { ... }`
    // refuses "expected identifier, got `supervised`"), so no such type
    // exists in the language and the contextual door loses nothing.
    if @peek_ident(SUPERVISED_WORD) && @peek(skip: 1) == TokenKind.LBrace {
        // The door's lookahead guarantees the body brace, so the block is
        // taken directly -- a BARE `supervised` (no brace) never reaches
        // this arm: it is an ordinary name statement, refused by the
        // unknown-name door at typing (check/exprs.nv:526; measured
        // 2026-09-23; the oracle, which RESERVES the word, refuses it at
        // parse -- either way, refused not silent).
        mut kids = []Node.of(@take()) // `supervised`
        kids.push(@block())
        return @node(NodeKind.SupervisedStmt, kids)
    }
    // SPAWN (wave 274.11 Э.7 item 4): `spawn { body }` -- the D13 pair of
    // `supervised`. Same contextual door, same probed-void hazard (the
    // oracle reserves `spawn` too: "expected identifier, got `spawn`"),
    // same bodyless marker. No `timeout:`/`cancel:` arguments this wave:
    // the carrier writes none, and the acceptance is the carrier's shape.
    if @peek_ident(SPAWN_WORD) && @peek(skip: 1) == TokenKind.LBrace {
        // Same guarantee and the same bare-word semantics as `supervised`
        // one arm up: the door sees the brace, so the block is direct.
        mut kids = []Node.of(@take()) // `spawn`
        kids.push(@block())
        return @node(NodeKind.SpawnStmt, kids)
    }
    // DEFER (D90): `defer { body }`. The keyword is lexed; the FORM is read
    // whole so the tree tells the truth about what was written, and check
    // then refuses it by name (`@walk`'s DeferStmt arm in check/check.nv,
    // text DEFER_MSG) -- running the body at scope exit on every way
    // out is the E2 effects/consume horizon's debt, not a record constructor
    // (which is exactly the lie this arm ends: `defer` unlexed read as a
    // name, and the brace behind it became a ctor -- the 118-corpus sweep's
    // consume_tour, tasks 133/134).
    if @peek() == TokenKind.KwDefer {
        mut kids = []Node.of(@take())
        if @peek() == TokenKind.LBrace {
            kids.push(@block())
        } else {
            // `defer` with no body: the marker, same discipline as a
            // bodyless if/while -- the tree says what is missing.
            kids.push(@error_node(TokenKind.ErrorTok))
        }
        return @node(NodeKind.DeferStmt, kids)
    }
    // A BARE BLOCK statement (D49; Plan 148 Ф.2): `{ ... }` opens a nested
    // scope and stays an ordinary side-effecting statement. Until
    // 2026-10-31 it fell through to `@expr`, whose `@atom` reads a leading
    // `{` as an anonymous record constructor, and check refused it for
    // POSITION (registry #1901; the 118-corpus sweep's consume_tour). The
    // brace is NOT unambiguous, though: `@block` reads its TAIL through this
    // same door, and an anonymous constructor is a legal tail (check's
    // RecordCtor arm answers init/arg/arm/tail) -- std's own `Vec.new` ends
    // in `{ data: alloc_buf[T](cap), len: 0, cap }` (the 17-fixture
    // differential regression of 2026-10-31, the first draft of this door
    // read every statement brace as a block). The content gives the form
    // away: constructor entries open with `name:`, the `name` shorthand
    // (`,` or `}` after it) or the `..base` spread -- none of which can
    // open a statement (Nova has no labels, no comma expressions, no
    // statement led by `..`). Constructor-shaped braces fall through to the
    // expression door, which reads them exactly as before 2026-10-31.
    if @peek() == TokenKind.LBrace && !@anon_ctor_ahead() {
        return @block()
    }
    ro e = @expr()
    if is_assign_op(@peek()) {
        mut kids = []Node.of(e, @take())
        kids.push(@expr())
        return @node(NodeKind.AssignStmt, kids)
    }
    e
}
