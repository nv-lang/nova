// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc_parse `pat.rs` -- patterns are their own file there, beside
// the expression parser, because their grammar is their own (D486 s2).
// Role: PATTERNS -- the one pattern door of the grammar (`@pattern`), its
//   alternatives and every bracketed form: variant payloads, tuple and array
//   sequences, record patterns.
// Used by: expr.nv (the match arm), parse.nv (the destructuring binding, the
//   if/while condition and the for header).
// Guarded by: check-novac-file-size.py (this split: expr.nv crossed 1000
//   lines when the pattern position learnt the interpolated string, registry
//   1556), check-novac-deps.py, check-novac-grammar-fixture-coverage.sh.
//
// Split out of expr.nv on 2026-10-01 by meaning: everything below reads a
// pattern and nothing else; the interpolated string it may meet is read by
// expr.nv's own door, `@interp_str`.

module novac.parse

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}

/// ONE PATTERN DOOR for the whole grammar (D486 §2): every destructuring
/// site reads a pattern here -- the match arm today; the destructuring
/// binding, the if/while condition and the for header as the pattern arc
/// reaches them (plan 274.5 §5y). A disjunction is the top level:
/// `primary (| primary)*`, one Pattern whose children are the alternatives.
///
/// The tree stays lossless: every token is a leaf, subpatterns are Pattern
/// branches, every binding name is a Name node (the invariant
/// sem/pattern.nv enforces). What a bare name MEANS -- binder or
/// payload-less variant -- is the checker's question (the names table
/// answers it), never the parser's.
fn Cursor mut @pattern() -> Node {
    mut kids = []Node.of(@pattern_primary())
    while @peek() == TokenKind.Pipe {
        kids.push(@take())
        kids.push(@pattern_primary())
    }
    if kids.len() == 1 { return kids[0] }
    @node(NodeKind.Pattern, kids)
}

/// One pattern alternative. The FIRST TOKEN decides the form -- the grammar
/// is LL(1) here, so recognition is a lookup, not a search: a literal, `[]`,
/// `(`, `[`, `{`, a mode word, or an identifier head.
fn Cursor mut @pattern_primary() -> Node {
    ro t = @peek()
    // A LITERAL PATTERN -- integer, string or char (D19's single
    // `literal` alternative), and the empty array pattern `[]`, which is
    // one token now and the Array shape's zero-element case.
    if t == TokenKind.IntLit || t == TokenKind.StrLit || t == TokenKind.CharLit ||
       t == TokenKind.EmptyBrackets {
        return @node(NodeKind.Pattern, []Node.of(@take()))
    }
    // An INTERPOLATED string in a pattern is READ, so the checker can refuse it
    // by name (registry 1556: a pattern's literal is not interpolated, D486 s2)
    // -- before this branch it fell to recovery, "novac did not parse this".
    if t == TokenKind.StrFrag {
        return @node(NodeKind.Pattern, []Node.of(@interp_str()))
    }
    // A tuple or array pattern: subpatterns and the `..` rest marker.
    if t == TokenKind.LParen { return @seq_pattern(TokenKind.RParen) }
    if t == TokenKind.LBracket { return @seq_pattern(TokenKind.RBracket) }
    // A mode word binds exactly one name: `ro x`, `mut x`, `consume x`
    // (D34; `ro` read since wave P3 for the if/while condition -- D486 §4).
    if t == TokenKind.KwMut || t == TokenKind.KwConsume || t == TokenKind.KwRo {
        mut mk = []Node.of(@take())
        @push_binder(mk)
        return @node(NodeKind.Pattern, mk)
    }
    // A head-less record pattern: `{ name, age }` against the scrutinee
    // itself (D34's condition form; the oracle reads it in match arms too).
    if t == TokenKind.LBrace { return @record_pattern([]Node.new()) }
    if t == TokenKind.Ident {
        // A HEAD is an ident that a `.`, `(` or `{` follows: `Some(..)`,
        // `Circle { .. }`, `mod.Type.Variant(..)` -- qualified to any
        // depth (D486 §2). Anything else is a lone name: the wildcard, or
        // a Name-wrapped binder-or-unit-variant (the checker decides which).
        ro is_head = (@peek(skip:1) == TokenKind.Dot && @peek(skip:2) == TokenKind.Ident) ||
                     @peek(skip:1) == TokenKind.LParen ||
                     @peek(skip:1) == TokenKind.LBrace
        if !is_head {
            if @peek_text() == "_" {
                return @node(NodeKind.Pattern, []Node.of(@take()))
            }
            return @node(NodeKind.Pattern, []Node.of(@node(NodeKind.Name, []Node.of(@take()))))
        }
        mut hk = []Node.of(@take())
        while @peek() == TokenKind.Dot && @peek(skip:1) == TokenKind.Ident {
            hk.push(@take())
            hk.push(@take())
        }
        if @peek() == TokenKind.LBrace { return @record_pattern(hk) }
        if @peek() == TokenKind.LParen { return @variant_pattern(hk) }
        // A qualified payload-less variant: the head leaves are the pattern.
        return @node(NodeKind.Pattern, hk)
    }
    // Recovery: one Err, one token, the arm loop keeps advancing. A closing
    // token is NOT consumed: it belongs to the enclosing form (274.3/F15),
    // so a terminator gets the zero-width marker instead.
    if is_terminator(@peek()) {
        return @error_node(TokenKind.ErrorTok)
    }
    @node(NodeKind.Err, []Node.of(@take()))
}

/// A variant's payload: `( subpattern, ... )` after the head leaves.
/// `Cons(..)` -- a payload that is only the rest marker -- is D59's
/// positional partial form and reads here too.
fn Cursor mut @variant_pattern(mut kids []Node) -> Node {
    kids.push(@take()) // the `(`
    // PROGRESS: a closer that is NOT this form's own (`}` of the match, `]` in a
    // `(`) makes @pattern() answer a zero-width marker and take nothing, so the loop
    // must stop on ANY terminator -- it spun and allocated forever on `R(w,` +
    // newline + `}` (registry 1856). The enclosing form re-reads the closer.
    while !@at_eof() && @peek() != TokenKind.RParen && !is_terminator(@peek()) {
        if @peek() == TokenKind.DotDot {
            kids.push(@take())
        } else {
            kids.push(@pattern())
        }
        @push_if(kids, TokenKind.Comma)
    }
    @push_expected(kids, TokenKind.RParen)
    @node(NodeKind.Pattern, kids)
}

/// A tuple or array pattern body: `open subpattern, .. close` -- the two
/// share every rule but the bracket (D59: positions, one `..`, `[..rest]`
/// binding spelled as the DotDot leaf followed by its binder subpattern).
fn Cursor mut @seq_pattern(close TokenKind) -> Node {
    mut kids = []Node.of(@take()) // the opener
    // PROGRESS: a closer that is NOT this form's own (`}` of the match, `]` in a
    // `(`) makes @pattern() answer a zero-width marker and take nothing, so the loop
    // must stop on ANY terminator -- it spun and allocated forever on `R(w,` +
    // newline + `}` (registry 1856). The enclosing form re-reads the closer.
    while !@at_eof() && @peek() != close && !is_terminator(@peek()) {
        if @peek() == TokenKind.DotDot {
            kids.push(@take())
        } else {
            kids.push(@pattern())
        }
        @push_if(kids, TokenKind.Comma)
    }
    @push_expected(kids, close)
    @node(NodeKind.Pattern, kids)
}

/// A record pattern body: `{ x, f: sub, mut y, .. }` after any head leaves.
/// A field is a PatField node: a Name (shorthand binder), a mode word with
/// its Name, or `ident : subpattern` for a renamed or nested field.
fn Cursor mut @record_pattern(mut kids []Node) -> Node {
    kids.push(@take()) // the `{`
    while !@at_eof() && @peek() != TokenKind.RBrace {
        if @peek() == TokenKind.DotDot {
            kids.push(@take())
        } else if @peek() == TokenKind.Ident {
            mut fk = []Node.new()
            if @peek(skip:1) == TokenKind.Colon {
                fk.push(@take()) // the field's name
                fk.push(@take()) // the `:`
                fk.push(@pattern())
            } else {
                fk.push(@node(NodeKind.Name, []Node.of(@take())))
            }
            kids.push(@node(NodeKind.PatField, fk))
        } else if @peek() == TokenKind.KwMut || @peek() == TokenKind.KwConsume {
            mut fk = []Node.of(@take())
            @push_binder(fk)
            kids.push(@node(NodeKind.PatField, fk))
        } else {
            // RECOVERY-BOUNDED: the loop stops at `}`, the pattern's own
            // closer, so it is never taken here; other closers can be eaten
            // and are re-read by the enclosing form, the known width of
            // every bound of this shape.
            kids.push(@node(NodeKind.Err, []Node.of(@take())))
        }
        @push_if(kids, TokenKind.Comma)
    }
    @push_expected(kids, TokenKind.RBrace)
    @node(NodeKind.Pattern, kids)
}
