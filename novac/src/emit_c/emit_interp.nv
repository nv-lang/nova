// An interpolated string as its builder chain (waves I1/I2).
//
// Donor: none -- fragments alternate with slot expressions, and the chain
// simply follows the children; nothing here needed a pattern beyond the walk.
// Role: the hoist's InterpStr arm builds here; the expression site prints
// the temporary this door answers.
// Used by: emit_c.nv's hoist walker, and nothing else.
// Guarded by: check-novac-differential.sh (corpus carriers interp_name and
// the I2 ones), the subset_test.nv holder (asserts the chain's C shapes),
// and check-novac-emitted-names.py holds the name spaces.
//
// INTEROP, named as such: Nova_StringBuilder_static_new / _method_append /
// _consume_into_str and the display entries
// (nova_fn_7runtime14string_builder16str_display_spec and the int one) are
// the shell's own runtime, spelled exactly as the oracle's cache spells
// them -- measured 2026-09-02, not guessed. The capacity formula is the
// oracle's too: the literal bytes plus sixteen. Goes the day novac emits
// the whole prelude.

module novac.emit_c

import ../sem.{Ctx, CheckOut, branch_children, leaf_text, leaf_kind, escaped_byte_len}
import ../sem.{unescape_dollar, is_expr_kind, prim_row_of}
import ../builtins.{BuiltinType, FMT_BARE_C}
import ../sem.{c_callable, decl_of_ty, field_range_of, raw_frow, is_value_record}
import ../sem.{c_method_symbol}
import ../builtins.{DISPLAY_METHOD}
import ../types.{TyId}
import ../tree.{Node, NodeKind, raw_node}
import ../lex.{TokenKind}
import ../diag.{ice}

/// Build the chain into a fresh temporary; answer the C name that holds the
/// finished string. Fragments carry their quotes on the outer edges only --
/// the slices below strip exactly those.
fn Emitter mut @emit_interp_build(e Node) -> str {
    ro kids = branch_children(e)
    mut cap = 16
    for fi in 0..kids.len() {
        ro c = kids[fi]
        if c.kind_of() != NodeKind.LeafNode { continue }
        if leaf_kind(c) != TokenKind.StrFrag { continue }
        cap += escaped_byte_len(frag_body(leaf_text(c), fi == 0, fi == kids.len() - 1))
    }
    ro sb = "_novac_isb_t${@fresh_uniq()}"
    @body.append("    Nova_StringBuilder* ${sb} = Nova_StringBuilder_static_new(${cap});\n")
    for fi in 0..kids.len() {
        ro c = kids[fi]
        ro ck = c.kind_of()
        if ck == NodeKind.LeafNode {
            if leaf_kind(c) != TokenKind.StrFrag {
                // The `\${` and `}` markers: punctuation of the form.
                continue
            }
            ro piece = frag_body(leaf_text(c), fi == 0, fi == kids.len() - 1)
            if piece != "" {
                @body.append("    Nova_StringBuilder_method_append(${sb}, (nova_str){.ptr=(const uint8_t*)\"")
                @body.append(unescape_dollar(piece))
                @body.append("\", .len=${escaped_byte_len(piece)}});\n")
            } else {
                // An empty fragment appends nothing.
            }
        } else if is_expr_kind(ck) {
            // ONE DOOR PER SLOT, keyed by the universe row of the slot's carrier
            // (wave B1a, 274.7): the runtime's `*_display_spec` family has an
            // entry per primitive family, and the checker admitted only what
            // that family covers. Until 2026-09-05 everything that was not `str`
            // was cast to `nova_int` and sent to the int entry -- `${1.5}` came
            // out as `1`.
            ro slot_t = @out.type_of(c.id_of())
            match prim_row_of(@ctx.tys, slot_t) {
                Some(row) => {
                    ro call = display_call_of(row)
                    @body.append("    ${call.head}(${sb}, ${call.cast}(")
                    @emit_expr(c)
                    @body.append("), ${call.tail});\n")
                }
                None => {
                    // A DECLARED type with its own `@display` (274.7 B1b-1): the
                    // checker recorded the call the slot MAKES in the channel's
                    // implicit table (the slot's value may itself be a call, so
                    // `callee_of` is the wrong door). The context is a bare one
                    // over OUR builder, handed in as the `Write` sink -- the
                    // runtime's `static_bare`. INTEROP, like the rest of this
                    // file, gone when novac emits the prelude itself.
                    ro iref = @out.implicit_of(c.id_of())
                    match iref.synth_display_type() {
                        Some(st) => {
                            @emit_synth_display(c, st, sb)
                            continue
                        }
                        None => {
                            // A written method: the row below is the decision.
                        }
                    }
                    ro row = iref.callable_row()
                    // THE SUBSTITUTION COMES FROM THE CHANNEL, not from an
                    // empty vector: for a generic instance the symbol is
                    // spelled from its type arguments, and an empty one names
                    // a function the shell does not carry (274.7 B1b-3).
                    ro targs = @out.subst_of_ref(iref)
                    ro fc = "_novac_fmt_t${@fresh_uniq()}"
                    @body.append("    Nova_FmtCtx* ${fc} = ${FMT_BARE_C}(${sb}, ((nova_int)0LL), false);\n")
                    // OURS OR THE SHELL'S -- the SAME fork a written method call
                    // makes (`emit_expr.nv:542`), asked through the same door
                    // rather than restated: a row with a body of ours is named by
                    // our scheme, a row without one is an instance method the
                    // SHELL emits and is named by the receiver's instance
                    // (`Vec____nova_int_method_display`). Writing `c_callable`
                    // unconditionally was the first version, and the LINKER said
                    // so: `undefined symbol: novac_fn_vecd_display__Vec_of_nova_int...`
                    // -- a name for a function nobody defines, because the
                    // program never wrote it.
                    if @ctx.fns.compiles_body(row) {
                        @body.append("    ${c_callable(@ctx, row, targs)}(")
                    } else {
                        @body.append("    ${c_method_symbol(@ctx, slot_t, DISPLAY_METHOD)}(")
                    }
                    @emit_expr(c)
                    @body.append(", ${fc});\n")
                }
            }
        } else {
            // Recovery leaves inside an Err branch: already refused.
        }
    }
    ro tmp = "_novac_istr_t${@fresh_uniq()}"
    @body.append("    nova_str ${tmp} = Nova_StringBuilder_consume_into_str(${sb});\n")
    tmp
}

/// THE SYNTHESIZED memberwise `@display` of a gated record, printed INTO the
/// slot's builder: `Name(` field `, ` field `)` (D422 section 4, D109 amended
/// 2026-09-18 -- the compact form WITHOUT field names; the named form belongs
/// to `@debug`).
///
/// WHERE THE BYTES COME FROM, and why that is not a P25 violation. The
/// separator is `", "` -- a comma AND a space -- and the norm does not say so:
/// it gives ONE sample, `Point(1, 2)`. The oracle writes exactly that, as its
/// own literal, and the oracle is the fixed point of BEHAVIOUR (same stdout,
/// same exit code). Reading it for the BYTES is what it is for; reading it for
/// the SHAPE of this code would be the forbidden thing, and is not done here --
/// the oracle emits a named function per type, this emits into the slot.
///
/// WHY INLINE AND NOT A FUNCTION. The acceptance recorded the opposite
/// decision and its reason was measured WRONG once this file was read: the
/// reason given was "the slot emitter already performs that shape, so no new
/// branch is needed", but the implicit target became a SUM the moment the
/// synthesis existed, so the branch above is needed either way. With the
/// branch unavoidable, a function would additionally need an emission site and
/// a per-type "already emitted" set, and inline needs neither. The
/// SIMPLIFICATION this leaves is named: no method exists that another consumer
/// could call, and the condition that removes it is a second consumer -- a
/// written `p.display(f)`, or a generic bound (274.7 B1b-3).
fn Emitter mut @emit_synth_display(c Node, st TyId, sb str) -> () {
    ro td = decl_of_ty(@ctx, st)
    // A RECORD IS A POINTER IN C unless it is a value record -- the same rule
    // the field-access emitter reads (`emit_expr.nv:502`), asked through the
    // same door rather than restated. The first version wrote `.`
    // unconditionally and clang refused it: "member reference type
    // 'Nova_Point *' is a pointer". The C compiler caught what a guess would
    // otherwise have shipped into the corpus run.
    ro arrow = if is_value_record(@ctx, st) { "." } else { "->" }
    @body.append("    Nova_StringBuilder_method_append(${sb}, (nova_str){.ptr=(const uint8_t*)\"")
    @body.append(td.name)
    @body.append("(\", .len=${escaped_byte_len(td.name) + 1}});\n")
    match field_range_of(td) {
        None => ice("emit: a synthesized display for a type with no field rows -- the judge admits a record with at least one field")
        Some((first, cnt)) => {
            mut i = 0
            while i < cnt {
                if i > 0 {
                    @body.append("    Nova_StringBuilder_method_append(${sb}, (nova_str){.ptr=(const uint8_t*)\", \", .len=2});\n")
                } else {
                    // The first field is not preceded by a separator.
                }
                ro fd = @ctx.fields.rows[raw_frow(first) + i]
                match prim_row_of(@ctx.tys, fd.type_id) {
                    None => ice("emit: a synthesized display over a non-primitive field -- the judge admits primitives only")
                    Some(row) => {
                        ro call = display_call_of(row)
                        @body.append("    ${call.head}(${sb}, ${call.cast}(")
                        @emit_expr(c)
                        @body.append("${arrow}${fd.name}), ${call.tail});\n")
                    }
                }
                i += 1
            }
        }
    }
    @body.append("    Nova_StringBuilder_method_append(${sb}, (nova_str){.ptr=(const uint8_t*)\")\", .len=1});\n")
}

/// The three pieces of one runtime display call: the mangled entry, the C cast
/// the value needs, and the trailing default arguments -- spelled per family.
type DisplayCall value {
    head str /// the runtime entry, in the shell's own spelling (interop)
    cast str /// C cast applied to the value, `""` when the C type already matches
    tail str /// the default formatting arguments after the value
}

/// WHICH runtime display entry a universe row takes, and how its value is
/// handed over -- the one door of wave B1a (274.7). Every arm names a symbol
/// the shell carries today (measured on shell.tpl.c 2026-09-05: the six entries
/// int/f64/f32/bool/char/str all exist); the defaults are the oracle's default
/// format (width 0, no precision, left align, space fill), which is interop
/// with the runtime's signature, not a design copied. Unit has no display and
/// the checker never admits it; an unsigned 64-bit row is refused there too,
/// so reaching it here is a broken invariant.
fn display_call_of(row BuiltinType) -> DisplayCall {
    ro sb_ns = "nova_fn_7runtime14string_builder"
    match row.family {
        PfStr => DisplayCall { head: "${sb_ns}16str_display_spec", cast: "",
                               tail: "((nova_int)0LL), false, ((nova_int)0LL), nova_make_Align_Left(), (nova_char)(32U)" }
        PfBool => DisplayCall { head: "${sb_ns}17bool_display_spec", cast: "",
                                tail: "((nova_int)0LL), nova_make_Align_Left(), (nova_char)(32U)" }
        PfChar => DisplayCall { head: "${sb_ns}17char_display_spec", cast: "",
                                tail: "((nova_int)0LL), nova_make_Align_Left(), (nova_char)(32U)" }
        PfFloat => {
            if row.bits == 32 {
                return DisplayCall { head: "${sb_ns}16f32_display_spec", cast: "",
                                     tail: "((nova_int)0LL), nova_make_Align_Left(), (nova_char)(32U)" }
            }
            DisplayCall { head: "${sb_ns}16f64_display_spec", cast: "(double)",
                          tail: "((nova_int)0LL), false, ((nova_int)0LL), false, false, nova_make_Align_Left(), (nova_char)(32U)" }
        }
        PfInt => {
            // Every signed width and the narrow unsigned ones widen into
            // `nova_int` without loss; the unsigned 64-bit rows never get here
            // (refused by name in the checker: the runtime has no entry).
            if !row.signed && row.bits == 64 {
                ice("emit_c: an unsigned 64-bit interpolation slot passed the checker -- the runtime has no display for it")
            }
            DisplayCall { head: "${sb_ns}16int_display_spec", cast: "(nova_int)",
                          tail: "((nova_int)0LL), ((nova_int)10LL), false, false, false, false, nova_make_Align_Left(), (nova_char)(32U)" }
        }
        PfUnit => ice("emit_c: a unit interpolation slot passed the checker")
    }
}

/// A fragment's BODY: the first fragment sheds its opening quote, the last
/// its closing one -- the token texts carry them for losslessness. Position
/// is passed IN: the first probe compared node ids, and the id equality
/// answered true for every pair, shaving both edges off every fragment.
fn frag_body(t str, first bool, last bool) -> str {
    ro lo = if first { 1 } else { 0 }
    ro hi = if last { t.byte_len() - 1 } else { t.byte_len() }
    t[lo..hi]
}
