// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: none -- the C of a numeric cast is the RUNTIME's: a C cast for every
// integer and float pair, and the saturating helper `nova_<f32|f64>_to_<int
// row>` of `nova_rt/cast.h` for a float into an integer, because a C cast
// there is undefined out of range and D54 defines it (saturation, NaN -> 0).
// This file repeats the runtime's spelling as interop.
// Role: emission of `expr as T` (D54): a newtype's unwrap (the operand, free),
//   a pointer cast, and the cast between two primitives the checker admitted
//   (check/cast_pairs.nv); the narrowing back to its row of a binary bit
//   operator's value (registry 1602); and a constant expression printed as its
//   exact value in the row its position gave it (registry 1679, D489).
// Used by: emit_expr.nv (`@emit_expr`'s Cast arm, its bit-operator arm, and
//   its entry for a constant expression).
// Guarded by: the fixtures novac/fixtures/cast_numeric and narrow_shift
//   (byte-for-byte against the oracle through check-novac-differential.sh) and
//   nova test novac/src/pipeline/cast_test.nv.

module novac.emit_c

import ../tree.{Node}
import ../sem.{branch_children, c_type, prim_row_of, is_int_prim, carrier_of}
import ../sem.{const_int_value}
import ../builtins.{BuiltinType, PrimFamily}
import ../types.{is_ty}
import ../diag.{ice_at}

/// A cast. What arrives is what the checker admitted, and the checker recorded
/// the operand's type beside the target's for every primitive pair.
///
/// - A POINTER target is a C cast (`0 as *mut T`, 274.11 E.10 step 4c-2).
/// - Two primitives of different types: a float into an integer goes through
///   the runtime's saturating helper (D54: out of range saturates, NaN is 0);
///   every other pair is a C cast, which IS D54's semantics for them -- the
///   low bits of an integer (wraparound, bit pattern, sign reinterpretation:
///   one operation, the 2026-09-04 amendment), IEEE rounding between floats,
///   the nearest float for an integer, a char's codepoint.
/// - Anything else -- a newtype unwrapped, a primitive into itself -- is FREE:
///   the value is already the representation, and C needs no cast between a
///   typedef and its underlying type.
fn Emitter mut @emit_cast(e Node) -> () {
    ro kids = branch_children(e)
    if @is_ptr_receiver(e) {
        @body.append("((${c_type(@ctx, @out.type_of(e.id_of()))})(")
        @emit_expr(kids[0])
        @body.append("))")
        return
    } else {
        // Not a pointer: the pair decides below.
    }
    ro from = @out.type_if_known(kids[0].id_of())
    ro to = @out.type_of(e.id_of())
    if !is_ty(from) || from == to {
        @emit_expr(kids[0])
        return
    } else {
        // A recorded operand of another type: a primitive pair, or a newtype.
    }
    match prim_row_of(@ctx.tys, from) {
        Some(fr) => {
            ro tr = prim_row_of(@ctx.tys, to) ?? ice_at(
                "novac/src/emit_c/emit_cast.nv:60",
                "emit: a primitive cast whose target has no row")
            @emit_prim_cast(kids[0], fr, tr)
        }
        None => @emit_expr(kids[0])
    }
}

/// The cast between two different primitives: the saturating helper for a
/// float into an integer, a C cast for the rest.
fn Emitter mut @emit_prim_cast(operand Node, fr BuiltinType, tr BuiltinType) -> () {
    if is_float_row_family(fr.family) && is_int_row_family(tr.family) {
        @body.append("nova_${fr.name}_to_${saturating_suffix(tr)}(")
        @emit_expr(operand)
        @body.append(")")
        return
    } else {
        // Not float-to-integer: plain C, below.
    }
    @body.append("((${tr.c_name})(")
    @emit_expr(operand)
    @body.append("))")
}

/// The helper's name for an integer row: the runtime names its helpers by
/// SIGN AND WIDTH (`i8`..`u64`), so the suffix is built from the row's own two
/// facts and not from its name. `int` and `uint` are address-sized, 64 bits on
/// every target novac emits for (D129/D130), and take `i64`/`u64` -- the
/// oracle's emission of the same casts, measured 2026-10-01, spells them so.
fn saturating_suffix(tr BuiltinType) -> str {
    ro sign = if tr.signed { "i" } else { "u" }
    "${sign}${tr.bits}"
}

/// A float row (`f32`, `f64`).
fn is_float_row_family(f PrimFamily) -> bool {
    match f {
        PfFloat => true
        PfInt | PfStr | PfBool | PfChar | PfUnit | PfAny | PfNever => false
    }
}

/// An integer row of any width.
fn is_int_row_family(f PrimFamily) -> bool {
    match f {
        PfInt => true
        PfFloat | PfStr | PfBool | PfChar | PfUnit | PfAny | PfNever => false
    }
}

/// A binary BIT operator (`&`, `|`, `^`, `<<`, `>>`) on an integer row, cast back
/// to the row's C type -- the door `~` has had since 274.7 B7 (#934), and the
/// same narrowing an `as` does (D54: the low bits). C promotes a `u8`/`i8`/
/// `u16`/`i16` operand to `int`, so `a << 4` with `a u8 = 200` was 3200 wherever
/// the value was not stored first -- a cast, a comparison, a `println` argument,
/// a constant's inlined initializer (registry 1600, 1602, 1603). The cast gives
/// the value D54 and the oracle give (128); on a row as wide as C's promotion it
/// changes nothing. Here and not in emit_expr.nv: it is a narrowing, and that
/// file stands at the thousand-line limit.
fn Emitter mut @emit_bit_infix(e Node, kids []Node, form str) -> () {
    ro bit_cast = is_int_prim(@ctx.tys, carrier_of(@ctx, @out.type_of(e.id_of())))
    if bit_cast {
        @body.append("((${@arith_row(@out.type_of(e.id_of())).c_name})")
    } else {
        // A bool's `&`/`|`/`^`: C's int is its value already.
    }
    @body.append("((")
    @emit_expr(kids[0])
    @body.append(") ")
    @body.append(form)
    @body.append(" (")
    @emit_expr(kids[2])
    @body.append("))")
    if bit_cast {
        @body.append(")")
    } else {
        // Nothing was opened above.
    }
}

/// A CONSTANT EXPRESSION its position adapted (`k(40 + 2)` at `b u8`, D489) is
/// printed as its EXACT VALUE in the position's row -- `((nova_byte)42ULL)` --
/// the literal's own spelling: the checker proved the value fits, and run-time
/// arithmetic in the narrow row could trap on an intermediate (`200 + 100 -
/// 50`) the exact value never meets. One left at its default `int` is printed
/// as the arithmetic it is, as before. Answers whether it printed.
fn Emitter mut @emit_folded_constant(e Node) -> bool {
    ro decided = @out.type_if_known(e.id_of())
    if !is_ty(decided) || decided == @ctx.prims.int_id { return false }
    ro v = const_int_value(e) ?? ice_at(
        "novac/src/emit_c/emit_cast.nv:150",
        "emit_c: a constant the checker adapted does not fold")
    ro row = @arith_row(decided)
    @body.append("((${row.c_name})")
    @body.append("${v}")
    @body.append(if row.signed { "LL)" } else { "ULL)" })
    true
}
