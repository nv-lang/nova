// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc_codegen_ssa `mir/rvalue.rs` -- operand and operator lowering
// sits apart from statement and item lowering there too; the operator
// tables and the expression walk are one subject.
//
// Role: emission of EXPRESSIONS -- the C forms of every operator, the
//   expression walk itself, and the call-as-statement door.
// Used by: emit_c.nv (statements and bindings ask for an expression).
// Guarded by: check-novac-file-size.py (this split), check-novac-deps.py,
//   check-novac-emission-size.sh, check-novac-doc-language.py.
//
// Split out of emit_c.nv on 2026-08-18: writing the `else` branch pushed
// that file past a thousand lines.

module novac.emit_c

import ../sem.{c_free_symbol}
import ../sem.{effect_op_dispatcher_c}
// The absent local (F65): a node that was not hoisted.
import ../lower.{no_local}

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind, BinOp, UnOp, bin_op_of, un_op_of, raw_node, is_node, no_node}
import ../diag.{ice_at}
import ../sem.{raw_crow, carrier_of, c_callable, c_method_symbol, c_overload_symbol, Ctx}
import ../sem.{CheckOut, vec_op_c, c_static_symbol}
import ../sem.{branch_children, leaf_text, leaf_kind, is_expr_kind, expr_leaf_name, call_callee_text, c_type, c_struct}
import ../sem.{shape_of}
import ../sem.{c_ident}
import ../sem.{int_literal_c_text, literal_digits, char_literal_code, interp_slices}
import ../tree.{raw_node}
import ../sem.{c_tag, c_maker, VariantRow, raw_vrow, no_vrow, call_arg_at, raw_row, slot_default_of, no_row}
import ../sem.{is_value_record, slice_shape_of, is_value_sum, is_payload_free_sum, row_recv_by_pointer}
import ../sem.{row_returns_recv_pointer}
import ../builtins.{EQUAL_METHOD, bool_c_literal, RECV_C_NAME, VEC_INDEX_METHOD, PANIC_FN}
import ../builtins.{is_bool_literal, is_true_literal, is_print_fn}
import ../types.{TyId, is_ty}
import ../sem.{prim_row_of, is_int_prim}
import ../sem.{is_const_int_expr}
import ../builtins.{BuiltinType}


/// The C form of a binary operator ON PRIMITIVE OPERANDS, chosen by the
/// DECISION and the operand type -- one exhaustive match instead of the three
/// token-keyed tables this replaced (`checked_op`, `cmp_op`, `raw_op`), each
/// of which returned an empty string on anything it did not know and let the
/// next one guess.
///
/// PRIMITIVE is the load-bearing word (owner's correction 2026-08-16). In
/// Nova every operator is overloadable on user types through protocols
/// (D46/D363: `@plus`, `@compare`, `@equal`), so the emitted form is a
/// function of the operator AND the operand type. The subset emits only the
/// primitive half; `check` refuses the rest at the operator's position rather
/// than letting this table answer for a type it knows nothing about.
///
/// The ROW comes from the checker's channel (the operands' type, through its
/// carrier): float arithmetic is raw C (floats have no overflow trap), integer
/// arithmetic goes through the runtime's checked helper OF THAT WIDTH, and
/// comparisons are C operators either way.
///
/// THE HELPER NAME IS A RUNTIME ABI FACT, not a spelling copied from the
/// oracle (P25): `nova_rt/effects.h` defines `nova_<T>_checked_add/sub/mul`
/// for every member of `Ints` by macro (`NOVA_DEFINE_CHECKED_OPS`, plan 206
/// F.1b / D423, the Swift trap-default model), and `_checked_div/_rem` for
/// signed and unsigned alike. `<T>` there IS the Nova spelling of the type, so
/// the name is a function of the universe row -- the same shape `prim_c_name`
/// has. Until 2026-09-04 the helper was spelled for `int` alone, which is one
/// of the twelve places ten widths fell out of (#910).
fn c_binary_form(op BinOp, row BuiltinType) -> str {
    ro is_float = is_float_row(row)
    match op {
        Add => {
            if is_float { return "+" }
            "nova_${row.name}_checked_add"
        }
        Sub => {
            if is_float { return "-" }
            "nova_${row.name}_checked_sub"
        }
        Mul => {
            if is_float { return "*" }
            "nova_${row.name}_checked_mul"
        }
        Div => {
            if is_float { return "/" }
            "nova_${row.name}_checked_div"
        }
        Modulo => {
            // The float remainder is `fmod`, not a C operator -- and it IS
            // part of the language (D46 F, registry No. 707: the precedence
            // table never restricted `%` by type, and forbidding it would
            // narrow the language to work around a codegen defect). Sign
            // follows the DIVIDEND as in C and Rust; there is no
            // divide-by-zero panic here, IEEE-754 gives NaN.
            if is_float { return "fmod" }
            "nova_${row.name}_checked_rem"
        }
        Less => "<"
        LessEq => "<="
        Greater => ">"
        GreaterEq => ">="
        Equal => "=="
        NotEqual => "!="
        AndAlso => "&&"
        OrElse => "||"
        BitAnd => "&"
        BitOr => "|"
        BitXor => "^"
        ShiftLeft => "<<"
        ShiftRight => ">>"
        Range => ice_at(
            "novac/src/emit_c/emit_expr.nv:111",
            "emit_c: a range reached expression emission -- for-heads consume it")
    }
}

/// Does arithmetic on this universe row run in FLOATING point -- raw C
/// operators -- rather than through the runtime's checked integer helpers?
fn is_float_row(r BuiltinType) -> bool {
    match r.family {
        PfFloat => true
        PfInt | PfStr | PfBool | PfChar | PfUnit | PfAny | PfNever => false
    }
}

/// The universe row an EXPRESSION's arithmetic runs in: its type's CARRIER (a
/// newtype computes as what it holds -- hunt emit_c x K1, H5) looked up in the
/// table. A carrier that is not a primitive never reaches emission: the
/// checker refuses arithmetic on records and sums at the operator, so here it
/// is a broken invariant, not a shape to guess about.
fn Emitter @arith_row(t TyId) -> BuiltinType =>
    prim_row_of(@ctx.tys, carrier_of(@ctx, t)) ?? ice_at(
        "novac/src/emit_c/emit_expr.nv:132",
        "emit_c: arith_row on a carrier that is no primitive")

/// The runtime PRINTER of a carrier type -- the oracle prints each argument of
/// `println` with its own printer, one per family and width (measured off its
/// emission 2026-09-04): `nova_print_int` for every signed integer and for the
/// unsigned ones up to 32 bits, `nova_print_uint` for `u64` and `uint`,
/// `nova_print_f32`/`nova_print_f64` by width, `nova_print_str`,
/// `nova_print_bool`. Found by the generics scouting 2026-08-16: this used to
/// be a bare `else` printing anything unknown AS AN INT -- a record would have
/// had its GC pointer printed as a number, in silence. The set of types is
/// open, so the honest form names every case it handles and ices on the rest;
/// the checker's printer set (`@is_printable_carrier`) refuses first.
fn Emitter @printer_of(t TyId) -> str {
    if t == @ctx.prims.str_id { return "nova_print_str" }
    if t == @ctx.prims.bool_id { return "nova_print_bool" }
    ro row = prim_row_of(@ctx.tys, t) ?? ice_at(
        "novac/src/emit_c/emit_expr.nv:149",
        "emit_c: printer_of on a carrier that is no primitive row")
    match row.family {
        PfFloat => {
            if row.bits == 32 { return "nova_print_f32" }
            return "nova_print_f64"
        }
        PfInt => {
            if !row.signed && row.bits == 64 { return "nova_print_uint" }
            return "nova_print_int"
        }
        PfChar => { return "nova_print_char" }
        PfStr | PfBool | PfUnit | PfAny | PfNever => {}
    }
    ice_at(
        "novac/src/emit_c/emit_expr.nv:164",
        "emit_c: printer_of reached a primitive family without a printer (unit; str, bool and char are answered above)")
}

/// Does this operator emit as a C INFIX operator inside a truth-value cast?
/// Comparisons, equality and the logical pair all yield bool and share the
/// same C shape; the bitwise family is infix too but keeps int width, so it
/// is a third answer rather than a second.
fn is_truth_infix(op BinOp) -> bool {
    match op {
        Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse => true
        Add | Sub | Mul | Div | Modulo | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// Is this form WRITTEN as a call `f(a, b)` rather than infix `a f b`?
///
/// One rule, two callers -- the binary expression and the compound
/// assignment. They had drifted: the compound path passed `is_float: false`
/// unconditionally, so `f += 0.25` on doubles emitted `nova_int_checked_add`,
/// the C still compiled, and the ANSWER came out wrong (found 2026-08-17,
/// prompted by the integrator's warning that a compound assignment has its
/// own emission path -- they had been caught by the same shape the same day).
fn is_call_form(op BinOp, is_float bool) -> bool {
    match op {
        // Integer arithmetic goes through the runtime's checked helpers;
        // float arithmetic is raw C -- except the remainder, which is fmod.
        Add | Sub | Mul | Div => !is_float
        Modulo => true
        Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse => false
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => false
        Range => ice_at(
            "novac/src/emit_c/emit_expr.nv:196",
            "emit_c: a range has no binary form -- for-heads consume it")
    }
}


/// `!=` is not a second protocol method: the spec DERIVES it from `@equal`
/// (D46 rule 3), so the emitter negates the same call.
fn op_is_not_equal(op BinOp) -> bool {
    match op {
        NotEqual => true
        Equal | Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// Plain C infix with no cast: the bitwise and shift family on int.
fn is_bit_infix(op BinOp) -> bool {
    match op {
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => true
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse | Range => false
    }
}

/// The C form of a prefix operator. `!` is logical on bool, `-` negates,
/// `~` complements -- all three are plain C on the primitives the subset
/// admits (check refuses the protocol cases).
fn c_unary_form(op UnOp) -> str {
    match op {
        Not => "!"
        Negate => "-"
        BitNot => "~"
    }
}

/// Is this operator a comparison? Derived from the decision (P22: derived is
/// a function, not a second table), and exhaustive so a new operator must
/// answer here too.


/// Emit one expression: literals, names, fields, method/fn calls, binary ops.
fn Emitter mut @emit_expr(e Node) -> () {
    // A NODE THE LOWERING PUT IN A TEMPORARY (registry 1619) prints as it -- except
    // the value of the assignment that defines it, which would read `x = x`.
    ro hl = if e.id_of() != @hoist_root { @lo.ir.local_of_node(e.id_of()) } else { no_local() }
    if hl != no_local() {
        @body.append(@lo.ir.decl_of(hl).name)
        return
    } else {
        // Not laid down, or the defining value: printed from the tree below.
    }
    // A MOVE of an affine binding that has a drop flag (D432 s5) sets it as it moves:
    // `(flag = 1, x)` -- inside the expression, so a move on one side of `&&` sets it
    // only when it runs.
    if e.id_of() != @gone_root {
        ro bind = @out.gone_binder(e.id_of())
        ro gone = if bind >= 0 { @lo.ir.gone_of(bind) } else { no_local() }
        if gone != no_local() {
            @gone_root = e.id_of()
            @body.append("(${@lo.ir.decl_of(gone).name} = 1, ")
            @emit_expr(e)
            @body.append(")")
            @gone_root = no_node()
            return
        } else {
            // No flag to set: printed below.
        }
    } else {
        // The move inside its own flag set: printed bare below.
    }
    ro k = e.kind_of()
    if k != NodeKind.Lit && is_const_int_expr(e) && @emit_folded_constant(e) { return }
    if k == NodeKind.Lit {
        ro lkids = branch_children(e)
        ro t = lkids[lkids.len() - 1]
        ro neg = lkids.len() > 1 // [Minus, lit]
        ro lk = leaf_kind(t)
        if lk == TokenKind.IntLit || lk == TokenKind.FloatLit {
            // THE POSITION'S TYPE, when the checker decided one (D227 rule 2:
            // a literal beside an `i8` operand IS an `i8`); with nothing
            // recorded the literal is its own kind (D44). The cast spells the
            // row's C name, as the oracle does -- `((int8_t)1)`,
            // `((nova_byte)100U)`, `((uint64_t)5000000001ULL)` -- and the
            // suffix follows the row's signedness. Until 2026-09-04 every
            // integer literal was `((nova_int)...LL)` whatever its position.
            ro own_ty = if lk == TokenKind.FloatLit { @ctx.prims.f64_id } else { @ctx.prims.int_id }
            ro decided = @out.type_if_known(e.id_of())
            ro row = @arith_row(if is_ty(decided) { decided } else { own_ty })
            @body.append("((")
            @body.append(row.c_name)
            @body.append(")")
            @body.append(if neg { "-" } else { "" })
            if lk == TokenKind.IntLit {
                @body.append(int_literal_c_text(leaf_text(t)))
                @body.append(if row.signed { "LL" } else { "ULL" })
            } else {
                @body.append(literal_digits(leaf_text(t)))
            }
            @body.append(")")
        } else if lk == TokenKind.CharLit {
            // The codepoint through the ONE spelling door (the int literal's
            // precedent); the C form is the one the interp chain already
            // prints for its fill character.
            @body.append("((nova_char)")
            @body.append(char_literal_code(leaf_text(t)))
            @body.append("U)")
        } else if lk == TokenKind.StrLit {
            // An INTERPOLATED literal was hoisted into its builder chain by
            // the statement's walk (I1); the temporary carries the string.
            // A literal WITHOUT an identity -- a handed constant's
            // initializer (registry 1518, sem/harvest.nv) -- was never
            // hoisted: no walk of this file reached it.
            ro itmp = if is_node(e.id_of()) { @lit_tmp[raw_node(e.id_of())] } else { "" }
            if itmp != "" {
                @body.append(itmp)
                return
            }
            if interp_slices(leaf_text(t)).len() > 1 {
                // The checker types every interpolation it accepts, and the
                // hoist walks every statement -- a miss here is a hole, not
                // a shape to print from the pool.
                ice_at(
                    "novac/src/emit_c/emit_expr.nv:317",
                    "emit_c: an interpolated literal the hoist never built (I1)")
            } else {
                // A plain literal: the pool owns it, below.
            }
            // A string literal in value position (binding init, method
            // argument): registered like a println literal, referenced by
            // its C name — the oracle emits the same shape.
            ro idx = @pool.slot(leaf_text(t))
            @body.append("_novac_strlit_${@tag}${idx}")
        } else {
            ice_at("novac/src/emit_c/emit_expr.nv:329", "emit_c: literal kind outside the subset")
        }
    } else if k == NodeKind.ArrayLit {
        // Printed as the TEMPORARY its hoist built (wave B8): the literal is
        // a multi-statement construction, and the statement that owns this
        // expression hoisted it before printing. An empty name here is a
        // hole in that contract, not a user mistake.
        ro tmp = @lit_tmp[raw_node(e.id_of())]
        if tmp == "" {
            ice_at(
                "novac/src/emit_c/emit_expr.nv:338",
                "emit: an array literal in expression position was never hoisted (wave B8)")
        } else {
            // Hoisted: the temporary carries the built vector.
        }
        @body.append(tmp)
    } else if k == NodeKind.TupleExpr {
        // The same contract as the literals above (B15 step 4a): a tuple is a
        // multi-statement build, so what stands in the expression is the
        // temporary its hoist filled.
        ro ttmp = @lit_tmp[raw_node(e.id_of())]
        if ttmp == "" {
            ice_at(
                "novac/src/emit_c/emit_expr.nv:351",
                "emit: a tuple literal in expression position was never hoisted (B15 step 4a)")
        } else {
            // Hoisted: the temporary carries the built pair.
        }
        @body.append(ttmp)
    } else if k == NodeKind.RecordCtor {
        // The same contract as the array literal above, and for the same
        // reason (wave B13): a constructor is built by several C statements,
        // so what stands in the expression is the temporary the hoist filled.
        ro rtmp = @lit_tmp[raw_node(e.id_of())]
        if rtmp == "" {
            ice_at(
                "novac/src/emit_c/emit_expr.nv:364",
                "emit: a record constructor in expression position was never hoisted (wave B13)")
        } else {
            // Hoisted: the temporary carries the built record.
        }
        @body.append(rtmp)
    } else if k == NodeKind.Name {
        // A NAME WITHOUT AN IDENTITY is a handed function's `true` / `false`
        // default, rebuilt without one by harvest (registry 1576): the channel
        // knows nothing of it, and asking it by id would index with -1.
        if !is_node(e.id_of()) {
            ro bname = expr_leaf_name(e)
            if is_bool_literal(bname) {
                @body.append(bool_c_literal(is_true_literal(bname)))
                return
            }
            ice_at(
                "novac/src/emit_c/emit_expr.nv:381",
                "emit_c: a name without an identity that is no bool literal (a handed default)")
        } else {
            // A name of this file's tree: the channel answers below.
        }
        // A CAPTURE (E.9 step 3): a binding of the scope a handler literal
        // was written in, read from one of its op bodies -- through the op
        // function's context, as the checker recorded it.
        match @out.capture_at(e.id_of()) {
            Some(c) => {
                @emit_capture_read(c)
                return
            }
            None => {
                // An ordinary name: a constant, a variant value or a local, below.
            }
        }
        // A CONSTANT IS SUBSTITUTED, not referenced (274.5 wave B2): it has no
        // C symbol of its own, and WHICH constant this is came from the
        // channel -- the emitter resolves no names (274.4 rule E).
        match @out.const_of(e.id_of()) {
            Some(row) => @emit_const_read(row)
            None => {
                if @out.has_callee(e.id_of()) {
                    // A payload-less variant as a value (the variant-value
                    // wave): the checker resolved the bare name to its
                    // variant row; the maker is the oracle's own spelling.
                    match @out.callee_of(e.id_of()).target {
                        CalleeVariant(v) => {
                            // An Option instance (`None`, wave W4) is the
                            // shell's compound literal; a file sum's variant
                            // is its maker.
                            ro nt = @out.type_if_known(e.id_of())
                            if @is_option_inst(nt) {
                                @emit_option_none(nt)
                            } else {
                                @body.append("${c_maker(@ctx, v)}()")
                            }
                        }
                        CalleeFn(_) | CalleeCtor(_) | CalleeSynthDisplay(_) | CalleeEffectOp(_) =>
                            ice_at(
                                "novac/src/emit_c/emit_expr.nv:422",
                                "emit: a bare name resolved to a non-variant callee")
                    }
                } else {
                    // Not a constant: an ordinary name, and `nova_bool` IS C
                    // `bool`, so the literals are the C keywords -- the same
                    // shape the oracle emits. A bool literal is a C keyword by
                    // its spelling, not a name: the door (`c_ident`, which
                    // escapes C23 `true`/`false`) must not see it.
                    ro nm = expr_leaf_name(e)
                    @body.append(if is_bool_literal(nm) { nm } else { c_ident(nm) })
                }
            }
        }
    } else if k == NodeKind.InterpStr {
        ro itmp2 = @lit_tmp[raw_node(e.id_of())]
        if itmp2 == "" {
            ice_at("novac/src/emit_c/emit_expr.nv:440", "emit_c: an interpolated string the hoist never built (I2)")
        }
        @body.append(itmp2)
    } else if k == NodeKind.Coalesce || k == NodeKind.Try {
        // The hoist built the temporary and the guard that fills it (the
        // short circuit lives there, and `x?`'s early return); the expression
        // IS that name.
        ro qtmp = @lit_tmp[raw_node(e.id_of())]
        if qtmp == "" {
            ice_at("novac/src/emit_c/emit_expr.nv:449", "emit_c: a `??` the hoist never built (coalesce wave)")
        }
        @body.append(qtmp)
    } else if k == NodeKind.SelfExpr {
        // The receiver's C name; its VALUE when a value record came by pointer (D488).
        @body.append(if @recv_ptr_value { "(*${RECV_C_NAME})" } else { RECV_C_NAME })
    } else if k == NodeKind.SelfField {
        // `@field` is a field of the receiver, and the receiver is parameter
        // zero under our own name. A record is a GC pointer, so the access is
        // `->` exactly like any other field access -- one shape, not two.
        ro kids = branch_children(e)
        // A `value` record that arrived BY COPY (D488 R5) is reached with `.`.
        @body.append(if @recv_copy { "(${RECV_C_NAME}." } else { "(${RECV_C_NAME}->" })
        @body.append(leaf_text(kids[1]))
        @body.append(")")
    } else if k == NodeKind.FieldAccess {
        // A QUALIFIED constant or module value (`Type.NAME`, D200 amend #66):
        // the checker wrote WHICH one on this node, exactly as on a bare
        // name -- nothing here is a field read. Until 274.5 S6 the checker
        // recorded only its type, and this arm printed `Type->NAME`.
        match @out.const_of(e.id_of()) {
            Some(row) => {
                @emit_const_read(row)
                return
            }
            None => {
                // Not a constant: a variant value or a field, below.
            }
        }
        // `Sum.Variant` as a VALUE (the variant-value wave): the checker
        // wrote the variant row on THIS node; nothing here is a field read.
        if @out.has_callee(e.id_of()) {
            match @out.callee_of(e.id_of()).target {
                CalleeVariant(v) => {
                    ro nt = @out.type_if_known(e.id_of())
                    if @is_option_inst(nt) {
                        @emit_option_none(nt)
                    } else {
                        @body.append("${c_maker(@ctx, v)}()")
                    }
                    return
                }
                CalleeFn(_) | CalleeCtor(_) | CalleeSynthDisplay(_) | CalleeEffectOp(_) =>
                    ice_at("novac/src/emit_c/emit_expr.nv:492", "emit: a field access resolved to a non-variant callee")
            }
        } else {
            // An ordinary field access: the shapes below own it.
        }
        ro kids = branch_children(e)
        // A POSITIONAL projection prints `.fN` -- for BOTH positional shapes,
        // and that is why the question is the shape and not `is_tuple` (owner,
        // 2026-09-04: that name answered "anonymous" while saying "tuple"). The
        // anonymous term is a D123 mono struct with fields f0..fN; the declared
        // positional record carries f0..fN by the owner's ruling. Both live on
        // the stack, so the dot is not a choice here the way it is for records
        // below. (The declared shape is refused by the checker until its
        // declaration is read; the arm is the truth about its spelling, not a
        // claim that it arrives.)
        ro positional = match shape_of(@ctx, @out.type_if_known(kids[0].id_of())) {
            AnonPositionalTuple | PositionalTuple => true
            Record | ValueRecord | NamedTuple | AnonNamedTuple => false
        }
        if positional {
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(".f")
            @body.append(leaf_text(kids[2]))
            @body.append(")")
            return
        }
        @body.append("(")
        @emit_expr(kids[0])
        // A VALUE record is reached with `.`, a GC pointer with `->`. The
        // operand's TYPE decides, and it comes from the channel: after the
        // checker, nobody infers. A position the channel has no answer for
        // keeps the pointer form, which is what every record was before the
        // layout existed.
        @body.append(if is_value_record(@ctx, @out.type_if_known(kids[0].id_of())) { "." } else { "->" })
        @body.append(c_ident(leaf_text(kids[2])))
        @body.append(")")
    } else if k == NodeKind.MethodCall {
        // kids: [recv, '.', name, '(', args..., ')'] -> <Recv>_method_<name>(recv, args...)
        // The C receiver prefix follows the oracle's mono naming: str ->
        // Nova_str_method_, []int -> Vec____nova_int_method_.
        ro kids = branch_children(e)
        // A RAW POINTER's method is the language's own (emit_ptr.nv, D216).
        if @is_ptr_receiver(kids[0]) {
            @emit_ptr_op(kids)
            return
        } else {
            // A method of a type: the row the checker decided, below.
        }
        // The ROW the checker decided on, not a name rebuilt from the receiver's
        // type: after the checker, nobody infers.
        ro cr = @out.callee_of(e.id_of())
        // `Sum.Variant(x)` WEARS THIS SHAPE and is a CONSTRUCTION, not a call:
        // the checker recorded a variant row, and asking that record for a
        // callable row ices by design ("a variant row is not a callable row").
        // The same maker the unqualified `Variant(x)` prints, from the same
        // recorded decision -- one form of the language, two spellings, one
        // emission (2026-09-04, wave V3-4b).
        match cr.target {
            CalleeVariant(v) => {
                // `Option.Some(x)`: the shell's compound literal (wave W4).
                ro nt = @out.type_if_known(e.id_of())
                if @is_option_inst(nt) {
                    @emit_option_some(nt, call_arg_at(kids, 3, 0))
                    return
                } else {
                    // A file sum's variant: its maker, below.
                }
                @body.append("${@variant_maker(v, nt)}(")
                @emit_bound_args(kids, 3, false, e.id_of(), callee_row_or_none(cr))
                @body.append(")")
                return
            }
            CalleeFn(_) | CalleeCtor(_) => {
                // An ordinary method call: the row below is the decision.
            }
            CalleeSynthDisplay(_) => ice_at(
                "novac/src/emit_c/emit_expr.nv:568",
                "emit: a method call resolved to a synthesized display -- the synthesis is recorded on an INTERPOLATION SLOT, and a written call has a row")
            CalleeEffectOp(op) => {
                // `Os.arg_count()` (E.9 step 2): the shell's dispatcher, which
                // runs the installed handler or the effect's default one --
                // the handler is never looked up at the call site.
                @body.append("${effect_op_dispatcher_c(op.eff, op.op)}(")
                @emit_bound_args(kids, 3, false, e.id_of(), no_row())
                @body.append(")")
                return
            }
        }
        // The SUBSTITUTION comes from the same record as the row: one question
        // ("which instance does this call name"), one read. An ordinary call
        // carries an empty one, so there is no branch here to get wrong.
        // `body_ours`: the file's own, a program module's, or an instance this
        // unit makes from a handed body (274.11 E.10 step 4c).
        ro static = is_ty(@ctx.fns.rows[raw_row(cr.callable_row())].owner)
        // A fluent `-> @` of a `value` receiver by pointer returns the POINTER (1654).
        ro deref = !static && row_returns_recv_pointer(@ctx, cr.callable_row())
        @body.append(if deref { "(*" } else { "" })
        // ONE question decides whose body this is (`Ctx @instantiates` asks the
        // shell by `c_overload_symbol`), and the name printed below is that
        // door's answer: a `consume` method of the shell (1564) and a second
        // overload (1524) are spelled by it alike, so no override is needed here.
        if @ctx.body_ours(cr.callable_row(), @out.callee_subst_of(e.id_of())) {
            @body.append(c_callable(@ctx, cr.callable_row(), @out.callee_subst_of(e.id_of())))
        } else if static {
            // A STATIC method the shell carries (274.11 E.10 step 4c-2): no
            // receiver to spell it from -- the row and its substitution are.
            @body.append(c_static_symbol(@ctx, cr.callable_row(), @out.callee_subst_of(e.id_of())))
        } else {
            // INTEROP (sub-plan L2): a method row with no body of ours is an
            // instance method the SHELL emits, named by the receiver's
            // instance -- `Vec____nova_int_method_len`; the checker admitted
            // it against the lifted surface. Goes the day novac emits the
            // whole prelude.
            // The OVERLOAD the checker picked, spelled by the same door the
            // checker asked the shell with (registry 1524, 1564).
            @body.append(c_overload_symbol(@ctx, cr.callable_row(), @out.type_of(kids[0].id_of()),
                                           @out.callee_subst_of(e.id_of())))
        }
        @body.append("(")
        // The receiver is parameter ZERO (plan 273), so it is slot zero of the
        // recorded binding -- not a special case bolted onto the front. The
        // written arguments start at child 3 (receiver, dot, name).
        // A static method takes no receiver: its slots are its written arguments.
        @emit_bound_args(kids, 3, !static, e.id_of(), cr.callable_row())
        @body.append(if deref { "))" } else { ")" })
    } else if k == NodeKind.Call && @out.embed_row_at(e.id_of()) >= 0 {
        // `embed("path")` (D412): the checker noted the door's row; the blob is printed.
        @emit_embed(e)
    } else if k == NodeKind.Call && @out.contract_of(e.id_of()).is_some() {
        // `assert(..)` (D81) or `panic(..)` (D13): the checker typed the
        // intrinsic and noted its line.
        ro ik = branch_children(e)
        if call_callee_text(ik) == PANIC_FN {
            @emit_panic_call(e, ik)
        } else {
            @emit_assert(e, ik)
        }
    } else if k == NodeKind.Call && @out.has_subst(e.id_of()) {
        // `size_of[T]()` (D216, 274.11 E.10 step 4c-2): the checker recorded
        // the type argument as the node's substitution; the value is C's size.
        @body.append("((nova_int)sizeof(${c_type(@ctx, @out.subst_of(e.id_of())[0])}))")
    } else if k == NodeKind.Call {
        ro kids = branch_children(e)
        // THE ROW THE CHECKER DECIDED ON, exactly as the MethodCall branch
        // above: after the checker, nobody infers. This branch used to ask
        // `defs` by the bare NAME instead -- a registry that lives by
        // last-write-wins -- so with two candidates the emission named a
        // different row than the one check had resolved. Measured 2026-08-20:
        // `byte_len("abc")` was recorded against `str @byte_len()` and emitted
        // as the file's two-parameter `byte_len`, one string argument and all.
        ro cr = @out.callee_of(e.id_of())
        // The target CARRIES its row, so each arm reads a row of its own
        // space: `c_maker` gets a variant row, `c_callable` a callable row, and
        // neither can be handed the other's (owner's question 2026-08-21 --
        // "why is `target_row` not `FnRow`": because it was three spaces in one
        // int, and the answer is a sum, not a wrapper).
        match cr.target {
            CalleeVariant(v) => {
                // `Some(x)` of an Option INSTANCE (wave W4): the shell's
                // compound literal, one expression, nothing to hoist here --
                // the payload prints through the general door.
                ro nt = @out.type_if_known(e.id_of())
                if @is_option_inst(nt) {
                    @emit_option_some(nt, call_arg_at(kids, 1, 0))
                    return
                } else {
                    // A file sum's variant: its maker opens here, the
                    // arguments follow below.
                }
                @body.append("${@variant_maker(v, nt)}(")
            }
            // A CONSTRUCTOR is a function whose return type is a
            // parenthesised record and whose body novac does not emit -- so
            // the call site prints the ORACLE's own construction, a compound
            // literal on the stack (`((NovaTuple_Pair){1LL, 2LL})`, read off
            // its C 2026-09-03), never a call to a C function that exists
            // nowhere. One expression, so nothing is hoisted (274.6 V2b).
            CalleeSynthDisplay(_) => ice_at(
                "novac/src/emit_c/emit_expr.nv:670",
                "emit: a call hoist for a synthesized display -- the synthesis is a slot, not a written call")
            CalleeEffectOp(_) => ice_at(
                "novac/src/emit_c/emit_expr.nv:673",
                "emit: a call hoist for an effect operation -- an operation call is a method-call form, printed by its own arm")
            CalleeFn(row) => {
                ro rt = @ctx.fns.rows[raw_row(row)].ret_id
                // Same deferral as the checker's routing door: only the
                // NAMED form has a constructor row today, so only it can
                // reach this arm. The three places -- registration (sem),
                // routing (check/calls) and this emission -- move together;
                // when V3 registers positional constructors, all three turn.
                ro ctor = match shape_of(@ctx, rt) {
                    NamedTuple => !@ctx.fns.compiles_body(row)
                    Record | ValueRecord | PositionalTuple | AnonNamedTuple | AnonPositionalTuple => false
                }
                if ctor {
                    @body.append("((${c_struct(@ctx, rt)}){")
                    @emit_bound_args(kids, 1, false, e.id_of(), row)
                    @body.append("})")
                    return
                } else {
                    // An ordinary callable: its C name opens below.
                }
                // NAMED BY WHOEVER HAS THE BODY (wave W6): a free function of a
                // handed module is std's, the shell carries it under the oracle's
                // spelling, and the checker admitted the call against the lifted
                // surface; our own spelling is for the rows we compile.
                // An instance this unit makes from a handed body (274.11 E.10
                // step 4c-2: `alloc_buf[Pt]`) is ours too (`Ctx @body_ours`).
                if !@ctx.body_ours(row, @out.callee_subst_of(e.id_of())) {
                    @body.append("${c_free_symbol(@ctx, row)}(")
                } else {
                    @body.append("${c_callable(@ctx, row, @out.callee_subst_of(e.id_of()))}(")
                }
            }
            // A TYPE in call position CONSTRUCTS a newtype, and a newtype IS
            // its representation at runtime -- zero cost, D-newtype. So the
            // emission is the ARGUMENT and nothing else: no wrapper, no cast
            // (C needs none between a typedef and its underlying type). The
            // oracle writes a redundant cast here; the shape of our emission is
            // ours (274 section 7.0) as long as the behaviour is identical.
            // A TYPE in call position CONSTRUCTS, and WHICH construction is
            // the SHAPE's answer (274.6 V2b):
            //
            //   * a NEWTYPE is its representation at runtime -- zero cost,
            //     so the emission is the ARGUMENT and nothing else: no
            //     wrapper, no cast (C needs none between a typedef and its
            //     underlying type). The oracle writes a redundant cast here;
            //     the shape of our emission is ours (274 section 7.0) as
            //     long as the behaviour is identical.
            //   * the PARENTHESISED record form is a COMPOUND LITERAL, one
            //     expression on the stack -- read off the oracle's own C
            //     2026-09-03: `((NovaTuple_Pair){1LL, 2LL})`. One expression
            //     is why this needs no hoist, unlike the brace constructor
            //     (which builds field by field through a temporary).
            CalleeCtor(_) => {
                for c in kids {
                    if !is_expr_kind(c.kind_of()) { continue }
                    @emit_expr(c)
                }
                return
            }
        }
        // BY THE RECORDED BINDING, never by written order (wave 4, D102): a
        // named argument may stand anywhere among the named ones, and an omitted
        // one is filled from the declaration. Which argument means which
        // parameter is the CHECKER's decision, and this reads it.
        @emit_bound_args(kids, 1, false, e.id_of(), callee_row_or_none(cr))
        @body.append(")")
    } else if k == NodeKind.Index {
        // Two checked forms, one door (D470 section 5: an index is the call
        // `xs.index(i)`; a slice is `xs.index(Range { start, end })`):
        //
        // - A SLICE `s[lo..hi]`, either side open (plan 274.7 waves U-1..U-3):
        //   `@emit_slice` (emit_slice.nv), over the receiver's recorded type.
        // - A PLAIN INDEX `xs[i]` on a `[]T` receiver whose instance the shell
        //   carries (`Vec____nova_int_method_index`, wave 274.5); the checker
        //   records the ELEMENT as the node's type, so the symbol question
        //   goes to the RECEIVER's recorded type, not the node's.
        //
        // Every other index was refused by the checker, named; reaching this
        // arm with one is a broken contract, not a program.
        ro kids = branch_children(e)
        if kids.len() < 3 {
            ice_at(
                "novac/src/emit_c/emit_expr.nv:756",
                "emit: an index with fewer than a receiver, `[` and an operand reached emission")
        } else {
            // The three children the checker judged.
        }
        if slice_shape_of(kids[2]).is_some() {
            @emit_slice(kids)
        } else {
            // A plain index: `xs.index(i)`, the receiver's instance spelling.
            ro rt = @out.type_if_known(kids[0].id_of())
            if !is_ty(rt) {
                ice_at(
                    "novac/src/emit_c/emit_expr.nv:768",
                    "emit: an index whose receiver type the checker did not record reached emission")
            } else {
                // The receiver's type decides the symbol, below.
            }
            @body.append(vec_op_c(@ctx, rt, VEC_INDEX_METHOD, @out.vec_op_row(VEC_INDEX_METHOD)))
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(")")
        }
    } else if k == NodeKind.Unsafe {
        @emit_unsafe_value(e)
    } else if k == NodeKind.IsTest {
        @emit_is_test(e)
    } else if k == NodeKind.Cast {
        // A newtype's unwrap, a pointer, a pair of primitives (D54): one door.
        @emit_cast(e)
    } else if k == NodeKind.Paren {
        @body.append("(")
        @emit_expr(branch_children(e)[1])
        @body.append(")")
    } else if k == NodeKind.Unary {
        ro kids = branch_children(e)
        // INT NEGATION GOES THROUGH THE CHECKED HELPER (hunt emit_c x K1, H3):
        // `-INT_MIN` does not fit, the oracle panics ("negation overflow"),
        // and the raw C form printed INT_MIN back in silence -- in the same
        // file where addition two doors up goes through `nova_int_checked_add`.
        // The node's type is the checker's answer, recorded when the unary was
        // typed; the CARRIER decides, exactly as in the compound form (H5) --
        // a newtype negates as what it holds.
        ro uk = un_op_of(leaf_kind(kids[0]))
        ro carrier = carrier_of(@ctx, @out.type_of(e.id_of()))
        // NEGATION IS CHECKED ONLY FOR SIGNED WIDTHS, and that is the RUNTIME's
        // own rule, not a preference: `nova_rt/effects.h` defines
        // `nova_<T>_checked_neg` under NOVA_DEFINE_CHECKED_SIGNED_DIVMODNEG for
        // i8/i16/i32/i64 only -- there is no unsigned symbol. Measured 2026-09-04
        // by a probe that LINKED: emitting `nova_u8_checked_neg` for `-a` on a
        // `u8` produced an undefined symbol. Since wave 274.7 B4 (2026-09-05) an
        // unsigned operand never reaches this door: the SPEC defines unary minus
        // for signed types only (conversions.md), and the checker refuses it in
        // `@report_if_unary_needs_protocol(kids)` (check/operators.nv, the
        // NEG_UNSIGNED_MSG arm) -- the oracle's modular wrap (#926) is not a
        // program novac emits. So the
        // raw-C branch below is for `!`, `~` and float negation, and an unsigned
        // integer here is a hole in the checker, said aloud rather than printed.
        ro neg_int = match uk {
            Negate => is_int_prim(@ctx.tys, carrier)
            Not | BitNot => false
        }
        if neg_int && !@arith_row(carrier).signed {
            ice_at(
                "novac/src/emit_c/emit_expr.nv:821",
                "emit_c: unary minus on an unsigned operand passed the checker -- spec/conversions.md defines it for signed types only")
        }
        if neg_int {
            @body.append("nova_${@arith_row(carrier).name}_checked_neg(")
            @emit_expr(kids[1])
            @body.append(")")
        } else {
            // `!` on a bool and `-` on a float are plain C. `~` on an INTEGER
            // row is cast back to the ROW's C type (274.7 B7, #934): C promotes
            // a `u8` to `int`, and `~idu8(15)` printed -16 where the oracle
            // prints 240 -- the width of the result is the row's, not the
            // promotion's.
            ro cast = match uk {
                BitNot => is_int_prim(@ctx.tys, carrier)
                Not | Negate => false
            }
            if cast {
                @body.append("((${@arith_row(carrier).c_name})")
            } else {
                // No narrowing to undo: the C operator's type is the row's.
            }
            @body.append("(")
            @body.append(c_unary_form(uk))
            @body.append("(")
            @emit_expr(kids[1])
            @body.append("))")
            if cast {
                @body.append(")")
            } else {
                // Nothing was opened above.
            }
        }
    } else if k == NodeKind.Bin {
        ro kids = branch_children(e)
        ro op = bin_op_of(leaf_kind(kids[1]))
        // Reading the EXPRESSION's recorded type IS reading the operands':
        // only ARITHMETIC branches on the float test (comparisons come out as
        // C operators whatever the flag says -- c_binary_form), and
        // arithmetic's result type equals its operands'. The hunt (emit_c x
        // K1, P1) read the previous wording here as a promise to look at the
        // operand and found the code reading the node: the code was right,
        // the words were not.
        ro row = @arith_row(@out.type_of(e.id_of()))
        ro is_float = is_float_row(row)
        ro form = c_binary_form(op, row)
        // `str` equality is the protocol method, not a C operator (D46:
        // `a == b` is `a.@equal(b)`), and `!=` is DERIVED from it — the spec
        // states the derivation, so novac spells it the same way instead of
        // inventing a second method name (owner's reminder 2026-08-16).
        // WHICH CALLABLE is the CHECKER's decision, and it is
        // in the channel (274.4 §1). Until 2026-08-28 the
        // emitter resolved the `equal` method here itself: the
        // only resolution outside `check/` and a SECOND DOOR to
        // one root -- on an ambiguous overload the checker
        // refuses by name while this branch silently took the
        // first candidate. Now the PRESENCE of a callee is the
        // decision: recorded for an operator that dispatches,
        // absent where a primitive C form comes out.
        if @out.has_callee(e.id_of()) {
            ro row = @out.callee_of(e.id_of()).callable_row()
            // `equal` for `==`/`!=`, `compare` for an ordering (D46): the row says
            // which, and an ordering reads `compare(a, b) <op> 0` (the oracle's).
            ro method = @ctx.fns.rows[raw_row(row)].name
            @body.append("((nova_int)(")
            @body.append(if op_is_not_equal(op) { "!" } else { "" })
            // NAMED BY WHOEVER HAS THE BODY. `str.equal` is std's, and novac
            // compiles no std bodies — so the definition lives in the SHELL and
            // must be called by the shell's name. Until 2026-08-28 this branch
            // printed `c_callable`, i.e. OUR `novac_fn_equal__...`, and the link
            // failed on an undefined symbol; nobody saw it because not one file
            // of the corpus that novac accepts compares strings (measured).
            if @ctx.in_program(row) {
                @body.append(c_callable(@ctx, row, no_subst()))
            } else {
                // A vector instance is spelled `<Head>____<args>_method_equal`, a
                // primitive `Nova_<type>_method_equal`: the one door that knows both.
                @body.append(c_method_symbol(@ctx, @out.type_of(kids[0].id_of()), method))
            }
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(if method == EQUAL_METHOD { ")))" } else { ") ${form} 0))" })
        } else if is_sum_equality(op, @ctx, @out.type_of(kids[0].id_of())) {
            // A PAYLOAD-FREE SUM declaring `Equal` (274.7 wave R): its value IS
            // the tag, so the tags compare -- the access by placement, the way
            // `@emit_tag_test` reads a scrutinee (A4).
            ro acc = if is_value_sum(@ctx, @out.type_of(kids[0].id_of())) { "." } else { "->" }
            @body.append("((nova_int)((")
            @emit_expr(kids[0])
            @body.append(")${acc}tag ")
            @body.append(form)
            @body.append(" (")
            @emit_expr(kids[2])
            @body.append(")${acc}tag))")
        } else if is_bit_infix(op) {
            // Cast back to the row's width (emit_cast.nv, registry 1602).
            @emit_bit_infix(e, kids, form)
        } else if is_truth_infix(op) {
            @body.append("((nova_int)((")
            @emit_expr(kids[0])
            @body.append(") ")
            @body.append(form)
            @body.append(" (")
            @emit_expr(kids[2])
            @body.append(")))")
        } else if !is_call_form(op, is_float) {
            // f64 arithmetic is RAW C with left-assoc parens -- the oracle's
            // shape: ((((nova_f64)3.14) * r) * r).
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(" ")
            @body.append(form)
            @body.append(" ")
            @emit_expr(kids[2])
            @body.append(")")
        } else {
            @body.append(form)
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(")")
        }
    } else {
        ice_at("novac/src/emit_c/emit_expr.nv:948", "emit: expression kind outside the subset")
    }
}

/// Emit a CALL STATEMENT. The subset knows exactly one callee here,
/// `println`, and check refuses the rest — the ice below is the second
/// floor, not the first answer (owner's question 2026-08-16: the name
/// `emit_println` read as if every Call were a println).
/// One printer per argument by its type, then a newline.
/// AN EXPRESSION IN STATEMENT POSITION WHOSE RESULT IS DISCARDED (wave B12): emitting a call
/// as a VALUE is something this file already does, and a statement is that plus a semicolon.
/// No temporary is declared, because nobody asked this call for an answer. Measured with the
/// oracle BEFORE it was written: discarding a result is legal there and silent, so warning
/// about it here would be our invention rather than the language's rule.
fn Emitter mut @emit_call_stmt(call Node) -> () {
    if is_print_fn(call_callee_text(branch_children(call))) {
        // `println` IS LOWERED, NOT PRINTED FROM HERE (M3a). Its output interleaves with the
        // effects of building its arguments, and THAT ORDER IS OBSERVABLE, so the sequence
        // lives in the channel: `lower_eval` turns it into output statements and the walk
        // prints those. Arriving here with a println means the lowering did not recognise the
        // form -- a hole, not a shape to print. The ice is what keeps it a hole: the printing
        // this branch used to do went through the PRINT-TIME HOIST, and that hoist is exactly
        // what refused with `lower: a block sealed twice (it already returns)` under the walk
        // of step 3b. A dead printer that restores retired behaviour is worse than none -- it
        // turns a hole into a silent divergence.
        ice_at(
            "novac/src/emit_c/emit_expr.nv:973",
            "emit_c: a println reached the call-statement door -- it is lowered, not printed (M3a)")
    } else {
        // An ordinary call: the lines below own it.
    }
    @hoist_array_lits(call)
    @body.append("    ")
    @emit_expr(call)
    @body.append(";\n")
}

/// `==` / `!=` whose operands are a payload-free sum (274.7 wave R): the checker
/// let it through only with `#impl(Equal)` and `is_payload_free_sum`, so the
/// operand's recorded type is the whole question here -- nothing is decided twice.
fn is_sum_equality(op BinOp, ctx Ctx, t TyId) -> bool {
    match op {
        Equal | NotEqual => is_payload_free_sum(ctx, t)
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | AndAlso | OrElse => false
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}
