// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc_codegen_ssa `mir/rvalue.rs` -- operand and operator lowering
// sits apart from statement and item lowering there too; the operator
// tables and the expression walk are one subject.
//
// Role: emission of EXPRESSIONS -- the C forms of every operator, the
//   expression walk itself, and the call-as-statement door.
// Used by: emit_c.nv (statements and bindings ask for an expression).
// Guarded by: check-novac-file-size.py (this split), check-novac-deps.py,
//   check-novac-emission-size.sh, check-novac-doc-language.py.
//
// Split out of emit_c.nv on 2026-08-18: writing the `else` branch pushed
// that file past a thousand lines.

module novac.emit_c

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind, BinOp, UnOp, bin_op_of, un_op_of, assign_op_of, raw_node}
import ../diag.{ice}
import ../sem.{raw_crow, carrier_of, c_callable, c_instance_method, c_shell_method, arm_body_at, Ctx}
import ../sem.{CheckOut}
import ../sem.{branch_children, leaf_text, leaf_kind, is_expr_kind, expr_leaf_name, call_callee_text, c_type, c_struct}
import ../sem.{int_literal_c_text}
import ../sem.{c_tag, c_maker, VariantRow, raw_vrow, no_vrow, is_vrow, call_arg_at, raw_row, slot_default_of, no_row}
import ../sem.{is_value_record}
import ../builtins.{EQUAL_METHOD, PRINT_FN, bool_c_literal, RECV_C_NAME}
import ../types.{TyId, is_ty}
import ../sem.{is_tuple}


/// The C form of a binary operator ON PRIMITIVE OPERANDS, chosen by the
/// DECISION and the operand type -- one exhaustive match instead of the three
/// token-keyed tables this replaced (`checked_op`, `cmp_op`, `raw_op`), each
/// of which returned an empty string on anything it did not know and let the
/// next one guess.
///
/// PRIMITIVE is the load-bearing word (owner's correction 2026-08-16). In
/// Nova every operator is overloadable on user types through protocols
/// (D46/D363: `@plus`, `@compare`, `@equal`), so the emitted form is a
/// function of the operator AND the operand type. The subset emits only the
/// primitive half; `check` refuses the rest at the operator's position rather
/// than letting this table answer for a type it knows nothing about.
///
/// `is_float` comes from the checker's channel: float arithmetic is raw C
/// (the oracle's shape, and floats have no overflow trap), int arithmetic
/// goes through the runtime's checked helpers, comparisons are C operators
/// either way.
fn c_binary_form(op BinOp, is_float bool) -> str {
    match op {
        Add => {
            if is_float { return "+" }
            "nova_int_checked_add"
        }
        Sub => {
            if is_float { return "-" }
            "nova_int_checked_sub"
        }
        Mul => {
            if is_float { return "*" }
            "nova_int_checked_mul"
        }
        Div => {
            if is_float { return "/" }
            "nova_int_checked_div"
        }
        Modulo => {
            // The float remainder is `fmod`, not a C operator -- and it IS
            // part of the language (D46 F, registry No. 707: the precedence
            // table never restricted `%` by type, and forbidding it would
            // narrow the language to work around a codegen defect). Sign
            // follows the DIVIDEND as in C and Rust; there is no
            // divide-by-zero panic here, IEEE-754 gives NaN.
            if is_float { return "fmod" }
            "nova_int_checked_rem"
        }
        Less => "<"
        LessEq => "<="
        Greater => ">"
        GreaterEq => ">="
        Equal => "=="
        NotEqual => "!="
        AndAlso => "&&"
        OrElse => "||"
        BitAnd => "&"
        BitOr => "|"
        BitXor => "^"
        ShiftLeft => "<<"
        ShiftRight => ">>"
        Range => ice("emit_c: a range reached expression emission -- for-heads consume it")
    }
}

/// Does this operator emit as a C INFIX operator inside a truth-value cast?
/// Comparisons, equality and the logical pair all yield bool and share the
/// same C shape; the bitwise family is infix too but keeps int width, so it
/// is a third answer rather than a second.
fn is_truth_infix(op BinOp) -> bool {
    match op {
        Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse => true
        Add | Sub | Mul | Div | Modulo | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// Is this form WRITTEN as a call `f(a, b)` rather than infix `a f b`?
///
/// One rule, two callers -- the binary expression and the compound
/// assignment. They had drifted: the compound path passed `is_float: false`
/// unconditionally, so `f += 0.25` on doubles emitted `nova_int_checked_add`,
/// the C still compiled, and the ANSWER came out wrong (found 2026-08-17,
/// prompted by the integrator's warning that a compound assignment has its
/// own emission path -- they had been caught by the same shape the same day).
fn is_call_form(op BinOp, is_float bool) -> bool {
    match op {
        // Integer arithmetic goes through the runtime's checked helpers;
        // float arithmetic is raw C -- except the remainder, which is fmod.
        Add | Sub | Mul | Div => !is_float
        Modulo => true
        Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse => false
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => false
        Range => ice("emit_c: a range has no binary form -- for-heads consume it")
    }
}


/// `!=` is not a second protocol method: the spec DERIVES it from `@equal`
/// (D46 rule 3), so the emitter negates the same call.
fn op_is_not_equal(op BinOp) -> bool {
    match op {
        NotEqual => true
        Equal | Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// Plain C infix with no cast: the bitwise and shift family on int.
fn is_bit_infix(op BinOp) -> bool {
    match op {
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => true
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse | Range => false
    }
}

/// The C form of a prefix operator. `!` is logical on bool, `-` negates,
/// `~` complements -- all three are plain C on the primitives the subset
/// admits (check refuses the protocol cases).
fn c_unary_form(op UnOp) -> str {
    match op {
        Not => "!"
        Negate => "-"
        BitNot => "~"
    }
}

/// Is this operator a comparison? Derived from the decision (P22: derived is
/// a function, not a second table), and exhaustive so a new operator must
/// answer here too.


/// A call's arguments, in SLOT order, with omitted slots filled from the
/// declaration.
///
/// ONE door for both call forms. `from` is the child where the written arguments
/// begin (1 for a free call, 3 for a method call); `recv_slot` says that
/// argument zero is the RECEIVER and lives at `kids[0]` rather than in that
/// range. The row is the callee's, and it is asked only when a slot was left to
/// its default -- a variant's payload has none, so it may arrive as `no_row()`.
fn Emitter mut @emit_bound_args(kids []Node, from int, recv_slot bool,
                                id NodeId, row FnRow) -> () {
    ro slots = @out.callee_slots_of(id)
    mut first = true
    for s in 0..slots.len() {
        @body.append(if first { "" } else { ", " })
        first = false
        ro at = slots[s].arg_row
        // THE DECLARED CONVERSION, when the checker recorded one (D429 R7): the
        // emission is a call to the method the program NAMED, never a cast and
        // never a conversion of our own invention. `#coerce fn str consume
        // @to_bytes() -> Bytes` becomes exactly that method's C name around the
        // argument.
        ro wrap = raw_row(slots[s].via_row) >= 0
        if wrap {
            @body.append("${c_callable(@ctx, slots[s].via_row, no_subst())}(")
        } else {
            // The type matches as written: nothing stands around the value.
        }
        if at < 0 {
            @emit_slot_default(row, s)
        } else if recv_slot && at == 0 {
            @emit_expr(kids[0])
        } else {
            @emit_expr(call_arg_at(kids, from, if recv_slot { at - 1 } else { at }))
        }
        if wrap {
            @body.append(")")
        } else {
            // Nothing was opened.
        }
    }
}

/// The DEFAULT of a slot the call omitted, emitted AT THE CALL SITE -- which is
/// what D102 means by "evaluated at the call site, each call anew".
///
/// An absent default here is not a user mistake but a broken channel: the
/// checker recorded -1 for a slot whose declaration writes nothing, and emitting
/// anything at all would invent a value. So it ices.
fn Emitter mut @emit_slot_default(row FnRow, s int) -> () {
    if raw_row(row) < 0 {
        ice("emit_c: a call with no callable row left a slot to a default")
    } else {
        // A callable row: its declaration is what says the value.
    }
    ro fd = @ctx.fns.rows[raw_row(row)]
    match slot_default_of(@ctx.fns.params, fd.param_off, s) {
        Some(d) => @emit_expr(d)
        None => ice("emit_c: a call left a slot to a default its declaration does not write")
    }
}

/// The CALLABLE row a decision names, or `no_row()` when it names something
/// else -- a variant or a type. The emission of the arguments is the same for
/// all three; only a DEFAULT needs the row, and only a callable has one.
#realtime nogc
fn callee_row_or_none(cr CalleeRef) -> FnRow {
    match cr.target {
        CalleeFn(row) => row
        CalleeVariant(_) => no_row()
        CalleeCtor(_) => no_row()
    }
}

/// Emit one expression: literals, names, fields, method/fn calls, binary ops.
fn Emitter mut @emit_expr(e Node) -> () {
    ro k = e.kind_of()
    if k == NodeKind.Lit {
        ro lkids = branch_children(e)
        ro t = lkids[lkids.len() - 1]
        ro neg = lkids.len() > 1 // [Minus, lit]
        ro lk = leaf_kind(t)
        if lk == TokenKind.IntLit {
            @body.append("((nova_int)")
            @body.append(if neg { "-" } else { "" })
            @body.append(int_literal_c_text(leaf_text(t)))
            @body.append("LL)")
        } else if lk == TokenKind.FloatLit {
            @body.append("((nova_f64)")
            @body.append(if neg { "-" } else { "" })
            @body.append(leaf_text(t))
            @body.append(")")
        } else if lk == TokenKind.StrLit {
            // A string literal in value position (binding init, method
            // argument): registered like a println literal, referenced by
            // its C name — the oracle emits the same shape.
            ro idx = @lits.len()
            @lits.push(leaf_text(t))
            @body.append("_novac_strlit_${idx}")
        } else {
            ice("emit_c: literal kind outside the subset")
        }
    } else if k == NodeKind.ArrayLit {
        // Printed as the TEMPORARY its hoist built (wave B8): the literal is
        // a multi-statement construction, and the statement that owns this
        // expression hoisted it before printing. An empty name here is a
        // hole in that contract, not a user mistake.
        ro tmp = @lit_tmp[raw_node(e.id_of())]
        if tmp == "" {
            ice("emit: an array literal in expression position was never hoisted (wave B8)")
        } else {
            // Hoisted: the temporary carries the built vector.
        }
        @body.append(tmp)
    } else if k == NodeKind.TupleExpr {
        // The same contract as the literals above (B15 step 4a): a tuple is a
        // multi-statement build, so what stands in the expression is the
        // temporary its hoist filled.
        ro ttmp = @lit_tmp[raw_node(e.id_of())]
        if ttmp == "" {
            ice("emit: a tuple literal in expression position was never hoisted (B15 step 4a)")
        } else {
            // Hoisted: the temporary carries the built pair.
        }
        @body.append(ttmp)
    } else if k == NodeKind.RecordCtor {
        // The same contract as the array literal above, and for the same
        // reason (wave B13): a constructor is built by several C statements,
        // so what stands in the expression is the temporary the hoist filled.
        ro rtmp = @lit_tmp[raw_node(e.id_of())]
        if rtmp == "" {
            ice("emit: a record constructor in expression position was never hoisted (wave B13)")
        } else {
            // Hoisted: the temporary carries the built record.
        }
        @body.append(rtmp)
    } else if k == NodeKind.Name {
        // A CONSTANT IS SUBSTITUTED, not referenced (274.5 wave B2): it has no
        // C symbol of its own, and WHICH constant this is came from the
        // channel -- the emitter resolves no names (274.4 rule E).
        match @out.const_of(e.id_of()) {
            Some(row) => {
                ro cd = @ctx.consts.rows[raw_crow(row)]
                if cd.init.len() > 0 {
                    @emit_expr(cd.init[0])
                } else {
                    ice("emit: a constant recorded with no initializer")
                }
            }
            None => {
                if @out.has_callee(e.id_of()) {
                    // A payload-less variant as a value (the variant-value
                    // wave): the checker resolved the bare name to its
                    // variant row; the maker is the oracle's own spelling.
                    match @out.callee_of(e.id_of()).target {
                        CalleeVariant(v) => @body.append("${c_maker(@ctx, v)}()")
                        CalleeFn(_) | CalleeCtor(_) => ice("emit: a bare name resolved to a non-variant callee")
                    }
                } else {
                    // Not a constant: an ordinary name, and `nova_bool` IS C
                    // `bool`, so the literals are the C keywords -- the same
                    // shape the oracle emits.
                    @body.append(expr_leaf_name(e))
                }
            }
        }
    } else if k == NodeKind.SelfField {
        // `@field` is a field of the receiver, and the receiver is parameter
        // zero under our own name. A record is a GC pointer, so the access is
        // `->` exactly like any other field access -- one shape, not two.
        ro kids = branch_children(e)
        @body.append("(${RECV_C_NAME}->")
        @body.append(leaf_text(kids[1]))
        @body.append(")")
    } else if k == NodeKind.FieldAccess {
        // `Sum.Variant` as a VALUE (the variant-value wave): the checker
        // wrote the variant row on THIS node; nothing here is a field read.
        if @out.has_callee(e.id_of()) {
            match @out.callee_of(e.id_of()).target {
                CalleeVariant(v) => {
                    @body.append("${c_maker(@ctx, v)}()")
                    return
                }
                CalleeFn(_) | CalleeCtor(_) => ice("emit: a field access resolved to a non-variant callee")
            }
        } else {
            // An ordinary field access: the shapes below own it.
        }
        ro kids = branch_children(e)
        // A TUPLE projection prints `.fN` (D123 named-field codegen): the
        // owner is a by-value mono struct, so the dot is not a choice here
        // the way it is for records below.
        if is_tuple(@ctx, @out.type_if_known(kids[0].id_of())) {
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(".f")
            @body.append(leaf_text(kids[2]))
            @body.append(")")
            return
        }
        @body.append("(")
        @emit_expr(kids[0])
        // A VALUE record is reached with `.`, a GC pointer with `->`. The
        // operand's TYPE decides, and it comes from the channel: after the
        // checker, nobody infers. A position the channel has no answer for
        // keeps the pointer form, which is what every record was before the
        // layout existed.
        @body.append(if is_value_record(@ctx, @out.type_if_known(kids[0].id_of())) { "." } else { "->" })
        @body.append(leaf_text(kids[2]))
        @body.append(")")
    } else if k == NodeKind.MethodCall {
        // kids: [recv, '.', name, '(', args..., ')'] -> <Recv>_method_<name>(recv, args...)
        // The C receiver prefix follows the oracle's mono naming: str ->
        // Nova_str_method_, []int -> Vec____nova_int_method_.
        ro kids = branch_children(e)
        // The ROW the checker decided on, not a name rebuilt from the receiver's
        // type: after the checker, nobody infers.
        ro cr = @out.callee_of(e.id_of())
        // The SUBSTITUTION comes from the same record as the row: one question
        // ("which instance does this call name"), one read. An ordinary call
        // carries an empty one, so there is no branch here to get wrong.
        if @ctx.fns.compiles_body(cr.callable_row()) {
            @body.append(c_callable(@ctx, cr.callable_row(), @out.callee_subst_of(e.id_of())))
        } else {
            // INTEROP (sub-plan L2): a method row with no body of ours is an
            // instance method the SHELL emits, named by the receiver's
            // instance -- `Vec____nova_int_method_len`; the checker admitted
            // it against the lifted surface. Goes the day novac emits the
            // whole prelude.
            @body.append(c_instance_method(@ctx, @out.type_of(kids[0].id_of()), leaf_text(kids[2])))
        }
        @body.append("(")
        // The receiver is parameter ZERO (plan 273), so it is slot zero of the
        // recorded binding -- not a special case bolted onto the front. The
        // written arguments start at child 3 (receiver, dot, name).
        @emit_bound_args(kids, 3, true, e.id_of(), cr.callable_row())
        @body.append(")")
    } else if k == NodeKind.Call {
        ro kids = branch_children(e)
        // THE ROW THE CHECKER DECIDED ON, exactly as the MethodCall branch
        // above: after the checker, nobody infers. This branch used to ask
        // `defs` by the bare NAME instead -- a registry that lives by
        // last-write-wins -- so with two candidates the emission named a
        // different row than the one check had resolved. Measured 2026-08-20:
        // `byte_len("abc")` was recorded against `str @byte_len()` and emitted
        // as the file's two-parameter `byte_len`, one string argument and all.
        ro cr = @out.callee_of(e.id_of())
        // The target CARRIES its row, so each arm reads a row of its own
        // space: `c_maker` gets a variant row, `c_callable` a callable row, and
        // neither can be handed the other's (owner's question 2026-08-21 --
        // "why is `target_row` not `FnRow`": because it was three spaces in one
        // int, and the answer is a sum, not a wrapper).
        match cr.target {
            CalleeVariant(v) => @body.append("${c_maker(@ctx, v)}(")
            CalleeFn(row) => @body.append("${c_callable(@ctx, row, @out.callee_subst_of(e.id_of()))}(")
            // A TYPE in call position CONSTRUCTS a newtype, and a newtype IS
            // its representation at runtime -- zero cost, D-newtype. So the
            // emission is the ARGUMENT and nothing else: no wrapper, no cast
            // (C needs none between a typedef and its underlying type). The
            // oracle writes a redundant cast here; the shape of our emission is
            // ours (274 section 7.0) as long as the behaviour is identical.
            CalleeCtor(_) => {
                for c in kids {
                    if !is_expr_kind(c.kind_of()) { continue }
                    @emit_expr(c)
                }
                return
            }
        }
        // BY THE RECORDED BINDING, never by written order (wave 4, D102): a
        // named argument may stand anywhere among the named ones, and an omitted
        // one is filled from the declaration. Which argument means which
        // parameter is the CHECKER's decision, and this reads it.
        @emit_bound_args(kids, 1, false, e.id_of(), callee_row_or_none(cr))
        @body.append(")")
    } else if k == NodeKind.Cast {
        // Unwrapping a newtype is FREE: the value is already the
        // representation, so the emission is the operand and nothing else. C
        // needs no cast between a typedef and its underlying type.
        @emit_expr(branch_children(e)[0])
    } else if k == NodeKind.Paren {
        @body.append("(")
        @emit_expr(branch_children(e)[1])
        @body.append(")")
    } else if k == NodeKind.Unary {
        ro kids = branch_children(e)
        // INT NEGATION GOES THROUGH THE CHECKED HELPER (hunt emit_c x K1, H3):
        // `-INT_MIN` does not fit, the oracle panics ("negation overflow"),
        // and the raw C form printed INT_MIN back in silence -- in the same
        // file where addition two doors up goes through `nova_int_checked_add`.
        // The node's type is the checker's answer, recorded when the unary was
        // typed; the CARRIER decides, exactly as in the compound form (H5) --
        // a newtype negates as what it holds.
        ro uk = un_op_of(leaf_kind(kids[0]))
        ro neg_int = match uk {
            Negate => carrier_of(@ctx, @out.type_of(e.id_of())) == @ctx.prims.int_id
            Not | BitNot => false
        }
        if neg_int {
            @body.append("nova_int_checked_neg(")
            @emit_expr(kids[1])
            @body.append(")")
        } else {
            @body.append("(")
            @body.append(c_unary_form(uk))
            @body.append("(")
            @emit_expr(kids[1])
            @body.append("))")
        }
    } else if k == NodeKind.Bin {
        ro kids = branch_children(e)
        ro op = bin_op_of(leaf_kind(kids[1]))
        // Reading the EXPRESSION's recorded type IS reading the operands':
        // only ARITHMETIC branches on the float test (comparisons come out as
        // C operators whatever the flag says -- c_binary_form), and
        // arithmetic's result type equals its operands'. The hunt (emit_c x
        // K1, P1) read the previous wording here as a promise to look at the
        // operand and found the code reading the node: the code was right,
        // the words were not.
        ro is_float = @out.type_of(e.id_of()) == @ctx.prims.f64_id
        ro form = c_binary_form(op, is_float)
        // `str` equality is the protocol method, not a C operator (D46:
        // `a == b` is `a.@equal(b)`), and `!=` is DERIVED from it — the spec
        // states the derivation, so novac spells it the same way instead of
        // inventing a second method name (owner's reminder 2026-08-16).
        // WHICH CALLABLE is the CHECKER's decision, and it is
        // in the channel (274.4 §1). Until 2026-08-28 the
        // emitter resolved the `equal` method here itself: the
        // only resolution outside `check/` and a SECOND DOOR to
        // one root -- on an ambiguous overload the checker
        // refuses by name while this branch silently took the
        // first candidate. Now the PRESENCE of a callee is the
        // decision: recorded for an operator that dispatches,
        // absent where a primitive C form comes out.
        if @out.has_callee(e.id_of()) {
            ro row = @out.callee_of(e.id_of()).callable_row()
            @body.append("((nova_int)(")
            @body.append(if op_is_not_equal(op) { "!" } else { "" })
            // NAMED BY WHOEVER HAS THE BODY. `str.equal` is std's, and novac
            // compiles no std bodies — so the definition lives in the SHELL and
            // must be called by the shell's name. Until 2026-08-28 this branch
            // printed `c_callable`, i.e. OUR `novac_fn_equal__...`, and the link
            // failed on an undefined symbol; nobody saw it because not one file
            // of the corpus that novac accepts compares strings (measured).
            if @ctx.fns.compiles_body(row) {
                @body.append(c_callable(@ctx, row, no_subst()))
            } else {
                @body.append(c_shell_method(@ctx, @out.type_of(kids[0].id_of()), EQUAL_METHOD))
            }
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(")))")
        } else if is_bit_infix(op) {
            @body.append("((")
            @emit_expr(kids[0])
            @body.append(") ")
            @body.append(form)
            @body.append(" (")
            @emit_expr(kids[2])
            @body.append("))")
        } else if is_truth_infix(op) {
            @body.append("((nova_int)((")
            @emit_expr(kids[0])
            @body.append(") ")
            @body.append(form)
            @body.append(" (")
            @emit_expr(kids[2])
            @body.append(")))")
        } else if !is_call_form(op, is_float) {
            // f64 arithmetic is RAW C with left-assoc parens -- the oracle's
            // shape: ((((nova_f64)3.14) * r) * r).
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(" ")
            @body.append(form)
            @body.append(" ")
            @emit_expr(kids[2])
            @body.append(")")
        } else {
            @body.append(form)
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(")")
        }
    } else {
        ice("emit: expression kind outside the subset")
    }
}

/// Emit a CALL STATEMENT. The subset knows exactly one callee here,
/// `println`, and check refuses the rest — the ice below is the second
/// floor, not the first answer (owner's question 2026-08-16: the name
/// `emit_println` read as if every Call were a println).
/// One printer per argument by its type, then a newline.
fn Emitter mut @emit_call_stmt(call Node) -> () {
    ro kids = branch_children(call)
    if call_callee_text(kids) != PRINT_FN {
        // A CALL WHOSE RESULT IS DISCARDED (wave B12). Emitting a call as a
        // VALUE is something this file already does; a statement is that plus a
        // semicolon and nothing more -- no temporary is declared, because
        // nobody asked this call for an answer.
        //
        // Measured with the oracle BEFORE it was written: discarding a result
        // is legal there and silent, so warning about it here would be our
        // invention rather than the language's rule.
        @hoist_array_lits(call)
        @body.append("    ")
        @emit_expr(call)
        @body.append(";\n")
        return
    } else {
        // `println` is not an ordinary call: every argument goes to its own
        // printer and the newline comes once, at the end. That is the path
        // below, and it is why this door exists at all.
    }
    // EACH ARGUMENT IS HOISTED RIGHT BEFORE ITS OWN PRINT LINE (hunt
    // emit_c x K1, finding H1). Hoisting the whole call up front ran a
    // constructor argument's effects AHEAD of its neighbours' prints: the
    // oracle prints `head` then ticks, novac ticked first. println is the one
    // place where output interleaves with argument effects, so the order of
    // the two IS the observable.
    for c in kids {
        ro ck = c.kind_of()
        if is_expr_kind(ck) {
            @hoist_array_lits(c)
        } else {
            // Punctuation and the callee leaf hoist nothing.
        }
        if ck == NodeKind.Lit && leaf_kind(branch_children(c)[0]) == TokenKind.StrLit {
            ro t = branch_children(c)[0]
            ro idx = @lits.len()
            @lits.push(leaf_text(t))
            @body.append("    nova_print_str(_novac_strlit_${idx});\n")
        } else if is_expr_kind(ck) {
            // Dispatch on the registry — the oracle prints each argument
            // with its own printer, newline once at the end.
            // The CARRIER, not the declared type: a newtype prints as what it
            // holds, and the channel keeps the declared type because that is
            // what resolution needs. Two questions, two doors.
            ro at = carrier_of(@ctx, @out.type_of(c.id_of()))
            if at == @ctx.prims.str_id {
                @body.append("    nova_print_str(")
            } else if at == @ctx.prims.bool_id {
                @body.append("    nova_print_bool(")
            } else if at == @ctx.prims.f64_id {
                @body.append("    nova_print_f64(")
            } else if at == @ctx.prims.int_id {
                @body.append("    nova_print_int(")
            } else {
                // Found by the generics scouting 2026-08-16: this used to be a
                // bare `else` printing anything unknown AS AN INT — a record
                // would have had its GC pointer printed as a number, in
                // silence. The set of types is open, so there is no exhaustive
                // match to write; the honest form is to name every case we
                // handle and refuse the rest. The first floor (a check-level
                // refusal) arrives with local typing, 274.3 wave 3 / C9.
                ice("emit_c: println of a type with no printer in the subset")
            }
            @emit_expr(c)
            @body.append(");\n")
        } else {
            match c {
                Leaf(_) => {
                    // The callee leaf and the parenthesis leaves are not
                    // arguments; the callee itself was already refused or
                    // accepted by name above.
                }
                Branch { .. } => {
                    // The checker refuses every branch it cannot type in an
                    // argument position (#870), so a branch here is a broken
                    // invariant, not a shape to skip -- the silent fallout
                    // this arm replaces printed `ab` for `a20b`.
                    ice("emit_c: an argument form the checker let through (#870)")
                }
            }
        }
    }
    @body.append("    nova_print_newline();\n")
}
