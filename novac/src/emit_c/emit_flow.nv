// The control-flow statements as STRUCTURED TERMINATORS of the lowered body
// (sub-plan 274.8, wave M2b-1): `if` / `else if` / `else`, `while`, the range
// `for` and `return` open and close blocks through the builder's events, and
// the C is printed AT THE SAME EVENTS -- the streaming bridge of M1/M2a moved
// from statements to terminators, so the C stays byte-identical while the
// body becomes a real graph (entry, branches, join, header, body, exit).
//
// Donor: rustc MIR building (`rustc_mir_build::build::expr::into` for `if`,
// `build::scope` for loops): a fresh block per branch, one join, a loop
// header with its own block. The FORM of the terminators is WebAssembly's
// structured control flow (`if`/`loop`/`block` with named exits), because
// the printer targets structural C and must not rediscover the structure
// from a flat graph (plan 274.8 section 2a).
// Role: layer emit_c -- the PRINTING of control flow, and nothing else. All eight
//   functions here are `print_*` on Emitter; the lowering that used to share this
//   file left for lower/lowering.nv with the M3 move, and the file became a pure
//   printer by SUBTRACTION rather than by rewriting -- which is the clearest
//   evidence the move cut where the seam actually was.
// Used by: emit_c.nv (`@print_body`, from `emit_callable`), nothing else. The
//   lowering does NOT call in here: it raises builder events (`@ir.begin_if`),
//   and the printer walks the finished body afterwards. lowering.nv names
//   `@print_if_head` in a comment only -- an edge would break the M3 criterion
//   and redden check-novac-deps.
// Guarded by: check-novac-differential.sh, the corpus C diff of the wave,
//   lower_test.nv (the graph shapes), check-novac-lowering-one-door.py.
//
// ORDER OF PRINT AND EVENT, and why it is this way: a condition is PRINTED
// before the branch it guards is opened, so that whatever its printing still
// lowers at print time (a `??` inside it, until M2b-2 lowers nested value
// positions ahead of print) is recorded in the block the test runs in, not
// in the branch taken. For an `else if` the else branch is opened FIRST, then
// the condition printed, then the chained `if` opened -- same reason.

module novac.emit_c

import ../tree.{Node, NodeKind}
import ../diag.{ice}
import ../sem.{branch_children, leaf_text, c_instance_method, for_head_elem}
// The walk prints a unit return from the type of the return place (2026-09-09).
import ../sem.{is_unit_ty}
import ../types.{is_ty}
import ../lower.{IfCtx, LoopHead, RangeHead, EachHead, Cond, Fn, Stmt, BlockId, SwitchTerm, no_block, raw_block}
import ../builtins.{VEC_LEN_METHOD}

/// Whether this branch continues a `} else ` line its caller printed.
fn chained_of(outer Option[IfCtx]) -> bool {
    match outer {
        None => false
        Some(_) => true
    }
}

/// THE HEAD OF A BRANCH, printed from the IR (wave M2b-2 step 3a): `if (<cond>) {`.
///
/// ONE printer for the plain `if` and for the `if let`. What differs between those two is
/// the `Cond` the lowering RECORDED, not the printing -- until this step each spelled its
/// own head, and the two could drift the way the two `else` tails did (registry #991).
/// A chained branch carries no indent of its own: it continues the `} else ` its caller
/// printed (M2b-2-0).
fn Emitter mut @print_if_head(cond Cond, chained bool) -> () {
    if chained {
        @body.append("if (")
    } else {
        @body.append("    if (")
    }
    match cond {
        Expr(e) => @emit_expr(e)
        IsSome(l) => {
            // The Some-test through the ONE Option door, spelled from the local's type
            // and name -- the same two the hand-written head passed by hand.
            ro d = @lo.ir.decl_of(l)
            @body.append(@option_some_test(d.ty, d.name))
        }
    }
    @body.append(") {\n")
}


/// THE HEAD OF A LOOP, printed from the IR (wave M2b-2 step 3a): one printer for all three
/// loop forms, because what differs between them is the `LoopHead` the lowering RECORDED,
/// not the printing. Until this step three functions spelled three heads, each reading the
/// tree; the walk that comes next needs one door that reads the record.
///
/// INTEROP, named as such: the element walk spells the shell's `len` of the collection's
/// instance -- it goes the day novac emits the whole prelude (emit_option.nv carries the
/// same note for the Option ABI).
fn Emitter mut @print_loop_head(head LoopHead) -> () {
    match head {
        While(e) => {
            @body.append("    while (")
            @emit_expr(e)
            @body.append(") {\n")
        }
        Range(r) => {
            ro v = @lo.ir.decl_of(r.var).name
            @body.append("    for (nova_int ${v} = ")
            @emit_expr(r.lo)
            @body.append("; ${v} < ")
            @emit_expr(r.hi)
            @body.append("; ${v}++) {\n")
        }
        Each(e) => {
            ro vd = @lo.ir.decl_of(e.vec)
            ro i = @lo.ir.decl_of(e.idx).name
            ro len_c = c_instance_method(@ctx, vd.ty, VEC_LEN_METHOD)
            @body.append("    for (nova_int ${i} = 0; ${i} < ${len_c}(${vd.name}); ${i}++) {\n")
        }
    }
}


// ---- THE WALK OVER SEALED BLOCKS (wave M2b-2, step 3b) ---------------------
//
// Printing is no longer tied to the order of BUILDING: the body is printed by ONE pass over
// the `Fn` that `@lo.ir.finish()` handed back. Structural terminators (M2b-1) were chosen for
// exactly this -- `If`/`Loop`/`Switch` carry their own blocks and ONE join -- so the walk
// stays structural and needs neither graph analysis nor C labels.
//
// The print doors it walks against:
//   @print_if_head(cond, chained)     -- the head of a branch: if, if let, an arm's guard
//   @print_loop_head(head)            -- the head of a loop: While, Range, Each
//   @print_arm_head(uniq, pat, scr)   -- the head of a match arm
//   @emit_decl / @emit_assign / @emit_eval / @emit_store / @emit_output -- the statement door
//
// WHAT THE WALK DOES NOT DO, and this is the convention rather than taste (architecture,
// section 3): it does not decide what the lowering decided. Missing data for printing means a
// FIELD on the terminator, never a computation here -- `IfTerm.els_braced` and
// `SwitchTerm.uniq` exist for that reason.
//
// WHY `chained` IS A PARAMETER AND NOT A FIELD (correction of 2026-09-08, after a wrong shape
// in step 3a). A field recorded `opened as a chain`, and printing may NOT follow that fact: a
// chained `if` and a chained `if let` open through one door, but the first continues the
// `} else ` line while the second stands in braces (C has no `else <declaration>`). What
// decides the print is the `els_braced` bit of the OUTER branch; whether a head continues a
// line is the state of the WALK at the moment of recursion -- a parameter. A field would have
// had to describe an inner `if` by what it turned out to be from the outside.
//
// EXHAUSTIVE MATCH WITHOUT `_` -- convention P21.3, held by check-novac-no-default-branch.py.
// That is why `Unreached` gets an explicit `ice` instead of a silent arm.



// ---- THE ENTRY POINT: it replaces the interleaving `emit_callable` used to do ----
// Before step 3b, `emit_callable` printed the body AS IT WENT and called `@lo.ir.finish()` at
// the end only to check the graph's integrity. The order is now the reverse: `finish` first,
// then ONE walk over what it returned.
fn Emitter mut @print_body(f Fn) -> () {
    // MARKING BLOCKS AS PRINTED removes TWO invariants of this section at once -- `every
    // block exactly once` and `the walk terminates` -- which is why it stands here rather
    // than being left for later. The technique is this compiler's own, from `mono/mono.nv`:
    // a `seen []bool` indexed alongside the table, built by the same loop and carried
    // through recursion as a PARAMETER. A field on `Emitter` would be worse: it would have
    // to be reset for every body, trading two invariants for one new one.
    mut printed = []bool.new()
    for _ in 0..f.blocks.len() {
        printed.push(false)
    }
    @print_chain(f, BlockId(0), no_block(), false, printed)
}
// ---- The chain of blocks from `at` up to `stop`, `stop` excluded ----
// `stop` = `no_block()` means `to the end of the body`: that is how the root chain prints,
// the one whose last block carries a `Return`.
// `head_continues` is true for EXACTLY the first block of an unbraced `else` branch: its head
// continues the `} else ` line the caller printed, so it carries no indent. Further along the
// chain it goes out -- a second head already starts its own line.
fn Emitter mut @print_chain(f Fn, at BlockId, stop BlockId, head_continues bool,
                            mut printed []bool) -> () {
    mut continues = head_continues
    mut cur = at
    while cur != stop {
        ro bi = raw_block(cur)
        // THE INDEX IS UNWRAPPED BEFORE USE, as it is everywhere in `mono.nv`: a newtype
        // and its carrier share a representation, so the C would swallow an unwrapped one
        // too -- and there that stayed silent until 2026-09-05 (registry #894/#921).
        if bi < 0 || bi >= printed.len() {
            ice("emit: the walk reached a block outside the body's table")
        }
        if printed[bi] {
            // RE-ENTRY. Two cases, and both are a broken invariant rather than a shape of
            // the program: either a join was printed twice (a branch failed to stop at it),
            // or the graph holds a cycle of `Goto`s. Without this check the first would
            // surface as doubled C and the second as a HANG -- a timeout, which the gate
            // cannot tell from a failed assertion.
            ice("emit: the walk entered a block twice")
        }
        printed[bi] = true
        ro b = f.blocks[bi]
        for s in b.stmts {
            @print_stmt(s)
        }
        match b.term {
            Return => {
                // A VALUE return is printed by the statement door: the value already sits
                // in local 0 and its assignment was printed as `return <expr>;`
                // (`emit_assign_head`, the `Return` arm). A UNIT return has no such
                // assignment -- there is no value to place -- so it is printed HERE, from
                // the type of the return place (`Fn` says `locals[0]` is that place).
                //
                // Asking the type is a NAME LOOKUP, not a decision about form: `NOVA_UNIT`
                // is the C spelling of the unit value. And one place printing it closes
                // two holes at once -- the bare `return` that used to print during
                // lowering and land above the body, and the unit function whose block body
                // simply ends and got no trailing return at all.
                // NO VALUE TO RETURN comes in TWO shapes, and both must be named: the return
                // place's type is the unit type, OR there is no type at all. The second is the
                // entry point -- `emit_c.nv` says it in its own words, `ret_id is -1 for main
                // only` -- so a test for the unit type alone left `main` with no return at all
                // (measured 2026-09-09 by emission, after the first edition of this fix).
                ro rt = f.locals[0].ty
                if !is_ty(rt) || is_unit_ty(@ctx, rt) {
                    @body.append("    return NOVA_UNIT;\n")
                } else {
                    // The assignment to the return place already printed the return.
                }
                return
            }
            // A BACK EDGE ENDS THE CHAIN rather than continuing it (measured 2026-09-09 on
            // the graph of `examples/basics/for_name_head.nv`: `b1=Loop(body=2,exit=3)`,
            // `b2=Goto(1)`). The draft's premise -- `the body-to-head edge is structural and
            // is NOT recorded` -- was WRONG: the builder does record it. The walk followed it
            // back into the header and entered it a second time; the printed-blocks marking
            // caught that, which is what it exists for.
            //
            // The rule is general rather than a patch for loops: a `Goto` into an ALREADY
            // PRINTED block is a return edge (body to head), and in C the loop's closing
            // brace prints it, not the walk. A `Goto` into a join never arrives here: a join
            // prints AFTER the branches, and a branch already ends at `stop`. The check is
            // free -- the `printed` set is already there.
            //
            // The assignment in an arm's body IS PARENTHESISED: without the braces the parser
            // reads `= next` as the start of the NEXT arm and refuses (D452,
            // `E_MATCH_ARM_SEP_MISSING`). The shape is taken from the tree (`Leaf(t) => { e =
            // ... }` in `check/`), not invented.
            Goto(next) => {
                ro ni = raw_block(next)
                if ni >= 0 && ni < printed.len() && printed[ni] {
                    return
                }
                cur = next
            }
            If(t) => {
                @print_if_head(t.cond, continues)
                continues = false
                @print_chain(f, t.then, t.join, false, printed)
                if t.els == t.join {
                    // There was no `else` branch: the `els` block IS the join.
                    @body.append("    }\n")
                } else {
                    @body.append("    } else ")
                    if t.els_braced {
                        // A block tail or an `if let` tail: its own pair of braces.
                        @body.append("{\n")
                        @print_chain(f, t.els, t.join, false, printed)
                        @body.append("    }\n")
                    } else {
                        // An `if` chain tail: its head continues this very line.
                        @print_chain(f, t.els, t.join, true, printed)
                    }
                }
                cur = t.join
            }
            Loop(t) => {
                @print_loop_head(t.head)
                @print_chain(f, t.body, t.exit, false, printed)
                @body.append("    }\n")
                cur = t.exit
            }
            Switch(t) => {
                @print_switch(f, t, printed)
                cur = t.join
            }
            Unreached => ice("emit: an unsealed block reached the printer")
        }
    }
}
// THE `else` TAIL IS HANDLED ABOVE; THERE IS NO SEPARATE FUNCTION FOR IT. The first
// edition had `@print_else` and `@term_is_chained_if` here, the latter with an exhaustive
// match over six kinds of terminator just to learn whether the else branch held a chain.
// Both are gone: the `els_braced` bit of the outer branch answers the same question
// without any inspection, and `does the head continue a line` became a parameter of the
// walk. Correcting the prerequisite removed not only a field but a whole function.
// ---- `match`: the flag is the PRINTER'S, first-match is the terminator's meaning ----
// `SwitchTerm` says so about itself in `lower/ir.nv`: "FIRST-MATCH IS THE TERMINATOR'S
// MEANING: the C printer emulates it with an if-chain and a `matched` flag, and that flag
// is the printer's, not the form's". So the walk raises and clears that flag, not the
// lowering.
//
// `uniq` comes from a FIELD of the terminator. Rebuilding the scrutinee local's name from a
// string would be the `decide it twice` the convention forbids.
// ---- A block's statements WITHOUT following its terminator ----
// Exactly one place needs this: an arm with a guard, where the binders print BEFORE the
// guard's head while the head itself comes from the terminator of that same block. A door
// of its own rather than a flag on `@print_chain`: a `follow the terminator?` flag would
// have to be read in the loop for every block, and it would become a second way to answer
// what `stop` already answers.
//
// The block IS MARKED printed right here: otherwise the walk, reaching it by another path,
// would print its statements a second time -- which is what the marking exists to stop.
fn Emitter mut @print_block_stmts(f Fn, b BlockId, mut printed []bool) -> () {
    ro bi = raw_block(b)
    if bi < 0 || bi >= printed.len() {
        ice("emit: an arm block outside the body's table")
    }
    if printed[bi] {
        ice("emit: the walk entered a block twice (arm statements)")
    }
    printed[bi] = true
    for s in f.blocks[bi].stmts {
        @print_stmt(s)
    }
}
fn Emitter mut @print_switch(f Fn, t SwitchTerm, mut printed []bool) -> () {
    ro sd = @lo.ir.decl_of(t.scrutinee)
    @body.append("    int _novac_matched_t${t.uniq} = 0;\n")
    for a in t.arms {
        // THE LOCAL, NOT ITS TYPE (M2c): the door asks the record itself, for both the name
        // and the type. Passing `sd.ty` would mean carrying a key beside the very subject it
        // was taken from.
        @print_arm_head(t.uniq, a.pat, t.scrutinee)
        // A GUARD IS PRINTED HERE AND NOT BY THE GENERAL WALK, and the reason is not
        // convenience (correction of 2026-09-09, after a measurement retired the previous
        // attempt). `SwitchArm.body` is documented word for word -- "binders first, then the
        // body" -- and the BOUNDARY between the binders and the body is held by the guard's
        // `If` terminator: binders in the arm's block, body in the then-branch.
        //
        // The general walk would print the guard's head structurally and `print_switch` would
        // print it again from the field; and the terminator cannot simply be dropped, because
        // then the boundary disappears and a binder lands AFTER the guard that reads it
        // (measured: such C does not compile).
        //
        // So: the arm block's statements print WITHOUT its terminator, the guard's head comes
        // from the terminator, the then-branch goes through the walk, and the flag is set
        // where it alone can be -- inside the then-branch. The flag is the PRINTER'S property
        // (`SwitchTerm` says so), and the printer may know where it goes; what it may not do
        // is decide the FORM, and the form is still dictated by the record.
        match a.guard {
            Some(_) => {
                @print_block_stmts(f, a.body, printed)
                match f.blocks[raw_block(a.body)].term {
                    If(gt) => {
                        @print_if_head(gt.cond, false)
                        @print_chain(f, gt.then, gt.join, false, printed)
                        @body.append("    _novac_matched_t${t.uniq} = 1;\n    }\n")
                    }
                    Return => ice("emit: a guarded arm whose block does not branch")
                    Goto(_) => ice("emit: a guarded arm whose block does not branch")
                    Loop(_) => ice("emit: a guarded arm whose block does not branch")
                    Switch(_) => ice("emit: a guarded arm whose block does not branch")
                    Unreached => ice("emit: a guarded arm whose block was never sealed")
                }
            }
            None => {
                @print_chain(f, a.body, t.join, false, printed)
                @body.append("    _novac_matched_t${t.uniq} = 1;\n")
            }
        }
        @body.append("    }\n")
    }
}
// ---- A statement: ONE dispatch on its kind ----
// The same one that lives in `@emit_last_stmt` (emit_place.nv). It does not disappear -- it
// moves here; a second copy of that match would be a second door.
//
// THE FIFTH PREREQUISITE HAD TO LAND BEFORE THIS DISPATCHER, and it did. Without it
// `@emit_assign` was no printer: it called `@build_value`, which for a `MatchExpr` did
// `@fresh_uniq()`, `@lo.ir.temp(...)` and `@lo.lower_match(...)` -- it LOWERED. The walk runs over
// the `f` that `@lo.ir.finish()` returned, and pushing new blocks into a finished builder means
// recording them and printing them NEVER: the body of every match-value (11 files) and every
// if-value (24 sites) would have vanished from the C. The root was in the record itself:
// `@lo.ir.place` stores `Rvalue.Expr(e)` with a RAW tree node, and `Rvalue.Expr` calls itself
// "the M1 bridge".
//
// The cure was the prerequisite rather than a part of the walk: the lowering of a match- or
// if-value moved into the lowering phase (`@lower_value_source`), `Assign` is recorded with
// a FINISHED source, and only then did `@emit_assign` become a printer.
fn Emitter mut @print_stmt(s Stmt) -> () {
    match s {
        Assign(a) => @emit_assign(a)
        Eval(rv) => @emit_eval(rv)
        Store(st) => @emit_store(st)
        Decl(l) => @emit_decl(l)
        Output(o) => @emit_output(o)
        OutputEnd => @emit_output_end()
    }
}
