// The control-flow statements as STRUCTURED TERMINATORS of the lowered body
// (sub-plan 274.8, wave M2b-1): `if` / `else if` / `else`, `while`, the range
// `for` and `return` open and close blocks through the builder's events, and
// the C is printed AT THE SAME EVENTS -- the streaming bridge of M1/M2a moved
// from statements to terminators, so the C stays byte-identical while the
// body becomes a real graph (entry, branches, join, header, body, exit).
//
// Donor: rustc MIR building (`rustc_mir_build::build::expr::into` for `if`,
// `build::scope` for loops): a fresh block per branch, one join, a loop
// header with its own block. The FORM of the terminators is WebAssembly's
// structured control flow (`if`/`loop`/`block` with named exits), because
// the printer targets structural C and must not rediscover the structure
// from a flat graph (plan 274.8 section 2a).
// Role: layer emit_c -- the lowering AND the printing of control flow. The
//   dispatcher `emit_stmt` routes here; nothing here dispatches on node kind
//   beyond the shape of the statement it was handed.
// Used by: emit_c.nv (`emit_stmt`), nothing else.
// Guarded by: check-novac-differential.sh, the corpus C diff of the wave,
//   lower_test.nv (the graph shapes), check-novac-lowering-one-door.py.
//
// ORDER OF PRINT AND EVENT, and why it is this way: a condition is PRINTED
// before the branch it guards is opened, so that whatever its printing still
// lowers at print time (a `??` inside it, until M2b-2 lowers nested value
// positions ahead of print) is recorded in the block the test runs in, not
// in the branch taken. For an `else if` the else branch is opened FIRST, then
// the condition printed, then the chained `if` opened -- same reason.

module novac.emit_c

import ../tree.{Node, NodeKind}
import ../diag.{ice}
import ../sem.{branch_children, leaf_text, c_instance_method, for_head_elem}
import ../lower.{IfCtx, LoopHead, RangeHead, EachHead, Cond}
import ../builtins.{VEC_LEN_METHOD}

/// Whether the `else` tail prints its OWN pair of braces -- ONE door for the question, so
/// `lower_if` and `lower_if_let` cannot answer it differently. A block tail and a chained
/// `if let` are braced; a chained `if` is not, because its head continues the `} else `
/// line. The reason if-let is braced: C has no `else <declaration>`, and an if-let's first
/// line IS the declaration of its Option temporary (registry #991).
fn else_is_braced(tail Node) -> bool {
    ro k = tail.kind_of()
    k == NodeKind.Block || k == NodeKind.IfLet
}

/// Whether this branch continues a `} else ` line its caller printed.
fn chained_of(outer Option[IfCtx]) -> bool {
    match outer {
        None => false
        Some(_) => true
    }
}

/// THE HEAD OF A BRANCH, printed from the IR (wave M2b-2 step 3a): `if (<cond>) {`.
///
/// ONE printer for the plain `if` and for the `if let`. What differs between those two is
/// the `Cond` the lowering RECORDED, not the printing -- until this step each spelled its
/// own head, and the two could drift the way the two `else` tails did (registry #991).
/// A chained branch carries no indent of its own: it continues the `} else ` its caller
/// printed (M2b-2-0).
fn Emitter mut @print_if_head(cond Cond, chained bool) -> () {
    if chained {
        @body.append("if (")
    } else {
        @body.append("    if (")
    }
    match cond {
        Expr(e) => @emit_expr(e)
        IsSome(l) => {
            // The Some-test through the ONE Option door, spelled from the local's type
            // and name -- the same two the hand-written head passed by hand.
            ro d = @ir.decl_of(l)
            @body.append(@option_some_test(d.ty, d.name))
        }
    }
    @body.append(") {\n")
}

/// One `if` statement with its `else` / `else if` chain. `outer` is the
/// enclosing `if` when this one IS its else branch: then the else branch is
/// opened first and the chained `if` shares the outer join.
fn Emitter mut @lower_if(st Node, outer Option[IfCtx]) -> () {
    ro kids = branch_children(st)
    ro has_else = kids.len() > 4
    // The condition is RECORDED first and PRINTED from the record (M2b-2 step 3a): the
    // printing no longer reads the tree, which is what lets one walk print every branch
    // later. Recording before printing is safe because printing a condition lowers
    // nothing -- `emit_expr` touches neither the builder nor the name counter (measured
    // 2026-09-08); only `build_value` lowers, and a condition never goes through it.
    ro cond = Cond.Expr(kids[1])
    ro braced = if has_else { else_is_braced(kids[4]) } else { false }
    ro c = match outer {
        None => @ir.begin_if(cond, has_else, braced)
        // THE door for "else, then a chain" -- until 2026-09-08 this pair was opened by
        // hand here and in `lower_if_let`, while the door itself had only a test as its
        // caller (class #991: one concept, two implementations).
        Some(o) => @ir.begin_else_if(o, cond, has_else, braced)
    }
    // ONE shape of else (M2b-2-0): a chained `if` continues the `} else ` line its
    // caller printed, so it starts without the indent the top-level `if` carries.
    @print_if_head(cond, chained_of(outer))
    @emit_block_stmts_fn(kids[2], false)
    if has_else {
        // The closing brace and the `else` share one line -- the one shape of else
        // (M2b-2-0). Until then the statement `if` printed `}` and `else` on two lines
        // while the if-value printed `} else {`; the oracle's recorded C has 41 753
        // `} else {` and no bare `else {`, so the second shape was novac's own, and a
        // single printing walk would have needed a flag to reproduce it.
        @body.append("    } else ")
        // The ELSE branch, since 2026-08-18. Before that the parser did not
        // read `else` at all; reading it without writing it here would have
        // been worse than not reading it -- the branch would vanish from the
        // C in silence, which is the class this compiler keeps finding in
        // others.
        @lower_else_tail(c, kids[4])
    } else {
        // No else branch was written: the else block IS the join.
        @body.append("    }\n")
    }
    @ir.end_if(c)
}

/// What follows `else` -- ONE door for the `if` and the `if let` (until
/// M2b-1b each printed its own copy of this and the two had drifted: the `if`
/// iced on an `else if let` tail the `if let` accepted). Three shapes are
/// legal and ALL are named: a block, a chained `if`, a chained `if let`.
/// Anything else is an invariant break, and it says so -- an `else` standing
/// for "every other node kind" is what P21 refuses, because the next kind
/// added to the tree would quietly land in it.
fn Emitter mut @lower_else_tail(c IfCtx, tail Node) -> () {
    // The caller printed `    } else ` already: this door prints only what follows.
    ro tk = tail.kind_of()
    if tk == NodeKind.Block {
        @ir.begin_else(c)
        @body.append("{\n")
        @emit_block_stmts_fn(tail, false)
        @body.append("    }\n")
    } else if tk == NodeKind.IfStmt {
        @lower_if(tail, Some(c))
    } else if tk == NodeKind.IfLet {
        // C has no `else <declaration>`: the chained if-let's FIRST line is
        // the declaration of its Option temporary, and printed bare after
        // `else` it is not a statement -- clang refuses the unit. Found by
        // the M2b-1b probe (2026-09-06): the two copies of this tail had
        // accepted the form and printed it unbraced since the else branch
        // was added, and no corpus file carried it (registry #991: one
        // concept, two implementations, the copy not knowing a fact the
        // original knew). The braces give the temporary a block of its own;
        // the IR already had that block -- the outer else.
        @body.append("{\n")
        @lower_if_let(tail, Some(c))
        @body.append("    }\n")
    } else {
        ice("emit: the else branch is neither a block nor a chained if / if-let")
    }
}

/// One `if Some(v) = expr { ... }` (wave M2b-1b, from emit_iflet.nv): the
/// Option lands in its own binding through the placement door, the branch
/// tests `IsSome` of that local, and the binder is a binding local assigned
/// the payload -- three IR statements where the printer used to spell three
/// lines by hand. The C is the same: `T tmp = <init>;`, the Some-test
/// through the ONE Option door (emit_option.nv, wave W4), `P v = tmp.value;`.
/// INTEROP, named as such: `.tag`/`.value` are the shell's Option ABI
/// (`NovaOpt_X{.tag,.value}`, read off shell.tpl.c); goes the day novac emits
/// the whole prelude.
fn Emitter mut @lower_if_let(st Node, outer Option[IfCtx]) -> () {
    ro kids = branch_children(st)
    ro init = kids[6]
    ro ot = @out.type_of(init.id_of())
    ro payload = @ctx.tys.arg(ot, 0)
    ro has_else = kids.len() > 9
    // THE ELSE BRANCH IS OPENED BY THE DOOR, NOT HERE (fix 2026-09-08, ICE «a block sealed
    // twice (it already jumps)» on `novac/fixtures/iflet_else/pos_2.nv`). Until the door
    // `@begin_else_if` existed, this function opened the pair «else, then a chain» by hand:
    // `begin_else` here, the chained `if` below. The door now does BOTH, so the call here was
    // the second half of a pair whose first half had moved -- `begin_else` ran twice and the
    // second `@close` hit a block already sealed with `Goto`. The door stays whole; the
    // leftover half goes. For a non-chained if-let (`outer == None`) nothing changes at all.
    //
    // Consequence to keep in mind, and the corpus judges it: the Option temporary is now
    // recorded BEFORE the else branch is opened, not after. Its declaration therefore belongs
    // to the block that precedes the branch -- which is what `lower_else_tail` braces anyway
    // (C has no `else <declaration>`, registry #991).
    ro tmp = "_novac_tmp_t${@fresh_uniq()}"
    ro lo = @ir.named(ot, tmp)
    @lower_place(init, lo)
    // Recorded first, printed from the record -- the same door the plain `if` uses
    // (M2b-2 step 3a). The head is identical to what this function spelled by hand:
    // `option_some_test` reads the local's type and name, which is what it was passed.
    ro cond = Cond.IsSome(lo)
    ro braced = if has_else { else_is_braced(kids[9]) } else { false }
    ro c = match outer {
        None => @ir.begin_if(cond, has_else, braced)
        Some(o) => @ir.begin_else_if(o, cond, has_else, braced)
    }
    // NOT chained for the purpose of PRINTING, even when `outer` is Some -- braced, not continued.
    // A chained plain `if` continues the `} else ` line its caller printed, so it carries no
    // indent; a chained `if let` is wrapped in braces by `lower_else_tail` (`{` before it,
    // `    }` after), because C has no `else <declaration>` and an if-let's first line IS the
    // declaration of its Option temporary -- unbraced, clang refuses the unit (registry
    // #991, found by the M2b-1b probe). Inside those braces the head starts a NEW line and
    // keeps its indent. Measured, not reasoned: passing `chained_of(outer)` here made the
    // corpus C differ in exactly one file (fixtures/iflet_else/pos_2), the hunk being this
    // lost indent.
    @print_if_head(cond, false)
    // The binder: the checker bound it to the payload type, this door spells
    // what was decided.
    ro bv = @ir.named(payload, leaf_text(kids[3]))
    @ir.take_payload(bv, lo)
    @emit_last_stmt()
    @emit_block_stmts_fn(kids[7], false)
    if has_else {
        @body.append("    } else ")
        @lower_else_tail(c, kids[9])
    } else {
        // No else branch was written: the else block IS the join.
        @body.append("    }\n")
    }
    @ir.end_if(c)
}

/// THE HEAD OF A LOOP, printed from the IR (wave M2b-2 step 3a): one printer for all three
/// loop forms, because what differs between them is the `LoopHead` the lowering RECORDED,
/// not the printing. Until this step three functions spelled three heads, each reading the
/// tree; the walk that comes next needs one door that reads the record.
///
/// INTEROP, named as such: the element walk spells the shell's `len` of the collection's
/// instance -- it goes the day novac emits the whole prelude (emit_option.nv carries the
/// same note for the Option ABI).
fn Emitter mut @print_loop_head(head LoopHead) -> () {
    match head {
        While(e) => {
            @body.append("    while (")
            @emit_expr(e)
            @body.append(") {\n")
        }
        Range(r) => {
            ro v = @ir.decl_of(r.var).name
            @body.append("    for (nova_int ${v} = ")
            @emit_expr(r.lo)
            @body.append("; ${v} < ")
            @emit_expr(r.hi)
            @body.append("; ${v}++) {\n")
        }
        Each(e) => {
            ro vd = @ir.decl_of(e.vec)
            ro i = @ir.decl_of(e.idx).name
            ro len_c = c_instance_method(@ctx, vd.ty, VEC_LEN_METHOD)
            @body.append("    for (nova_int ${i} = 0; ${i} < ${len_c}(${vd.name}); ${i}++) {\n")
        }
    }
}

/// One `while`: the header block carries the loop, the body jumps back.
fn Emitter mut @lower_while(st Node) -> () {
    ro kids = branch_children(st)
    // Recorded first, printed from the record (M2b-2 step 3a).
    ro head = LoopHead.While(kids[1])
    ro c = @ir.begin_loop(head)
    @print_loop_head(head)
    @emit_block_stmts_fn(kids[2], false)
    @body.append("    }\n")
    @ir.end_loop(c)
}

/// One `for v in lo..hi`: the loop variable is a binding local of the body,
/// the bounds stay tree expressions (the M1 bridge), the header carries the
/// range form so the printer spells C's `for` and not a `while`.
fn Emitter mut @lower_for_range(kids []Node) -> () {
    ro v = leaf_text(kids[1])
    ro range = branch_children(kids[3]) // Bin: [lo, .., hi]
    // The loop variable is a binding local of the body, and the head is printed from the
    // record that carries it (M2b-2 step 3a).
    ro lv = @ir.named(@ctx.prims.int_id, v)
    ro head = LoopHead.Range(RangeHead { var: lv, lo: range[0], hi: range[2] })
    ro c = @ir.begin_loop(head)
    @print_loop_head(head)
    @emit_block_stmts_fn(kids[4], false)
    @body.append("    }\n")
    @ir.end_loop(c)
}

/// One `for v in <collection>` (wave M2b-1c, from emit_for.nv): the head runs
/// ONCE into a binding local through the placement door, the index is a
/// binding local of int, the header carries all three locals, and the body
/// starts by reading `vec[idx]` -- `Rvalue.IndexPayload`, printed as the
/// shell's `get(...).value` by the one assignment printer. The C is the same
/// walk `emit_for_call` spelled by hand: `T vtmp = <head>;`, `for (nova_int
/// itmp = 0; itmp < len(vtmp); itmp++) {`, `E var = get(vtmp, itmp).value;`.
/// The element type is the CHECKER's decision (`for_head_elem`), not a second
/// derivation here (hunt emit_c x K4, 2026-09-04).
fn Emitter mut @lower_for_each(kids []Node) -> () {
    ro head = kids[3]
    ro ht = @out.type_of(head.id_of())
    ro elem_t = for_head_elem(@ctx, ht)
    ro vtmp = "_novac_tmp_t${@fresh_uniq()}"
    ro itmp = "_novac_i_t${@fresh_uniq()}"
    ro lv = @ir.named(ht, vtmp)
    @lower_place(head, lv)
    // All three locals of the walk exist before the head is printed, because the head is
    // printed FROM the record that names them (M2b-2 step 3a).
    ro li = @ir.named(@ctx.prims.int_id, itmp)
    ro le = @ir.named(elem_t, leaf_text(kids[1]))
    ro lh = LoopHead.Each(EachHead { vec: lv, idx: li, elem: le })
    ro c = @ir.begin_loop(lh)
    @print_loop_head(lh)
    @ir.take_elem(le, lv, li)
    @emit_last_stmt()
    @emit_block_stmts_fn(kids[4], false)
    @body.append("    }\n")
    @ir.end_loop(c)
}

/// One `return`: the value lands in the return place through the one door
/// (274.8 M1) -- a bare `return` spells the unit itself -- and the block ends
/// with `Return`; what the source wrote after it lands in a fresh block.
fn Emitter mut @lower_return(st Node) -> () {
    ro kids = branch_children(st)
    if kids.len() > 1 {
        @lower_place(kids[1], @ir.ret_place())
    } else {
        @body.append("    return NOVA_UNIT;\n")
    }
    @ir.ret()
}
