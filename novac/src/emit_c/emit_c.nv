// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Nim `ccgexprs`/`ccgstmts` (C emitted as text from a typed tree, one
// procedure per node kind, string builder per function) + Chicken Scheme's
// C backend for "the runtime shell is a fixed template with slots"; the walk
// hangs on one `Emitter` receiver as Go `*Checker` / Zig `*Sema` / Roslyn
// `Binder` do (П15). NOT taken: Nim's `TLoc` value-location machinery (no
// register/temp allocator here — arguments will hoist into temporaries per
// F65), any GC-shape or dictionary path (full mono by D122). The CURRENT
// record/sum/match/println shapes are a starting point held by the diff gate,
// not an obligation (274 §7.0); the current compiler is NOT a donor (П25,
// П27 2a) — matching its output is what the smoke measures, not where the
// shape comes from.
// Role: layer 11 — backend A, C text; renders decisions already made, decides nothing (architecture, checker/codegen
// boundary).
// Used by: the smoke and diff-corpus (E1-E2); replaced below lower at E4 for a native backend, kept as the normative
// one.
// Guarded by: novac-e1-smoke.sh (behaviour identical to the oracle binary), check-novac-shell-freshness.sh (the shell
// is the oracle's emission), check-novac-no-default-branch.py, check-novac-no-alloc-in-lookup.py (an emitter is not a
// door).
// copying, and the oracle's shape is a fixed point of BEHAVIOUR only (П25,
// plan 274 §7.0); the walk hangs on one `Emitter` receiver like Go's
// `*Checker` and Zig's `*Sema` (П15).
// novac/src/emit_c — backend A: C text (architecture §2/§9).
//
// E2 vertical: the runtime SHELL is a fixed, file-independent template
// (shell.tpl.c) REGENERATED BY MACHINE from the umbrella probe
// (novac/probe/shell_probe.nv + scripts/tools/novac-regen-shell.sh): the
// probe's oracle emission IS the shell, so every std helper the emitter can
// reference survives the oracle's DCE. The emitter generates ONLY the two
// slots: string-literal definitions and the user code (type declarations
// first, then functions, main included). novac never invents ABI — a form
// whose helper is missing in the probe dies loudly at the smoke's link
// step, and the probe grows the same wave.
//
// This module is C RENDER ONLY (owner's review 2026-08-15): the type
// registry, the unified def table and expression typing live in `sem` —
// any backend consumes them, none owns them (the rustc_middle model). A
// libFirm backend (plan §12) imports the same sem and renders its own IR.
//
// The walk hangs on ONE receiver, `Emitter` (convention П15): the registry
// it reads, the literal pool and the code it writes, and the locals visible
// at the current point used to ride every signature as four parameters.
// They are the state of one emission, so they are fields — the shape of
// every reference (rustc's `Builder`, Roslyn's `Binder`, Go's `*Checker`,
// Zig's `*Sema`). The data flow stays visible in the type; nothing became
// ambient.
//
// Records and sums currently emit in the oracle's shape - values are GC
// pointers, constructors alloc + store, spread copies then overrides, field
// access is (p->x), sums are a tag enum plus a tagged union with a maker per
// variant, match is scrutinee/result/matched-flag with an if-chain and guards
// nesting one more if. That is a STARTING POINT, no longer an obligation
// (plan 274 section 7.0, owner 2026-08-16): identity with the oracle is owed
// on BEHAVIOUR and on the ABI boundary, never on the shape of the emission.
// Where a different shape is better - argument temporaries in source order
// (F65), tuples as stack values, one allocation fewer - novac is expected to
// diverge, with a line in docs/dev/novac-divergences.md saying why.
//
// Edge note (table §3): E2-temporary rows `emit_c` -> `tree`/`lex`/`names`/
// `sem` — the emitter walks the green tree until `lower` exists (E4);
// removal obligation recorded in the table.

module novac.emit_c

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind, BinOp, UnOp, bin_op_of, un_op_of, assign_op_of}
import ../diag.{ice}
import ../mono.{Reach}
import ../sem.{ParamDef, FnRow, raw_row, decl_fn_row, decl_name_at, param_name_at, c_callable, arm_body_at, Ctx, CheckOut, branch_children, leaf_text, leaf_kind, is_expr_kind, expr_leaf_name, call_callee_text, c_type, c_struct, c_tag, c_maker, VariantRow, raw_vrow, no_vrow, is_vrow, field_range_of, variant_range_of, raw_frow, no_frow}
import ../builtins.{PRINT_FN, bool_c_literal}
import ../types.{TyId, no_ty}

/// The runtime shell, embedded at build time (regenerated by novac-regen-shell.sh).
fn shell_template() -> []u8 => embed("shell.tpl.c")

/// One C translation unit under construction: everything the emitter reads
/// and writes while it walks one file. The text builder is a resource, so
/// the emitter is a `consume` value — created once, walked, finished once.
type Emitter consume {
    ctx Ctx /// type registry and def table — read only, built by sem
    out CheckOut /// THE checker's channel: every type question is a READ here, never a re-derivation (E2-b1)
    lits []str /// string literals in registration order; the index is the C name suffix
    consume body StringBuilder /// the code slot of the shell, built in a single pass
    reach Reach /// WHICH callables are reached from a root (mono, E2-b2): the emitter
        /// asks, it does not decide
    next_tmp int /// counter behind @fresh_uniq — the ONLY source of temporary names (F30)
}

/// No type arguments: the ONE spelling of "this instance substitutes nothing",
/// so the day substitutions arrive there is one place to stop passing it.
/// A fn and not a `const`: a vector is allocated, and an allocation is not a
/// constant expression (E_CONST_NOT_CONSTEXPR -- the oracle is right).
fn no_subst() -> []TyId => []TyId.new()

/// Finish the emission: the literal pool AND the accumulated code, together.
/// Named `into_*` because it is a consume conversion into a different type
/// (nv-coding-style §1a, caught by `nova lint` once it was pointed at novac).
///
/// Returning both is not a convenience. The owner's review 2026-08-16 killed
/// the previous shape, which read `e.lits` into a binding and then consumed
/// `e` in the same call: the binding copies only a POINTER, so nothing in
/// the TYPE stops a consume method from touching that same object — the
/// safety rested on the body of `finish`, not on anything checkable. Worse,
/// it leaned on argument evaluation order, and a probe the same day showed
/// the C backend evaluating arguments RIGHT-TO-LEFT despite the spec calling
/// left-to-right normative (reported to the compiler window). One move, one
/// result: no aliasing question and no order to depend on.
fn Emitter consume @into_parts() -> ([]str, str) => (@lits, @body.into_str())

/// One instance of a generic callable, already decided and already typed:
/// what mono chose, the body to walk, and the channel that body's types live
/// in.
///
/// It crosses the pipeline -> emitter boundary as DATA. The emitter asks
/// `check` for nothing and substitutes nothing: `ptypes` and `ret_id` are
/// concrete because mono rewrote them, which is where the architecture puts
/// that work.
export type Instantiation {
    decl Node /// the generic declaration whose body this instance is
    row FnRow /// its row in FnTable -- the C name is a function of (row, subst)
    subst []TyId /// the type arguments this instance stands for
    ptypes []ParamDef /// its parameters: CONCRETE types plus the declared modes
    ret_id TyId /// its CONCRETE return type
    chan CheckOut /// the channel this body was typed into -- one per instance
}

/// Emit the whole C translation unit for a checked subset file. The channel
/// comes from the checker and is not optional: an emitter that could fall
/// back to computing a type itself is an emitter with a second opinion, and
/// the second opinion is what plan 196 spent a wave deleting.
///
/// `reach` and `insts` come from the pipeline for the same reason: WHICH
/// callables exist is mono's decision and typing an instance body is check's
/// work, so an emitter that called either of them would be deciding rather
/// than rendering (274 §6 -- pass order lives in the pipeline alone).
export fn emit(file Node, ctx Ctx, out CheckOut, reach Reach, insts []Instantiation) -> str {
    consume e = Emitter { ctx, out, reach, next_tmp: 0, lits: []str.new(), body: StringBuilder.new() }
    e.emit_type_decls()
    e.emit_instance_protos(insts)
    e.emit_file(file)
    for inst in insts {
        e.emit_instance(inst)
    }
    ro (lits, code) = e.into_parts()
    render(lits, code)
}


/// Emit declarations for every user type of the file (shell owns the rest).
/// The dispatch is an EXHAUSTIVE match over TypeKind, not an if-chain ending
/// in `else`: the owner's rule 2026-08-16. An `else` on a closed set means
/// "everything I did not name is a sum", so a fourth kind would be emitted as
/// a sum in silence — the #652 class again. With a match, a new variant is a
/// compile error at exactly this line.
fn Emitter mut @emit_type_decls() -> () {
    for t in 0..@ctx.types.len() {
        ro td = @ctx.types[t]
        match td.kind {
            TkPrim => {} // primitives own no declarations
            TkRecord => @emit_record_decl(t)
            TkSum => @emit_sum_decl(t)
            TkApp => ice("emit_c: declaration of an applied type — instances are emitted by mono, E2-b2")
            // A type parameter DECLARES nothing: it has no layout until a
            // substitution names one, and the instance that carries the
            // substitution is emitted as its own function (E2-b2). The row
            // exists from 2026-08-20, when a parameter became a real type, so
            // this arm went from "cannot happen" to "nothing to do" -- and it
            // says which, rather than icing on a legal registry.
            TkParam => {}
            // A NEWTYPE declares NOTHING of its own: it is laid out as its
            // representation, and every reference to it spells the
            // representation (`c_type`). The oracle emits a `typedef` here;
            // novac's emission shape is its own (274 section 7.0) and an
            // unreferenced typedef would be text nobody reads.
            TkNewtype => {}
            TkInfer => ice("emit_c: declaration of an inference variable — a variable escaped its body")
        }
    }
}

/// Record: a typedef plus the struct with one member per field row, in the
/// declaration order the registry stored (the FieldRows arm of TypeDef.rows).
fn Emitter mut @emit_record_decl(rec_id int) -> () {
    // A DECL index, not a type id -- and since 2026-08-21 the two are told
    // apart: the C name comes from the row's OWN `ty_id` instead of from the
    // index that happens to equal it (the DeclId == TyId invariant is asserted
    // in `sem.decl_of_ty`, and this door no longer leans on it).
    ro td = @ctx.types[rec_id]
    ro sn = c_struct(@ctx, td.ty_id)
    @body.append("typedef struct ${sn} ${sn};\n")
    @body.append("struct ${sn} {\n")
    // The FIELD range, asked of the arm that holds one: a declaration whose rows
    // are variants (or none) has no fields to write, and the door says so instead
    // of handing back a range into the wrong table.
    ro frange = field_range_of(td) ?? (no_frow(), 0)
    for j in raw_frow(frange.0)..raw_frow(frange.0) + frange.1 {
        ro fd = @ctx.fields.rows[j]
        @body.append("    ")
        @body.append(c_type(@ctx, fd.type_id))
        @body.append(" ")
        @body.append(fd.name)
        @body.append(";\n")
    }
    @body.append("};\n\n")
}

/// Sum: tag enum + tagged union + a maker per variant — the oracle's exact
/// shape (fixed point on match_demo.nv), novac's own namespace. The type's
/// variant rows are the TypeDef.rows range (the VariantRows arm); each variant's payload
/// rows are VariantDef.payload_off/cnt — no filter loops (compile speed first).
fn Emitter mut @emit_sum_decl(sum_id int) -> () {
    // A DECL index; the C name comes from the row's own type id (see above).
    ro td = @ctx.types[sum_id]
    ro sn = c_struct(@ctx, td.ty_id)
    // The VARIANT range, from the arm that holds one.
    ro vrange = variant_range_of(td) ?? (no_vrow(), 0)
    ro vstart = raw_vrow(vrange.0)
    ro vend = vstart + vrange.1
    @body.append("typedef enum {\n")
    for v in vstart..vend {
        @body.append("    ${c_tag(@ctx, VariantRow(v))},\n")
    }
    @body.append("} ${sn}_Tag;\n")
    @body.append("typedef struct ${sn} ${sn};\n")
    @body.append("struct ${sn} {\n    ${sn}_Tag tag;\n    union {\n")
    for v in vstart..vend {
        ro vd = @ctx.variant_rows[v]
        @body.append("        struct {\n")
        for p in 0..vd.payload_cnt {
            @body.append("            ")
            @body.append(c_type(@ctx, @ctx.payload_types[vd.payload_off + p]))
            @body.append(" _${p};\n")
        }
        @body.append("        } ${vd.name};\n")
    }
    @body.append("    } payload;\n};\n\n")
    for v in vstart..vend {
        ro vd = @ctx.variant_rows[v]
        @body.append("static ${sn}* ${c_maker(@ctx, VariantRow(v))}(")
        if vd.payload_cnt == 0 {
            @body.append("void")
        } else {
            for p in 0..vd.payload_cnt {
                @body.append(if p > 0 { ", " } else { "" })
                @body.append(c_type(@ctx, @ctx.payload_types[vd.payload_off + p]))
                @body.append(" _${p}")
            }
        }
        @body.append(") {\n    ${sn}* _r = (${sn}*)nova_alloc(sizeof(${sn}));\n")
        @body.append("    _r->tag = ${c_tag(@ctx, VariantRow(v))};\n")
        for q in 0..vd.payload_cnt {
            @body.append("    _r->payload.${vd.name}._${q} = _${q};\n")
        }
        @body.append("    return _r;\n}\n\n")
    }
}

/// Splice string literals and the emitted body into the shell's two slots.
fn render(lits []str, body str) -> str {
    ro tpl_bytes = shell_template()
    ro tpl = tpl_bytes.to_str() ?? ice("emit: shell.tpl.c is not UTF-8")
    consume out = StringBuilder.new()
    mut emitted_lits = false
    mut emitted_body = false
    for line in tpl.lines() {
        if line.contains("__NOVAC_STRLITS__") {
            emit_strlit_defs(out, lits)
            emitted_lits = true
        } else if line.contains("__NOVAC_BODY__") {
            out.append(body)
            emitted_body = true
        } else {
            out.append(line)
            out.append("\n")
        }
    }
    assert(emitted_lits && emitted_body, "emit: template slots missing")
    out
}

/// Emit one static nova_str per registered string literal.
/// Drop the backslash of `\$`, and touch nothing else.
///
/// Written byte by byte rather than with a replace-all: the backslash before a
/// dollar is only an escape when it is not ITSELF escaped, and `\\${` means a
/// literal backslash followed by an interpolation. A blind replace would eat
/// the wrong one.
fn unescape_dollar(s str) -> str {
    ro b = s.bytes()
    consume out = StringBuilder.new()
    mut one = []u8.new()
    one.push(0 as u8)
    // A `while` and NOT `for`, on purpose: this cursor advances by ONE or by
    // TWO (an escaped `$` consumes two bytes), so the step carries information
    // and a range would lose it. The rule is "a cursor that always steps by one
    // is a range" -- this one does not.
    mut i = 0
    while i < b.len() {
        ro c = b[i]
        ro next_is_dollar = i + 1 < b.len() && b[i + 1] == DOLLAR_BYTE
        if c == BACKSLASH_BYTE && next_is_dollar {
            one[0] = DOLLAR_BYTE
            out.append(one)
            i += 2
        } else {
            one[0] = c
            out.append(one)
            i += 1
        }
    }
    out
}

/// The two bytes this door compares against; the character is in the comment
/// for the same reason the lexer's tables carry it.
const BACKSLASH_BYTE u8 = 0x5C  // backslash
const DOLLAR_BYTE u8 = 0x24     // $

/// Write the literal pool: one C array per string the file holds.
///
/// The only place a Nova literal becomes C text -- which is why the escaped
/// dollar is unescaped here and nowhere else.
fn emit_strlit_defs(mut out StringBuilder, lits []str) -> () {
    mut i = 0
    for raw in lits {
        // raw is the token text INCLUDING quotes. Nova's subset escape set
        // (\" \\ \n \t \r) matches C's one for one -- check refuses everything
        // else BY NAME -- with a single exception: `\$`. Nova spells an escaped
        // dollar that way so a literal `${` does not open an interpolation; C
        // has no such escape and would take it as undefined. So the backslash
        // is dropped HERE, at the one place that writes a literal into C, and
        // the rest of the text is passed through untouched.
        out.append("static const uint8_t _novac_strlit_${i}_buf[] = ")
        out.append(unescape_dollar(raw))
        out.append(";\n")
        out.append("static const nova_str _novac_strlit_${i} = { .ptr = _novac_strlit_${i}_buf, .len = sizeof(_novac_strlit_${i}_buf) - 1 };\n")
        i += 1
    }
}

/// Emit every fn declaration of the file in source order.
fn Emitter mut @emit_file(file Node) -> () {
    match file {
        Leaf(_) => ice("emit: file node must be a branch")
        Branch { kind, children, .. } => {
            assert(kind == NodeKind.File, "emit: root is not File")
            for c in children {
                if c.kind_of() != NodeKind.FnDecl { continue }
                // E2-b2: a callable NOT reached from a root is not emitted.
                // The decision belongs to mono, not to the emitter: the
                // emitter writes what it is given and asks who decided.
                match decl_fn_row(c, @ctx) {
                    // No row: this declaration is not a callable of the file,
                    // so there is nothing for the emitter to write.
                    None => continue
                    Some(row) => {
                        if !@reach.has(row) {
                            continue
                        } else {
                            // Reached from a root: the emitter writes it below.
                        }
                    }
                }
                @emit_fn(c)
            }
        }
    }
}

// ---- functions -----------------------------------------------------------

/// The NAME of a declaration. ONE door, so the refusal exists once: the
/// emitter is handed only files check accepted, and a declaration without a
/// name is not one of them.
fn decl_name(f Node) -> str {
    ro kids = branch_children(f)
    leaf_text(kids[decl_name_at(kids) ?? ice("emit: a declaration without a name reached the emitter")])
}

/// Emit one function of the FILE: main becomes nova_fn_main_impl, others
/// novac_user_<name>. Its row and its types come from the registry, and it
/// substitutes nothing -- an ordinary callable binds no type parameters.
fn Emitter mut @emit_fn(f Node) -> () {
    ro name = decl_name(f)
    // THE ROW THIS DECLARATION OWNS, asked by NODE. Asking `defs` by name was a
    // last-write-wins answer: with `fn tag(c Cel)` beside `fn tag(mut c Cel)`
    // both declarations resolved to the LAST row, so both emitted under the mut
    // overload's name and clang refused the unit (measured 2026-08-21). The
    // door exists for exactly this question, and the emitter now asks it -- the
    // same correction the CALL path took on 2026-08-19.
    // The door answers with a bare row index (`Option[int]`) -- wrapping
    // `decl_fn_row` is the next step of section 9.1g -- so the crossing into the
    // row SPACE happens here, once, and named.
    ro fn_row = FnRow(decl_fn_row(f, @ctx) ?? ice("emit: a declaration with no row in the callable table"))
    // The TYPES come from the ROW, as a VIEW: the registry decided them while
    // collecting, and asking `defs` again was a second door to one decision
    // that answered DIFFERENTLY for `x T` (found 2026-08-20). `ret_id` is -1
    // for main only; check refuses it elsewhere.
    ro fd = @ctx.fns.rows[raw_row(fn_row)]
    @emit_callable(f, name, fn_row, no_subst(),
        @ctx.fns.params[fd.param_off..fd.param_off + fd.param_cnt], fd.ret_id)
}

/// One INSTANCE of a generic body: the same door as any callable, with the
/// substitution mono chose and the channel that instance was typed into.
///
/// The channel is per INSTANCE by construction -- Go stenciling types one copy
/// of the body per substitution -- and the emitter holds exactly one. So the
/// instance's channel stands in the field for the length of its body and the
/// file's returns after. The alternative, threading a channel through every
/// `emit_*` signature, would put the same choice at a hundred call sites
/// instead of at this one.
fn Emitter mut @emit_instance(inst Instantiation) -> () {
    ro kids = branch_children(inst.decl)
    ro file_chan = @out
    @out = inst.chan
    @emit_callable(inst.decl, decl_name(inst.decl), inst.row, inst.subst, inst.ptypes, inst.ret_id)
    @out = file_chan
}

/// A prototype per instance, written before any definition.
///
/// Instance DEFINITIONS go at the end of the unit, because an instance body
/// may call the file's own functions and C wants those defined first; the call
/// sites inside those functions then need something to reach. The file's
/// ordinary functions keep the oracle's shape -- definitions in source order,
/// no prototypes -- so a file without generics emits exactly what it emitted
/// before this door existed.
fn Emitter mut @emit_instance_protos(insts []Instantiation) -> () {
    for inst in insts {
        @emit_signature(inst.decl, decl_name(inst.decl), inst.row, inst.subst, inst.ptypes, inst.ret_id)
        @body.append(";\n")
    }
}

/// The signature of a callable, up to but not including its body: `static`, the
/// return type, the ONE mangled name and the parameter list.
///
/// Written by one door because a prototype and a definition must agree by
/// construction: two writers of the same signature is how a prototype starts
/// declaring something the definition does not implement.
fn Emitter mut @emit_signature(f Node, name str, row FnRow, subst []TyId, ptypes []ParamDef, ret TyId) -> () {
    // The ROW, not the spelling: an overload of `main` is an ordinary callable
    // and gets an ordinary signature (fixed 2026-08-22 -- see `is_entry_fn`).
    if @ctx.fns.is_entry_row(row) {
        @body.append("static nova_unit ${c_callable(@ctx, row, subst)}(void)")
        return
    } else {
        // A callable whose signature is written out: its parameters follow.
    }
    @body.append("static ")
    @body.append(c_type(@ctx, ret))
    @body.append(" ${c_callable(@ctx, row, subst)}(")
    mut first = true
    mut slot = 0
    for c in branch_children(f) {
        if c.kind_of() != NodeKind.Param { continue }
        ro pk = branch_children(c)
        // The name by its DOOR, not by index zero: `mut v int` puts the mode
        // there, and the emitter used to print the mode as the parameter name.
        ro pname = leaf_text(pk[param_name_at(pk) ?? ice("emit: a parameter without a name reached the emitter")])
        // Position is the whole mapping: plan 273 §4.4 fixes a parameter's
        // slot, and the count is asserted after the loop rather than assumed.
        assert(slot < ptypes.len(), "emit: more parameter nodes than types the caller handed")
        ro ptype = ptypes[slot].type_id
        slot += 1
        assert(ptype >= 0, "emit: param without a type past check — no silent int default (#652 class)")
        @body.append(if first { "" } else { ", " })
        @body.append(c_type(@ctx, ptype))
        @body.append(" ")
        @body.append(pname)
        first = false
    }
    assert(slot == ptypes.len(), "emit: the caller handed types the declaration does not write")
    @body.append(if first { "void" } else { "" })
    @body.append(")")
}

/// One callable, signature and body: the ONE door that writes a C function,
/// whether it is a function of the file or an instance of a generic one. The
/// substitution and the concrete types ARRIVE here; nothing below substitutes.
fn Emitter mut @emit_callable(f Node, name str, row FnRow, subst []TyId, ptypes []ParamDef, ret TyId) -> () {
    ro kids = branch_children(f)
    @emit_signature(f, name, row, subst, ptypes, ret)
    @body.append(" {\n")
    mut has_expr_body = false
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Block {
            @emit_block_stmts_fn(c, !@ctx.fns.is_entry_row(row))
        } else if ck == NodeKind.FnExprBody {
            has_expr_body = true
            ro ek = branch_children(c)
            ro e = ek[ek.len() - 1]
            if e.kind_of() == NodeKind.MatchExpr {
                ro u = @fresh_uniq()
                @emit_match(e, u, ret)
                @body.append("    return _novac_match_t${u};\n")
            } else if is_expr_kind(e.kind_of()) {
                @body.append("    return ")
                @emit_expr(e)
                @body.append(";\n")
            } else if e.kind_of() == NodeKind.RecordCtor {
                // F34: the body position IS an initializer position -- that
                // is exactly why the oracle asks for bare braces here -- so
                // the constructor is emitted like any other, through the
                // shared door.
                ro rtmp = @emit_record_ctor(e, ret)
                @body.append("    return ${rtmp};\n")
            } else {
                ice("emit_c: fn expression body is neither a match nor an expression")
            }
        } else {
            // Any other child -- the name leaf, the parameter list, the return
            // type -- is read above by position, never by walking this loop.
        }
    }
    if @ctx.fns.is_entry_row(row) {
        @body.append("    return NOVA_UNIT;\n}\n")
    } else {
        // Trailing safety return only for block bodies of int fns (the E1
        // shape); an expression body IS the return, and non-int returns
        // never fall through in the subset.
        if !has_expr_body && ret == @ctx.prims.int_id {
            @body.append("    return (nova_int)0LL;\n")
        } else {
            // An expression body already emitted its return, and a non-int
            // block body cannot reach the closing brace in the subset.
        }
        @body.append("}\n")
    }
}

/// The oracle's match scheme (fixed point on match_demo.nv): scrutinee tmp,
/// result var, matched flag, then an if-chain — literal pattern compares,
/// binder pattern binds (guard nests one more if), variant pattern checks
/// A fresh suffix for the temporaries of one `match`.
///
/// F30: the suffix used to be the BINDING NAME, and Nova lets a name be bound
/// twice in one scope (`ro r = match ..` then `ro r = match ..` -- the oracle
/// accepts it). Two identical `nova_int _novac_match_r` then landed in the same
/// C block: a redefinition, from a program that is perfectly legal Nova. The
/// counter makes collision impossible instead of unlikely.
fn Emitter mut @fresh_uniq() -> int {
    @next_tmp += 1
    @next_tmp
}

/// the tag and unpacks payload fields in order. uniq must be unique per
/// function body: the binding name or the fn name.
fn Emitter mut @emit_match(m Node, uniq int, res_t TyId) -> () {
    ro kids = branch_children(m)
    ro scr = kids[1]
    ro scr_t = @out.type_of(scr.id_of())
    @body.append("    ")
    @body.append(c_type(@ctx, scr_t))
    @body.append(" _novac_scr_t${uniq} = ")
    @emit_expr(scr)
    @body.append(";\n    ")
    // The temporary is declared with its type AND zero-initialised
    // (274.3/F29). The checker demands exhaustiveness for SUMS now, but a
    // match on `int` may legally leave values uncovered -- both compilers
    // accept `match n { 1 => 10  2 => 20 }` -- and the oracle answers 0
    // there. An uninitialised temporary answered whatever the stack held:
    // valid C, a different number per run, no diagnostic anywhere. The
    // compound literal `(T){0}` is C99 and works for scalars and structs
    // alike, so the emitter needs no per-type knowledge here.
    @body.append(c_type(@ctx, res_t))
    @body.append(" _novac_match_t${uniq} = (")
    @body.append(c_type(@ctx, res_t))
    @body.append("){0};\n")
    @body.append("    int _novac_matched_t${uniq} = 0;\n")
    for c in kids {
        if c.kind_of() != NodeKind.MatchArm { continue }
        @emit_arm(c, uniq, scr_t)
    }
}

/// Tag test of a variant pattern: user sums are GC pointers with novac's own
/// tag names; std sums (Option) are VALUES with the oracle's tag names.
fn Emitter mut @emit_tag_test(uniq int, vrow VariantRow) -> () {
    @body.append("(_novac_scr_t${uniq}->tag == ${c_tag(@ctx, vrow)})")
}

/// Emit one match arm: pattern test, binder unpacking, optional guard, arm value.
fn Emitter mut @emit_arm(arm Node, uniq int, scr_t TyId) -> () {
    ro ak = branch_children(arm)
    ro pat = branch_children(ak[0])
    ro arm_e = ak[arm_body_at(ak) ?? ice("emit_c: a match arm with no body reached the emitter")]
    mut has_guard = false
    for g in ak {
        has_guard = has_guard || g.kind_of() == NodeKind.Guard
    }
    @body.append("    if (!_novac_matched_t${uniq} && (")
    ro p0 = pat[0]
    mut vrow = no_vrow()
    if leaf_kind(p0) == TokenKind.IntLit {
        @body.append("(_novac_scr_t${uniq} == ")
        @body.append(leaf_text(p0))
        @body.append("LL)")
    } else if leaf_kind(p0) == TokenKind.Ident {
        // A bare `None` (no parens) is a variant too — resolve by name
        // regardless of arity; only a NON-variant ident is a binder.
        if Some(def) = @ctx.defs.def_of(leaf_text(p0)) {
            vrow = match def.target {
                DefVariant(row) => row
                DefType(_) | DefFn(_) => no_vrow()
            }
        } else {
            // A name the registry never saw is a fresh binder, and `no_vrow()`
            // is what the binder path below reads: no tag test, an always-true
            // arm.
        }
        if is_vrow(vrow) {
            @emit_tag_test(uniq, vrow)
        } else {
            @body.append(bool_c_literal(true))
        }
    } else {
        ice("emit_c: match pattern is neither an int literal nor an identifier")
    }
    @body.append(")) {\n")
    // Asked once and named, so the chain below tests bools rather than
    // variants (no-default-branch keeps variant dispatch for `match`, and a
    // TokenKind match here would need the wildcard the same rule forbids).
    ro is_plain_binder = leaf_kind(p0) == TokenKind.Ident && leaf_text(p0) != "_"
    if is_vrow(vrow) {
        // Unpack payload fields onto the arm's binders, in order: binder
        // names sit after '(' in the pattern; field types are the variant's
        // rows of the flat context.
        ro vname = leaf_text(p0)
        mut binders = []str.new()
        // `for` over the RANGE (owner 2026-08-22): the comment below used to
        // WARN that "the walk cannot `continue` on None -- `j += 1` is what
        // advances it". A warning about a hazard is worse than a form without
        // the hazard: over a range, `continue` advances by construction.
        for j in 2..pat.len() {
            // [LEGACY-#676] var-index-method: same workaround as in
            // collect_types: variable-index receiver miscompiles.
            ro pj = pat[j]
            // The test and the TEXT are one question: `ident_str` answers
            // both, and None is the pattern's punctuation -- '(' ',' ')' --
            // which names no binder.
            // A match, not `if Some(...)`: the second case is empty, and P31
            // would demand an `else` with a reason -- which is longer than the
            // arm it replaced (measured 2026-08-22).
            match pj.ident_str() {
                Some(binder) => binders.push(binder)
                None => {}
            }
        }
        mut pi = 0
        for bname in binders {
            ro bt = @ctx.payload_types[@ctx.variant_rows[raw_vrow(vrow)].payload_off + pi]
            @body.append("        ")
            @body.append(c_type(@ctx, bt))
            @body.append(" ${bname} = _novac_scr_t${uniq}->payload.${vname}._${pi};\n")
            pi += 1
        }
    } else if is_plain_binder {
        // Plain binder: the scrutinee under a new name.
        @body.append("        ")
        @body.append(c_type(@ctx, scr_t))
        @body.append(" ${leaf_text(p0)} = _novac_scr_t${uniq};\n")
    } else {
        // The remaining pattern shapes -- an int literal and the wildcard
        // `_` -- introduce no name: the test emitted above IS the whole
        // arm, so nothing is declared inside it. This closes the chain;
        // the no-default-branch rule is satisfied because the conditions
        // test a LEAF KIND and a spelling, not a sum variant.
    }
    if has_guard {
        for g in ak {
            if g.kind_of() != NodeKind.Guard { continue }
            @body.append("        if (")
            @emit_expr(branch_children(g)[1])
            @body.append(") {\n")
        }
        @body.append("            _novac_match_t${uniq} = ")
        @emit_expr(arm_e)
        @body.append(";\n            _novac_matched_t${uniq} = 1;\n        }\n")
    } else {
        @body.append("        _novac_match_t${uniq} = ")
        @emit_expr(arm_e)
        @body.append(";\n        _novac_matched_t${uniq} = 1;\n")
    }
    @body.append("    }\n")
}

/// tail=true: the LAST expression statement of an int fn body is its return
/// value (Nova tail-expression semantics; arithmetic.nv relies on it).
fn Emitter mut @emit_block_stmts_fn(b Node, tail bool) -> () {
    ro kids = branch_children(b)
    mut last_branch = -1
    if tail {
        mut j = 0
        for c in kids {
            match c {
                Leaf(_) => {}
                Branch { .. } => { last_branch = j }
            }
            j += 1
        }
    } else {
        // No tail duty: no statement of this block is a return value, and -1
        // is an index no child can equal, so the test below never fires.
    }
    mut j = 0
    for c in kids {
        match c {
            Leaf(_) => {} // the block's own braces -- trivia carriers, not statements
            Branch { .. } => {
                if tail && j == last_branch && is_expr_kind(c.kind_of()) && c.kind_of() != NodeKind.Call {
                    @body.append("    return ")
                    @emit_expr(c)
                    @body.append(";\n")
                } else {
                    @emit_stmt(c)
                }
            }
        }
        j += 1
    }
}

/// Emit one statement by node kind (call/if/while/return/bind/assign/for/expr).
fn Emitter mut @emit_stmt(st Node) -> () {
    ro k = st.kind_of()
    if k == NodeKind.Call {
        @emit_call_stmt(st)
    } else if k == NodeKind.IfStmt {
        ro kids = branch_children(st)
        @body.append("    if (")
        @emit_expr(kids[1])
        @body.append(") {\n")
        @emit_block_stmts_fn(kids[2], false)
        @body.append("    }\n")
        // The ELSE branch, since 2026-08-18. Before that the parser did not
        // read `else` at all; reading it without writing it here would have
        // been worse than not reading it -- the branch would vanish from the
        // C in silence, which is the class this compiler keeps finding in
        // others.
        if kids.len() > 4 {
            @body.append("    else ")
            ro tail = kids[4]
            ro tk = tail.kind_of()
            // Two shapes are legal after `else` and BOTH are named: a block,
            // and a nested if for the `else if` chain. Anything else is an
            // invariant break, and it says so -- an `else` standing for "every
            // other node kind" is what P21 refuses, because the next kind
            // added to the tree would quietly land in it.
            if tk == NodeKind.Block {
                @body.append("{\n")
                @emit_block_stmts_fn(tail, false)
                @body.append("    }\n")
            } else if tk == NodeKind.IfStmt {
                @emit_stmt(tail)
            } else {
                ice("emit: the else branch is neither a block nor an else-if")
            }
        } else {
            // No else branch was written.
        }
    } else if k == NodeKind.WhileStmt {
        ro kids = branch_children(st)
        @body.append("    while (")
        @emit_expr(kids[1])
        @body.append(") {\n")
        @emit_block_stmts_fn(kids[2], false)
        @body.append("    }\n")
    } else if k == NodeKind.RetStmt {
        ro kids = branch_children(st)
        @body.append("    return ")
        if kids.len() > 1 { @emit_expr(kids[1]) } else { @body.append("NOVA_UNIT") }
        @body.append(";\n")
    } else if k == NodeKind.BindStmt {
        @emit_bind(st)
    } else if k == NodeKind.AssignStmt {
        ro kids = branch_children(st)
        ro target = expr_leaf_name(kids[0])
        @body.append("    ")
        @body.append(target)
        @body.append(" = ")
        // A compound assignment IS its binary operator plus a store, so it
        // reuses the ONE form table rather than repeating it (`a += b` is
        // `a = a + b`, which is also how the protocol path will read on user
        // types: `a = a.@plus(b)`, D46).
        match assign_op_of(leaf_kind(kids[1])) {
            Set => @emit_expr(kids[2])
            Update(op) => {
                // The operand TYPE decides the form, and it is READ from the
                // channel -- assuming int here is what made `f += 0.25` emit
                // an integer helper on doubles.
                ro is_float = @out.type_of(kids[2].id_of()) == @ctx.prims.f64_id
                ro form = c_binary_form(op, is_float)
                if !is_call_form(op, is_float) {
                    @body.append("((")
                    @body.append(target)
                    @body.append(") ")
                    @body.append(form)
                    @body.append(" (")
                    @emit_expr(kids[2])
                    @body.append("))")
                } else {
                    @body.append(form)
                    @body.append("(")
                    @body.append(target)
                    @body.append(", ")
                    @emit_expr(kids[2])
                    @body.append(")")
                }
            }
        }
        @body.append(";\n")
    } else if k == NodeKind.ForStmt {
        ro kids = branch_children(st)
        ro v = leaf_text(kids[1])
        ro range = branch_children(kids[3]) // Bin: [lo, .., hi]
        @body.append("    for (nova_int ${v} = ")
        @emit_expr(range[0])
        @body.append("; ${v} < ")
        @emit_expr(range[2])
        @body.append("; ${v}++) {\n")
        @emit_block_stmts_fn(kids[4], false)
        @body.append("    }\n")
    } else if is_expr_kind(k) {
        @body.append("    (void)(")
        @emit_expr(st)
        @body.append(");\n")
    } else {
        ice("emit: statement kind outside the subset")
    }
}
/// Emit a record constructor into a fresh temporary and answer its C name.
///
/// ONE door for both positions: the initializer of a binding, and the
/// expression body of a fn (`fn mk() -> Pt => { x: 1, y: 2 }`). F34 was the
/// second position missing -- check accepted the form and emit answered with
/// an ice, so a legal program had no compiler at all. Copying the twenty
/// lines instead would have set up the next divergence between two places
/// that must agree.
fn Emitter mut @emit_record_ctor(init Node, vtype TyId) -> str {
    ro rec = c_struct(@ctx, vtype)
    // F30: the temporary is NUMBERED, not named after the binding --
        // a name may be bound twice in one scope (the oracle accepts it)
        // and the C would then declare the same variable twice in one
        // block: invalid C from perfectly legal Nova.
        ro tmp = "_novac_tmp_t${@fresh_uniq()}"
    @body.append("    ${rec}* ${tmp} = (${rec}*)nova_alloc(sizeof(${rec}));\n")
    for c in branch_children(init) {
        ro ck = c.kind_of()
        if ck == NodeKind.CtorSpread {
            @body.append("    *${tmp} = *")
            @emit_expr(branch_children(c)[1])
            @body.append(";\n")
        } else if ck == NodeKind.CtorField {
            ro fk = branch_children(c)
            ro fname = leaf_text(fk[0])
            @body.append("    ${tmp}->${fname} = ")
            if fk.len() > 1 {
                @emit_expr(fk[2])
            } else {
                // Punning: `Point { x }` stores the local of that name.
                @body.append(fname)
            }
            @body.append(";\n")
        } else {
            // The '{' ',' '}' leaves of the constructor: punctuation
            // stores no field, so the temporary is left as it is.
        }
    }
    tmp
}

/// Binding. A record-constructor initializer follows the oracle's tmp scheme
/// (fixed point on records.nv); a match initializer follows the match
/// scheme; everything else is a plain typed local.
fn Emitter mut @emit_bind(st Node) -> () {
    ro kids = branch_children(st)
    ro vname = leaf_text(kids[1])
    ro init = kids[kids.len() - 1]
    ro vtype = @out.type_of(init.id_of())
    if init.kind_of() == NodeKind.MatchExpr {
        ro u = @fresh_uniq()
        @emit_match(init, u, vtype)
        @body.append("    ")
        @body.append(c_type(@ctx, vtype))
        @body.append(" ${vname} = _novac_match_t${u};\n")
        return
    }
    if init.kind_of() == NodeKind.RecordCtor {
        ro rec = c_struct(@ctx, vtype)
        ro tmp = @emit_record_ctor(init, vtype)
        @body.append("    ${rec}* ${vname} = ${tmp};\n")
    } else if is_expr_kind(init.kind_of()) {
        @body.append("    ")
        @body.append(c_type(@ctx, vtype))
        @body.append(" ")
        @body.append(vname)
        @body.append(" = ")
        @emit_expr(init)
        @body.append(";\n")
    } else {
        ice("emit_c: binding initializer is neither a match, a ctor nor an expression")
    }
}
