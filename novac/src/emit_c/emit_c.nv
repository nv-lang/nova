// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/emit_c — backend A: C text (architecture §2/§9).
//
// E1 vertical: the runtime SHELL is a fixed, file-independent template
// (shell.tpl.c, embedded at build time — proven by the day's probe: the
// existing driver cc+links it against the real nova_rt and the binary runs).
// The emitter generates ONLY the two slots: string-literal definitions and
// the body of nova_fn_main_impl. Everything the shell contains — runtime
// init, effect vtables, supervisor bridge — is the oracle's own emission
// shape, extracted once; novac never invents ABI.
//
// E1 subset emitted here: fn main with println(str-lit) statements. The
// emitter is reached ONLY through pipeline and ONLY on a clean check —
// poisoning discipline: broken input never gets this far.
//
// Edge note (table §3): E1-temporary rows `emit_c` -> `tree`/`lex` mirror
// check's — the emitter walks the green tree until `lower` exists (E2);
// removal obligation recorded in the table.

module novac.emit_c

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}
import ../diag.{ice}

fn shell_template() -> []u8 => embed("shell.tpl.c")

/// Emit the whole C translation unit for a checked E1 file.
export fn emit(file Node) -> str {
    mut lits = []str.new()
    consume body = StringBuilder.new()
    emit_file(file, lits, body)
    render(lits, body.into_str())
}

fn render(lits []str, body str) -> str {
    ro tpl_bytes = shell_template()
    ro tpl = tpl_bytes.to_str() ?? ice("emit: shell.tpl.c is not UTF-8")
    consume out = StringBuilder.new()
    mut emitted_lits = false
    mut emitted_body = false
    for line in tpl.lines() {
        if line.contains("__NOVAC_STRLITS__") {
            emit_strlit_defs(out, lits)
            emitted_lits = true
        } else if line.contains("__NOVAC_BODY__") {
            out.append(body)
            emitted_body = true
        } else {
            out.append(line)
            out.append("\n")
        }
    }
    if !emitted_lits || !emitted_body { ice("emit: template slots missing") }
    out
}

fn emit_strlit_defs(mut out StringBuilder, lits []str) -> () {
    mut i = 0
    for raw in lits {
        // raw is the token text INCLUDING quotes; escapes verbatim. The E1
        // subset string has no interpolation (lex refuses it), and Nova's
        // escape set in the subset (\" \\ \n) matches C's — recorded subset
        // boundary, the diff gate holds it honest.
        out.append("static const uint8_t _novac_strlit_${i}_buf[] = ")
        out.append(raw)
        out.append(";\n")
        out.append("static const nova_str _novac_strlit_${i} = { .ptr = _novac_strlit_${i}_buf, .len = sizeof(_novac_strlit_${i}_buf) - 1 };\n")
        i += 1
    }
}

fn emit_file(file Node, mut lits []str, mut body StringBuilder) -> () {
    match file {
        Leaf(_) => ice("emit: file node must be a branch")
        Branch { kind, children } => {
            if kind != NodeKind.File { ice("emit: root is not File") }
            for c in children {
                if c.kind_of() == NodeKind.FnDecl {
                    emit_fn(c, lits, body)
                }
            }
        }
    }
}

fn branch_children(n Node) -> []Node {
    match n {
        Leaf(_) => ice("emit: expected a branch node")
        Branch { children, .. } => children
    }
}

fn leaf_text(n Node) -> str {
    match n {
        Leaf(t) => t.text
        Branch { .. } => ice("emit: expected a leaf")
    }
}

fn leaf_kind(n Node) -> TokenKind {
    match n {
        Leaf(t) => t.kind
        Branch { .. } => ice("emit: expected a leaf")
    }
}

// E1 user functions are all (nova_int...) -> nova_int; main is the impl slot.
fn emit_fn(f Node, mut lits []str, mut body StringBuilder) -> () {
    ro kids = branch_children(f)
    ro name = leaf_text(kids[1])
    if name == "main" {
        body.append("static nova_unit nova_fn_main_impl(void) {\n")
    } else {
        body.append("static nova_int novac_user_${name}(")
        mut first = true
        for c in kids {
            if c.kind_of() == NodeKind.Param {
                if !first { body.append(", ") }
                body.append("nova_int ")
                body.append(leaf_text(branch_children(c)[0]))
                first = false
            }
        }
        if first { body.append("void") }
        body.append(") {\n")
    }
    for c in kids {
        if c.kind_of() == NodeKind.Block {
            emit_block_stmts_fn(c, lits, body, name != "main")
        }
    }
    if name == "main" {
        body.append("    return NOVA_UNIT;\n}\n")
    } else {
        body.append("    return (nova_int)0LL;\n}\n")
    }
}

fn emit_block_stmts(b Node, mut lits []str, mut body StringBuilder) -> () {
    emit_block_stmts_fn(b, lits, body, false)
}

fn is_expr_kind(k NodeKind) -> bool =>
    k == NodeKind.Bin || k == NodeKind.Lit || k == NodeKind.Name || k == NodeKind.Call

// tail=true: the LAST expression statement of an int fn body is its return
// value (Nova tail-expression semantics; arithmetic.nv relies on it).
fn emit_block_stmts_fn(b Node, mut lits []str, mut body StringBuilder, tail bool) -> () {
    ro kids = branch_children(b)
    mut last_branch = -1
    if tail {
        mut j = 0
        for c in kids {
            match c {
                Leaf(_) => {}
                Branch { .. } => { last_branch = j }
            }
            j += 1
        }
    }
    mut j = 0
    for c in kids {
        match c {
            Leaf(_) => {} // the block's own braces -- trivia carriers, not statements
            Branch { .. } => {
                if tail && j == last_branch && is_expr_kind(c.kind_of()) && c.kind_of() != NodeKind.Call {
                    body.append("    return ")
                    emit_expr(c, body)
                    body.append(";\n")
                } else {
                    emit_stmt(c, lits, body)
                }
            }
        }
        j += 1
    }
}

fn emit_stmt(st Node, mut lits []str, mut body StringBuilder) -> () {
    ro k = st.kind_of()
    if k == NodeKind.Call {
        emit_println(st, lits, body)
    } else if k == NodeKind.IfStmt {
        ro kids = branch_children(st)
        body.append("    if (")
        emit_expr(kids[1], body)
        body.append(") {\n")
        emit_block_stmts(kids[2], lits, body)
        body.append("    }\n")
    } else if k == NodeKind.RetStmt {
        ro kids = branch_children(st)
        body.append("    return ")
        if kids.len() > 1 { emit_expr(kids[1], body) } else { body.append("NOVA_UNIT") }
        body.append(";\n")
    } else if k == NodeKind.BindStmt {
        ro kids = branch_children(st)
        body.append("    nova_int ")
        body.append(leaf_text(kids[1]))
        body.append(" = ")
        emit_expr(kids[3], body)
        body.append(";\n")
    } else if k == NodeKind.AssignStmt {
        ro kids = branch_children(st)
        ro target = expr_leaf_name(kids[0])
        body.append("    ")
        body.append(target)
        if leaf_kind(kids[1]) == TokenKind.PlusAssign {
            body.append(" = nova_int_checked_add(")
            body.append(target)
            body.append(", ")
            emit_expr(kids[2], body)
            body.append(")")
        } else {
            body.append(" = ")
            emit_expr(kids[2], body)
        }
        body.append(";\n")
    } else if k == NodeKind.ForStmt {
        ro kids = branch_children(st)
        ro v = leaf_text(kids[1])
        ro range = branch_children(kids[3]) // Bin: [lo, .., hi]
        body.append("    for (nova_int ${v} = ")
        emit_expr(range[0], body)
        body.append("; ${v} < ")
        emit_expr(range[2], body)
        body.append("; ${v}++) {\n")
        emit_block_stmts(kids[4], lits, body)
        body.append("    }\n")
    } else if k == NodeKind.Bin || k == NodeKind.Lit || k == NodeKind.Name {
        body.append("    (void)(")
        emit_expr(st, body)
        body.append(");\n")
    } else {
        ice("emit: statement kind outside the E1 subset")
    }
}

fn expr_leaf_name(e Node) -> str {
    ro kids = branch_children(e)
    leaf_text(kids[0])
}

fn checked_op(op TokenKind) -> str {
    if op == TokenKind.Plus { return "nova_int_checked_add" }
    if op == TokenKind.Minus { return "nova_int_checked_sub" }
    if op == TokenKind.Star { return "nova_int_checked_mul" }
    if op == TokenKind.Slash { return "nova_int_checked_div" }
    ""
}

fn cmp_op(op TokenKind) -> str {
    if op == TokenKind.Lt { return "<" }
    if op == TokenKind.Le { return "<=" }
    ""
}

fn emit_expr(e Node, mut body StringBuilder) -> () {
    ro k = e.kind_of()
    if k == NodeKind.Lit {
        ro t = branch_children(e)[0]
        if leaf_kind(t) == TokenKind.IntLit {
            body.append("((nova_int)")
            body.append(leaf_text(t))
            body.append("LL)")
        } else {
            ice("emit: string literal in a value position is outside E1")
        }
    } else if k == NodeKind.Name {
        body.append(expr_leaf_name(e))
    } else if k == NodeKind.Call {
        ro kids = branch_children(e)
        body.append("novac_user_")
        body.append(call_callee_text(kids))
        body.append("(")
        mut first = true
        for c in kids {
            ro ck = c.kind_of()
            if ck == NodeKind.Bin || ck == NodeKind.Lit || ck == NodeKind.Name || ck == NodeKind.Call {
                if !first { body.append(", ") }
                emit_expr(c, body)
                first = false
            }
        }
        body.append(")")
    } else if k == NodeKind.Bin {
        ro kids = branch_children(e)
        ro op = leaf_kind(kids[1])
        ro chk = checked_op(op)
        if chk != "" {
            body.append(chk)
            body.append("(")
            emit_expr(kids[0], body)
            body.append(", ")
            emit_expr(kids[2], body)
            body.append(")")
            return
        }
        ro cmp = cmp_op(op)
        if cmp != "" {
            body.append("((nova_int)((")
            emit_expr(kids[0], body)
            body.append(") ")
            body.append(cmp)
            body.append(" (")
            emit_expr(kids[2], body)
            body.append(")))")
            return
        }
        ice("emit: binary operator outside the E1 subset")
    } else {
        ice("emit: expression kind outside the E1 subset")
    }
}

fn call_callee_text(kids []Node) -> str {
    match kids[0] {
        Leaf(t) => t.text
        Branch { children, .. } => {
            match children[0] {
                Leaf(t) => t.text
                Branch { .. } => ""
            }
        }
    }
}

fn emit_println(call Node, mut lits []str, mut body StringBuilder) -> () {
    ro kids = branch_children(call)
    if call_callee_text(kids) != "println" {
        ice("emit: E1 subset knows only println calls in statement position")
    }
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Lit && leaf_kind(branch_children(c)[0]) == TokenKind.StrLit {
            ro t = branch_children(c)[0]
            ro idx = lits.len()
            lits.push(leaf_text(t))
            body.append("    nova_print_str(_novac_strlit_${idx});\n")
        } else if ck == NodeKind.Lit || ck == NodeKind.Bin || ck == NodeKind.Name || ck == NodeKind.Call {
            body.append("    nova_print_int(")
            emit_expr(c, body)
            body.append(");\n")
        }
    }
    body.append("    nova_print_newline();\n")
}
