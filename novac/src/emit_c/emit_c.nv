// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Nim `ccgexprs`/`ccgstmts` (C emitted as text from a typed tree, one
// procedure per node kind, string builder per function) + Chicken Scheme's
// C backend for "the runtime shell is a fixed template with slots"; the walk
// hangs on one `Emitter` receiver as Go `*Checker` / Zig `*Sema` / Roslyn
// `Binder` do (П15). NOT taken: Nim's `TLoc` value-location machinery (no
// register/temp allocator here — arguments will hoist into temporaries per
// F65), any GC-shape or dictionary path (full mono by D122). The CURRENT
// record/sum/match/println shapes are a starting point held by the diff gate,
// not an obligation (274 §7.0); the current compiler is NOT a donor (П25,
// П27 2a) — matching its output is what the smoke measures, not where the
// shape comes from.
// Role: layer 11 — backend A, C text; renders decisions already made, decides nothing (architecture, checker/codegen boundary).
// Used by: the smoke and diff-corpus (E1-E2); replaced below lower at E4 for a native backend, kept as the normative one.
// Guarded by: novac-e1-smoke.sh (behaviour identical to the oracle binary), check-novac-shell-freshness.sh (the shell is the oracle's emission), check-novac-no-default-branch.sh, check-novac-no-alloc-in-lookup.sh (an emitter is not a door).
// copying, and the oracle's shape is a fixed point of BEHAVIOUR only (П25,
// plan 274 §7.0); the walk hangs on one `Emitter` receiver like Go's
// `*Checker` and Zig's `*Sema` (П15).
// novac/src/emit_c — backend A: C text (architecture §2/§9).
//
// E2 vertical: the runtime SHELL is a fixed, file-independent template
// (shell.tpl.c) REGENERATED BY MACHINE from the umbrella probe
// (novac/probe/shell_probe.nv + scripts/tools/novac-regen-shell.sh): the
// probe's oracle emission IS the shell, so every std helper the emitter can
// reference survives the oracle's DCE. The emitter generates ONLY the two
// slots: string-literal definitions and the user code (type declarations
// first, then functions, main included). novac never invents ABI — a form
// whose helper is missing in the probe dies loudly at the smoke's link
// step, and the probe grows the same wave.
//
// This module is C RENDER ONLY (owner's review 2026-08-15): the type
// registry, the unified def table and expression typing live in `sem` —
// any backend consumes them, none owns them (the rustc_middle model). A
// libFirm backend (plan §12) imports the same sem and renders its own IR.
//
// The walk hangs on ONE receiver, `Emitter` (convention П15): the registry
// it reads, the literal pool and the code it writes, and the locals visible
// at the current point used to ride every signature as four parameters.
// They are the state of one emission, so they are fields — the shape of
// every reference (rustc's `Builder`, Roslyn's `Binder`, Go's `*Checker`,
// Zig's `*Sema`). The data flow stays visible in the type; nothing became
// ambient.
//
// Records and sums currently emit in the oracle's shape - values are GC
// pointers, constructors alloc + store, spread copies then overrides, field
// access is (p->x), sums are a tag enum plus a tagged union with a maker per
// variant, match is scrutinee/result/matched-flag with an if-chain and guards
// nesting one more if. That is a STARTING POINT, no longer an obligation
// (plan 274 section 7.0, owner 2026-08-16): identity with the oracle is owed
// on BEHAVIOUR and on the ABI boundary, never on the shape of the emission.
// Where a different shape is better - argument temporaries in source order
// (F65), tuples as stack values, one allocation fewer - novac is expected to
// diverge, with a line in docs/dev/novac-divergences.md saying why.
//
// Edge note (table §3): E2-temporary rows `emit_c` -> `tree`/`lex`/`names`/
// `sem` — the emitter walks the green tree until `lower` exists (E4);
// removal obligation recorded in the table.

module novac.emit_c

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind, BinOp, UnOp, AssignOp, bin_op, un_op, assign_op}
import ../diag.{ice}
import ../sem.{Ctx, CheckOut, DefKind, branch_children, leaf_text, leaf_kind, is_expr_kind, expr_leaf_name, call_callee_text, c_type, c_struct, c_tag, c_maker, c_method, c_fn}
import ../builtins.{ENTRY_FN, PRINT_FN}

/// The runtime shell, embedded at build time (regenerated by novac-regen-shell.sh).
fn shell_template() -> []u8 => embed("shell.tpl.c")

/// One C translation unit under construction: everything the emitter reads
/// and writes while it walks one file. The text builder is a resource, so
/// the emitter is a `consume` value — created once, walked, finished once.
type Emitter consume {
    ctx Ctx /// type registry and def table — read only, built by sem
    out CheckOut /// THE checker's channel: every type question is a READ here, never a re-derivation (E2-b1)
    lits []str /// string literals in registration order; the index is the C name suffix
    consume body StringBuilder /// the code slot of the shell, built in a single pass
}

/// Finish the emission: the literal pool AND the accumulated code, together.
/// Named `into_*` because it is a consume conversion into a different type
/// (nv-coding-style §1a, caught by `nova lint` once it was pointed at novac).
///
/// Returning both is not a convenience. The owner's review 2026-08-16 killed
/// the previous shape, which read `e.lits` into a binding and then consumed
/// `e` in the same call: the binding copies only a POINTER, so nothing in
/// the TYPE stops a consume method from touching that same object — the
/// safety rested on the body of `finish`, not on anything checkable. Worse,
/// it leaned on argument evaluation order, and a probe the same day showed
/// the C backend evaluating arguments RIGHT-TO-LEFT despite the spec calling
/// left-to-right normative (reported to the compiler window). One move, one
/// result: no aliasing question and no order to depend on.
fn Emitter consume @into_parts() -> ([]str, str) => (@lits, @body.into_str())

/// Emit the whole C translation unit for a checked subset file. The channel
/// comes from the checker and is not optional: an emitter that could fall
/// back to computing a type itself is an emitter with a second opinion, and
/// the second opinion is what plan 196 spent a wave deleting.
export fn emit(file Node, ctx Ctx, out CheckOut) -> str {
    consume e = Emitter { ctx, out, lits: []str.new(), body: StringBuilder.new() }
    e.emit_type_decls()
    e.emit_file(file)
    ro (lits, code) = e.into_parts()
    render(lits, code)
}


/// Emit declarations for every user type of the file (shell owns the rest).
/// The dispatch is an EXHAUSTIVE match over TypeKind, not an if-chain ending
/// in `else`: the owner's rule 2026-08-16. An `else` on a closed set means
/// "everything I did not name is a sum", so a fourth kind would be emitted as
/// a sum in silence — the #652 class again. With a match, a new variant is a
/// compile error at exactly this line.
fn Emitter mut @emit_type_decls() -> () {
    for t in 0..@ctx.types.len() {
        ro td = @ctx.types[t]
        match td.kind {
            TkPrim => {} // primitives own no declarations
            TkRecord => @emit_record_decl(t)
            TkSum => @emit_sum_decl(t)
            TkApp => ice("emit_c: declaration of an applied type — instances are emitted by mono, E2-b2")
            TkParam => ice("emit_c: declaration of a type parameter — nothing to declare, and nothing should ask")
            TkInfer => ice("emit_c: declaration of an inference variable — a variable escaped its body")
        }
    }
}

/// Record: a typedef plus the struct with one member per field row, in the
/// declaration order the registry stored (TypeDef.row_off/row_cnt).
fn Emitter mut @emit_record_decl(rec_id int) -> () {
    ro td = @ctx.types[rec_id]
    ro sn = c_struct(@ctx, rec_id)
    @body.append("typedef struct ${sn} ${sn};\n")
    @body.append("struct ${sn} {\n")
    for j in td.row_off..td.row_off + td.row_cnt {
        ro fd = @ctx.fields.rows[j]
        @body.append("    ")
        @body.append(c_type(@ctx, fd.type_id))
        @body.append(" ")
        @body.append(fd.name)
        @body.append(";\n")
    }
    @body.append("};\n\n")
}

/// Sum: tag enum + tagged union + a maker per variant — the oracle's exact
/// shape (fixed point on match_demo.nv), novac's own namespace. The type's
/// variant rows are the TypeDef.row_off/cnt range; each variant's payload
/// rows are VariantDef.payload_off/cnt — no filter loops (compile speed first).
fn Emitter mut @emit_sum_decl(sum_id int) -> () {
    ro td = @ctx.types[sum_id]
    ro sn = c_struct(@ctx, sum_id)
    ro vend = td.row_off + td.row_cnt
    @body.append("typedef enum {\n")
    for v in td.row_off..vend {
        @body.append("    ${c_tag(@ctx, v)},\n")
    }
    @body.append("} ${sn}_Tag;\n")
    @body.append("typedef struct ${sn} ${sn};\n")
    @body.append("struct ${sn} {\n    ${sn}_Tag tag;\n    union {\n")
    for v in td.row_off..vend {
        ro vd = @ctx.variant_rows[v]
        @body.append("        struct {\n")
        for p in 0..vd.payload_cnt {
            @body.append("            ")
            @body.append(c_type(@ctx, @ctx.payload_types[vd.payload_off + p]))
            @body.append(" _${p};\n")
        }
        @body.append("        } ${vd.name};\n")
    }
    @body.append("    } payload;\n};\n\n")
    for v in td.row_off..vend {
        ro vd = @ctx.variant_rows[v]
        @body.append("static ${sn}* ${c_maker(@ctx, v)}(")
        for p in 0..vd.payload_cnt {
            if p > 0 { @body.append(", ") }
            @body.append(c_type(@ctx, @ctx.payload_types[vd.payload_off + p]))
            @body.append(" _${p}")
        }
        if vd.payload_cnt == 0 { @body.append("void") }
        @body.append(") {\n    ${sn}* _r = (${sn}*)nova_alloc(sizeof(${sn}));\n")
        @body.append("    _r->tag = ${c_tag(@ctx, v)};\n")
        for q in 0..vd.payload_cnt {
            @body.append("    _r->payload.${vd.name}._${q} = _${q};\n")
        }
        @body.append("    return _r;\n}\n\n")
    }
}

/// Splice string literals and the emitted body into the shell's two slots.
fn render(lits []str, body str) -> str {
    ro tpl_bytes = shell_template()
    ro tpl = tpl_bytes.to_str() ?? ice("emit: shell.tpl.c is not UTF-8")
    consume out = StringBuilder.new()
    mut emitted_lits = false
    mut emitted_body = false
    for line in tpl.lines() {
        if line.contains("__NOVAC_STRLITS__") {
            emit_strlit_defs(out, lits)
            emitted_lits = true
        } else if line.contains("__NOVAC_BODY__") {
            out.append(body)
            emitted_body = true
        } else {
            out.append(line)
            out.append("\n")
        }
    }
    if !emitted_lits || !emitted_body { ice("emit: template slots missing") }
    out
}

/// Emit one static nova_str per registered string literal.
fn emit_strlit_defs(mut out StringBuilder, lits []str) -> () {
    mut i = 0
    for raw in lits {
        // raw is the token text INCLUDING quotes; escapes verbatim. The
        // subset string has no interpolation (lex refuses it), and Nova's
        // escape set in the subset (\" \\ \n) matches C's — recorded subset
        // boundary, the diff gate holds it honest.
        out.append("static const uint8_t _novac_strlit_${i}_buf[] = ")
        out.append(raw)
        out.append(";\n")
        out.append("static const nova_str _novac_strlit_${i} = { .ptr = _novac_strlit_${i}_buf, .len = sizeof(_novac_strlit_${i}_buf) - 1 };\n")
        i += 1
    }
}

/// Emit every fn declaration of the file in source order.
fn Emitter mut @emit_file(file Node) -> () {
    match file {
        Leaf(_) => ice("emit: file node must be a branch")
        Branch { kind, children, .. } => {
            if kind != NodeKind.File { ice("emit: root is not File") }
            for c in children {
                if c.kind_of() == NodeKind.FnDecl {
                    @emit_fn(c)
                }
            }
        }
    }
}

// ---- functions -----------------------------------------------------------

/// Emit one function: main becomes nova_fn_main_impl, others novac_user_<name>.
fn Emitter mut @emit_fn(f Node) -> () {
    ro kids = branch_children(f)
    ro name = leaf_text(kids[1])
    ro d = @ctx.defs.find(name)
    if d < 0 { ice("emit: fn missing from the registry") }
    // One row read, then its parts are named (owner's style note 2026-08-16:
    // repeating `@ctx.defs.rows[d]` reads the same row three times and hides
    // that it IS the same row).
    ro { kind: def_kind, payload: fn_row } = @ctx.defs.rows[d]
    if def_kind != DefKind.DefFn { ice("emit: fn name shadowed by a non-fn def (check's ground, later wave)") }
    ro ret = @ctx.fns.rows[fn_row].ret_id // -1 for main only; check refuses it elsewhere
    mut has_expr_body = false
    if name == ENTRY_FN {
        @body.append("static nova_unit ${c_fn(name, true)}(void) {\n")
    } else {
        @body.append("static ")
        @body.append(c_type(@ctx, ret))
        @body.append(" ${c_fn(name, false)}(")
        mut first = true
        for c in kids {
            if c.kind_of() == NodeKind.Param {
                ro pk = branch_children(c)
                ro pname = leaf_text(pk[0])
                mut ptype = -1
                if pk.len() > 1 && pk[1].kind_of() == NodeKind.LeafNode {
                    if leaf_kind(pk[1]) == TokenKind.Ident {
                        ptype = @ctx.defs.type_id(leaf_text(pk[1]))
                    }
                }
                if ptype < 0 { ice("emit: param without a type past check — no silent int default (#652 class)") }
                if !first { @body.append(", ") }
                @body.append(c_type(@ctx, ptype))
                @body.append(" ")
                @body.append(pname)
                first = false
            }
        }
        if first { @body.append("void") }
        @body.append(") {\n")
    }
    for c in kids {
        if c.kind_of() == NodeKind.Block {
            @emit_block_stmts_fn(c, name != ENTRY_FN)
        }
        if c.kind_of() == NodeKind.FnExprBody {
            has_expr_body = true
            ro ek = branch_children(c)
            ro e = ek[ek.len() - 1]
            if e.kind_of() == NodeKind.MatchExpr {
                @emit_match(e, name, ret)
                @body.append("    return _novac_match_${name};\n")
            } else if is_expr_kind(e.kind_of()) {
                @body.append("    return ")
                @emit_expr(e)
                @body.append(";\n")
            } else {
                ice("emit_c: fn expression body is neither a match nor an expression")
            }
        }
    }
    if name == ENTRY_FN {
        @body.append("    return NOVA_UNIT;\n}\n")
    } else {
        // Trailing safety return only for block bodies of int fns (the E1
        // shape); an expression body IS the return, and non-int returns
        // never fall through in the subset.
        if !has_expr_body && ret == @ctx.prims.int_id { @body.append("    return (nova_int)0LL;\n") }
        @body.append("}\n")
    }
}

/// The oracle's match scheme (fixed point on match_demo.nv): scrutinee tmp,
/// result var, matched flag, then an if-chain — literal pattern compares,
/// binder pattern binds (guard nests one more if), variant pattern checks
/// the tag and unpacks payload fields in order. uniq must be unique per
/// function body: the binding name or the fn name.
fn Emitter mut @emit_match(m Node, uniq str, res_t int) -> () {
    ro kids = branch_children(m)
    ro scr = kids[1]
    ro scr_t = @out.type_of(scr.id_of())
    @body.append("    ")
    @body.append(c_type(@ctx, scr_t))
    @body.append(" _novac_scr_${uniq} = ")
    @emit_expr(scr)
    @body.append(";\n    ")
    @body.append(c_type(@ctx, res_t))
    @body.append(" _novac_match_${uniq};\n")
    @body.append("    int _novac_matched_${uniq} = 0;\n")
    for c in kids {
        if c.kind_of() == NodeKind.MatchArm {
            @emit_arm(c, uniq, scr_t)
        }
    }
}

/// Tag test of a variant pattern: user sums are GC pointers with novac's own
/// tag names; std sums (Option) are VALUES with the oracle's tag names.
fn Emitter mut @emit_tag_test(uniq str, vrow int) -> () {
    @body.append("(_novac_scr_${uniq}->tag == ${c_tag(@ctx, vrow)})")
}

/// Emit one match arm: pattern test, binder unpacking, optional guard, arm value.
fn Emitter mut @emit_arm(arm Node, uniq str, scr_t int) -> () {
    ro ak = branch_children(arm)
    ro pat = branch_children(ak[0])
    ro arm_e = ak[ak.len() - 1]
    mut has_guard = false
    for g in ak {
        if g.kind_of() == NodeKind.Guard { has_guard = true }
    }
    @body.append("    if (!_novac_matched_${uniq} && (")
    ro p0 = pat[0]
    mut vrow = -1
    if leaf_kind(p0) == TokenKind.IntLit {
        @body.append("(_novac_scr_${uniq} == ")
        @body.append(leaf_text(p0))
        @body.append("LL)")
    } else if leaf_kind(p0) == TokenKind.Ident {
        // A bare `None` (no parens) is a variant too — resolve by name
        // regardless of arity; only a NON-variant ident is a binder.
        ro d = @ctx.defs.find(leaf_text(p0))
        if d >= 0 {
            ro { kind: def_kind, payload: def_payload } = @ctx.defs.rows[d]
            if def_kind == DefKind.DefVariant { vrow = def_payload }
        }
        if vrow >= 0 {
            @emit_tag_test(uniq, vrow)
        } else {
            @body.append("true")
        }
    } else {
        ice("emit_c: match pattern is neither an int literal nor an identifier")
    }
    @body.append(")) {\n")
    if vrow >= 0 {
        // Unpack payload fields onto the arm's binders, in order: binder
        // names sit after '(' in the pattern; field types are the variant's
        // rows of the flat context.
        ro vname = leaf_text(p0)
        mut binders = []str.new()
        mut j = 2
        while j < pat.len() {
            // [LEGACY-#676] var-index-method: same workaround as in
            // collect_types: variable-index receiver miscompiles.
            ro pj = pat[j]
            if pj.kind_of() == NodeKind.LeafNode {
                if leaf_kind(pj) == TokenKind.Ident { binders.push(leaf_text(pj)) }
            }
            j += 1
        }
        mut pi = 0
        for bname in binders {
            ro bt = @ctx.payload_types[@ctx.variant_rows[vrow].payload_off + pi]
            @body.append("        ")
            @body.append(c_type(@ctx, bt))
            @body.append(" ${bname} = _novac_scr_${uniq}->payload.${vname}._${pi};\n")
            pi += 1
        }
    } else if leaf_kind(p0) == TokenKind.Ident && leaf_text(p0) != "_" {
        // Plain binder: the scrutinee under a new name.
        @body.append("        ")
        @body.append(c_type(@ctx, scr_t))
        @body.append(" ${leaf_text(p0)} = _novac_scr_${uniq};\n")
    }
    if has_guard {
        for g in ak {
            if g.kind_of() == NodeKind.Guard {
                @body.append("        if (")
                @emit_expr(branch_children(g)[1])
                @body.append(") {\n")
            }
        }
        @body.append("            _novac_match_${uniq} = ")
        @emit_expr(arm_e)
        @body.append(";\n            _novac_matched_${uniq} = 1;\n        }\n")
    } else {
        @body.append("        _novac_match_${uniq} = ")
        @emit_expr(arm_e)
        @body.append(";\n        _novac_matched_${uniq} = 1;\n")
    }
    @body.append("    }\n")
}

/// tail=true: the LAST expression statement of an int fn body is its return
/// value (Nova tail-expression semantics; arithmetic.nv relies on it).
fn Emitter mut @emit_block_stmts_fn(b Node, tail bool) -> () {
    ro kids = branch_children(b)
    mut last_branch = -1
    if tail {
        mut j = 0
        for c in kids {
            match c {
                Leaf(_) => {}
                Branch { .. } => { last_branch = j }
            }
            j += 1
        }
    }
    mut j = 0
    for c in kids {
        match c {
            Leaf(_) => {} // the block's own braces -- trivia carriers, not statements
            Branch { .. } => {
                if tail && j == last_branch && is_expr_kind(c.kind_of()) && c.kind_of() != NodeKind.Call {
                    @body.append("    return ")
                    @emit_expr(c)
                    @body.append(";\n")
                } else {
                    @emit_stmt(c)
                }
            }
        }
        j += 1
    }
}

/// Emit one statement by node kind (call/if/while/return/bind/assign/for/expr).
fn Emitter mut @emit_stmt(st Node) -> () {
    ro k = st.kind_of()
    if k == NodeKind.Call {
        @emit_call_stmt(st)
    } else if k == NodeKind.IfStmt {
        ro kids = branch_children(st)
        @body.append("    if (")
        @emit_expr(kids[1])
        @body.append(") {\n")
        @emit_block_stmts_fn(kids[2], false)
        @body.append("    }\n")
    } else if k == NodeKind.WhileStmt {
        ro kids = branch_children(st)
        @body.append("    while (")
        @emit_expr(kids[1])
        @body.append(") {\n")
        @emit_block_stmts_fn(kids[2], false)
        @body.append("    }\n")
    } else if k == NodeKind.RetStmt {
        ro kids = branch_children(st)
        @body.append("    return ")
        if kids.len() > 1 { @emit_expr(kids[1]) } else { @body.append("NOVA_UNIT") }
        @body.append(";\n")
    } else if k == NodeKind.BindStmt {
        @emit_bind(st)
    } else if k == NodeKind.AssignStmt {
        ro kids = branch_children(st)
        ro target = expr_leaf_name(kids[0])
        @body.append("    ")
        @body.append(target)
        @body.append(" = ")
        // A compound assignment IS its binary operator plus a store, so it
        // reuses the ONE form table rather than repeating it (`a += b` is
        // `a = a + b`, which is also how the protocol path will read on user
        // types: `a = a.@plus(b)`, D46).
        match assign_op(leaf_kind(kids[1])) {
            Set => @emit_expr(kids[2])
            Update(op) => {
                ro form = c_binary_form(op, false)
                if is_bit_infix(op) {
                    @body.append("((")
                    @body.append(target)
                    @body.append(") ")
                    @body.append(form)
                    @body.append(" (")
                    @emit_expr(kids[2])
                    @body.append("))")
                } else {
                    @body.append(form)
                    @body.append("(")
                    @body.append(target)
                    @body.append(", ")
                    @emit_expr(kids[2])
                    @body.append(")")
                }
            }
        }
        @body.append(";\n")
    } else if k == NodeKind.ForStmt {
        ro kids = branch_children(st)
        ro v = leaf_text(kids[1])
        ro range = branch_children(kids[3]) // Bin: [lo, .., hi]
        @body.append("    for (nova_int ${v} = ")
        @emit_expr(range[0])
        @body.append("; ${v} < ")
        @emit_expr(range[2])
        @body.append("; ${v}++) {\n")
        @emit_block_stmts_fn(kids[4], false)
        @body.append("    }\n")
    } else if is_expr_kind(k) {
        @body.append("    (void)(")
        @emit_expr(st)
        @body.append(");\n")
    } else {
        ice("emit: statement kind outside the subset")
    }
}

/// Binding. A record-constructor initializer follows the oracle's tmp scheme
/// (fixed point on records.nv); a match initializer follows the match
/// scheme; everything else is a plain typed local.
fn Emitter mut @emit_bind(st Node) -> () {
    ro kids = branch_children(st)
    ro vname = leaf_text(kids[1])
    ro init = kids[kids.len() - 1]
    ro vtype = @out.type_of(init.id_of())
    if init.kind_of() == NodeKind.MatchExpr {
        @emit_match(init, vname, vtype)
        @body.append("    ")
        @body.append(c_type(@ctx, vtype))
        @body.append(" ${vname} = _novac_match_${vname};\n")
        return
    }
    if init.kind_of() == NodeKind.RecordCtor {
        ro rec = c_struct(@ctx, vtype)
        ro tmp = "_novac_tmp_${vname}"
        @body.append("    ${rec}* ${tmp} = (${rec}*)nova_alloc(sizeof(${rec}));\n")
        for c in branch_children(init) {
            ro ck = c.kind_of()
            if ck == NodeKind.CtorSpread {
                @body.append("    *${tmp} = *")
                @emit_expr(branch_children(c)[1])
                @body.append(";\n")
            } else if ck == NodeKind.CtorField {
                ro fk = branch_children(c)
                ro fname = leaf_text(fk[0])
                @body.append("    ${tmp}->${fname} = ")
                if fk.len() > 1 {
                    @emit_expr(fk[2])
                } else {
                    // Punning: `Point { x }` stores the local of that name.
                    @body.append(fname)
                }
                @body.append(";\n")
            }
        }
        @body.append("    ${rec}* ${vname} = ${tmp};\n")
    } else if is_expr_kind(init.kind_of()) {
        @body.append("    ")
        @body.append(c_type(@ctx, vtype))
        @body.append(" ")
        @body.append(vname)
        @body.append(" = ")
        @emit_expr(init)
        @body.append(";\n")
    } else {
        ice("emit_c: binding initializer is neither a match, a ctor nor an expression")
    }
}

/// The C form of a binary operator ON PRIMITIVE OPERANDS, chosen by the
/// DECISION and the operand type -- one exhaustive match instead of the three
/// token-keyed tables this replaced (`checked_op`, `cmp_op`, `raw_op`), each
/// of which returned an empty string on anything it did not know and let the
/// next one guess.
///
/// PRIMITIVE is the load-bearing word (owner's correction 2026-08-16). In
/// Nova every operator is overloadable on user types through protocols
/// (D46/D363: `@plus`, `@compare`, `@equal`), so the emitted form is a
/// function of the operator AND the operand type. The subset emits only the
/// primitive half; `check` refuses the rest at the operator's position rather
/// than letting this table answer for a type it knows nothing about.
///
/// `is_float` comes from the checker's channel: float arithmetic is raw C
/// (the oracle's shape, and floats have no overflow trap), int arithmetic
/// goes through the runtime's checked helpers, comparisons are C operators
/// either way.
fn c_binary_form(op BinOp, is_float bool) -> str {
    match op {
        Add => {
            if is_float { return "+" }
            "nova_int_checked_add"
        }
        Sub => {
            if is_float { return "-" }
            "nova_int_checked_sub"
        }
        Mul => {
            if is_float { return "*" }
            "nova_int_checked_mul"
        }
        Div => {
            if is_float { return "/" }
            "nova_int_checked_div"
        }
        Modulo => {
            if is_float { ice("emit_c: the remainder operator has no float form in the subset") }
            "nova_int_checked_rem"
        }
        Less => "<"
        LessEq => "<="
        Greater => ">"
        GreaterEq => ">="
        Equal => "=="
        NotEqual => "!="
        AndAlso => "&&"
        OrElse => "||"
        BitAnd => "&"
        BitOr => "|"
        BitXor => "^"
        ShiftLeft => "<<"
        ShiftRight => ">>"
        Range => ice("emit_c: a range reached expression emission -- for-heads consume it")
    }
}

/// Does this operator emit as a C INFIX operator inside a truth-value cast?
/// Comparisons, equality and the logical pair all yield bool and share the
/// same C shape; the bitwise family is infix too but keeps int width, so it
/// is a third answer rather than a second.
fn is_truth_infix(op BinOp) -> bool {
    match op {
        Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse => true
        Add | Sub | Mul | Div | Modulo | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// Is this the equality pair? They are the operators whose C form depends on
/// the OPERAND type: scalars compare with `==`, `str` goes through `@equal`.
fn is_equality(op BinOp) -> bool {
    match op {
        Equal | NotEqual => true
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// `!=` is not a second protocol method: the spec DERIVES it from `@equal`
/// (D46 rule 3), so the emitter negates the same call.
fn op_is_not_equal(op BinOp) -> bool {
    match op {
        NotEqual => true
        Equal | Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | AndAlso | OrElse | BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight | Range => false
    }
}

/// Plain C infix with no cast: the bitwise and shift family on int.
fn is_bit_infix(op BinOp) -> bool {
    match op {
        BitAnd | BitOr | BitXor | ShiftLeft | ShiftRight => true
        Add | Sub | Mul | Div | Modulo | Less | LessEq | Greater | GreaterEq | Equal | NotEqual | AndAlso | OrElse | Range => false
    }
}

/// The C form of a prefix operator. `!` is logical on bool, `-` negates,
/// `~` complements -- all three are plain C on the primitives the subset
/// admits (check refuses the protocol cases).
fn c_unary_form(op UnOp) -> str {
    match op {
        Not => "!"
        Negate => "-"
        BitNot => "~"
    }
}

/// Is this operator a comparison? Derived from the decision (P22: derived is
/// a function, not a second table), and exhaustive so a new operator must
/// answer here too.
/// Emit one expression: literals, names, fields, method/fn calls, binary ops.
fn Emitter mut @emit_expr(e Node) -> () {
    ro k = e.kind_of()
    if k == NodeKind.Lit {
        ro lkids = branch_children(e)
        ro t = lkids[lkids.len() - 1]
        ro neg = lkids.len() > 1 // [Minus, lit]
        ro lk = leaf_kind(t)
        if lk == TokenKind.IntLit {
            @body.append("((nova_int)")
            if neg { @body.append("-") }
            @body.append(leaf_text(t))
            @body.append("LL)")
        } else if lk == TokenKind.FloatLit {
            @body.append("((nova_f64)")
            if neg { @body.append("-") }
            @body.append(leaf_text(t))
            @body.append(")")
        } else if lk == TokenKind.StrLit {
            // A string literal in value position (binding init, method
            // argument): registered like a println literal, referenced by
            // its C name — the oracle emits the same shape.
            ro idx = @lits.len()
            @lits.push(leaf_text(t))
            @body.append("_novac_strlit_${idx}")
        } else {
            ice("emit_c: literal kind outside the subset")
        }
    } else if k == NodeKind.Name {
        @body.append(expr_leaf_name(e))
    } else if k == NodeKind.FieldAccess {
        ro kids = branch_children(e)
        @body.append("(")
        @emit_expr(kids[0])
        @body.append("->")
        @body.append(leaf_text(kids[2]))
        @body.append(")")
    } else if k == NodeKind.MethodCall {
        // kids: [recv, '.', name, '(', args..., ')'] -> <Recv>_method_<name>(recv, args...)
        // The C receiver prefix follows the oracle's mono naming: str ->
        // Nova_str_method_, []int -> Vec____nova_int_method_.
        ro kids = branch_children(e)
        ro recv_t = @out.type_of(kids[0].id_of())
        @body.append(c_method(@ctx, recv_t, leaf_text(kids[2])))
        @body.append("(")
        @emit_expr(kids[0])
        mut i = 0
        for c in kids {
            if i > 2 && is_expr_kind(c.kind_of()) {
                @body.append(", ")
                @emit_expr(c)
            }
            i += 1
        }
        @body.append(")")
    } else if k == NodeKind.Call {
        ro kids = branch_children(e)
        ro cname = call_callee_text(kids)
        // ONE lookup, then the kind decides (owner's correction 2026-08-14).
        ro d = @ctx.defs.find(cname)
        if d < 0 { ice("emit: call target not in the registry (#652 class)") }
        ro { kind: def_kind, payload: def_payload } = @ctx.defs.rows[d]
        if def_kind == DefKind.DefVariant {
            // Variant constructor call -> the maker.
            ro vrow = def_payload
            @body.append("${c_maker(@ctx, vrow)}(")
        } else if def_kind == DefKind.DefFn {
            @body.append("${c_fn(cname, false)}(")
        } else {
            ice("emit_c: call target is neither a variant nor a fn")
        }
        mut first = true
        for c in kids {
            if is_expr_kind(c.kind_of()) {
                if !first { @body.append(", ") }
                @emit_expr(c)
                first = false
            }
        }
        @body.append(")")
    } else if k == NodeKind.Paren {
        @body.append("(")
        @emit_expr(branch_children(e)[1])
        @body.append(")")
    } else if k == NodeKind.Unary {
        ro kids = branch_children(e)
        @body.append("(")
        @body.append(c_unary_form(un_op(leaf_kind(kids[0]))))
        @body.append("(")
        @emit_expr(kids[1])
        @body.append("))")
    } else if k == NodeKind.Bin {
        ro kids = branch_children(e)
        ro op = bin_op(leaf_kind(kids[1]))
        // The RESULT of a comparison is bool, so the float test must look at
        // the OPERAND, not at the expression: `a < b` on two f64 is still an
        // f64 comparison. Arithmetic's result type equals its operands', so
        // the two agree there.
        ro is_float = @out.type_of(e.id_of()) == @ctx.prims.f64_id
        ro form = c_binary_form(op, is_float)
        // `str` equality is the protocol method, not a C operator (D46:
        // `a == b` is `a.@equal(b)`), and `!=` is DERIVED from it — the spec
        // states the derivation, so novac spells it the same way instead of
        // inventing a second method name (owner's reminder 2026-08-16).
        ro lhs_t = @out.type_of(kids[0].id_of())
        if lhs_t == @ctx.prims.str_id && is_equality(op) {
            @body.append("((nova_int)(")
            if op_is_not_equal(op) { @body.append("!") }
            @body.append(c_method(@ctx, lhs_t, "equal"))
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(")))")
        } else if is_bit_infix(op) {
            @body.append("((")
            @emit_expr(kids[0])
            @body.append(") ")
            @body.append(form)
            @body.append(" (")
            @emit_expr(kids[2])
            @body.append("))")
        } else if is_truth_infix(op) {
            @body.append("((nova_int)((")
            @emit_expr(kids[0])
            @body.append(") ")
            @body.append(form)
            @body.append(" (")
            @emit_expr(kids[2])
            @body.append(")))")
        } else if is_float {
            // f64 arithmetic is RAW C with left-assoc parens -- the oracle's
            // shape: ((((nova_f64)3.14) * r) * r). Never checked_*.
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(" ")
            @body.append(form)
            @body.append(" ")
            @emit_expr(kids[2])
            @body.append(")")
        } else {
            @body.append(form)
            @body.append("(")
            @emit_expr(kids[0])
            @body.append(", ")
            @emit_expr(kids[2])
            @body.append(")")
        }
    } else {
        ice("emit: expression kind outside the subset")
    }
}

/// Emit a CALL STATEMENT. The subset knows exactly one callee here,
/// `println`, and check refuses the rest — the ice below is the second
/// floor, not the first answer (owner's question 2026-08-16: the name
/// `emit_println` read as if every Call were a println).
/// One printer per argument by its type, then a newline.
fn Emitter mut @emit_call_stmt(call Node) -> () {
    ro kids = branch_children(call)
    if call_callee_text(kids) != PRINT_FN {
        ice("emit: the subset knows only println calls in statement position")
    }
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Lit && leaf_kind(branch_children(c)[0]) == TokenKind.StrLit {
            ro t = branch_children(c)[0]
            ro idx = @lits.len()
            @lits.push(leaf_text(t))
            @body.append("    nova_print_str(_novac_strlit_${idx});\n")
        } else if is_expr_kind(ck) {
            // Dispatch on the registry — the oracle prints each argument
            // with its own printer, newline once at the end.
            ro at = @out.type_of(c.id_of())
            if at == @ctx.prims.str_id {
                @body.append("    nova_print_str(")
            } else if at == @ctx.prims.bool_id {
                @body.append("    nova_print_bool(")
            } else if at == @ctx.prims.f64_id {
                @body.append("    nova_print_f64(")
            } else if at == @ctx.prims.int_id {
                @body.append("    nova_print_int(")
            } else {
                // Found by the generics scouting 2026-08-16: this used to be a
                // bare `else` printing anything unknown AS AN INT — a record
                // would have had its GC pointer printed as a number, in
                // silence. The set of types is open, so there is no exhaustive
                // match to write; the honest form is to name every case we
                // handle and refuse the rest. The first floor (a check-level
                // refusal) arrives with local typing, 274.3 wave 3 / C9.
                ice("emit_c: println of a type with no printer in the subset")
            }
            @emit_expr(c)
            @body.append(");\n")
        }
    }
    @body.append("    nova_print_newline();\n")
}
