// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: C's `assert` macro (`__FILE__`, `__LINE__`, `#expr` handed to a
// failure routine) -- taken as the shape of the call; NOT taken: NDEBUG, since
// D81 makes the check always on. The callee is the runtime's
// `nova_assert_loc(cond, text, file, line, msg)` inside a comma expression
// whose value is the unit, so the call is legal in any position. INTEROP,
// named as such: it lives in nova_rt effects.h, reached through the shell;
// goes the day novac emits the prelude.
// Role: the emission of the `assert` intrinsic the checker typed
//   (check/assert_call.nv): the condition, its display and line from the
//   channel's contract note on the call node, the file this unit names, and
//   the literal message or NULL; and of its sibling `panic(msg)` (D13): the
//   throw site stamped, then the runtime's `nv_panic`.
// Used by: emit_expr.nv (`@emit_expr`, the free-call branch with a note).
// Guarded by: novac/fixtures/assert_stmt (byte-for-byte with the oracle),
//   check-novac-differential.sh.

module novac.emit_c

import ../tree.{Node, raw_node}
import ../sem.{call_arg_at, is_arg_node, literal_as_c_text}
import ../lex.{TokenKind}
import ../diag.{ice}

/// `assert(cond[, msg])` as one C expression of type `nova_unit`.
fn Emitter mut @emit_assert(e Node, kids []Node) -> () {
    ro note = @out.contract_of(e.id_of()) ?? ice("emit_c: an assert the checker left without its note")
    @body.append("((void)nova_assert_loc(")
    @emit_expr(call_arg_at(kids, 1, 0))
    @body.append(", \"")
    @body.append(c_literal_escaped(note.display))
    @body.append("\", \"${@src_name}\", ${note.src_line}, ")
    if assert_msg_computed(kids) {
        // The C text the hoist copied out of the message value.
        @body.append(@lit_tmp[raw_node(call_arg_at(kids, 1, 1).id_of())])
    } else {
        @body.append(assert_msg_c(kids))
    }
    @body.append("), NOVA_UNIT)")
}

/// A message that is NOT a string literal -- an interpolation, a variable, a
/// call -- has its value only at run time, so the hoist copies it into C text
/// before the statement (`@hoist_assert_message`). Eager: the message is built
/// whether or not the condition holds, as an interpolated argument always was.
fn Emitter mut @hoist_assert_message(kids []Node) -> () {
    if !assert_msg_computed(kids) { return }
    ro msg = call_arg_at(kids, 1, 1)
    ro sv = "_novac_asv${@fresh_uniq()}"
    ro cs = "_novac_asc${@fresh_uniq()}"
    @body.append("    nova_str ${sv} = ")
    @emit_expr(msg)
    @body.append(";\n")
    @body.append("    char* ${cs} = (char*)nova_alloc(${sv}.len + 1);\n")
    @body.append("    if (${sv}.len) memcpy(${cs}, ${sv}.ptr, ${sv}.len);\n")
    @body.append("    ${cs}[${sv}.len] = '\\0';\n")
    @lit_tmp[raw_node(msg.id_of())] = cs
}

/// Does the call carry a message that is not a string literal?
fn assert_msg_computed(kids []Node) -> bool {
    mut n = 0
    mut at = 0
    for c in kids {
        if at >= 1 && is_arg_node(c) {
            n += 1
        } else {
            // The callee's name, or punctuation: not an argument.
        }
        at += 1
    }
    n == 2 && assert_msg_c(kids) == "NULL"
}

/// `panic(msg)` as one C expression, the oracle's shape: the throw site stamped
/// first (the runtime prints `at <file>:<line> (throw site)` after the message),
/// then `nv_panic`, which never returns; the trailing `0` gives the comma
/// expression the `never` type's C value (`nova_int`) for a value position.
fn Emitter mut @emit_panic_call(e Node, kids []Node) -> () {
    ro note = @out.contract_of(e.id_of()) ?? ice("emit_c: a panic the checker left without its note")
    @body.append("(nova_throw_site_set_dominant(\"${@src_name}\", ${note.src_line}), ${RT_DEATH_C}(")
    @emit_expr(call_arg_at(kids, 1, 0))
    @body.append("), (nova_int)0LL)")
}

/// The runtime's death entry (effects.h): never returns -- `longjmp` into the
/// fiber's frame, or abort.
const RT_DEATH_C = "nv_panic"

/// The message as C text: a string literal as written, anything else -- or no
/// message -- the runtime's NULL (the oracle's rule: only a literal is baked in).
fn assert_msg_c(kids []Node) -> str {
    mut n = 0
    mut at = 0
    for c in kids {
        if at >= 1 && is_arg_node(c) {
            n += 1
        } else {
            // The callee's name, or punctuation: not an argument.
        }
        at += 1
    }
    if n < 2 { return "NULL" }
    str_literal_c(call_arg_at(kids, 1, 1))
}

/// A plain string literal as C text, else NULL. The parser wraps a literal in
/// a branch of one leaf, so both shapes are asked.
fn str_literal_c(m Node) -> str {
    match m {
        Leaf(t) => {
            if t.kind == TokenKind.StrLit { return literal_as_c_text(t.text) }
            // Not a string literal: the runtime prints no message.
        }
        Branch { children, .. } => {
            // The literal's own wrapper is the one branch with a single child
            // (a parenthesised or computed message has more): look inside it.
            if children.len() == 1 { return str_literal_c(children[0]) }
            // A computed message: the same fallback.
        }
    }
    "NULL"
}
