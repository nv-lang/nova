// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc MIR codegen (`rustc_codegen_ssa::mir::codegen_assign`,
// `codegen_statement`): ONE place prints `dest = rvalue`, and the rvalue's form
// is dispatched once there, not at each position that produces a value; a
// statement is printed by its IR kind, not by walking the tree again. Not
// taken: LLVM values -- the target is C text, so "print" here is appending to
// the shell's body.
// Role: layer emit_c, the ONE printer of the lowered body's statements
//   (sub-plan 274.8, waves M1/M2a): every value position of the language --
//   block tail, `=>` body, `return`, binding, `??`, if-branch tail, match arm,
//   destructuring -- records `dest = Expr(e)` through `lower`'s door; every
//   statement expression records an evaluation, every assignment a store; all
//   are printed here from the recorded statement.
// Used by: emit_c.nv, emit_match.nv, emit_destructure.nv -- the positions.
// Guarded by: check-novac-lowering-one-door.py (the positions hold no kind
//   dispatch of their own, so the count only shrinks),
//   check-novac-differential.sh (behaviour does not move by one file).

module novac.emit_c

import ../tree.{Node, NodeKind, AssignOp}
import ../diag.{ice}
import ../sem.{is_value_tail_kind, c_type, c_instance_method, raw_vrow}
import ../types.{TyId, is_ty}
import ../lower.{Local, LocalDecl, AssignStmt, StoreStmt, Rvalue, Operand}
import ../builtins.{VEC_GET_METHOD}

/// Records `dest = e` in the lowered body and prints it at once -- the
/// streaming bridge of waves M1/M2a: statements are lowered and printed one
/// by one until M2b prints sealed blocks.
fn Emitter mut @lower_place(e Node, dest Local) -> () {
    // THE SOURCE IS RESOLVED FIRST (prerequisite 5): a value form that lays down blocks
    // is lowered NOW and the assignment reads the local it produced, through the operand
    // rvalue door `@ir.copy`. Otherwise the tree node stays the source -- the M1 bridge,
    // printed inline by `@emit_expr`.
    match @lower_value_source(e, @ir.decl_of(dest).ty) {
        Some(l) => @ir.copy(dest, l)
        None => @ir.place(e, dest)
    }
}

/// Records an expression evaluated for its effects and prints it at once.
fn Emitter mut @lower_eval(e Node) -> () {
    @ir.eval(e)
}

/// Records a store into a place the tree names and prints it at once.
fn Emitter mut @lower_store(target Node, op AssignOp, src Node) -> () {
    @ir.store(target, op, src)
}

/// Prints the statement recorded last, by its IR kind -- the one dispatch on
/// statement kind the printer has.
fn Emitter mut @emit_last_stmt() -> () {
    match @ir.last_stmt() {
        Assign(a) => @emit_assign(a)
        Eval(rv) => @emit_eval(rv)
        Store(st) => @emit_store(st)
        Decl(l) => @emit_decl(l)
    }
}

/// The declaration of a result temporary: `T name = (T){0};` at the body's indent. The
/// zero is not decoration -- see `LocalDecl.zero_init` for the two forms that need it and
/// why the lowering, not this printer, decides.
///
/// A `Decl` of a local that is NOT zero-initialised is a lowering bug, not a shape to
/// print: bindings are declared by their first assignment, and no form records a bare
/// declaration. It is named here rather than printed as dead code with no carrier.
fn Emitter mut @emit_decl(l Local) -> () {
    ro d = @ir.decl_of(l)
    if !d.zero_init {
        ice("emit: a Decl statement for a local that is not zero-initialised")
    }
    @body.append("    ${c_type(@ctx, d.ty)} ${d.name} = (${c_type(@ctx, d.ty)}){0};\n")
}

/// The tree expression behind an rvalue -- the M1 bridge; an operand rvalue
/// does not exist before M2 lowers one, and a payload read is printed by the
/// assignment printer alone (it is never evaluated for effect).
fn Emitter @expr_of(rv Rvalue) -> Node {
    match rv {
        Expr(n) => n
        Use(_) => ice("emit_c: an operand rvalue reached the printer before M2 lowers one")
        SomePayload(_) => ice("emit_c: a payload read reached expr_of -- only an assignment prints it")
        IndexPayload(_) => ice("emit_c: an element read reached expr_of -- only an assignment prints it")
        VariantField(_) => ice("emit_c: a variant field read reached expr_of -- only an assignment prints it")
    }
}

/// Prints one assignment of the lowered body: a tree value is built by
/// `build_value` (the ONE dispatch on the form of a value) and printed
/// inline or by the temporary it was built into; a payload read (wave
/// M2b-1b, the if-let binder) is the local's `.value` -- the shell's Option
/// ABI, INTEROP named in emit_option.nv. The line itself is spelled by the
/// local's role (`emit_assign_head`).
fn Emitter mut @emit_assign(a AssignStmt) -> () {
    ro d = @ir.decl_of(a.dest)
    match a.src {
        Expr(e) => {
            // Built FIRST: a construction lays its statements down before the
            // line that reads the temporary.
            ro built = @build_value(e, d.ty)
            @emit_assign_head(d)
            match built {
                Some(t) => @body.append(t)
                None => @emit_expr(e)
            }
            @body.append(";\n")
        }
        SomePayload(opt) => {
            @emit_assign_head(d)
            @body.append("${@ir.decl_of(opt).name}.value;\n")
        }
        IndexPayload(r) => {
            // The shell's `get` of the collection's instance hands back the
            // Option BY VALUE and the loop header proved the index in range,
            // so `.value` is always the element -- INTEROP (emit_option.nv).
            ro vd = @ir.decl_of(r.vec)
            ro get_c = c_instance_method(@ctx, vd.ty, VEC_GET_METHOD)
            @emit_assign_head(d)
            @body.append("${get_c}(${vd.name}, ${@ir.decl_of(r.idx).name}).value;\n")
        }
        VariantField(r) => {
            // The payload union of the shell's sum ABI (INTEROP, header):
            // the arm's test proved the variant, so the field is there.
            ro vname = @ctx.variant_rows[raw_vrow(r.vrow)].name
            @emit_assign_head(d)
            @body.append("${@ir.decl_of(r.scr).name}->payload.${vname}._${r.slot};\n")
        }
        // A plain binder of a match: the scrutinee under a new name. The
        // operand is read by its own door, so this arm holds one call and no
        // match sits nested on the payload the arm above just bound.
        Use(op) => {
            @emit_assign_head(d)
            @body.append("${@operand_name(op)};\n")
        }
    }
}

/// The C NAME of an operand: a local reads as its name; a tree operand does
/// not reach an assignment (the M1 bridge is `Rvalue.Expr`, not `Use`), and
/// this says so rather than printing something plausible.
fn Emitter @operand_name(op Operand) -> str {
    match op {
        Place(src) => @ir.decl_of(src).name
        Tree(_) => ice("emit_c: an operand of the tree reached emit_assign -- the bridge is Rvalue.Expr")
    }
}

/// The head of the line: `return ` for the return place, `T name = ` for a
/// binding (declared where it is first assigned), `        name = ` for a
/// temporary its creator declared.
fn Emitter mut @emit_assign_head(d LocalDecl) -> () {
    match d.kind {
        Return => @body.append("    return ")
        Binding => @body.append("    ${c_type(@ctx, d.ty)} ${d.name} = ")
        Temp => @body.append("        ${d.name} = ")
    }
}

/// An expression in STATEMENT position: a call keeps its own printer (the
/// arguments, their hoists, the receiver); a positional record is built and
/// dropped -- the effects of its components run in written order (B15 step
/// 4a); anything else is `(void)(e);`.
fn Emitter mut @emit_eval(rv Rvalue) -> () {
    ro e = @expr_of(rv)
    ro k = e.kind_of()
    if k == NodeKind.Call {
        @emit_call_stmt(e)
        return
    }
    if k == NodeKind.TupleExpr {
        ro dropped = @emit_record_ctor(e, @out.type_of(e.id_of()), true)
        @body.append("    (void)${dropped};\n")
        return
    }
    @body.append("    (void)(")
    @emit_expr(e)
    @body.append(");\n")
}

/// A store: THE TARGET IS WRITTEN THE WAY IT IS READ -- as an expression, so a
/// plain name and `@field` take one path (measured 2026-08-23: `@n = @n + 1`
/// once became `@ = ...`). A compound store is its binary operator plus a
/// store, spelled from the ONE form table (`a += b` is `a = a + b`, which is
/// also how the protocol path reads on user types, D46). The operand's carrier
/// decides the form and is READ from the channel: assuming int here is what
/// once made `f += 0.25` call an integer helper on doubles (hunt emit_c x K1,
/// H5).
fn Emitter mut @emit_store(st StoreStmt) -> () {
    @body.append("    ")
    @emit_expr(st.target)
    @body.append(" = ")
    match st.op {
        Set => @emit_expr(st.src)
        Update(op) => {
            ro row = @arith_row(@out.type_of(st.src.id_of()))
            ro is_float = is_float_row(row)
            ro form = c_binary_form(op, row)
            if !is_call_form(op, is_float) {
                @body.append("((")
                @emit_expr(st.target)
                @body.append(") ")
                @body.append(form)
                @body.append(" (")
                @emit_expr(st.src)
                @body.append("))")
            } else {
                @body.append(form)
                @body.append("(")
                @emit_expr(st.target)
                @body.append(", ")
                @emit_expr(st.src)
                @body.append(")")
            }
        }
    }
    @body.append(";\n")
}

/// THE ONE DISPATCH on the form of a value. Forms that need statements of
/// their own -- a match, an if-value, a record or positional-record
/// constructor, an array literal -- are built here into a temporary, and its
/// name is the value. Any other expression is hoisted (its constructions laid
/// down first) and printed inline by `emit_expr`. Until M1 this dispatch
/// stood in eight positions with four to six arms each (274.8 section 0).
/// The value forms that LOWER: a `match` and an `if` in value position lay down blocks of
/// the body, so they are resolved WHILE LOWERING and hand back the local that holds the
/// result. Prerequisite 5 of M2b-2 step 3b: after the walk prints from sealed blocks, a
/// printer that lowered would push into a FINISHED builder -- the blocks would be recorded
/// and never printed. The forms that only PRINT (a record constructor, an array literal)
/// stay in `build_value` below.
fn Emitter mut @lower_value_source(e Node, ty TyId) -> Option[Local] {
    ro k = e.kind_of()
    if k == NodeKind.MatchExpr {
        // The match is a Switch of the lowered body (274.8 M2b-1d); its result local is
        // recorded here, assigned in each arm through the one door.
        ro u = @fresh_uniq()
        ro t = @ir.temp(ty, "_novac_match_t${u}")
        @lower_match(e, u, t)
        return Some(t)
    }
    if k == NodeKind.Coalesce {
        // `??` ПОНИЖАЕТ ТОЖЕ, и добирается до понижения ДРУГОЙ дверью: не через этот
        // диспетчер, а через `hoist_array_lits`, который зовёт `@emit_coalesce` на узле
        // `Coalesce`. Замер шага 3б (2026-09-09): обход шёл `@emit_assign` ->
        // `@build_value` -> `@hoist_array_lits` -> `@emit_coalesce`, тот толкал
        // `begin_if`/`end_if` в УЖЕ ЗАКРЫТЫЙ билдер, и три носителя падали с
        // `lower: a block sealed twice (it already returns)`.
        //
        // Урок формы, а не случая: предусловие 5 перечисляло формы ПО ДИСПЕТЧЕРУ
        // `build_value`, а `??` в него не входит. Закрывать класс списком МЕСТ вместо
        // свойства «форма понижает» — значит закрыть его наполовину.
        return Some(@emit_coalesce(e))
    }
    if k == NodeKind.IfExpr || k == NodeKind.IfStmt {
        // A tail `if` and an if-expression lay down the same pair (wave B14); the door
        // hands back the local it declared.
        ro u = @fresh_uniq()
        return Some(@emit_if_value(e, u, ty))
    }
    None
}

fn Emitter mut @build_value(e Node, ty TyId) -> Option[str] {
    ro k = e.kind_of()
    if k == NodeKind.RecordCtor {
        return Some(@emit_record_ctor(e, ty, false))
    }
    if k == NodeKind.TupleExpr {
        return Some(@emit_record_ctor(e, ty, true))
    }
    if k == NodeKind.ArrayLit {
        return Some(@emit_array_lit(e, ty))
    }
    @hoist_array_lits(e)
    None
}

/// Whether a block's last statement is its VALUE: an expression, a positional
/// record, a tail `if`, or a match the checker typed (an untyped tail match is
/// a statement whose arms leave through `return`, 274.5 wave B9).
fn Emitter @tail_places_value(c Node) -> bool {
    ro k = c.kind_of()
    is_value_tail_kind(k) || k == NodeKind.IfStmt ||
        (k == NodeKind.MatchExpr && is_ty(@out.type_if_known(c.id_of())))
}
