// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: C itself -- `p.read_at(i)` is `*(p + i)`, the address arithmetic the
// language moved from operators to methods (D216, the methods amendment);
// NOT taken: a runtime helper per operation -- the C operator is the operation.
// Role: emission of a raw pointer's `read_at` (274.11 E.10 step 3c): the
//   checker admitted it inside `unsafe { }` and recorded the pointee's type;
//   the spelling is `(*((p) + (i)))`.
// Used by: emit_expr.nv (`@emit_expr`'s MethodCall arm) when a receiver of
//   pointer type is printed.
// Guarded by: check-novac-differential.sh over novac/fixtures/unsafe_block.

module novac.emit_c

import ../tree.{Node}
import ../builtins.{TypeKind, PTR_WRITE_AT, PTR_WRITE_CONSUME_AT, PTR_OFFSET, PTR_DIST}
import ../sem.{call_arg_at, leaf_text, sole_expr_of_unsafe}
import ../diag.{ice}
import ../types.{is_ty}

/// Is this method call's receiver a raw pointer (its recorded type)?
fn Emitter @is_ptr_receiver(recv Node) -> bool {
    ro t = @out.type_if_known(recv.id_of())
    is_ty(t) && @ctx.tys.kind_of(t) == TypeKind.TkPtr
}

/// `p.read_at(i)` as `(*((p) + (i)))` -- the one pointer method the checker admits.
fn Emitter mut @emit_ptr_op(kids []Node) -> () {
    // `write_at` stores and is a unit value: the assignment, then `NOVA_UNIT`
    // (274.11 E.10 step 4c-2).
    ro writes = leaf_text(kids[2]) == PTR_WRITE_AT || leaf_text(kids[2]) == PTR_WRITE_CONSUME_AT
    // `offset(n)` is the address itself, `n` elements on: C's pointer `+`
    // scales by the element size, as D216 section 6 says (registry 1557).
    if leaf_text(kids[2]) == PTR_OFFSET {
        @body.append("((")
        @emit_expr(kids[0])
        @body.append(") + (")
        @emit_expr(call_arg_at(kids, 3, 0))
        @body.append("))")
        return
    } else if leaf_text(kids[2]) == PTR_DIST {
        // `dist(q)`: C's pointer difference counts elements, signed -- cast to
        // the `int` the checker recorded, as the oracle spells it.
        @body.append("((nova_int)((")
        @emit_expr(kids[0])
        @body.append(") - (")
        @emit_expr(call_arg_at(kids, 3, 0))
        @body.append(")))")
        return
    } else {
        // `read_at` / `read_consume_at` / `write_at`: the element.
    }
    @body.append(if writes { "((*((" } else { "(*((" })
    @emit_expr(kids[0])
    @body.append(") + (")
    // The index the checker admitted: the first argument after the `(`.
    @emit_expr(call_arg_at(kids, 3, 0))
    @body.append(")))")
    if writes {
        @body.append(" = (")
        @emit_expr(call_arg_at(kids, 3, 1))
        @body.append("), NOVA_UNIT)")
    } else {
        // A read is the element itself.
    }
}

/// `unsafe { e }` with no statement IS `e` (a typing context, D216): printed as
/// `e` in every value position at once (`sole_expr_of_unsafe`). Beside the
/// pointer operations because the block exists for them; cut out of
/// emit_expr.nv when the merge with main took it past 1000 lines.
fn Emitter mut @emit_unsafe_value(e Node) -> () {
    match sole_expr_of_unsafe(e) {
        Some(x) => @emit_expr(x)
        None => ice("emit: an `unsafe` block with statements in a position the lowering did not hoist")
    }
}
