// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/emit_c/shell.nv -- THE SHELL: the runtime C our emission is glued
// into, and everything that touches it -- the embedded template, the splice of
// body and literals into its slots, and the interop surface lifted from its text.
//
// Donor: none -- the shell is INTEROP by definition (274 section 7.0: our
//        emission links into the fixed point's runtime), and interop is named
//        as such rather than modelled on anyone. END CONDITION, said once for
//        the whole file: the day novac emits the whole prelude, the shell is our
//        own emission and this file describes it instead of a foreign one.
// Role: layer 8 (emit_c) -- the boundary between what novac writes and what it
//       links against.
// Used by: `emit` (splicing), `pipeline.interop_surface` (the surface as an
//          input of compilation, sub-plan L).
// Guarded by: check-novac-shell-freshness.sh (the template IS the oracle's
//             emission of the probe), check-novac-mangle-fixed-point.sh (every
//             name we print exists here), check-novac-file-size.py (this file
//             exists because emit_c.nv crossed a thousand lines).
//
// A co-equal file of module `novac.emit_c` (folder = one module), cut by
// MEANING under decision 12: emit_c.nv keeps what novac WRITES, this file keeps
// what it writes INTO.

module novac.emit_c

import ../lex.{is_ident_start, is_ident_byte, is_space}
import ../sem.{unescape_dollar}
import ../sem.{InteropTable}
import ../diag.{ice}

/// The runtime shell, embedded at build time (regenerated by novac-regen-shell.sh).
fn shell_template() -> []u8 => embed("shell.tpl.c")

/// EVERY C identifier the shell carries, lifted from its text -- the interop
/// surface, as an INPUT to compilation (sub-plan L).
///
/// The same method the fixed-point guard uses at the gate, run once per process
/// here: identifier runs over the bytes, deduplicated by the table. It lives in
/// THIS module because the shell lives here; the collector receives the table and
/// never touches the shell (one reader per input).
///
/// Cost is measured, not assumed: one pass over ~300KB, once -- which is why it
/// is a door the driver calls ONCE and hands down, exactly like `parse_decls`,
/// rather than something `compile` does per file (the per-file re-parse of the
/// declarations cost a 13x batch slowdown two days ago; the lesson is applied
/// before the same shape can repeat).
export fn shell_surface() -> InteropTable {
    mut t = InteropTable.new()
    ro bytes = shell_template()
    mut i = 0
    ro n = bytes.len()
    // The previous identifier, for the ONE two-token shape this scan also
    // reads: `struct <name> {` is a struct BODY -- the thing a C unit cannot
    // define twice -- while a forward `typedef struct X X;` repeats legally.
    // The declaration judge asks for bodies, so bodies are what gets lifted.
    mut prev = ""
    while i < n {
        if !is_ident_start(bytes[i]) {
            if bytes[i] == ('{' as u8) && prev != "" {
                // `<ident> {` right after `struct <ident>`: prev was pushed
                // by the branch below only when the word before it was
                // `struct`, so this brace closes the body shape.
                t.add_body(prev)
            } else {
                // Any other separator: not a body brace, nothing to lift.
            }
            if !is_space(bytes[i]) {
                prev = ""
            } else {
                // Whitespace between `struct`, the name and `{` is legal C:
                // the pending name survives it.
            }
            i += 1
            continue
        }
        ro start = i
        while i < n && is_ident_byte(bytes[i]) {
            i += 1
        }
        // An identifier run is ASCII by construction of the predicates, so the
        // slice is valid UTF-8 and the `?? ""` never fires; it is spelled rather
        // than asserted because a door that ices on its own input is the class
        // this plan keeps removing.
        ro word = bytes[start..i].to_str() ?? ""
        t.add(word)
        prev = if prev == "struct" || word == "struct" { word } else { "" }
    }
    t
}

/// One C translation unit under construction: everything the emitter reads
/// and writes while it walks one file. The text builder is a resource, so
/// the emitter is a `consume` value — created once, walked, finished once.
type Emitter consume {
    ctx Ctx /// type registry and def table — read only, built by sem
    out CheckOut /// THE checker's channel: every type question is a READ here, never a re-derivation (E2-b1)
    lits []str /// string literals in registration order; the index is the C name suffix
    consume body StringBuilder /// the code slot of the shell, built in a single pass
    reach Reach /// WHICH callables are reached from a root (mono, E2-b2): the emitter
        /// asks, it does not decide
    next_tmp int /// counter behind @fresh_uniq — the ONLY source of temporary names (F30)
    lit_tmp []str /// node id -> the hoisted temporary of an array literal (B8) or a record constructor (B13) in argument position; "" = none
}

/// Splice string literals and the emitted body into the shell's two slots.
fn render(lits []str, body str) -> str {
    ro tpl_bytes = shell_template()
    ro tpl = tpl_bytes.to_str() ?? ice("emit: shell.tpl.c is not UTF-8")
    consume out = StringBuilder.new()
    mut emitted_lits = false
    mut emitted_body = false
    for line in tpl.lines() {
        if line.contains("__NOVAC_STRLITS__") {
            emit_strlit_defs(out, lits)
            emitted_lits = true
        } else if line.contains("__NOVAC_BODY__") {
            out.append(body)
            emitted_body = true
        } else {
            out.append(line)
            out.append("\n")
        }
    }
    assert(emitted_lits && emitted_body, "emit: template slots missing")
    out
}
/// The two bytes this door compares against; the character is in the comment
/// for the same reason the lexer's tables carry it.

/// Write the literal pool: one C array per string the file holds.
///
/// One of TWO places a Nova literal becomes C text (the other is the
/// contract prologue's message slot) -- both go through the one
/// unescape_dollar door in sem/mangle (hunt 2026-09-02, P1).
fn emit_strlit_defs(mut out StringBuilder, lits []str) -> () {
    mut i = 0
    for raw in lits {
        // raw is the token text INCLUDING quotes. Nova's subset escape set
        // (\" \\ \n \t \r) matches C's one for one -- check refuses everything
        // else BY NAME -- with a single exception: `\$`. Nova spells an escaped
        // dollar that way so a literal `${` does not open an interpolation; C
        // has no such escape and would take it as undefined. So the backslash
        // is dropped HERE, at the one place that writes a literal into C, and
        // the rest of the text is passed through untouched.
        out.append("static const uint8_t _novac_strlit_${i}_buf[] = ")
        out.append(unescape_dollar(raw))
        out.append(";\n")
        out.append("static const nova_str _novac_strlit_${i} = { .ptr = _novac_strlit_${i}_buf, .len = sizeof(_novac_strlit_${i}_buf) - 1 };\n")
        i += 1
    }
}

