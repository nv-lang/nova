// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/emit_c/shell.nv -- THE SHELL: the runtime C our emission is glued
// into, and everything that touches it -- the embedded template, the splice of
// body and literals into its slots, and the interop surface lifted from its text.
//
// Donor: none -- the shell is INTEROP by definition (274 section 7.0: our
//        emission links into the fixed point's runtime), and interop is named
//        as such rather than modelled on anyone. END CONDITION, said once for
//        the whole file: the day novac emits the whole prelude, the shell is our
//        own emission and this file describes it instead of a foreign one.
// Role: layer 8 (emit_c) -- the boundary between what novac writes and what it
//       links against.
// Used by: `emit` (splicing), `pipeline.interop_surface` (the surface as an
//          input of compilation, sub-plan L).
// Guarded by: check-novac-shell-freshness.sh (the template IS the oracle's
//             emission of the probe), check-novac-mangle-fixed-point.sh (every
//             name we print exists here), check-novac-file-size.py (this file
//             exists because emit_c.nv crossed a thousand lines).
//
// A co-equal file of module `novac.emit_c` (folder = one module), cut by
// MEANING under decision 12: emit_c.nv keeps what novac WRITES, this file keeps
// what it writes INTO.

module novac.emit_c

import ../lex.{is_ident_start, is_ident_byte, is_space}
import ../sem.{LitPool}
import ../sem.{literal_as_c_text}
import ../sem.{InteropTable}
import ../diag.{ice}
import ../lower.{FnBuilder, Lowerer}

/// The runtime shell, embedded at build time (regenerated by novac-regen-shell.sh).
fn shell_template() -> []u8 => embed("shell.tpl.c")

/// EVERY C identifier the shell carries, lifted from its text -- the interop
/// surface, as an INPUT to compilation (sub-plan L).
///
/// The same method the fixed-point guard uses at the gate, run once per process
/// here: identifier runs over the bytes, deduplicated by the table. It lives in
/// THIS module because the shell lives here; the collector receives the table and
/// never touches the shell (one reader per input).
///
/// Cost is measured, not assumed: one pass over ~300KB, once -- which is why it
/// is a door the driver calls ONCE and hands down, exactly like `parse_decls`,
/// rather than something `compile` does per file (the per-file re-parse of the
/// declarations cost a 13x batch slowdown two days ago; the lesson is applied
/// before the same shape can repeat).
export fn shell_surface() -> InteropTable {
    mut t = InteropTable.new()
    ro bytes = shell_template()
    mut i = 0
    ro n = bytes.len()
    // The previous identifier, for the ONE two-token shape this scan also
    // reads: `struct <name> {` is a struct BODY -- the thing a C unit cannot
    // define twice -- while a forward `typedef struct X X;` repeats legally.
    // The declaration judge asks for bodies, so bodies are what gets lifted.
    mut prev = ""
    while i < n {
        if !is_ident_start(bytes[i]) {
            if bytes[i] == ('{' as u8) && prev != "" {
                // `<ident> {` right after `struct <ident>`: prev was pushed
                // by the branch below only when the word before it was
                // `struct`, so this brace closes the body shape.
                t.add_body(prev)
            } else {
                // Any other separator: not a body brace, nothing to lift.
            }
            if !is_space(bytes[i]) {
                prev = ""
            } else {
                // Whitespace between `struct`, the name and `{` is legal C:
                // the pending name survives it.
            }
            i += 1
            continue
        }
        ro start = i
        while i < n && is_ident_byte(bytes[i]) {
            i += 1
        }
        // An identifier run is ASCII by construction of the predicates, so the
        // slice is valid UTF-8 and the `?? ""` never fires; it is spelled rather
        // than asserted because a door that ices on its own input is the class
        // this plan keeps removing.
        ro word = bytes[start..i].to_str() ?? ""
        t.add(word)
        prev = if prev == "struct" || word == "struct" { word } else { "" }
    }
    for stub in stub_names(bytes.to_str() ?? ice("emit: shell.tpl.c is not UTF-8 for the stub scan")) {
        t.add_stub(stub)
    }
    t
}

/// THE SHELL'S STUBS, read off their bodies (registry 1643). The oracle emits
/// the ERASED generic layer (`Nova_Vec_method_*`, `Nova_HashMap_*`, `Nova_Set_*`,
/// their iterators) as bodies that discard every parameter and return a
/// constant: `{ (void)nova_self; (void)other; return (nova_bool){0}; }`. A name
/// that resolves to one compiles, links and answers a constant -- `==` over two
/// vectors was "not equal" whatever they held. Such a function is marked, and
/// `InteropTable @has` answers no for it, so every door that asks the shell
/// falls to the std instance or to its refusal by name. The NAMES are returned
/// and the caller marks them: the table is a local of the scan, not a mutable
/// aggregate handed through the phases.
///
/// The shape is exact: a `static` definition at column 0 whose body is one or
/// more `(void)<param>;` and ONE `return` of `NULL`, `NOVA_UNIT` or a `{0}`
/// compound literal -- nothing a real body is made of. A body with no `(void)`
/// is not taken: a constant function without parameters may be meant.
fn stub_names(text str) -> []str {
    mut found = []str.new()
    mut name = ""
    mut voids = 0
    mut returns = 0
    mut shape = false
    for line in text.lines() {
        if name == "" {
            if line.starts_with("static ") && line.contains("(") && is_open_brace_line(line) {
                name = defined_name(line)
                voids = 0
                returns = 0
                shape = true
            } else {
                // Not a definition head: nothing opens here.
            }
        } else if line == "}" {
            if shape && voids > 0 && returns == 1 {
                found.push(name)
            } else {
                // A real body: the function stays callable.
            }
            name = ""
        } else if line.starts_with("    (void)") && !line.contains(" = ") {
            voids += 1
        } else if is_constant_return(line) {
            returns += 1
        } else {
            shape = false
        }
    }
    found
}

/// Does this definition head end its line with ` {` (a body follows)?
fn is_open_brace_line(line str) -> bool {
    ro n = line.byte_len()
    n > 2 && line[n - 2..] == " {"
}

/// The defined function's name: the identifier right before the first `(`.
fn defined_name(line str) -> str {
    mut head = ""
    mut taken = false
    for part in line.split("(") {
        head = if taken { head } else { part }
        taken = true
    }
    mut last = ""
    for w in head.split(" ") { last = w }
    last
}

/// A stub's one statement: a constant handed back whatever came in.
fn is_constant_return(line str) -> bool {
    if line == "    return NULL;" || line == "    return NOVA_UNIT;" { return true }
    ro n = line.byte_len()
    line.starts_with("    return (") && n > 4 && line[n - 4..] == "{0};"
}

/// One C translation unit under construction: everything the emitter reads
/// and writes while it walks one file. The text builder is a resource, so
/// the emitter is a `consume` value — created once, walked, finished once.
type Emitter consume {
    src_name str /// The compiled file's base name, for contract panics (#874); "" on the test path.
    ctx Ctx /// type registry and def table — read only, built by sem
    out CheckOut /// THE checker's channel: every type question is a READ here, never a re-derivation (E2-b1)
    mut pool LitPool /// string constants: each distinct text once, the slot is the C name suffix
    consume body StringBuilder /// the code slot of the shell, built in a single pass
    reach Reach /// WHICH callables are reached from a root (mono, E2-b2): the emitter
        /// asks, it does not decide
    next_tmp int /// counter behind @fresh_uniq: the source of the PRINTER's OWN hoist names
        /// (array literal, by-value record, the three of string interpolation). It said
        /// "the ONLY source of temporary names" until 2026-09-09, and that stopped being
        /// true twice over: M2c gave the lowering's temporaries their own index (`_novac_l<i>`),
        /// and M3 moved the `match` number to the builder. F30 still applies to what is left:
        /// a name may be bound twice in one scope, so the two name spaces must not
        /// intersect. One direction is held by guard
        /// [INV-GUARD: check-novac-invented-name-not-named]: an invented name cannot
        /// enter `named`, the door that means "the author wrote this". The other
        /// direction -- a hoist never taking a source name -- holds by the `_novac_`
        /// prefix, which no source identifier may carry, and is not checked here. [INV-TODO: 274.3 F30 -- nothing checks it]
    mut lo Lowerer /// THE LOWERING'S RECEIVER (274.8 M3): the builder is no longer the printer's own state -- it lives in `lower/` with the methods that write it, and printing READS it through here. Was `mut ir FnBuilder` (274.8 M1)
    ret_self bool /// the callable being printed returns its receiver (`-> @`, D409): a return with no value prints the receiver
    recv_copy bool /// the callable being printed takes a `value` record receiver BY COPY (D488 R5): `@f` is `.f`, `@` is the parameter itself; otherwise a value record's receiver is a pointer
    recv_ptr_value bool /// the callable being printed takes a `value` record receiver BY POINTER (D488 R3/R5): `@` as a value is `(*self)`
    hoist_root NodeId /// the value an assignment is printing: its OWN hoist is not read back (`x = x`), its children's are (registry 1619)
    gone_root NodeId /// the move being printed inside its drop-flag set (D432 s5): printed once more, bare
    lit_tmp []str /// node id -> the hoisted temporary of an array literal (B8) or a record constructor (B13) in argument position; "" = none
    hlits []Node /// the handler literals of the reached functions; the index is the literal's C number (E.9 step 3)
    spawns []Node /// the `spawn` statements of the reached functions; the index is the spawn's C number (E.9 step 4)
    cur_spawn int /// the C number of the spawn whose body function is being emitted, -1 outside one
    cur_lit int /// the C number of the literal whose op function is being emitted, -1 outside one: a literal built there reads its outer captures through that op's context
    mut blobs []int /// the rows of `Ctx.embeds` whose static arrays the emission printed a reference to (D412, emit_embed.nv): their arrays go before the code
}

/// Splice string literals, the emitted body and the module values'
/// initialization into the shell's three slots. The INIT slot is the last
/// line of the shell's `nova_consts_init()`, which `main` runs before the
/// program (scripts/tools/novac-regen-shell.sh stamps it).
fn render(lits []str, body str, init str) -> str {
    ro tpl_bytes = shell_template()
    ro tpl = tpl_bytes.to_str() ?? ice("emit: shell.tpl.c is not UTF-8")
    consume out = StringBuilder.new()
    mut emitted_lits = false
    mut emitted_body = false
    mut emitted_init = false
    for line in tpl.lines() {
        if line.contains("__NOVAC_STRLITS__") {
            emit_strlit_defs(out, lits)
            emitted_lits = true
        } else if line.contains("__NOVAC_BODY__") {
            out.append(body)
            emitted_body = true
        } else if line.contains("__NOVAC_INIT__") {
            out.append(init)
            emitted_init = true
        } else {
            out.append(line)
            out.append("\n")
        }
    }
    assert(emitted_lits && emitted_body && emitted_init, "emit: template slots missing")
    out
}
/// The two bytes this door compares against; the character is in the comment
/// for the same reason the lexer's tables carry it.

/// Write the literal pool: one C array per string the file holds.
///
/// One of TWO places a Nova literal becomes C text (the other is the
/// contract prologue's message slot) -- both go through the one
/// literal_as_c_text door in sem/mangle (hunt 2026-09-02, P1).
fn emit_strlit_defs(mut out StringBuilder, lits []str) -> () {
    mut i = 0
    for raw in lits {
        // raw is the token text INCLUDING quotes. Nova's subset escape set
        // (\" \\ \n \t \r) matches C's one for one -- check refuses everything
        // else BY NAME -- with two exceptions, both translated by the door:
        // `\$` (Nova's escaped dollar, so a literal `${` does not open an
        // interpolation; C has no such escape) and the line continuation (D467
        // section 3 eats the next line's indentation, which C's splice keeps).
        // The rest of the text is passed through untouched.
        out.append("static const uint8_t _novac_strlit_${i}_buf[] = ")
        out.append(literal_as_c_text(raw))
        out.append(";\n")
        out.append("static const nova_str _novac_strlit_${i} = { .ptr = _novac_strlit_${i}_buf, .len = sizeof(_novac_strlit_${i}_buf) - 1 };\n")
        i += 1
    }
}

