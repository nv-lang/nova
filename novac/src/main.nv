// SPDX-License-Identifier: MIT OR Apache-2.0
// EXPECT_EXIT_CODE 2
// novac — the Nova compiler written in Nova. Plan 274, stage E1.
// (Exit 2 = usage exit: the test runner invokes the binary with no args.
// This is the real contract, restored 2026-08-14 when the #659 fix landed
// and this file's self-expiring negative cc-error marker fell loudly.)
//
// The E1 CLI: `novac <file.nv>` lexes, parses and subset-checks one file,
// prints §7-schema JSON diagnostics one per line, and exits 0 on a clean
// subset file / 1 on diagnostics / 2 on usage or IO errors. This is the
// entry the binary guard quartet judges (differential vs the oracle,
// diag-schema, no-cascade, no-panic) and the seam the driver will call.
//
// Effects at the door only: Fs and Os are handled HERE (real_fs/real_os);
// the compiler modules below are pure functions over the handed-in text
// (274 §2: the compiler reads nothing itself).

module novac

import ./pipeline.{compile, compile_to_c}
import ./diag.{to_json}
import std.fs.{read, read_dir, real_fs}
import std.os.{args, exit_process, real_os}

/// How one file ended. The process exit code is a VIEW of this outcome
/// (see @code), never the value passed around: §7 fixes the legal set at
/// exactly three, and the guards read anything else as a panic. A closed
/// type is what keeps a fourth code from ever being invented — an int
/// return could grow one silently (the #652 class).
type Verdict enum
    | Clean /// nothing to report: the file is inside the subset
    | Refused /// judged and refused; the diagnostics are already printed
    | DoorError /// the door failed: bad usage, unreadable path, or not UTF-8

/// The process exit code this outcome reports (the §7 contract, and the
/// order of the codes IS the order of severity — see worse).
fn Verdict @code() -> int => match @ {
    Clean => 0
    Refused => 1
    DoorError => 2
}

/// The worse of two outcomes. A batch reports the worst file it saw, so a
/// door error outranks a refusal and a refusal outranks a clean file.
fn worse(a Verdict, b Verdict) -> Verdict => if b.code() > a.code() { b } else { a }

/// Emit C for one file: print diagnostics, or the C text when there are none.
fn emit_one(text str, file str, decls []str) -> Verdict {
    ro (diags, c_text) = compile_to_c(text, decls)
    if diags.len() > 0 {
        mut i = 0
        for d in diags {
            println(to_json(d, i, file))
            i += 1
        }
        return Verdict.Refused
    }
    println(c_text)
    Verdict.Clean
}

/// Check one file: print §7 diagnostics one per line, one JSON per line.
fn compile_one(text str, file str, decls []str) -> Verdict {
    ro diags = compile(text, decls)
    mut i = 0
    for d in diags {
        println(to_json(d, i, file))
        i += 1
    }
    if diags.len() > 0 { Verdict.Refused } else { Verdict.Clean }
}

/// Read the declaration texts of a directory (`--std <dir>`): every *.nv,
/// no recursion. THIS IS THE DOOR: filesystem walking lives here and the
/// compiler is handed texts (architecture §1 — the compiler reads nothing
/// itself). A missing or unreadable directory yields an empty list: then no
/// method is known and every method call gets an honest subset refusal
/// instead of a quiet guess.
fn read_decls(dir str) Fs -> []str {
    mut out = []str.new()
    if dir == "" { return out }
    match read_dir(dir.to_path()) {
        Ok(entries) => {
            for e in entries {
                // A DirEntry carries the NAME (a Path), not the full path, so
                // we join it ourselves; the name bytes become str through the
                // same door as all other input.
                ro nm = e.name.os_bytes().to_str() ?? ""
                if nm == "" { continue }
                if !nm.ends_with(".nv") { continue }
                ro full = "${dir}/${nm}"
                match read(full.to_path()) {
                    Ok(bytes) => {
                        match bytes.to_str() {
                            Ok(t) => { out.push(t) }
                            Err(_) => {}
                        }
                    }
                    Err(_) => {}
                }
            }
        }
        Err(_) => {
            println("novac: cannot read declarations dir ", dir)
        }
    }
    out
}

/// Check one path (read + compile), printing diagnostics; the outcome is
/// this file's contribution to the batch verdict.
fn check_path(path str, decls []str) -> Verdict {
    match read(path.to_path()) {
        Ok(bytes) => {
            match bytes.to_str() {
                Ok(text) => compile_one(text, path, decls)
                Err(_) => {
                    println("novac: not UTF-8: ", path)
                    Verdict.DoorError
                }
            }
        }
        Err(_) => {
            println("novac: cannot read ", path)
            Verdict.DoorError
        }
    }
}

/// CLI entry: `novac check <file.nv>...` (batch: one process, per-file
/// diagnostics; exit = worst of the files) or `novac emit <file.nv>` (one
/// file: its C on stdout). Effects are handled here only. Batch check exists
/// for the cost of the loop (plan 274.2): the process start dominates a
/// single check, so the fuzzer and the diff runner feed a LIST.
fn main() {
    with Fs = real_fs(), Os = real_os() {
        ro a = args()
        if a.len() < 3 || (a[1] != "check" && a[1] != "emit") {
            println("usage: novac check [--std <dir>] <file.nv>... | novac emit [--std <dir>] <file.nv>")
            exit_process(Verdict.DoorError.code())
            return
        }
        // `--std <dir>` is the std interface novac READS (method signatures)
        // instead of knowing it by heart (convention П5). Without the flag
        // the method table is empty and every method call is an honest
        // subset refusal.
        mut argi = 2
        mut std_dir = ""
        if a.len() > 3 && a[2] == "--std" {
            std_dir = a[3]
            argi = 4
        }
        ro decls = read_decls(std_dir)
        if argi >= a.len() {
            println("usage: novac check [--std <dir>] <file.nv>... | novac emit [--std <dir>] <file.nv>")
            exit_process(Verdict.DoorError.code())
            return
        }
        if a[1] == "check" {
            mut worst = Verdict.Clean
            mut i = argi
            while i < a.len() {
                worst = worse(worst, check_path(a[i], decls))
                i += 1
            }
            exit_process(worst.code())
            return
        }
        ro path = a[argi]
        match read(path.to_path()) {
            Ok(bytes) => {
                match bytes.to_str() {
                    Ok(text) => { exit_process(emit_one(text, path, decls).code()) }
                    Err(_) => {
                        println("novac: not UTF-8: ", path)
                        exit_process(Verdict.DoorError.code())
                    }
                }
            }
            Err(_) => {
                println("novac: cannot read ", path)
                exit_process(Verdict.DoorError.code())
            }
        }
    }
}
