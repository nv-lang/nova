// SPDX-License-Identifier: MIT OR Apache-2.0
// EXPECT_EXIT_CODE 2
// novac — the Nova compiler written in Nova. Plan 274, stage E1.
// (Exit 2 = usage exit: the test runner invokes the binary with no args.
// This is the real contract, restored 2026-08-14 when the #659 fix landed
// and this file's self-expiring negative cc-error marker fell loudly.)
//
// The E1 CLI: `novac <file.nv>` lexes, parses and subset-checks one file,
// prints §7-schema JSON diagnostics one per line, and exits 0 on a clean
// subset file / 1 on diagnostics / 2 on usage or IO errors. This is the
// entry the binary guard quartet judges (differential vs the oracle,
// diag-schema, no-cascade, no-panic) and the seam the driver will call.
//
// Effects at the door only: Fs and Os are handled HERE (real_fs/real_os);
// the compiler modules below are pure functions over the handed-in text
// (274 §2: the compiler reads nothing itself).

module novac

import ./pipeline.{compile, compile_to_c}
import ./diag.{to_json}
import std.fs.{read, read_dir, real_fs}
import std.os.{args, exit_process, real_os}

/// Emit C for one file: print diagnostics (exit 1) or the C text (exit 0).
fn emit_one(text str, file str, decls []str) -> int {
    ro (diags, c_text) = compile_to_c(text, decls)
    if diags.len() > 0 {
        mut i = 0
        for d in diags {
            println(to_json(d, i, file))
            i += 1
        }
        return 1
    }
    println(c_text)
    0
}

/// Check one file: print §7 diagnostics one per line; exit 0 clean / 1 diagnostics.
fn compile_one(text str, file str, decls []str) -> int {
    ro diags = compile(text, decls)
    mut i = 0
    for d in diags {
        println(to_json(d, i, file))
        i += 1
    }
    if diags.len() > 0 { 1 } else { 0 }
}

/// Прочитать тексты деклараций из каталога (`--std <dir>`): все *.nv, без
/// рекурсии. ЭТО ДВЕРЬ: обход ФС живёт здесь, компилятор получает тексты
/// (архитектура §1 — компилятор читает только переданное). Нет каталога или
/// нечитаем — пустой список: тогда методы неизвестны и всякий вызов метода
/// получает честный отказ подмножества, а не тихий «неизвестный метод».
fn read_decls(dir str) Fs -> []str {
    mut out = []str.new()
    if dir == "" { return out }
    match read_dir(dir.to_path()) {
        Ok(entries) => {
            for e in entries {
                // DirEntry несёт ИМЯ (Path), не полный путь — склеиваем сами;
                // байты имени -> str через ту же дверь, что и весь ввод.
                ro nm = e.name.os_bytes().to_str() ?? ""
                if nm == "" { continue }
                if !nm.ends_with(".nv") { continue }
                ro full = "${dir}/${nm}"
                match read(full.to_path()) {
                    Ok(bytes) => {
                        match bytes.to_str() {
                            Ok(t) => { out.push(t) }
                            Err(_) => {}
                        }
                    }
                    Err(_) => {}
                }
            }
        }
        Err(_) => {
            println("novac: cannot read declarations dir ", dir)
        }
    }
    out
}

/// Check one path (read + compile), printing diagnostics; returns the exit
/// code contribution: 0 clean, 1 diagnostics, 2 IO/UTF-8 error.
fn check_path(path str, decls []str) -> int {
    match read(path.to_path()) {
        Ok(bytes) => {
            match bytes.to_str() {
                Ok(text) => compile_one(text, path, decls)
                Err(_) => {
                    println("novac: not UTF-8: ", path)
                    2
                }
            }
        }
        Err(_) => {
            println("novac: cannot read ", path)
            2
        }
    }
}

/// CLI entry: `novac check <file.nv>...` (batch: one process, per-file
/// diagnostics; exit = worst of the files) or `novac emit <file.nv>` (one
/// file: its C on stdout). Effects are handled here only. Batch check exists
/// for the cost of the loop (plan 274.2): the process start dominates a
/// single check, so the fuzzer and the diff runner feed a LIST.
fn main() {
    with Fs = real_fs(), Os = real_os() {
        ro a = args()
        if a.len() < 3 || (a[1] != "check" && a[1] != "emit") {
            println("usage: novac check [--std <dir>] <file.nv>... | novac emit [--std <dir>] <file.nv>")
            exit_process(2)
            return
        }
        // `--std <dir>` — интерфейс std, который novac ЧИТАЕТ (сигнатуры
        // методов), а не знает наизусть (П5). Без флага таблица методов пуста
        // и всякий вызов метода — честный отказ подмножества.
        mut argi = 2
        mut std_dir = ""
        if a.len() > 3 && a[2] == "--std" {
            std_dir = a[3]
            argi = 4
        }
        ro decls = read_decls(std_dir)
        if argi >= a.len() {
            println("usage: novac check [--std <dir>] <file.nv>... | novac emit [--std <dir>] <file.nv>")
            exit_process(2)
            return
        }
        if a[1] == "check" {
            mut worst = 0
            mut i = argi
            while i < a.len() {
                ro rc = check_path(a[i], decls)
                worst = worst.max(rc)
                i += 1
            }
            exit_process(worst)
            return
        }
        ro path = a[argi]
        match read(path.to_path()) {
            Ok(bytes) => {
                match bytes.to_str() {
                    Ok(text) => { exit_process(emit_one(text, path, decls)) }
                    Err(_) => {
                        println("novac: not UTF-8: ", path)
                        exit_process(2)
                    }
                }
            }
            Err(_) => {
                println("novac: cannot read ", path)
                exit_process(2)
            }
        }
    }
}
