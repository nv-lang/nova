// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `method::probe` + `AssocItem.fn_has_self_parameter` ("the
// receiver is the first parameter, resolve by receiver type"), separate chaining
// (name -> first row + `next_row`, TAOCP 6.4) for the table itself, rustc
// `report_method_error` / clang `Sema::NoteAllOverloadCandidates` ("a refusal
// names the whole candidate set"), and Nova's own rule P14 (10-overloading.md)
// for selection by MODE. NOT taken: a uniform DefId (a payload here is a ROW),
// inference of any kind (E2-b3), and any tie-break -- an ambiguous set is
// refused, never resolved by an order nobody declared.
// Role: layer 3 -- THE callable registry: rows and their payload. Resolution
// -- which callable does a call name -- moved WHOLE to `resolve` (274.4 step
// 2): the chain (heads/next) lives there as FnIndex, built FROM these rows.
// Used by: check (row payload), emit_c and mono (the row a declaration owns),
// resolve (builds its index from the rows), sem itself.
// Guarded by: check-novac-row-fields.py (row fields declared in plan 10.3v), check-novac-no-alloc-in-lookup.py (a door
// allocates nothing), check-novac-file-size.py (this file exists because sem.nv crossed 1000 lines), the module tests
// of mangle and pipeline.
// novac/src/sem/callables.nv -- the callable registry: rows and their payload.
//
// A co-equal file of the `sem` module, cut along MEANING: "what is declared in
// this file" (sem.nv) and "what does a row carry" are the questions left here.
// "Which callable does a CALL name" was the third one and it is a MODULE now
// (`resolve`, 274.4 step 2): with the chain on this table, any holder of Ctx
// could resolve names -- and the emitter did, silently. The selection rule
// lives with the resolver.

module novac.sem

import ../tree.{Node}
import ../diag.{ice}
import ../names.{NameTable, NamespaceId}
import ../builtins.{ENTRY_FN}
import ../types.{TyId, no_ty, is_ty, Interner}

// WHY `VariantRow` LIVES IN THIS FILE and not beside `VariantDef`, where it
// belongs by subject: THE ORACLE'S EMISSION DEPENDS ON DECLARATION ORDER. A
// newtype used by a sum arm is emitted as a boxed `struct Nova_X*` unless its own
// declaration was emitted FIRST -- and then it collides with its own
// `typedef nova_int Nova_X` and the C unit is refused. Isolated to twelve lines
// (2026-08-22): one file, sum above newtype fails, newtype above sum compiles.
//
// Inside one module the same rule runs over FILES, in their order, and it now
// holds TWO spaces: `VariantRow` feeds `DefTarget` (sem.nv) and `CalleeTarget`
// (channel.nv), and `FieldRow` feeds `TypeRows` (sem.nv) -- so both have to be
// declared in the file that comes before those, and that is this one. `FnRow`,
// `TyId` and `DeclId` never met the defect because they already sit in files (or
// modules) emitted earlier; that is luck of ordering, not design.
//
// So this POSITION is a workaround under [LEGACY-#761-newtype-order-in-sum-arm],
// not a decision about where the type belongs. When the oracle stops caring
// about declaration order, it moves next to `VariantDef`.

/// THE row of a module-level constant in `Ctx.consts` (274.5 wave B2).
///
/// HERE, and not beside `ConstTable` in defs.nv, for the reason written at the
/// top of this file: a newtype used by a SUM ARM (`DefTarget.DefConst`) has to
/// be declared in a file the oracle emits EARLIER, or its own
/// `typedef nova_int Nova_ConstRow` collides with the boxed struct the sum arm
/// makes of it. Measured 2026-08-29, the same failure `FieldRow` and
/// `VariantRow` are here to avoid: [LEGACY-#761-newtype-order-in-sum-arm].
export type ConstRow int

/// The row's index, for the one thing a row is for: addressing a vector.
export fn raw_crow(r ConstRow) -> int => r as int

// `no_crow()` and `is_crow()` are NOT here, and their absence is the rule
// rather than an oversight (P35): a constant row is answered as `Option`
// everywhere -- `defs.const_row` and `chan.const_of` both do -- so the
// sentinel never leaves the storage and nobody has an absence to test. The
// pair would have been written for symmetry with `FnRow`, and symmetry is
// exactly what P35 refuses as a reason for a name.

/// THE row of a record's FIELD in `Ctx.field_rows`.
///
/// A space of its own, and the criterion the previous wave produced says why it
/// deserves the wrapper while the `defs` row did not: this one is STORED --
/// `FieldDef.next_row` holds it, so the same-name chain WALKS the space instead
/// of merely stepping through it. A value that lives in a field is an identity;
/// one that dies on the next line is a step (§9.1g.1, wave B4).
export type FieldRow int

/// The index inside -- the ONE unwrapping door for this space.
#realtime nogc
export fn raw_frow(f FieldRow) -> int => f as int

/// "No field", as a value: the END of a same-name chain, which is where the
/// walk stops.
#realtime nogc
export fn no_frow() -> FieldRow => FieldRow(-1)

/// Is this an actual field row? Asked by the chain walk, where the end is a
/// legal answer.
#realtime nogc
export fn is_frow(f FieldRow) -> bool => raw_frow(f) >= 0

/// THE VARIANT range of a declaration: first row and count, or None when this
/// declaration owns no variants. A door and not a bare match, because three
/// readers ask it and each would otherwise spell the two impossible arms.
export fn variant_range_of(td TypeDef) -> Option[(VariantRow, int)] {
    match td.rows {
        VariantRows(first, cnt) => Some((first, cnt))
        // A record's field range is not a variant range, and a type with no rows
        // has neither: both answer "none" rather than a zero to interpret.
        NoRows | FieldRows(_, _) => None
    }
}

/// THE FIELD range of a declaration, by the same rule.
export fn field_range_of(td TypeDef) -> Option[(FieldRow, int)] {
    match td.rows {
        FieldRows(first, cnt) => Some((first, cnt))
        NoRows | VariantRows(_, _) => None
    }
}

/// THE row of a sum's VARIANT in `Ctx.variant_rows` -- a space of its own since
/// wave B2 (2026-08-22), and the last bare `int` in the arms of `DefTarget` and
/// `CalleeTarget`.
///
/// Its neighbours were wrapped first for a reason the plan states: one wrapped
/// space protects only against itself, and this one shares its arms with two
/// others. `DefVariant(int)` beside `DefFn(FnRow)` and `DefType(DeclId)` meant
/// the sum still admitted "a variant row where a callable row belongs" through
/// the one arm that had no type.
export type VariantRow int

/// The index inside -- the ONE unwrapping door for this space.
#realtime nogc
export fn raw_vrow(v VariantRow) -> int => v as int

/// "No variant", as a value rather than a −1 the caller has to know. The
/// pattern-head walk needs it: most heads are binders and name no variant.
#realtime nogc
export fn no_vrow() -> VariantRow => VariantRow(-1)

/// Does this name a variant at all? Asked where "no" is a legal answer.
#realtime nogc
export fn is_vrow(v VariantRow) -> bool => raw_vrow(v) >= 0



/// A ROW of the callable registry -- and a TYPE, not a bare `int`, since
/// 2026-08-21 (plan 274 section 9.1g; the owner's decision of 2026-08-20).
///
/// Three index spaces used to share one `int`: a row of this table, a type id,
/// and an interner term. Nothing in the compiler told them apart, and they
/// diverged silently -- this week the emitter asked `defs` for a row BY NAME
/// (last-write-wins) and got another overload's row, so two declarations emitted
/// under one C name and clang refused the unit. A newtype makes that a compile
/// error at the door instead of a defect at the link step.
///
/// `-1` still means "no row" in the STORAGE (a dense int vector), and the doors
/// answer `Option[FnRow]` -- the representation is a choice of this file, the
/// language of a door is the language of the caller.
export type FnRow int

/// The row's index, for the ONE thing a row is for: addressing a vector.
///
/// A free function and not a method, deliberately: novac compiles no method
/// BODY yet, and its own source must stay inside what it can read (the whole
/// reason section 9.1g waited for the newtype form to arrive first). The cast
/// inside is the language's unwrap, and novac reads exactly that direction --
/// newtype into its representation -- since the same day.
export fn raw_row(r FnRow) -> int => r as int

/// "No row", as a ROW, not a number to be decoded by hand
/// [INV-GUARD: check-novac-no-unwrap-compare] -- unwrapping in order to compare
/// is red, so a caller cannot quietly go back to recognising a number.
/// [INV-GUARD: check-novac-no-unwrap-compare] -- what holds it is the ban on
/// unwrapping for comparison: `raw_row(x) == raw_row(y)` is red, so a caller
/// cannot quietly go back to recognising a number.
///
/// The storage keeps `-1` (a dense int vector cannot hold an absence any other
/// way), and every door that can fail answers `Option[FnRow]`. This is for the
/// one place in between: a walk that has not found a candidate yet.
export fn no_row() -> FnRow => FnRow(-1)

/// One callable — plan 273 form: a method IS a function whose first
/// parameter is the receiver, so there is ONE row shape for both.
///
/// The receiver is NOT a field of this row (owner's check 2026-08-16: "in
/// plan 273 the receiver is a parameter like all the others — are you sure
/// you should be matching on it?"). It is `params[param_off]` of a method,
/// and the row says only WHETHER the first parameter is a receiver. The
/// earlier shape kept `recv_id` and stored no other parameter at all:
/// `harvest_fn` validated the parameter types and then threw them away, so
/// the receiver was not "a parameter like the others" — it was the only
/// parameter novac remembered. Keeping them all is also what overload
/// resolution needs later; today it is what makes the form honest.
export type FnDef value {
    name str /// name as written in the declaration
    ret_id TyId /// return type id; `no_ty()` = none declared (legal for main only)
    param_off int /// first parameter of this callable in FnTable.params
    param_cnt int /// how many parameters, INCLUDING the receiver when there is one
    has_recv bool /// the first parameter IS the receiver — the ONE datum here (see below)
    tparam_off int /// start of this callable's type parameters in FnTable.tparams
    tparam_cnt int /// how many type parameters it declares; 0 = not generic
}

/// IS THIS ROW THE PROGRAM'S ENTRY POINT? Asked of the ROW, never of the
/// spelling -- and that distinction is a fix, not a nicety.
///
/// The entry point is special for a reason that has nothing to do with novac:
/// its C symbol is dictated from OUTSIDE. The shell the oracle emits calls
/// `nova_fn_main_impl()`, so that one name cannot carry parameter types the way
/// every other name of ours does (274 section 7.0), it may declare no return
/// type, it is the root of the reachability walk, and its body gets a `(void)`
/// signature. Four exemptions, all legitimate, all keyed on ONE question.
///
/// Until 2026-08-22 that question was `fd.name == ENTRY_FN`, in six places
/// across four modules -- so EVERY callable spelled `main` inherited all four
/// exemptions. Measured on two files the oracle accepts:
///
///   * `fn main(x int) -> int` beside `fn main()`: `typing` skipped binding the
///     parameters (they belong to "the entry point", which takes none), so the
///     body refused its own parameter with "unknown name: nothing with this name
///     is bound at this point" -- a refusal about a bound name;
///   * both rows would have been mangled to `nova_fn_main_impl`: two C functions
///     with one name, the exact collision closed on 2026-08-19 by putting
///     parameter types INTO the name, reopened here through the one name that
///     has no parameter types.
///
/// So the rule is three facts about the row and not one about the string: the
/// spelling, no parameters, no receiver. An overload of `main` is an ORDINARY
/// callable -- Nova allows it, the oracle compiles it, and it gets an ordinary
/// mangled name.
#realtime nogc
export fn is_entry_fn(fd FnDef) -> bool =>
    fd.name == ENTRY_FN && fd.param_cnt == 0 && !fd.has_recv

/// The same question by ROW, for the readers that hold one.
#realtime nogc
export fn FnTable @is_entry_row(row FnRow) -> bool
    requires raw_row(row) >= 0 && raw_row(row) < @rows.len(), "sem: is_entry_row of a row outside the registry"
{
    is_entry_fn(@rows[raw_row(row)])
}

/// WHERE THE RECEIVER MARK LIVES, and why it is one bit on the callable
/// rather than a flag on each parameter (owner, 2026-08-16, twice).
///
/// First reading: a bool on the function looked like a privileged fact about
/// one element stored on the container, so the mark moved onto the parameter
/// (`ParamDef.is_recv`). That was worse, and the owner said why: a per
/// parameter flag ADMITS STATES THE LANGUAGE FORBIDS — "the third parameter
/// is the receiver", "two receivers" — and the invariant then rests on
/// discipline instead of on construction.
///
/// The resolution: the POSITION is not data. Plan 273 §4.4 fixes it — "the
/// receiver is the first parameter, on the first step without exceptions" —
/// so position is a rule of the language, not a fact of this file. The only
/// datum left is WHETHER a receiver is there, which is a zero-or-one fact
/// about the CALLABLE. One bool on FnDef expresses exactly that and nothing
/// illegal: there is no way to say "the third one". Parameters go back to
/// being plain type ids, and the receiver is `params[param_off]` when
/// `has_recv` — a fact of the DECLARATION: the author wrote this callable with
/// a receiver. Resolution does not read it and must not: a method IS a function
/// whose first parameter is the receiver (plan 273 §4.4), so `@fits` compares
/// positions and nothing else (owner, 2026-08-19). Kept because it is not
/// derivable from the parameter list, and a diagnostic that wants to say "this
/// is a method, call it as `x.f()`" has nowhere else to read it from.

/// THE callable registry: file functions and the method signatures READ
/// from std declarations live in the SAME rows (П5: std names are data,
/// not compiler knowledge).
///
/// EVERY declaration gets its own row, including a second one for the same
/// (receiver, name). The first shape kept a `dup` flag on the winner and
/// DROPPED the loser — so the compiler knew an overload existed but could no
/// longer say which signatures collided, and no diagnostic could ever name
/// them (owner's review 2026-08-16). Ambiguity is now a property of the
/// same-name CHAIN -- which lives in `resolve.FnIndex` since 274.4 step 2,
/// built FROM these rows: this table holds payload and answers by ROW, and
/// deliberately cannot answer by name (that was the second door).
export type FnTable {
    tparams []str /// type-parameter NAMES of every callable, grouped by tparam_off/cnt
    tbounds []str /// the BOUND of each type parameter (`""` = none), same grouping as `tparams` -- a parallel pool, so a slot's bound is one index away
    rows []FnDef /// every callable, in registration order; a row index is what `DefTarget.DefFn` carries
    params []ParamDef /// parameters of every callable -- type AND mode in one row, addressed by FnDef.param_off/param_cnt
    own_cnt int /// how many LEADING rows this file declared; the rest are signatures read from declarations
}

/// An empty callable registry.
export fn FnTable.new() -> FnTable =>
    { rows: []FnDef.new(), params: []ParamDef.new(),
      tparams: []str.new(), tbounds: []str.new(), own_cnt: 0 }

/// Does novac compile this callable's BODY?
///
/// The file's own callables are registered by `collect_types`, the signatures of
/// std methods by `harvest_methods` AFTER it, so the file's rows are a PREFIX
/// and the boundary is ONE number. A bit per row would admit "the third row is
/// theirs, the fourth is ours" -- a state that cannot occur; the same argument
/// put the receiver mark on the callable instead of on each parameter (§10.3в).
/// Nor is this a derived field on a ROW (П22): it is a fact about the TABLE,
/// like its length, answered in O(1).
///
/// WHY CHECK ASKS AT ALL. Every C name is ours now (owner, 2026-08-20: there is
/// no `foreign` in that sense -- Nova's external declarations are
/// `extern "C" fn` / `extern "nova" fn`, and they say so IN THE SOURCE). A call
/// to a body novac does not emit therefore names a symbol that exists nowhere,
/// so the subset declines it by name instead of emitting C that cannot link.
#realtime nogc
export fn FnTable @compiles_body(row FnRow) -> bool => raw_row(row) < @own_cnt

// `FnTable.tparam_index` lived here until 2026-08-22 and is gone for the reason
// that removed `candidates_from` and `same_vrow` before it: EXPORTED, and called
// by nobody. Three of these in one session is a pattern of mine, not an accident
// -- a door written because it "completes the set" rather than because someone
// asked the question. The question it answered ("which slot does this name bind
// in THIS row") is asked one step earlier by `slots.tparam_slot`, which has real
// callers, and by `sem.ty_of_type_name`, which is what those callers wanted.



/// Register one callable. A repeat (receiver, name) is NOT merged and NOT
/// dropped: it becomes its own row in the same chain, so the collision stays
/// describable. Silent choosing between overloads is not allowed anywhere.
/// `param_ids` carries the receiver FIRST when `has_recv` — the plan 273
/// order (§4.4 fixes the position, so the caller has no other place to put
/// it, and no way to name a second one).
export fn FnTable mut @add(name str, ret_id TyId, has_recv bool, param_ids []ParamDef,
                          tparam_names []str, tparam_bounds []str) -> () {
    ro off = @params.len()
    // Whole slice at once: std does the copy (nv-coding-style section 18a --
    // a counted push loop is the red flag it names).
    @params.append(param_ids)
    ro toff = @tparams.len()
    @tparams.append(tparam_names)
    // The bound pool is filled to the SAME length as the name pool, always:
    // `tparam_off` addresses both, and a short pool would silently shift every
    // later callable's bounds by one.
    for i in 0..tparam_names.len() {
        @tbounds.push(if i < tparam_bounds.len() { tparam_bounds[i] } else { "" })
    }
    @rows.push(FnDef { name, ret_id, param_off: off, param_cnt: param_ids.len(), has_recv,
                       tparam_off: toff, tparam_cnt: tparam_names.len() })
}
