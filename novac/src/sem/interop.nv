// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem/interop.nv -- THE interop surface: which C identifiers the shell
// our emission links into already carries.
//
// Donor: none -- this is a fact about OUR boundary, not a design borrowed from
//        anyone. The nearest kin is a linker's symbol table, and that is exactly
//        the question this answers one step earlier than the linker would.
// Role: layer 3 of the map (sem) -- an INPUT of compilation beside the std
//       declarations: read from the embedded shell once per process, never
//       remembered by the compiler (the hard-coded `[]int` the owner rolled back
//       on 2026-08-15 is the shape this table exists to make impossible).
// Used by: `check` (a literal whose instance the shell does not carry is refused
//          BY NAME instead of failing in clang), `emit_c` (which names to print).
// Guarded by: check-novac-ctx-tables.py (declared in plan 10.3b),
//             check-novac-row-fields.py (10.3v), check-novac-mangle-fixed-point
//             (every name we print exists in the shell -- the same fact, judged
//             after the fact at the gate; this table judges it before).
//
// INTEROP, and said so: the shell is the oracle's emission of the probe program
// (`novac/probe/shell_probe.nv`), so what the probe USES the shell CARRIES -- the
// probe is the declared interop surface, and widening it is a visible edit. END
// CONDITION: the day novac emits the whole prelude, the surface is ours and this
// table describes our own emission rather than a foreign one.

module novac.sem

import ../names.{NameTable, NamespaceId}

/// The set of C identifiers the linked shell carries.
///
/// A NameTable and not a vector, for the one reason every table here is a table:
/// the question is asked per literal and per call, and it must be O(1) (P18).
/// The id is meaningless -- membership is the whole answer -- so it is the row
/// count at insertion, which also makes `len` free.
export type InteropTable {
    names NameTable /// identifier -> insertion index; presence is the fact, the index is incidental (NsInterop namespace)
    sym_cnt int /// how many identifiers were lifted; printed by the gate so a shell that lost its symbols is loud
    modules NameTable /// the PROGRAM's modules, dotted (`novac.sem`): files handed from the program's own root (NOVAC_SELF_PATH), whose bodies the program compiles -- std's are not here (274.11 E.10 step 2a) (NsInterop namespace)
    stubs NameTable /// functions whose shell BODY is a constant in place of a refusal (registry 1643): the erased generic layer `Nova_Vec_method_equal(..) { (void)..; return (nova_bool){0}; }` -- carried, never callable; `@has` answers no for them (NsInterop namespace)
    struct_bodies NameTable /// identifiers the shell defines a `struct <name> {` BODY for -- a forward typedef is NOT here (C11 allows repeating it), so the declaration judge refuses only the real one-unit redefinition (NsInterop namespace)
    decl_names []str /// per handed declaration tree (its index in the decls handed to `collect`): the file name it was read from -- a contract in a body instantiated from it prints that name (274.11 E.10 step 4c); empty when the decls were not described
    decl_texts []str /// per handed declaration tree: the very text it was parsed from -- a token's position is its slice's distance from THAT buffer (`SourceText.offset_of`), so a copy would not do
}

/// A set of C identifiers of OUR emission (274.11 E.10 step 2b): the names one
/// unit of a program wants another to print (a call by its owner's name), and
/// the instances an earlier unit already printed. The same kind of name as the
/// shell's -- a C identifier -- and kept apart from it, because "the shell
/// carries it" and "the program printed it" are different facts.
export type CNames {
    names NameTable /// identifier -> insertion index; presence is the fact (NsInterop namespace)
    name_cnt int /// how many identifiers were added
}

/// An empty set.
export fn CNames.new() -> CNames => { names: NameTable.new(NamespaceId.NsInterop), name_cnt: 0 }

/// Add one identifier; answers whether it was new.
export fn CNames mut @add(name str) -> bool {
    if @names.find(name) >= 0 { return false }
    @names.put(name, @name_cnt)
    @name_cnt += 1
    true
}

/// Is this identifier in the set?
#realtime nogc
export fn CNames @has(name str) -> bool => @names.find(name) >= 0

/// An empty surface -- what a test builds when it wants no interop at all.
export fn InteropTable.new() -> InteropTable =>
    { names: NameTable.new(NamespaceId.NsInterop), sym_cnt: 0,
      modules: NameTable.new(NamespaceId.NsInterop), stubs: NameTable.new(NamespaceId.NsInterop),
      struct_bodies: NameTable.new(NamespaceId.NsInterop), decl_names: []str.new(), decl_texts: []str.new() }

/// Register one identifier the shell carries. A repeat is a no-op: the shell
/// mentions a symbol as often as it uses it, and the table records THAT it does.
export fn InteropTable mut @add(sym str) -> () {
    if @names.find(sym) >= 0 { return }
    @names.put(sym, @sym_cnt)
    @sym_cnt += 1
}

/// Does the shell carry this identifier? The O(1) door -- asked before printing
/// a name, so the answer "no" becomes a refusal by name rather than a linker error.
/// A STUB is carried and still answered no (registry 1643): its body returns a
/// constant whatever it is given, and printing its name would compile a silent
/// wrong value -- `==` over two vectors of the erased layer was always false.
#realtime nogc
export fn InteropTable @has(sym str) -> bool => @names.find(sym) >= 0 && @stubs.find(sym) < 0

/// Register a function the shell DEFINES as a stub (registry 1643). One writer:
/// shell_surface's scan, which reads the body's shape.
export fn InteropTable mut @add_stub(sym str) -> () {
    if @stubs.find(sym) >= 0 { return }
    @stubs.put(sym, 1)
}

/// Register a struct NAME the shell defines a body for (`struct X {` in the
/// template). One writer: shell_surface's scan.
export fn InteropTable mut @add_body(sym str) -> () {
    if @struct_bodies.find(sym) >= 0 { return }
    @struct_bodies.put(sym, 1)
}

/// Does the shell define a struct BODY under this name? The declaration
/// judge's question: a body is the one thing a unit cannot repeat.
#realtime nogc
export fn InteropTable @has_body(sym str) -> bool => @struct_bodies.find(sym) >= 0

/// Describes the handed declaration trees -- the file each was read from and
/// the text it was parsed from -- in the order the decls are handed to
/// `collect` (274.11 E.10 step 4c): a std body this unit instantiates is typed
/// against its own text and prints its own file in a contract.
export fn InteropTable mut @describe_decls(names []str, texts []str) -> ()
    requires names.len() == texts.len(), "sem: a declaration description with names and texts of different lengths"
{
    @decl_names = names
    @decl_texts = texts
}

/// The text handed declaration tree `tree` was parsed from, or None when the
/// decls were not described.
#realtime nogc
export fn InteropTable @decl_text(tree int) -> Option[str] {
    if tree < 0 || tree >= @decl_texts.len() { return None }
    Some(@decl_texts[tree])
}

/// The file handed declaration tree `tree` was read from, "" when the decls
/// were not described (asked after `@decl_text` answered).
#realtime nogc
export fn InteropTable @decl_name(tree int) -> str {
    if tree < 0 || tree >= @decl_names.len() { return "" }
    @decl_names[tree]
}

/// Marks a module of the PROGRAM on the link surface (274.11 E.10 step 2a).
export fn InteropTable mut @add_module(dotted str) -> () {
    if @modules.find(dotted) >= 0 { return }
    @modules.put(dotted, 1)
}

/// Is this module one of the program's (its bodies are compiled into it)?
#realtime nogc
export fn InteropTable @has_module(dotted str) -> bool => @modules.find(dotted) >= 0

/// Is this row's body in the PROGRAM -- the file's own, or a handed row of one of
/// the program's modules (274.11 E.10 step 2a)? The door that decides whose NAME a
/// call prints and whether the checker asks the shell; `compiles_body` stays the
/// door that says whether THIS unit prints the body.
export fn Ctx @in_program(row FnRow) -> bool {
    if @fns.compiles_body(row) { return true }
    ro h = @fns.rows[raw_row(row)].handed_from
    h != "" && @interop.has_module(h)
}

/// A4 FENCE OF THE PROGRAM (registry 221.1 #1813): does payload-free sum `t`
/// stand as an argument -- of an application or a newtype -- in THIS unit's
/// pool or in any other unit's of the program? The oracle compiles a program
/// as ONE unit, so its fence (`sum_placement.rs`) is a fact of the whole
/// program; judged by the unit's own pool alone, `lex` printed
/// `NovaValue_TokenKind` and `parse` (`[]TokenKind`) `Nova_TokenKind*` --
/// ~950 clang errors on novac itself. `fences` is empty in a single unit, where
/// the answer is the pool's alone. Asked only by `is_value_sum`, after
/// `is_payload_free_sum` -- so `t` is a sum with a declaration.
///
/// A SUM OF THE SHELL is not judged here at all (registry 221.1 #1830): its
/// layout was decided ONCE, when the oracle emitted the probe, and the shell
/// glued into every unit already carries the answer (`shell_fence`). Judged by
/// the unit's pool, `[]PathStyle` in a program printed `Nova_PathStyle*` for a
/// sum the shell declares only as `NovaValue_PathStyle` -- clang "unknown type
/// name 'Nova_PathStyle'".
fn is_fenced(ctx Ctx, t TyId) -> bool {
    match shell_fence(ctx, t) {
        Some(fenced) => { return fenced }
        None => {}
    }
    if ctx.tys.is_arg_anywhere(t) { return true }
    ctx.fences.name_cnt > 0 && ctx.fences.has(fence_key(ctx, t))
}

/// The SHELL's A4 answer for payload-free sum `t` (registry 221.1 #1830):
/// `Some(false)` when the shell defines `struct NovaValue_<name>` (laid out by
/// value), `Some(true)` when it defines `struct Nova_<name>` (on the heap), and
/// `None` when `t` is the program's (`fence_key` names it) or the shell defines
/// neither body -- a unit built with no shell, whose pool is then the only
/// judge. The shell spells std's types bare (`decl_base` keeps the name of a
/// type that is not the program's), so the declared name is the C base.
fn shell_fence(ctx Ctx, t TyId) -> Option[bool] {
    if fence_key(ctx, t) != "" { return None }
    ro nm = decl_of_ty(ctx, t).name
    if ctx.interop.has_body("NovaValue_${nm}") { return Some(false) }
    if ctx.interop.has_body("Nova_${nm}") { return Some(true) }
    None
}

/// Add THIS unit's fence to the program's: every payload-free sum of the
/// PROGRAM standing in the unit's argument pool, by `fence_key`. A sum of the
/// shell is not added: its layout is the oracle's emission of the probe, not
/// this program's to decide, and every unit reads it from the shell
/// (`shell_fence`, #1830).
export fn note_fences(ctx Ctx, mut into CNames) -> () {
    for i in 0..ctx.tys.arg_pool_len() {
        ro t = ctx.tys.arg_pool_at(i)
        if !is_payload_free_sum(ctx, t) { continue }
        ro k = fence_key(ctx, t)
        if k != "" {
            ro _ = into.add(k)
        } else {
            // The shell's sum: not the program's to fence.
        }
    }
}

/// The program-wide name of sum `t`: its owning module in C shape and its
/// declared name -- one string in every unit that names the sum (the owner is
/// `program_type_module`'s, #1786); `""` for the shell's.
fn fence_key(ctx Ctx, t TyId) -> str {
    match program_type_module(ctx, ctx.tys.decl_head_of(t)) {
        Some(m) => "${m}.${decl_of_ty(ctx, t).name}"
        None => ""
    }
}
