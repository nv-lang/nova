// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_symbol_mangling` -- the defining crate is part of a
// symbol's identity (v0 path prefix), so a name is qualified by where the
// entity was DECLARED, never by the unit that asks; NOT taken: its path
// grammar (our spellings must match the runtime ABI and the shell's names).
// Role: the half of the mangling door that answers WHOSE an entity is: the
//   shell's or the program's, and which module of the program owns it
//   (`program_type_module`, registry 221.1 #1786), the D381 C base of a
//   nominal type (`decl_base`), and the module part of our own names
//   (`module_prefix`, `c_module_part`, `row_module_prefix`). Split out of
//   mangle.nv by meaning when that file passed the size cap (274 decision 12).
// Used by: mangle.nv (`c_tag_enum`, `c_struct`, `c_tag`, `c_maker`,
//   `c_free_symbol`, `c_callable`, the in-name spellings) -- the same module.
// Guarded by: check-novac-mangle-fixed-point.sh (the spellings against the
//   oracle's emission of the probe), check-novac-differential.sh (fixtures
//   cross_module_sum/ -- another module's sum, tags and makers -- multi_module/
//   and shell_namesake/, byte for byte with the oracle).
//
// Same module as sem.nv and mangle.nv (folder = one module of co-equal files).

module novac.sem

import ../names.{raw_decl, DeclId, is_decl}
import ../types.{TyId}

/// D381 -- THE BASE of a nominal type's C name: the declared name, or
/// `<modpath>_<name>` when the name COLLIDES in the unit. The oracle's single
/// point (`def_type_base`/`ref_type_base`, spec 08-runtime.md D381, its
/// single-point paragraph): every spelling of a user struct, tag enum and
/// in-name argument goes through it. A name that does not collide comes back
/// unchanged, so a unit without a collision is byte-identical (D381 rejects
/// always-qualify).
fn type_base(ctx Ctx, t TyId) -> str => decl_base(ctx, ctx.tys.decl_head_of(t))

/// D381 -- does the SHELL already define a struct BODY under one of this
/// name's C spellings? The collision set of OUR unit: the shell is the
/// oracle's emission of the probe, where std's types are spelled BARE, and it
/// is glued into every unit we emit -- so a program type of that name is the
/// second declaration of one simple name in the unit (what D381 calls colliding),
/// and the std side cannot be renamed (interop). Both spellings, because a
/// value record or a payload-free sum comes out as `NovaValue_`.
fn shell_defines_struct(ctx Ctx, name str) -> bool =>
    ctx.interop.has_body("Nova_${name}") || ctx.interop.has_body("NovaValue_${name}")

/// D381 -- the C base of declaration `d`. Measured on the oracle 2026-10-06
/// (plan 274.5 section pre68): a user `ErrorKind` beside std.io's in one unit
/// is `Nova_p3_ErrorKind`, and `Nova_ErrorKind` when nothing collides.
///
/// COLLIDING is a NAME fact, as in D381 ("a simple name declared in two
/// modules"): a type of the PROGRAM whose name the shell already spells. Every
/// shape of it is qualified -- the oracle's D381 stops at plain-Sum and
/// heap-Record and fails the rest in clang (value record, newtype, generic:
/// registry 221.1 #1765), but a spelling is not a language rule, and a
/// program D125 makes legal is compiled whatever its shape. A newtype has no C
/// name of its own (its representation's), and a generic head is named by the
/// mono path, which the subset does not compile yet (E2-b2).
///
/// THE DEF MODULE, not the module of the file asking (D381's module
/// resolution): the file's own row takes the file's module, a handed row of a
/// program module its home -- `novac.lex`'s `Token` is `Nova_novac_lex_Token`
/// in every unit naming it -- and a handed row of std is the shell's and keeps
/// the name. A file with NO module takes D381's formula with an empty modpath,
/// `Nova__<Name>`: the oracle collapses that to the bare name, which in our
/// unit IS the shell's struct, and a type name never starts with `_` (D30), so
/// the doubled separator cannot meet a bare name.
fn decl_base(ctx Ctx, d DeclId) -> str
    requires is_decl(d) && raw_decl(d) < ctx.types.len(), "mangle: the C base of a declaration outside the registry"
{
    ro td = ctx.types[raw_decl(d)]
    if !shell_defines_struct(ctx, td.name) { return td.name }
    match program_type_module(ctx, d) {
        Some(m) => "${m}_${td.name}"
        None => td.name
    }
}

/// THE ONE DOOR "the shell's type or the program's" (registry 221.1 #1786,
/// #1790 (a)): `Some(<module path in C shape>)` when declaration `d` is the
/// PROGRAM's -- the file's own row (`ctx.module_c`), or a handed row whose
/// home is a module of the program (`interop.has_module`, 274.11 E.10 step
/// 2a) -- and `None` when it is the SHELL's: a handed row of std, or one no
/// row registers (nothing to qualify it by, the shell keeps it).
///
/// The row boundary `foreign_types_cnt` answers a DIFFERENT question --
/// whether THIS unit prints the declaration -- and in a program the two part:
/// another module's type is handed to the unit yet compiled by its owner, so
/// its tags, makers and C base are the owner's, never the shell's. Asked by
/// the boundary, `c_tag` wrote `NOVA_TAG_Node_Leaf` for `novac.tree`'s `Node`
/// in every other unit (~1000 clang errors on novac itself). The callable
/// twin is `Ctx @in_program` (sem/interop.nv).
fn program_type_module(ctx Ctx, d DeclId) -> Option[str] {
    if raw_decl(d) >= ctx.foreign_types_cnt { return Some(ctx.module_c) }
    match handed_type_home(ctx, d, ctx.types[raw_decl(d)].name) {
        Some(home) => if home != "" && ctx.interop.has_module(home) { Some(home.replace(".", "_")) } else { None }
        None => None
    }
}

/// The module a HANDED type declaration came from: the `DefTable` home of the
/// row registering it, found along the chain of same-named rows (#1521), None
/// when no row names it.
fn handed_type_home(ctx Ctx, d DeclId, name str) -> Option[str] {
    mut i = ctx.defs.first_def(name)
    while i >= 0 {
        ro hit = match ctx.defs.def_at(i).target {
            DefType(id) => id == d
            DefFn(_) | DefConst(_) => false
        }
        if hit { return Some(ctx.defs.home_at(i)) }
        i = ctx.defs.prev_def(i)
    }
    None
}

/// The module part of one of OUR names: the path plus a separator, or `""`.
///
/// A door and not `"${ctx.module_c}_"` at three call sites, because the EMPTY
/// case is the whole question: a file with no module declaration must add
/// nothing at all, and a trailing separator would make `novac_fn__helper` -- a
/// name with a hole where the identity is missing, which is exactly what a
/// reader would then have to know not to trust.
///
/// WHAT DOES NOT GET IT, and this is interop rather than an exception: the C
/// STRUCT names (`Nova_<name>`). Our emission is glued into the oracle's shell
/// (274 section 7.0), the shell declares those types, and a name we invent there
/// would not be the type the shell knows. They stay until novac emits the whole
/// prelude itself -- the same end condition every other interop line carries.
fn module_prefix(ctx Ctx) -> str => c_module_part(ctx.module_c)

/// The same part for ANY module path in C shape -- a type's owner
/// (`program_type_module`), not only the file's: `""` stays `""`.
fn c_module_part(m str) -> str {
    if m == "" { return "" }
    "${m}_"
}

/// The module prefix of a CALLABLE: the module of the ROW -- the file's for its
/// own rows, the handed file's (`handed_from`) for a handed one -- so every unit
/// that calls it names one symbol (274.11 E.10 step 1).
fn row_module_prefix(ctx Ctx, fd FnDef) -> str =>
    if fd.handed_from == "" { module_prefix(ctx) } else { "${fd.handed_from.replace(".", "_")}_" }
