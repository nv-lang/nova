// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc's crate metadata -- an item of another crate keeps its MIR, so a
// generic of that crate is instantiated by the CONSUMER from the body it was
// handed; NOT taken: an encoded metadata format -- novac's handed declarations
// are the parsed source trees themselves.
// Role: where a HANDED callable's body lives (274.11 E.10 step 4a): the
//   declaration tree it was read from (an index into the decls handed to
//   `collect`) and its `FnDecl` node there. A generic of std over a type of
//   novac's own (`Vec[TyRow] @index`) is instantiated from this body when the
//   shell carries no instance -- the shell cannot know novac's types.
// Used by: harvest.nv (`harvest_in` notes each handed row it reads); the
//   checker, mono and the emitter through `Ctx @instantiates` / `@body_ours`
//   (whose body an instance is); the pipeline's instance builder.
// Guarded by: nova test novac/src/pipeline/handed_free_test.nv (the handed body
//   tests) and check-novac-ctx-tables.py (the Ctx table, plan 274 s10.3b).

module novac.sem

import ../tree.{Node, NodeKind}
import ../types.{TyId, is_ty, no_ty, Interner, raw_ty}
import ../names.{NameTable, NamespaceId, raw_decl}
import ../builtins.{SLICE_HEAD, EMPTY_CTOR, VEC_INDEX_METHOD, VEC_INDEX_SET_OP, VEC_INDEX_RANGE_OP, RANGE_TYPE}

/// The bodies of the handed callables, by row.
export type HandedBodies {
    slot []int /// per callable row: its index in `trees`/`decls`, or -1 when the row has no handed body
    trees []int /// per noted row: the handed declaration tree it was read from (index into the decls)
    decls []Node /// per noted row: its `FnDecl` node in that tree
    rows []FnRow /// per noted row: the row itself -- what the same-name chain answers; `no_row()` for a DROPPED declaration (see `@note_dropped`)
    heads []int /// per noted row: the declaration the method hangs on (its index), -1 for a free function
    same_prev []int /// per noted row: the noted row of the same NAME read before it (its index here), -1 at the chain's end
    by_name NameTable /// callable name -> the LAST noted row of that name (its index here): the head of the chain `same_prev` continues
}

/// No handed body known yet.
fn HandedBodies.new() -> HandedBodies =>
    { slot: []int.new(), trees: []int.new(), decls: []Node.new(), rows: []FnRow.new(),
      heads: []int.new(), same_prev: []int.new(), by_name: NameTable.new(NamespaceId.NsCallables) }

/// Note that `row`, named `name`, was read from the `FnDecl` node `decl` of
/// handed tree `tree`. The rows are noted in READING order, so the same-name
/// chain runs from the latest back to the first -- the order an overload's
/// shell spelling is decided by (`Ctx @overload_ordinal`).
fn HandedBodies mut @note(row FnRow, name str, head int, tree int, decl Node) -> () {
    while @slot.len() <= raw_row(row) {
        @slot.push(-1)
    }
    @slot[raw_row(row)] = @trees.len()
    @chain(row, name, head, tree, decl)
}

/// Note a method declaration harvest did NOT take (a type it cannot read): no
/// row, no body to make -- but its PLACE among its name's overloads on `head`,
/// which is what the oracle's spelling of the later ones counts (registry
/// 1558). Without it a dropped early overload shifted every later ordinal down,
/// and the second overload was asked of the shell by the first's bare name.
fn HandedBodies mut @note_dropped(name str, head int, tree int, decl Node) -> () {
    @chain(no_row(), name, head, tree, decl)
}

/// One entry of the same-name chain, in reading order.
fn HandedBodies mut @chain(row FnRow, name str, head int, tree int, decl Node) -> () {
    ro s = @trees.len()
    @trees.push(tree)
    @decls.push(decl)
    @rows.push(row)
    @heads.push(head)
    @same_prev.push(@by_name.find(name))
    @by_name.put(name, s)
}

/// WHICH type a method hangs on, as one int: the index of the declaration an
/// application or a nominal names (>= 0), or -- for a term that names no
/// declaration, a primitive -- its own type id, kept apart below -1; -1 for a
/// free function's `no_ty()`. Until the primitives had their own key every
/// method of every primitive shared -1, and `int @max` counted `u8 @max` as an
/// earlier overload of itself (registry 1558).
fn head_index(tys Interner, t TyId) -> int {
    if !is_ty(t) { return -1 }
    if tys.names_a_decl(t) { return raw_decl(tys.decl_head_of(t)) }
    -2 - raw_ty(t)
}

/// How many handed methods of `row`'s name hang on its type -- taken or
/// dropped, before it or after: the count the oracle's EXTERN spelling asks
/// (`Ctx @overload_suffix`). 0 for a row that was not handed.
#realtime nogc
fn Ctx @overload_count(row FnRow) -> int {
    ro s = if raw_row(row) >= 0 && raw_row(row) < @handed.slot.len() { @handed.slot[raw_row(row)] } else { -1 }
    mut n = 0
    if s >= 0 {
        ro on = @handed.heads[s]
        mut p = @handed.by_name.find(@fns.rows[raw_row(row)].name)
        while p >= 0 {
            n += if @handed.heads[p] == on { 1 } else { 0 }
            p = @handed.same_prev[p]
        }
    } else {
        // A row that was not handed: no overload of it was harvested.
    }
    n
}

/// Is `row` a handed declaration with NO body -- `extern "nova" fn` (the
/// runtime's own, `AtomicInt @load`)? The oracle names those by another rule
/// (`external_registry.rs`), so the overload spelling must know (registry 1558).
fn Ctx @is_extern_handed(row FnRow) -> bool {
    match @handed.decl_of(row) {
        Some(d) => !has_body(d)
        None => false
    }
}

/// The handed `FnDecl` of `row`, or `None` for a row read from nowhere (the
/// file's own, a constructor, a builtin).
export fn HandedBodies @decl_of(row FnRow) -> Option[Node] {
    if raw_row(row) < 0 || raw_row(row) >= @slot.len() { return None }
    ro s = @slot[raw_row(row)]
    if s < 0 { None } else { Some(@decls[s]) }
}

/// The handed tree `row` was read from, or -1 (the rows `decl_of` answers None for).
export fn HandedBodies @tree_of(row FnRow) -> int {
    if raw_row(row) < 0 || raw_row(row) >= @slot.len() { return -1 }
    ro s = @slot[raw_row(row)]
    if s < 0 { -1 } else { @trees[s] }
}

/// Does THIS unit instantiate `row` under `args` from the body it was handed
/// (274.11 E.10 step 4c)? A generic callable of another module -- std's
/// `Vec[T] @len` -- with a handed body, under type arguments the shell carries
/// no instance for: `Vec[Pt]` over a type of the program, which the probe the
/// shell is built from cannot know. Where the shell DOES carry the instance
/// (`Vec____nova_int_method_len`), the answer is no and the shell's is called:
/// one body per instance in the linked program.
///
/// A FREE generic callable of another module answers no here: its shell
/// spelling is not the method door's, and none is instantiated yet (its
/// refusal names it, check/calls.nv).
export fn Ctx @instantiates(row FnRow, args []TyId) -> bool {
    if @fns.compiles_body(row) { return false }
    if @handed.decl_of(row).is_none() { return false }
    ro fd = @fns.rows[raw_row(row)]
    if args.len() != fd.tparam_cnt { return false }
    // A NON-generic row of another module of the PROGRAM is compiled by its
    // owner unit, never a second time here (274.11 E.10 step 2a); a generic one
    // is instantiated by the caller, which alone knows the substitution.
    if fd.tparam_cnt == 0 && @in_program(row) { return false }
    // A declaration with no body (`extern "nova"`) has nothing to make an
    // instance FROM: the shell's or nothing (registry shell-str, task 4).
    ro bodied = match @handed.decl_of(row) {
        Some(d) => has_body(d)
        None => false
    }
    if !bodied { return false }
    // A FREE generic function of another module (`alloc_buf[T]`, 274.11 E.10
    // step 4c-2): the shell's spelling of its instances is not novac's to
    // compute, so a generic one with a BODY is always this unit's to make --
    // under OUR name, which cannot collide with the shell's. An `extern` one
    // has no body to make it from.
    // A NON-generic one is this unit's to make only when the shell does not
    // carry it (task 4: std's private `is_ascii_ws`, called from the body of
    // `str @trim_ascii`, was printed under the shell's name the shell lacks).
    if !fd.has_recv && !is_ty(fd.owner) {
        return fd.tparam_cnt > 0 || !@interop.has(c_free_symbol(@, row))
    } else {
        // A method or a static method: the shell is asked below.
    }
    // A STATIC method (`Vec[T].new`) is spelled off its owner type, a method
    // off its receiver (274.11 E.10 step 4c-2).
    if is_ty(fd.owner) {
        return !@interop.has(c_static_symbol(@, row, args))
    } else {
        // A method: its receiver is parameter zero.
    }
    if !fd.has_recv || fd.param_cnt == 0 { return false }
    ro recv_t = subst_type(@, @fns.params[fd.param_off].type_id, args)
    // THE OVERLOAD, not the name (registry 1524): `cap()` and `cap(n)` are two
    // shell functions, and asking by the name answered "carried" for both.
    !@interop.has(c_overload_symbol(@, row, recv_t, args))
}

/// WHICH overload of its name `row` is on its type, counted in READING order
/// from zero: how many handed methods of the same name on the same type were
/// read before it. The oracle spells the first overload by the bare name and
/// every later one with a suffix of its parameter types
/// (`Vec____nova_int_method_cap` / `..._cap__nova_int`, the generic-method
/// overload mangling of the oracle's `emit_c.rs`), so this number is what the shell
/// question is asked by (registry 1524). A walk of the name's chain, never a
/// scan of the registry; -1 for a row that was not handed.
fn Ctx @overload_ordinal(row FnRow) -> int {
    if raw_row(row) < 0 || raw_row(row) >= @handed.slot.len() { return -1 }
    ro s = @handed.slot[raw_row(row)]
    if s < 0 { return -1 }
    // Counted over DECLARATIONS, taken or dropped (`@note_dropped`), on the
    // same type -- the oracle's order (registry 1558).
    ro on = @handed.heads[s]
    mut n = 0
    mut p = @handed.same_prev[s]
    while p >= 0 {
        n += if @handed.heads[p] == on { 1 } else { 0 }
        p = @handed.same_prev[p]
    }
    n
}

/// Is the body of this call's callee compiled into this program -- the file's
/// own, a handed row of a program module, or an instance this unit makes from
/// a handed body? The door that decides whose NAME a call prints.
export fn Ctx @body_ours(row FnRow, args []TyId) -> bool => @in_program(row) || @instantiates(row, args)

/// Is `row` -- a callable NAMED like the implicit vector operation `name` (the
/// caller walks the name's chain in the callable index) -- the std
/// declaration of `Vec[T]` that operation calls (274.11 E.10 step 4c-2)? The
/// overloads are told apart by the SHAPE the implicit call has: the
/// constructor that takes a capacity (not the unsafe raw-parts ones), the push
/// that copies (not the consuming one), the index by `int` (not by `Range`),
/// and for the WRITE (`VEC_INDEX_SET_OP`) the `mut @index(i int, val T)` that
/// copies its value in (registry 1524).
export fn Ctx @is_vec_op_shape(row FnRow, name str) -> bool {
    ro fd = @fns.rows[raw_row(row)]
    // A HANDED row only: std may be handed without a module line (`handed_from` "").
    if @fns.compiles_body(row) { return false }
    ro first = if fd.param_cnt > 0 { @fns.params[fd.param_off].type_id } else { no_ty() }
    ro on = if is_ty(fd.owner) { fd.owner } else { first }
    if !is_ty(on) || !@tys.names_a_decl(on) || decl_of_ty(@, on).name != SLICE_HEAD { return false }
    if name == EMPTY_CTOR {
        return is_ty(fd.owner) && fd.param_cnt == 1 && @fns.params[fd.param_off].type_id == @prims.int_id
    } else if name == VEC_INDEX_RANGE_OP {
        // The SLICE: `@index(r Range) -> Self` (registry 1557).
        if !fd.has_recv || fd.param_cnt != 2 { return false }
        ro rt = @fns.params[fd.param_off + 1].type_id
        return is_ty(rt) && @tys.names_a_decl(rt) && decl_of_ty(@, rt).name == RANGE_TYPE
    } else if name == VEC_INDEX_SET_OP {
        if !fd.has_recv || fd.param_cnt != 3 { return false }
        return @fns.params[fd.param_off + 1].type_id == @prims.int_id &&
            @fns.params[fd.param_off + 2].mode != ParamMode.ModeConsume
    } else if fd.param_cnt == 1 {
        return fd.has_recv
    } else if fd.param_cnt == 2 {
        ro second = @fns.params[fd.param_off + 1]
        ro copying = second.mode != ParamMode.ModeConsume
        ro by_int = name != VEC_INDEX_METHOD || second.type_id == @prims.int_id
        return fd.has_recv && copying && by_int
    } else {
        // Another arity: not the implicit operation's shape.
        return false
    }
}

/// Does a handed declaration carry a BODY -- a block or `=> expr` -- rather than
/// being `extern`?
fn has_body(decl Node) -> bool {
    for c in branch_children(decl) {
        if c.kind_of() == NodeKind.Block || c.kind_of() == NodeKind.FnExprBody { return true }
    }
    false
}

