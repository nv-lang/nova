// Donor: rustc `rustc_hir::Expr::is_*` and `ExprKind` predicates -- the question
//   "what IS this node" is answered next to the tree's own vocabulary, once, and
//   every consumer reads that answer instead of re-deriving it from the kind.
// Role: layer sem -- the CHANNEL's yes/no questions about a node. Judgement about
//   the SHAPE of a node lives here; extraction and parsing (slots, children, texts)
//   stay in slots.nv, which is why this file was split off it on 2026-09-13 when
//   that file crossed the 1000-line limit. The file-size guard demands cutting by
//   meaning and forbids both a baseline and an exception.
// Used by: check/ and lower/ while lowering and type-checking; a folder is one
//   module, so moving these out of slots.nv changed no import anywhere outside.
// Guarded by: check-novac-deps.py (the edges these predicates exist to remove),
//   check-novac-file-size.py (the limit that forced the split), check-novac-lint.sh.
//
// THE FAMILY GROWS, and it grows by a rule: three of the six predicates here were
// written within one day, all for the same reason -- the lowering asks the CHANNEL
// what a node MEANS instead of deriving it at the consumer (plan 196, stage E2-b1).
// A new question of that shape belongs here, not in the consumer that needs it.

module novac.sem

import ../builtins.{PRINT_FN, is_print_fn}
import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}

/// Is this child of a call an ARGUMENT? Two shapes are: a bare expression, and
/// a NAMED argument (`by: 2`), which is a node WRAPPING one.
///
/// A door because the answer used to be `is_expr_kind(c.kind_of())` at four
/// call sites, and a named argument is not an expression kind -- so every one of
/// them counted the arguments of `f(1, by: 2)` as one.
///
/// A TUPLE LITERAL is the third shape (`is_arg_value_kind`).
export fn is_arg_node(c Node) -> bool =>
    is_arg_value_kind(c.kind_of()) || c.kind_of() == NodeKind.NamedArg

/// May a node of this kind stand as an argument's VALUE -- an expression, or a
/// TUPLE LITERAL (part 5 of p274-carina-k1)? `Some((a, b))` was counted as NO
/// argument and typed by no walk, and the variant was refused as taking "a
/// different number of payload values" -- the RecordCtor/IfExpr/Index lesson
/// once more. The tuple joins THIS door and not `is_expr_kind`, which feeds
/// every general arm (wave B13); the walks that count or type a call's
/// arguments ask here.
/// The SAME set as `is_value_tail_kind` below, asked under the name of its
/// position -- one list, so the two cannot drift.
export fn is_arg_value_kind(k NodeKind) -> bool => is_value_tail_kind(k)

/// The kinds a VALUE TAIL may have -- `is_expr_kind` plus the one positional
/// record literal the tail chain returns since B15 step 4b. ONE door for the
/// three askers that used to spell the disjunction each on their own (the tail
/// rule, the `=>` body's typing, the emitter's body arm), and two of them had
/// not: the body was never typed and never built, and iced after a green check
/// (#974). NOT folded into `is_expr_kind` -- that list is read by many walks,
/// and a kind put into it moves silently into every general arm (B13).
export fn is_value_tail_kind(k NodeKind) -> bool => is_expr_kind(k) || k == NodeKind.TupleExpr

/// Is this leaf the REST marker `..`? A question about what the node MEANS, so
/// the channel answers it and not the consumer: an array pattern's lowering
/// asks which side of the marker an element stands on, and `lower` has no
/// edge to `lex`. (Its companions `is_int_lit` / `is_ident_leaf`, written by
/// the same move, left with the D486 arc 2026-09-29 -- an export nobody asks
/// is code nobody runs, P35.)
export fn is_dotdot(n Node) -> bool => leaf_kind(n) == TokenKind.DotDot

/// Node kinds that stand as expressions (argument/operand positions).
export fn is_expr_kind(k NodeKind) -> bool {
    // Wrapped with a TRAILING operator only: probed 2026-08-17 -- a leading
    // `||` on the next line is parsed as something else entirely (the oracle
    // answered E_CLOSURE_SCALAR_RETURN), and parentheses around a multi-line
    // chain are refused outright.
    k == NodeKind.Paren ||
    k == NodeKind.Unary ||
    k == NodeKind.Bin ||
    k == NodeKind.Lit ||
    k == NodeKind.Name ||
    k == NodeKind.Call ||
    k == NodeKind.MethodCall ||
    k == NodeKind.FieldAccess ||
    // `@field` is an EXPRESSION, and saying so here is what lets an
    // expression-bodied method (`fn Box @size() -> int => @n`) reach the
    // emitter at all: without it the body was "neither a match nor an
    // expression" and iced (wave 3g, measured 2026-08-23).
    k == NodeKind.SelfField ||
    k == NodeKind.SelfExpr ||
    // `unsafe { ... }` is an EXPRESSION whose value is its block's tail (D216 s8).
    k == NodeKind.Unsafe ||
    k == NodeKind.InterpStr ||
    // `a ?? b` is an expression, and its VALUE is what the argument or the
    // binding reads -- the emitter hoists it into a temporary the way it
    // hoists an interpolation chain (the coalesce wave).
    k == NodeKind.Coalesce ||
    // `a?` (D85, registry #1264): an expression shape too, even
    // though `@type_expr`'s own door always refuses it -- without this the
    // refusal door is never REACHED, and the initializer/argument walkers
    // that gate on `is_expr_kind` before calling `@type_expr` skip it
    // entirely, letting the node reach `type_of`'s generic ice instead of
    // the named refusal.
    k == NodeKind.Try ||
    k == NodeKind.MatchExpr ||
    // An array literal is an expression since wave B8 let it stand in
    // argument and constructor-field position; the walks that skip
    // non-expressions must not skip it, or its type is never recorded.
    k == NodeKind.ArrayLit ||
    // A RECORD CONSTRUCTOR joins it for the same reason in wave B13, and the
    // measurement that found this is worth keeping: `grab(P { n: 7 })` was
    // refused with "this call omits `p`" -- not because the constructor was
    // rejected, but because the argument COUNT never saw it. Counting goes
    // through `is_arg_node`, `is_arg_node` asks here, and a form missing from
    // this list is not refused anywhere. It is simply not there.
    k == NodeKind.RecordCtor ||
    k == NodeKind.Cast ||
    k == NodeKind.IsTest ||
    // AN `if` VALUE joins for the identical reason RecordCtor did (see the
    // comment above): registry #TBD found `pick(if c {10} else {20}))`
    // refused with "this call omits `x`" even after `check.nv`'s shape gate
    // and `exprs.nv`'s `type_expr` both learned the argument position --
    // counting never saw the node, because counting goes through
    // `is_arg_node`, which asks here, and IfExpr was not on this list.
    k == NodeKind.IfExpr ||
    // AN INDEX EXPRESSION (`xs[i]`) joins for the IDENTICAL reason (found
    // 2026-09-22): `takes_one(xs[0])` was refused "this call omits `n`" even
    // though `xs[0]` is plainly the one argument written -- counting goes
    // through `is_arg_node`, which asks here, and `NodeKind.Index` was not on
    // this list, so the argument was never counted at all. Indexing itself is
    // still a separate, already-named subset gap ("indexing is read but not
    // compiled yet", binds.nv) -- this fix only lets the call reach THAT
    // honest refusal instead of the misleading "omits a parameter" one.
    k == NodeKind.Index
}

/// Is this a call to `println` in the source? A question about meaning, so the
/// channel answers it -- exactly as for `is_int_lit`.
///
/// Written 2026-09-10 for the lowering's move: `lower` has no edge to `builtins`,
/// and `lower_eval` compared the callee's name against `PRINT_FN` directly.
///
/// Worth saying about `PRINT_FN` itself: it is NOT a C name but the name of a
/// function in the LANGUAGE (`PRINT_FN = "println"`). It sat in my notes as backend
/// knowledge for half a day purely because it lives in a module called `builtins`
/// -- a guess from the module's name, undone by reading the constant.
export fn is_println_call(e Node) -> bool {
    if e.kind_of() != NodeKind.Call { return false }
    is_print_fn(call_callee_text(branch_children(e)))
}

/// Does this print statement close its line -- `println`, not `print`? Asked
/// of a call `is_println_call` admitted.
export fn print_call_ends_line(e Node) -> bool => call_callee_text(branch_children(e)) == PRINT_FN

/// Is this `for` head a COLLECTION -- a value handing back a vector whose
/// element the loop variable is (wave B16) -- rather than a range `lo..hi`?
/// ONE list for the three layers that dispatch on it: the form rule (check/
/// rules.nv), typing (check/typing.nv) and the lowering (lower/lowering.nv).
/// Until 2026-09-30 each spelled the four kinds itself, and a slice head
/// (`for p in a[argi..]`, main.nv; registry #1170) needed the same word in
/// three places. What the head hands back is typing's question
/// (`for_head_elem`), not this one's.
/// A receiver field (`for c in @captures`) and an array literal (`for m in
/// []str.of(a, b)`, `for x in [1, 2]`) joined 2026-10-01: both are values the
/// same three layers already type, copy into the loop's temporary and index --
/// the list, not the machinery, was what refused them (twice over novac's own
/// source in the 0.2 measure).
export fn is_collection_head(n Node) -> bool {
    ro k = n.kind_of()
    k == NodeKind.Call || k == NodeKind.MethodCall || k == NodeKind.Name ||
        k == NodeKind.FieldAccess || k == NodeKind.Index || k == NodeKind.SelfField ||
        k == NodeKind.ArrayLit
}

/// Whether a `LoopCtl` node is `break` rather than `continue` (274.7 wave B10). ONE door
/// for the lowering, which picks the terminator, and the tail rule, which asks whether a
/// `while true` has a way out: the keyword leaf is the node's one child.
export fn loop_ctl_is_break(n Node) -> bool => leaf_kind(branch_children(n)[0]) == TokenKind.KwBreak

/// Does this declaration return its RECEIVER -- `-> @` (D132, D409)? Its body
/// writes no self-return: a missing tail or a bare `return` IS `return @`
/// (D409, 274.11 E.10 step 4c-2: std's `Vec[T] @push` and `@reserve`).
export fn returns_receiver(fk []Node) -> bool {
    for c in fk {
        if c.kind_of() != NodeKind.RetType { continue }
        ro rk = branch_children(c)
        return rk.len() == 2 && rk[1].kind_of() == NodeKind.LeafNode && leaf_kind(rk[1]) == TokenKind.At
    }
    false
}

/// The one expression of `unsafe { e }` -- `None` when the block holds a
/// statement besides it, or no expression at all. The block is a typing context
/// (D216) and does nothing when the program runs, so it IS this expression in
/// every value position at once -- the operand of `as` (std's `trim_ascii`:
/// `unsafe { @ptr().read_at(i) } as int`), a condition, an operand -- rather than
/// one hoist per position (the class registry 1525 named). ONE door for the two
/// askers: the walk's position gate admits such a block anywhere, and the
/// emitter prints it as its expression. A block WITH statements is the
/// lowering's to hoist, in the positions it hoists.
export fn sole_expr_of_unsafe(e Node) -> Option[Node] {
    ro uk = branch_children(e)
    if uk.len() < 2 { return None }
    ro bk = branch_children(uk[1])
    mut n = 0
    mut at = -1
    for i in 0..bk.len() {
        if bk[i].kind_of() == NodeKind.LeafNode { continue }
        n += 1
        at = i
    }
    if n == 1 && is_value_tail_kind(bk[at].kind_of()) { Some(bk[at]) } else { None }
}

/// Is this `??` (its children: left side, `??`, fallback...) the form whose fallback
/// is `return` -- `X ?? return R` (D86 amended 2026-09-01)? The parser keeps the
/// keyword as a leaf, so the question is one leaf's kind; the checker judges the form
/// and the lowering leaves the body from its None branch, and both ask HERE.
export fn is_coalesce_return(qk []Node) -> bool {
    if qk.len() < 3 { return false }
    match qk[2] {
        Leaf(t) => t.kind == TokenKind.KwReturn
        Branch { .. } => false
    }
}
