// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem/literal_spelling.nv -- the C SPELLING of a literal's text:
// the integer, float, char and string doors every emitter reads.
//
// Donor: rustc `rustc_codegen_ssa` constant lowering -- a literal's value is
// spelled for the backend in ONE place from the token's text; NOT taken: a
// parsed numeric value carried in the token, which the lossless lexer of
// novac does not hold (the text IS the token).
// Role: layer 3 -- what C text a Nova literal becomes. Each door is one
//   answer to "what is written here", so two emitters cannot spell the same
//   literal two ways (the int literal's octal hunt, 2026-09-02, N1).
// Used by: emit_c (emit_expr.nv, emit_match.nv, emit_interp.nv, emit_assert.nv,
//   emit_requires.nv, shell.nv) and check/cast_pairs.nv (a char's codepoint).
// Guarded by: check-novac-differential.sh (the fixtures float_exponent/,
//   const_bool_cast/ and the hex and char waves, byte-for-byte with the
//   oracle), nova test of mangle_test.nv (the int, char and string doors).
//
// Cut out of mangle.nv (2026-10-02, registry 1605) when the float door pushed
// that file past the 1000-line bound: a literal's spelling is not an entity's
// C NAME, so the cut follows the meaning, not only the count.

module novac.sem

import ../diag.{ice}

/// The C SPELLING of an integer literal's text. C reads a leading zero as
/// OCTAL (hunt 2026-09-02, N1: `println(0123)` printed 83, a `010 =>` arm
/// matched the other branch, `08` broke clang), so the decimal spelling
/// drops the leading zeros -- the same strip the magnitude judge already
/// performs (literal_rules.nv): ONE answer to "what number is written
/// here", at the one door both emitters read. A hex literal keeps its
/// digits: C reads `0x` exactly as Nova does. Both go through
/// `literal_digits` first -- C has no `_`.
export fn int_literal_c_text(text str) -> str {
    ro t = literal_digits(text)
    if t.byte_len() > 2 && t[..2] == "0x" { return t }
    mut i = 0
    while i + 1 < t.byte_len() && t[i..i + 1] == "0" { i += 1 }
    t[i..]
}

/// The DIGITS of a numeric literal's text: the D44 separators dropped
/// (`1_000` -> `1000`, `0xFF_FF` -> `0xFFFF`, `1_000.5e3` -> `1000.5e3`), the
/// rest verbatim. ONE door for every reader of a literal's number -- the
/// magnitude judges (check/literal_rules.nv), the integer and float C
/// spellings -- so no reader meets a separator another one stripped (#1605).
/// A float's C spelling IS its digits: C reads the fraction and the signed
/// exponent exactly as Nova writes them.
export fn literal_digits(t str) -> str {
    // Slices between the separators, not `replace`: the shell Carina links
    // into carries no `replace` for str yet. The width is bound first: a
    // method call as the named argument of a static call is an ICE in
    // novac's own check (registry 1618).
    ro width = t.byte_len()
    consume out = StringBuilder.new(cap: width)
    mut from = 0
    for i in 0..t.byte_len() {
        if t[i..i + 1] == "_" {
            out.append(t[from..i])
            from = i + 1
        } else {
            // A digit, the `0x` head, the dot, the exponent letter or its sign: kept.
        }
    }
    out.append(t[from..])
    out
}

/// The CODEPOINT of a char literal's text, as decimal C digits: `'A'` -> "65",
/// a newline escape -> "10". The int literal's precedent exactly: one spelling
/// door, every emitter through it, so two readers cannot disagree about what
/// character is written. The judge upstream (check) refused everything but one
/// codepoint or one defined escape, so the leftover here is an ice, not a
/// diagnostic.
export fn char_literal_code(t str) -> str {
    ro body = t[1..t.byte_len() - 1]
    ro b = body.bytes()
    if b[0] == BACKSLASH_BYTE {
        // BYTES, not one-letter strings: the P24 scanner reads a quoted
        // identifier-like string in an emitting module as a printed C name,
        // and it is right to -- a char literal is the honest spelling here.
        ro e = b[1]
        if e == ('n' as u8) { return "10" }
        if e == ('t' as u8) { return "9" }
        if e == ('r' as u8) { return "13" }
        if e == BACKSLASH_BYTE { return "92" }
        if e == ('\'' as u8) { return "39" }
        if e == ('"' as u8) { return "34" }
        if e == ('0' as u8) { return "0" }
        ice("mangle: a char escape the judge let through")
    }
    // One UTF-8 codepoint, 1-4 bytes: the head byte announces the length and
    // carries the high bits, each continuation byte carries six more.
    ro head = b[0] as int
    if head < 128 { return "${head}" }
    mut cp = 0
    mut i = 1
    if head >= 240 {
        cp = head - 240
    } else if head >= 224 {
        cp = head - 224
    } else {
        cp = head - 192
    }
    while i < b.len() {
        cp = cp * 64 + ((b[i] as int) - 128)
        i += 1
    }
    "${cp}"
}

/// The two bytes the dollar rule reads.
const BACKSLASH_BYTE u8 = 0x5C  // backslash
const DOLLAR_BYTE u8 = 0x24     // $

/// A Nova string literal's text as C text -- the ONE door every literal takes
/// into C. Nova's subset escape set (\" \\ \n \t \r) matches C's one for one
/// -- check refuses everything else by name -- with three exceptions whose Nova
/// spelling C does not share: the line continuation, `\u{H…}` and `\$`. THREE readers
/// spell literals into C: the shell's literal pool, the contract prologue's
/// message slot and an interpolated string's pieces -- the hunt (2026-09-02,
/// its P1 contradiction) caught the pool claiming to be `the only place`
/// while the prologue shipped the backslash through; one door ends that
/// argument by construction.
export fn literal_as_c_text(s str) -> str => unescape_dollar(spell_unicode_escapes(splice_continuations(s)))

/// THE `\u{H…}` ESCAPE (D467 section 2) as the judge asks it: `at` is the
/// index of the `u` in the literal's bytes; the answer is the index of the
/// closing `}` when the escape is well formed AND names a Unicode scalar
/// value, else -1. One door for the judge (check/strings.nv), the byte count
/// (`escaped_byte_len`) and the C spelling below, so the three cannot read
/// one escape three ways.
export fn unicode_escape_end(b []u8, at int) -> int {
    ro close = unicode_escape_close(b, at)
    if close < 0 || unicode_escape_value(b, at, close) < 0 { -1 } else { close }
}

/// The SHAPE of the escape: one or more hex digits of either case between
/// braces, no separator. The index of the closing `}`, or -1 when the brace
/// or the digits are missing -- the oracle's lexer reads the same shape
/// ("expected hex digits", "expected '}'").
fn unicode_escape_close(b []u8, at int) -> int {
    if at + 1 >= b.len() || b[at + 1] != UESC_LBRACE { return -1 }
    mut i = at + 2
    while i < b.len() && hex_digit_value(b[i]) >= 0 { i += 1 }
    if i == at + 2 || i >= b.len() || b[i] != UESC_RBRACE { return -1 }
    i
}

/// The codepoint the escape names, or -1 when it names no Unicode scalar
/// value: D467 section 2 refuses a surrogate (U+D800..U+DFFF) and anything
/// past U+10FFFF. `close` is `unicode_escape_close`'s answer. The sum stops
/// growing once it is past the bound, so a run of digits longer than an int
/// holds cannot wrap around into a valid value.
fn unicode_escape_value(b []u8, at int, close int) -> int {
    mut cp = 0
    for i in at + 2..close {
        if cp <= UESC_MAX {
            cp = cp * 16 + hex_digit_value(b[i])
        } else {
            // Past the bound already: the sum stops growing, so it cannot wrap.
        }
    }
    if cp > UESC_MAX || (cp >= UESC_SURROGATE_LO && cp <= UESC_SURROGATE_HI) { -1 } else { cp }
}

/// How many bytes UTF-8 spends on a codepoint -- what a `str` holds for it.
fn utf8_width(cp int) -> int {
    if cp < 0x80 { return 1 }
    if cp < 0x800 { return 2 }
    if cp < 0x10000 { return 3 }
    4
}

/// The value of one hex digit byte, either case, or -1 for any other byte.
fn hex_digit_value(c u8) -> int {
    ro v = c as int
    if v >= 0x30 && v <= 0x39 { return v - 0x30 }
    if v >= 0x61 && v <= 0x66 { return v - 0x61 + 10 }
    if v >= 0x41 && v <= 0x46 { return v - 0x41 + 10 }
    -1
}

/// The `\u{H…}` third of the door: each escape becomes the C escapes of its
/// UTF-8 bytes, `\u{43f}` -> `\320\277` -- the `str` holds the codepoint
/// encoded, not the letters of its spelling. OCTAL and not `\x`: C's hex
/// escape swallows EVERY hex digit after it, so `\u{43f}a` spelled
/// `\xd0\xbfa` would read `\xbfa` as one escape; an octal escape stops at
/// three digits by definition. A cursor over the BYTES, the precedent of
/// `escaped_byte_len`; every other escape is stepped over whole, so `\\u{41}`
/// stays a backslash and four letters. The judge refused every malformed or
/// out-of-range escape, so one reaching here is an ice.
fn spell_unicode_escapes(s str) -> str {
    if !s.contains("\\u{") { return s }
    ro b = s.bytes()
    ro n = b.len()
    consume out = StringBuilder.new(cap: n)
    mut from = 0
    mut i = 0
    while i < n {
        if b[i] != BACKSLASH_BYTE || i + 1 >= n {
            i += 1
            continue
        }
        if b[i + 1] != UESC_LOWER_U {
            i += 2
            continue
        }
        ro close = unicode_escape_close(b, i + 1)
        ro cp = if close < 0 { -1 } else { unicode_escape_value(b, i + 1, close) }
        assert(cp >= 0, "mangle: a unicode escape the judge let through")
        out.append(s[from..i])
        append_utf8_octal(out, cp)
        i = close + 1
        from = i
    }
    out.append(s[from..])
    out
}

/// Append one codepoint as the octal C escapes of its UTF-8 bytes: the head
/// byte announces the length and carries the high bits, each continuation
/// byte carries six more (the inverse of `char_literal_code`'s decode).
fn append_utf8_octal(mut out StringBuilder, cp int) -> () {
    ro w = utf8_width(cp)
    if w == 1 {
        append_octal_byte(out, cp)
        return
    }
    if w == 2 {
        append_octal_byte(out, 192 + cp / 64)
    } else if w == 3 {
        append_octal_byte(out, 224 + cp / 4096)
        append_octal_byte(out, 128 + cp / 64 % 64)
    } else {
        append_octal_byte(out, 240 + cp / 262144)
        append_octal_byte(out, 128 + cp / 4096 % 64)
        append_octal_byte(out, 128 + cp / 64 % 64)
    }
    append_octal_byte(out, 128 + cp % 64)
}

/// One byte as a three-digit C octal escape (`\320`): always three digits,
/// so a digit that follows in the literal is never read into the escape.
fn append_octal_byte(mut out StringBuilder, v int) -> () {
    out.append("\\")
    out.append("${v / 64}${v / 8 % 8}${v % 8}")
}

/// The bytes and bounds the unicode escape reads. The `UESC_` prefix is not
/// decoration: `check/cast_pairs.nv` owns a `SURROGATE_LO` of its own, and a
/// same-named constant of another module made the oracle's C for check name
/// `Nova_const_novac_sem_SURROGATE_LO` without declaring it (measured on this
/// change; the class strings.nv's NEWLINE note records, registry 1158).
const UESC_LOWER_U u8 = 0x75  // u
const UESC_LBRACE u8 = 0x7B   // {
const UESC_RBRACE u8 = 0x7D   // }
const UESC_MAX = 0x10FFFF
const UESC_SURROGATE_LO = 0xD800
const UESC_SURROGATE_HI = 0xDFFF

/// D467 section 3: `\` right before a line break eats the break AND the
/// leading spaces and tabs of the next line (the oracle's lexer, the same
/// bytes). Until registry 1324 this was left to C, whose phase-2 splice
/// joins the lines but KEEPS the next line's indentation: `"x\` + newline +
/// `  y"` printed `x  y` where the oracle prints `xy` -- a silent wrong
/// string, measured with the behaviour smoke on an LF and a CRLF file.
///
/// Written with `@replace` and no cursor, the rule of the door below, and for
/// one more reason: this module is part of novac's own source, and a byte
/// cursor over a slice is a form novac does not compile yet (registry 1170).
/// A `\` before a raw line break is always a continuation in a literal the
/// lexer accepted: an escaped `\\` followed by a raw break is a raw newline
/// in a literal, refused before emission (D467 section 4).
fn splice_continuations(s str) -> str {
    if !s.contains("\\\n") && !s.contains("\\\r\n") { return s }
    mut t = s.replace("\\\r\n", "\\\n")
    while t.contains("\\\n ") || t.contains("\\\n\t") {
        t = t.replace("\\\n ", "\\\n").replace("\\\n\t", "\\\n")
    }
    t.replace("\\\n", "")
}

/// The `\$` half of the door above. Kept apart so the continuation rule and
/// the dollar rule each read as one sentence.
fn unescape_dollar(s str) -> str =>
    // ONE CALL, not a cursor. The first version walked the bytes through a
    // reusable one-byte buffer, and the owner asked the obvious question
    // (2026-09-04): std already answers this. `@replace` takes every
    // occurrence -- `@replacen` is the one that counts -- which is exactly
    // the contract here: no `\$` may reach clang, not merely the first.
    s.replace("\$", "$")
