// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_symbol_mangling` -- a symbol name is a deterministic
// function of the ENTITY, and a component of a name is built from the
// component, never from another name's text; here, how a TYPE is written
// INSIDE an instance name, and whether its C type is a pointer.
// Role: the two questions every instance spelling asks of a type argument,
//   answered from the type term (274.11, integrator's decision 2026-10-01 on
//   check-novac-mangling-one-way): "is the C type of t a pointer" and "how is
//   t written inside a name" (the star spelled `_p`). Until this file both
//   were answered by string operations on the RESULT of `c_type` -- `.replace("*",
//   "_p")` in the Option/Result family name and the tuple mono name,
//   `.ends_with("*")` in the Option ABI door -- which is reading a C name back,
//   the thing P24 forbids, and which the guard missed only because its pattern
//   stopped at the first `)` of a nested call.
// Used by: mangle_instance.nv (`family_instance_name`), mangle.nv
//   (`mono_tuple_name`), emit_c/emit_option.nv (`@option_payload_is_pointer`).
// Guarded by: check-novac-mangling-one-way.py (no string operation on a
//   mangling result, nested calls included), check-novac-mangle-fixed-point.sh
//   (the spellings against the oracle's emission of the probe), the fixtures
//   option_ctor/ and match_applied_sum/ (both Option shapes, byte-for-byte).
//
// INTEROP, as everywhere in this door: the spellings are the shell's, and go the
// day novac emits the whole prelude.

module novac.sem

import ../builtins.{TypeKind, RESULT_SUM, ASSERT_FN, SUM_MARKER, INT_TYPE_NAME, BOOL_TYPE_NAME, CHAR_TYPE_NAME}
import ../builtins.{bool_c_literal}
import ../atomics.{c_tls_keyword}
import ../types.{TyId}

// THE DOOR "Nova name -> C identifier" (221.1 #1787, plan 274.5 section 74). A
// source name a field, a local, a parameter, a capture or a plain expression
// name carries becomes a C token here, ONCE, where the emitter prints it. The
// rule is the oracle's (compiler-codegen `codegen/emit_c/c_name.rs`, `c_ident`),
// word for word: escape as `nv_` + name when the name is a C keyword, a listed
// header macro, a fixed struct member of the generator, an ALL-CAPS name of two
// or more characters, or starts with `_`, `nv_`, `nova_`, `Nova` or `NOVA` --
// except the compiler's own namespaces `_nv_`, `_nova_`, `_at_`, `__`. The
// escaped form is the ORACLE's (`nv_signed`), so interop stays one spelling.
//
// The word lists live HERE, not in `builtins.nv` (reverted 2026-10-07, round 3
// of #1787's acceptance): `builtins` is the P5 registry of NOVA's own and std's
// names (`check-novac-no-name-hardcode.py`), and every C keyword placed there
// read as a claimed Nova/std name, turning `if`/`void`/`return` in unrelated
// files red. The door that owns these words is this one, not `builtins`.

// C keywords, C89..C23 and the extensions the supported compilers accept.
// The one C23 keyword for thread-local storage is NOT spelled here (274
// §8.1): it lives behind the atomics door and is asked separately below --
// this table may not carry it, by the same P5 reasoning as the paragraph
// above: a name confined to one door is not a second literal elsewhere.
// Four entries below are not literals: `char`/`int`/`bool` collide with
// Nova's own primitive spellings and `enum` with `SUM_MARKER` -- P5 gives
// each ONE home in `builtins.nv`, so the door asks for them rather than
// retyping them (a literal here would read as a second, unrelated claim to
// the same Nova name, which `check-novac-no-name-hardcode.py` polices).
// (`///` was dropped here: Plan 45 Ф.3 ignores a doc-comment before a bare
// module-level `ro` and nova lint flags the ignored comment -- P30.)
ro C_NAME_KEYWORDS = []str.of("auto", "break", "case", CHAR_TYPE_NAME, "const", "continue", "default", "do",
    "double", "else", SUM_MARKER, "extern", "float", "for", "goto", "if",
    "inline", INT_TYPE_NAME, "long", "register", "restrict", "return", "short",
    "signed", "sizeof", "static", "struct", "switch", "typedef", "union",
    "unsigned", "void", "volatile", "while",
    "alignas", "alignof", BOOL_TYPE_NAME, "constexpr", bool_c_literal(false), "nullptr",
    "static_assert", bool_c_literal(true), "typeof", "typeof_unqual",
    "_Alignas", "_Alignof", "_Atomic", "_BitInt", "_Bool", "_Complex",
    "_Generic", "_Imaginary", "_Noreturn", "_Static_assert", "_Thread_local",
    "asm", "fortran")

// Lower-case macros of the headers a generated unit includes (Windows and glibc / POSIX).
// `assert` is not a literal here either: it is Nova's own intrinsic name
// (`ASSERT_FN`, P5), which happens to be a glibc macro too.
ro C_NAME_MACROS = []str.of("near", "far", "interface", "small", "hyper", "pascal", "cdecl", "min",
    "max", "linux", "unix", "i386", "alloca", ASSERT_FN, "errno", "stdin", "stdout", "stderr", "offsetof",
    "setjmp", "sigsetjmp", "h_addr", "h_errno", "fpclassify", "isfinite",
    "isgreater", "isgreaterequal", "isinf", "isless", "islessequal",
    "islessgreater", "isnan", "isnormal", "isunordered", "signbit",
    "math_errhandling", "isalnum", "isalpha", "isascii", "isblank", "iscntrl",
    "isdigit", "isgraph", "islower", "isprint", "ispunct", "isspace",
    "isupper", "isxdigit", "toascii", "st_atime", "st_ctime", "st_mtime",
    "d_fileno", "s6_addr", "s6_addr16", "s6_addr32", "sa_handler",
    "sa_sigaction", "sched_priority", "sigmask", "howmany", "roundup",
    "powerof2", "setbit", "clrbit", "isset", "isclr", "dlopen",
    "be16toh", "be32toh", "be64toh", "le16toh", "le32toh", "le64toh",
    "htobe16", "htobe32", "htobe64", "htole16", "htole32", "htole64",
    "pthread_create", "pthread_join", "pthread_detach", "pthread_exit",
    "pthread_cancel", "pthread_sigmask", "pthread_cleanup_push",
    "pthread_cleanup_pop",
    "s_addr", "s_host", "s_net", "s_imp", "s_impno", "s_lh")

// The fixed members the generator declares next to user-named members.
ro C_NAME_MEMBERS = []str.of("ctx", "schedlink")

// The prefixes the generator and the runtime reserve, and the compiler's own namespaces inside `_`.
ro C_NAME_PREFIXES = []str.of("_", "nv_", "nova_", "Nova", "NOVA")
ro C_NAME_NAMESPACES = []str.of("_nv_", "_nova_", "_at_", "__")

/// Does a Nova source name have to be escaped as `nv_` + name in C? (The rule of the comment above.)
fn c_name_needs_escape(text str) -> bool {
    for w in C_NAME_KEYWORDS { if w == text { return true } }
    for w in C_NAME_MACROS { if w == text { return true } }
    for w in C_NAME_MEMBERS { if w == text { return true } }
    if c_name_is_all_caps(text) { return true }
    if c_name_in_namespace(text) { return false }
    for p in C_NAME_PREFIXES {
        if text.starts_with(p) { return true }
    }
    false
}

/// `_nv_`, `_nova_`, `_at_`, `__`: the compiler's own names inside `_`, which pass unchanged.
fn c_name_in_namespace(text str) -> bool {
    for p in C_NAME_NAMESPACES {
        if text.starts_with(p) { return true }
    }
    false
}

/// `IN`, `OUT`, `INT_MAX`: two or more characters, a capital first, no lower-case letter.
fn c_name_is_all_caps(text str) -> bool {
    ro b = text.bytes()
    if b.len() < 2 { return false }
    if !(b[0] >= 0x41 && b[0] <= 0x5A) { return false }
    for c in b {
        if c >= 0x61 && c <= 0x7A { return false }
    }
    true
}

/// THE door: the C identifier of a Nova source name. An empty name (a
/// temporary's label) passes unchanged, and so does a bool literal, which the
/// emitter passes around the door (`true` is a C keyword by spelling, not a name).
export fn c_ident(name str) -> str {
    if c_name_needs_escape(name) || name == c_tls_keyword() { "nv_${name}" } else { name }
}

/// IS THE C TYPE OF `t` A POINTER -- the answer of the SAME match that writes
/// the star (`c_layout`, mangle.nv), never a reading of the spelling `c_type`
/// returned. A type parameter, an inference variable and an effect have no
/// layout, and `c_layout` ices on them exactly as `c_type` always did.
export fn c_is_pointer(ctx Ctx, t TyId) -> bool => c_layout(ctx, t).by_ptr

/// HOW `t` IS WRITTEN INSIDE AN INSTANCE NAME: its C type when that is no
/// pointer, otherwise its layout's base with `_p` for the star
/// (`Nova_Vec____nova_int*` -> `Nova_Vec____nova_int_p`, `Nova_Rec*` ->
/// `Nova_Rec_p`). A raw pointer's base is its pointee's C type, which may carry
/// stars of its own, so it is written from the pointee's own in-name spelling
/// (`const` kept, as `c_type` writes it).
fn c_in_name(ctx Ctx, t TyId) -> str {
    ro l = c_layout(ctx, t)
    if !l.by_ptr { return l.base }
    if ctx.tys.kind_of(t) != TypeKind.TkPtr { return "${l.base}_p" }
    ro under = c_in_name(ctx, ctx.tys.arg(t, 0))
    if ctx.tys.ptr_is_mut(t) { "${under}_p" } else { "const ${under}_p" }
}

/// Does a generic-sum FAMILY instance travel behind a pointer: the Result
/// family does (`nova_make_NovaRes_*` allocates and returns `r`), the Option
/// family does not (its methods hand it back by value). Asked only for a term
/// `family_instance_name` spells -- one rule, read by the C type and by the
/// pointer question above.
fn family_by_pointer(ctx Ctx, t TyId) -> bool => decl_of_ty(ctx, t).name == RESULT_SUM
