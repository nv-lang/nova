// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_symbol_mangling` -- a symbol name is a deterministic
// function of the entity; here, of a generic INSTANCE and its arguments.
// Role: the INSTANCE half of the mangling door (moved out of mangle.nv on
//   2026-10-01, 274.11 E.10 step 3, when the file reached its 1000-line cap and
//   a new type kind had to add an arm to every match): the shell's spellings of
//   a generic record or sum instance (`Vec____nova_int`, `NovaOpt_nova_str`)
//   and the method symbol question; the DOORS of the root (c_instance_ctor,
//   c_instance_method, c_shell_method) stay in mangle.nv, their home in the
//   architecture table section 3a. INTEROP, read off the shell -- the same end
//   condition as mangle.nv: gone the day novac emits the whole prelude.
// Used by: mangle.nv (c_type, c_struct), check (the shell-carries questions),
//   emit_c (the names it prints).
// Guarded by: check-novac-mangle-fixed-point.sh (spellings against the oracle's
//   emission of the probe), check-novac-mangling-one-way.py, sem/mangle_test.nv.

module novac.sem

import ../diag.{ice}
import ../builtins.{prim_c_name, OPTION_FAMILY_C, OPTION_SUM, RESULT_FAMILY_C, RESULT_SUM}
import ../builtins.{FMT_PROTO, FMT_IMPL}
import ../builtins.{TypeKind, SLICE_HEAD}
import ../types.{TyId, no_ty, is_ty}

/// The FAMILY spelling of a generic-sum instance's STRUCT, or "" for everything
/// else -- INTEROP, read off the shell, gone the day novac emits the whole
/// prelude:
///   * `Option[int]` is `NovaOpt_nova_int`, with no `Nova_` prefix;
///   * `Result[[]u8, IoError]` is `NovaRes_Nova_Vec____nova_byte_p_NovaValue_IoError`
///     (2026-10-01, the carrier: a `match` on what a std call hands back).
/// Each argument is written as a type INSIDE a name (`c_in_name`,
/// mangle_spelling.nv: a pointer's struct with `_p`) -- the one rule both
/// families share (`NovaOpt_Nova_Rec_p`, `..._Nova_Utf16Error_p`), built from
/// the argument's term rather than by editing the C type it spells to.
/// Every other generic sum still reaches the instance_body ice below by name.
/// WHETHER the instance travels by value or behind a pointer is the other
/// question (`family_by_pointer`, read by `c_layout`): the struct name is the same.
fn family_instance_name(ctx Ctx, t TyId) -> str {
    ro head = decl_of_ty(ctx, t)
    ro is_sum = match head.kind {
        TkSum => true
        // TkEffect: an effect is not a sum -- no family spelling.
        TkPrim | TkRecord | TkApp | TkParam | TkInfer | TkNewtype | TkTuple | TkEffect | TkPtr => false
    }
    if !is_sum { return "" }
    ro n = ctx.tys.arg_count(t)
    if head.name == RESULT_SUM && n == 2 {
        return "${RESULT_FAMILY_C}${c_in_name(ctx, ctx.tys.arg(t, 0))}_${c_in_name(ctx, ctx.tys.arg(t, 1))}"
    }
    if head.name != OPTION_SUM { return "" }
    if n != 1 { return "" }
    "${OPTION_FAMILY_C}${c_in_name(ctx, ctx.tys.arg(t, 0))}"
}

/// The oracle's spelling of a generic-record instance struct
/// (`Nova_Vec____nova_int`): interop, lifted off the shell 2026-08-26.
fn instance_struct_name(ctx Ctx, t TyId) -> str => "Nova_${instance_body(ctx, t)}"

/// THE IMPLEMENTOR a protocol-typed value is compiled as -- or the type itself
/// when it is no protocol with a bound implementor. One door for the one pair
/// novac knows (FMT_PROTO -> FMT_IMPL, interop, see builtins): the checker's
/// method key, the C type of a parameter and the method symbol all ask here,
/// so the pair is written once and read three times.
export fn impl_of_proto(ctx Ctx, t TyId) -> TyId {
    if !is_ty(t) { return t }
    if ctx.tys.kind_of(t) != TypeKind.TkRecord { return t }
    if decl_of_ty(ctx, t).name != FMT_PROTO { return t }
    match ctx.defs.type_decl(FMT_IMPL) {
        None => t
        Some(d) => ty_of_decl(ctx, d)
    }
}

/// WHICH spelling a method of a handed type takes: a generic INSTANCE is
/// `<body>_method_<name>` (no `Nova_` prefix), a PLAIN type is
/// `Nova_<name>_method_<name>` -- the oracle spells the two differently, and
/// until 2026-09-05 the checker's interop check and the emitter each chose the
/// instance form for everything, so a plain std record's method could never
/// pass (`Nova_FmtCtx_method_write` was asked for as `FmtCtx_____method_write`).
/// One question, one door; a protocol receiver goes through its implementor.
export fn c_method_symbol(ctx Ctx, t TyId, name str) -> str {
    ro it = impl_of_proto(ctx, t)
    // `it` is `no_ty()` whenever the caller's OWN receiver type did not
    // resolve (registry: an index into a self-hosted `[]Node` losing its
    // element type upstream) -- `impl_of_proto` passes that absence straight
    // through (`return t` on its `!is_ty(t)` branch), and asking the
    // interner for the KIND of an absent type is the ICE this door used to
    // reach. Not a type application either way, so the shell-method spelling
    // is the honest fallback, same as any other non-instance receiver.
    if is_ty(it) && ctx.tys.kind_of(it) == TypeKind.TkApp { return c_instance_method(ctx, it, name) }
    c_shell_method(ctx, it, name)
}

/// The C identifier of a CONCRETE array receiver -- `[]u8` is `NovaArray_nova_byte`
/// -- or "" for every other type (a generic `[]T`, a nested or a record element).
/// INTEROP, read off the oracle (`receiver_type_c_ident`, emit_c.rs) and the
/// shell (`Nova_NovaArray_nova_byte_method_to_str`): a method a std file declares
/// on `[]E` for one primitive `E` is spelled from the element's runtime name.
/// A spelling the shell does not carry is still asked of `interop.has` by the
/// caller, so an element whose name differs is refused, never guessed.
fn array_ext_c_ident(ctx Ctx, t TyId) -> str {
    if !is_ty(t) || ctx.tys.kind_of(t) != TypeKind.TkApp { return "" }
    if decl_of_ty(ctx, t).name != SLICE_HEAD || ctx.tys.arg_count(t) != 1 { return "" }
    match prim_row_of(ctx.tys, ctx.tys.arg(t, 0)) {
        Some(bt) => "NovaArray_${bt.c_name}"
        None => ""
    }
}

/// THE OVERLOAD's shell symbol: the method `row` picks, on receiver `recv_t`,
/// under the type arguments `args` (registry 1524). `c_method_symbol` answers
/// for a NAME, and a name is not a function when it is overloaded: `cap()` and
/// `cap(n)` of `Vec[int]` are `Vec____nova_int_method_cap` and
/// `Vec____nova_int_method_cap__nova_int`, and the name alone sent `v.cap(100)`
/// to the first with two arguments. The oracle spells the FIRST overload of a
/// name on its type bare and every later one with `__` and its parameters' C
/// types (pointer `*` as `_p`, joined by `_`; none -> `__mut`/`__ro` by the
/// receiver) -- read off the oracle's generic-method overload mangling in
/// `emit_c.rs` and off the shell. The same scheme holds for a PLAIN receiver --
/// a record, a primitive, a newtype (`Nova_StringBuilder_method_append` /
/// `..._append__nova_int`, `Nova_str_method_contains__nova_char`,
/// `Nova_Vec_method_ptr__mut`, read off the shell; registry 1558). A sum's,
/// or a generic sum's FAMILY (`Nova_Option_method_display_nova_str`), was
/// never measured with a second overload: there the second overload gets a
/// spelling no C identifier holds, so it is never "carried" -- only the first
/// overload is ever asked by the bare name.
///
/// A spelling the shell does not carry is not a guess that links: the caller
/// asks `interop.has` of THIS answer, and a miss sends the overload to the body
/// novac was handed (`Ctx @instantiates`) or to a refusal by name.
export fn c_overload_symbol(ctx Ctx, row FnRow, recv_t TyId, args []TyId) -> str {
    // The ROW's spelling first: a `consume` receiver of a plain type is the
    // shell's `_consume_` (registry 1564, `shell_method_symbol`) -- one truth
    // for the question `Ctx @instantiates` asks and the name the emitter prints.
    ro base = shell_method_symbol(ctx, row, recv_t)
    ro it = impl_of_proto(ctx, recv_t)
    // SILENT-OK: a receiver whose type did not resolve was refused upstream.
    if !is_ty(it) { return base }
    ro k = ctx.tys.kind_of(it)
    ro measured = k == TypeKind.TkPrim || k == TypeKind.TkRecord || k == TypeKind.TkNewtype ||
        (k == TypeKind.TkApp && decl_of_ty(ctx, it).kind == TypeKind.TkRecord)
    "${base}${overload_tail(ctx, row, args, measured)}"
}

/// WHAT FOLLOWS the bare symbol of overload `row` -- "" for the first overload
/// of its name on its type, the one spelling both a method and a STATIC method
/// take (registry 1558; `Nova_str_static_new` /
/// `Nova_str_static_new__const_nova_byte_p_nova_int`, read off the shell):
/// - an EXTERN declaration (`extern "nova"`, no body) is spelled by the
///   oracle's other rule (`external_registry.rs` `mangle_method_c_name`): with
///   two or more overloads every one takes `_` and its last parameter's type
///   name, none -> nothing (`Nova_AtomicInt_method_load` is `load()`);
/// - a later overload otherwise takes `__` and its parameters' C types
///   (pointer star `_p`, joined by `_`; none -> `mut`/`ro` by the receiver);
/// - a receiver kind whose overloads were never measured (`measured` false: a
///   sum, a generic sum's family) gets a spelling no C identifier holds, so it
///   is never found carried.
fn overload_tail(ctx Ctx, row FnRow, args []TyId, measured bool) -> str {
    if ctx.is_extern_handed(row) {
        if ctx.overload_count(row) < 2 { return "" }
        ro last = extern_last_param_name(ctx, row, args)
        return if last == "" { "" } else { "_${last}" }
    } else {
        // A declaration with a body: the generic-method overload rule below.
    }
    if ctx.overload_ordinal(row) <= 0 { return "" }
    if !measured { return "__${UNMEASURED_SPELLING}" }
    ro fd = ctx.fns.rows[raw_row(row)]
    ro first = if fd.has_recv { 1 } else { 0 }
    consume s = StringBuilder.new(cap: 64)
    s.append("__")
    for p in first..fd.param_cnt {
        if p > first {
            s.append("_")
        } else {
            // The first parameter follows the separator directly.
        }
        match overload_param_spelling(ctx, subst_type(ctx, ctx.fns.params[fd.param_off + p].type_id, args)) {
            Some(sp) => s.append(sp)
            // A kind whose in-name spelling the shell was never measured for:
            // a character no C identifier holds, so the shell is never found
            // to carry it -- the overload is made from its body or refused by
            // name, never guessed into a call.
            None => s.append(UNMEASURED_SPELLING)
        }
    }
    if fd.param_cnt <= first {
        ro recv_mut = fd.has_recv && ctx.fns.params[fd.param_off].mode != ParamMode.ModeRo
        s.append(if recv_mut { "mut" } else { "ro" })
    } else {
        // The parameters are the suffix.
    }
    s
}

/// WHAT follows the bare symbol of a handed FREE function: "" for the first
/// overload of its name in its module, `__` and its parameters' C types for a
/// later one -- the generic-method rule above, which the oracle applies to
/// free functions too (`nova_fn_3std2os3env__nova_str_nova_str`, read off the
/// shell). An `extern` free function keeps its bare name: its overload rule
/// is the extern registry's and was never measured on a free function.
fn free_overload_tail(ctx Ctx, row FnRow) -> str {
    // SILENT-OK: the extern registry's spelling, never measured for a free function.
    if ctx.is_extern_handed(row) { return "" }
    // SILENT-OK: the first overload of its module takes the bare name.
    if ctx.free_overload_ordinal(row) <= 0 { return "" }
    ro fd = ctx.fns.rows[raw_row(row)]
    consume s = StringBuilder.new(cap: 64)
    s.append("__")
    for p in 0..fd.param_cnt {
        if p > 0 {
            s.append("_")
        } else {
            // The first parameter follows the separator directly.
        }
        match overload_param_spelling(ctx, ctx.fns.params[fd.param_off + p].type_id) {
            Some(sp) => s.append(sp)
            // Never measured: a spelling no C identifier holds (see overload_tail).
            None => s.append(UNMEASURED_SPELLING)
        }
    }
    if fd.param_cnt == 0 {
        s.append(UNMEASURED_SPELLING)
    } else {
        // The parameters above are the whole suffix.
    }
    s
}

/// The oracle's `last_param_suffix` for an extern method: the Nova NAME of
/// the last parameter's type -- a named type by its name, a slice of one by
/// the name plus `s` (`[]u8` -> `u8s`); "" with no parameter. A shape the rule
/// spells otherwise (`arr`) answers the unmeasured spelling, never a guess.
fn extern_last_param_name(ctx Ctx, row FnRow, args []TyId) -> str {
    ro fd = ctx.fns.rows[raw_row(row)]
    ro first = if fd.has_recv { 1 } else { 0 }
    if fd.param_cnt <= first { return "" }
    ro t = subst_type(ctx, ctx.fns.params[fd.param_off + fd.param_cnt - 1].type_id, args)
    if !is_ty(t) { return UNMEASURED_SPELLING }
    ro k = ctx.tys.kind_of(t)
    if k == TypeKind.TkApp {
        if decl_of_ty(ctx, t).name != SLICE_HEAD || ctx.tys.arg_count(t) != 1 { return UNMEASURED_SPELLING }
        return "${ty_source_name(ctx, ctx.tys.arg(t, 0))}s"
    } else if k == TypeKind.TkPrim || k == TypeKind.TkRecord || k == TypeKind.TkSum || k == TypeKind.TkNewtype {
        return ty_source_name(ctx, t)
    } else {
        // SILENT-OK: a shape whose extern spelling was never measured.
        return UNMEASURED_SPELLING
    }
}

/// What an overload's suffix holds for a parameter kind the shell's spelling
/// was not measured for -- see `c_overload_symbol`.
const UNMEASURED_SPELLING = "?"

/// The in-name spelling of an overload's PARAMETER type, the oracle's C type
/// with its pointer star as `_p` -- which is exactly an instance argument's
/// spelling (`nova_int`, `NovaValue_Range`, `Nova_P_p`,
/// `Nova_Vec____nova_byte_p`, a newtype as its representation), and an
/// `Option` by its family (`NovaOpt_nova_int`). `None` for a kind not measured
/// on the shell; built from the doors, never by editing a spelling (P24).
///
/// THE MEASURED KINDS ARE LISTED, the rest answer `None` -- a chain and not a
/// `match` on purpose: every other kind (a sum, a pointer, an effect, a
/// structural pair, a parameter left unsubstituted) has the SAME answer, the
/// safe one, and a kind added tomorrow joins it without a guess about its C.
fn overload_param_spelling(ctx Ctx, t TyId) -> Option[str] {
    ro k = ctx.tys.kind_of(t)
    if k == TypeKind.TkPrim || k == TypeKind.TkRecord || k == TypeKind.TkNewtype {
        return Some(instance_arg_spelling(ctx, t))
    } else if k == TypeKind.TkPtr {
        // `*mut T` is the oracle's `T*`, `*const T` its `const T*` -- read off
        // the shell (`..._static_new__const_nova_byte_p_nova_int`).
        ro el = overload_param_spelling(ctx, ctx.tys.arg(t, 0))?
        return Some(if ctx.tys.ptr_is_mut(t) { "${el}_p" } else { "const_${el}_p" })
    } else if k == TypeKind.TkApp {
        if decl_of_ty(ctx, t).kind != TypeKind.TkSum { return Some(instance_arg_spelling(ctx, t)) }
        ro fam = family_instance_name(ctx, t)
        return if fam == "" { None } else { Some(fam) }
    } else {
        // SILENT-OK: not measured on the shell -- the overload is not asked of it.
        return None
    }
}

/// The body every instance name is built from: `<Head>____<arg>__<arg>`.
fn instance_body(ctx Ctx, t TyId) -> str {
    ro head = decl_of_ty(ctx, t)
    match head.kind {
        TkRecord => {}
        // A SUM never reaches HERE any more: `c_instance_method` answers it with
        // the family spelling above, without building a record-shaped body. The
        // ice stays because this door is about the RECORD body specifically, and
        // a caller that asks it for a sum is asking the wrong door.
        TkSum => ice("mangle: the record-shaped instance body of a generic SUM -- ask `c_instance_method`, which spells a sum by its family")
        // A head is a declaration; these are not declarations a `[T]` can hang on.
        // TkEffect joins them: an effect head owns operations, not an instance body.
        TkPrim | TkApp | TkParam | TkInfer | TkNewtype | TkTuple | TkEffect | TkPtr =>
            ice("mangle: an application whose head is not a record or sum declaration")
    }
    applied_body_text(ctx, t)
}

/// The text of `<Head>____<arg>__<arg>` for an applied declaration -- a
/// record's instance body, and a generic sum's in a STATIC symbol
/// (`c_static_symbol`), the one place the oracle spells a sum that way.
fn applied_body_text(ctx Ctx, t TyId) -> str {
    ro head = decl_of_ty(ctx, t)
    consume s = StringBuilder.new(cap: 64)
    s.append(head.name)
    s.append("____")
    for i in 0..ctx.tys.arg_count(t) {
        if i > 0 {
            s.append("__")
        } else {
            // The first argument follows the head's separator directly.
        }
        s.append(instance_arg_spelling(ctx, ctx.tys.arg(t, i)))
    }
    s
}

/// How the oracle spells a type ARGUMENT inside an instance name: a primitive by
/// its C name (`nova_int`), a value record as its struct (`NovaValue_P`), a
/// heap record as its struct plus the pointer suffix (`Nova_P_p`), a SUM the
/// same way as a heap record (`Nova_Sig_p` -- a sum is a GC pointer too; read
/// off the oracle's C for `Vec[Sig]` on 2026-09-04: `Nova_Vec____Nova_Sig_p`,
/// `Vec____Nova_Sig_p_method_len`), a nested instance recursively with the same
/// suffix. The other kinds are not measured on the shell and are named rather
/// than guessed.
///
/// The sum arm was an ice until 2026-09-04, and its doc said the shape was
/// unreachable. novac's OWN sources reach it (`[]TokenKind` and kin), so the
/// batch self-check iced -- and that one ice sent the self-distance runner into
/// per-file mode, where a file cannot see its co-equal siblings and 72 of 73
/// files read as rejected against 27 in the batch. A doc that calls a shape
/// unreachable when nobody measured it is the same lie as a stale live line,
/// only quieter. (No quotes around the word: the P24 scanner reads a quoted
/// identifier-like string in an emitting module as a printed C name.)
fn instance_arg_spelling(ctx Ctx, a TyId) -> str {
    match ctx.tys.kind_of(a) {
        TkPrim => prim_c_name(ctx.tys.prim_ordinal_of(a))
        TkRecord => {
            ro nm = type_base(ctx, a)
            if is_value_record(ctx, a) { "NovaValue_${nm}" } else { "Nova_${nm}_p" }
        }
        TkApp => "${instance_struct_name(ctx, a)}_p"
        TkSum => "Nova_${type_base(ctx, a)}_p"
        // A NEWTYPE inside an instance name is its REPRESENTATION (274.7 B7,
        // #940): `[Meters(1.0), Meters(2.0)]` with `type Meters f64` is
        // `Nova_Vec____nova_f64` in the oracle's C (measured 2026-09-05, the
        // kept artifact of the probe), and the SHELL's instances are keyed the
        // same way -- so this is the spelling that LINKS. The same canon `c_type`
        // takes for the type itself ("a newtype is a distinct type with the
        // representation's layout"): one canon, one name (K3), where this arm
        // used to be the second answer, an ice after a green check.
        TkNewtype => instance_arg_spelling(ctx, representation_of(ctx, a))
        TkTuple => ice("mangle: a TUPLE as an instance argument — its in-name spelling is not measured on the shell")
        TkPtr => ice("mangle: a POINTER as an instance argument — its in-name spelling is not measured on the shell")
        // TkEffect: unreachable while the with-doors refuse non-handler values;
        // ice, not a fallback (E4 wave). An effect has no in-name spelling.
        TkEffect => ice("mangle: an EFFECT as an instance argument — an effect value reaches a generic instance only through a with-door bug (E4 wave)")
        TkParam => ice("mangle: a type parameter as an instance argument — layout asked before substitution")
        TkInfer => ice("mangle: an inference variable as an instance argument — a variable escaped its body")
    }
}

/// A STATIC method's instance as the shell emits it (274.11 E.10 step 4c-2):
/// `Nova_<owner>_static_<name>`, the owner spelled as its instance body when
/// it is an application (`Nova_Vec____nova_int_static_new`) and by its name
/// otherwise (`Nova_RawMem_static_alloc`), then the method's OWN type
/// arguments as an instance suffix (`..._copy_n_nonoverlapping____nova_int`,
/// read off the shell). `args` holds the owner's arguments first, the
/// method's after -- the slot order of the row's type parameters.
export fn c_static_symbol(ctx Ctx, row FnRow, args []TyId) -> str {
    ro fd = ctx.fns.rows[raw_row(row)]
    ro owner_n = ctx.tys.arg_count(fd.owner)
    consume s = StringBuilder.new(cap: 64)
    s.append("Nova_")
    if owner_n > 0 && decl_of_ty(ctx, fd.owner).kind == TypeKind.TkSum {
        // A generic SUM's static is spelled per instance like a record's
        // (measured: `LinkedList[int].from_array([1, 2, 3])` calls
        // `Nova_LinkedList____nova_int_static_from_array`), not by the
        // family spelling `c_instance_method` gives Option/Result methods.
        // The oracle's bare `Nova_LinkedList_static_from_array` is the
        // erased fallback it takes WITHOUT the turbofish -- and that program
        // segfaults at run time; it is not copied.
        s.append(applied_body_text(ctx, subst_type(ctx, fd.owner, args)))
    } else if owner_n > 0 {
        s.append(instance_body(ctx, subst_type(ctx, fd.owner, args)))
    } else if ctx.tys.names_a_decl(fd.owner) {
        s.append(decl_of_ty(ctx, fd.owner).name)
    } else {
        // A PRIMITIVE owner (`fn str.new()`, registry 1631) names no
        // declaration: the shell spells it by its source name, `Nova_str_static_new`.
        s.append(ty_source_name(ctx, fd.owner))
    }
    s.append("_static_")
    s.append(fd.name)
    // THE OVERLOAD, not the name (registry 1558): `str.new(p, n)` is
    // `Nova_str_static_new__const_nova_byte_p_nova_int`. The owner of a static
    // method is a record or a primitive -- the measured kinds.
    s.append(overload_tail(ctx, row, args, true))
    for i in owner_n..args.len() {
        s.append(if i == owner_n { "____" } else { "__" })
        s.append(instance_arg_spelling(ctx, args[i]))
    }
    s
}

/// The C struct NAME of a generic record instance (`Nova_Vec____Nova_Pt_p`) --
/// the shell's spelling, for the door that writes the struct when the shell
/// does not (274.11 E.10 step 4d).
export fn instance_struct_c(ctx Ctx, t TyId) -> str => instance_struct_name(ctx, t)
