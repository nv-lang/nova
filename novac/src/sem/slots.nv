// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `hir::Node` accessors and Go `ast.Inspect` helpers for "ask the
// node WHICH child holds what" instead of indexing; NOT taken: a visitor
// framework — these are plain questions over a children slice, and a framework
// would hide the very indices this file exists to remove.
// Role: layer 3 — the ONE place that knows where a name, a type or a body
//   stands among a node's children -- narrowed since the 2026-09-21 split
//   (see below) to a NAME's, a PARAMETER's, a CALL's or a PATTERN's own
//   geometry; the sibling file `slots_decl.nv` answers the same kind of
//   question about what a DECLARATION itself is.
// Used by: check, emit_c, mono and sem itself, at every stage from E1 on.
// Guarded by: check-novac-no-alloc-in-lookup.py (these doors allocate nothing),
// check-novac-type-field-docs.py (every function documented), the module tests
// of parse and check that break the moment a shape changes.
//
// WHY A FILE OF ITS OWN. `sem.nv` crossed 1000 lines (decision 12), and the
// answer to that is a cut along a seam, not an exception. The seam is real: the
// registries and the collector know WHAT is declared, while these doors know
// WHERE in the tree it is written. Every one of them was born from the same
// case: a fixed index (`kids[1]`, `pk[0]`) read a mode as the name, or a comma
// as the type, the moment the shape grew one child.
//
// SPLIT AGAIN, INTO `slots_decl.nv`, ON 2026-09-21 (decision 12 / P13): this
// file itself reached 998/1000 lines after two more door-scanners (#1239's
// `array_of_lparen_at`, #1254's investigation) landed in it -- the ACTUAL mine
// `backlog-followups.md`'s `[M-novac-checker-files-at-the-size-cap]` entry
// names, once the earlier `rules.nv`/`exprs.nv` mines had already been cut.
// The declaration-shape doors (`type`/`const`/field: what a declaration IS)
// moved out whole; every import below was re-derived from what the REMAINING
// functions actually use -- the file had carried five dead names
// (`NodeId`/`raw_node`/`is_node` from `tree`, `no_ty`/`is_ty`/`same_ty`/
// `Interner` from `types`, and the whole `builtins`/`names` import lines,
// which nothing here ever called) that the split is also where they stopped
// being carried forward.

module novac.sem

import ../tree.{Node, NodeKind}
import ../lex.{TokenKind}
import ../diag.{ice}
import ../types.{TyId}

/// The BODY of a match arm, or None when the arm carries nothing but
/// punctuation. Its last child is not always the body.
///
/// A one-line `match n { 1 => 10, _ => 2 }` writes a COMMA after each arm body
/// (D452), and the comma is kept in the tree because the tree is lossless. The
/// readers that took `ak[ak.len() - 1]` then asked the checker for the type of
/// a comma and got the honest ice "expression kind without a type rule".
///
/// Third instance of the fixed-index class in one day (the method-declaration
/// ice, check's kids[1], typing's pk[0]/pk[1]). The shape of a tree grows; an
/// index does not grow with it, and a door does.
export fn arm_body_at(ak []Node) -> Option[int] {
    mut i = ak.len() - 1
    while i >= 0 {
        ro c = ak[i]
        ro is_punct = c.kind_of() == NodeKind.LeafNode &&
            (leaf_kind(c) == TokenKind.Comma || leaf_kind(c) == TokenKind.FatArrow)
        if !is_punct { return Some(i) }
        i -= 1
    }
    None
}

/// The slot of the `(` in a TYPED array literal's own constructor call
/// (`[]Point.of(a, b)`, sub-plan L) -- everything after it is an ARGUMENT
/// of `.of(...)`, the same position a `Call`'s own children get (registry
/// #1239's remaining half). `None` for the plain `[a, b]` shape and for a
/// bare `[]Point` with no argument list -- neither has a `(` at all.
export fn array_of_lparen_at(kids []Node) -> Option[int] {
    mut i = 0
    for c in kids {
        if c.kind_of() == NodeKind.LeafNode && leaf_kind(c) == TokenKind.LParen {
            return Some(i)
        }
        i += 1
    }
    None
}

/// Where the NAME of a parameter sits among its children, and where its TYPE
/// begins.
///
/// A parameter is `[name, type...]` -- and since 2026-08-17 it may carry a
/// leading MODE leaf (`fn take(consume v int)`), which shifts both. Every
/// consumer used to index `pk[0]` and `pk[1]` directly, and the moment the
/// shape grew those indexes started reading the mode as the name and the name
/// as the type. That is the same defect the checker hit this morning with
/// `kids[1]` on a method declaration: a fixed index into a tree whose shape
/// just grew is a bug waiting for the next form.
export fn param_name_at(pk []Node) -> Option[int] {
    mut i = 0
    for c in pk {
        // A MODE WORD CANNOT LAND HERE ANY MORE: `mut`, `ro` and `consume` all
        // lex as keywords, so the first IDENTIFIER of a parameter is its name by
        // construction -- the spelling filter this line used to carry is gone
        // along with the question it answered.
        ro is_ident = c.kind_of() == NodeKind.LeafNode &&
            leaf_kind(c) == TokenKind.Ident
        if is_ident { return Some(i) }
        i += 1
    }
    None
}

/// The ELEMENT nodes of an array literal, in order -- for `[7, 8]` the
/// expressions between the brackets, for `[]int.of(7, 8)` the arguments of
/// the constructor. Spread and named-argument nodes are returned AS THEY ARE, so
/// check can refuse them by kind rather than this door hiding them.
///
/// One geometry for two spellings: the checker types the elements and the
/// emitter pushes them, and a second walk in either would be the second door.
export fn literal_elems(kids []Node) -> []Node {
    mut out = []Node.new()
    mut after_paren = false
    ro typed = literal_head_name(kids).is_some()
    for c in kids {
        if c.kind_of() == NodeKind.LeafNode && leaf_kind(c) == TokenKind.LParen {
            after_paren = true
            continue
        }
        if typed && !after_paren { continue }
        // Brackets, commas, the dot and the constructor's name are syntax and
        // are skipped; the `continue` is the other branch (P31 form 2).
        ro is_elem = is_expr_kind(c.kind_of()) || c.kind_of() == NodeKind.ArraySpread ||
            c.kind_of() == NodeKind.NamedArg
        if !is_elem { continue }
        out.push(c)
    }
    out
}

/// The ELEMENT TYPE NAME of a typed literal (`[]int.of(...)` -> `int`), or
/// `None` for the bracket form, whose element type comes from its elements.
export fn literal_head_name(kids []Node) -> Option[str] {
    if kids.len() < 2 { return None }
    if kids[0].kind_of() != NodeKind.LeafNode || leaf_kind(kids[0]) != TokenKind.EmptyBrackets { return None }
    if kids[1].kind_of() != NodeKind.LeafNode || leaf_kind(kids[1]) != TokenKind.Ident { return None }
    Some(leaf_text(kids[1]))
}

/// The CONSTRUCTOR name a typed literal was written with (`of`), or `None`.
export fn literal_ctor_name(kids []Node) -> Option[str] {
    if kids.len() < 4 { return None }
    if kids[3].kind_of() != NodeKind.LeafNode || leaf_kind(kids[3]) != TokenKind.Ident { return None }
    Some(leaf_text(kids[3]))
}


/// How many ARGUMENTS a call writes, counting from child `from`.
///
/// The same walk the key builders do, without building the key -- asked where
/// only the count is needed (a variant's payload has no names to bind by).
export fn arg_count(kids []Node, from int) -> int {
    mut n = 0
    mut i = 0
    for c in kids {
        if i >= from && is_arg_node(c) {
            n += 1
        } else {
            // Syntax, or a child standing before the first argument.
        }
        i += 1
    }
    n
}

/// The i-th ARGUMENT of a call, unwrapped -- the geometry the key was built
/// with, so a slot recorded by the checker names the same node here.
///
/// `from` is where the arguments start: 1 for a free call (child 0 is the
/// callee's name), 3 for a method call (receiver, dot, name). A method call's
/// argument ZERO is the receiver and is NOT in this range -- plan 273 puts it at
/// parameter zero, and the caller hands `kids[0]` for it directly.
export fn call_arg_at(kids []Node, from int, i int) -> ro Node {
    mut seen = 0
    mut at = 0
    for c in kids {
        if at >= from && is_arg_node(c) {
            // The one asked for; anything earlier is counted and passed.
            if seen == i { return arg_expr_of(c) }
            seen += 1
        } else {
            // Syntax, or a child before the first argument.
        }
        at += 1
    }
    ice("sem: a call was asked for an argument it does not write")
}

/// The EXPRESSION an argument carries: itself when positional, and the value
/// after the colon when it was passed by name.
/// `ro` in the return by D246: the node comes from the caller's own tree and is
/// not a copy, so the type says so rather than laundering a frozen source
/// through a `mut` binding at the call site.
export fn arg_expr_of(c Node) -> ro Node {
    // A positional argument IS its expression; the named form wraps one, and
    // the parser pushes `name`, `:`, expr in that order.
    if c.kind_of() != NodeKind.NamedArg { return c }
    ro kids = branch_children(c)
    if kids.len() >= 3 { kids[2] } else { c }
}

/// The parameter NAME an argument was passed under, or `""` when positional.
export fn arg_name_of(c Node) -> str {
    // Positional means no name at all; the named form carries it as its first
    // child, a leaf.
    if c.kind_of() != NodeKind.NamedArg { return "" }
    ro kids = branch_children(c)
    if kids.len() >= 1 { leaf_text(kids[0]) } else { "" }
}

/// The parameter's NAME as written, or `""` when the shape carries none.
///
/// A door and not `leaf_text(pk[param_name_at(pk)])` at three call sites: the
/// index and the text are one question with one answer, and the `??` fallback
/// spelled out per caller is where the recovery case gets forgotten in one of
/// them.
fn param_name_of(pk []Node) -> str {
    if Some(n) = param_name_at(pk) { leaf_text(pk[n]) } else { "" }
}

/// The DEFAULT expression written for this parameter (`by int = 2`), in the
/// shape the row stores it: EMPTY when the declaration writes none.
///
/// The parser leaves `=` as a leaf and the expression right after it, so the
/// door reads the pair rather than a fixed index -- a parameter's children are
/// mode, name, one or more type nodes, then this.
///
/// The vector shape is the oracle's constraint, not a choice: see `ParamDef`.
export fn param_default_slot(pk []Node) -> []Node {
    mut seen_assign = false
    for c in pk {
        // The child right after the `=` IS the default; everything before it is
        // the mode, the name and the type.
        if seen_assign { return []Node.of(c) }
        if c.kind_of() != NodeKind.LeafNode { continue }
        if leaf_kind(c) != TokenKind.Assign { continue }
        seen_assign = true
    }
    []Node.new()
}

/// The NAME slot of a fn DECLARATION: the first identifier leaf after the
/// `fn` keyword.
///
/// Not child one. A `Generics` branch stands between for `fn twice[T]`, and a
/// receiver group does for a method -- and `leaf_text` on a branch is an ice,
/// which is how this rule was learned. The rule itself was then written out a
/// second time in the typing walk and was about to be written a third in the
/// emitter, which is what P18 calls a door: one question, one place.
export fn decl_name_at(kids []Node) -> Option[int] {
    mut i = 0
    for c in kids {
        // Index zero is the `fn` keyword -- a keyword is no identifier, so the
        // test excludes it by construction rather than by counting.
        if i > 0 && c.is_ident() { return Some(i) }
        i += 1
    }
    None
}

/// The parameter MODES, and the set is measured rather than assumed
/// (2026-08-17, after the owner asked why only `consume` was skipped):
///
///     mut v int       legal -- and the one std actually uses, 131 times
///     consume v int   legal -- 4 times in std
///     ro v int        parses, then E_REDUNDANT_PARAM_RO (`ro` is default)
///     own v int       "expected `,`, got identifier" -- NOT a mode
///     zzz v int       the same, so the set is closed, not open
///
/// The `own`/`borrow`/`inout` rows came back "accepted" in an earlier probe of
/// mine, and they were wrong the same way twice in one shift: the grep behind
/// the measurement matched only BRACKETED error codes, and this diagnostic
/// carries none. A measurement is only as good as what it agrees to see.
///
/// THE TABLE ABOVE CARRIED A FOURTH ROW, `uninit v int`, and it was wrong the
/// same way -- re-measured 2026-08-21 on the owner's question ("what does
/// `uninit` combine with?"): the oracle answers "expected identifier, got
/// `uninit`" to `fn f(uninit v int)` and ACCEPTS `fn f(v uninit int)`. So
/// `uninit` is no mode at all: it qualifies the TYPE (`uninit T`, MaybeUninit)
/// and a pointer's pointee, and THERE it combines with a mode -- `*mut uninit T`
/// (amendment 2026-08-05, No 358). The axis is three: ro, mut, consume. Had the
/// wrong row stayed, novac would ACCEPT a parameter form the language refuses --
/// the over-acceptance direction, the dangerous one.
///
/// The CONTEXTUAL half of the set moved to `builtins` on 2026-08-21, where
/// every string name of the language lives (P5): the parser needs the same
/// words to read a qualified receiver, and a second copy of a closed set is how
/// IS THIS IDENTIFIER A MODE WORD? Since 2026-08-23 the answer is always NO,
/// and the door is gone with the question: all three mode words lex as keywords
/// (`KwMut`, `KwRo`, `KwConsume`), so an IDENTIFIER can no longer be one. The
/// caller that asked -- `param_name_at`, looking for the parameter's name --
/// needs no filter at all now, because a keyword is not an identifier.
///
/// `is_mode_word(w str)` stood here until 2026-08-23 and is gone with the last
/// reader that had only TEXT to go on. All three mode words are keywords now, so
/// the question is about a token KIND, and `mode_of_leaf` answers it -- one door
/// instead of a door plus three spellings kept in step with the lexer by hand.

/// The MODE this parameter declares -- `ModeRo` when it writes none, which is
/// the language's default (D32/D246: a bare parameter IS the read-only view).
///
/// Read from the leaves before the NAME, because that is where a mode stands.
/// The set is closed (see `is_param_mode` above), so an unrecognised word is
/// not a mode and this door says `ModeRo` about it -- the shape itself is
/// refused elsewhere, and guessing a mode here would be worse than either.
export fn param_mode_at(pk []Node) -> ParamMode {
    // No name: a recovery shape. Nothing is written, so nothing is claimed --
    // and the `else` says that in the same line instead of a second arm.
    if Some(n) = param_name_at(pk) { mode_before(pk, n) } else { ParamMode.ModeRo }
}

/// The MODE this node spells, or `None` when it spells none -- INCLUDING when it
/// is not a leaf at all.
///
/// THE GUARD AGAINST A BRANCH LIVES HERE AND NOWHERE ELSE. Three readers asked
/// `leaf_kind` of a child directly, and that is a question only a LEAF has an
/// answer to: a receiver group carrying type arguments (`fn P[A].mk()`) puts a
/// `Generics` BRANCH exactly where they expected a word, and novac ICED on a
/// form the oracle compiles. Found 2026-08-23 by the corpus batch -- the batch
/// died with rc=2, which the batch guard refuses to read as "all accepted", and
/// that is the only reason it was found at all.
///
/// The three readers differ in WHERE they look (before the name, after the
/// receiver's type, at a statement's head); they do not differ in what a mode
/// word IS, so that part is one door (P18).
#realtime nogc
fn mode_of_leaf(c Node) -> Option[ParamMode] {
    if c.kind_of() != NodeKind.LeafNode { return None }
    // A MATCH, because three `if k == ...` in a row IS a table and the
    // convention says to write a table as one (P21). The residual arm is `None`
    // -- partiality declared by the return type, which is the form the rule
    // admits: most token kinds are not mode words, and that is not a refusal.
    match leaf_kind(c) {
        KwMut => Some(ParamMode.ModeMut)
        KwRo => Some(ParamMode.ModeRo)
        KwConsume => Some(ParamMode.ModeConsume)
        _ => None
    }
}

/// The mode word standing before slot `n`, as a mode.
fn mode_before(pk []Node, n int) -> ParamMode {
    mut i = 0
    for c in pk {
        if i >= n { return ModeRo }
        // WHAT a mode word is lives in one door; this reader owns only WHERE it
        // looks -- before the name, because that is where a parameter's mode
        // stands.
        // Not a mode word -- a name, a type, or a branch -- means keep looking;
        // the `return` IS the other branch (P31 form 2).
        if Some(m) = mode_of_leaf(c) { return m }
        i += 1
    }
    ModeRo
}

/// The MODE a BINDING statement declares: `ro x = …`, `mut x = …`,
/// `consume x = …`.
///
/// The keyword is the statement's first leaf, and it is a KEYWORD for two of
/// the three -- so the question is answered by the same split as everywhere
/// else: token kind for `mut`/`ro`, spelling for `consume` (P5 keeps the
/// spelling in `builtins`).
export fn bind_mode_at(kids []Node) -> ParamMode {
    if kids.len() == 0 { return ModeRo }
    // Not a mode word: the default below answers, and the `return` is the
    // other branch.
    if Some(m) = mode_of_leaf(kids[0]) { return m }
    // `ro` and anything else: read-only is the language's default, and a
    // statement whose head is neither was refused by the subset walk.
    ModeRo
}

/// The MODE of the RECEIVER of a method declaration -- parameter zero's mode
/// (plan 273), which is what makes `@ptr()` and `mut @ptr()` two selectable
/// callables (P14).
///
/// Read from the receiver GROUP, after its type: `fn Vec[T] mut @ptr()` puts
/// the qualifier between the type reference and the `@`. A declaration with no
/// receiver has no receiver mode, and `ModeRo` is the honest answer -- the
/// caller only asks when `has_recv`.
export fn recv_mode_at(kids []Node) -> ParamMode {
    for c in kids {
        if c.kind_of() != NodeKind.Recv { continue }
        return mode_after_first_ident(branch_children(c))
    }
    ModeRo
}

/// The mode word standing AFTER the first identifier of a receiver group.
///
/// After, because the first identifier is the receiver's TYPE: a type named
/// `consume` would otherwise be read as a qualifier of itself.
fn mode_after_first_ident(rk []Node) -> ParamMode {
    mut seen_type = false
    for c in rk {
        if !seen_type {
            seen_type = c.is_ident()
            continue
        }
        // A BRANCH lands in the not-a-mode case too, and that is the fix:
        // `fn P[A].mk()` puts the type arguments right after the receiver's type
        // name, and asking a branch for its token kind was an ice.
        if Some(m) = mode_of_leaf(c) { return m }
    }
    ModeRo
}

/// The first node of the parameter's TYPE, or None when it declares none.
export fn param_type_at(pk []Node) -> Option[int] {
    // No name: a recovery shape, and a type cannot be located without one.
    if Some(n) = param_name_at(pk) { type_slot_after(pk, n) } else { None }
}

/// The slot holding the type that follows the name at `n`, or None: the name
/// may be the LAST child (`fn f(v)`) or be followed by a comma (`fn f(v, w)`),
/// and in both cases the parameter declares no type of its own.
fn type_slot_after(pk []Node, n int) -> Option[int] {
    if n + 1 >= pk.len() {
        return None
    } else {
        // There is a child after the name; whether it is a type is next.
    }
    ro t = n + 1
    ro c = pk[t]
    ro no_type = c.kind_of() == NodeKind.LeafNode &&
        leaf_kind(c) == TokenKind.Comma
    if no_type {
        return None
    } else {
        // A real node stands where the type belongs.
    }
    Some(t)
}

/// Children of a branch node; a leaf here is an invariant break.
///
/// The view is READ-ONLY (`-> ro`, owner's review 2026-08-17): the green tree
/// is immutable by definition, and handing its own children out as a plain
/// `[]Node` would give every caller a mutable alias of it. The compiler does
/// not catch that today (see the `ro`-laundering repro in
/// docs/plans/274.12-novac-divergences.md), so the signature has to say it.
export fn branch_children(n Node) -> ro []Node {
    match n {
        Leaf(_) => ice("sem: expected a branch node")
        Branch { children, .. } => children
    }
}

/// Token text of a leaf node; a branch here is an invariant break.
export fn leaf_text(n Node) -> str {
    match n {
        Leaf(t) => t.text
        Branch { .. } => ice("sem: leaf_text on a branch node")
    }
}

/// Token kind of a leaf node; a branch here is an invariant break.
export fn leaf_kind(n Node) -> TokenKind {
    match n {
        Leaf(t) => t.kind
        Branch { .. } => ice("sem: leaf_kind on a branch node")
    }
}


/// THE TYPE A LITERAL TOKEN STANDS FOR -- the ONE home of the four-way table (D44:
/// an undecided literal is its own kind, `int` and `f64`).
///
/// Two consumers ask it, and that is why it is here rather than in either of them: the
/// checker's `type_of` (after the channel had no type for the position) and the lowering
/// of a `println` argument (where there IS no position type -- `println` is a builtin name
/// with no registry row, so nothing can dictate a width). A copy in the second consumer
/// would be a second home for one rule, and the first edit to part them would be the day
/// a new literal kind arrives in one place and not the other.
///
/// A table maps, so it is a match -- and its leftover branch is a REFUSAL, not a guess
/// (P21: a wildcard may only carry `None` where the type declares partiality).
export fn literal_prim_of(lk TokenKind, ctx Ctx) -> TyId {
    match lk {
        StrLit => ctx.prims.str_id
        FloatLit => ctx.prims.f64_id
        IntLit => ctx.prims.int_id
        CharLit => ctx.prims.char_id
        _ => ice("sem: literal token kind without a type rule (#652 class)")
    }
}


/// First-leaf text of a Name-like node (its identifier).
export fn expr_leaf_name(e Node) -> str {
    ro kids = branch_children(e)
    leaf_text(kids[0])
}


/// Callee text of a Call node's children (leaf or Name-branch callee).
export fn call_callee_text(kids []Node) -> str {
    match kids[0] {
        Leaf(t) => t.text
        Branch { children, .. } => {
            match children[0] {
                Leaf(t) => t.text
                Branch { .. } => ""
            }
        }
    }
}

/// Does this declaration write a RECEIVER -- is it a method?
///
/// The parser puts a `Recv` branch where a free function has its name leaf, so
/// the question is "is one of these children a Recv" and the answer arrives at
/// the first one. Two walks asked it separately until 2026-08-20 (typing, to
/// refuse a method declaration before `leaf_text` meets a branch and ices; and
/// the generics-position rule, to tell `fn[T] []T @map` from `fn box[T]`) --
/// one question, so one door.
#realtime nogc
export fn declares_receiver(kids []Node) -> bool {
    for c in kids {
        // The prevailing shape for "skip what is not my kind": a negated test
        // with a terminator, and no `else` doing work on a closed set (P21).
        if c.kind_of() != NodeKind.Recv { continue }
        return true
    }
    false
}

/// The INDEX a projection leaf spells, or -1: `t.0` carries its component
/// index as the integer literal's text, and the checker needs the number to
/// judge it against the tuple's arity. Plain unsigned decimal -- anything
/// else answers -1 rather than guessing (B15 step 4a).
export fn digit_index(text str) -> int {
    if text == "" { return -1 }
    mut v = 0
    for b in text.bytes() {
        if b < ('0' as u8) || b > ('9' as u8) { return -1 }
        v = v * 10 + ((b - ('0' as u8)) as int)
    }
    v
}

/// The SLOTS of the extra disjunction heads inside a flat match pattern:
/// every identifier standing right after a `|` leaf (the pattern-alternatives
/// wave). Slot 0 is NOT here -- the first head keeps its original readers;
/// this door feeds the exhaustiveness count and the emitter's OR-chain with
/// the alternatives only. Two readers, one walk (P18).
/// WHICH LEAF OF A FLAT PATTERN IS ITS HEAD -- the one question two passes
/// used to answer separately and wrongly in the same way.
///
/// A bare head is slot 0 (`A => ...`). A QUALIFIED head is slot 2, because
/// the parser writes the three leaves `Kind`, `.`, `B` and the variant is the
/// last of them. Before 2026-09-20 both the checker and the lowering read
/// slot 0 and found the TYPE name, which names no variant -- so both fell
/// through to "a plain binder", and a plain binder matches everything. The
/// first arm of every qualified match won, in a program that compiled
/// cleanly and printed a wrong answer.
///
/// The qualifier itself is left at slot 0 for the caller that has to check
/// it names the matched type -- a question this door does not answer,
/// because it has no `Ctx`.
/// DOES THIS SUBTREE CALL ANYTHING? An argument that calls something is an
/// argument whose evaluation ORDER is observable.
///
/// Two askers, one door: `check` refuses two such arguments in one call when
/// nothing fixes their order, and the lowering hoists exactly those into
/// temporaries so that something does (F65). The two must agree on WHICH
/// arguments they mean, and agreeing by asking the same function is the only
/// kind of agreement that survives an edit.
export fn contains_call(n Node) -> bool {
    match n {
        Leaf(_) => false
        Branch { kind, children, .. } => {
            if kind == NodeKind.Call || kind == NodeKind.MethodCall { return true }
            for c in children {
                if contains_call(c) { return true }
            }
            false
        }
    }
}

/// WHICH LEAF OF A FLAT PATTERN IS ITS HEAD -- slot 0 for a bare head, slot
/// 2 for a qualified one (`Kind`, `.`, `B`).
///
/// Its doc paragraph ended up above `disj_head_slots` when that door was
/// written beside it -- the same displacement, in the other direction, that
/// the neighbour's own doc records. Registry 1190 is why the door exists:
/// reading slot 0 found the TYPE name, which names no variant, so both the
/// checker and the lowering fell through to "a plain binder" -- and a
/// binder matches everything.
export fn pattern_head_slot(pat []Node) -> int {
    if pat.len() < 3 { return 0 }
    if !pat[0].is_ident() { return 0 }
    if leaf_kind(pat[1]) != TokenKind.Dot { return 0 }
    if !pat[2].is_ident() { return 0 }
    2
}

/// THE ALTERNATIVE HEADS of a disjunction -- the slot right after each pipe.
///
/// Its doc paragraph lived above it until `pattern_head_slot` was inserted
/// here and took it: a door written directly above another inherits the one
/// thing that was never its own.
export fn disj_head_slots(pat []Node) -> []int {
    mut slots = []int.new()
    for i in 1..pat.len() {
        ro prev = pat[i - 1]
        ro cur = pat[i]
        match prev {
            Leaf(t) => {
                // Only an identifier right after a pipe is an alternative
                // head; anything else is the pattern body or a recovery gap.
                if t.kind != TokenKind.Pipe { continue }
                if !cur.is_ident() { continue }
                slots.push(i)
            }
            Branch { .. } => {}
        }
    }
    slots
}

/// Does this flat pattern carry a disjunction at all? One pipe answers; the
/// binder judge and the payload unpack both gate on it.
export fn pattern_has_disj(pat []Node) -> bool {
    for c in pat {
        match c {
            Leaf(t) => {
                if t.kind == TokenKind.Pipe { return true }
            }
            Branch { .. } => {}
        }
    }
    false
}

/// Does this `IfLet`'s head carry a QUALIFIER -- `if Sum.Variant(b) = e`,
/// not bare `if Variant(b) = e` (registry #1259)? Slot 2 is `.` for the
/// qualified form and `(` for the bare one; the parser writes no other
/// shape. The same class already fixed for match's own pattern head
/// (`pattern_head_slot` above) and for `const Type.NAME` -- a variant's
/// head is read in more than one place in this grammar, and if-let's was
/// the one that had not learned the qualifier yet.
export fn iflet_is_qualified(kids []Node) -> bool {
    kids.len() > 2 && kids[2].kind_of() == NodeKind.LeafNode && leaf_kind(kids[2]) == TokenKind.Dot
}

/// The QUALIFIER'S WIDTH: 2 extra slots (`.` + the variant ident) stand
/// before everything the bare head already had, when there is one. Every
/// other `iflet_*_at` door below is the bare offset plus this.
fn iflet_shift(kids []Node) -> int {
    if iflet_is_qualified(kids) { 2 } else { 0 }
}

/// The slot of the VARIANT name -- 1 for a bare head, 3 for a qualified one.
export fn iflet_variant_at(kids []Node) -> int => 1 + iflet_shift(kids)

/// The slot of the BINDER name inside the parens.
export fn iflet_binder_at(kids []Node) -> int => 3 + iflet_shift(kids)

/// The slot of the INITIALIZER expression, the head after `=`.
export fn iflet_init_at(kids []Node) -> int => 6 + iflet_shift(kids)

/// The slot of the THEN-block (the `Some`/binder branch).
export fn iflet_body_at(kids []Node) -> int => 7 + iflet_shift(kids)

/// The slot of the ELSE-branch (the `None` branch), when there is one --
/// callers still check `kids.len()` against it; this door only says WHERE
/// it would stand, not WHETHER it does.
export fn iflet_else_at(kids []Node) -> int => 9 + iflet_shift(kids)
