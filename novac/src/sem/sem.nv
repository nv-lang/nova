// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem — the semantic layer of the E2 vertical (architecture §2:
// the `sem` seat, grown early by the owner's 2026-08-15 review: the type
// registry, the unified def table and expression typing are NOT backend
// matter — any backend (C today, libFirm later) consumes them, so they
// live in ONE place, the rustc_middle model; rustc backends receive types
// through a shared layer, never own them).
//
// E2-TEMPORARY shape, recorded in the edge table: sem is BUILT during the
// emit phase from the green tree (collect_types) and typing is the tiny
// registry lattice. At E4 `check` becomes the single writer of sem and the
// lattice grows into the real type checker; the module seat does not move.
//
// Terminology (owner's question 2026-08-15, id vs idx): a TYPE ID is the
// identifier of a type, IMPLEMENTED as its interned index in Ctx.types —
// the rustc DefId model (an identifier that happens to be a number). A ROW
// is an index into one specific row vector and nothing more. Fields say
// which one they are.
//
// No silent type defaults anywhere here (#652 class, owner's rule): every
// resolve miss is an ice(), every kind is judged positively.

module novac.sem

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}
import ../diag.{ice}
import ../names.{NameTable, NamespaceId}
import ../builtins.{TypeKind, builtin_types}

/// What a top-level name IS (the rustc Res model: ONE lookup answers it) —
/// a SUM, not int constants (owner 2026-08-14: the language's own type
/// safety judges kind dispatch, an arbitrary int cannot leak in).
export type DefKind enum
    | DefType
    | DefVariant
    | DefFn

/// One type of the file registry; a type id is this record's interned
/// index in Ctx.types (see the terminology note above). Registry rows are
/// VALUE records: a plain record is a GC pointer — one heap allocation per
/// row; `value` keeps rows inline in the vector buffer.
export type TypeDef value {
    kind TypeKind /// Which row table the off/cnt range addresses.
    name str /// Source spelling (`int`, `Point`); the mangling door derives C names from it.
    c_name str /// Runtime ABI spelling for TkPrim ONLY (nova_rt.h fact); "" otherwise — mangling is a door, never a stored string.
    row_off int /// First row of this type in Ctx.field_rows (record) / Ctx.variant_rows (sum).
    row_cnt int /// How many rows; 0 for primitives.
}

/// One top-level declaration of the unified name registry: what a name IS.
export type Def value {
    kind DefKind /// What this name is — drives the payload's meaning.
    /// DefType: a type id · DefVariant: a Ctx.variant_rows ROW · DefFn: a
    /// Ctx.fn_rets ROW. Named payload, not id: two of the three are plain
    /// row indexes (owner's id-vs-idx question 2026-08-15).
    payload int
}

/// THE unified name registry: the O(1) name door and the row it answers
/// with — one record, because they only ever travel together (owner
/// 2026-08-15: a pair that always walks in pairs belongs in one record).
export type DefTable {
    names NameTable /// name -> row in `rows` (NsDefs namespace).
    rows []Def /// What each registered name is.
}

/// Empty registry with the NsDefs namespace.
export fn DefTable.new() -> DefTable =>
    { names: NameTable.new(NamespaceId.NsDefs), rows: []Def.new() }

/// Register one name; collisions across kinds are check's ground (later
/// wave) — last put wins for now, recorded honestly.
export fn DefTable mut @add(name str, kind DefKind, payload int) -> () {
    @names.put(name, @rows.len())
    @rows.push(Def { kind, payload })
}

/// Row of `name`, or -1.
export fn DefTable @find(name str) -> int => @names.find(name)

/// Тип по имени при СБОРЕ: -1, если имя неизвестно или это не тип. Сбор
/// терпим к сломанному вводу СОЗНАТЕЛЬНО (274.3/F-B4): картина файла строится
/// и для check, а тот обязан выдать диагностику, а не умереть в ICE. Судит
/// check (правило «тип в позиции типа обязан быть объявлен»); sem ничего не
/// придумывает — просто не регистрирует то, чего не понял.
export fn DefTable @type_id_opt(name str) -> int {
    ro d = @names.find(name)
    if d < 0 { return -1 }
    ro def = @rows[d]
    if def.kind != DefKind.DefType { return -1 }
    def.payload
}

/// Resolve `name` in TYPE POSITION (params, fields, returns, constructor
/// heads): ONE lookup, then the kind must be a type. NO SILENT DEFAULT.
export fn DefTable @type_id(name str) -> int {
    ro d = @names.find(name)
    if d < 0 { ice("sem: type name not in the registry — no silent int default (#652 class)") }
    ro def = @rows[d]
    if def.kind != DefKind.DefType { ice("sem: name in type position is not a type (#652 class)") }
    def.payload
}

/// One record field; a field row is this record's index in Ctx.field_rows.
export type FieldDef value {
    name str /// Field spelling; the backend uses it for the member name verbatim.
    type_id int /// The field's type id.
}

/// Record-field registry: fields resolve ONLY through a receiver type —
/// never as bare names (same as Go/rustc) — so the door key carries the
/// owner: "ownerTypeId.fieldName".
export type FieldTable {
    names NameTable /// "ownerId.field" -> row in `rows` (NsFields namespace).
    rows []FieldDef /// The field rows, grouped per type via TypeDef.row_off/cnt.
}

/// Empty field registry with the NsFields namespace.
export fn FieldTable.new() -> FieldTable =>
    { names: NameTable.new(NamespaceId.NsFields), rows: []FieldDef.new() }

/// Register one field of `owner`.
export fn FieldTable mut @add(owner int, fd FieldDef) -> () {
    @names.put("${owner}.${fd.name}", @rows.len())
    @rows.push(fd)
}

/// Type id of `owner`.`fname` — an unknown field past check is an ice.
export fn FieldTable @field_type(owner int, fname str) -> int {
    ro row = @names.find("${owner}.${fname}")
    if row < 0 { ice("sem: unknown field past check (type checker is a later wave)") }
    @rows[row].type_id
}

/// One sum variant; a variant row is this record's index in Ctx.variant_rows.
export type VariantDef value {
    sum int /// Owning sum's type id (backends derive the tag name from it).
    name str /// Variant spelling; backends derive maker names from it.
    payload_off int /// First payload row in Ctx.payload_types.
    payload_cnt int /// How many payload fields.
}

/// Type ids of the pre-seeded primitives — the rustc CommonTypes model
/// (owner 2026-08-15: no hard-coded indexes; the seed hands the ACTUAL ids
/// out and everything compares against these fields).
export type Prims value {
    t_int int /// Type id of `int`.
    t_str int /// Type id of `str`.
    t_bool int /// Type id of `bool`.
    t_f64 int /// Type id of `f64`.
}

/// Чем закончился поиск метода в ПРОЧИТАННЫХ декларациях std.
/// Сумма, а не int-код: «не нашли» и «перегрузка» — разные ответы, и оба
/// обязаны быть представимы (П13.5; тихий int-дефолт — класс №652).
export type MethodLookup enum
    | MethodFound(int)
    | MethodUnknown
    | MethodAmbiguous

/// Одна сигнатура метода, прочитанная из декларации `fn <Recv> @<имя>(...) -> R`.
export type MethodDef value {
    recv int /// type id ресивера
    name str /// имя метода как написано в декларации
    ret int /// type id возврата
    dup bool /// встретилась вторая декларация с тем же (recv, имя) — перегрузка
}

/// Таблица методов подмножества. Наполняется ТОЛЬКО чтением деклараций
/// (П5: имена std — данные, а не знание компилятора); ключ — (тип ресивера,
/// имя), поэтому `p.contains(..)` на записи не резолвится в метод строки.
export type MethodTable {
    names NameTable /// "recvId.имя" -> строка в rows (пространство NsMethods)
    bare NameTable /// "имя" -> 1: существует ли метод с таким именем ХОТЬ У КОГО-ТО
    rows []MethodDef /// прочитанные сигнатуры
}

/// Пустая таблица методов.
export fn MethodTable.new() -> MethodTable =>
    { names: NameTable.new(NamespaceId.NsMethods), bare: NameTable.new(NamespaceId.NsMethods), rows: []MethodDef.new() }

/// Зарегистрировать прочитанную сигнатуру; повтор (recv, имя) помечает
/// перегрузку — выбирать молча нельзя.
export fn MethodTable mut @add(md MethodDef) -> () {
    ro key = "${md.recv}.${md.name}"
    ro row = @names.find(key)
    if row >= 0 {
        @rows[row] = MethodDef { recv: @rows[row].recv, name: @rows[row].name, ret: @rows[row].ret, dup: true }
        return
    }
    @names.put(key, @rows.len())
    @bare.put(md.name, 1)
    @rows.push(md)
}

/// Есть ли метод с таким именем ХОТЬ У КАКОГО-ТО ресивера в прочитанных
/// декларациях. Слабее точного (ресивер, имя) и применяется ровно там, где
/// точный ответ невозможен: `check` идёт по дереву без локалов, тип ресивера
/// ему ещё не известен. Опечатка в имени ловится здесь; несовпадение ресивера
/// (`p.contains(..)` на записи) остаётся находкой C9 плана 274.3 — она
/// закрывается волной 3, когда типизацию локалов получит check, а не эмиттер.
export fn MethodTable @has_name(name str) -> bool => @bare.find(name) >= 0

/// Тип возврата метода на ресивере — или причина отказа.
export fn MethodTable @lookup(recv int, name str) -> MethodLookup {
    ro row = @names.find("${recv}.${name}")
    if row < 0 { return MethodLookup.MethodUnknown }
    ro md = @rows[row]
    if md.dup { return MethodLookup.MethodAmbiguous }
    MethodLookup.MethodFound(md.ret)
}

/// File-level semantic context. Row STORAGE is flat id-indexed vectors of
/// VALUE row records (rustc IndexVec camp; architecture «референс
/// хранения»); every name -> id step goes through a table door.
export type Ctx {
    types []TypeDef /// The type registry; a prefix of pre-seeded primitives, then the file's types in declaration order.
    prims Prims /// Type ids of the primitives (the CommonTypes model).
    defs DefTable /// THE unified top-level name registry (types, variants, fns).
    fields FieldTable /// Record fields, addressed through the owner type.
    variant_rows []VariantDef /// Sum variants, grouped per type via TypeDef.row_off/cnt.
    payload_types []int /// Variant payload rows: type ids, grouped via VariantDef.
    fn_rets []int /// fn ROW -> return type id (-1 = none declared, main only).
    methods MethodTable /// сигнатуры методов, ПРОЧИТАННЫЕ из деклараций std (П5)
}

/// Seed one pre-declared type: the registry row and the def row are born
/// together; the ACTUAL id flows back to the caller (never hard-coded).
fn seed(mut types []TypeDef, mut defs DefTable, name str, c_name str) -> int {
    ro id = types.len()
    types.push(TypeDef { kind: TypeKind.TkPrim, name, c_name, row_off: 0, row_cnt: 0 })
    defs.add(name, DefKind.DefType, id)
    id
}

/// Build the semantic context of one checked file (E2: called by the
/// backend; E4: check becomes the single writer).
/// Собрать сигнатуры методов из ПРОЧИТАННЫХ деклараций (`fn <Recv> @<имя>()
/// -> R`). Берутся только те, у которых И ресивер, И возврат — типы, уже
/// известные реестру: остальное методом подмножества не становится и получает
/// честный отказ на месте использования. Перегрузки (две сигнатуры на одно
/// (ресивер, имя)) помечаются и тоже отказываются — молча выбирать нельзя.
fn harvest_methods(decls []Node, defs DefTable, mut methods MethodTable) -> () {
    for d in decls {
        harvest_in(d, defs, methods)
    }
}

/// Обход РЕКУРСИВНЫЙ, а не по верхнему уровню: восстановление парсера может
/// вложить объявление внутрь чужого узла (та самая находка A2 плана 274.3 —
/// `atom()` съедает закрывающую скобку и утаскивает хвост файла). Пока
/// восстановление не починено волной 2, сбор сигнатур не должен от него
/// зависеть: декларация найдена там, где она оказалась.
fn harvest_in(n Node, defs DefTable, mut methods MethodTable) -> () {
    match n {
        Leaf(_) => {}
        Branch { kind, children } => {
            if kind == NodeKind.FnDecl {
                harvest_fn(children, defs, methods)
                return
            }
            for c in children {
                harvest_in(c, defs, methods)
            }
        }
    }
}

/// Одна декларация: ресивер, имя, тип возврата. Берётся, только если И
/// ресивер, И возврат уже известны реестру — иначе метод в подмножество не
/// попадает и получит честный отказ на месте использования.
fn harvest_fn(kids []Node, defs DefTable, mut methods MethodTable) -> () {
    mut recv_name = ""
    mut mname = ""
    mut ret_name = ""
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Recv {
            recv_name = leaf_text(branch_children(c)[0])
        } else if ck == NodeKind.RetType {
            ro rk = branch_children(c)
            if rk.len() > 1 { ret_name = leaf_text(rk[1]) }
        } else if ck == NodeKind.LeafNode && mname == "" && recv_name != "" {
            if leaf_kind(c) == TokenKind.Ident { mname = leaf_text(c) }
        }
    }
    if recv_name == "" || mname == "" || ret_name == "" { return }
    ro recv_t = defs.type_id_opt(recv_name)
    ro ret_t = defs.type_id_opt(ret_name)
    if recv_t < 0 || ret_t < 0 { return }
    // Сигнатура годна, только если известны ВСЕ её типы, включая параметры.
    // Иначе перегрузки std попадали бы в таблицу как «одно имя дважды» и
    // отказывались как неоднозначные: у `str` есть и `@contains(needle str)`,
    // и `@contains(c char)` — вторая не про подмножество, потому что `char`
    // реестру неизвестен. Так отбор делает ТИПОВАЯ система, а не список имён.
    for c in kids {
        if c.kind_of() != NodeKind.Param { continue }
        ro pk = branch_children(c)
        if pk.len() < 2 { return }
        if pk[1].kind_of() != NodeKind.LeafNode { return }
        if defs.type_id_opt(leaf_text(pk[1])) < 0 { return }
    }
    methods.add(MethodDef { recv: recv_t, name: mname, ret: ret_t, dup: false })
}

/// Построить семантический контекст: типы файла + методы из деклараций.
export fn collect(file Node, decls []Node) -> Ctx {
    mut ctx = collect_types(file)
    harvest_methods(decls, ctx.defs, ctx.methods)
    ctx
}

/// Реестр типов и деклараций ОДНОГО файла (без методов: их приносит
/// collect() из прочитанных сигнатур).
export fn collect_types(file Node) -> Ctx {
    mut types = []TypeDef.new()
    mut defs = DefTable.new()
    // Pre-declared types come from the ONE builtins table (P5), in Prims
    // order; the seed hands the ACTUAL ids back (CommonTypes model).
    mut seeded = []int.new()
    for bt in builtin_types() {
        seeded.push(seed(types, defs, bt.name, bt.c_name))
    }
    ro prims = Prims { t_int: seeded[0], t_str: seeded[1], t_bool: seeded[2], t_f64: seeded[3] }
    mut fields = FieldTable.new()
    mut variant_rows = []VariantDef.new()
    mut payload_types = []int.new()
    mut fn_rets = []int.new()
    // First pass: register every type NAME (id = order of appearance after
    // the primitives), so later rows can reference any type of the file
    // regardless of declaration order. TypeDef records are BUILT on the
    // second pass, when their row ranges are known — passes walk the file
    // in the same order, so ids line up.
    mut next_id = types.len()
    for c in branch_children(file) {
        ro k = c.kind_of()
        if k == NodeKind.TypeDecl || k == NodeKind.SumDecl {
            ro nk = branch_children(c)
            if nk.len() > 1 && nk[1].kind_of() == NodeKind.LeafNode {
                defs.add(leaf_text(nk[1]), DefKind.DefType, next_id)
                next_id += 1
            }
        }
    }
    for c in branch_children(file) {
        ro k = c.kind_of()
        if k == NodeKind.TypeDecl {
            ro tkids = branch_children(c)
            if tkids.len() < 2 { continue }
            if tkids[1].kind_of() != NodeKind.LeafNode { continue }
            ro tname = leaf_text(tkids[1])
            ro owner = defs.type_id_opt(tname)
            if owner < 0 { continue }
            ro off = fields.rows.len()
            mut cnt = 0
            for f in branch_children(c) {
                if f.kind_of() == NodeKind.Field {
                    ro fk = branch_children(f)
                    if fk.len() > 1 && fk[0].kind_of() == NodeKind.LeafNode && fk[1].kind_of() == NodeKind.LeafNode {
                        ro ft = defs.type_id_opt(leaf_text(fk[1]))
                        if ft >= 0 {
                            fields.add(owner, FieldDef { name: leaf_text(fk[0]), type_id: ft })
                            cnt += 1
                        }
                    }
                }
            }
            types.push(TypeDef { kind: TypeKind.TkRecord, name: tname, c_name: "", row_off: off, row_cnt: cnt })
        }
        if k == NodeKind.SumDecl {
            ro skids = branch_children(c)
            if skids.len() < 2 { continue }
            if skids[1].kind_of() != NodeKind.LeafNode { continue }
            ro sname = leaf_text(skids[1])
            ro sum_id = defs.type_id_opt(sname)
            if sum_id < 0 { continue }
            ro off = variant_rows.len()
            mut vcnt = 0
            for v in branch_children(c) {
                if v.kind_of() == NodeKind.Variant {
                    ro vk = branch_children(v)
                    // Вариант без имени (восстановление после сломанной суммы):
                    // пропускаем — судит check, sem не падает (274.3/F-B4).
                    if vk.len() < 2 { continue }
                    if vk[1].kind_of() != NodeKind.LeafNode { continue }
                    ro vname = leaf_text(vk[1])
                    defs.add(vname, DefKind.DefVariant, variant_rows.len())
                    ro poff = payload_types.len()
                    mut pcnt = 0
                    // payload type names sit between '(' and ')'
                    mut j = 2
                    while j < vk.len() {
                        // [LEGACY-#TBD-var-index-method] `vk[j].kind_of()`
                        // with a VARIABLE index miscompiles in the oracle
                        // (E_RECV_METHOD_MISMATCH: receiver resolves as Vec;
                        // a constant index works). Found 2026-08-14; the
                        // binding hop is the workaround.
                        ro pj = vk[j]
                        if pj.kind_of() == NodeKind.LeafNode {
                            if leaf_kind(pj) == TokenKind.Ident {
                                ro pt = defs.type_id_opt(leaf_text(pj))
                                if pt >= 0 {
                                    payload_types.push(pt)
                                    pcnt += 1
                                }
                            }
                        }
                        j += 1
                    }
                    variant_rows.push(VariantDef { sum: sum_id, name: vname, payload_off: poff, payload_cnt: pcnt })
                    vcnt += 1
                }
            }
            types.push(TypeDef { kind: TypeKind.TkSum, name: sname, c_name: "", row_off: off, row_cnt: vcnt })
        }
        if k == NodeKind.FnDecl {
            ro fk = branch_children(c)
            if fk.len() < 2 { continue }
            if fk[1].kind_of() != NodeKind.LeafNode { continue }
            defs.add(leaf_text(fk[1]), DefKind.DefFn, fn_rets.len())
            // -1 sentinel = no declared return. Legal ONLY for main (check
            // refuses it elsewhere); backends ice on -1 as the second
            // floor — never a silent int (#652 class).
            mut ret = -1
            for r in fk {
                if r.kind_of() == NodeKind.RetType {
                    ro rk = branch_children(r)
                    if rk.len() > 1 && rk[1].kind_of() == NodeKind.LeafNode { ret = defs.type_id_opt(leaf_text(rk[1])) }
                }
            }
            fn_rets.push(ret)
        }
    }
    Ctx { types, prims, defs, fields, variant_rows, payload_types, fn_rets, methods: MethodTable.new() }
}

/// Children of a branch node; a leaf here is an invariant break.
export fn branch_children(n Node) -> []Node {
    match n {
        Leaf(_) => ice("sem: expected a branch node")
        Branch { children, .. } => children
    }
}

/// Token text of a leaf node; a branch here is an invariant break.
export fn leaf_text(n Node) -> str {
    match n {
        Leaf(t) => t.text
        Branch { .. } => ice("sem: expected a leaf")
    }
}

/// Token kind of a leaf node; a branch here is an invariant break.
export fn leaf_kind(n Node) -> TokenKind {
    match n {
        Leaf(t) => t.kind
        Branch { .. } => ice("sem: expected a leaf")
    }
}

/// Function-local scope: the NsLocals name door and the type of each
/// binding — one record, they only travel together. Shadowing = last bind
/// wins (the door's put overwrites).
export type Scope {
    names NameTable /// name -> row in `types` (NsLocals namespace).
    types []int /// Type id of each binding row.
}

/// Empty scope with the NsLocals namespace.
export fn Scope.new() -> Scope =>
    { names: NameTable.new(NamespaceId.NsLocals), types: []int.new() }

/// Bind `name` to type id `t` (shadowing allowed).
export fn Scope mut @bind(name str, t int) -> () {
    @names.put(name, @types.len())
    @types.push(t)
}

/// Type id of a bound name; an unbound name past check is an ice.
export fn Scope @type_of_name(name str) -> int {
    ro row = @names.find(name)
    if row < 0 { ice("sem: unbound name — resolve is check's ground, no silent int default (#652 class)") }
    @types[row]
}

/// Type of an expression over the tiny registry lattice. Every kind is
/// judged positively; the residual is an ice, never an int (#652 class).
export fn type_of(e Node, ctx Ctx, scope Scope) -> int {
    ro k = e.kind_of()
    if k == NodeKind.Lit {
        // A negated literal is [Minus, lit] — judge the LAST leaf.
        ro lk_kids = branch_children(e)
        ro lk = leaf_kind(lk_kids[lk_kids.len() - 1])
        if lk == TokenKind.StrLit { return ctx.prims.t_str }
        if lk == TokenKind.FloatLit { return ctx.prims.t_f64 }
        if lk == TokenKind.IntLit { return ctx.prims.t_int }
        ice("sem: literal token kind without a type rule (#652 class)")
    }
    if k == NodeKind.Name { return scope.type_of_name(expr_leaf_name(e)) }
    if k == NodeKind.MethodCall {
        ro kids = branch_children(e)
        if kids.len() < 3 { ice("sem: method call without a name") }
        ro mname = leaf_text(kids[2])
        // Тип возврата — из ПРОЧИТАННОЙ сигнатуры (П5): компилятор не знает
        // имён методов std, он их читает. Сюда доходит только то, что check
        // уже принял, поэтому отказы здесь — ice (нарушение отравления).
        ro recv_t = type_of(kids[0], ctx, scope)
        match ctx.methods.lookup(recv_t, mname) {
            MethodFound(r) => { return r }
            MethodUnknown => { ice("sem: method not in the read declarations past check") }
            MethodAmbiguous => { ice("sem: overloaded method past check") }
        }
    }
    if k == NodeKind.FieldAccess {
        ro kids = branch_children(e)
        if kids.len() < 3 { ice("sem: field access without a name") }
        ro recv_t = type_of(kids[0], ctx, scope)
        return ctx.fields.field_type(recv_t, leaf_text(kids[2]))
    }
    if k == NodeKind.RecordCtor {
        ro kids = branch_children(e)
        if kids[0].kind_of() == NodeKind.Name {
            return ctx.defs.type_id(expr_leaf_name(kids[0]))
        }
        // Anonymous `{ ...src, ... }`: the record type is the spread's.
        for c in kids {
            if c.kind_of() == NodeKind.CtorSpread {
                return type_of(branch_children(c)[1], ctx, scope)
            }
        }
        ice("sem: anonymous constructor without a spread")
    }
    if k == NodeKind.Bin {
        ro kids = branch_children(e)
        ro op = leaf_kind(kids[1])
        if op == TokenKind.Lt || op == TokenKind.Le || op == TokenKind.Gt { return ctx.prims.t_bool }
        ro lt = type_of(kids[0], ctx, scope)
        ro rt = type_of(kids[2], ctx, scope)
        if lt == ctx.prims.t_f64 || rt == ctx.prims.t_f64 { return ctx.prims.t_f64 }
        // Both sides must be PROVEN int — arithmetic on str/bool/records is
        // not a silent int (#652 class), it is an invariant break here.
        if lt == ctx.prims.t_int && rt == ctx.prims.t_int { return ctx.prims.t_int }
        ice("sem: binary arithmetic on non-numeric operands past check (#652 class)")
    }
    if k == NodeKind.MatchExpr {
        // The match's value type: its FIRST arm expression (the corpus arms
        // agree by construction; the type checker wave will judge).
        for c in branch_children(e) {
            if c.kind_of() == NodeKind.MatchArm {
                ro ak = branch_children(c)
                return type_of(ak[ak.len() - 1], ctx, scope)
            }
        }
        ice("sem: match without arms past check")
    }
    if k == NodeKind.Call {
        // ONE lookup answers "what is this name" (the rustc Res model),
        // then the kind decides.
        ro d = ctx.defs.find(call_callee_text(branch_children(e)))
        if d < 0 { ice("sem: call target not in the registry — no silent int default (#652 class)") }
        ro def = ctx.defs.rows[d]
        if def.kind == DefKind.DefVariant { return ctx.variant_rows[def.payload].sum }
        if def.kind == DefKind.DefFn {
            ro ret = ctx.fn_rets[def.payload]
            if ret < 0 { ice("sem: call of a fn without a declared return type (#652 class)") }
            return ret
        }
        ice("sem: call target is a type, not a callable (#652 class)")
    }
    ice("sem: expression kind without a type rule — no silent int default (#652 class)")
}

/// Node kinds that stand as expressions (argument/operand positions).
export fn is_expr_kind(k NodeKind) -> bool => k == NodeKind.Bin || k == NodeKind.Lit || k == NodeKind.Name || k == NodeKind.Call || k == NodeKind.MethodCall || k == NodeKind.FieldAccess || k == NodeKind.MatchExpr

/// First-leaf text of a Name-like node (its identifier).
export fn expr_leaf_name(e Node) -> str {
    ro kids = branch_children(e)
    leaf_text(kids[0])
}

/// Callee text of a Call node's children (leaf or Name-branch callee).
export fn call_callee_text(kids []Node) -> str {
    match kids[0] {
        Leaf(t) => t.text
        Branch { children, .. } => {
            match children[0] {
                Leaf(t) => t.text
                Branch { .. } => ""
            }
        }
    }
}
