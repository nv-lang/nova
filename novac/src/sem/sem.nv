// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `Res::Def(DefKind, DefId)` for Def{kind,payload} (ONE lookup
// answers \"what is a name\"), rustc `IndexVec` for flat id-indexed value rows,
// rustc `CommonTypes` for Prims, Go `types2.collectObjects`/`packageObjects` for
// the two-pass collect, separate chaining (name -> first row + `next_row`, TAOCP
// §6.4) for FieldTable/FnTable, Go `types2.lookupFieldOrMethod` / rustc
// `FnCtxt::check_field` for \"fields only through a receiver\", rustc
// `method::probe` + `AssocItem.fn_has_self_parameter` for \"receiver = first
// parameter, resolve by receiver type\", rustc `report_method_error` / clang
// `Sema::NoteAllOverloadCandidates` for printing the whole candidate set, Zig
// `InternPool.OptionalIndex` for `-1 = absent`; Donor: none for the harvest rule
// (a signature enters only when EVERY type is known — the type system filters std
// overloads, not a name list) and for the tolerant/strict pair
// `type_id_opt`/`type_id` (274.3/F-B4); NOT taken: a uniform DefId (payload is a
// per-kind ROW), Go `Scope.Insert`→alt / rustc E0428 duplicate diagnostics
// (DefTable.add is last-put-wins, collect_types first-owns — check's ground), a
// per-node type table (Go `types2.Info.Types` / rustc `TypeckResults.node_types`)
// — `type_of` recomputes on demand until check is the single writer at E4 (Go
// `Checker`→`Info`, rustc typeck→`TypeckResults`), block-scoped ribs.
// Role: layers 3-4 — the declaration registry (DeclId rows) and, since E2-b1, the owner of the type interner; the truth every pass below reads.
// Used by: check and emit_c (E1-E2); mono and layout at E2-b2; becomes the checker's channel writer at E4.
// Guarded by: check-novac-ctx-tables.sh (the set of Ctx tables is declared in plan 10.3b), check-novac-row-fields.sh (every row field justified in 10.3v, no derived field), check-novac-ref-field-names.sh (_id/_row suffixes), check-novac-resolve-discipline.sh (no silent int default), check-novac-no-alloc-in-lookup.sh (doors carry #realtime nogc).
// `IndexVec<Idx, Row>` as flat id-indexed value rows, and the rule that
// backends CONSUME the registry and none owns it; NOT taken: TyCtxt arenas and
// the query system (a batch pass builds Ctx once per file).
// novac/src/sem — the semantic layer of the E2 vertical (architecture §2:
// the `sem` seat, grown early by the owner's 2026-08-15 review: the type
// registry, the unified def table and expression typing are NOT backend
// matter — any backend (C today, libFirm later) consumes them, so they
// live in ONE place, the rustc_middle model; rustc backends receive types
// through a shared layer, never own them).
//
// E2-TEMPORARY shape, recorded in the edge table: sem is BUILT during the
// emit phase from the green tree (collect_types) and typing is the tiny
// registry lattice. At E4 `check` becomes the single writer of sem and the
// lattice grows into the real type checker; the module seat does not move.
//
// Terminology (owner's question 2026-08-15, id vs idx): a TYPE ID is the
// identifier of a type, IMPLEMENTED as its interned index in Ctx.types —
// the rustc DefId model (an identifier that happens to be a number). A ROW
// is an index into one specific row vector and nothing more. Fields say
// which one they are.
//
// No silent type defaults anywhere here (#652 class, owner's rule): every
// resolve miss is an ice(), every kind is judged positively.

module novac.sem

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}
import ../diag.{ice}
import ../names.{NameTable, NamespaceId}
import ../builtins.{TypeKind, builtin_types}
import ../types.{Interner}

/// What a top-level name IS (the rustc Res model: ONE lookup answers it) —
/// a SUM, not int constants (owner 2026-08-14: the language's own type
/// safety judges kind dispatch, an arbitrary int cannot leak in).
export type DefKind enum
    | DefType
    | DefVariant
    | DefFn

/// One type of the file registry; a type id is this record's interned
/// index in Ctx.types (see the terminology note above). Registry rows are
/// VALUE records: a plain record is a GC pointer — one heap allocation per
/// row; `value` keeps rows inline in the vector buffer.
export type TypeDef value {
    kind TypeKind /// Which row table the off/cnt range addresses.
    ty_id int /// The interned term of this declaration (types.Interner id): Prim / Record(decl) / Sum(decl). E2-b1 seam — consumers migrate to it one by one; the declaration index stays the DeclId.
    name str /// Source spelling (`int`, `Point`); the mangling door derives C names from it.
    row_off int /// First row of this type in Ctx.field_rows (record) / Ctx.variant_rows (sum_id).
    row_cnt int /// How many rows; 0 for primitives.
}

/// One top-level declaration of the unified name registry: what a name IS.
export type Def value {
    kind DefKind /// What this name is — drives the payload's meaning.
    /// DefType: a type id · DefVariant: a Ctx.variant_rows ROW · DefFn: a
    /// Ctx.fns ROW. Named payload, not id: two of the three are plain
    /// row indexes (owner's id-vs-idx question 2026-08-15).
    payload int
}

/// THE unified name registry: the O(1) name door and the row it answers
/// with — one record, because they only ever travel together (owner
/// 2026-08-15: a pair that always walks in pairs belongs in one record).
export type DefTable {
    names NameTable /// name -> row in `rows` (NsDefs namespace).
    rows []Def /// What each registered name is.
}

/// Empty registry with the NsDefs namespace.
export fn DefTable.new() -> DefTable =>
    { names: NameTable.new(NamespaceId.NsDefs), rows: []Def.new() }

/// Register one name; collisions across kinds are check's ground (later
/// wave) — last put wins for now, recorded honestly.
export fn DefTable mut @add(name str, kind DefKind, payload int) -> () {
    @names.put(name, @rows.len())
    @rows.push(Def { kind, payload })
}

/// Row of `name`, or -1.
#realtime nogc
export fn DefTable @find(name str) -> int => @names.find(name)

/// Type by name during COLLECTION: -1 if the name is unknown or not a
/// type. Collection is DELIBERATELY tolerant of broken input
/// (274.3/F-B4): the file picture is built for check too, and check
/// must issue a diagnostic, not die in an ICE. check is the judge (the
/// rule "a type in type position must be declared"); sem invents
/// nothing — it just does not register what it did not understand.
#realtime nogc
export fn DefTable @type_id_opt(name str) -> int {
    ro d = @names.find(name)
    if d < 0 { return -1 }
    ro def = @rows[d]
    if def.kind != DefKind.DefType { return -1 }
    def.payload
}

/// Resolve `name` in TYPE POSITION (params, fields, returns, constructor
/// heads): ONE lookup, then the kind must be a type. NO SILENT DEFAULT.
#realtime nogc
export fn DefTable @type_id(name str) -> int {
    ro d = @names.find(name)
    if d < 0 { ice("sem: type name not in the registry — no silent int default (#652 class)") }
    ro def = @rows[d]
    if def.kind != DefKind.DefType { ice("sem: name in type position is not a type (#652 class)") }
    def.payload
}

/// One record field; a field row is this record's index in Ctx.field_rows.
export type FieldDef value {
    name str /// Field spelling; the backend uses it for the member name verbatim.
    type_id int /// The field's type id.
    owner_id int /// Owning type id; the door takes the NAME and compares this as an integer.
    next_row int /// Next row carrying the SAME field name, or -1; see FieldTable.
}

/// Record-field registry: fields resolve ONLY through a receiver type —
/// never as bare names (same as Go/rustc). The door therefore takes the
/// field name and walks a chain of same-named rows, comparing the owner as
/// an INTEGER. The first shape built the key as text ("${owner_id}.${name}"),
/// which allocated and formatted a string on every field access and put
/// structure back into a string right after §4а spent a rule on "identity
/// is not a name"; the chain does the same job with one integer compare per
/// candidate and no allocation. Rows stay in per-type insertion order, so
/// TypeDef.row_off/row_cnt still address a contiguous range.
export type FieldTable {
    names NameTable /// field name -> FIRST row with that name (NsFields); FieldDef.next walks the rest.
    rows []FieldDef /// The field rows, grouped per type via TypeDef.row_off/cnt.
}

/// Empty field registry with the NsFields namespace.
export fn FieldTable.new() -> FieldTable =>
    { names: NameTable.new(NamespaceId.NsFields), rows: []FieldDef.new() }

/// Register one field of `owner_id`, keeping the same-name chain linked.
export fn FieldTable mut @add(owner_id int, name str, type_id int) -> () {
    ro head = @names.find(name)
    @names.put(name, @rows.len())
    @rows.push(FieldDef { name, type_id, owner_id, next_row: head })
}

/// Does `owner_id` have a field named `fname`? The tolerant half again:
/// `check` asks first, so a misspelled field is a diagnostic, not an ice.
#realtime nogc
export fn FieldTable @has_field(owner_id int, fname str) -> bool {
    mut r = @names.find(fname)
    while r >= 0 {
        ro fd = @rows[r]
        if fd.owner_id == owner_id { return true }
        r = fd.next_row
    }
    false
}

/// Type id of `owner_id`.`fname` — an unknown field past check is an ice.
#realtime nogc
export fn FieldTable @field_type(owner_id int, fname str) -> int {
    mut r = @names.find(fname)
    while r >= 0 {
        ro fd = @rows[r]
        if fd.owner_id == owner_id { return fd.type_id }
        r = fd.next_row
    }
    // [LEGACY-#700-user-error-as-ice until:E2b3] a typo in a field name is a
    // USER error and must be a diagnostic, not an ice; check gets local typing
    // at E2-b3 and takes this over. Integrator review 2026-08-16.
    ice("sem: unknown field past check (type checker is a later wave)")
}

/// One sum_id variant; a variant row is this record's index in Ctx.variant_rows.
export type VariantDef value {
    sum_id int /// Owning sum's type id (backends derive the tag name from it).
    name str /// Variant spelling; backends derive maker names from it.
    payload_off int /// First payload row in Ctx.payload_types.
    payload_cnt int /// How many payload fields.
}

/// Type ids of the pre-seeded primitives — the rustc CommonTypes model
/// (owner 2026-08-15: no hard-coded indexes; the seed hands the ACTUAL ids
/// out and everything compares against these fields).
export type Prims value {
    int_id int /// Type id of `int`.
    str_id int /// Type id of `str`.
    bool_id int /// Type id of `bool`.
    f64_id int /// Type id of `f64`.
}

/// How a callable lookup turned out. A sum, not an int code: "not found"
/// and "more than one candidate" are different answers, and both must be
/// representable (П13.5; a silent int default is the №652 class).
///
/// EVERY variant carries a ROW, never a type id (owner's review 2026-08-16).
/// Two reasons. First, the pair (receiver, name) does NOT determine a return
/// type while the language overloads on PARAMETERS: two callables can share
/// the pair and differ in their parameters, so a door that answered with a
/// type would be claiming more than it can know. It answers with the
/// candidate instead, and the caller reads `ret_id` off the row once the
/// candidate is settled. Second, a row gives the caller the parameters too,
/// which is exactly what choosing between overloads needs.
///
/// `FnOverloaded` is not "ambiguous": it means the set has more than one
/// member and picking needs the ARGUMENT types, which `check` will have when
/// it gets local typing (274.3 wave 3, finding C9). Today novac refuses such
/// a call honestly rather than guessing. The payload is the FIRST row of the
/// set — the whole set is `candidates_from`, which is not a door and may
/// allocate; the door itself stays allocation-free (П18).
export type FnLookup enum
    | FnFound(int)
    | FnUnknown
    | FnOverloaded(int)

/// One callable — plan 273 form: a method IS a function whose first
/// parameter is the receiver, so there is ONE row shape for both.
///
/// The receiver is NOT a field of this row (owner's check 2026-08-16: "in
/// plan 273 the receiver is a parameter like all the others — are you sure
/// you should be matching on it?"). It is `params[param_off]` of a method,
/// and the row says only WHETHER the first parameter is a receiver. The
/// earlier shape kept `recv_id` and stored no other parameter at all:
/// `harvest_fn` validated the parameter types and then threw them away, so
/// the receiver was not "a parameter like the others" — it was the only
/// parameter novac remembered. Keeping them all is also what overload
/// resolution needs later; today it is what makes the form honest.
export type FnDef value {
    name str /// name as written in the declaration
    ret_id int /// return type id; -1 = none declared (legal for main only)
    param_off int /// first parameter of this callable in FnTable.params
    param_cnt int /// how many parameters, INCLUDING the receiver when there is one
    has_recv bool /// the first parameter IS the receiver — the ONE datum here (see below)
    next_row int /// next row carrying the SAME name, or -1; see FnTable
}

/// WHERE THE RECEIVER MARK LIVES, and why it is one bit on the callable
/// rather than a flag on each parameter (owner, 2026-08-16, twice).
///
/// First reading: a bool on the function looked like a privileged fact about
/// one element stored on the container, so the mark moved onto the parameter
/// (`ParamDef.is_recv`). That was worse, and the owner said why: a per
/// parameter flag ADMITS STATES THE LANGUAGE FORBIDS — "the third parameter
/// is the receiver", "two receivers" — and the invariant then rests on
/// discipline instead of on construction.
///
/// The resolution: the POSITION is not data. Plan 273 §4.4 fixes it — "the
/// receiver is the first parameter, on the first step without exceptions" —
/// so position is a rule of the language, not a fact of this file. The only
/// datum left is WHETHER a receiver is there, which is a zero-or-one fact
/// about the CALLABLE. One bool on FnDef expresses exactly that and nothing
/// illegal: there is no way to say "the third one". Parameters go back to
/// being plain type ids, and the receiver is `params[param_off]` when
/// `has_recv` — read by the one function `FnTable.recv_of`.

/// THE callable registry: file functions and the method signatures READ
/// from std declarations live in the SAME rows (П5: std names are data,
/// not compiler knowledge).
///
/// The door takes the NAME only, and rows sharing a name form a chain
/// through `next_row`; the receiver is compared as an INTEGER while walking
/// it. The first shape built the key as text ("${recv}.${name}") — the
/// owner's question 2026-08-16 ("what if there is no receiver?") holds,
/// since a free function keys as -1 and type ids are never negative, but the
/// shape was wrong for two better reasons: it allocated and formatted a
/// string on EVERY lookup, in the hottest path there is (П14), and it
/// encoded structure into text right after the architecture spent a whole
/// rule on "identity is not a name" (§4а). A chain costs one integer compare
/// per candidate and allocates nothing; chains are 1-3 long because they
/// only hold callables that literally share a name.
///
/// EVERY declaration gets its own row, including a second one for the same
/// (receiver, name). The first shape kept a `dup` flag on the winner and
/// DROPPED the loser — so the compiler knew an overload existed but could no
/// longer say which signatures collided, and no diagnostic could ever name
/// them (owner's review 2026-08-16). Ambiguity is now a property of the
/// chain, not a flag on a row.
export type FnTable {
    rows []FnDef /// every callable, in registration order; a row index is what DefKind.DefFn points at
    params []int /// parameter type ids of every callable, addressed by FnDef.param_off/param_cnt
    heads NameTable /// name -> FIRST row with that name; `FnDef.next_row` walks the rest
}

/// An empty callable registry.
export fn FnTable.new() -> FnTable =>
    { rows: []FnDef.new(), params: []int.new(), heads: NameTable.new(NamespaceId.NsCallables) }

/// The receiver's type id of a row, or -1 when the callable is a free
/// function. This is the ONE place that knows the receiver is the first
/// parameter — everything else asks here, so the plan 273 form stays a fact
/// of the data and not a convention people must remember.
#realtime nogc
export fn FnTable @recv_of(row int) -> int {
    ro fd = @rows[row]
    if !fd.has_recv { return -1 }
    if fd.param_cnt < 1 { return -1 }
    @params[fd.param_off]
}

/// Row of this exact (receiver, name), or -1 — the FIRST one when a name is
/// declared more than once for one receiver. Ambiguity is judged by
/// `@lookup`, which counts the chain.
///
/// Resolution BY RECEIVER is not a violation of the plan 273 form, it is how
/// a dot-call resolves in this language and in every reference: rustc lowers
/// a method to a function whose first input is `self` and still probes by
/// the type of the receiver expression. 273 unifies the representation and
/// the passes; it does not change what `x.f()` means.
#realtime nogc
export fn FnTable @row_of(recv_id int, name str) -> int {
    mut r = @heads.find(name)
    while r >= 0 {
        if @recv_of(r) == recv_id { return r }
        r = @rows[r].next_row
    }
    -1
}

/// Register one callable. A repeat (receiver, name) is NOT merged and NOT
/// dropped: it becomes its own row in the same chain, so the collision stays
/// describable. Silent choosing between overloads is not allowed anywhere.
/// `param_ids` carries the receiver FIRST when `has_recv` — the plan 273
/// order (§4.4 fixes the position, so the caller has no other place to put
/// it, and no way to name a second one).
export fn FnTable mut @add(name str, ret_id int, has_recv bool, param_ids []int) -> () {
    ro head = @heads.find(name)
    ro off = @params.len()
    for t in param_ids {
        @params.push(t)
    }
    @heads.put(name, @rows.len())
    @rows.push(FnDef { name, ret_id, param_off: off, param_cnt: param_ids.len(), has_recv, next_row: head })
}

/// Whether a callable with this name exists for SOME receiver at all.
/// Free functions are deliberately NOT an answer here: the question is
/// about METHOD names, and `foo()` being declared says nothing about
/// `x.foo()` being legal. Weaker than the exact (receiver, name) and used
/// exactly where the exact answer is impossible: `check` walks the tree
/// without locals, so it does not yet know the receiver's type. A typo in
/// the name is caught here; a receiver mismatch (`p.contains(..)` on a
/// record) stays finding C9 of plan 274.3 — it closes in wave 3, when
/// check, not the emitter, gets local typing.
#realtime nogc
export fn FnTable @has_name(name str) -> bool {
    mut r = @heads.find(name)
    while r >= 0 {
        if @recv_of(r) >= 0 { return true }
        r = @rows[r].next_row
    }
    false
}

/// The candidate row for this (receiver, name) — or why there is none to
/// name. A free function asks with recv_id = -1, through the same door.
/// Counts the chain instead of trusting a flag: more than one row for one
/// pair is an overload SET, and its first row is handed back so the caller
/// can enumerate the set without searching again.
#realtime nogc
export fn FnTable @lookup(recv_id int, name str) -> FnLookup {
    mut first = -1
    mut found = 0
    mut r = @heads.find(name)
    while r >= 0 {
        if @recv_of(r) == recv_id {
            if first < 0 { first = r }
            found += 1
        }
        r = @rows[r].next_row
    }
    if found == 0 { return FnLookup.FnUnknown }
    if found > 1 { return FnLookup.FnOverloaded(first) }
    FnLookup.FnFound(first)
}

/// Every candidate of an overload set, starting from the row `lookup` handed
/// back. NOT a door: it allocates, and it may — it runs once, when a
/// diagnostic is being built, never in the hot path (П18 draws the line at
/// functions that ASK the table; this one is given its starting row and only
/// walks). Every reference prints the set rather than the first member:
/// rustc lists the candidate impls, C++ prints the candidate functions.
export fn candidates_from(fns FnTable, first int, recv_id int) -> []int {
    mut out = []int.new()
    mut r = first
    while r >= 0 {
        if fns.recv_of(r) == recv_id { out.push(r) }
        r = fns.rows[r].next_row
    }
    out
}

/// File-level semantic context. Row STORAGE is flat id-indexed vectors of
/// VALUE row records (rustc IndexVec camp; the architecture's "storage
/// reference"); every name -> id step goes through a table door.
export type Ctx {
    types []TypeDef /// The type registry; a prefix of pre-seeded primitives, then the file's types in declaration order.
    tys Interner /// THE type interner (layer 4): every Ty of this file is a row here; identity is the id (E2-b1).
    prims Prims /// Type ids of the primitives (the CommonTypes model).
    defs DefTable /// THE unified top-level name registry (types, variants, fns).
    fields FieldTable /// Record fields, addressed through the owner type.
    variant_rows []VariantDef /// Sum variants, grouped per type via TypeDef.row_off/cnt.
    payload_types []int /// Variant payload rows: type ids, grouped via VariantDef.
    fns FnTable /// THE callable registry: file functions and read method signatures, one row shape (plan 273).
}

/// Seed one pre-declared type: the registry row and the def row are born
/// together; the ACTUAL id flows back to the caller (never hard-coded).
fn seed(mut types []TypeDef, mut defs DefTable, mut tys Interner, name str, ordinal int) -> int {
    ro id = types.len()
    ro ty_id = tys.prim(ordinal)
    types.push(TypeDef { kind: TypeKind.TkPrim, ty_id, name, row_off: 0, row_cnt: 0 })
    defs.add(name, DefKind.DefType, id)
    id
}

/// Build the semantic context of one checked file (E2: called by the
/// backend; E4: check becomes the single writer).
/// Collect method signatures from READ declarations (`fn <Recv>
/// @<name>() -> R`). Only signatures where BOTH the receiver AND the
/// return are types already known to the registry are taken: the rest
/// does not become a subset method and gets an honest rejection at the
/// point of use. Overloads (two signatures for one (receiver, name))
/// are marked and also rejected — silent choosing is not allowed.
fn harvest_methods(decls []Node, defs DefTable, mut fns FnTable) -> () {
    for d in decls {
        harvest_in(d, defs, fns)
    }
}

/// The walk is RECURSIVE, not top-level only: parser recovery can
/// nest a declaration inside a foreign node (that same finding A2 of
/// plan 274.3 — `atom()` eats the closing bracket and drags away the
/// tail of the file). Until recovery is fixed in wave 2, signature
/// collection must not depend on it: a declaration is found wherever
/// it ended up.
fn harvest_in(n Node, defs DefTable, mut fns FnTable) -> () {
    match n {
        Leaf(_) => {}
        Branch { kind, children, .. } => {
            if kind == NodeKind.FnDecl {
                harvest_fn(children, defs, fns)
                return
            }
            for c in children {
                harvest_in(c, defs, fns)
            }
        }
    }
}

/// One declaration: receiver, name, return type. Taken only if BOTH
/// the receiver AND the return are already known to the registry —
/// otherwise the method does not enter the subset and gets an
/// honest rejection at the point of use.
fn harvest_fn(kids []Node, defs DefTable, mut fns FnTable) -> () {
    mut recv_name = ""
    mut mname = ""
    mut ret_name = ""
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Recv {
            recv_name = leaf_text(branch_children(c)[0])
        } else if ck == NodeKind.RetType {
            ro rk = branch_children(c)
            if rk.len() > 1 { ret_name = leaf_text(rk[1]) }
        } else if ck == NodeKind.LeafNode && mname == "" && recv_name != "" {
            if leaf_kind(c) == TokenKind.Ident { mname = leaf_text(c) }
        }
    }
    if recv_name == "" || mname == "" || ret_name == "" { return }
    ro recv_t = defs.type_id_opt(recv_name)
    ro ret_t = defs.type_id_opt(ret_name)
    if recv_t < 0 || ret_t < 0 { return }
    // A signature is valid only if ALL its types are known, including
    // its parameters. Otherwise std overloads would land in the table
    // as "one name twice" and get rejected as ambiguous: `str` has both
    // `@contains(needle str)` and `@contains(c char)` — the second is
    // not part of the subset, because `char` is unknown to the
    // registry. This way the TYPE system does the picking, not a list
    // of names.
    // Parameters are KEPT, receiver first: plan 273 order. They were merely
    // validated and dropped before (owner's check 2026-08-16), which left the
    // receiver as the only parameter novac remembered.
    mut param_ids = []int.new()
    param_ids.push(recv_t)
    for c in kids {
        if c.kind_of() != NodeKind.Param { continue }
        ro pk = branch_children(c)
        if pk.len() < 2 { return }
        if pk[1].kind_of() != NodeKind.LeafNode { return }
        ro pt = defs.type_id_opt(leaf_text(pk[1]))
        if pt < 0 { return }
        param_ids.push(pt)
    }
    fns.add(mname, ret_t, true, param_ids)
}

/// Build the semantic context: the file's types + methods from declarations.
export fn collect(file Node, decls []Node) -> Ctx {
    mut ctx = collect_types(file)
    harvest_methods(decls, ctx.defs, ctx.fns)
    ctx
}

/// The type and declaration registry of ONE file (without methods:
/// collect() brings those in from the signatures it read).
export fn collect_types(file Node) -> Ctx {
    mut types = []TypeDef.new()
    mut defs = DefTable.new()
    mut tys = Interner.new()
    // Pre-declared types come from the ONE builtins table (P5), in Prims
    // order; the seed hands the ACTUAL ids back (CommonTypes model). The
    // universe ordinal is the interner's head for a primitive.
    mut seeded = []int.new()
    mut ordinal = 0
    for bt in builtin_types() {
        seeded.push(seed(types, defs, tys, bt.name, ordinal))
        ordinal += 1
    }
    ro prims = Prims { int_id: seeded[0], str_id: seeded[1], bool_id: seeded[2], f64_id: seeded[3] }
    mut fields = FieldTable.new()
    mut variant_rows = []VariantDef.new()
    mut payload_types = []int.new()
    mut fns = FnTable.new()
    // First pass: register every type NAME (id = order of appearance after
    // the primitives), so later rows can reference any type of the file
    // regardless of declaration order. TypeDef records are BUILT on the
    // second pass, when their row ranges are known — passes walk the file
    // in the same order, so ids line up.
    mut next_id = types.len()
    for c in branch_children(file) {
        ro k = c.kind_of()
        if k == NodeKind.TypeDecl || k == NodeKind.SumDecl {
            ro nk = branch_children(c)
            if nk.len() > 1 && nk[1].kind_of() == NodeKind.LeafNode {
                // A DUPLICATE type name registers nothing: the first
                // declaration owns the DeclId, the second gets no row and no
                // id. Found by the fuzzer through the E2-b1 invariant assert
                // (a doubled file used to grow TWO rows for one name with the
                // second one orphaned under the first one's owner id — the
                // silent "last put wins" of DefTable.add). Reporting the
                // duplicate is check's job (a later wave); sem's job is to
                // not build a second truth for one name.
                if defs.type_id_opt(leaf_text(nk[1])) < 0 {
                    defs.add(leaf_text(nk[1]), DefKind.DefType, next_id)
                    next_id += 1
                }
            }
        }
    }
    for c in branch_children(file) {
        ro k = c.kind_of()
        if k == NodeKind.TypeDecl {
            ro tkids = branch_children(c)
            if tkids.len() < 2 { continue }
            if tkids[1].kind_of() != NodeKind.LeafNode { continue }
            ro tname = leaf_text(tkids[1])
            ro owner_id = defs.type_id_opt(tname)
            if owner_id < 0 { continue }
            // Only the declaration that OWNS the id builds the row: a later
            // duplicate resolves to the same id and must not push a second
            // row for it (that is what broke the ty_id == index invariant).
            if owner_id != types.len() { continue }
            ro off = fields.rows.len()
            mut cnt = 0
            for f in branch_children(c) {
                if f.kind_of() == NodeKind.Field {
                    ro fk = branch_children(f)
                    if fk.len() > 1 && fk[0].kind_of() == NodeKind.LeafNode && fk[1].kind_of() == NodeKind.LeafNode {
                        ro ft = defs.type_id_opt(leaf_text(fk[1]))
                        if ft >= 0 {
                            fields.add(owner_id, leaf_text(fk[0]), ft)
                            cnt += 1
                        }
                    }
                }
            }
            types.push(TypeDef { kind: TypeKind.TkRecord, ty_id: tys.record(owner_id), name: tname, row_off: off, row_cnt: cnt })
        }
        if k == NodeKind.SumDecl {
            ro skids = branch_children(c)
            if skids.len() < 2 { continue }
            if skids[1].kind_of() != NodeKind.LeafNode { continue }
            ro sname = leaf_text(skids[1])
            ro sum_id = defs.type_id_opt(sname)
            if sum_id < 0 { continue }
            if sum_id != types.len() { continue } // same rule as for records
            ro off = variant_rows.len()
            mut vcnt = 0
            for v in branch_children(c) {
                if v.kind_of() == NodeKind.Variant {
                    ro vk = branch_children(v)
                    // A variant with no name (recovery after a broken sum_id):
                    // skipped — check is the judge, sem does not fail (274.3/F-B4).
                    if vk.len() < 2 { continue }
                    if vk[1].kind_of() != NodeKind.LeafNode { continue }
                    ro vname = leaf_text(vk[1])
                    defs.add(vname, DefKind.DefVariant, variant_rows.len())
                    ro poff = payload_types.len()
                    mut pcnt = 0
                    // payload type names sit between '(' and ')'
                    mut j = 2
                    while j < vk.len() {
                        // [LEGACY-#676] var-index-method: `vk[j].kind_of()`
                        // with a VARIABLE index miscompiles in the oracle
                        // (E_RECV_METHOD_MISMATCH: receiver resolves as Vec;
                        // a constant index works). Found 2026-08-14; the
                        // binding hop is the workaround.
                        ro pj = vk[j]
                        if pj.kind_of() == NodeKind.LeafNode {
                            if leaf_kind(pj) == TokenKind.Ident {
                                ro pt = defs.type_id_opt(leaf_text(pj))
                                if pt >= 0 {
                                    payload_types.push(pt)
                                    pcnt += 1
                                }
                            }
                        }
                        j += 1
                    }
                    variant_rows.push(VariantDef { sum_id, name: vname, payload_off: poff, payload_cnt: pcnt })
                    vcnt += 1
                }
            }
            types.push(TypeDef { kind: TypeKind.TkSum, ty_id: tys.sum(sum_id), name: sname, row_off: off, row_cnt: vcnt })
        }
        if k == NodeKind.FnDecl {
            ro fk = branch_children(c)
            if fk.len() < 2 { continue }
            if fk[1].kind_of() != NodeKind.LeafNode { continue }
            // -1 sentinel = no declared return. Legal ONLY for main (check
            // refuses it elsewhere); backends ice on -1 as the second
            // floor — never a silent int (#652 class).
            mut ret = -1
            for r in fk {
                if r.kind_of() == NodeKind.RetType {
                    ro rk = branch_children(r)
                    if rk.len() > 1 && rk[1].kind_of() == NodeKind.LeafNode { ret = defs.type_id_opt(leaf_text(rk[1])) }
                }
            }
            // A file function is a callable with no receiver (plan 273):
            // same row shape as a read method signature, same table.
            ro fname = leaf_text(fk[1])
            mut param_ids = []int.new()
            for pn in fk {
                if pn.kind_of() != NodeKind.Param { continue }
                ro pk = branch_children(pn)
                mut pt = -1
                if pk.len() > 1 && pk[1].kind_of() == NodeKind.LeafNode {
                    pt = defs.type_id_opt(leaf_text(pk[1]))
                }
                param_ids.push(pt)
            }
            fns.add(fname, ret, false, param_ids)
            defs.add(fname, DefKind.DefFn, fns.rows.len() - 1)
        }
    }
    // E2-b1 INVARIANT, asserted, not assumed: while every type of the file is a
    // declaration with no arguments, the interner hands out ids in exactly the
    // order the declaration rows are pushed, so ty_id == declaration index for
    // every row. Everything downstream still speaks "type id = declaration
    // index" and is therefore ALREADY speaking in interned terms; the two
    // numbers part company the moment the first App is interned (E2-b2), and
    // this assert is what turns that moment into a loud one instead of a
    // silent skew. Costs one integer compare per row, once per file.
    for i in 0..types.len() {
        if types[i].ty_id != i { ice("sem: interned term id diverged from declaration index before E2-b2 — a type was interned out of declaration order") }
    }
    Ctx { types, tys, prims, defs, fields, variant_rows, payload_types, fns }
}

/// Children of a branch node; a leaf here is an invariant break.
export fn branch_children(n Node) -> []Node {
    match n {
        Leaf(_) => ice("sem: expected a branch node")
        Branch { children, .. } => children
    }
}

/// Token text of a leaf node; a branch here is an invariant break.
export fn leaf_text(n Node) -> str {
    match n {
        Leaf(t) => t.text
        Branch { .. } => ice("sem: leaf_text on a branch node")
    }
}

/// Token kind of a leaf node; a branch here is an invariant break.
export fn leaf_kind(n Node) -> TokenKind {
    match n {
        Leaf(t) => t.kind
        Branch { .. } => ice("sem: leaf_kind on a branch node")
    }
}

/// Node kinds that stand as expressions (argument/operand positions).
export fn is_expr_kind(k NodeKind) -> bool => k == NodeKind.Paren || k == NodeKind.Unary || k == NodeKind.Bin || k == NodeKind.Lit || k == NodeKind.Name || k == NodeKind.Call || k == NodeKind.MethodCall || k == NodeKind.FieldAccess || k == NodeKind.MatchExpr

/// First-leaf text of a Name-like node (its identifier).
export fn expr_leaf_name(e Node) -> str {
    ro kids = branch_children(e)
    leaf_text(kids[0])
}

/// Callee text of a Call node's children (leaf or Name-branch callee).
export fn call_callee_text(kids []Node) -> str {
    match kids[0] {
        Leaf(t) => t.text
        Branch { children, .. } => {
            match children[0] {
                Leaf(t) => t.text
                Branch { .. } => ""
            }
        }
    }
}
