// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem/typeref.nv -- reading TYPES and GENERICS out of the tree: the
// one reference door, the name resolvers, the generics readers.
//
// Donor: rustc `AstConv` (now HIR ty lowering) for the ROLE -- one place turns
//        written type syntax into type terms; taken as a seam, not as a design
//        (novac's subset reads four shapes, not a grammar of types). Go's
//        `typexpr.go` splits the same way.
// Role: layer 3 of the map (sem) -- every signature position (parameter,
//       return, std method) resolves its written type HERE, at collection;
//       check reads rows and never re-derives.
// Used by: the collector (sem.nv), the std reader (harvest.nv), the rules that
//          judge declaration shapes (check/rules.nv), protocols.
// Guarded by: check-novac-file-size.py (this file exists because slots.nv
//             crossed a thousand lines), the pipeline module tests (the
//             application test pins both spellings and both rotten shapes).
//
// A co-equal file of module `novac.sem` (folder = one module), split out of
// slots.nv by decision 12. The cut is by MEANING: slots.nv keeps the tree
// GEOMETRY doors (where is the name, the mode, the argument); this file owns
// what a written TYPE means.

module novac.sem

import ../tree.{Node, NodeKind}
import ../lex.{TokenKind}
import ../builtins.{SLICE_HEAD, SELF_TYPE, UNIT_TYPE_NAME}
import ../names.{DeclId, raw_decl}
import ../types.{TyId, no_ty, is_ty, same_ty, Interner}

/// A TYPE REFERENCE starting at `pk[at]`, resolved to a term -- including an
/// APPLICATION (step B2): `Vec[int]` is `app(vec_decl, [int])`, and `[]int` is
/// the same term through the D239 sugar (`[]T` IS `Vec[T]`).
///
/// ONE reading for every signature position (parameter, return, std method),
/// because the three readers each picked ONE leaf before this door existed --
/// and `[]Node` then read as the identifier `[]`, resolved to nothing, and the
/// refusal blamed the type ("does not know") instead of the shape.
///
/// `recv_t` is the receiver's type for `Self`, or `no_ty()` where no receiver
/// exists -- the same Self-is-a-role rule the method reader already holds.
///
/// TOLERANT like everything at collection: an unreadable shape answers
/// `no_ty()`, and check names the refusal at the point of use. What it reads
/// today, exhaustively: a plain identifier; `Self`; `Name[Args]` with IDENT
/// arguments of exactly the head's arity; `[]Elem` with an ident element.
/// Nested applications (`Vec[Vec[int]]`) answer `no_ty()` honestly -- the
/// argument reader takes identifiers only, and a bare head is not a type.
export fn ty_of_type_ref(pk []Node, at int, recv_t TyId, tps []str, param_rows []TyId,
                         types []TypeDef, defs DefTable, mut tys Interner) -> TyId {
    if at >= pk.len() { return no_ty() }
    // [LEGACY-#676] var-index-method: the binding hop, same as the readers this
    // door replaced.
    ro head = pk[at]
    if head.kind_of() != NodeKind.LeafNode { return no_ty() }
    // THE SLICE SUGAR FIRST: `[]Elem` has no head ident of its own -- the head
    // is the language's (D239), asked from the registry by its builtins name.
    if leaf_kind(head) == TokenKind.EmptyBrackets {
        if at + 1 >= pk.len() { return no_ty() }
        ro elem = ref_leaf_ty(pk[at + 1], recv_t, tps, param_rows, types, defs)
        return app_term_of(SLICE_HEAD, []TyId.of(elem), types, defs, tys)
    }
    if leaf_kind(head) != TokenKind.Ident { return no_ty() }
    // `Name[Args]`: the Generics branch, when written, stands right after the
    // head -- the parser keeps the pair adjacent.
    if at + 1 < pk.len() && pk[at + 1].kind_of() == NodeKind.Generics {
        mut args = []TyId.new()
        for nm in names_of_generics(branch_children(pk[at + 1])) {
            args.push(ty_of_type_name(nm, tps, param_rows, types, defs))
        }
        return app_term_of(leaf_text(head), args, types, defs, tys)
    }
    // A plain name: the reading every caller had before the door.
    ref_leaf_ty(head, recv_t, tps, param_rows, types, defs)
}

/// One identifier leaf of a type reference: `Self` is the receiver's type
/// spelled by role, everything else resolves by name.
fn ref_leaf_ty(c Node, recv_t TyId, tps []str, param_rows []TyId,
               types []TypeDef, defs DefTable) -> TyId {
    if c.kind_of() != NodeKind.LeafNode { return no_ty() }
    if leaf_kind(c) != TokenKind.Ident { return no_ty() }
    // `same_ty`, not `recv_t`: [LEGACY-#760-newtype-ro-launder].
    if leaf_text(c) == SELF_TYPE { return same_ty(recv_t) }
    ty_of_type_name(leaf_text(c), tps, param_rows, types, defs)
}

/// The application term of `head_name` over `args`, or `no_ty()` when the head
/// is unknown, not generic, of another arity, or an argument did not resolve.
///
/// The ARITY test is what keeps step B1's lid on: a head resolves ONLY through
/// an application of exactly its declared arity, so neither `Vec` bare nor
/// `Vec[int, str]` becomes a type by accident.
fn app_term_of(head_name str, args []TyId, types []TypeDef, defs DefTable,
               mut tys Interner) -> TyId {
    if Some(d) = defs.type_decl(head_name) {
        if raw_decl(d) >= types.len() { return no_ty() }
        if types[raw_decl(d)].tparam_cnt != args.len() { return no_ty() }
        if types[raw_decl(d)].tparam_cnt == 0 { return no_ty() }
        for a in args {
            if !is_ty(a) { return no_ty() }
        }
        tys.app(d, args)
    } else {
        no_ty()
    }
}

/// THE TYPE a type NAME denotes inside a declaration: its own type parameter if
/// the declaration binds that name, otherwise whatever the registry holds.
///
/// WAVE B6 WAS CANCELLED BY THE CRITERION AND BECAME THIS DOOR. The plan said
/// "wrap the tparam slot, 26 sites". The criterion from wave B4 -- an identity is
/// STORED -- said no: the slot is never a field of anything. It is produced by
/// `tparam_slot` and consumed on the next line by `param_rows[slot]`, every time,
/// which makes it a STEP.
///
/// And the step was written out TWICE, verbatim, in `collect_types` -- once for
/// the return type, once for each parameter. Two copies of one question is what a
/// missing door looks like from the inside (P18), so the question gets a name and
/// the slot goes back to being an implementation detail.
export fn ty_of_type_name(name str, tps []str, param_rows []TyId,
                          types []TypeDef, defs DefTable) -> TyId {
    if Some(slot) = tparam_slot(name, tps) {
        // `-> T` or `x T` names a type PARAMETER of THIS declaration, and that
        // is a real type: the term the interner made for that slot.
        param_rows[slot]
    } else {
        ty_or_none(types, defs, name)
    }
}

/// Which slot of `tps` this type name binds, or None when it is not a type
/// parameter of the declaration.
///
/// The question is asked while COLLECTING, before the callable has a row, so it
/// cannot go through `FnTable.tparam_index` -- same question, one step earlier,
/// and the list is the declaration's own arity (never the registry's size).
#realtime nogc
export fn tparam_slot(name str, tps []str) -> Option[int] {
    for i in 0..tps.len() {
        // BINDER-OK: the set is this declaration's own type parameters, so it
        // is bounded by its arity and not by any registry.
        if tps[i] == name {
            return Some(i)
        } else {
            // Not this slot; the next may bind the name.
        }
    }
    None
}

/// The identifier NAMES a `Generics` node holds, in source order.
///
/// ONE question with one answer, asked from both ends of the mapping: a
/// declaration reads its type PARAMETERS with it (`fn f[T, U]` binds T to slot
/// 0), and a call site reads its type ARGUMENTS (`f[int, str]` fills the same
/// slots). Writing it twice is what check-novac-second-door caught on
/// 2026-08-19 — two identical bodies in two modules, differing only in name.
///
/// Brackets and commas are leaves too (the tree is lossless), so only
/// identifier leaves are names.
export fn generic_names(kids []Node) -> []str {
    mut out = []str.new()
    for c in kids {
        if c.kind_of() != NodeKind.Generics { continue }
        out.append(names_of_generics(branch_children(c)))
    }
    out
}

/// The NAMES a generics list binds -- one per entry, and the entry's BOUND is
/// not one of them.
///
/// `[T]` binds T. `[T Compare]` binds T and CONSTRAINS it; `[K Equal + Hash, V]`
/// binds K and V. Until 2026-08-21 this walk took every identifier leaf, so a
/// bound was counted as a second type parameter: `fn pick[T Compare](a T)` was
/// registered as binding TWO, and the honest call `pick[int](3)` came back "the
/// call gives a different number of type arguments than the declaration binds"
/// -- a refusal that was a lie about a legal program, and the only way to
/// satisfy the count was to write nonsense (`pick[int, Compare]`).
///
/// The rule is positional and needs no knowledge of protocol names: the FIRST
/// identifier of each comma-separated entry is the parameter, everything after
/// it inside that entry is its bound.
export fn names_of_generics(gk []Node) -> []str {
    mut out = []str.new()
    mut expect_name = true
    for g in gk {
        if g.kind_of() != NodeKind.LeafNode { continue }
        ro k = leaf_kind(g)
        if k == TokenKind.Comma {
            // A new entry begins: its first identifier is a parameter again.
            expect_name = true
            continue
        }
        if k != TokenKind.Ident { continue }
        if expect_name {
            out.push(leaf_text(g))
            expect_name = false
        } else {
            // Inside an entry after its name: this is the BOUND (`Compare`, or
            // `Equal + Hash` -- the `+` is punctuation and never a name).
        }
    }
    out
}

/// The BOUND of each generics entry, one per parameter, `""` when the entry
/// declares none.
///
/// The mirror of `names_of_generics` and deliberately a SECOND door rather than
/// a second return value: the two answers are wanted in different places (the
/// names by everything that resolves a type argument, the bounds only by the
/// filter), and a pair return would make every existing caller carry a value it
/// does not use.
///
/// Positional, exactly like the names: the first identifier of an entry is the
/// parameter, the next identifier inside that entry is its bound. `[K Equal +
/// Hash]` answers `Equal` -- the second protocol of a `+` list is not read by
/// this wave, and the filter says so by name rather than pretending it checked.
export fn bounds_of_generics(gk []Node) -> []str {
    mut out = []str.new()
    mut expect_name = true
    mut have_bound = false
    for g in gk {
        if g.kind_of() != NodeKind.LeafNode { continue }
        ro k = leaf_kind(g)
        if k == TokenKind.Comma {
            if !have_bound {
                out.push("")
            } else {
                // This entry already contributed its bound.
            }
            expect_name = true
            have_bound = false
            continue
        }
        if k != TokenKind.Ident { continue }
        if expect_name {
            expect_name = false
            continue
        }
        if !have_bound {
            out.push(leaf_text(g))
            have_bound = true
        } else {
            // A second protocol in a `+` list, or the `consume` word: neither
            // is read here (the consume axis has its own door).
        }
    }
    if !expect_name && !have_bound {
        out.push("")
    } else {
        // Either no entry was open, or its bound is already recorded.
    }
    out
}

/// The TYPE a declaration's return declares, or `no_ty()` when it declares
/// none (legal for `main` only; the backends ice on absence rather than invent).
///
/// Two spellings, one door: `-> int` names a type, `-> ()` is punctuation. The
/// caller used to spell both out, which is how the unit could be missed in one
/// reader and not the other.
export fn ret_ty_of_decl(fk []Node, tps []str, param_rows []TyId,
                         types []TypeDef, defs DefTable, mut tys Interner) -> TyId {
    mut ret = no_ty()
    for r in fk {
        if r.kind_of() != NodeKind.RetType { continue }
        ro rk = branch_children(r)
        if ret_is_unit(rk) {
            ret = ty_of_type_name(UNIT_TYPE_NAME, tps, param_rows, types, defs)
            continue
        } else {
            // A named type: the identifier path below answers.
        }
        // The same door every signature position reads (step B2): `-> []Node`
        // and `-> Vec[int]` are applications, and a leaf-only read called the
        // brackets an identifier.
        ret = ty_of_type_ref(rk, 1, no_ty(), tps, param_rows, types, defs, tys)
    }
    ret
}

/// Does this return-type node declare the UNIT (`-> ()`)?
///
/// The parser leaves `(` and `)` as leaves, so the question is about tokens, not
/// about a name -- and it is asked in two places (the shape rule, which must not
/// call the unit a tuple, and the collector, which needs its type id), so it is
/// a door rather than two spellings of one test.
export fn ret_is_unit(rk []Node) -> bool {
    mut saw_lparen = false
    for c in rk {
        if c.kind_of() != NodeKind.LeafNode { continue }
        ro k = leaf_kind(c)
        if k == TokenKind.LParen {
            saw_lparen = true
            continue
        }
        if k == TokenKind.RParen {
            if saw_lparen {
                return true
            } else {
                // A closing paren with no opening one before it: recovery
                // debris, and the walk keeps looking.
                continue
            }
        }
        if k == TokenKind.Arrow { continue }
        // Anything else between the parens means this is not the unit.
        if saw_lparen { return false } else { continue }
    }
    false
}

/// The TYPE a protocol signature's parameter declares, or `no_ty()`.
///
/// A protocol signature carries no type parameters of its own in this wave, so
/// the resolution needs no substitution: the door that resolves a type NAME is
/// asked with an empty parameter list, and a name it does not know answers
/// absence rather than a guess.
export fn ty_of_param_node(pm Node, types []TypeDef, defs DefTable, tys Interner) -> TyId {
    mut seen_name = false
    for c in branch_children(pm) {
        if c.kind_of() != NodeKind.LeafNode { continue }
        if leaf_kind(c) != TokenKind.Ident { continue }
        if !seen_name {
            seen_name = true
            continue
        }
        return ty_of_type_name(leaf_text(c), []str.new(), []TyId.new(), types, defs)
    }
    no_ty()
}

/// The RETURN type a protocol signature declares, or `no_ty()` when it declares
/// none -- the absence is visible because the `RetType` node is absent, and the
/// checker names it instead of assuming a type.
export fn ty_of_ret_node(mk []Node, types []TypeDef, defs DefTable, tys Interner) -> TyId {
    for c in mk {
        if c.kind_of() != NodeKind.RetType { continue }
        for r in branch_children(c) {
            if r.kind_of() != NodeKind.LeafNode { continue }
            if leaf_kind(r) != TokenKind.Ident { continue }
            return ty_of_type_name(leaf_text(r), []str.new(), []TyId.new(), types, defs)
        }
    }
    no_ty()
}

/// The bounds of a declaration's generics list, `[]` when it has none.
export fn generic_bounds(kids []Node) -> []str {
    mut out = []str.new()
    for c in kids {
        if c.kind_of() != NodeKind.Generics { continue }
        out.append(bounds_of_generics(branch_children(c)))
    }
    out
}

/// Does a generics list constrain a parameter to be MUST-CONSUME
/// (`[T consume]`, `[T consume Compare]`)?
///
/// The full form of an entry is `T [consume] [Protocol + Protocol ...]` (owner,
/// 2026-08-21; measured: the oracle accepts `fn take[T consume](consume a T)
/// -> T => a`, and on a body that does NOT consume it answers
/// `[D156-strict-forget]` -- so the word constrains the PARAMETER, it is not a
/// protocol name). Two questions and two doors, because the two carry different
/// refusals: linearity is a gap of novac as a whole [INV-TODO: 274 9.1g.3]
/// (D133/D156 have no tracking; the plan owns the question and defers it to
/// E2-b3, and no registry number is invented here), a protocol bound waits for
/// dispatch (D122, E2-b3). One message for both
/// would name a cause that was not established (the D420 class).
export fn generics_have_consume(kids []Node) -> bool {
    for c in kids {
        if c.kind_of() != NodeKind.Generics { continue }
        for g in branch_children(c) {
            if g.kind_of() != NodeKind.LeafNode { continue }
            if leaf_kind(g) == TokenKind.KwConsume { return true }
        }
    }
    false
}

/// Does a generics list write a PROTOCOL bound (`[T Compare]`,
/// `[K Equal + Hash]`)?
///
/// Counted positionally: one identifier per entry is the bare shape, and the
/// mode word is not a bound -- so what is left over after the names and the mode
/// words is a protocol.
export fn generics_have_protocol_bound(kids []Node) -> bool {
    for c in kids {
        if c.kind_of() != NodeKind.Generics { continue }
        ro gk = branch_children(c)
        mut extra = 0
        mut entries = 1
        mut expect_name = true
        for g in gk {
            if g.kind_of() != NodeKind.LeafNode { continue }
            ro k = leaf_kind(g)
            if k == TokenKind.Comma {
                entries += 1
                expect_name = true
                continue
            }
            // The mode word is a KEYWORD now, so it never reaches the identifier
            // test below -- it constrains LINEARITY, not dispatch, and the door
            // above answers about it separately.
            if k != TokenKind.Ident { continue }
            if expect_name {
                expect_name = false
                continue
            }
            // After the name inside one entry: anything left is a protocol.
            extra += 1
        }
        if extra > 0 { return true }
    }
    false
}
