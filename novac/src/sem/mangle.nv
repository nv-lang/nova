// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem/mangle — THE mangling door: every C identifier a backend
// emits for a Nova entity comes from HERE, as a FUNCTION of the entity —
// never as a stored string (owner's verdict 2026-08-15 on C_VEC_INT_TYPE:
// a constant per type combination is the first member of an infinite
// series; the oracle's `Nova_Vec____nova_int*` is the VALUE of a mangling
// function at one point, and copying values instead of the function is the
// P1 class — a consumer recomputing a fact — turned into hard-coding it).
//
// Reference: rustc_symbol_mangling (v0: a deterministic function of the
// Instance), Go's types.LinkString. The rules below are the ORACLE'S
// (fixed point on its emission; primitives spell as nova_rt.h says);
// check-novac-mangle-fixed-point.sh judges them against the oracle's
// emission of the probe — the rules are held honest by diff, not by prose.
//
// Same module as sem.nv (folder = one module of co-equal files): the
// door reads the type registry it names.

module novac.sem

import ../diag.{ice}

/// C spelling of a type id: primitives by their runtime ABI name (a stored
/// fact of nova_rt.h), records and sums as GC pointers `Nova_<name>*`.
export fn c_type(ctx Ctx, t int) -> str {
    if t >= 0 && t < ctx.types.len() {
        ro td = ctx.types[t]
        match td.kind {
            TkPrim => { return td.c_name }
            TkRecord => { return "Nova_${td.name}*" }
            TkSum => { return "Nova_${td.name}*" }
            TkApp => { ice("mangle: c_type of an applied type — the instance door arrives with E2-b2") }
            TkParam => { ice("mangle: c_type of a type parameter — layout is asked before substitution") }
            TkInfer => { ice("mangle: c_type of an inference variable — a variable escaped its body") }
        }
    }
    ice("mangle: type id outside the registry — no silent int default (#652 class)")
    // [LEGACY-#677] never-in-tail: `ice() -> never` as the tail of a `-> str`
    // fn MIScompiles in the oracle, so the unreachable value stays. Removing
    // it passes `check` (tried 2026-08-16) — and that proves nothing, because
    // #677 is a codegen bug, not a checker one. It goes when #677 closes.
    ""
}

/// C name of a user type's struct (no pointer): `Nova_<name>`.
///
/// Same door discipline as `c_type`, and it was NOT the same until the
/// owner's review 2026-08-16: an id outside the registry fell into a bounds
/// panic instead of an honest `ice`, and the kind was tested by an if
/// instead of an exhaustive match, so a fourth kind would have been spelled
/// as a struct in silence (П21).
export fn c_struct(ctx Ctx, t int) -> str {
    if t < 0 || t >= ctx.types.len() {
        ice("mangle: struct name asked for a type id outside the registry")
    }
    ro td = ctx.types[t]
    match td.kind {
        TkPrim => { ice("mangle: a primitive has no struct name") }
        TkRecord => { return "Nova_${td.name}" }
        TkSum => { return "Nova_${td.name}" }
        TkApp => { ice("mangle: struct name of an applied type — the instance door arrives with E2-b2") }
        TkParam => { ice("mangle: struct name of a type parameter — no layout before substitution") }
        TkInfer => { ice("mangle: struct name of an inference variable — a variable escaped its body") }
    }
    // [LEGACY-#677] never-in-tail: same unreachable pacifier as in c_type —
    // one arm ends in `ice() -> never`, which is the miscompiling shape.
    ""
}

/// C name of a sum's tag constant for a variant: `NOVAC_TAG_<Sum>_<Variant>`
/// (novac's own namespace for user sums — the oracle's NOVA_TAG_ is its).
export fn c_tag(ctx Ctx, vrow int) -> str {
    ro vd = ctx.variant_rows[vrow]
    "NOVAC_TAG_${ctx.types[vd.sum_id].name}_${vd.name}"
}

/// C name of a variant's maker function: `novac_make_<Sum>_<Variant>`.
export fn c_maker(ctx Ctx, vrow int) -> str {
    ro vd = ctx.variant_rows[vrow]
    "novac_make_${ctx.types[vd.sum_id].name}_${vd.name}"
}

/// C name of a method call on a receiver type: the oracle's shape is
/// `<Recv>_method_<name>` where <Recv> is the receiver's C base spelling
/// (`Nova_str` for str). Only str receivers exist in the subset today; the
/// rule generalizes with the registry (records: `Nova_<name>`).
export fn c_method(ctx Ctx, recv_t int, name str) -> str {
    ro td = ctx.types[recv_t]
    match td.kind {
        TkPrim => { return "Nova_${td.name}_method_${name}" }
        TkRecord => { return "Nova_${td.name}_method_${name}" }
        TkSum => { return "Nova_${td.name}_method_${name}" }
        TkApp => { ice("mangle: method name on an applied receiver — the instance door arrives with E2-b2") }
        TkParam => { ice("mangle: method name on a type parameter — resolution happens on the head, not here") }
        TkInfer => { ice("mangle: method name on an inference variable — a variable escaped its body") }
    }
}

/// C name of a user function. TWO prefixes on purpose (owner's question
/// 2026-08-16), because they answer to two different owners:
/// * `nova_fn_main_impl` is not ours to choose — it is the RUNTIME's entry
///   slot, called by the shell, so it is spelled exactly as the oracle
///   spells it. An ABI fixed point, held by the shell-freshness guard.
/// * `novac_user_<name>` is novac's OWN namespace, deliberately unlike the
///   oracle's `nova_fn_<mangled>`, so novac's output can never collide with
///   a runtime or std symbol. Same reason `c_tag` says `NOVAC_TAG_` and
///   `c_maker` says `novac_make_`.
export fn c_fn(name str, is_entry bool) -> str {
    if is_entry { return "nova_fn_main_impl" }
    "novac_user_${name}"
}
