// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_symbol_mangling` — a symbol name is a deterministic
// Role: the mangling door — every C identifier is a function of the entity, one-way (П24).
// Used by: emit_c only (E1+); mono at E2-b2 makes it a function of (decl, args); the shell-freshness guard holds
// primitives to the ABI.
// Guarded by: check-novac-mangling-one-way.py (no C name is ever parsed back), check-novac-mangle-fixed-point.sh
// (primitive spellings match the oracle ABI), check-novac-no-name-hardcode.py.
// FUNCTION of the entity, computed at the door, never stored and never parsed
// back; NOT taken: the v0 grammar itself (our names must match nova_rt.h ABI
// for primitives, so the spelling is the oracle's fixed point, П25).
// novac/src/sem/mangle — THE mangling door: every C identifier a backend
// emits for a Nova entity comes from HERE, as a FUNCTION of the entity —
// never as a stored string (owner's verdict 2026-08-15 on C_VEC_INT_TYPE:
// a constant per type combination is the first member of an infinite
// series; the oracle's `Nova_Vec____nova_int*` is the VALUE of a mangling
// function at one point, and copying values instead of the function is the
// P1 class — a consumer recomputing a fact — turned into hard-coding it).
//
// Reference: rustc_symbol_mangling (v0: a deterministic function of the
// Instance), Go's types.LinkString. The rules below are the ORACLE'S
// (fixed point on its emission; primitives spell as nova_rt.h says);
// check-novac-mangle-fixed-point.sh judges them against the oracle's
// emission of the probe — the rules are held honest by diff, not by prose.
//
// Same module as sem.nv (folder = one module of co-equal files): the
// door reads the type registry it names.

module novac.sem

import ../diag.{ice_at}
import ../names.{raw_decl, DeclId, is_decl}
import ../builtins.{prim_c_name, is_runtime_abi_sum, prim_name}
import ../builtins.{PAREN_RECORD_C_PREFIX, HANDLER_CTOR, TypeKind, EMPTY_CTOR}
import ../types.{TyId, is_ty}

/// The REPRESENTATION of a newtype: the type it is laid out as.
///
/// One level, never a chain: `type A B` over `type B int` gives `A` the
/// representation `B`, and asking again peels the next. Callers that need the
/// LAYOUT ask through `c_type`, which recurses, so no caller has to know how
/// deep it goes. The representation rides in the interner's args -- the same
/// pool an application's arguments use, because it IS an argument of the term.
export fn representation_of(ctx Ctx, t TyId) -> TyId
    requires is_ty(t), "mangle: representation asked for `no type`"
    requires ctx.tys.arg_count(t) == 1, "mangle: a newtype term without exactly one representation argument"
{
    // The TERM answers, not the declaration row: the representation is an
    // argument of the term itself (wave B8 -- before it, this door went through
    // the declaration table to read a fact the interner already held).
    ctx.tys.arg(t, 0)
}

/// The type a value is CARRIED as: newtypes peeled, everything else itself.
///
/// A newtype is distinct for RESOLUTION and identical for REPRESENTATION, so the
/// two questions get two doors: `type_tag` keeps the distinction in a C name,
/// and this one answers "what does the runtime actually hold". The printer asks
/// it -- `println(Row(7))` prints 7, which is what the oracle does -- and so
/// does any consumer that cares about the value rather than the name.
///
/// A loop and not one step: `type A B` over `type B int` peels twice.
export fn carrier_of(ctx Ctx, t TyId) -> TyId {
    mut cur = t
    // Bounded by the number of declarations: each step moves to the
    // representation of a DIFFERENT declaration, and a cycle among them is a
    // shape the checker refuses before this door is ever asked.
    mut steps = 0
    while steps <= ctx.types.len() {
        if !is_ty(cur) { return cur }
        ro is_new = match ctx.tys.kind_of(cur) {
            TkNewtype => true
            // TkEffect: an effect is not a newtype -- the peel stops here.
            TkPrim | TkRecord | TkSum | TkApp | TkParam | TkInfer | TkTuple | TkEffect | TkPtr => false
        }
        if !is_new { return cur }
        cur = representation_of(ctx, cur)
        steps += 1
    }
    ice_at(
        "novac/src/sem/mangle.nv:79",
        "mangle: a newtype chain longer than the registry -- a cycle reached the carrier door")
}

/// A4: is this sum emitted BY VALUE (`NovaValue_<X>`) instead of as a heap
/// `Nova_<X>*`? The rule is the ORACLE's, taken word for word from plan 172.14
/// F.2 atom A4 (`compiler-codegen/src/codegen/emit_c/sum_placement.rs`, merge
/// `efbe73ff5`): payload-less, non-generic, unfenced, not runtime-pinned.
///
/// Payload-less means ZERO inline edges, so such a sum is non-recursive by
/// construction and no recursion detector is consulted -- the donor states the
/// same consequence in the same words.
///
/// GENERICS are out of the subset BY CONSTRUCTION, not by check: an applied
/// type ices in `c_type` ("arrives with E2-b2"), so a generic sum cannot reach
/// emission at all. When E2-b2 lands, the parameter test joins this door.
export fn is_value_sum(ctx Ctx, t TyId) -> bool => is_payload_free_sum(ctx, t) && !ctx.tys.is_arg_anywhere(t)

/// Is this a PAYLOAD-FREE sum of the file's own kind (not a runtime-pinned one)
/// -- the A4 question WITHOUT the fence? Its value is its tag wherever it is
/// placed, so `==` on it compares tags; the fence (an argument of an
/// application keeps it on the heap) decides only how the tag is READ, `.` or
/// `->`. Split out of `is_value_sum` on 2026-10-01: the two questions were one,
/// and every `==` on a fenced enum -- 279 of novac's own in parse/, `@peek() ==
/// TokenKind.X` beside a `[]TokenKind` -- was refused as protocol dispatch.
export fn is_payload_free_sum(ctx Ctx, t TyId) -> bool {
    if !is_ty(t) { return false }
    match ctx.tys.kind_of(t) {
        TkSum => {}
        // TkEffect: an effect is not a sum -- the A4 question answers false.
        TkPrim | TkRecord | TkApp | TkParam | TkInfer | TkNewtype | TkTuple | TkEffect | TkPtr => { return false }
    }
    ro td = decl_of_ty(ctx, t)
    if is_runtime_abi_sum(td.name) { return false }
    ro vr = variant_range_of(td) ?? (no_vrow(), 0)
    if vr.1 == 0 { return false }
    ro vstart = raw_vrow(vr.0)
    for v in vstart..(vstart + vr.1) {
        if ctx.variant_rows[v].payload_cnt != 0 { return false }
    }
    true
}

/// The type's SOURCE name, for a message a person reads (`int`, not `nova_int`).
///
/// Primitives answer through the universe (a primitive names no declaration --
/// its head is an ordinal, wave B8), everything nominal through its declaration
/// row. The three remaining kinds cannot stand where this door is asked -- a
/// call argument and a protocol signature are both concrete by then -- so they
/// answer with a WORD rather than an ice [INV-PROPERTY]: every arm returns a
/// string, so there is no path from this door to a crash -- the invariant is
/// held by the exhaustive match, not by anyone remembering P12.
///
/// Lives here and not in `check` because two callers want it: the deduction
/// conflict message and the unsatisfied-bound message (P18 -- one question, one
/// door).
export fn ty_source_name(ctx Ctx, t TyId) -> str {
    if !is_ty(t) { return "an unreadable type" }
    match ctx.tys.kind_of(t) {
        TkPrim => prim_name(ctx.tys.prim_ordinal_of(t))
        // TkEffect: the term reuses the Record interning (E4 wave), so the head
        // IS a declaration and the name answers through it like any nominal's.
        TkEffect => decl_of_ty(ctx, t).name
        TkRecord => decl_of_ty(ctx, t).name
        TkSum => decl_of_ty(ctx, t).name
        TkNewtype => decl_of_ty(ctx, t).name
        TkApp => instance_source_name(ctx, t)
        TkParam => "a type parameter"
        TkTuple => anon_record_source_name(ctx, t)
        TkInfer => "an inference variable"
        // A POINTER reads as written: `*mut T` / `*T`.
        TkPtr => {
            ro under = ty_source_name(ctx, ctx.tys.arg(t, 0))
            if ctx.tys.ptr_is_mut(t) { "*mut ${under}" } else { "*${under}" }
        }
    }
}

/// `(int, str)`: a tuple spelled as the source spells it. "a tuple" against
/// "a tuple" told the reader of a return mismatch nothing (measured 2026-09-05
/// on `fn pair() -> (int, str) => (1, 2)`, wave W3): the components ARE the
/// difference, so they are what the sentence names.
fn anon_record_source_name(ctx Ctx, t TyId) -> str {
    consume s = StringBuilder.new(cap: 32)
    s.append("(")
    for i in 0..ctx.tys.arg_count(t) {
        if i > 0 {
            s.append(", ")
        } else {
            // The first component has nothing before it to separate from.
        }
        s.append(ty_source_name(ctx, ctx.tys.arg(t, i)))
    }
    s.append(")")
    s
}

/// `Vec[int]`, `Opt[str]`: the head's declared name and its arguments as the
/// source would spell them. A refusal that says "a generic instance" sends the
/// reader nowhere; one that says `Opt[int]` names the line to change.
fn instance_source_name(ctx Ctx, t TyId) -> str {
    consume s = StringBuilder.new(cap: 32)
    s.append(decl_of_ty(ctx, t).name)
    s.append("[")
    for i in 0..ctx.tys.arg_count(t) {
        if i > 0 {
            s.append(", ")
        } else {
            // The first argument has nothing before it to separate from.
        }
        s.append(ty_source_name(ctx, ctx.tys.arg(t, i)))
    }
    s.append("]")
    s
}

/// C name of a sum's TAG ENUM: always `Nova_<X>_Tag`, whether the sum is a
/// value or a pointer. The oracle names the tag enum off the TYPE's name even
/// when the value struct is `NovaValue_<X>` -- measured in the fresh shell,
/// `novac/src/emit_c/shell.tpl.c:56-58`. `<X>` is the D381 base (`type_base`).
export fn c_tag_enum(ctx Ctx, t TyId) -> str => "Nova_${type_base(ctx, t)}_Tag"

/// D381 -- THE BASE of a nominal type's C name: the declared name, or
/// `<modpath>_<name>` when the name COLLIDES in the unit. The oracle's single
/// point (`def_type_base`/`ref_type_base`, spec 08-runtime.md D381, its
/// single-point paragraph): every spelling of a user struct, tag enum and
/// in-name argument goes through it. A name that does not collide comes back
/// unchanged, so a unit without a collision is byte-identical (D381 rejects
/// always-qualify).
fn type_base(ctx Ctx, t TyId) -> str => decl_base(ctx, ctx.tys.decl_head_of(t))

/// D381 -- does the SHELL already define a struct BODY under one of this
/// name's C spellings? The collision set of OUR unit: the shell is the
/// oracle's emission of the probe, where std's types are spelled BARE, and it
/// is glued into every unit we emit -- so a program type of that name is the
/// second declaration of one simple name in the unit (what D381 calls colliding),
/// and the std side cannot be renamed (interop). Both spellings, because a
/// value record or a payload-free sum comes out as `NovaValue_`.
fn shell_defines_struct(ctx Ctx, name str) -> bool =>
    ctx.interop.has_body("Nova_${name}") || ctx.interop.has_body("NovaValue_${name}")

/// D381 -- the C base of declaration `d`. Measured on the oracle 2026-10-06
/// (plan 274.5 section pre68): a user `ErrorKind` beside std.io's in one unit
/// is `Nova_p3_ErrorKind`, and `Nova_ErrorKind` when nothing collides.
///
/// COLLIDING is a NAME fact, as in D381 ("a simple name declared in two
/// modules"): a type of the PROGRAM whose name the shell already spells. Every
/// shape of it is qualified -- the oracle's D381 stops at plain-Sum and
/// heap-Record and fails the rest in clang (value record, newtype, generic:
/// registry 221.1 #1765), but a spelling is not a language rule, and a
/// program D125 makes legal is compiled whatever its shape. A newtype has no C
/// name of its own (its representation's), and a generic head is named by the
/// mono path, which the subset does not compile yet (E2-b2).
///
/// THE DEF MODULE, not the module of the file asking (D381's module
/// resolution): the file's own row takes the file's module, a handed row of a
/// program module its home -- `novac.lex`'s `Token` is `Nova_novac_lex_Token`
/// in every unit naming it -- and a handed row of std is the shell's and keeps
/// the name. A file with NO module takes D381's formula with an empty modpath,
/// `Nova__<Name>`: the oracle collapses that to the bare name, which in our
/// unit IS the shell's struct, and a type name never starts with `_` (D30), so
/// the doubled separator cannot meet a bare name.
fn decl_base(ctx Ctx, d DeclId) -> str
    requires is_decl(d) && raw_decl(d) < ctx.types.len(), "mangle: the C base of a declaration outside the registry"
{
    ro td = ctx.types[raw_decl(d)]
    if !shell_defines_struct(ctx, td.name) { return td.name }
    if raw_decl(d) >= ctx.foreign_types_cnt { return "${ctx.module_c}_${td.name}" }
    match handed_type_home(ctx, d, td.name) {
        Some(home) => if home != "" && ctx.interop.has_module(home) {
            "${home.replace(".", "_")}_${td.name}"
        } else {
            td.name
        }
        // No row registers the declaration: nothing to qualify it by, the shell keeps it.
        None => td.name
    }
}

/// The module a HANDED type declaration came from: the `DefTable` home of the
/// row registering it, found along the chain of same-named rows (#1521), None
/// when no row names it.
fn handed_type_home(ctx Ctx, d DeclId, name str) -> Option[str] {
    mut i = ctx.defs.first_def(name)
    while i >= 0 {
        ro hit = match ctx.defs.def_at(i).target {
            DefType(id) => id == d
            DefFn(_) | DefConst(_) => false
        }
        if hit { return Some(ctx.defs.home_at(i)) }
        i = ctx.defs.prev_def(i)
    }
    None
}

/// The module part of one of OUR names: the path plus a separator, or `""`.
///
/// A door and not `"${ctx.module_c}_"` at three call sites, because the EMPTY
/// case is the whole question: a file with no module declaration must add
/// nothing at all, and a trailing separator would make `novac_fn__helper` -- a
/// name with a hole where the identity is missing, which is exactly what a
/// reader would then have to know not to trust.
///
/// WHAT DOES NOT GET IT, and this is interop rather than an exception: the C
/// STRUCT names (`Nova_<name>`). Our emission is glued into the oracle's shell
/// (274 section 7.0), the shell declares those types, and a name we invent there
/// would not be the type the shell knows. They stay until novac emits the whole
/// prelude itself -- the same end condition every other interop line carries.
fn module_prefix(ctx Ctx) -> str {
    if ctx.module_c == "" { return "" }
    "${ctx.module_c}_"
}

/// The module prefix of a CALLABLE: the module of the ROW -- the file's for its
/// own rows, the handed file's (`handed_from`) for a handed one -- so every unit
/// that calls it names one symbol (274.11 E.10 step 1).
fn row_module_prefix(ctx Ctx, fd FnDef) -> str =>
    if fd.handed_from == "" { module_prefix(ctx) } else { "${fd.handed_from.replace(".", "_")}_" }

/// Is this type a record DECLARED `value`?
///
/// A predicate over the stored word, not over the shape: a record's layout is
/// what the source says, unlike a sum's, whose value-ness `is_value_sum` DERIVES
/// from having no payloads (A4). One door, so the three readers -- the C type,
/// the struct name and the emission of a construction -- cannot disagree.
export fn is_value_record(ctx Ctx, t TyId) -> bool {
    // DELEGATES: one door answers the shape, the booleans are readings of it.
    // Two doors each with their own exhaustive kind-match were the shape of a
    // second door (P18) -- and the guard of the word rule counted the second
    // match as growth, which is how it was found.
    match shape_of(ctx, t) {
        Record => false
        ValueRecord | NamedTuple | PositionalTuple | AnonNamedTuple | AnonPositionalTuple => true
    }
}

/// THE shape of a type's declaration -- the one door, and the only place that
/// gates on the kind. A boolean wrapper per shape is NOT written: the owner's
/// rule (2026-09-03) is that a caller compares with the variant's own name,
/// which the word rule allows, and a wrapper would be a second door needing a
/// periphrasis for a name it may not spell. `is_value_record` stays because it
/// answers a DIFFERENT question -- placement, asked by ten sites -- not a
/// rephrasing of one variant. A type that declares no record answers `Record`: the
/// shape field is dead for it, and `Record` is the reading every caller of the
/// booleans above already expects for a non-record (heap, no inline layout).
export fn shape_of(ctx Ctx, t TyId) -> RecordShape {
    if !is_ty(t) { return RecordShape.Record }
    match ctx.tys.kind_of(t) {
        TkRecord => decl_of_ty(ctx, t).shape
        // A STRUCTURAL tuple term IS the anonymous shape -- it lives on the
        // stack exactly as the declared forms do. Answering `Record` here (the
        // first version did) meant "on the heap", which is false about a tuple
        // and was invisible only because the tuple had a door of its own.
        TkTuple => RecordShape.AnonPositionalTuple
        // TkEffect: an effect is not a record -- it takes the same "declares no
        // record" default as the rest of the residual group.
        TkPrim | TkSum | TkNewtype | TkApp | TkParam | TkInfer | TkEffect | TkPtr => RecordShape.Record
    }
}

/// The LAYOUT of a type's C spelling, decided once: the spelling without its
/// star, and whether the star is written. Split out of `c_type` on 2026-10-01
/// (the integrator's decision on check-novac-mangling-one-way) so that "is it a
/// pointer" and "how is it written inside a name" are answered from the SAME
/// match that writes the star, instead of by editing the string it produced.
type CLayout value {
    /// The spelling without the star: `Nova_Rec`, `nova_int`, `NovaRes_..._IoError`.
    base str
    /// Whether `c_type` writes a star after it -- the type lives behind a pointer.
    by_ptr bool
}

/// C spelling of a type id: primitives by their runtime ABI name (a stored
/// fact of nova_rt.h), records and sums as GC pointers `Nova_<name>*`.
export fn c_type(ctx Ctx, t TyId) -> str {
    ro l = c_layout(ctx, t)
    if l.by_ptr { "${l.base}*" } else { l.base }
}

/// The match `c_type` reads: every kind's spelling and whether it is a pointer.
fn c_layout(ctx Ctx, t TyId) -> CLayout {
    if is_ty(t) {
        // THE KIND COMES FROM THE INTERNER (wave B8). It used to come from the
        // declaration row, which meant every question about a type went through
        // the declaration table -- and a PRIMITIVE has no declaration to go
        // through. The row is reached for below only where the NAME is wanted.
        match ctx.tys.kind_of(t) {
            // A universe fact by ordinal, read off the term.
            TkPrim => { return CLayout { base: prim_c_name(ctx.tys.prim_ordinal_of(t)), by_ptr: false } }
            // A VALUE RECORD IS NOT A POINTER, and that is the whole meaning of
            // the word: it lives inline, so a copy is a copy. Measured against
            // the fixed point (2026-08-23): `ro b = a` on a value record must
            // leave `b` unchanged when `a` is written to, and emitting the
            // pointer form made the copy an alias. The oracle's own shape is
            // `struct NovaValue_<name>` by value, with only a RECEIVER taken as
            // a pointer (shell.tpl.c, `NovaValue_CharsIter*`).
            // The shape decides both the prefix and whether a pointer is
            // written: only a plain record lives on the heap (see c_struct).
            TkRecord => {
                // A PROTOCOL-typed value is laid out as its implementor (interop
                // pair, `impl_of_proto`): `mut f Fmt` is `Nova_FmtCtx* f`.
                ro it = impl_of_proto(ctx, t)
                return match shape_of(ctx, it) {
                    Record => CLayout { base: "Nova_${type_base(ctx, it)}", by_ptr: true }
                    ValueRecord => CLayout { base: "NovaValue_${type_base(ctx, it)}", by_ptr: false }
                    NamedTuple | PositionalTuple | AnonNamedTuple | AnonPositionalTuple =>
                        CLayout { base: "${PAREN_RECORD_C_PREFIX}${type_base(ctx, it)}", by_ptr: false }
                }
            }
            // A4: payload-less unfenced sums are VALUES, as the oracle emits them.
            TkSum => {
                ro nm = type_base(ctx, t)
                if is_value_sum(ctx, t) { return CLayout { base: "NovaValue_${nm}", by_ptr: false } }
                return CLayout { base: "Nova_${nm}", by_ptr: true }
            }
            // A NEWTYPE is a distinct TYPE with the representation's LAYOUT, so
            // its C spelling is the representation's -- zero cost, and what the
            // oracle emits too (`typedef nova_int Nova_Row;` and then a plain
            // `nova_int` local; measured 2026-08-21). The DISTINCTION lives in
            // the registry and in `type_tag`, never in the layout.
            TkNewtype => { return c_layout(ctx, representation_of(ctx, t)) }
            // An INSTANCE of a generic record is a GC pointer like the record
            // itself; its struct is spelled the oracle's way (interop -- see
            // `instance_struct_name`).
            TkApp => {
                // A HANDLER VALUE (`Effect[Os]`) is the shell's vtable pointer for
                // its effect -- INTEROP, the oracle's `NovaVtable_Os*` (E.9 step 2):
                // the table and its registration live in the shell, novac only
                // holds and installs the pointer.
                ro eff = handled_effect_name(ctx, t)
                if eff != "" { return CLayout { base: effect_vtable_c(eff), by_ptr: true } }
                ro fam = family_instance_name(ctx, t)
                if fam != "" { return CLayout { base: fam, by_ptr: family_by_pointer(ctx, t) } }
                return CLayout { base: instance_struct_name(ctx, t), by_ptr: true }
            }
            TkParam => { ice_at(
                "novac/src/sem/mangle.nv:415",
                "mangle: c_type of a type parameter — layout is asked before substitution") }
            TkInfer => { ice_at(
                "novac/src/sem/mangle.nv:418",
                "mangle: c_type of an inference variable — a variable escaped its body") }
            // TkEffect: unreachable while the with-doors refuse non-handler values;
            // ice, not a fallback (E4 wave). Effect types get a C spelling with the
            // Effect-type stage, not by masquerading as a record pointer here.
            TkEffect => { ice_at(
                "novac/src/sem/mangle.nv:424",
                "mangle: c_type of an EFFECT type — effect values are typed by with-doors, which are not built yet (E4 wave)") }
            // A tuple is a BY-VALUE mono struct (D123): its C type IS its
            // struct name, no pointer -- the same word `value` means on a
            // record, and the shell's own pair typedefs are structs by value.
            TkTuple => { return CLayout { base: mono_tuple_name(ctx, t), by_ptr: false } }
            // A POINTER is its pointee's C type with a star -- `*mut T` is `T*`,
            // `*T` is `const T*` (the oracle's spelling, read off the shell:
            // `copy_n_nonoverlapping(const nova_int* src, nova_int* dst, ..)`).
            TkPtr => {
                ro under = c_type(ctx, ctx.tys.arg(t, 0))
                return CLayout { base: if ctx.tys.ptr_is_mut(t) { under } else { "const ${under}" }, by_ptr: true }
            }
        }
    }
    ice_at("novac/src/sem/mangle.nv:440", "mangle: type id outside the registry — no silent int default (#652 class)")
}

/// C name of a user type's struct (no pointer): `Nova_<name>`.
///
/// Same door discipline as `c_type`, and it was NOT the same until the
/// owner's review 2026-08-16: an id outside the registry fell into a bounds
/// panic instead of an honest `ice`, and the kind was tested by an if
/// instead of an exhaustive match, so a fourth kind would have been spelled
/// as a struct in silence (П21).
export fn c_struct(ctx Ctx, t TyId) -> str {
    if !is_ty(t) {
        ice_at("novac/src/sem/mangle.nv:452", "mangle: struct name asked for `no type`")
    }
    match ctx.tys.kind_of(t) {
        TkPrim => { ice_at("novac/src/sem/mangle.nv:455", "mangle: a primitive has no struct name") }
        TkPtr => { ice_at(
            "novac/src/sem/mangle.nv:456",
            "mangle: a pointer has no struct name -- it is its pointee's type with a star") }
        // THE SHAPE decides the prefix, and all three spellings are the
        // ORACLE's, measured off its own emission (P25 -- the fixed point of
        // behaviour, and here of the interop name): a plain record is
        // `Nova_X`, a `value` record `NovaValue_X`, and the parenthesised
        // form `NovaTuple_X` (read 2026-09-03 from the oracle's C for
        // `type Pair(x int, y int)`: `struct NovaTuple_Pair { nova_int x;
        // nova_int y; }` -- members BY FIELD NAME, no positional f0/f1).
        TkRecord => match shape_of(ctx, t) {
            Record => "Nova_${type_base(ctx, t)}"
            ValueRecord => "NovaValue_${type_base(ctx, t)}"
            NamedTuple | PositionalTuple | AnonNamedTuple | AnonPositionalTuple =>
                "${PAREN_RECORD_C_PREFIX}${type_base(ctx, t)}"
        }
        TkSum => {
            if is_value_sum(ctx, t) { return "NovaValue_${type_base(ctx, t)}" }
            return "Nova_${type_base(ctx, t)}"
        }
        // Same rule as `c_type`: the STRUCT of a newtype is the
        // representation's, because that is what it is laid out as.
        TkNewtype => { return c_struct(ctx, representation_of(ctx, t)) }
        TkApp => {
            ro fam = family_instance_name(ctx, t)
            if fam != "" { return fam }
            return instance_struct_name(ctx, t)
        }
        TkParam => { ice_at(
            "novac/src/sem/mangle.nv:484",
            "mangle: struct name of a type parameter — no layout before substitution") }
        TkInfer => { ice_at(
            "novac/src/sem/mangle.nv:487",
            "mangle: struct name of an inference variable — a variable escaped its body") }
        // TkEffect: unreachable while the with-doors refuse non-handler values;
        // ice, not a fallback (E4 wave). An effect owns operation rows, not a C
        // struct.
        TkEffect => { ice_at(
            "novac/src/sem/mangle.nv:493",
            "mangle: struct name of an EFFECT type — an effect declares no C struct; with-doors refuse non-handler values (E4 wave)") }
        // The typedef is self-named (`typedef struct X {...} X;`), so the
        // struct name and the C type are the one string.
        TkTuple => { return mono_tuple_name(ctx, t) }
    }
}

/// INTEROP -- the ORACLE's spelling of a generic INSTANCE, and this door says so
/// out loud (P27 p.2a): `Nova_<Head>____<arg>__<arg>` for a RECORD head, each
/// argument spelled as the oracle spells a type INSIDE a name. Measured off
/// shell.tpl.c 2026-08-26, not guessed: `Nova_Vec____Nova_EmbeddedEntry_p`,
/// `Nova_Vec____Nova_Slot____nova_int__nova_unit_p`, `NovaOpt_NovaValue_Utf8Error`.
///
/// WHY THE ORACLE'S SPELLING AND NOT OURS: one type, one C name (274 section
/// 7.0). Our emission is glued into the oracle's shell, and an instance the
/// shell already lays out must be the SAME struct -- two spellings of `Vec[int]`
/// are two structs, and the linker is where that is found. END CONDITION: the day
/// novac emits the whole prelude, the instance is ours and this door spells it
/// our way (`novac_` prefix, P24); until then it is interop and named as such.
///
/// A SUM head (`Option[T]`, `Result[T, E]`) has a FAMILY spelling of its own in
/// the oracle (`NovaOpt_...`, `NovaRes_...`) -- measured, and deliberately NOT
/// taken here: it arrives with the Option wave, and the ice names that instead
/// of guessing a name a linker would then find. No program reaches it today: an
/// instance of a handed-over sum cannot be constructed (its variants are not
/// harvested), so nothing carrying one is ever emitted.
/// The EFFECT a handler type `Effect[E]` handles, or "" for any other type.
export fn handled_effect_name(ctx Ctx, t TyId) -> str {
    if ctx.tys.kind_of(t) != TypeKind.TkApp { return "" }
    if decl_of_ty(ctx, t).name != HANDLER_CTOR { return "" }
    if ctx.tys.arg_count(t) != 1 { return "" }
    decl_of_ty(ctx, ctx.tys.arg(t, 0)).name
}

/// THE C NAMES OF AN EFFECT'S RUNTIME PIECES -- all three are the shell's
/// (interop, E.9 step 2): the vtable struct an `Effect[E]` points at, the
/// thread slot a `with` installs into (`_nova_handler_E`), and the dispatcher
/// an operation call goes through (`Nova_E_op`, which runs the installed
/// handler or the effect's `#default_handler`). One door each, so a `with`
/// and an operation call cannot spell the same slot two ways.
export fn effect_vtable_c(eff str) -> str => "NovaVtable_${eff}"

/// The thread slot of the installed handler of `eff` -- see `effect_vtable_c`.
export fn effect_slot_c(eff str) -> str => "_nova_handler_${eff}"

/// The shell's dispatcher of operation `op` of `eff` -- see `effect_vtable_c`.
export fn effect_op_dispatcher_c(eff str, op str) -> str => "Nova_${eff}_${op}"

/// A FREE function of a handed module as the SHELL spells it (wave W6): the
/// oracle's `nova_fn_` + each module segment length-prefixed + the name
/// The constructor the shell emits for an instance: `Nova_<body>_static_new`
/// (measured: `Nova_Vec____nova_int_static_new(nova_int cap)`). Interop, same
/// end condition as the struct name. Whether the shell CARRIES it for this
/// instance is the table's question (`Ctx.interop`), asked by check before
/// anything is printed.
export fn c_instance_ctor(ctx Ctx, t TyId) -> str => c_instance_static(ctx, t, EMPTY_CTOR)

/// A STATIC method of an instance as the shell emits it: `Nova_<body>_static_<name>`
/// -- the constructor's spelling, for any static name (274.11 E.10 step 4c-2:
/// `Ctx @instantiates` asks it of `Vec[T].new`). Interop, same end condition.
export fn c_instance_static(ctx Ctx, t TyId, name str) -> str => "Nova_${instance_body(ctx, t)}_static_${name}"

/// THE C NAME of a vector operation the language calls IMPLICITLY over `vec_t`
/// -- the literal's constructor and push, `xs[i]`, a `for`'s len and index
/// (274.11 E.10 step 4c-2): the shell's instance when it carries one, else the
/// instance this unit makes from std's body (the checker admitted it and
/// recorded it as wanted, so mono made it). One door for every emitter site.
export fn vec_op_c(ctx Ctx, vec_t TyId, name str, row FnRow) -> str {
    // The OVERLOAD the checker recorded, spelled by the door it asked the shell
    // with (registry 1524); the bare name only where no row was recorded.
    ro shell = if name == EMPTY_CTOR {
        c_instance_ctor(ctx, vec_t)
    } else if raw_row(row) >= 0 {
        c_overload_symbol(ctx, row, vec_t, []TyId.of(ctx.tys.arg(vec_t, 0)))
    } else {
        c_instance_method(ctx, vec_t, name)
    }
    if ctx.interop.has(shell) { return shell }
    if raw_row(row) < 0 {
        ice_at(
            "novac/src/sem/mangle.nv:574",
            "mangle: an implicit vector operation the shell lacks reached emission with no row recorded")
    } else {
        // The row the checker recorded for this operation.
    }
    c_callable(ctx, row, []TyId.of(ctx.tys.arg(vec_t, 0)))
}

/// An instance METHOD as the shell emits it: `<body>_method_<name>` -- note the
/// missing `Nova_` prefix, which is how the oracle spells methods
/// (`Vec____nova_int_method_push`, measured 2026-08-26). Interop, same end
/// condition.
export fn c_instance_method(ctx Ctx, t TyId, name str) -> str {
    // TWO FAMILIES, TWO SPELLINGS, both READ OFF THE SHELL and neither invented
    // (2026-09-18). A generic RECORD instance is `<Head>____<args>_method_<name>`
    // (`Vec____nova_int_method_display`), while a generic SUM is
    // `Nova_<Head>_method_<name>_<arg>...` -- measured in `shell.tpl.c`:
    // `Nova_Option_method_display_nova_str` (defined at :6338) and
    // `Nova_Result_method_display_nova_int_nova_str`.
    //
    // THE SUM ARM CORRECTS A RECORD OF MINE THAT WAS WRONG. Earlier the same day
    // I wrote -- in the plan, in a fixture and to the integrator -- that
    // `Option`/`Result` were held by TWO independent blockers: no symbol in the
    // shell AND no spelling in novac. The first half was FALSE, and the way it
    // became false is worth the line: I grepped for the spelling novac WOULD
    // build (`NovaOpt_*_method_display`), found nothing, and read that as "the
    // shell does not carry it". The shell carries it under the spelling the
    // ORACLE builds. A grep for the name you expect answers a question about
    // your expectation, not about the tree.
    ro head = decl_of_ty(ctx, t)
    if head.kind != TypeKind.TkSum {
        return "${instance_body(ctx, t)}_method_${name}"
    } else {
        // The family spelling below.
    }
    consume s = StringBuilder.new(cap: 64)
    s.append("Nova_")
    s.append(head.name)
    s.append("_method_")
    s.append(name)
    for i in 0..ctx.tys.arg_count(t) {
        s.append("_")
        s.append(instance_arg_spelling(ctx, ctx.tys.arg(t, i)))
    }
    s
}

/// A method of a PLAIN (non-instance) type as the SHELL spells it:
/// `Nova_<type>_method_<name>` — measured on the shell 2026-08-28
/// (`Nova_str_method_equal`, `Nova_str_method_byte_len`). Note the `Nova_`
/// prefix, which the INSTANCE form deliberately does NOT have
/// (`Vec____nova_int_method_push`): the oracle spells the two differently, and
/// this door exists so that novac never guesses which of the two it needs.
///
/// Interop, with the same end condition as the rest of it: the door goes the day
/// novac emits the prelude itself and every method has a body of ours.
export fn c_shell_method(ctx Ctx, t TyId, name str) -> str =>
    "Nova_${ty_source_name(ctx, t)}_method_${name}"

/// The C cell of a MODULE VALUE (`ro NAME = expr`, 274.5 section 6) and the
/// function that computes it once. OURS, not interop: the cell never
/// crosses the ABI, so it carries novac's own prefix (P24). A qualified name
/// (`Type.NAME`) spells its dot as a double underscore -- no Nova identifier
/// holds one, so two names cannot meet in one spelling.
export fn module_value_c_name(name str) -> str => "novac_mv_${name.replace(".", "__")}"

/// The initializer function of a module value's cell: see `module_value_c_name`.
export fn module_value_init_c_name(name str) -> str => "novac_mvinit_${name.replace(".", "__")}"

/// length-prefixed -- `nova_fn_8encoding5utf1617is_high_surrogate` for
/// `encoding.utf16.is_high_surrogate` (D134; a Nova identifier never starts
/// with a digit, so the length and the segment cannot run together). INTEROP,
/// not imitation: one C name for one function on both sides of the link; goes
/// the day novac compiles handed modules into the unit (E2-b2 multi-file).
/// Asked only of a row whose `handed_from` is set -- a row of the file's own has no
/// shell symbol, and the caller's `compiles_body` question comes first.
export fn c_free_symbol(ctx Ctx, row FnRow) -> str {
    ro fd = ctx.fns.rows[raw_row(row)]
    consume s = StringBuilder.new(cap: 48)
    s.append("nova_fn_")
    ro b = fd.handed_from.bytes()
    mut start = 0
    mut i = 0
    while i <= b.len() {
        if i == b.len() || b[i] == DOT_BYTE {
            if i > start {
                ro seg = b[start..i].to_str() ?? ""
                s.append("${i - start}")
                s.append(seg)
            } else {
                // Two dots in a row, or a leading dot: no segment between them.
            }
            start = i + 1
        } else {
            // Inside a segment: the byte belongs to it.
        }
        i += 1
    }
    s.append("${fd.name.bytes().len()}")
    s.append(fd.name)
    // A LATER OVERLOAD of its module carries its parameters (task #14): until
    // `()` was a readable type argument, std.os's `env(key, value) ->
    // Result[(), IoError]` was dropped and `env(key)` was the only one.
    s.append(free_overload_tail(ctx, row))
    s
}

/// The byte the module path separates its segments with.
const DOT_BYTE u8 = 0x2E // .

/// The mono NAME of a tuple type (D123, length-prefixed):
/// `_NovaTuple_<arity>_<len1>_<spelling1>_..._<lenN>_<spellingN>`, where a
/// spelling is the component's C type with the pointer star written `_p`
/// (`Nova_Vec____nova_int*` -> `Nova_Vec____nova_int_p`) and the len is the
/// SPELLING's byte length -- unambiguous for any nesting, which is the whole
/// point of the prefix (Itanium/Rust-v0 analog, the oracle's shell spells
/// pairs exactly so). INTEROP, not imitation: one C name for one type on both
/// sides of the link, and it goes the day novac emits the whole prelude.
export fn mono_tuple_name(ctx Ctx, t TyId) -> str {
    consume s = StringBuilder.new(cap: 48)
    s.append("_NovaTuple_")
    s.append("${ctx.tys.arg_count(t)}")
    for i in 0..ctx.tys.arg_count(t) {
        ro spell = c_in_name(ctx, ctx.tys.arg(t, i))
        s.append("_")
        s.append("${spell.byte_len()}")
        s.append("_")
        s.append(spell)
    }
    s
}

/// C name of a sum's tag constant for a variant: `NOVAC_TAG_<Sum>_<Variant>`
/// (novac's own namespace for user sums — the oracle's NOVA_TAG_ is its).
export fn c_tag(ctx Ctx, vrow VariantRow) -> str {
    ro vd = ctx.variant_rows[raw_vrow(vrow)]
    // A HANDED sum's tags are the SHELL's (`NOVA_TAG_ScopeOutcome_Success`) -- the split
    // `c_maker` below makes for its maker. Spelled in our namespace, a test of an
    // auto-cleanup's outcome named an undeclared constant (registry 221.1 #1728).
    if raw_decl(ctx.tys.decl_head_of(vd.sum_id)) < ctx.foreign_types_cnt { return c_shell_tag(ctx, vrow) }
    // TWICE QUALIFIED, exactly as section 9.1d point 3 asks: the module, then the
    // sum, then the variant. Two same-named sums in one unit used to collapse
    // into one tag set -- and a tag is an enum constant, so C would have taken
    // the second definition as a redefinition or, worse, silently agreed.
    "NOVAC_TAG_${module_prefix(ctx)}${decl_of_ty(ctx, vd.sum_id).name}_${vd.name}"
}

/// C name of the SHELL'S tag constant for a variant: `NOVA_TAG_<Sum>_<Variant>`
/// -- the oracle's namespace, unqualified by module, exactly as the shell
/// declares it (`r->tag = NOVA_TAG_Result_Ok` in every `nova_make_NovaRes_*`).
/// Asked for a sum whose instances the SHELL defines (`is_shell_applied_sum`);
/// novac's own sums keep `c_tag` above. The maker below makes the same split for
/// a handed sum, by the same reason: the C is the shell's, not ours.
export fn c_shell_tag(ctx Ctx, vrow VariantRow) -> str {
    ro vd = ctx.variant_rows[raw_vrow(vrow)]
    "NOVA_TAG_${decl_of_ty(ctx, vd.sum_id).name}_${vd.name}"
}

/// C name of a variant's maker function: `novac_make_<Sum>_<Variant>`.
export fn c_maker(ctx Ctx, vrow VariantRow) -> str {
    ro vd = ctx.variant_rows[raw_vrow(vrow)]
    ro sname = decl_of_ty(ctx, vd.sum_id).name
    // A HANDED sum (a row below `foreign_types_cnt`) is the shell's: its maker
    // answers to the oracle's ABI (`nova_make_Decision_Stop`, E.9 step 4b --
    // an op of a std effect returns one), never to our module prefix.
    if raw_decl(ctx.tys.decl_head_of(vd.sum_id)) < ctx.foreign_types_cnt { return "nova_make_${sname}_${vd.name}" }
    "novac_make_${module_prefix(ctx)}${sname}_${vd.name}"
}

/// The RUNTIME's entry slot. Not ours to choose: the shell calls this exact
/// symbol, and `check-novac-shell-freshness.sh` holds the pair together.
const ENTRY_C_NAME = "nova_fn_main_impl"

/// C name of a method call on a receiver type: the oracle's shape is
/// `<Recv>_method_<name>` where <Recv> is the receiver's C base spelling
/// (`Nova_str` for str). Only str receivers exist in the subset today; the
/// rule generalizes with the registry (records: `Nova_<name>`).
/// The C name of a CALLABLE. ONE scheme for all of them.
///
/// Plan 273 says a method IS a function whose first parameter is marked the
/// receiver, and this door now spells it that way: the receiver is simply
/// parameter zero, and no `method` appears in the name. What IS special is
/// not method-ness but ORIGIN -- a symbol we did not choose:
///   * the entry point answers to the RUNTIME (`nova_fn_main_impl`);
///   * a callable read from the oracle's declarations answers to the
///     ORACLE's ABI, and matching it byte for byte is the fixed point that
///     `check-novac-mangle-fixed-point.sh` holds.
/// Everything else is ours, and ours carries its PARAMETER TYPES.
///
/// The parameters are in the name because overloading is BY parameters:
/// until 2026-08-19 `fn describe(v int)` and `fn describe(v str)` -- legal
/// Nova, accepted by the oracle and by novac -- emitted TWO C functions
/// called `novac_user_describe`. Invalid C from a valid program, and no
/// diagnostic anywhere (owner's review; the probe is in the wave's commit).
///
/// `args` carries the instance key on top (E2-b2): two instantiations of one
/// generic callable differ in the same name, after the parameters.
export fn c_callable(ctx Ctx, row FnRow, subst []TyId) -> str
    requires raw_row(row) >= 0 && raw_row(row) < ctx.fns.rows.len(), "mangle: callable row outside the registry"
{
    ro fd = ctx.fns.rows[raw_row(row)]
    if is_entry_fn(fd) {
        return ENTRY_C_NAME
    } else {
        // Every other callable is named by the scheme below -- INCLUDING an
        // overload of `main`, which is an ordinary callable: the entry point is
        // the row whose symbol the runtime dictates, not every row that shares
        // its spelling (measured 2026-08-22: both rows got this one symbol).
    }
    // ONE scheme for every callable of ours. A receiver is parameter zero and
    // gets no special treatment: plan 273 says a method IS a function whose
    // first parameter is marked the receiver, so the name has no `method` in it
    // and no branch on `has_recv`. Overloading is by parameter types (and the
    // oracle accepts a difference in the return type alone), so both are here.
    consume s = StringBuilder.new(cap: 64)
    s.append("novac_fn_")
    // THE MODULE PATH IS PART OF THE IDENTITY (section 9.1d point 1) -- the ROW's
    // module, not this file's (E.10 step 1) -- and it goes
    // FIRST for the same reason the parameters go last: the name reads
    // outside-in, and two modules declaring `helper` must differ before their
    // parameters are even compared. A file with no module declaration adds
    // nothing -- novac's own `main.nv` is such a file, and inventing a path for
    // it would name something the source does not say.
    s.append(row_module_prefix(ctx, fd))
    s.append(fd.name)
    for p in ctx.fns.params[fd.param_off..fd.param_off + fd.param_cnt] {
        s.append("__")
        s.append(mode_tag(p.mode))
        s.append(type_tag(ctx, p.type_id, subst))
    }
    // The RETURN type belongs in the name too: the oracle accepts two
    // callables that differ only by it (probed 2026-08-19), so leaving it
    // out would reopen the collision the parameters just closed. It is
    // absent only for the -1 sentinel, which is legal for the entry point
    // alone and answered above.
    if is_ty(fd.ret_id) {
        s.append("__to_")
        s.append(type_tag(ctx, fd.ret_id, subst))
    } else {
        // No declared return: check refuses this everywhere but `main`,
        // and `main` never reaches here.
    }
    // A generic call carries substitution arguments that may not appear in
    // the parameter or return types (e.g. a parameterless generic). The
    // suffix makes `id[int]` and `id[str]` two C functions even when the
    // parameters already disambiguate — harmless redundancy.
    for a in subst {
        s.append("__")
        s.append(type_tag(ctx, a, subst))
    }
    s
}
/// The concrete type a declaration's type stands for under a substitution:
/// `TkParam(i)` becomes `subst[i]`, and every other type is already itself.
///
/// THE one door for applying a substitution, and it became one only when a
/// THIRD caller wanted it: the rule lived here inside `type_tag` and again in
/// `check` as `Checker.concrete`, which is how one rule starts being two
/// (P18). `mono` rewrites an instance's parameter and return types with it, so
/// no backend ever substitutes -- the architecture's own boundary
/// (novac-architecture.md: a substitution needed in the emitter means mono did
/// not finish its work).
export fn subst_type(ctx Ctx, t TyId, subst []TyId) -> TyId {
    if !is_ty(t) { return t }
    match ctx.tys.kind_of(t) {
        TkParam => {
            // The parameter's index comes from the interner term, and it
            // addresses the substitution directly.
            ro idx = ctx.tys.param_slot_of(t)
            assert(idx >= 0 && idx < subst.len(),
                "mangle: a type parameter outside the substitution — a generic asked without one")
            return subst[idx]
        }
        // A TERM WITH ARGUMENTS carries parameters inside it -- `Vec[T]`,
        // `(T, int)`, `*mut T` -- and is rewritten THROUGH them, by the
        // interner's one substitution (2026-10-01, 274.11 E.10 step 4c). Until
        // this day these kinds returned unchanged: a shallow door, so the
        // receiver of an instance of std's `Vec[T] @len` stayed `Vec[T]` and
        // the instance's C name asked for a parameter's layout (ice). No own
        // generic took a `[]T` before the handed bodies did, which is why the
        // shallowness went unseen. An empty substitution is a run over a file,
        // where there is nothing to rewrite.
        TkApp | TkTuple | TkPtr => {
            if subst.len() == 0 { return t }
            // READ, not interned: this door holds the context without the
            // right to grow the interner. The checker interned every term it
            // typed, so the rewritten one exists -- a term that does not is
            // a hole in the checker, said here rather than guessed.
            ro r = ctx.tys.subst_known(t, subst)
            if !is_ty(r) {
                ice_at(
                    "novac/src/sem/mangle.nv:865",
                    "mangle: a substituted type the checker never interned -- the instance was not typed through it")
            } else {
                // Interned: the one id this term has.
            }
            return r
        }
        // Every other kind is already a type: a substitution has nothing to
        // rewrite in it. Named one by one rather than through a wildcard --
        // a new kind must come here and say what it does (P21). TkEffect is
        // one of them: a marker nominal whose term mentions no parameter.
        TkPrim | TkRecord | TkSum | TkInfer | TkNewtype | TkEffect => {}
    }
    t
}

/// The MODE of a parameter, inside a C name.
///
/// A parameter's mode is an axis of OVERLOADING (P14), so two callables of one
/// name differing only by a mode are two C functions -- and until 2026-08-21
/// they were one: `fn tag(c Cel)` beside `fn tag(mut c Cel)` emitted
/// `novac_fn_tag__Cel__to_nova_int` twice and clang refused the unit. The same
/// class the parameter TYPES closed on 2026-08-19, one axis later.
///
/// `ro` is UNMARKED on purpose: it is the default of the language, so every
/// name of mode-free code is exactly what it was, and no baseline moves for a
/// change that does not concern it.
///
/// Letters, not the language's words: the C name is OURS (274 section 7.0), and
/// the spelling of a mode belongs to `builtins` alone (P5). `m_`/`c_` are
/// fragments this door invents, like `__to_`.
#realtime nogc
fn mode_tag(m ParamMode) -> str => match m {
    ModeRo => ""
    ModeMut => "m_"
    ModeConsume => "c_"
}

/// The tag of an INSTANCE inside one of our names: head, `_of_`, the argument
/// tags joined by `_and_` -- `Vec_of_nova_int`, `Pair_of_nova_int_and_nova_str`.
fn instance_tag(ctx Ctx, t TyId, subst []TyId) -> str {
    consume s = StringBuilder.new(cap: 48)
    s.append(decl_of_ty(ctx, t).name)
    s.append("_of_")
    for i in 0..ctx.tys.arg_count(t) {
        if i > 0 {
            s.append("_and_")
        } else {
            // The first argument follows `_of_` directly.
        }
        s.append(type_tag(ctx, ctx.tys.arg(t, i), subst))
    }
    s
}

/// A POINTER's tag inside one of OUR names: `_ptr_` or `_mutptr_`, then the
/// pointee's tag -- pieces, like `_of_` and `_and_` above, never a name.
fn ptr_tag(ctx Ctx, t TyId, subst []TyId) -> str {
    consume s = StringBuilder.new(cap: 32)
    s.append(if ctx.tys.ptr_is_mut(t) { "_mutptr_" } else { "_ptr_" })
    s.append(type_tag(ctx, ctx.tys.arg(t, 0), subst))
    s
}

/// An identifier-safe tag for a type, for use INSIDE a C name.
///
/// `c_type` cannot serve here: it answers with C syntax (`Nova_Pt*`), and a
/// star is not a letter. The tag answers a different question -- "which type is
/// this, spelled so it can sit in an identifier" -- and the two must not be
/// conflated, or the first pointer instance emits a name C refuses to parse.
///
/// `subst` is the substitution of the declaration's type parameters: when a
/// parameter is `TkParam` with index `i`, `subst[i]` is the concrete type.
/// Empty for every ordinary callable.
fn type_tag(ctx Ctx, t TyId, subst []TyId) -> str
    requires is_ty(t), "mangle: type_tag of `no type`"
{
    match ctx.tys.kind_of(t) {
        TkPrim => prim_c_name(ctx.tys.prim_ordinal_of(t))
        // A record and a sum are named the same way: one case.
        TkRecord | TkSum => decl_of_ty(ctx, t).name
        // The newtype's OWN name, never the representation's: `f(Row)` and
        // `f(int)` are two callables, and the C name is what keeps them apart.
        TkNewtype => decl_of_ty(ctx, t).name
        // A tuple in a callable's C name spells as its D123 mono struct --
        // unique per component list and stable, so overloading by a tuple
        // RETURN type works the D84 way (step 4b). A tuple PARAMETER stays
        // outside the wave's bounds, held by the checker's named refusal in
        // bind_typed_param, not by this spelling's absence. SUBSTITUTED first,
        // like every term with parameters inside: std's `Vec[T] @split_at`
        // returns `(Self, Self)`, and its instance's name asked the layout of
        // `T` (ice, registry 1557).
        TkTuple => mono_tuple_name(ctx, subst_type(ctx, t, subst))
        // An INSTANCE inside one of OUR names: `Vec_of_nova_int`. This is not
        // the shell's spelling (`Vec____nova_int`) on purpose -- a callable's C
        // name is ours (274 section 7.0), and the pieces are chosen so no
        // parameter separator (`__`) can be mistaken for an argument separator:
        // `take__Vec__nova_int` would read as two parameters. Found by the first
        // literal that reached emission (2026-08-26): `fn first(xs []int)` iced
        // here while its call site had already been accepted.
        TkApp => instance_tag(ctx, t, subst)
        // A type parameter resolved through the substitution -- by the ONE
        // door that applies one, so the mangler and mono cannot disagree about
        // what `T` stands for.
        TkParam => type_tag(ctx, subst_type(ctx, t, subst), subst)
        TkInfer => ice_at(
            "novac/src/sem/mangle.nv:971",
            "mangle: type_tag of an inference variable — inference arrives at E2-b3")
        // TkEffect: unreachable while the with-doors refuse non-handler values;
        // ice, not a fallback (E4 wave). A callable named BY an effect type is a
        // with-typing question, not a mangle guess.
        // A POINTER in one of OUR names: the pointee's tag behind a piece that
        // cannot be a parameter separator (`ptr_tag`).
        TkPtr => ptr_tag(ctx, t, subst)
        TkEffect => ice_at(
            "novac/src/sem/mangle.nv:980",
            "mangle: type_tag of an EFFECT type — an effect value reaches a callable name only through a with-door bug (E4 wave)")
    }
}
