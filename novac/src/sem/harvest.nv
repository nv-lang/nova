// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc crate metadata / Go export data for the SHAPE (a compiler reads
// another unit's signatures instead of knowing them), and rustc `method::probe`
// + `AssocItem.fn_has_self_parameter` for "the receiver is the first parameter".
// Donor: none for the harvest RULE -- that a signature enters only when EVERY
// type in it is known, so the type system filters std's overloads and no name
// list in the compiler does. NOT taken: a real metadata format (declarations
// are re-lexed and re-parsed every compile, E2-temporary).
// Role: layer 3 -- reading signatures from the declarations the DOOR hands in: std's interface as DATA (P5).
// Used by: collect() only; nothing else reads declarations.
// Guarded by: check-novac-row-fields.py (registry row fields declared in plan 10.3v), the pipeline module tests (a
// declaration with a mode stays readable), check-novac-file-size.py (this file exists because sem.nv crossed 1000
// lines).
// novac/src/sem/harvest.nv -- signatures READ from declarations.
//
// A co-equal file of the `sem` module, cut along MEANING: "what this FILE
// declares" (sem.nv) and "what the declarations handed to us declare"
// (here) are two questions with two answers, and only the second one is
// tolerant by design -- a signature novac cannot fully read simply does not
// enter the table, and every use of it gets an honest refusal at the point of
// use.
//
// The rule this file exists to keep: a parameter's TYPE is found by its DOOR
// (`param_type_at`), never by a fixed index. A mode stands at index zero in
// `mut v int`, so a fixed index reads the NAME as the type -- and here the
// consequence was total and silent: the type came back unknown and the whole
// SIGNATURE was dropped, so every `consume` method of std (both finalize-lane
// `#coerce` pairs among them) was invisible to novac until 2026-08-21.

module novac.sem

import ../tree.{Node, NodeKind}
import ../builtins.{COERCE_ATTR, SELF_TYPE, UNIT_TYPE_NAME}
import ../types.{TyId, no_ty, is_ty}

/// Read a METHOD declared in THIS file: the same reader std declarations go
/// through, plus the node -> row entry the emitter needs to find the body.
///
/// Answers the row it registered, or `None` when the signature was refused (an
/// unknown type in it, for instance) -- and then `check` names the refusal at
/// the point of use rather than the collector guessing.
///
/// Lives here and not in the collector because this IS reading a method
/// declaration, which is what this file does; the collector calls it.
export fn harvest_own_method(kids []Node, types []TypeDef, defs DefTable,
                             mut fns FnTable) -> Option[FnRow] {
    ro before = fns.rows.len()
    harvest_fn(kids, types, defs, fns)
    if fns.rows.len() > before {
        Some(FnRow(fns.rows.len() - 1))
    } else {
        None
    }
}

/// Collect method signatures from READ declarations (`fn <Recv>
/// @<name>() -> R`). Only signatures where BOTH the receiver AND the
/// return are types already known to the registry are taken: the rest
/// does not become a subset method and gets an honest rejection at the
/// point of use. Overloads (two signatures for one (receiver, name))
/// are marked and also rejected — silent choosing is not allowed.
fn harvest_methods(decls []Node, types []TypeDef, defs DefTable, mut fns FnTable, mut coerces []CoercePair) -> () {
    for d in decls {
        harvest_in(d, types, defs, fns, coerces)
    }
}

/// The walk is RECURSIVE, not top-level only: parser recovery can
/// nest a declaration inside a foreign node (that same finding A2 of
/// plan 274.3 — `atom()` eats the closing bracket and drags away the
/// tail of the file). Until recovery is fixed in wave 2, signature
/// collection must not depend on it: a declaration is found wherever
/// it ended up.
fn harvest_in(n Node, types []TypeDef, defs DefTable, mut fns FnTable, mut coerces []CoercePair) -> () {
    match n {
        Leaf(_) => {}
        Branch { kind, children, .. } => {
            if kind == NodeKind.FnDecl {
                harvest_fn(children, types, defs, fns)
                return
            }
            // An attribute is the declaration's PREVIOUS SIBLING, not its
            // child: the parser reads `#coerce` as a top-level node of its own
            // (newlines are trivia, so the attribute line ends where the next
            // declaration keyword begins). So the relation "this attribute
            // belongs to what follows" is a property of THIS walk, and it is
            // one bool wide.
            // WHOSE attribute is this -- asked by the door, once for the list,
            // because the compiled FILE now asks the same question and two
            // readings of one positional rule is how they part company.
            ro marked = coerce_marked(children)
            for c in children {
                if c.kind_of() == NodeKind.AttrDecl { continue }
                ro before = fns.rows.len()
                harvest_in(c, types, defs, fns, coerces)
                if is_coerce_marked(marked, c.id_of()) && fns.rows.len() > before {
                    harvest_coerce_pair(fns, coerces, FnRow(fns.rows.len() - 1))
                } else {
                    // Either no attribute stood here, or the declaration under
                    // it entered no row -- a signature whose types novac does
                    // not know is not taken (see harvest_fn), and a pair to a
                    // row that does not exist would be a pair to nothing.
                }
            }
        }
    }
}

/// THE TYPES of the declarations novac was HANDED, into the same registry.
///
/// Until 2026-08-23 only method SIGNATURES were harvested, and the types those
/// signatures mention were not -- which is why `fn take(xs CharsIter)` answered
/// "novac does not know this type yet" about a type std declares three lines
/// above the method that returns it, and why a signature whose parameter is such
/// a type was dropped whole.
///
/// TOLERANT BY DESIGN, like the signature reader beside it: a declaration whose
/// shape this pass cannot read registers nothing, and the use of its name gets an
/// honest refusal at the point of use. Nothing here refuses -- `sem` builds the
/// picture, `check` judges it.
///
/// FIELDS ARE NOT READ YET, and that is a boundary rather than an omission: a
/// field of a handed-over record is reachable only through a form the subset does
/// not compile (`iter.pos`), so reading them now would be a capability with no
/// obligation (K7). The name and the KIND are what a type in a signature needs.
export fn harvest_types(decls []Node, mut types []TypeDef, mut defs DefTable,
                        mut tys Interner) -> () {
    for d in decls {
        for c in file_decls(d) {
            ro k = c.kind_of()
            if k != NodeKind.TypeDecl && k != NodeKind.SumDecl { continue }
            ro nk = branch_children(c)
            if nk.len() < 2 { continue }
            if nk[1].kind_of() != NodeKind.LeafNode { continue }
            ro tname = leaf_text(nk[1])
            // A GENERIC declaration registers as a HEAD (step B1): the row
            // carries how many parameters it binds, and the RESOLVER is what
            // keeps a bare `Vec` from becoming a type -- `ty_or_none` answers
            // no_ty for a head, so the hole step A closed by skipping stays
            // closed by construction, and the refusal site can now say the
            // truth ("write its type arguments") instead of "unknown type".
            ro tp_cnt = generic_names(nk).len()
            // A name the registry already holds is not registered twice: the
            // chain would grow a second foreign row for one declaration, and
            // the reader would answer with whichever came last -- the very
            // last-write-wins this table stopped doing.
            if defs.def_of(tname).is_some() { continue }
            ro id = DeclId(types.len())
            defs.add(tname, DefTarget.DefType(id))
            // A SUM IS TOLD BY THE NODE KIND, not by `DeclShape`: that sum has
            // four variants and none of them is a sum, because the shape reader
            // answers about a `type` declaration's TAIL while the parser already
            // separated `SumDecl` from `TypeDecl`. The C compiler said so --
            // `NOVA_TAG_NovaValue_DeclShape_ShapeSum` exists nowhere -- which is
            // the third time this session that a guess about a closed set was
            // corrected by a build rather than by a check.
            if k == NodeKind.SumDecl {
                // The VARIANTS are not read, for the same reason the fields are
                // not: constructing one needs a path form the subset does not
                // compile, so reading them now would be a capability with no
                // obligation.
                types.push(TypeDef { kind: TypeKind.TkSum, by_value: false,
                                     tparam_cnt: tp_cnt,
                                     ty_id: tys.sum(id), name: tname,
                                     rows: TypeRows.NoRows })
                continue
            }
            // Everything else -- a record, an alias, a newtype, a protocol from
            // elsewhere -- registers as a RECORD with no fields, which is the
            // honest "a type novac knows of and knows nothing about". Refusing
            // here would drop the declaration and take the methods that mention
            // it down with it.
            types.push(TypeDef { kind: TypeKind.TkRecord, by_value: decl_is_value(c),
                                 tparam_cnt: tp_cnt,
                                 ty_id: tys.record(id), name: tname,
                                 rows: TypeRows.NoRows })
        }
    }
}

/// One declaration: receiver, name, return type. Taken only if BOTH
/// the receiver AND the return are already known to the registry —
/// otherwise the method does not enter the subset and gets an
/// honest rejection at the point of use.
fn harvest_fn(kids []Node, types []TypeDef, defs DefTable, mut fns FnTable) -> () {
    mut recv_name = ""
    mut mname = ""
    mut ret_name = ""
    for c in kids {
        ro ck = c.kind_of()
        if ck == NodeKind.Recv {
            // The receiver's NAME is the first identifier LEAF, not child 0:
            // since 2026-08-17 the group may open with a Generics branch
            // (`fn[T] []T @map`) or with slice brackets, and `leaf_text` on a
            // branch is an ice -- which is exactly what it became, on EVERY
            // file, because std declarations go through this door.
            for rc in branch_children(c) {
                ro is_name = rc.is_ident()
                if is_name && recv_name == "" {
                    recv_name = leaf_text(rc)
                } else {
                    // Either the name is already found, or this leaf is not
                    // one: the FIRST identifier under the receiver group is
                    // the name, and what follows belongs to its type
                    // arguments.
                }
            }
        } else if ck == NodeKind.RetType {
            ro rk = branch_children(c)
            if rk.len() < 2 { continue }
            // `-> ()` names the UNIT, and its spelling is punctuation rather
            // than an identifier -- so reading leaf 1 gave `(` and the whole
            // signature was DROPPED (all its types must be known). The call site
            // then said "no such method in the declarations handed to novac"
            // about a method declared three lines above (measured 2026-08-23).
            ret_name = if ret_is_unit(rk) { UNIT_TYPE_NAME } else { leaf_text(rk[1]) }
        } else if ck == NodeKind.LeafNode && mname == "" && recv_name != "" {
            if leaf_kind(c) != TokenKind.Ident { continue }
            mname = leaf_text(c)
        } else {
            // Every other child (the `fn` keyword, the parameter list, the
            // body) says nothing about receiver, name or return; parameters
            // are read by the second walk below, once those three are known.
        }
    }
    if recv_name == "" || mname == "" || ret_name == "" { return }
    ro recv_t = ty_or_none(types, defs, recv_name)
    // `Self` is the RECEIVER's type, spelled by its role instead of its name.
    // It is not in `defs` and never will be -- it names no declaration -- so a
    // door that only asked the registry dropped the WHOLE signature: measured
    // 2026-08-21 on `fn Cel @twin() -> Self`, and std spells it 264 times in 50
    // files. Same silent-drop class as the receiver mode two waves earlier: the
    // signature vanished, and the refusal at the use site said "no such method"
    // about a method std declares.
    ro ret_t = if ret_name == SELF_TYPE { recv_t } else { ty_or_none(types, defs, ret_name) }
    if !is_ty(recv_t) || !is_ty(ret_t) { return }
    // A signature is valid only if ALL its types are known, including
    // its parameters. Otherwise std overloads would land in the table
    // as "one name twice" and get rejected as ambiguous: `str` has both
    // `@contains(needle str)` and `@contains(c char)` — the second is
    // not part of the subset, because `char` is unknown to the
    // registry. This way the TYPE system does the picking, not a list
    // of names.
    // Parameters are KEPT, receiver first: plan 273 order. They were merely
    // validated and dropped before (owner's check 2026-08-16), which left the
    // receiver as the only parameter novac remembered.
    mut param_ids = []ParamDef.new()
    // The receiver is parameter ZERO (plan 273), and its mode is the receiver's
    // own qualifier: `fn StringBuilder consume @into_str()` declares a consuming
    // receiver, and that is what makes it selectable at all (P14).
    // The RECEIVER carries neither a name nor a default: it is written before
    // the method's name, not in the parameter list, so there is no `name:` a
    // call site could say and no `=` a declaration could write.
    param_ids.push(ParamDef { name: RECV_BINDING, type_id: recv_t,
                              mode: recv_mode_at(kids), default_expr: []Node.new() })
    for c in kids {
        if c.kind_of() != NodeKind.Param { continue }
        ro pk = branch_children(c)
        // The type by its DOOR, never by index one: a MODE stands at index zero
        // in `mut v int`, so a fixed index reads the NAME as the type. Here the
        // consequence was silent and total -- the type came back unknown and the
        // whole SIGNATURE was dropped, so every std method with a `mut`
        // parameter (131 of them) was invisible to novac. Measured 2026-08-21;
        // the typing walk moved onto these doors on 2026-08-18 and both
        // collectors were left behind.
        ro tat = match param_type_at(pk) {
            // No readable type: the signature does not enter the subset, and a
            // use of it gets an honest refusal at the point of use.
            None => return
            Some(t) => t
        }
        // [LEGACY-#676] var-index-method: a method called on `pk[tat]` with a
        // VARIABLE index takes the CONTAINER as its receiver, so the binding
        // hop is the whole workaround (it is refused outright in strict mode,
        // which is how this line was caught the moment it was written).
        ro tnode = pk[tat]
        if tnode.kind_of() != NodeKind.LeafNode { return }
        ro pname = leaf_text(tnode)
        // A PARAMETER may be `Self` too (`fn T @merge(other Self)`), and it
        // means the same thing: the receiver's type.
        ro pt = if pname == SELF_TYPE { recv_t } else { ty_or_none(types, defs, pname) }
        if !is_ty(pt) { return }
        // The MODE travels with the type: it is an axis of overloading (P14),
        // so a signature read without it would make `@ptr()` and `mut @ptr()`
        // one row twice over.
        param_ids.push(ParamDef { name: param_name_of(pk), type_id: pt,
                                  mode: param_mode_at(pk), default_expr: param_default_slot(pk) })
    }
    // A signature READ from std's own Nova source: the body is there too, and
    // novac does not compile it yet. That is a state of THIS compiler, not a
    // property of the declaration -- so no field records it, and the row is a
    // row like any other. Nova's real external declarations are `extern "C" fn`
    // and `extern "nova" fn`, which say so IN THE SOURCE and carry an ABI;
    // neither appears in std's string module (owner, 2026-08-20).
    fns.add(mname, ret_t, true, param_ids, generic_names(kids), generic_bounds(kids))
}
