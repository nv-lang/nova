// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem/handed_fields.nv -- the FIELDS of records novac was HANDED
// (another file's, another module's), registered where the language lets the
// compiled file see them (D281 with D220, registry 1322).
//
// Donor: Go `types2` field visibility across packages (`lookupFieldOrMethod`:
// a field of another package is reached only when it is exported, one of the
// same package always) -- taken as the shape of the rule: a visibility decided
// per field, at registration, by the relation of the two modules; NOT taken:
// Go's case-based exportation -- Nova's `priv`/`pub` markers and `export`
// decide (D281, D220).
// Role: layer 3 -- the second half of filling the field registry: `collect.nv`
//   fills the file's own records, this file the handed ones, both through
//   the one door `fill_record_fields` (so the two cannot read a field two ways).
// Used by: sem/collect.nv (`collect_types_with`, after the file's own types).
// Guarded by: check-novac-file-size.py (cut out of collect.nv on 2026-10-05,
//   along meaning: the handed half of the field pass), the module tests of sem
//   and pipeline/handed_fields_test.nv.

module novac.sem

import ../lex.{TokenKind}
import ../tree.{Node, NodeKind}
import ../names.{raw_decl, no_decl, is_decl}
import ../builtins.{TypeKind, PRIV_MARKER}
import ../types.{Interner}


/// The FIELDS OF HANDED RECORDS, filled where the language lets the compiled
/// file see them (registry 1322).
///
/// `harvest_types` registers a handed record's name and kind and NOT its fields
/// ("FIELDS ARE NOT READ YET"), on the reasoning that a handed field is reached
/// only through a form the subset does not compile. The self-build refutes it:
/// in module mode a unit's neighbours in the same module are in the unit, but
/// every type of ANOTHER module arrives handed -- `Ctx`, `FnRow`, `SourceText`
/// -- and 771 of the 4156 typing diagnostics of novac's own source were
/// "unknown field" about fields written right there (measured 2026-09-25).
///
/// VISIBILITY IS THE LANGUAGE'S, D281 with D220 brought to it (2026-09-24):
/// fields are public by default; a type-level bare `priv` makes them
/// module-private; `priv(type)` and `priv(file)` narrow further. So a handed
/// record of the SAME module shows its fields unless its `priv` is qualified,
/// and one of ANOTHER module only when it is exported and carries no `priv` at
/// all. Whatever this does not open stays "unknown field" -- a loud refusal,
/// never a silent grant.
///
/// The FIRST handed declaration of a name owns its row (harvest's own rule), so
/// only that declaration fills it; a row the file itself declares shadows the
/// handed one and is left to the file's own pass.
fn fill_handed_fields(file Node, decls []Node, foreign_cnt int, mut types []TypeDef, defs DefTable,
                      mut fields FieldTable, mut tys Interner) -> () {
    ro own_module = module_dotted(file)
    mut seen = []bool.new()
    while seen.len() < foreign_cnt { seen.push(false) }
    mut tree = 0 - 1
    for d in decls {
        tree += 1
        // NO MODULE IS NOBODY'S MODULE (D281, registry 221.1 #1521): a file with
        // no module line and a handed std file read without one (std's
        // `#prelude` files -- `collections/vec/core.nv`) both answer "", and
        // the equality made `Vec`'s `priv` fields the moduleless file's own --
        // `v.len` compiled where the oracle says E_FIELD_MODULE_PRIVATE.
        ro same_module = own_module != "" && module_dotted(d) == own_module
        // The `file_decls` walk, keeping what it drops: whether the declaration
        // stood inside an `export` wrapper -- the other half of D281's rule.
        for w in branch_children(d) {
            if w.kind_of() != NodeKind.ExportDecl {
                fill_one_handed(w, false, same_module, foreign_cnt, seen, types, defs, fields, tys,
                                module_dotted(d), tree)
                continue
            }
            for inner in branch_children(w) {
                if inner.kind_of() == NodeKind.LeafNode { continue }
                fill_one_handed(inner, true, same_module, foreign_cnt, seen, types, defs, fields, tys,
                                module_dotted(d), tree)
            }
        }
    }
}

/// One handed declaration of `fill_handed_fields`: a record whose row it owns,
/// filled when D281 lets the compiled file see its fields.
fn fill_one_handed(c Node, exported bool, same_module bool, foreign_cnt int, mut seen []bool,
                   mut types []TypeDef, defs DefTable, mut fields FieldTable, mut tys Interner,
                   home str, tree int) -> () {
    if c.kind_of() != NodeKind.TypeDecl { return }
    if shape_of_decl(c) != DeclShape.ShapeRecord { return }
    ro nk = branch_children(c)
    if nk.len() < 2 || nk[1].kind_of() != NodeKind.LeafNode { return }
    ro tname = leaf_text(nk[1])
    ro owner_id = defs.type_decl(tname) ?? no_decl()
    if !is_decl(owner_id) { return }
    ro at = raw_decl(owner_id)
    // The file's own row shadows the handed one; its own pass fills it.
    if at >= foreign_cnt { return }
    if types[at].name != tname || types[at].kind != TypeKind.TkRecord { return }
    if seen[at] { return }
    seen[at] = true
    ro marker_at = priv_marker_at(nk)
    ro has_priv = marker_at >= 0
    ro qualified = has_priv && marker_at + 1 < nk.len() && leaf_kind(nk[marker_at + 1]) == TokenKind.LParen
    ro visible = if same_module { !qualified } else { exported && !has_priv }
    // A field the file may NOT read is registered all the same, marked private
    // to its module (274.11 E.10 step 4c-2): a body of that module this unit
    // instantiates (`Vec[T] @len` reads `@len`) has every right to it. Until
    // this day such a record got no fields at all, and its own body could not
    // read them.
    // WHERE a private field is visible from: its module for a bare `priv` (or a
    // record not exported), its declaring FILE for a qualified one -- spelled
    // `#<tree>`, which no module path can equal, so only a body read from that
    // same tree reads it (`check.Checker @field_visible`).
    // A FIELD's own `priv` (D220) hides it from another module; its `pub` lifts
    // only a bare type-level `priv` of an exported record.
    fill_record_fields(c, owner_id, tname, types, defs, fields, tys, !visible,
                       if qualified { "#${tree}" } else { home },
                       field_priv_hides: !same_module, pub_lifts: !same_module && exported && has_priv && !qualified)
}

/// Where a declaration's type-level privacy marker stands (D281), or -1 when it
/// has none. A qualifier group -- `priv(type)`, `priv(file)` -- opens with the
/// `(` right after it, which the caller asks of the next child. An int and not a
/// pair: a tuple in a signature is a form novac does not compile yet, and this
/// file is part of its own source.
fn priv_marker_at(nk []Node) -> int {
    for i in 0..nk.len() {
        if nk[i].kind_of() == NodeKind.LeafNode && leaf_text(nk[i]) == PRIV_MARKER {
            return i
        } else {
            // Not the marker: keep looking.
        }
    }
    0 - 1
}
