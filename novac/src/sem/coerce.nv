// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `CoerceMany`/`coerce_unsized` only for the SHAPE of the question
// ("does this value reach that position") -- the RULE is Nova's own D429, and it
// is DECLARATIVE: pairs are read from `.nv` declarations, never known by the
// compiler. NOT taken: rustc's coercion lattice and autoderef chains (D429 R4
// forbids chains outright -- one level, no composition, not even across
// mechanisms).
// Role: layer 3's D429 registry -- which implicit conversions this program declares, and which function performs each.
// Used by: check (the refusal path: an argument that coerces is legal Nova, so the refusal must say what novac lacks
// instead of "nothing fits").
// Guarded by: check-novac-ctx-tables.py (the table is declared in plan 10.3b), check-novac-row-fields.py (every row
// field justified in 10.3v), check-novac-no-name-hardcode.py (the attribute's word lives in builtins), the module tests
// of check.
// novac/src/sem/coerce.nv -- the `#coerce` pair registry (D429).
//
// A co-equal file of the `sem` module (a folder is one module): the registry
// lives beside the tables it references, and the cut is along MEANING -- "what
// conversions are declared" is one question, and it has one file. sem.nv
// crossed the thousand-line limit when this arrived, which is what made the
// seam visible rather than what created it.
//
// What is NOT judged here, and is named rather than left to be discovered:
// D429's R2 (the two zero-cost lanes, view and finalize) and R3 (one
// declaration per pair). Both need parameter MODES, and a callable row does not
// carry them -- `consume` and `ro` are invisible to this registry. Recorded in
// plan 274 section 9.1d.

module novac.sem

import ../tree.{Node, NodeId, NodeKind}
import ../builtins.{COERCE_ATTR, IMPL_ATTR}
import ../lex.{TokenKind}
import ../types.{TyId, is_ty}

/// ONE declared implicit conversion (D429 V1, form-source): the pair and the
/// function that performs it.
///
/// A pair is DATA read from a declaration, never knowledge of the compiler:
/// D429 is explicit that no pair may be hard-coded, and the attribute's own
/// word lives in `builtins` for the same reason (P5).
export type CoercePair value {
    from_id TyId /// source type -- the declaring method's receiver
    to_id TyId /// target type -- its return type
    via_row FnRow /// the declaring callable's row -- the inserted call names IT (D429 R7). `FnRow`, not `int`: this IS a row of `Ctx.fns` (`fns.rows[via_row]` two doors down), so the pair carried an untyped index into a typed space until 2026-08-21
}

/// The row that converts `from` into `to`, or None when no pair is declared.
///
/// A linear walk over a handful of pairs (std declares three), asked only when
/// an exact match has already failed -- which is R5 in its own shape: the exact
/// path never touches this table, so the hot resolution does not pay for it.
/// The comparison is by type ID, not by name; the day a program declares
/// hundreds of pairs the fix is an index, not a guess made now.
///
/// WHY THIS IS NOT THE SCAN THE CONVENTION FORBIDS, asked by the owner
/// 2026-08-23 and answered by measurement rather than by opinion. The rule
/// (`check-novac-resolve-discipline`, its first form) is about comparing NAMES
/// outside `names/`, because a name has an O(1) door -- `NameTable` -- and a
/// linear scan there is a scan past an index that exists. A pair is keyed by a
/// PAIR OF TYPE IDS, for which no door exists, and building one is what the
/// sentence above defers.
///
/// WHAT WAVE 5 CHANGED, and it is the fact that could reopen the decision: this
/// walk is now asked PER CANDIDATE (`coerces_into` runs over the same-name
/// chain), not once per call. The multiplier is real and it is bounded by two
/// small numbers -- candidates of one name (one, usually) times pairs declared
/// (three in std) -- and it is still off the hot path: the exact stage answers
/// first and never comes here. So the decision stands, and the trigger for
/// changing it is now WRITTEN rather than remembered: an index the day either
/// number stops being small, and the shape it would take is the one this
/// codebase already uses for a keyed registry -- a dense vector of chain heads
/// indexed by the SOURCE type, exactly like `fn_decl_rows` by node.
export fn coerce_row(ctx Ctx, from TyId, to TyId) -> Option[FnRow] {
    for p in ctx.coerces {
        if p.from_id == from && p.to_id == to { return Some(p.via_row) }
    }
    None
}


/// Does this attribute node name `word`? `#coerce` is `['#', ident...]`, and
/// the words are compared to the ONE place that spells language names (P5).
fn attr_names(attr Node, word str) -> bool => attr_kids_name(branch_children(attr), word)

/// The same question asked of the attribute's CHILDREN -- what a walk that
/// already opened the node has. One implementation, two entrances: `check`
/// judges the form from inside the walk, the collectors from outside it.
export fn attr_kids_name(kids []Node, word str) -> bool {
    for c in kids {
        // THE SCAN STOPS AT THE ARGUMENT LIST, and this stop is younger than the
        // loop around it (2026-09-18). Until that day the cursor stopped at `(`,
        // so an attribute's children were its NAME and its modifier words only --
        // `#realtime nogc` gives `realtime` and `nogc`, and asking "does it name
        // this word" over all of them was exactly right. Once the cursor began
        // taking `#impl(Display)` whole, the argument became a child too, and
        // without this stop `#impl(coerce)` would answer YES to "is this
        // `#coerce`" -- one attribute read as a different one.
        //
        // Nothing in the tree spells it that way today (`#impl(Serialize)`,
        // `#impl(Display)`, `#impl(Debug)`; protocol names are capitalised),
        // which is why this is written now rather than after a defect: the
        // hazard arrived with a change of mine, and the cheapest moment to close
        // it is the one where it is still visible.
        if leaf_kind(c) == TokenKind.LParen {
            break
        } else {
            // A name or a modifier word: still part of what the attribute says.
        }
        // A two-armed match and NOT `if Some(...)`, and the difference is
        // measured: the if-form needs an `else` with a reason anyway (P31), so
        // for an empty second case it is LONGER, not shorter. `if Some(...)`
        // wins where the second case carries a VALUE or a terminator.
        match c.ident_str() {
            Some(t) => { if t == word { return true } }
            None => {}
        }
    }
    false
}

/// Does this attribute's argument list name `word` AND NOTHING ELSE? The
/// companion of `attr_kids_name`, which asks about the attribute's own words and
/// stops at the argument list.
///
/// TWO DOORS AND NOT ONE FLAG, because the two questions have different answers
/// for the same node: `#impl(Display)` NAMES `impl` and ARGUES `Display`. A
/// single door with a boolean would let a caller ask the wrong half by passing
/// the wrong flag, and the compiler would not notice.
///
/// "AND NOTHING ELSE" IS THE WHOLE POINT, and the first version got it wrong.
/// `#impl(P1 + P2 + ...)` (D186) carries a LIST, and a door that answered "is
/// `word` among them" accepted `#impl(Display + Serialize)`: the author opted
/// into two protocols, the subset reads one, and the other was ignored in
/// silence. That is the subset claiming to honour an opt-in it does nothing
/// about -- measured 2026-09-18, four list forms, all four accepted where two
/// should have been refused. An opt-in the compiler half-honours is worse than
/// one it refuses: the author has said the type is Serializable and been
/// believed.
///
/// `+` is not an identifier, so it needs no case of its own; an EMPTY list
/// answers false, because `#impl()` opts into nothing and is not this door's
/// business to accept.
/// Does this attribute carry ANY protocol at all? `#impl()` and a bare `#impl`
/// both answer false.
///
/// A SEPARATE QUESTION FROM `attr_args_all`, and the amendment is why. Until
/// 2026-09-18 D186 said nothing about an empty list either way, and the checker
/// could treat it as "a protocol the subset does not read" -- the same refusal
/// as `#impl(Serialize)`. The owner ruled it an OVERSIGHT: the annotation means
/// the author OPTED IN, and opting into nothing opens no gate and states
/// nothing, so both empty spellings are language errors. Two questions now,
/// because they have different ANSWERS: "no protocol at all" is a form that does
/// not exist, "a protocol I do not read" is debt of this subset.
export fn attr_has_args(kids []Node, word str) -> bool {
    mut inside = false
    for c in kids {
        if leaf_kind(c) == TokenKind.LParen {
            inside = true
            continue
        } else {
            // Before the list.
        }
        if !inside {
            continue
        } else {
            // Inside it.
        }
        if leaf_kind(c) == TokenKind.RParen {
            return false
        } else {
            // Still inside.
        }
        match c.ident_str() {
            Some(t) => { return true }
            None => {}
        }
    }
    false
}

/// Does EVERY name in this attribute's argument list equal `word`?
///
/// `#display(Display)` and `#display(Display, Debug)` are both asked about one
/// protocol at a time, so ALL rather than ANY: an attribute that also names
/// something else is not an opt-in to this one alone.
export fn attr_args_all(kids []Node, word str) -> bool => attr_args_among(kids, []str.of(word))

/// Does every name in this attribute's argument list belong to `words` -- and is
/// there at least one? `#impl(Display + Equal)` is an opt-in to protocols the
/// subset reads when BOTH are among them (274.7 wave R added `Equal`); one name
/// outside the set and the attribute is not one the subset may accept unread.
export fn attr_args_among(kids []Node, words []str) -> bool {
    mut inside = false
    mut seen = false
    for c in kids {
        if leaf_kind(c) == TokenKind.LParen {
            inside = true
            continue
        } else {
            // Before the list, or a word inside it -- decided below.
        }
        if !inside {
            continue
        } else {
            // Inside the argument list.
        }
        if leaf_kind(c) == TokenKind.RParen {
            return seen
        } else {
            // Still inside.
        }
        match c.ident_str() {
            Some(t) => {
                if !word_in(words, t) {
                    return false
                } else {
                    // One more protocol the subset does read.
                }
                seen = true
            }
            None => {}
        }
    }
    false
}

/// Whether `t` is one of `words` -- the membership `attr_args_among` asks per name.
fn word_in(words []str, t str) -> bool {
    for w in words {
        if w == t { return true }
    }
    false
}

/// WHICH declarations a `#coerce` attribute marks, by node id.
///
/// ONE reading of "whose attribute is this", asked by BOTH collectors -- std's
/// (`harvest_in`) and the compiled file's (`collect_types`). An attribute is a
/// SIBLING of the declaration it marks (the parser keeps the tree lossless), so
/// the question is positional, and answering it inside each loop meant two
/// answers.
///
/// NO BUG IS BEING FIXED HERE, and the first version of this comment claimed
/// one -- that std's loop never cleared its flag. It cleared it (the compiler
/// said so, by refusing the line I had left behind). The door is justified by
/// the ONE reading, not by a defect: the rule "an attribute marks the NEXT
/// declaration and nothing else" is positional, and a second copy of it is a
/// second place for it to drift.
export fn coerce_marked(kids []Node) -> []NodeId =>
    attr_marked(kids, COERCE_ATTR, "")

/// WHICH protocols the `#impl(...)` gate over `id` names, in source order
/// (D186 gate semantics: bare call and interpolation require the type author's
/// opt-in).
///
/// Returns the NAMES AS WRITTEN and judges none of them. Whether a name is a
/// protocol at all, and whether this compiler reads it, are different questions
/// with different answers and different diagnostics -- `E_UNKNOWN_PROTOCOL` for
/// the first (D186, not answered by this subset yet) and subset debt for the
/// second. A door that folded them would make "a protocol I do not read"
/// indistinguishable from "a name that is not a protocol".
///
/// The positional rule is the same one `coerce_marked` reads, and it is read
/// HERE rather than copied into each collector for the reason that door names:
/// an attribute is a SIBLING of the declaration it marks, and two readings of
/// one positional rule is how they part company.
fn impl_protocols_before(kids []Node, id NodeId) -> []str {
    mut pending = []str.new()
    for c in kids {
        if c.kind_of() == NodeKind.AttrDecl {
            ro ch = branch_children(c)
            if attr_kids_name(ch, IMPL_ATTR) {
                pending = attr_arg_names(ch)
            } else {
                // Some other attribute: it marks this declaration, but not with
                // a gate, and it CONSUMES the position all the same.
                pending = []str.new()
            }
            continue
        }
        if c.id_of() == id {
            return pending
        } else {
            // Not the declaration asked about; its own mark is consumed below.
        }
        pending = []str.new()
    }
    []str.new()
}

/// The identifiers inside an attribute's argument list, in source order.
///
/// `+` and the parentheses are separators and do not appear; `#impl()` and a
/// bare `#impl` both give an empty list, which the checker refuses as a
/// LANGUAGE error (D186 amendment 2026-09-18) rather than reading as "no gate".
fn attr_arg_names(kids []Node) -> []str {
    mut out = []str.new()
    mut inside = false
    for c in kids {
        if leaf_kind(c) == TokenKind.LParen {
            inside = true
            continue
        } else {
            // Before the list, or a word inside it -- decided below.
        }
        if !inside {
            continue
        } else {
            // Inside the argument list.
        }
        if leaf_kind(c) == TokenKind.RParen {
            return out
        } else {
            // Still inside.
        }
        match c.ident_str() {
            Some(t) => { out.push(t) }
            None => {}
        }
    }
    out
}

/// Does this declaration's gate name `word`? The question the slot judge asks,
/// kept as a door so "is the type opted into Display" has ONE spelling.
#realtime nogc
export fn gate_names(gates []str, off int, cnt int, word str) -> bool {
    for i in 0..cnt {
        if gates[off + i] == word { return true }
    }
    false
}

/// ONE reading of "whose attribute is this", for any attribute.
///
/// `arg` EMPTY means the attribute is matched by NAME alone (`#coerce`).
/// A non-empty `arg` additionally requires EVERY protocol in the argument list
/// to be that word -- so `#impl(Display)` marks and `#impl(Display + Serialize)`
/// does NOT. That asymmetry is the owner's correction of 2026-09-18: reading
/// the gate as "is Display AMONG them" would silently ignore an opt-in this
/// compiler does not honour, and an opt-in half-read is worse than refused.
fn attr_marked(kids []Node, attr str, arg str) -> []NodeId {
    mut out = []NodeId.new()
    mut pending = false
    for c in kids {
        if c.kind_of() == NodeKind.AttrDecl {
            ro achildren = branch_children(c)
            pending = attr_kids_name(achildren, attr) &&
                      (arg == "" || attr_args_all(achildren, arg))
            continue
        }
        if pending {
            out.push(c.id_of())
        } else {
            // No attribute stood before this declaration.
        }
        // The mark is CONSUMED by the declaration it marked: the next one is
        // unmarked unless it carries its own attribute.
        pending = false
    }
    out
}

/// Is this declaration one of the marked ones? The other half of the same
/// reading, for a collector that has a node and a list.
#realtime nogc
fn is_attr_marked(marked []NodeId, id NodeId) -> bool {
    for m in marked {
        if m == id { return true }
    }
    false
}

/// Register the pair a `#coerce` declaration declares (D429 V1, form-source):
/// receiver -> return, performed by this row.
///
/// R1 (unary source form) is the ONE rule enforced here, because it is the one
/// this registry can see: a method with the receiver and nothing else. A form
/// outside V1 registers no pair, so a call that would need it is refused as an
/// ordinary type mismatch rather than accepted by a rule novac cannot check.
/// R2 (the zero-cost lanes) and R3 (one declaration per pair) are NOT judged
/// here: the row does not carry parameter modes, so `consume` and `ro` are
/// invisible to it -- named in plan 274 section 9.1d, not left to be discovered.
export fn harvest_coerce_pair(fns FnTable, mut coerces []CoercePair, via_row FnRow) -> () {
    ro fd = fns.rows[raw_row(via_row)]
    if !fd.has_recv || fd.param_cnt != 1 || !is_ty(fd.ret_id) {
        return
    } else {
        // A no-parameter method with a declared return: the source form D429
        // V1 admits, and both ends of the pair are right here.
    }
    coerces.push(CoercePair { from_id: fns.params[fd.param_off].type_id, to_id: fd.ret_id, via_row })
}

