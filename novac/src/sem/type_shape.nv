// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/sem/type_shape.nv -- what a resolved TYPE TERM looks like: the
// questions both phases ask about a `TyId` and neither may answer twice.
//
// Donor: rustc `Ty::kind()` accessors plus the `ty::util` predicates -- the
// shape of a type is ASKED of the term, and each question has exactly one
// implementation that every consumer shares; NOT taken: a `TypeFolder`/visitor
// framework, because novac's subset asks three fixed questions and a framework
// would be a mechanism with no question (K7).
// Role: layer 3 -- doors over a type TERM: does it carry exactly one argument,
//   is it the language's Option (and what is its payload), what does a for-head
//   hand out per step. Written once, asked by the checker AND the emitter.
// Used by: check/type_of.nv, check/typing.nv, check/methods.nv, check/exprs.nv
//   (the judges) and emit_c/emit_flow.nv (the spelling, lower_for_each).
// Guarded by: check-novac-second-door.py (these three exist because the same
//   question was spelled twice before), check-novac-surface.py (their move out
//   of `check` raised the sem base, named in that baseline).
//
// WHY A FILE AND NOT `mangle.nv`, where `shape_of`/`is_tuple` already sit: that
// file's role line says MANGLING -- every C identifier as a function of the
// entity -- and the type-shape questions drifted in there for want of a home.
// This is the home. Moving `shape_of` and its neighbours here is the next
// tenant's job and NOT this wave's: they have thirty-odd call sites, and mixing
// that move with a behaviour wave would put two risks in one merge.
//
// Split out of check/type_of.nv on 2026-09-04 (wave 274.6 V3-4a): the emitter
// was recomputing a for-head's element type with a raw interner call while the
// checker asked the door -- the same judgment written twice, which is what the
// second-door guard exists to stop. `emit_c` imports `check` nowhere (measured,
// not assumed), so the door had to rise to the layer both phases share.

module novac.sem

import ../tree.{Node}
import ../types.{TyId, no_ty, is_ty, Interner}
import ../builtins.{TypeKind, OPTION_SUM, OPTION_SOME_VARIANT, RESULT_SUM, RESULT_OK_VARIANT, RESULT_ERR_VARIANT}
import ../builtins.{BuiltinType, prim_row}

/// The ONE type argument of an arity-one instance, or no type: the question
/// both the for-head judge and the Option judge ask (the second-door guard
/// caught them spelled twice, 2026-09-02). Anything that is not an App of
/// arity one answers nothing; the caller turns that into its named refusal.
fn single_type_arg(ctx Ctx, t TyId) -> TyId {
    if !is_ty(t) { return no_ty() }
    ro k = ctx.tys.kind_of(t)
    ro is_app = match k {
        TkApp => true
        // TkEffect: an effect is not an application -- no single type argument.
        TkPrim | TkRecord | TkSum | TkParam | TkInfer | TkNewtype | TkTuple | TkEffect | TkPtr => false
    }
    if !is_app { return no_ty() }
    if ctx.tys.arg_count(t) != 1 { return no_ty() }
    ctx.tys.arg(t, 0)
}

/// The PAYLOAD an Option instance carries, or no type: the single-argument
/// door, gated on the head being the language's Option sum.
export fn option_payload(ctx Ctx, t TyId) -> TyId {
    ro arg = single_type_arg(ctx, t)
    if !is_ty(arg) { return no_ty() }
    if decl_of_ty(ctx, t).name != OPTION_SUM { return no_ty() }
    arg
}

/// Is this pattern `Some(..)` over an Option -- the one test the Option door
/// keeps its own spelling for (`if Some(x) = ..`, lower's `Cond.IsSome`).
export fn is_option_some_pattern(ctx Ctx, pat Node, t TyId) -> bool =>
    is_ty(option_payload(ctx, t)) && pattern_head_text(pat) == OPTION_SOME_VARIANT

/// THE VARIANT THAT CARRIES A VALUE in a container `??` unwraps -- `Some` for `Option`,
/// `Ok` for `Result` -- or no variant when this type is not such a container.
///
/// THE ONE HOME OF D86's LIST. The decision reads: «`expr ?? fallback`: if `expr` is
/// `Some(v)` OR `Ok(v)`, returns `v`» (04-effects.md:5222). Before this door that list
/// existed as a single comparison against `OPTION_SUM` inside `option_payload`, which is
/// how half the decision came to be implemented without anyone declaring the other half
/// missing (registry 1084).
///
/// The ARITY is checked with the name because it is part of what the name means here: an
/// `Option` of two arguments is not the language's Option, and answering for it would
/// hand the caller a payload from a type nobody declared.
export fn coalesce_ok_variant(ctx Ctx, t TyId) -> VariantRow {
    if !is_ty(t) { return no_vrow() }
    ro k = ctx.tys.kind_of(t)
    ro is_app = match k {
        TkApp => true
        // TkEffect: an effect is not an application -- no `??` container answer.
        TkPrim | TkRecord | TkSum | TkParam | TkInfer | TkNewtype | TkTuple | TkEffect | TkPtr => false
    }
    if !is_app { return no_vrow() }
    ro decl = decl_of_ty(ctx, t)
    ro name = decl.name
    ro arity = ctx.tys.arg_count(t)
    // THE VARIANT REGISTRY IS KEYED BY THE DECLARATION, not by the instance: a row
    // carries the sum term a declaration interned (`TypeDef.ty_id`), while `t` here is
    // an application of it (`Option[int]`). Passing the instance answers None for every
    // container -- which is exactly what the control half of the probe caught, by
    // reddening the Option case this wave must not touch.
    ro sum_t = decl.ty_id
    if name == OPTION_SUM && arity == 1 {
        return variant_in_sum(ctx, sum_t, OPTION_SOME_VARIANT) ?? no_vrow()
    }
    if name == RESULT_SUM && arity == 2 {
        return variant_in_sum(ctx, sum_t, RESULT_OK_VARIANT) ?? no_vrow()
    }
    no_vrow()
}

/// THE FAILING VARIANT of a `Result` instance -- `Err` -- or no variant when `t` is
/// not the language's `Result`. Asked by `x?` (D85), whose failing branch reads the
/// operand's `Err` payload and builds the `Err` of the body's own `Result`; the
/// container test stays `coalesce_ok_variant`'s, so the two cannot disagree on
/// what a `Result` is.
export fn result_err_variant(ctx Ctx, t TyId) -> VariantRow {
    if !is_vrow(coalesce_ok_variant(ctx, t)) || is_ty(option_payload(ctx, t)) { return no_vrow() }
    variant_in_sum(ctx, decl_of_ty(ctx, t).ty_id, RESULT_ERR_VARIANT) ?? no_vrow()
}

/// The ERROR type `E` of a `Result[T, E]` instance, `no_ty()` for any other type.
export fn result_error(ctx Ctx, t TyId) -> TyId {
    if !is_vrow(result_err_variant(ctx, t)) { return no_ty() }
    ctx.tys.arg(t, 1)
}

/// THE PAYLOAD such a container carries -- the type `??` yields, and the type the
/// fallback is checked against.
///
/// It asks `coalesce_ok_variant` rather than repeating the list: two doors that each
/// know which types are containers part on the first edit, and this whole wave exists
/// because one such list was written in one place and read as if it were the decision.
/// Argument ZERO for both containers: `Option[T]` carries T, and `Result[T, E]` carries
/// T in its `Ok` -- the failing side is absorbed (D86), so nothing here reads E.
export fn coalesce_payload(ctx Ctx, t TyId) -> TyId {
    if !is_vrow(coalesce_ok_variant(ctx, t)) { return no_ty() }
    ctx.tys.arg(t, 0)
}

/// AN APPLIED SUM WHOSE TAGS THE SHELL SPELLS: the language's `Option[T]` or
/// `Result[T, E]`, and nothing else.
///
/// THE ONE HOME OF THE LIST, asked by the checker (may a `match` on this
/// scrutinee pass?) and the emitter (whose spelling is the tag test?), so the
/// two cannot disagree -- the class the registry calls O-1. An applied sum
/// comes from the SHELL: its C is the oracle's monomorphised instance, and
/// novac's own `NOVAC_TAG_<module><Sum>_<Variant>` names nothing there
/// (measured on `Option[int]`: `_novac_l2->tag == NOVAC_TAG_p1_Option_None`,
/// an undeclared constant behind a pointer access to a value struct). The two
/// sums named here are the ones whose instances the shell spells by name --
/// `NovaOpt_<T>` (emit_option.nv) and `NovaRes_<T>_<E>` with `NOVA_TAG_Result_*`
/// (shell.tpl.c, `nova_make_NovaRes_..._Ok`). Every other applied sum the
/// declarations hand over (`Outcome[T]` of the prelude) is spelled by the shell
/// WITHOUT a per-instance struct, and stays refused by name until it is read.
///
/// The ARITY is part of the name for the reason `coalesce_ok_variant` gives.
export fn is_shell_applied_sum(ctx Ctx, t TyId) -> bool {
    if !is_ty(t) { return false }
    if ctx.tys.kind_of(t) != TypeKind.TkApp { return false }
    ro head = decl_of_ty(ctx, t)
    if head.kind != TypeKind.TkSum { return false }
    ro arity = ctx.tys.arg_count(t)
    (head.name == OPTION_SUM && arity == 1) || (head.name == RESULT_SUM && arity == 2)
}

/// The ELEMENT a for-head vector carries: the single-argument door under its
/// wave's name (B16) -- the head kind was already judged by the caller
/// (`check/typing.nv:680`).
export fn for_head_elem(ctx Ctx, t TyId) -> TyId => single_type_arg(ctx, t)

/// Is this the UNIT type -- the `()` a callable declares when it returns
/// nothing? Answered by IDENTITY with the seeded prim (`Prims.unit_id`, the
/// same shape `int_id` and `char_id` take), not by a declaration's name: a
/// primitive names no declaration -- its head is a universe ordinal -- and the
/// first version of this door asked `decl_of_ty` and iced on every callable.
///
/// Asked by the emitter to decide whether a body has a TAIL VALUE. Until
/// 2026-09-04 it decided that by "this is not main" -- a second rule beside
/// the checker's `declares_a_value` -- and the two diverged on every unit
/// callable whose last statement is an expression: `return println(1);` was
/// emitted and the println call had no callee to name. One question, one
/// door; the checker's tree-level rule and this type-level one read the same
/// declaration.
export fn is_unit_ty(ctx Ctx, t TyId) -> bool {
    if !is_ty(t) { return false }
    t == ctx.prims.unit_id
}

/// THE UNIVERSE ROW behind a type TERM -- family, width, signedness, both
/// spellings -- or nothing when the term is not a primitive. The one door the
/// family questions below share: a primitive's head is its universe ordinal
/// (`Interner.prim`), and the ordinal indexes the ONE table in `builtins`.
///
/// Why a door over the ROW and not a set of ids in `Prims` (registry #910,
/// 2026-09-04): until this door the checker asked "is this an integer" as
/// `t == prims.int_id`, so ten of the sixteen primitives -- every integer width,
/// `uint`, `f32` -- fell out of literal typing, arithmetic, comparison and
/// printing at once, while the oracle compiled them all. A predicate that lists
/// members by id is a copy of the table; a predicate that READS the table has
/// nothing to drift. Takes the interner rather than `Ctx` because the resolver
/// asks it too, and the resolver holds only the interner.
export fn prim_row_of(tys Interner, t TyId) -> Option[BuiltinType] {
    if !is_ty(t) { return None }
    // One kind is asked about, so one comparison -- not an exhaustive match
    // over eight kinds that would spell every other one here for no reason.
    if tys.kind_of(t) != TypeKind.TkPrim { return None }
    Some(prim_row(tys.prim_ordinal_of(t)))
}

/// Is this term an INTEGER primitive of any width or signedness (D405's "the
/// same concrete integer type" is asked of two of these; D227's literal rule
/// asks it of the target)?
export fn is_int_prim(tys Interner, t TyId) -> bool {
    match prim_row_of(tys, t) {
        Some(r) => row_is_int(r)
        None => false
    }
}

/// Is this term a FLOAT primitive (`f32` or `f64`)?
export fn is_float_prim(tys Interner, t TyId) -> bool {
    match prim_row_of(tys, t) {
        Some(r) => row_is_float(r)
        None => false
    }
}

/// The family questions asked of a ROW -- one `match` each, in their own
/// functions, because a `match` nested inside an arm is a form novac does not
/// read about itself yet (274.5), and this file is part of what it reads.
fn row_is_int(r BuiltinType) -> bool {
    match r.family {
        PfInt => true
        PfFloat | PfStr | PfBool | PfChar | PfUnit | PfAny | PfNever => false
    }
}

/// Is this row a FLOAT family row (`f32`, `f64`)? The twin of `row_is_int`.
fn row_is_float(r BuiltinType) -> bool {
    match r.family {
        PfFloat => true
        PfInt | PfStr | PfBool | PfChar | PfUnit | PfAny | PfNever => false
    }
}

/// Is this term a NUMERIC primitive -- what arithmetic and ordering accept
/// (D363: primitives dispatch built in, no protocol call)?
export fn is_numeric_prim(tys Interner, t TyId) -> bool =>
    is_int_prim(tys, t) || is_float_prim(tys, t)

/// May a BARE NUMERIC LITERAL stand in a position of this type (D227 rule 2)?
/// An integer literal takes any integer width; a float literal any float width.
/// Measured 2026-09-04: the oracle also lets an INTEGER literal stand in a
/// `f64` position (`fn f(x f64)` + `f(1)` builds and prints `1`), so an integer
/// literal admits a float target as well -- the rule's "numeric target" is read
/// as written. The range rule (D227 rule 3) is not asked here: admission is the
/// resolver's question, the range is the checker's, once the binding is known.
export fn lit_admits(tys Interner, lit LitArg, want TyId) -> bool {
    // A NEWTYPE over a number takes the literal by its representation's rule
    // (D489 "where it applies"; D55 amendment 2026-08-21): `branch(0, ..)` with
    // `id NodeId`. Until part 8 of p274-carina-k1 only a call with ONE row let
    // it through (the argument's expectation, check/arg_expect.nv); an overload
    // set asked this door, and `NodeId` is no numeric primitive.
    if is_ty(want) && tys.kind_of(want) == TypeKind.TkNewtype && tys.arg_count(want) == 1 {
        return lit_admits(tys, lit, tys.arg(want, 0))
    }
    match lit {
        NotLit => false
        IntLitArg => is_numeric_prim(tys, want)
        FloatLitArg => is_float_prim(tys, want)
    }
}

/// Is `t` the top type `any` (D53)? The family of its universe row says so.
export fn is_any_ty(tys Interner, t TyId) -> bool {
    if !is_ty(t) || tys.kind_of(t) != TypeKind.TkPrim { return false }
    match prim_row(tys.prim_ordinal_of(t)).family {
        PfAny => true
        PfInt | PfFloat | PfStr | PfBool | PfChar | PfUnit | PfNever => false
    }
}

/// Is `t` the bottom type `never` (D26)? The family of its universe row says so.
/// A value of it never exists, so it is compatible with every expected type.
export fn is_never_ty(tys Interner, t TyId) -> bool {
    if !is_ty(t) || tys.kind_of(t) != TypeKind.TkPrim { return false }
    match prim_row(tys.prim_ordinal_of(t)).family {
        PfNever => true
        PfInt | PfFloat | PfStr | PfBool | PfChar | PfUnit | PfAny => false
    }
}
