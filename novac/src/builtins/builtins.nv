// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_span::sym` + Go `types.Universe` — the universe of
// Role: the universe — the ONE table of pre-declared names and primitive ABI facts the compiler reads (П5).
// Used by: sem seeds the registry from it, mangle asks prim_c_name (E1+); grows only when the language's universe
// grows.
// Guarded by: check-novac-no-name-hardcode.py (std names only here), check-novac-no-prelude-shadow.py,
// check-novac-mangle-fixed-point.sh (prim_c_name matches nova_rt.h).
// pre-declared names lives in ONE table the compiler reads, never a scattering
// of string literals (П5); NOT taken: rustc's symbol interning (names here are
// four).
// novac/src/builtins — THE ONE FILE where names of the language may appear as
// string literals (convention P5, guard check-novac-no-name-hardcode.py; owner
// 2026-08-15). What is legitimate here, by the reference compilers (rustc
// `sym`/LangItem, Go `types.Universe`, Zig builtins): (a) the universe —
// primitive types with their runtime ABI spelling; (b) language entry
// points the compiler itself must know (main, the println statement form).
// What is NOT legitimate here (and what was REMOVED 2026-08-16 by the owner's
// rule «no temporary hardcode»): names of std types and methods — they are
// DECLARATIONS, read by `sem` from the signatures handed to novac; instances
// of generics (they come from `mono`); and C names of anything but primitives
// (they come from the mangling door, `sem/mangle`).
//
// Its own module (the rustc_span::sym model): every layer that must SPELL a
// name imports this leaf — check, sem, emit_c — and no edge points back.

module novac.builtins


/// What a registry type IS — selects which row table the off/cnt range
/// addresses (record -> fields, sum -> variants; primitives own no rows).
/// Lives here, not in sem, because the builtin seed rows carry it and sem
/// imports builtins (no back edge).
#impl(Equal)
export type TypeKind enum
    | TkPrim /// a primitive of the universe: int, str, bool, f64
    | TkRecord /// a nominal record declaration, no type parameters applied
    | TkSum /// a nominal sum declaration, no type parameters applied
    | TkApp /// a type constructor applied to arguments: Vec[int] (E2-b1)
    | TkParam /// a type parameter of the enclosing declaration, by index (E2-b1)
    | TkInfer /// an inference variable, alive only inside one body (E2-b1)
    | TkNewtype /// a NEWTYPE: a distinct nominal type over a representation (`type Row int`), its underlying type in the interner's args
    | TkTuple /// a structural TUPLE (D123): head = ARITY, components in the interner's args -- no declaration, its identity IS its components (B15 step 3)
    | TkPtr /// a raw POINTER (D216): `*T` and `*mut T` -- head = 1 for `*mut`, 0 for `*T`; the pointee in the interner's args (274.11 E.10 step 3: std's `Vec[T]` body reads `@data *mut T`)
    | TkEffect /// an EFFECT declaration (E4 wave, 274.11): `type Fs effect { ... }` -- the marker kind: owns operation rows, not field/variant rows; values of handler type are typed by the `with` doors, the term reuses the Record interning until the Effect-type stage lands (named in the with-typing wave)

/// How many kinds there are. The interner's bucket arithmetic multiplies by
/// this, so it lives NEXT TO the enum it counts (owner's question 2026-08-16:
/// "what is that 6?" — a magic constant one file away from its source is the
/// first thing to drift when a kind is added). Every dispatch on TypeKind is
/// an exhaustive match, so a tenth kind is a compile error at each site —
/// and this constant is the ONE place a match cannot reach, hence the note.
export const TYPE_KIND_COUNT = 10

/// Name of the program entry function.
export const ENTRY_FN = "main"

/// Name of the print statement the subset understands (a statement form
/// today, not a std function — the one println the runtime prints through).
export const PRINT_FN = "println"

/// The print statement WITHOUT the closing newline (`print("a|")`): the same
/// statement form as `println` -- the oracle's `emit_println(.., newline:
/// false)` -- lowered by the same door (registry 1703).
export const PRINT_PIECE_FN = "print"

/// Is `name` one of the two print statements, `println` or `print`?
export fn is_print_fn(name str) -> bool => name == PRINT_FN || name == PRINT_PIECE_FN

/// The intrinsic that yields the location of the expression it stands in
/// (D468). Named here rather than spelled at the rule that admits it, because
/// this file is where a name the compiler must know itself belongs (P5).
///
/// It is the ONE call the subset takes as a parameter's default value, and the
/// reason is the exact inverse of the rule that refuses every other expression
/// there: a default is emitted INSIDE THE CALLER, so the subset admits only
/// forms that mean the same in both places -- while `caller_loc()` exists
/// precisely to mean the CALLER's place, and that is its whole work. Registry
/// #1146. The oracle draws the same line (`callnorm.rs:842`, `is_bare_caller_loc`):
/// the BARE call only, a nested one left to a later stage.
export const CALLER_LOC_FN = "caller_loc"

/// The Option FAMILY (if-let wave): the language's sum name and the shell's
/// C family prefix (`NovaOpt_<elemC>`, by value) plus the Some tag constant.
/// P5: names live here; the mangle door spells, the emitter reads.
/// The ORACLE's C prefix for a record declared in the parenthesised form
/// (`type Pair(x int, y int)` becomes `struct NovaTuple_Pair`). Measured off
/// its own emission 2026-09-03, not chosen: our C links into its shell, so the
/// spelling is the fixed point's (P25), and by P5 an ABI name lives in this
/// registry as data -- written ONCE, asked by the mangling door.
///
/// This is also the ONE line of novac that spells the word the owner's rule of
/// 2026-09-03 reserves to their approval; keeping it here is what makes that
/// line auditable instead of scattered through the mangler.
export const PAREN_RECORD_C_PREFIX = "NovaTuple_"

/// The HANDLER constructor's name: `Effect[Fs]` is the type of a handler value
/// for effect `Fs` (D459). One spelling, read by the seed in sem and by the
/// mangler that spells the handler's C type (E.9 step 2, 274.11).
export const HANDLER_CTOR = "Effect"

export const OPTION_SUM = "Option"
/// The prelude's range record (`std/src/collections/range/core.nv`): a slice
/// `x[lo..hi]` is the call `x.index(Range { start: lo, end: hi })` (D470 section 5),
/// so the emitter builds one. Its C type comes from the registry through `c_type`;
/// only the LANGUAGE name is data here (plan 274.7 wave U).
export const RANGE_TYPE = "Range"
export const OPTION_FAMILY_C = "NovaOpt_"
export const OPTION_SOME_TAG_C = "NOVA_TAG_Option_Some"
/// The shell's tag of an absent Option (read off shell.tpl.c, wave W4): the
/// emitter builds `None` as a compound literal carrying it.
export const OPTION_NONE_TAG_C = "NOVA_TAG_Option_None"
export const OPTION_SOME_VARIANT = "Some"

/// THE OTHER CONTAINER `??` UNWRAPS (D86: the operator is a fallback for `Result` AND
/// `Option`). Written 2026-09-13 for registry 1084: `Result` had no name here at all,
/// while `Option` had five -- the same halfness that row records. Only the two names
/// the wave reads are added: a C tag and a family prefix would be fields nobody reads,
/// because the tag of a variant is printed through `c_tag(ctx, vrow)` from the registry.
export const RESULT_SUM = "Result"
/// The variant that CARRIES A VALUE, as `Some` does for `Option` -- what `??` unwraps
/// and what `match` tests. `??` ABSORBS the error (D86) and never names its twin.
export const RESULT_OK_VARIANT = "Ok"
/// The FAILING variant: `x?` over a `Result` (D85) reads its payload and returns an
/// `Err` of the body's own `Result` -- the one reader of the name (task #15).
export const RESULT_ERR_VARIANT = "Err"
/// The shell's family prefix of a `Result` instance (read off shell.tpl.c,
/// 2026-10-01): `NovaRes_<T>_<E>`, a GC pointer -- unlike `NovaOpt_`, which the
/// shell passes by value. The carrier arrived with the `match` on an applied
/// sum: a `Result` a std call hands back is now a scrutinee, so its C type is
/// asked for the first time.
export const RESULT_FAMILY_C = "NovaRes_"

/// The vector length method the for-over-a-call emission walks with (B16
/// wave, P5: std names live here, the emitter must not spell them itself).
export const VEC_LEN_METHOD = "len"

/// D432: the method a must-consume type declares to become AFFINE -- an owned value
/// of it left unconsumed gets this call, with the exit's outcome.
export const CLEANUP_METHOD = "cleanup"

/// D432: the type of `@cleanup`'s one parameter, and the variant a normal exit
/// passes (std's prelude, `ScopeOutcome enum Success | ...`).
export const SCOPE_OUTCOME_TYPE = "ScopeOutcome"
export const SCOPE_OUTCOME_SUCCESS = "Success"
/// The outcome of an exit that leaves with an error: `?` over a `Result` at `Err(e)` (D314
/// amended 2026-10-03), its payload the error boxed into `any`.
export const SCOPE_OUTCOME_FAILURE = "Failure"
/// The first runtime type id novac gives a type with no FIXED id (`nova_rt/typeid.h` fixes
/// seven primitives; the oracle numbers the rest per compilation unit from 17): 2^30, a
/// range no oracle unit reaches. Read by the `any` box of `Failure(e)` (emit_flow.nv).
export const NOVAC_TID_BASE = 1073741824
/// The DIRECT element read (`v[i]`'s method, panics on OOB): for the access
/// whose in-range is already proven -- a match arm's length test over an
/// array pattern. `get` is for the access nobody proved (D470: it answers
/// Option), and `for x in xs` is the iterator protocol, not either door.
export const VEC_INDEX_METHOD = "index"
/// The WRITE `xs[i] = v` as an implicit vector operation: the overload
/// `mut @index(i int, val T)` of the same name (std access.nv, "Powers
/// `v[i] = val`"). A KEY of the operation, not a name of the language -- `=`
/// cannot stand in an identifier, so no method can collide with it; the
/// method it calls is `vec_op_method`'s answer (registry 1524: the read and
/// the write are two overloads, and asking by the name sent the write to the
/// read).
export const VEC_INDEX_SET_OP = "index="

/// The SLICE `xs[lo..hi]` as an implicit vector operation: the overload
/// `@index(r Range) -> Self` of the same name (D470 section 5), made from std's
/// body where the shell lacks it (registry 1557). A key, like `index=`: `.`
/// cannot stand in an identifier.
export const VEC_INDEX_RANGE_OP = "index.."

/// Is this implicit operation key an OVERLOAD of another name -- one with no
/// by-name spelling of its own (the bare name is the other overload's)?
export fn vec_op_is_overload(op str) -> bool => op == VEC_INDEX_SET_OP || op == VEC_INDEX_RANGE_OP

/// The METHOD NAME an implicit vector operation key calls: the key itself,
/// except for the write and the slice, which are overloads of `index`.
export fn vec_op_method(op str) -> str => if vec_op_is_overload(op) { VEC_INDEX_METHOD } else { op }
/// The raw-pointer READ of D216 (the "all through methods" amendment):
/// `p.read_at(i) -> T`, legal only inside `unsafe { }` -- std's `Vec[T]` body
/// reads its elements so (`unsafe { @data.read_at(i) }`, 274.11 E.10 step 3c).
export const PTR_READ_AT = "read_at"

/// `p.offset(n) -> *T` (D216): the pointer `n` elements on, of the same type --
/// std's `Vec[T] @index(r Range)` builds its view's data with it (registry 1557).
export const PTR_OFFSET = "offset"

/// `p.dist(q) -> int` (D216, the methods amendment): the SIGNED element count
/// from `q` to `p`, replacing the retracted `p - q` -- source/source.nv measures
/// a slice's offset in its text with it.
export const PTR_DIST = "dist"

/// `p.write_at(i, v)` on a `*mut T` (D216): store the element at index `i`; unsafe context only.
export const PTR_WRITE_AT = "write_at"

/// `p.write_consume_at(i, v)`: `write_at` that MOVES `v` in -- the consuming store (D216, D156); the same bits in C.
export const PTR_WRITE_CONSUME_AT = "write_consume_at"

/// Is `name` one of the raw-pointer methods of D216 -- `read_at`, `write_at`,
/// `write_consume_at`, `offset`, `dist`? ONE answer for the two walks that ask it
/// (registry 221.1 #1539): the typing of a pointer's method (check/unsafe.nv)
/// and the subset walk's "is this a method novac knows" (check/rules.nv). The
/// second knew only the names std DECLARES, and passed `read_at`/`offset` by
/// coincidence (std has `File @read_at`, `ZonedDateTime @offset`) while
/// refusing `write_at` -- unseen while an instance skipped that walk.
export fn is_ptr_method(name str) -> bool =>
    name == PTR_READ_AT || name == PTR_WRITE_AT || name == PTR_WRITE_CONSUME_AT || name == PTR_OFFSET ||
        name == PTR_DIST

/// `size_of[T]()`: the byte size of `T`'s value, an `int` -- the language's intrinsic (D216).
export const SIZE_OF_FN = "size_of"

/// `embed("path")`: the bytes of a file, read at compile time, as `[]u8` -- the
/// language's intrinsic (D412).
export const EMBED_FN = "embed"
/// The element type of the `[]u8` an `embed` call is (D412).
export const BYTE_TYPE = "u8"

/// `assert(cond)` / `assert(cond, msg)`: the prelude's runtime check (D81),
/// declared `extern "nova"` -- no body, so the call is the language's intrinsic.
export const ASSERT_FN = "assert"

/// The upper bound an open slice `x[lo..]` takes: the second method of std's
/// `RangeIndex` role beside `index(r Range)` -- the receiver's OWN answer, not
/// a `len` field (plan 284; `std/src/collections/vec/slice.nv`,
/// `std/src/runtime/string/slice.nv`).
export const END_INDEX_METHOD = "end_index"

/// The method `==` lowers to. A NAME OF THE LANGUAGE, so it lives here with
/// the others (P5): the emitter must not spell std names itself, and the
/// registry is asked for the row under this name.
export const EQUAL_METHOD = "equal"

/// The method a `for` over an ITERATOR calls each turn (D58: `Iter[T]` is
/// `mut next() -> Option[T]`). A name of the language, beside `equal` (P5).
export const NEXT_METHOD = "next"

/// The method an ORDERING lowers to (`a < b` is `a.@compare(b) < 0`, D46). A
/// name of the language, beside `equal`, for the same reason (P5).
export const COMPARE_METHOD = "compare"

/// The attribute that declares an implicit conversion (D429): `#coerce` on a
/// no-parameter method makes `receiver -> return` an implicit pair. A NAME OF
/// THE LANGUAGE, so it lives here and nowhere else (P5) -- D429 is emphatic
/// that not one pair may be hard-coded in a compiler, and the same holds for
/// the word that declares them.
export const COERCE_ATTR = "coerce"

/// The `#realtime` attribute (D172, `06-concurrency.md:5499`), optionally with
/// its `nogc` modifier (amendment #273). novac READS it and enforces nothing:
/// the guarantee is about what a body may CALL, and the subset compiles no
/// effect machinery. Measured 2026-08-29: the oracle accepts an allocating
/// body under `#realtime nogc`, so reading-and-ignoring matches the fixed
/// point of behaviour exactly -- the day the oracle starts enforcing it, the
/// differential corpus reddens and this decision comes back.
export const REALTIME_ATTR = "realtime"

/// The CONTEXTUAL mode word of the language -- the one a token kind cannot
/// answer for.
///
/// A mode qualifies a parameter (`mut v int`) and a receiver
/// (`fn StringBuilder consume @into_str()`). The set is closed and measured
/// against the oracle rather than assumed; the measurement and what it cost are
/// written out at `sem/slots.nv`'s `is_param_mode`.
///
/// The axis is exactly THREE modes -- `ro`, `mut`, `consume` -- and only one of
/// them lives here. `mut` and `ro` are KEYWORDS: the lexer owns those spellings
/// and hands out `KwMut`/`KwRo`, so a reader asks the token kind and repeating
/// the words here would be the copy P5 exists to prevent. `consume` is an
/// ordinary identifier to the lexer, so only its spelling identifies it -- and a
/// spelling of the language lives HERE, which is why the parser has an edge to
/// this module at all.
///
/// `uninit` is NOT here, and that is a measurement of 2026-08-21, not a taste:
/// the oracle answers "expected identifier, got `uninit`" to `fn f(uninit v T)`
/// and accepts `fn f(v uninit T)`. It is a qualifier of the TYPE (`uninit T`,
/// the MaybeUninit wrapper) and of a pointer's pointee, where it does combine
/// with a mode -- `*mut uninit T` (D-amendment 2026-08-05, No 358: a bare
/// `*uninit T` is not writable). Treating it as a mode would have made novac
/// ACCEPT a parameter form the language does not have.
// THE MODE WORDS ARE NOT HERE, and that is the decision rather than an
// oversight (2026-08-23): all three lex as keywords, so the only place that
// needs their spelling is the lexer's own word-to-token table, and the only
// question anyone else asks is about a token KIND (`sem.mode_of_leaf`).
// `is_contextual_mode_word` and `CONSUME_MODE` stood here while `consume` was
// read by spelling; both are gone with that premise.

/// The word that turns a type declaration into an ALIAS rather than a newtype:
/// `type Row alias int` is `int` under a second name, while `type Row int` is a
/// DISTINCT type over the same representation (measured by the integrator
/// 2026-08-21: the oracle enforces the distinction -- `Row` into an `int`
/// parameter is E7301).
///
/// A NAME OF THE LANGUAGE, so it lives here (P5), next to `enum` -- the other
/// word that decides what a `type` declaration means.
/// The word that makes a type declaration a SUM: `type Colour enum Red | Green`.
/// It stood as a bare literal in the parser until 2026-08-23, when the door that
/// asks about a marker made the four of them one shape -- and a name of the
/// language spelled in the parser is exactly what P5 forbids.
export const SUM_MARKER = "enum"

export const ALIAS_MARKER = "alias"

/// The word that makes a record a VALUE: `type Point value { x int, y int }`.
/// It changes the LAYOUT -- a value record lives inline where a plain one is a
/// GC pointer -- so it changes the C type, the field access and the
/// construction. D241 fixes the order of type modifiers (`value priv` is canon),
/// which is why it is read in the marker position and not in the tail.
export const VALUE_MARKER = "value"

/// The field-privacy marker of a type declaration (D281): `type X priv { }`,
/// `type X priv(type) { }`, `type X priv(file) { }`. Read as a leaf plus an
/// optional balanced qualifier group, exactly like `value` plus a tuple; the
/// subset records the form and does not judge it yet -- novac compiles one
/// file, and inside one module a `priv` field is readable by D47, so there is
/// nothing to refuse until cross-module compilation arrives.
export const PRIV_MARKER = "priv"

/// The word that LIFTS a type-level `priv` off one field (D220): `pub ro tag str`
/// inside `type Secret priv { .. }`.
const PUB_MARKER = "pub"

/// Is this word a field's VISIBILITY modifier (D220: `priv` or `pub`, written
/// before the field's mode and name -- `priv mut money f64`)? Both are reserved
/// words, so a leaf spelled so at the head of a field is always the modifier,
/// never the field's name. Asked by the field reader, by `field_name_at` and
/// by the collector.
export fn is_field_visibility_word(text str) -> bool => text == PRIV_MARKER || text == PUB_MARKER

/// The word that marks a PROTOCOL declaration: `type Sized protocol { ... }`.
///
/// A contextual word like `alias` and `enum`, not a keyword -- the lexer knows
/// none of the three. It lives here because P5 keeps every name of the language
/// in one registry: the parser asks, it does not spell.
export const PROTOCOL_MARKER = "protocol"

/// The word that marks an EFFECT declaration: `type Counter effect { ... }`
/// (spec/effects.ru.md; kind-token position, `02-types.md` D53). A contextual
/// word beside `protocol`, read the same way -- until this the parser had no
/// idea `effect` was anything but an ordinary type name, and `type Counter
/// effect { ... }` was read as the alias form `type Name Y`, refusing `effect`
/// as an undeclared type (registry TBD, found 2026-09-20 surveying rung 0.3).
export const EFFECT_MARKER = "effect"

/// The name the RECEIVER is bound under inside a method body: `@`.
///
/// Not an invented word (`self`, `this`, `nova_self`) but the symbol the
/// language itself uses -- and one no identifier can collide with, because the
/// lexer never produces `@` as an identifier. So the receiver is an ordinary
/// binding in scope, `@field` is a field access on it, and nothing needs a
/// second mechanism.
/// The head the slice sugar desugars to: `[]T` IS `Vec[T]` (D239 -- a type
/// alias, not a distinct container). A name of the LANGUAGE, so it lives here
/// (P5): the resolver asks the registry for this head by name, and a hard-coded
/// "Vec" at the resolution site is exactly what the name-hardcode guard exists
/// to stop.
export const SLICE_HEAD = "Vec"

/// The std constructor the TYPED array literal is written with: `[]int.of(7, 8)`.
/// Not a word of the language grammar but the one spelling the subset reads as
/// a literal -- and a spelled name lives here (P5), so a second reader cannot
/// drift from the first.
export const LITERAL_CTOR = "of"

/// The std constructor of an EMPTY vector: `[]int.new()` (registry 221.1 #1457).
/// Not a literal -- it takes no elements and pushes nothing -- but it is built
/// through the same two names a literal is (the shell's instance constructor,
/// capacity zero), so the checker reads it beside `of` and the emitter prints
/// it with the same door. The oracle's `Vec[T].new(cap int = 0)`
/// (std/src/collections/vec/core.nv) is the donor; the subset takes the
/// zero-argument call only.
export const EMPTY_CTOR = "new"

/// The std method the literal LOWERS to, one call per element (the oracle
/// builds `[7, 8]` as `static_new(0)` + `push` + `push`; measured 2026-08-26 on
/// its own emission). Spelled once, here.
export const LITERAL_PUSH = "push"

export const RECV_BINDING = "@"

/// The C name of the RECEIVER parameter in novac's own emission.
///
/// Ours, in our own prefix (P24): the receiver is a parameter of a function
/// novac names itself, so this spelling never crosses the ABI and nothing
/// outside the emitted function can see it. The leading underscore keeps it out
/// of the way of any user name the mangling might produce.
export const RECV_C_NAME = "_novac_self"

/// INTEROP, named as such (274.7 B1b-1, 2026-09-05): the prelude's `Fmt` protocol
/// has ONE implementor, and the codegen synthesizes it by hand -- `FmtCtx`
/// (std/prelude/protocols.nv says so beside the type). Until novac has real
/// protocol dispatch, a value typed `Fmt` resolves its methods and its C
/// spelling through that implementor: `f.write(b)` on `mut f Fmt` is
/// `Nova_FmtCtx_method_write(f, b)`, the parameter is `Nova_FmtCtx* f`. Goes
/// the day protocol dispatch is real -- then this pair is the second door.
export const FMT_PROTO = "Fmt"
export const FMT_IMPL = "FmtCtx"
/// The method the `Display` protocol requires (D422): `@display(mut f Fmt)`.
///
/// The citation used to read "D73/D422". D73 was retracted whole on 2026-07-06
/// (08-runtime.md) together with `From`/`Into`; D422 is the keystone that gives
/// this method its signature. A name of the language carrying a dead reference
/// sends the next reader to a block that says the opposite.
export const DISPLAY_METHOD = "display"

/// The `Display` protocol itself, by NAME -- what `#impl(Display)` opts into.
///
/// Here and nowhere else (P5): the same rule that put `COERCE_ATTR` here. The
/// checker needs the name to tell the ONE protocol the subset judges today from
/// every other, and a second spelling of it elsewhere would be a second place to
/// drift.
export const DISPLAY_PROTO = "Display"

/// The protocol `==` and `!=` dispatch through (D363). A SUM opts in by
/// `#impl(Equal)` -- it is a value type (D477), and value types get no identity
/// fallback -- so the checker asks the gate for this name (274.7 wave R).
export const EQUAL_PROTO = "Equal"

/// The `#impl(P1 + P2 + ...)` attribute (D186): the type author's explicit
/// opt-in that the type implements those protocols. Structural conformance is
/// NOT enough for a bare `${x}` -- at least one of (type author, use site) must
/// say so out loud, and this attribute is how the author does.
export const IMPL_ATTR = "impl"
/// `#share` -- the author vouches that a value of this type may be aliased
/// for MUTATION from another fiber (06-concurrency.md:7383, audited vouch):
/// the sync primitives of std carry it (`Atomic*`, `Mutex`, ...).
export const SHARE_ATTR = "share"
/// `#no_copy` and `#zero_on_move` -- a `value` record that must not be copied
/// (a copy would not be zeroed, or would duplicate what the type owns): its
/// `ro @` receiver crosses by pointer at any size (D488, the oracle's pin).
export const NO_COPY_ATTR = "no_copy"
export const ZERO_ON_MOVE_ATTR = "zero_on_move"

/// Does the primitive whose C spelling is `c_name` carry a FIXED runtime type
/// id (`nova_rt/typeid.h`: NOVA_TID_nova_int .. NOVA_TID_nova_unit)? Every other
/// type's id is generated per compilation unit by the oracle (D54 `is`, E.9
/// step 4b).
export fn has_fixed_tid(c_name str) -> bool =>
    c_name == "nova_int" || c_name == "nova_str" || c_name == "nova_bool" || c_name == "nova_f64" ||
    c_name == "nova_f32" || c_name == "nova_byte" || c_name == "nova_unit"
/// The effect a `supervised` scope asks about: an installed handler decides
/// its children's failures (`has_supervisor`, E.9 step 4).
export const SUPERVISOR_EFFECT = "Supervisor"
/// The runtime entry that builds a bare `Fmt` context over a builder -- what
/// the codegen constructs at every user-type slot (measured on the oracle's
/// emission 2026-09-05: `Nova_FmtCtx_static_bare(sb, 0, false)`). Interop.
export const FMT_BARE_C = "Nova_FmtCtx_static_bare"


/// The SOURCE spelling of the unit type: `()`.
///
/// A name no identifier can be, so nothing in a program can shadow it, and the
/// registry can hold the unit like any other type. P5 keeps it here with every
/// other name of the language.
export const UNIT_TYPE_NAME = "()"

/// The RECEIVER's own type, spelled by its role: `fn T @twin() -> Self`.
///
/// A NAME OF THE LANGUAGE, so it lives here (P5). It names no declaration and
/// is in no registry -- which is exactly how it went missing: a door that only
/// asked `defs` dropped every signature mentioning it, and std spells it 264
/// times across 50 files (measured 2026-08-21).
export const SELF_TYPE = "Self"

/// The FAMILY of a primitive -- the axis every rule about primitives actually
/// asks about (D227 literal typing, D405 mixed widths, D363 built-in operator
/// dispatch): is it an integer, a float, text, a truth value, a character, the
/// unit. Until 2026-09-04 the checker asked "is this an integer" as
/// `t == prims.int_id`, so every integer but `int` fell out of every rule at
/// once -- ten of the sixteen types below were declared here and reachable
/// nowhere (registry #910). The family lives in the table because the table is
/// the ONE home of primitive facts (P5); a predicate in the checker listing the
/// members by id would be the copy this module exists to prevent.
#impl(Equal)
export type PrimFamily enum
    | PfInt /// a signed or unsigned integer of some width: int, uint, i8..i64, u8..u64
    | PfFloat /// an IEEE float: f32, f64
    | PfStr /// str
    | PfBool /// bool
    | PfChar /// char
    | PfUnit /// ()
    | PfAny /// any -- the top type (D53), a boxed value behind `void*` (D54)
    | PfNever /// never -- the bottom type (D26): no values; it stands in any value position

/// One pre-declared type of the universe: (source name, runtime C spelling,
/// family, width, signedness). The C spelling of a PRIMITIVE is part of the
/// runtime ABI (nova_rt.h) — a fact, not a mangling result; everything
/// non-primitive goes through the mangling door. Width and signedness are the
/// spec's own axis for a scalar (D315 `Scalar{width, signed}`): the literal
/// range rule (D227 rule 3) and the mixed-width rule (D405) read them; the
/// non-numeric rows carry 0 and false because the questions do not apply.
export type BuiltinType value {
    name str /// canonical Nova spelling
    c_name str /// runtime ABI spelling (nova_rt.h)
    family PrimFamily /// which rules apply to it
    bits int /// width in bits for a numeric row (int/uint: 64 on every target novac emits for -- address-sized, D129/D130); 0 otherwise
    signed bool /// a signed integer; false for unsigned and for every non-integer row
}

// The universe, in Prims order; the seed hands the ACTUAL ids back
// (CommonTypes model, no hard-coded indexes).
// THE universe table, built ONCE at module load. It is the WHOLE primitive
// set of the language, not a convenient corner of it (owner's question
// 2026-08-16: "you still have not added all the builtin types -- does that
// make sense?"). It did not: a type novac does not know cannot even be
// NAMED in a signature, and novac's own lexer is written in `u8`. The C
// names are an ABI fact, read from the oracle's own map
// (compiler-codegen/src/codegen/emit_c.rs, the primitive table) rather than
// invented -- getting one wrong is a silent layout bug, not a compile error.
//
// What the subset does WITH them is a separate and narrower question:
// arithmetic and printing still cover int and f64 only, and `check` refuses
// the rest honestly at the operator or the argument. (owner's correction
// 2026-08-16: a function returning a fresh vector allocated on EVERY call —
// prim_c_name is a door and П18 says a door allocates nothing; the seed loop
// called it too. A module-level `ro` binding is initialized once and read
// forever; the type system keeps it read-only).
//
// THE CANONICAL FORM (274.5 section 6, step 3; LEGACY-#701 retired 2026-09-30):
// an ASSOCIATED module value, exported. `ro` and not `const`, and that is the
// spec's word, not a taste: an array literal is an allocation, and D184 keeps
// allocations out of `const` (03-syntax.md:1353; the integrator's ruling of
// 2026-09-30). It is ONE cell, computed once before `main` (D200,
// 02-types.md:9319), and every reader reads that cell -- the private table
// and its reader door `builtin_types()` that stood here while the oracle
// could not export a `ro` vector are gone.
export ro BuiltinType.ALL []BuiltinType = [
    BuiltinType { name: "int", c_name: "nova_int", family: PrimFamily.PfInt, bits: 64, signed: true },
    BuiltinType { name: "str", c_name: "nova_str", family: PrimFamily.PfStr, bits: 0, signed: false },
    BuiltinType { name: "bool", c_name: "nova_bool", family: PrimFamily.PfBool, bits: 0, signed: false },
    BuiltinType { name: "f64", c_name: "nova_f64", family: PrimFamily.PfFloat, bits: 64, signed: true },
    BuiltinType { name: "uint", c_name: "nova_uint", family: PrimFamily.PfInt, bits: 64, signed: false },
    BuiltinType { name: "i8", c_name: "int8_t", family: PrimFamily.PfInt, bits: 8, signed: true },
    BuiltinType { name: "i16", c_name: "int16_t", family: PrimFamily.PfInt, bits: 16, signed: true },
    BuiltinType { name: "i32", c_name: "int32_t", family: PrimFamily.PfInt, bits: 32, signed: true },
    BuiltinType { name: "i64", c_name: "int64_t", family: PrimFamily.PfInt, bits: 64, signed: true },
    BuiltinType { name: "u8", c_name: "nova_byte", family: PrimFamily.PfInt, bits: 8, signed: false },
    BuiltinType { name: "u16", c_name: "uint16_t", family: PrimFamily.PfInt, bits: 16, signed: false },
    BuiltinType { name: "u32", c_name: "uint32_t", family: PrimFamily.PfInt, bits: 32, signed: false },
    BuiltinType { name: "u64", c_name: "uint64_t", family: PrimFamily.PfInt, bits: 64, signed: false },
    BuiltinType { name: "f32", c_name: "nova_f32", family: PrimFamily.PfFloat, bits: 32, signed: true },
    BuiltinType { name: "char", c_name: "nova_char", family: PrimFamily.PfChar, bits: 0, signed: false },
    // THE UNIT. Its source spelling is `()`, not a word -- so it is the one
    // entry of this table whose `name` is punctuation, and that is deliberate:
    // the table maps a SOURCE SPELLING to a runtime ABI name, and the unit has
    // both (`nova_rt.h`: `typedef struct { char _dummy; } nova_unit`). The spec
    // calls it a type form of the language (02-types.md), not an absence.
    //
    // It goes LAST so no seeded ordinal moves: `Prims` reads the first four by
    // index, and an insertion above would have silently renamed them.
    BuiltinType { name: "()", c_name: "nova_unit", family: PrimFamily.PfUnit, bits: 0, signed: false },
    // `any` (E.9 step 4b): the top type, an EMPTY protocol by the spec (D53,
    // 02-types.md:1008) and a boxed value at run time (D54, 03-syntax.md:4193) --
    // a row of the universe here, named: its C spelling is the runtime's `void*`
    // on a `NovaAny`, and no operator or printer takes it. After `()`, so no
    // ordinal moves.
    BuiltinType { name: "any", c_name: "void*", family: PrimFamily.PfAny, bits: 0, signed: false },
    // `never` (registry 221.1 / 274.11 B10 part 3): the BOTTOM type (D26) -- no
    // value has it, and a value of it is compatible with every type. Until this
    // row the word was refused as "a type form not compiled yet", and a handed
    // signature `-> never` (diag `ice`) was dropped whole, so every `?? ice(..)`
    // and every `ice(..)` in a value position was "not a callable novac knows".
    // Its C spelling is the oracle's (`nova_int`, compiler-codegen emit_c.rs, the
    // primitive map): a function declared `-> never` returns that in C and never
    // does. Last, so no ordinal moves.
    BuiltinType { name: "never", c_name: "nova_int", family: PrimFamily.PfNever, bits: 0, signed: false }]

/// THE ROW of a primitive by its universe ordinal -- family, width, signedness
/// and both spellings in one value, for the doors in `sem/type_shape` that
/// answer "is this an integer / a float / which width" about a type TERM. One
/// door handing out the row rather than three handing out fields: the callers
/// that ask one fact (`family`) and the caller that asks three (the literal
/// range rule) read the same value, and the table stays the only home (P5).
/// A value record of two strings, an enum, an int and a bool -- copying it
/// allocates nothing, so the door keeps П18.
#realtime nogc
export fn prim_row(ordinal int) -> BuiltinType
    requires ordinal >= 0 && ordinal < BuiltinType.ALL.len(), "builtins: primitive ordinal outside the universe"
{
    BuiltinType.ALL[ordinal]
}

/// The runtime ABI spelling of a primitive by its universe ordinal — THE
/// door the mangler asks (E2-b1 step 3). It used to be a field copied onto
/// every TypeDef row; a fact of nova_rt.h belongs to the universe, and a
/// C name is a FUNCTION of the term, never a stored string (П22, mangle
/// door rule). The ordinal is what the interner keeps as the head of a
/// TkPrim term, so the round trip is prim term -> ordinal -> ABI name.
#realtime nogc
export fn prim_c_name(ordinal int) -> str
    requires ordinal >= 0 && ordinal < BuiltinType.ALL.len(), "builtins: primitive ordinal outside the universe"
{
    BuiltinType.ALL[ordinal].c_name
}

/// The SOURCE spelling of a primitive by its universe ordinal — the name a
/// diagnostic shows a person (`int`), not the runtime ABI name the mangler needs
/// (`nova_int`, which is `prim_c_name` right above).
///
/// Two doors and not one because they answer different questions and diverge in
/// spelling for most of the table (`u8` is `nova_byte`, `i32` is `int32_t`). A
/// message that printed the ABI name would name a type the author never wrote.
#realtime nogc
export fn prim_name(ordinal int) -> str
    requires ordinal >= 0 && ordinal < BuiltinType.ALL.len(), "builtins: primitive ordinal outside the universe"
{
    BuiltinType.ALL[ordinal].name
}

/// The two bool literals of the language, named ONCE.
///
/// They are not tokens of their own: the lexer sees identifiers, and the
/// language spells them `true` / `false` (the oracle emits the C keywords,
/// since `nova_bool` is C `bool`). Without them the subset had no way to
/// WRITE a bool at all -- only to compute one from a comparison -- which the
/// owner's question about the literal list exposed (2026-08-16).
#realtime nogc
export fn is_bool_literal(name str) -> bool => name == "true" || name == "false"

/// The `true` literal alone, for the one place that needs to tell the two
/// apart: `while true { ... }` ends a function (no way out but `return`),
/// `while false` and every computed condition do not (`check/tail_rules.nv`).
/// Named here rather than spelled in the checker for the same reason as its
/// two neighbours -- P5: a language name is not a string literal of the
/// backend. The checker carried `== "true"` inline until 2026-09-22
/// (registry 221.1 #1286).
#realtime nogc
export fn is_true_literal(name str) -> bool => name == "true"

/// The C spelling of a bool constant. `nova_bool` IS C `bool`, so the two
/// spellings coincide -- but they are LANGUAGE names, and language names live
/// here (P5), not as string literals in the backend.
#realtime nogc
export fn bool_c_literal(v bool) -> str {
    if v { return "true" }
    "false"
}

/// A4 (plan 172.14 F.2, atom `sum_placement.rs`): the seven sums whose C name is
/// pinned by HAND-WRITTEN runtime C (`nova_rt/*.h`, `*.c`). Their shape is fixed
/// by code the compiler does not emit, so they stay heap pointers whatever their
/// variants look like: turning one into a value would change a signature the
/// runtime already holds, and the C compiler would report it far from any sum.
///
/// The list is the oracle's `A4_RUNTIME_ABI_SUMS`, copied rather than
/// re-derived. It lives HERE because P5 keeps every language/std NAME in one
/// registry -- the mangling door asks, it does not spell.
export fn is_runtime_abi_sum(name str) -> bool {
    if name == "Decision" { return true }
    if name == "MemOrdering" { return true }
    if name == "OnceState" { return true }
    if name == "Result" { return true }
    if name == "RuntimeError" { return true }
    if name == "ScopeOutcome" { return true }
    if name == "WaitResult" { return true }
    false
}

/// The words the language RESERVES that this lexer reads as identifiers -- the
/// oracle's keyword table (compiler-codegen/src/lexer/mod.rs) minus the words
/// novac lexes as keywords of its own. Several are read here by SPELLING in
/// the one position they own (`with` before a handler binding, `effect` and
/// `priv` as markers, `true`/`false` as literals, `spawn`/`supervised` before a
/// block); NONE may name a declaration: the oracle refuses `fn Tab.with(..)`,
/// `fn with()` and a parameter `with` alike -- "expected identifier, got
/// `with`" -- and novac accepted all three (registry 1652).
/// `with` before a handler binding (`with Fs = h { .. }`), read by spelling.
export const WITH_WORD = "with"
/// `supervised { .. }`, read by spelling.
export const SUPERVISED_WORD = "supervised"
/// `spawn { .. }`, read by spelling.
export const SPAWN_WORD = "spawn"

ro RESERVED_WORDS = []str.of("alias", "blocking", "defer", "detach", "effect", "errdefer", "external",
    "false", "forbid", "interrupt", "lemma", "let", "loop", "okdefer", "parallel", "priv", "protocol",
    "pub", "readonly", "realtime", "ref", "safe", "select", "spawn", "supervised", "throw", "true",
    "uninit", "with")

/// Is this word one the language reserves although novac's lexer hands it over
/// as an identifier (`RESERVED_WORDS`)? Asked by the parser at every position
/// that NAMES a declaration.
export fn is_reserved_word(text str) -> bool {
    for w in RESERVED_WORDS {
        if w == text { return true }
    }
    false
}
