// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/pipeline/handed_sum_test.nv -- the holders of the wave "variants of
// handed sums" (plan 274.5 section 3-pred61, 2026-09-04): a sum novac was HANDED
// as a declaration offers its variants exactly as the compiled file's own sums
// do, and a type that is no sum answers the right cause. Reverse probe: with the
// handed-variants loop in collect_types_with removed the first case reddens
// ("not one of its variants"); with the non-sum branch of the judge removed the
// last case reddens on its message.

module novac.pipeline

/// A handed sum, written as a std declaration would be handed.
fn handed_sum() -> []str => []str.of("type Tk enum\n    | A\n    | B\n")

test "a variant of a HANDED sum is a value, and match arms name it (3-pred61)" {
    // Before the wave: the head `Tk` was known as a type (harvest registered the
    // name) and `B` was known as nothing (harvest skipped the variants), so
    // `Tk.B` was refused as "not one of its variants" -- 249 times over novac's
    // own source, which writes `TokenKind.KwFn` from module `lex` in `parse`.
    ro (d, c) = compile_to_c("fn main() {\n ro k = Tk.B\n match k {\n A => println(1)\n B => println(2)\n }\n}", handed_sum())
    assert(d.len() == 0, messages(d))
    // The tag is spelled by the mangle door -- module prefix, sum, variant --
    // so the holder pins the sum-and-variant tail, not the whole constant.
    assert(c.contains("_Tk_B"), c)
}

test "a name that is no variant of the handed sum is still refused by name (3-pred61)" {
    ro (d, _) = compile_to_c("fn main() {\n ro k = Tk.C\n println(1)\n}", handed_sum())
    assert(d.len() >= 1, "Tk.C must be refused")
    assert(messages(d).contains("not one of its variants"))
}

test "the file's own sum shadows a handed one of the same name (D125, last put wins)" {
    // The handed `Tk` has A and B; the file declares its own `Tk` with C only.
    // Its own variant is what `Tk.C` means, and the handed `B` is not a variant
    // of the file's `Tk`.
    ro (d, _) = compile_to_c("type Tk enum\n    | C\nfn main() {\n ro k = Tk.C\n match k {\n C => println(3)\n }\n}", handed_sum())
    assert(d.len() == 0, messages(d))
    ro (d2, _) = compile_to_c("type Tk enum\n    | C\nfn main() {\n ro k = Tk.B\n println(1)\n}", handed_sum())
    assert(d2.len() >= 1, "the handed B is no variant of the file's own Tk")
}

test "a type that is no sum is not told it has variants -- the refusal names the real cause (#922 family)" {
    // `Box.new(...)` in an argument position reached the variant judge and was
    // refused as "not one of its variants": the wrong cause for a record head.
    ro decls = []str.of("type Box { n int }\nfn Box.new(n int) -> Box\n")
    ro (d, _) = compile_to_c("fn take(b Box) -> int => 1\nfn main() {\n println(take(Box.new(1)))\n}", decls)
    assert(d.len() >= 1, "a static call in argument position is outside the subset today")
    assert(!messages(d).contains("not one of its variants"), messages(d))
    // Since 274.11 E.10 step 4c-2 a static call IS compiled: this one is refused
    // for its real cause -- the declaration has no body and the shell carries no
    // `Nova_Box_static_new` -- not as an uncompiled form.
    assert(messages(d).contains("carries no `new`"), messages(d))
}

/// A handed sum whose payload is a handed NEWTYPE, as `sem` hands
/// `| CalleeFn(FnRow)` with `type FnRow int` (registry 1512).
fn handed_newtype_sum() -> []str => []str.of("type Rw int\ntype Tg enum\n    | A(Rw)\n    | B(int)\n")

test "a handed sum's payload of a handed NEWTYPE keeps its position (registry 1512)" {
    // The newtype's term was interned AFTER the handed variants were read, so
    // `Rw` resolved to nothing and `A` was registered with no payload: the
    // correct `A(r)` was refused as "payload count disagrees" -- four times
    // over novac's own mono.nv. Reverse probe: with `fill_handed_newtypes`
    // back after the variants loop (sem/collect.nv) this case reddens.
    ro (d, _) = compile_to_c("fn f(t Tg) -> int {\n match t {\n A(r) => 1\n B(n) => n\n }\n}\nfn main() {\n println(f(Tg.B(4)))\n}", handed_newtype_sum())
    assert(!messages(d).contains("payload count"), messages(d))
    assert(d.len() == 0, messages(d))
}

test "a handed payload of a type novac does not know is refused BY THAT TYPE'S NAME, not by arity (registry 1512)" {
    // CONTROL: the arity rule still speaks for a pattern that really does
    // write the wrong count.
    ro dc = []str.of("type Tg enum\n    | A(int)\n    | B(int)\n")
    ro (d0, _) = compile_to_c("fn f(t Tg) -> int {\n match t {\n A(x, y) => x\n B(n) => n\n }\n}\nfn main() {\n println(f(Tg.B(4)))\n}", dc)
    assert(messages(d0).contains("payload count disagrees"), messages(d0))
    // `Ghost` is declared nowhere novac was handed: the position used to be
    // DROPPED, so `A(x)` met a variant of no payload. Reverse probe: with the
    // skip restored in `register_sum_variants` the pattern case reddens on
    // its message (the arity refusal is back).
    ro dg = []str.of("type Tg enum\n    | A(Ghost)\n    | B(int)\n")
    ro (d1, _) = compile_to_c("fn f(t Tg) -> int {\n match t {\n A(x) => 1\n B(n) => n\n }\n}\nfn main() {\n println(f(Tg.B(4)))\n}", dg)
    assert(messages(d1).contains("undeclared type name `Ghost`"), messages(d1))
    assert(!messages(d1).contains("payload count"), messages(d1))
    // The construction door, qualified and bare: the same refusal.
    ro (d2, _) = compile_to_c("fn main() {\n ro t = Tg.A(3)\n println(1)\n}", dg)
    assert(messages(d2).contains("undeclared type name `Ghost`"), messages(d2))
    ro (d3, _) = compile_to_c("fn main() {\n ro t = A(3)\n println(1)\n}", dg)
    assert(messages(d3).contains("undeclared type name `Ghost`"), messages(d3))
    // `A(..)` binds no payload, so it types none: no refusal from this door.
    ro (d4, _) = compile_to_c("fn f(t Tg) -> int {\n match t {\n A(..) => 1\n B(n) => n\n }\n}\nfn main() {\n println(f(Tg.B(4)))\n}", dg)
    assert(!messages(d4).contains("Ghost"), messages(d4))
}
