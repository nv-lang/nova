// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: the same habit subset_test.nv names -- rustc's ui-test grouping of
// acceptance tests by the wave that earned them; NOT taken: golden files.
// Role: acceptance tests of E2-b3 overload resolution (sub-plan 274.5, waves
// M1/M3): the typed method key picks by argument types, and a real D84 tie --
// method or free -- is refused by name, never chosen.
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file -- and it EXISTS because
// subset_test.nv crossed the 1000-line limit (decision 12): the cut is by
// MEANING, the overload-resolution block, exactly as subset_test.nv itself
// was once cut from pipeline_test.nv.
// novac/src/pipeline/overload_test.nv -- what E2-b3 M1/M3 promised, held.

module novac.pipeline

test "a method overload is narrowed by the argument types (E2-b3 M1)" {
    // Two `absorb` overloads on an own type, split by the argument's TYPE.
    // Until M1 the method key carried `no_ty()` in every argument slot, so
    // this pair was refused as "overloaded and novac does not type arguments
    // yet". The pick decides the SYMBOL: each call must name its OWN
    // overload's C spelling (our scheme carries the parameter types).
    ro std = std_decls()
    ro (dpk, c) = compile_to_c("type Tally {\n\
 n int\n\
}\n\
fn Tally @absorb(x int) -> int => @n + x\n\
fn Tally @absorb(s str) -> int => @n + 90\n\
fn main() {\n\
 ro t = Tally { n: 10 }\n\
 println(\"\${t.absorb(5)}\")\n\
 println(\"\${t.absorb(\"abc\")}\")\n\
}", std)
    assert(dpk.len() == 0)
    assert(c.contains("absorb__Tally__nova_int__to_nova_int(t,"))
    assert(c.contains("absorb__Tally__nova_str__to_nova_int(t,"))
}

test "the D84 tie text arrives at the FREE path too (E2-b3 M3)" {
    // The free-call FnOverloaded arm said "not narrowed yet (arrives with
    // the checker, E2-b3)" -- a lie since M1: typed_free_key has been the
    // key all along, so what stays overloaded is a real tie. Same guard as
    // the method arm (key_fully_typed), one rule for both call forms.
    // The oracle refuses the same class (E_OVERLOAD_AMBIGUOUS_MODE).
    ro std = std_decls()
    ro (dft, _) = compile_to_c("fn take(consume a int, b int) -> int => a + b\n\
fn take(a int, mut b int) -> int => a - b\n\
fn main() {\n\
 mut m = 2\n\
 println(\"\${take(7, m)}\")\n\
}", std)
    mut ftie = false
    for g in dft {
        if g.message.contains("more than one function and none is more specific") { ftie = true }
    }
    assert(ftie)
}

test "a real D84 tie refuses by name, never chooses (E2-b3 M1)" {
    // Modes varying OPPOSITELY across two positions: `take(consume, ro)`
    // beside `take(ro, mut)` both fit `bx.take(7, m)` and neither dominates
    // (P14 filter 4). D84's mode-axis amendment says refuse the tie -- "there
    // is no silent choice". The oracle agrees on this axis
    // (E_OVERLOAD_AMBIGUOUS_MODE, probed 2026-09-02).
    ro std = std_decls()
    ro (dtie, _) = compile_to_c("type Box {\n\
 v int\n\
}\n\
fn Box @take(consume a int, b int) -> int => a + b\n\
fn Box @take(a int, mut b int) -> int => a - b\n\
fn main() {\n\
 ro bx = Box { v: 1 }\n\
 mut m = 2\n\
 println(\"\${bx.take(7, m)}\")\n\
}", std)
    mut tie = false
    for g in dtie {
        if g.message.contains("none is more specific") { tie = true }
    }
    assert(tie)
}

test "`??` is judged: a non-Option left side refuses by name, with or without a `return` fallback (coalesce wave)" {
    // The POSITIVE path (payload/fallback, the tag guard, the short circuit)
    // is the CARRIER's -- examples/basics/coalesce.nv, held byte-for-byte by
    // the corpus smoke. It cannot live here: these shared decls are poor (no
    // Vec, so no `get`), and the subset's only Option source is a std method.
    // What belongs here is the JUDGE (`check/literal_rules.nv:420`, the `??`
    // judge's own two refusals), and it speaks without any Option at all.
    ro std = std_decls()

    // `?? return` is no longer refused as a form (D86 amended 2026-09-01: legal
    // where the fn returns neither container -- its door and tests are
    // check/try_rules.nv and pipeline/try_test.nv). Its LEFT side is still
    // judged first: an `int` has no payload, with a `return` fallback too.
    ro (dr, _) = compile_to_c("fn main() {\n\
 ro n = 1\n\
 ro v = n ?? return 0\n\
 println(v)\n\
}", std)
    mut ret_hit = false
    for g in dr {
        if g.message.contains("this left side is neither") { ret_hit = true }
    }
    assert(ret_hit)

    // A left side that is no Option has no payload to answer with.
    ro (dn, _) = compile_to_c("fn main() {\n\
 ro n = 1\n\
 println(n ?? 0)\n\
}", std)
    mut non_opt = false
    for g in dn {
        if g.message.contains("unwraps an `Option`") { non_opt = true }
    }
    assert(non_opt)
}

test "the linearity axis: a plain T takes the `[T]` form over `[T consume]` (D84 amendment 2026-09-25, registry 1519)" {
    // std declares `Vec[T consume] @contains` beside `Vec[T] @contains`; for a
    // plain T both fit, and the amendment says the `[T]` form dominates. Without
    // the axis every `xs.contains(k)` on a vector of a plain type was refused
    // as an ambiguity -- four times over novac's own parser.
    mut std = std_decls()
    std.push("module std.v\nexport type Vec[T] { n int }\nexport fn Vec[T consume] @has(v T) -> bool => false\nexport fn Vec[T] @has(v T) -> bool => true\n")
    ro d = compile_with("fn f(xs Vec[int]) -> bool => xs.has(1)\nfn main() {\n println(1)\n}", parse_decls(std), interop_surface())
    assert(d.len() == 0, messages(d))
    // CONTROL: one form alone takes every T its bound admits (rule 3).
    mut one = std_decls()
    one.push("module std.v\nexport type Vec[T] { n int }\nexport fn Vec[T consume] @has(v T) -> bool => false\n")
    ro d1 = compile_with("fn f(xs Vec[int]) -> bool => xs.has(1)\nfn main() {\n println(1)\n}", parse_decls(one), interop_surface())
    assert(d1.len() == 0, messages(d1))
}

test "a method on a concrete receiver beats a blanket one on a bare type parameter (D285 section 2 point 1, D84 section 1)" {
    mut std = std_decls()
    std.push("module std.sh\nexport fn int @show() -> int => 1\nexport fn[T] T @show() -> str => \"\"\n")
    // The concrete `int @show` wins: its `int` result takes `+ 1`; the blanket
    // `str` one could not, and a tie would be the D84 ambiguity.
    ro (d, _) = compile_to_c("fn main() {\n ro n = 7\n println(n.show() + 1)\n}", std)
    assert(!messages(d).contains("fits more than one method"), messages(d))
    // CONTROL: two concrete-alike forms (both blanket) stay an ambiguity --
    // the axis says nothing between two bare type parameters.
    mut std2 = std_decls()
    std2.push("module std.sh\nexport fn[T] T @show() -> int => 1\nexport fn[U] U @show() -> str => \"\"\n")
    ro (a, _) = compile_to_c("fn main() {\n ro n = 7\n println(n.show())\n}", std2)
    assert(messages(a).contains("fits more than one method"), messages(a))
}

test "concrete beats generic: a concrete row wins over a blanket one of its name (D84 filter 4 rule 1, registry 1543)" {
    // std declares `[]u8 @to_str()` beside `fn[T] T @to_str()`; both fit a
    // `[]u8` receiver, and `dominates` compared only modes and linearity, so
    // `bytes.to_str()` was an ambiguity -- six times over novac's own source.
    mut std = std_decls()
    std.push("module std.w\nexport type Box { n int }\n\
export fn Box @tag() -> int => 1\nexport fn[T] T @tag() -> int => 2\n")
    ro src = "fn f(b Box) -> int => b.tag()\nfn main() {\n println(1)\n}"
    ro d = compile_with(src, parse_decls(std), interop_surface())
    // The concrete row is CHOSEN: what remains is the shell's word about its
    // symbol (std's bodies are the shell's), never the D84 tie.
    assert(!messages(d).contains("fits more than one"), messages(d))
    // The free path asks the same door: `pick(3)` takes `pick(a int)`.
    ro (df, c) = compile_to_c("fn pick[T](a T) -> int => 2\nfn pick(a int) -> int => 1\nfn main() {\n println(pick(3))\n}", std_decls())
    assert(df.len() == 0, messages(df))
    assert(c.contains("pick"), c)
    // CONTROL: generic in OPPOSITE positions is still a tie -- neither row is
    // no more general everywhere, and D84 refuses rather than chooses.
    ro (dt, _) = compile_to_c("fn pick[T](a T, b int) -> int => 1\nfn pick[T](a int, b T) -> int => 2\nfn main() {\n println(pick(1, 2))\n}", std_decls())
    assert(dt.len() >= 1, "opposite generic positions must be refused")
    assert(messages(dt).contains("fits more than one"), messages(dt))
}

test "an integer literal takes a NEWTYPE parameter by its representation's rule, in an overload set too (D489, part 8 of p274-carina-k1)" {
    // `branch(0, NodeKind.File, []Node.new())` with `id NodeId` -- sem/binding_test.nv
    // and sem/mangle_test.nv, refused since the sem module is typed past
    // channel.nv (sweep 3-4). A single row takes the literal through the
    // argument's expectation (part 7); an overload set asks `lit_admits`,
    // which knew no newtype: "no overload accepts these argument types".
    ro decls = "type Id int\nfn f(i Id) -> int => (i as int) + 1\nfn f(s str) -> int => 2\n\
fn g(i Id, k int) -> int => (i as int) + k\n"
    ro calls = "fn main() {\n println(f(0))\n println(f(\"a\"))\n println(g(0, 3))\n}"
    ro (ds, _) = compile_to_c("${decls}${calls}", std_decls())
    assert(ds.len() == 0, messages(ds))
    // CONTROL: a FLOAT literal does not fit an int-based newtype, by the same
    // rule -- the overload set still refuses it.
    ro (dc, _) = compile_to_c("${decls}fn main() {\n println(f(1.5))\n}", std_decls())
    assert(dc.len() >= 1, "a float literal must not take an int-based newtype")
}
