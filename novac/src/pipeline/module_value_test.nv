// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: Go package initialization -- a package-level variable is one cell,
// initialized once before `main`; NOT taken: Go's dependency sort (values run
// in declaration order this wave, 274.5 section 6 boundaries).
// Role: acceptance tests of the module-value wave (274.5 section 6, step 1):
// `ro NAME = expr` at module level is found and typed at a read like a
// constant, emitted as ONE C cell with an initializer function, run from the
// shell's INIT slot, and what only its initializer calls is still emitted.
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file; the fixture
// novac/fixtures/module_ro/pos_1.nv through the smoke and the differential.
// novac/src/pipeline/module_value_test.nv -- module values, as novac writes them.

module novac.pipeline

test "module value: one cell, computed from the INIT slot, read by name (274.5 section 6)" {
    ro (d, c) = compile_to_c("fn add(a int, b int) -> int => a + b\nro K = add(3, 4)\nfn main() {\n println(K)\n}", std_decls())
    assert(d.len() == 0, messages(d))
    // The cell, declared once before any function reads it.
    assert(c.contains("static nova_int novac_mv_K;"), c)
    // Its initializer is a function of its own, and the INIT slot runs it once.
    assert(c.contains("static nova_int novac_mvinit_K(void) {"), c)
    assert(c.contains("novac_mv_K = novac_mvinit_K();"), c)
    assert(c.contains("nova_gc_add_root(&novac_mv_K"), c)
    // The slot line is gone: the text went into nova_consts_init.
    assert(!c.contains("__NOVAC_INIT__"), c)
    // A ROOT: `add` is called ONLY by the initializer, and it is emitted.
    assert(c.contains("novac_fn_add"), c)
}

test "module value: a constant is still substituted, not given a cell (274.5 section 6)" {
    // CONTROL: `const` keeps its semantics -- no cell, the value at the read.
    ro (d, c) = compile_to_c("const K = 7\nfn main() {\n println(K)\n}", std_decls())
    assert(d.len() == 0, messages(d))
    assert(!c.contains("novac_mv_K"), c)
}

test "module value: initializers run in DEPENDENCY order; a cycle is refused (274.5 S6, D200)" {
    // D200 initializes module values once, before main, in dependency order
    // (02-types.md:9319): a value read by another's initializer is computed
    // first, wherever it is declared. The values call `three()`: a literal
    // initializer is a CONSTANT and belongs in `const`.
    ro fx = "fn three() -> int => 3\n"
    // Declared AFTER its reader: still computed first.
    ro (d1, c1) = compile_to_c("${fx}ro second = first + 1\nro first = three()\nfn main() {\n println(second)\n}", std_decls())
    assert(d1.len() == 0, messages(d1))
    ro at_first = c1.find("novac_mv_first = novac_mvinit_first();") ?? 0 - 1
    ro at_second = c1.find("novac_mv_second = novac_mvinit_second();") ?? 0 - 1
    assert(at_first >= 0 && at_second > at_first, "the INIT slot computes `first` before `second`")
    // A value reading ITSELF, and two values reading each other: no order
    // computes them -- E_MODULE_INIT_CYCLE (D184 amendment 2026-09-30), a
    // language error on the declaration whose read closes the cycle, the path
    // in the text; the read in `main` stays silent.
    ro self_src = "${fx}ro a = a + three()\nfn main() {\n println(a)\n}"
    ro (d1, _) = compile_to_c(self_src, std_decls())
    assert(d1.len() == 1, messages(d1))
    assert(d1[0].code == "E_NOVAC_LANG", d1[0].code)
    assert(d1[0].message.contains("E_MODULE_INIT_CYCLE"), d1[0].message)
    assert(d1[0].message.contains("form a cycle: a -> a "), d1[0].message)
    ro pair_src = "${fx}ro a = b + three()\nro b = a + three()\nfn main() {\n println(a)\n}"
    ro (d2, _) = compile_to_c(pair_src, std_decls())
    assert(d2.len() == 1, messages(d2))
    assert(d2[0].message.contains("form a cycle: a -> b -> a "), d2[0].message)
    // On `b`'s declaration -- the one whose read of `a` closes the cycle.
    ro at_b = pair_src.find("ro b") ?? (0 - 1)
    assert(d2[0].lo == at_b, "at ${d2[0].lo}, want ${at_b}")
}

test "D184 partition: constexpr is `const`, runtime is `ro` -- both directions, one predicate (274.5 S6)" {
    // The spec's list, word for word (03-syntax.md:1344-1352): literals,
    // operators over constants, record literals and SUM CONSTRUCTORS of them,
    // references to constants. An ARRAY literal allocates, and a tuple is not
    // in the list: both are runtime values.
    ro fx = "fn three() -> int => 3\ntype Fam enum\n | FInt\n | FStr\n"
    ro main_src = "fn main() {\n println(1)\n}"
    // `ro` over a compile-time value -> E_RO_FOR_CONSTEXPR_PREFER_CONST.
    for src in []str.of("ro x = 3\n", "ro x = 2 + 3\n", "ro x = Fam.FInt\n", "ro x = FStr\n") {
        ro (d, _) = compile_to_c("${fx}${src}${main_src}", std_decls())
        assert(d.len() == 1, "${src}: ${messages(d)}")
        assert(d[0].code == "E_NOVAC_LANG", d[0].code)
        assert(d[0].message.contains("E_RO_FOR_CONSTEXPR_PREFER_CONST"), d[0].message)
    }
    // `const` over a runtime value -> E_CONST_NOT_CONSTEXPR.
    for src in []str.of("const y = three()\n", "const y = [1, 2]\n", "const y = (1, 2)\n") {
        ro (d, _) = compile_to_c("${fx}${src}${main_src}", std_decls())
        assert(d.len() >= 1, "${src}: ${messages(d)}")
        assert(d[0].message.contains("E_CONST_NOT_CONSTEXPR"), "${src}: ${d[0].message}")
    }
    // CONTROLS: each side of the line in its own keyword is right -- no
    // partition diagnostic (this std-less harness may refuse an array for
    // want of the Vec surface, which is not the question here).
    ro controls = []str.of("const a = 2\nconst b = a * 3\n", "const k Fam = Fam.FInt\n",
        "ro v = three()\nro w = v + 1\n", "ro xs = [1, 2]\n")
    for src in controls {
        ro (d, _) = compile_to_c("${fx}${src}${main_src}", std_decls())
        assert(!messages(d).contains("D184"), "${src}: ${messages(d)}")
    }
    ro (d9, _) = compile_to_c("${fx}const k Fam = Fam.FInt\nro v = three()\n${main_src}", std_decls())
    assert(d9.len() == 0, messages(d9))
}

test "qualified reads: `Type.NAME` of a constant is substituted, of a module value is its cell (274.5 S6, D200 #66)" {
    // Until 274.5 S6 the checker recorded only the TYPE of a qualified read,
    // and the emitter printed `Row->N` -- a field access on a C name that does
    // not exist. It records WHICH constant now, as on a bare name.
    ro fx = "type Row value {\n a int\n}\nfn seven() -> int => 7\n"
    ro (d0, c0) = compile_to_c("${fx}const Row.LIMIT int = 40\nro Row.N = seven()\nfn main() {\n println(Row.LIMIT + Row.N)\n}", std_decls())
    assert(d0.len() == 0, messages(d0))
    assert(!c0.contains("Row->"), c0)
    assert(c0.contains("novac_mv_Row__N"), c0)
    assert(c0.contains("novac_mv_Row__N = novac_mvinit_Row__N();"), c0)
    assert(!c0.contains("novac_mv_Row__LIMIT"), c0)
}
