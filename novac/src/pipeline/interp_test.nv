// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: the same habit subset_test.nv was cut with -- rustc's ui-test grouping
// of ACCEPTANCE tests by the feature that earned them; NOT taken: golden-file
// assertions (a test here asserts the property, not the byte).
// Role: acceptance tests of string INTERPOLATION in novac -- the chain (waves
// I1+I2), every primitive family through its own runtime entry (274.7 B1a),
// a declared type through its `display(mut f Fmt)` (274.7 B1b-1), and the
// refusals that fence the rest by name (u64, nested slots, a type without
// display).
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file -- and it EXISTS because
// subset_test.nv crossed the 1000-line limit (decision 12) on 2026-09-05: the
// cut is by MEANING, the interpolation block, not by counting lines.
// novac/src/pipeline/interp_test.nv -- what `${...}` promised, held.

module novac.pipeline

test "an interpolated string builds its chain; slots are real expressions (waves I1+I2)" {
    // The chain is the oracle's own (static_new with its cap formula,
    // per-fragment append, per-slot display insert, consume_into_str); the
    // slots are REAL nodes since I2, so calls, fields and operators ride
    // the ordinary expression paths. The asserts aim at OUR chain names --
    // the shell prelude carries the oracle's, and those are always there.
    ro std = std_decls()
    ro (d, c) = compile_to_c("fn twice(v int) -> int => v * 2\n\
fn main() {\n\
 ro name = \"world\"\n\
 ro n = 42\n\
 println(\"hi \${name}, tw=\${twice(n)}!\")\n\
}", std)
    assert(d.len() == 0)
    assert(c.contains("_novac_isb_t"))
    assert(c.contains("str_display_spec(_novac_isb_t"))
    assert(c.contains("int_display_spec(_novac_isb_t"))
    assert(c.contains("nova_print_str(_novac_istr_t"))

    // EVERY PRIMITIVE FAMILY takes its own runtime entry (wave B1a, 274.7):
    // the asserts pin the exact entry and the exact cast, because the wave
    // exists to stop `${1.5}` from printing `1` through `(nova_int)`.
    ro (d3, c3) = compile_to_c("fn idf32(x f32) -> f32 => x\n\
fn main() {\n\
 ro f = true\n\
 ro h = 2.5\n\
 ro ch = 'z'\n\
 println(\"\${f} \${h} \${ch} \${idf32(1.5)}\")\n\
}", std)
    assert(d3.len() == 0, messages(d3))
    assert(c3.contains("17bool_display_spec(_novac_isb_t"), c3)
    assert(c3.contains("16f64_display_spec(_novac_isb_t") && c3.contains("(double)("), c3)
    assert(c3.contains("17char_display_spec(_novac_isb_t"), c3)
    assert(c3.contains("16f32_display_spec(_novac_isb_t"), c3)
    // The shell prelude DEFINES int_display_spec, so the negative assert aims
    // at our chain's CALL spelling, not at the bare name.
    assert(!c3.contains("int_display_spec(_novac_isb_t"), "no slot here is an integer")

    // A DECLARED type with its own display(mut f Fmt) displays (wave B1b-1):
    // the slot builds the bare context over our builder and calls the method.
    // `[]u8` is `Vec[u8]`: without a handed `Vec` both signatures below are
    // unreadable and DROPPED, and the holder fails as "no such method"
    // (measured 2026-09-05 with the binary and a fake std, probes q0/q1/q4). A
    // handed fn WITHOUT a body is recovery debris that swallows the NEXT decl
    // (`type Fmt protocol` vanished with it, probe s0) -- the bodies are dummies.
    ro fmt_std = []str.of("export type Vec[T] { n int }\ntype FmtCtx { mark int }\nfn FmtCtx mut @write(bytes []u8) -> () {}\ntype Fmt protocol { mut @write(bytes []u8) -> () }\ntype Write protocol { mut @write(bytes []u8) -> () }\nfn str @bytes() -> []u8 => []u8.new()\n")
    ro (d3d, c3d) = compile_to_c("type Pt { n int }\nfn Pt @display(mut f Fmt) -> () {\n f.write(\"Pt\".bytes())\n}\nfn main() {\n ro p = Pt { n: 7 }\n println(\"p \${p}\")\n}", fmt_std)
    assert(d3d.len() == 0, messages(d3d))
    // The spellings are pinned by their SUFFIXES, the way the instance-method
    // holders pin `_method_len(` (P24: the prefix is the mangler's, and no test
    // reads a C name backwards). The door itself (`FMT_BARE_C`) is not imported
    // here: pipeline has no edge to builtins in the architecture table, and a
    // test does not get one.
    assert(c3d.contains("FmtCtx_static_bare(_novac_isb_t"), c3d)
    assert(c3d.contains("FmtCtx* f)") || c3d.contains("FmtCtx* f,"), c3d)
    assert(c3d.contains("FmtCtx_method_write(f, ") && c3d.contains("str_method_bytes("), c3d)

    // The parameter's TYPE decides (#634): display over `Write` is not Display.
    ro (d3e, _) = compile_to_c("type Pt { n int }\nfn Pt @display(mut w Write) -> () {\n w.write(\"Pt\".bytes())\n}\nfn main() {\n ro p = Pt { n: 7 }\n println(\"p \${p}\")\n}", fmt_std)
    assert(d3e.len() >= 1)
    assert(messages(d3e).contains("non-primitive type"), messages(d3e))

    // A NON-primitive slot still refuses by name -- B1b's ground.
    ro (d3b, _) = compile_to_c("type P { n int }\nfn main() {\n\
 ro p = P { n: 1 }\n\
 println(\"p \${p}\")\n\
}", std)
    assert(d3b.len() >= 1)
    assert(messages(d3b).contains("non-primitive type"), messages(d3b))

    // The one primitive the runtime cannot display refuses by NAME of the
    // missing function, rather than truncating through the int entry.
    ro (d3c, _) = compile_to_c("fn idu(x u64) -> u64 => x\nfn main() {\n\
 println(\"u \${idu(7)}\")\n\
}", std)
    assert(d3c.len() >= 1)
    assert(messages(d3c).contains("uint_display_spec"), messages(d3c))

    // A nested interpolation (a live slot inside a slot's string) refuses
    // by name -- the lexer splits one level, and the I1 judge that used to
    // ICE on the cut token is the backstop.
    ro (d4, _) = compile_to_c("fn main() {\n\
 ro s = \"a\"\n\
 println(\"bad \${\"x \${s} y\"} tail\")\n\
}", std)
    assert(d4.len() >= 1)
    mut hit4 = false
    for g in d4 {
        if g.message.contains("nested inside another slot") { hit4 = true }
    }
    assert(hit4)
}
