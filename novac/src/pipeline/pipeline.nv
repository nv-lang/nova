// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/pipeline — the ONE owner of pass order (architecture §2).
//
// Nobody else strings phases together: the CLI, the future LSP and the tests
// call compile() and never name a phase. This module existing is not
// ceremony — its absence was caught live 2026-08-14: main called five phases
// directly, the deps guard was blind to root `./` imports, and the violation
// shipped in a green commit. The guard now parses `./` imports too, and main
// imports pipeline + diag only, exactly as the §3 table always said.

module novac.pipeline

import ../source.{SourceText}
import ../lex.{lex}
import ../parse.{parse}
import ../check.{check}
import ../diag.{Diagnostic}
import ../emit_c.{emit}

/// The whole E1 front half: text in, diagnostics out. Always returns the
/// full list; no Result (274 §4 п.1).
export fn compile(text str) -> []Diagnostic {
    ro src = SourceText { text }
    check(parse(lex(text)), src)
}

/// Emit C for a CLEAN e1 file. Contract: call only when compile() returned
/// an empty list — the emitter never sees broken input (poisoning). Returns
/// (diags, c_text): non-empty diags means c_text is empty and must not be
/// used; no Result in signatures (274 p4.1).
export fn compile_to_c(text str) -> ([]Diagnostic, str) {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro diags = check(tree, src)
    if diags.len() > 0 {
        return (diags, "")
    }
    (diags, emit(tree))
}
