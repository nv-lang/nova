// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_interface::passes` (one function per phase boundary, the
// driver calls one seam); Roslyn `CSharpCompilation.Create(syntaxTrees)` /
// `SourceText.From` and rustc `FileLoader` for \"the driver hands text in, the
// compiler reads nothing\"; NOT taken: rustc's query graph/incremental, rustc
// crate metadata / Go export data — std declaration texts are re-lexed and
// re-parsed on every compile (E2-temporary, until an interface cache).
// Role: layer glue — phases in order, one function per boundary; the seam the driver calls (274 §6).
// Used by: main (E1+); the module tests judge no-cascade THROUGH it; the daemon/LSP call the same seam at E3.
// Guarded by: the pipeline module tests (no-cascade judged THROUGH compile()), check-novac-deps.py (edges only from the
// section 3 table), check-novac-effects-at-door.sh (no capability below main).
// boundary, no phase reaches around another; NOT taken: the query graph and
// incremental compilation (a batch pipeline, plan 274 §6).
// novac/src/pipeline — the ONE owner_id of pass order (architecture §2).
//
// Nobody else strings phases together: the CLI, the future LSP and the tests
// call compile() and never name a phase. This module existing is not
// ceremony — its absence was caught live 2026-08-14: main called five phases
// directly, the deps guard was blind to root `./` imports, and the violation
// shipped in a green commit. The guard now parses `./` imports too, and main
// imports pipeline + diag only, exactly as the §3 table always said.

module novac.pipeline

import ../source.{SourceText}
import ../lex.{lex}
import ../parse.{parse}
import ../tree.{Node}
import ../check.{check}
import ../diag.{Diagnostic}
import ../emit_c.{emit}
import ../sem.{Ctx, collect}

/// A file's semantic context: the file's types + method signatures, READ
/// from the declarations passed in. The compiler does not walk the
/// filesystem and does not resolve packages (§1): the door (main) hands
/// it declaration texts, the way a driver hands a real compiler the std
/// interface.
fn context(tree Node, decl_texts []str) -> Ctx {
    mut decls = []Node.new()
    for d in decl_texts { decls.push(parse(lex(d))) }
    collect(tree, decls)
}

/// The whole E1 front half: text in, diagnostics out. Always returns the
/// full list; no Result (274 §4 item 1). `decl_texts` — std declaration
/// texts (empty = no methods are known at all, and every method call
/// gets an honest subset rejection).
export fn compile(text str, decl_texts []str) -> []Diagnostic {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro (diags, _) = check(tree, src, context(tree, decl_texts))
    diags
}

/// Emit C for a CLEAN e1 file. Contract: call only when compile() returned
/// an empty list — the emitter never sees broken input (poisoning). Returns
/// (diags, c_text): non-empty diags means c_text is empty and must not be
/// used; no Result in signatures (274 p4.1).
export fn compile_to_c(text str, decl_texts []str) -> ([]Diagnostic, str) {
    ro src = SourceText { text }
    ro tree = parse(lex(text))
    ro ctx = context(tree, decl_texts)
    ro (diags, chan) = check(tree, src, ctx)
    if diags.len() > 0 {
        return (diags, "")
    }
    // The emitter is handed the checker's channel, not the checker: it reads
    // decisions and cannot ask for a new one (E2-b1).
    (diags, emit(tree, ctx, chan))
}
