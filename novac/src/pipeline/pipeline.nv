// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `rustc_interface::passes` (one function per phase boundary, the
// driver calls one seam); Roslyn `CSharpCompilation.Create(syntaxTrees)` /
// `SourceText.From` and rustc `FileLoader` for \"the driver hands text in, the
// compiler reads nothing\"; NOT taken: rustc's query graph/incremental, rustc
// crate metadata / Go export data — std declaration texts are re-lexed and
// re-parsed on every compile (E2-temporary, until an interface cache).
// Role: layer glue — phases in order, one function per boundary; the seam the driver calls (274 §6).
// Used by: main (E1+); the module tests judge no-cascade THROUGH it; the daemon/LSP call the same seam at E3.
// Guarded by: the pipeline module tests (no-cascade judged THROUGH compile()), check-novac-deps.py (edges only from the
// section 3 table), check-novac-effects-at-door.sh (no capability below main).
// boundary, no phase reaches around another; NOT taken: the query graph and
// incremental compilation (a batch pipeline, plan 274 §6).
// novac/src/pipeline — the ONE owner_id of pass order (architecture §2).
//
// Nobody else strings phases together: the CLI, the future LSP and the tests
// call compile() and never name a phase. This module existing is not
// ceremony — its absence was caught live 2026-08-14: main called five phases
// directly, the deps guard was blind to root `./` imports, and the violation
// shipped in a green commit. The guard now parses `./` imports too, and main
// imports pipeline + diag only, exactly as the §3 table always said.

module novac.pipeline
/// Tokens of a source text — and the LOSSLESS invariant, checked here.
///
/// The tree is non-destructive by design: every byte of the input stands in the
/// token stream, trivia included. That is a property of the LEXER, so it is
/// asserted where the lexer is used — on every file novac ever reads, the whole
/// corpus included — instead of being shown on fixtures and hoped for
/// elsewhere.
///
/// Plan 274 wave 3 asked for this as a `reserialize` CLI over the corpus. An
/// invariant needs no command, and П26 forbids inventing one nova-cli does not
/// have: novac is built as a REPLACEMENT for it, not a neighbour. Checking it
/// here is strictly stronger than a command someone must remember to run.
fn tokens_of(text str) -> []Token {
    ro toks = lex(text)
    assert(reserialize(toks) == text, "lex: the token stream lost bytes of the source")
    toks
}


import ../source.{SourceText}
import ../lex.{lex, reserialize, Token}
import ../parse.{parse}
import ../tree.{Node, NodeKind, raw_node}
import ../check.{check, check_instance, derive_serialize_text, DerivedText}
import ../diag.{Diagnostic, ice_at}
import ../emit_c.{emit, Instantiation, shell_surface}
import ../mono.{Reach, reachable}
import ../sem.{Ctx, collect, decl_fn_row, file_decls, InteropTable, module_dotted, raw_row}
import ../sem.{EmbedTable}
import ../types.{TyId}

/// A file's semantic context: the file's types + method signatures, READ
/// from the declarations passed in. The compiler does not walk the
/// filesystem and does not resolve packages (§1): the door (main) hands
/// it declaration texts, the way a driver hands a real compiler the std
/// interface.
fn context(tree Node, decls []Node, interop InteropTable) -> Ctx => collect(tree, decls, interop)

/// The same, with what the door read for the text's `embed` calls (D412).
fn context_with_embeds(tree Node, decls []Node, interop InteropTable, embeds EmbedTable) -> Ctx {
    mut ctx = collect(tree, decls, interop)
    // The door's `embed` findings (D412) are HANDED, like the interop surface:
    // the collector reads no file (sem/embeds.nv).
    ctx.embeds = embeds
    ctx
}

/// The interop surface, read from the embedded shell ONCE per process -- the
/// driver calls this beside `parse_decls` and hands both down; a test that wants
/// the real surface calls it too, one that wants none passes `InteropTable.new()`.
export fn interop_surface() -> InteropTable => shell_surface()

/// Marks the PROGRAM's modules on the link surface: every declaration tree
/// handed from the program's own root (NOVAC_SELF_PATH) is a module whose
/// bodies the program compiles (274.11 E.10 step 2a); std's trees are not.
export fn mark_program(mut link InteropTable, program_decls []Node) -> () {
    for d in program_decls {
        link.add_module(module_dotted(d))
    }
}

/// The declaration TEXTS, parsed once.
///
/// THE COST THIS DOOR EXISTS FOR, measured 2026-08-24: the texts used to be
/// parsed inside `context`, that is once per COMPILED FILE. With six declaration
/// files it hid in the noise; handing novac the whole std interface (184 files)
/// took the corpus batch from 1308ms to 17548ms -- thirteen times, while ONE file
/// only doubled. The quadratic was in the batch, not in the parser: sixty-one
/// files times a hundred and eighty-four declarations.
///
/// So the door that parses is separate from the door that compiles, and the
/// batch calls it ONCE. P14 is the reason and it is not decoration: the cost of
/// the "edit -> verdict" loop is what this compiler is measured by.
export fn parse_decls(decl_texts []str) -> []Node {
    mut out = []Node.new()
    for d in decl_texts {
        out.push(parse(tokens_of(d)))
    }
    out
}

/// The whole E1 front half: text in, diagnostics out. Always returns the
/// full list; no Result (274 §4 item 1). `decl_texts` — std declaration
/// texts (empty = no methods are known at all, and every method call
/// gets an honest subset rejection).
export fn compile(text str, decl_texts []str) -> []Diagnostic =>
    compile_with(text, parse_decls(decl_texts), described_surface(decl_texts))

/// The interop surface with the handed texts DESCRIBED (274.11 E.10 step 4c):
/// a std body the unit instantiates is typed against its own text. The texts
/// here come from no files, so each is named by its position -- `decl_3` --
/// which is what a contract in such a body prints; the driver names real files
/// (main.nv `read_decls`).
fn described_surface(decl_texts []str) -> InteropTable {
    mut s = interop_surface()
    mut names = []str.new()
    for i in 0..decl_texts.len() {
        names.push("decl_${i}")
    }
    s.describe_decls(names, decl_texts)
    s
}

/// The same, given declarations ALREADY parsed -- what a batch hands over.
///
/// Two doors and not a flag: a caller with texts (every module test) says so by
/// calling the wrapper above, and a caller compiling many files parses once and
/// calls this. The wrapper is the whole difference between them.
/// One RUN of a unit of peers, and the file it came from (274.7 M).
///
/// A unit is one header plus the bodies of a module's files, so a span that
/// comes out of the checker is an offset into the UNIT and has to be handed
/// back as a file plus an offset in that file. These three numbers are the
/// whole of that translation.
///
/// WHY THE FILE IS NOT IN THE DIAGNOSTIC INSTEAD: it never was. A Diagnostic
/// carries a code, a severity, two byte offsets and a message; the path is
/// handed to `to_json` separately, by the door that already knows it. So
/// nothing in the tree or the channel needs to learn about files -- the door
/// that prints needs a table.
///
/// EXPORTED because `Unit.files`, `file_of_offset` and `offset_in_file` are:
/// a module-private type in a public signature or a public record's field is
/// E_PRIVATE_TYPE_IN_PUBLIC (D47 amendment, owner's decision 2026-10-01).
export type UnitFile value {
    path str /// the path exactly as the CLI received it
    at int /// where this run begins INSIDE the unit text
    from int /// where that same run began in the file it came from
}

/// Which file of the unit owns a unit offset -- its index, or -1.
///
/// The bodies lie in order and back to back, so the owner is the LAST one that
/// starts at or before the offset. A linear walk, not a search: a module has
/// tens of files, and a binary search here would be machinery for nothing.
///
/// -1 rather than an ice for an offset before the first body: the header is a
/// real part of the unit and a diagnostic CAN land in it (a malformed import
/// is a diagnostic about the unit itself). The caller then names the module
/// rather than a file, and that is a decision, not a hole.
export fn file_of_offset(files []UnitFile, off int) -> int {
    mut best = 0 - 1
    for i in 0..files.len() {
        if files[i].at <= off {
            best = i
        } else {
            // A run that starts AFTER the offset: not this file's, and the
            // scan keeps walking -- the answer is the LAST run at or before.
        }
    }
    best
}

/// The offset as the FILE knows it: undo the unit's shift.
///
/// `off - f.at` is how far into the body the span sits, and `f.from` is where
/// that body began in the original -- so the sum is the original offset. Two
/// numbers and a subtraction, which is the entire price of the wave on the
/// positions side.
export fn offset_in_file(f UnitFile, off int) -> int => off - f.at + f.from

/// The index of a path's last separator, or -1 when it has none.
///
/// BOTH separators, because the CLI receives the path exactly as it was
/// typed and this compiler is built on Windows as much as anywhere else.
fn last_sep(path str) -> int {
    ro b = path.bytes()
    mut last = 0 - 1
    for i in 0..b.len() {
        if b[i] == UNIT_SLASH || b[i] == UNIT_BACKSLASH {
            last = i
        } else {
            // An ordinary byte: it is not a separator, and `last` keeps the
            // one found before it. A path with no separator at all leaves -1.
        }
    }
    last
}

/// The path's last segment: what the oracle prints as the FILE of a contract
/// panic (`p.nv:4:`), and the only part of a path the emitted binary should
/// carry (#874). Moved here from main.nv (#1521): the handed body's path now
/// reaches the pipeline whole -- its refusals name it -- and its contracts
/// still print the base name, so the cut is asked in two places, through one door.
export fn path_base(path str) -> str => path[last_sep(path) + 1..]

/// The two separators, prefixed like everything else this file declares.
///
/// FOURTH COLLISION OF ONE NIGHT, and the prefix is the whole defence: a
/// bare `BACKSLASH` here resolved to the one `novac.check` declares, and the
/// C named a symbol this unit does not emit. The census of 2026-09-20 found
/// 145 constants under 145 DISTINCT names and therefore zero collisions in
/// the tree -- which is true and misleading, because a collision that was
/// hit and renamed leaves no trace. The denominator that matters is
/// collisions MET while writing, and this file met four.
const UNIT_SLASH u8 = 0x2F
const UNIT_BACKSLASH u8 = 0x5C

/// Do two paths name files of ONE module?
///
/// A module is a directory in this compiler's layout, so the question is
/// whether the paths agree up to their last separator. Compared byte by byte
/// rather than by cutting the directory out: cutting means slicing, and a
/// slice is not compiled by novac yet (registry No. 1170).
///
/// THE TWO SEPARATORS COMPARE EQUAL (registry 1194). `last_sep` has looked
/// for both since it was written -- "the CLI receives the path exactly as it
/// was typed and this compiler is built on Windows as much as anywhere else"
/// -- and the prefix comparison did not, so `sub/x.nv` and `sub\\y.nv` were
/// different directories. The module split in two, and the call between the
/// peers was refused as an unknown name: a CORRECT program refused for how
/// its path was spelled on the command line. Measured 2026-09-20 with the
/// same two files handed in both ways.
///
/// Two paths with no separator at all are peers -- they name files of the
/// working directory, which is one module like any other.
export fn same_dir(a str, b str) -> bool {
    ro sa = last_sep(a)
    ro sb = last_sep(b)
    if sa != sb { return false }
    if sa < 0 { return true }
    ro ba = a.bytes()
    ro bb = b.bytes()
    for i in 0..sa {
        if !same_path_byte(ba[i], bb[i]) { return false }
    }
    true
}

/// Two bytes of a PATH: equal, or the two spellings of one separator.
///
/// Its own door because the question is asked per byte and the answer is a
/// rule about paths, not about bytes -- and because a reader of `same_dir`
/// should meet the rule by name rather than by an `||` in a loop.
fn same_path_byte(x u8, y u8) -> bool {
    if x == y { return true }
    ro x_sep = x == UNIT_SLASH || x == UNIT_BACKSLASH
    ro y_sep = y == UNIT_SLASH || y == UNIT_BACKSLASH
    x_sep && y_sep
}

/// A module's files, handed to the compiler as ONE text (274.7 M).
///
/// `text` is what the parser sees; `files` says which part of it came from
/// where, so a span can be handed back as a file and an offset in it.
export type Unit value {
    text str /// the unit as the parser will read it
    files []UnitFile /// where each body landed, in order
}

/// The end of a file's `module` line -- found BY NAME, not by position.
///
/// A unit keeps ONE module line and takes every file's imports after it, so
/// this number is where a file's contribution to the header begins.
///
/// THE FIRST LINE IS NOT THE MODULE LINE, and assuming it was cost twenty
/// diagnostics. Every file of this compiler opens with an SPDX comment, so a
/// unit built on `first line` copied that comment as its header and left each
/// file's real `module` line inside the imports region -- where it was
/// repeated once per file, and a repeated module line is exactly what the
/// parser refuses. Caught by two measurements disagreeing: the same module
/// gave 77 diagnostics assembled by the probe script and 97 assembled here,
/// while the file-by-file number matched exactly (308 and 308). The
/// agreement of the halves that shared code is what made the difference
/// point at the half that did not.
///
/// A file with NO module line answers 0: it contributes no header, and the
/// whole of it is body. That is a real shape -- a fragment handed in by a
/// test -- and not an error.
fn module_line_end(text str) -> int {
    ro b = text.bytes()
    ro n = text.byte_len()
    mut ls = 0
    mut i = 0
    // THE CANON IS `for i in 0..=n`, AND CARINA CANNOT READ IT. Asked her
    // directly rather than assumed: `novac/src/lex` and `novac/src/parse` carry
    // no inclusive-range token at all, and `..=` appears zero times in the whole
    // of `novac/src`. This file is part of the corpus Carina must compile to
    // build herself, so the canon form would be a form she cannot parse -- the
    // exact defect found in `check/variant_rules.nv` an hour earlier, where the
    // oracle compiled a line Carina refused.
    //
    // Goes back to the canon when `..=` is in the subset, not before.
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- `..=` absent from Carina's lexer and parser
    while i <= n {
        mut at_end = false
        if i == n {
            at_end = true
        } else {
            if b[i] == UNIT_LF {
                at_end = true
            } else {
                // A byte inside the line: the line has not ended, so the scan
                // walks on without touching where the line began.
            }
        }
        if at_end {
            if matches_at(b, ls, "module ") {
                mut e = i
                if i < n {
                    e = i + 1
                } else {
                    // The header ends AT the end of the text: there is no
                    // newline to step past, so the end stays where it is.
                }
                return e
            } else {
                // The line is not the module line: it is a comment, an
                // import or blank, and the scan moves its start forward.
            }
            ls = i + 1
        } else {
            // Mid-line: nothing is decided until the line ends, and the
            // next byte is read.
        }
        i += 1
    }
    0
}

/// Copy `b[from..to)` onto `out` -- a byte loop, because a slice is not
/// compiled by novac yet (registry No. 1170) and this file has to stay
/// inside the subset it is helping to widen.
fn append_range(mut out []u8, b []u8, from int, to int) -> () {
    for i in from..to {
        // The canon `x[a..b]` is a SLICE, and novac does not compile one yet
        // (registry 1170), so the copy is by hand here.
        // nova:allow W_MANUAL_SLICE_COPY -- slice not compiled yet, registry 1170
        out.push(b[i])
    }
}

/// Build the unit: ONE module line, then every file's imports, then every
/// file's body, in the order given.
///
/// IMPORTS ARE NOT DEDUPLICATED, and that is measured rather than lazy: a
/// repeated `import` line is accepted (probe, 2026-09-20), while a repeated
/// `module` line is not -- which is the whole reason a unit is not a plain
/// concatenation. Deduplicating would mean comparing lines, and comparing
/// lines means slicing, which this file may not do yet.
///
/// THE TABLE COVERS THE WHOLE UNIT, not only the bodies, and that is a
/// correction of the first draft. A diagnostic can land in the header -- a
/// malformed import is exactly that -- and a table of bodies only would have
/// had to answer "no file" and invent a path to print. Since each file's
/// imports also occupy one contiguous run, they are entries too, and every
/// offset of the unit maps to the file it came from.
///
/// THE ORDER IS THE CALLER'S. Whether the checker depends on it once bodies
/// can see each other is NOT measured yet and stands as an open question of
/// the wave; sorting here would hide the answer instead of giving it.
export fn unit_of(paths []str, texts []str) -> Unit {
    mut out = []u8.new()
    mut files = []UnitFile.new()
    if texts.len() == 0 {
        // BOUND FIRST, not returned inline: a record constructor is compiled
        // only as a binding initializer or a call argument, and writing it in
        // the return position would add a subset refusal to the very file
        // that exists to remove them (measured here, 2026-09-20).
        ro empty = Unit { text: "", files }
        return empty
    }
    // The module line of the FIRST file speaks for the unit -- and it is a
    // RUN like any other, because a diagnostic can land in it.
    ro t0 = texts[0]
    ro b0 = t0.bytes()
    ro m0 = module_line_end(texts[0])
    files.push(UnitFile { path: paths[0], at: 0, from: 0 })
    append_range(out, b0, 0, m0)
    // Then the imports of every file -- the part of a header after its own
    // module line.
    for i in 0..texts.len() {
        ro ti = texts[i]
        ro bi = ti.bytes()
        ro mi = module_line_end(texts[i])
        ro hi = header_end(texts[i])
        if hi > mi {
            files.push(UnitFile { path: paths[i], at: out.len(), from: mi })
            append_range(out, bi, mi, hi)
        } else {
            // No imports in this file: its header is the module line alone,
            // which the unit already carries once, so there is nothing to
            // hand over and no run to remember.
        }
    }
    // Then the bodies, each remembering where it came from.
    mut bodies = 0
    for j in 0..texts.len() {
        ro tj = texts[j]
        ro bj = tj.bytes()
        ro hj = header_end(texts[j])
        // A FILE THAT CONTRIBUTES NO BYTES CONTRIBUTES NO RUN (registry 1193).
        //
        // An empty body was recorded as a run of length zero, and the newline
        // written after it then fell inside that run -- so `file_of_offset`,
        // which answers with the LAST run at or before the offset, handed the
        // end of the unit to the file that had given nothing. Measured: a
        // three-line broken file plus a ZERO-BYTE peer reported
        // `z_empty.nv:1` -- a byte that file does not have -- while the broken
        // file alone reported its own offset 43 correctly.
        //
        // The separator goes with the run: it exists to keep one body's last
        // line off the next body's first, and an absent body needs no keeping
        // apart.
        if hj < bj.len() {
            // THE SEPARATOR GOES BETWEEN BODIES, NOT AFTER EACH (registry 1193,
            // second half). Written after, the last body was followed by a
            // newline that belongs to no file -- and a diagnostic at the END of
            // the unit landed on it, so a span that read 43 alone read 44 in the
            // unit: one byte past a 43-byte file. Between-form has no last one.
            if bodies > 0 {
                out.push(UNIT_LF)
            } else {
                // The first body follows the header, which already ends in one.
            }
            bodies += 1
            files.push(UnitFile { path: paths[j], at: out.len(), from: hj })
            append_range(out, bj, hj, bj.len())
        } else {
            // No body: an empty file, or one that is nothing but its header.
        }
    }
    match out.to_str() {
        Ok(t) => {
            ro u = Unit { text: t, files }
            u
        }
        // The pieces came from strings, so the bytes are UTF-8 by
        // construction and a failure here would mean the copy lost a
        // boundary -- an invariant of this function, not an input error.
        Err(_) => ice_at(
            "novac/src/pipeline/pipeline.nv:454",
            "pipeline: a unit built from strings did not read back as UTF-8")
    }
}

/// Does `word` stand at byte `at` of `b`? A prefix test that allocates
/// nothing and takes no slice -- see the note inside `header_end`.
fn matches_at(b []u8, at int, word str) -> bool {
    ro w = word.bytes()
    ro m = word.byte_len()
    if at + m > b.len() { return false }
    for k in 0..m {
        if b[at + k] != w[k] { return false }
    }
    true
}

/// The byte just past a file's HEADER -- its `module` line and its imports.
///
/// The first step of the peers-as-one-unit wave (274.7 M): a unit is ONE
/// header followed by the BODIES of the module's files, because a naive
/// concatenation is refused -- a repeated `module` line and repeated imports
/// are not read (measured 2026-09-20). Everything else the unit needs is
/// arithmetic on this number, which is why it is a door of its own and has
/// its own test.
///
/// THE LAST header line decides, not the first body line. A doc comment sits
/// between them and belongs to the declaration below it, so asking "where do
/// the headers stop" is answerable while "where does the body start" is not:
/// the body's first line is a comment whose owner is two lines further down.
///
/// BYTES, not `@lines`, and the reason is measured elsewhere in this project:
/// a working copy can hold CRLF, and counting `line.byte_len() + 1` would
/// then drift by one per line -- silently, and only on some machines.
fn header_end(text str) -> int {
    ro b = text.bytes()
    ro n = text.byte_len()
    mut last = 0
    mut ls = 0
    mut i = 0
    // THE CANON IS `for i in 0..=n`, AND CARINA CANNOT READ IT. Asked her
    // directly rather than assumed: `novac/src/lex` and `novac/src/parse` carry
    // no inclusive-range token at all, and `..=` appears zero times in the whole
    // of `novac/src`. This file is part of the corpus Carina must compile to
    // build herself, so the canon form would be a form she cannot parse -- the
    // exact defect found in `check/variant_rules.nv` an hour earlier, where the
    // oracle compiled a line Carina refused.
    //
    // Goes back to the canon when `..=` is in the subset, not before.
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- `..=` absent from Carina's lexer and parser
    while i <= n {
        mut at_end = false
        if i == n {
            at_end = true
        } else {
            if b[i] == UNIT_LF {
                at_end = true
            } else {
                // A byte inside the line: the line has not ended, so the scan
                // walks on without touching where the line began.
            }
        }
        if at_end {
            // BYTES AGAIN, and this time not for CRLF but for the subset: the
            // obvious `text[ls..i].starts_with(...)` is a SLICE, and a slice is
            // not compiled by novac yet (registry No. 1170). Writing it here
            // would have added one line of self-hosting debt with the very
            // edit that exists to remove a quarter of it -- measured, not
            // feared: the first draft of this function did exactly that and
            // novac answered with one new refusal.
            if matches_at(b, ls, "module ") || matches_at(b, ls, "import ") {
                last = i
                if i < n {
                    last = i + 1
                } else {
                    // The header line is the last line of the text: there
                    // is no newline to step past.
                }
            } else {
                // Not a header line: the header ended before it, and `last`
                // keeps the end of the previous one.
            }
            ls = i + 1
        } else {
            // Mid-line: nothing is decided until the line ends.
        }
        i += 1
    }
    last
}

/// The line feed, by name: the scan above compares one byte, and a bare 0x0A
/// in an expression says nothing to the next reader.
///
/// THE SPELLING IS A SCAR, and it is cheaper to explain than to rediscover.
/// `novac.lex` has its own `B_LF`, NOT exported -- and a `const B_LF` here
/// still resolved to it: the C came out naming a symbol this unit does not
/// emit, and the test died at the C compiler. Renaming to `LF_BYTE` hit the
/// same wall against `novac.check`. So a private constant of a peer module is
/// NOT private today -- identity is a bare name without its module (the class
/// the registry knows as the key-without-module one). Measured twice in three
/// minutes, 2026-09-20, by two CC-FAILs on this file's own test.
const UNIT_LF u8 = 0x0A
/// One file to diagnostics, with the declarations and the interop surface
/// handed IN rather than read from disk.
///
/// The handing-in is what makes the pipeline testable without a filesystem,
/// and it is also how the unit wave feeds novac several files at once: the
/// text is a unit, the declarations are its peers'.
export fn compile_with(text str, decls []Node, interop InteropTable) -> []Diagnostic =>
    compile_with_embeds(text, decls, interop, EmbedTable.new())

/// The same, with what the door read for the text's `embed` calls (D412).
export fn compile_with_embeds(text str, decls []Node, interop InteropTable, embeds EmbedTable) -> []Diagnostic {
    ro fr = front(text, decls, interop, embeds)
    ro { src, tree, ctx, .. } = fr
    ro (diags, chan) = check(tree, src, ctx)
    if diags.len() > 0 { return derived_named(diags, fr) }
    // A generic body's mistakes exist only once an INSTANCE does, so `check`
    // runs the same instances the emitter will. Otherwise a file passes check
    // and is refused by emit: two verdicts about one file, which is the shape
    // this compiler exists to stop repeating.
    mut reach = reachable(tree, ctx, chan)
    ro (idiags, _) = instances_of(tree, src, ctx, reach, decls)
    derived_named(idiags, fr)
}

/// The unit as the checker sees it: its text, tree and context -- with the
/// methods `#impl(Serialize)` derives (D341) already IN the text.
///
/// D341 "Injection ordering": the synthesis is injected BEFORE type-check, so
/// the derived method is typed, instantiated and emitted like one its author
/// wrote. It needs the COLLECTED unit to be written (which types opted in, what
/// their fields are and whether each serializes), so the unit is collected,
/// the methods are spelled, and a unit that gained any is parsed and collected
/// again -- appended at the END, every offset of the author's text stays what
/// it was. A unit with no `#impl(Serialize)` pays nothing but the question.
type Front {
    src SourceText /// the text the phases read: the unit's, plus the derived methods
    tree Node /// its tree
    ctx Ctx /// its context
    at int /// where the derived methods begin in `src` -- the unit's own length
    derived DerivedText /// which method starts where, and whose it is
}

/// Parse and collect the unit, derive, and -- when anything was derived --
/// parse and collect the text that carries it.
fn front(text str, decls []Node, interop InteropTable, embeds EmbedTable) -> Front {
    ro tree = parse(tokens_of(text))
    ro ctx = context_with_embeds(tree, decls, interop, embeds)
    ro derived = derive_serialize_text(ctx)
    if derived.text == "" {
        return Front { src: SourceText { text }, tree, ctx, at: text.byte_len(), derived }
    } else {
        // Something to inject: the unit is read once more, with the methods in.
    }
    ro full = "${text}${derived.text}"
    ro tree2 = parse(tokens_of(full))
    Front { src: SourceText { text: full }, tree: tree2, ctx: context_with_embeds(tree2, decls, interop, embeds),
            at: text.byte_len(), derived }
}

/// A refusal raised INSIDE a derived method names that method, not the unit:
/// its span lies past the author's text, where no file of the unit has a byte.
/// The same shape a handed body's refusal takes (#1521) -- its own "file" and
/// an offset into it -- so the door prints it as it came.
fn derived_named(diags []Diagnostic, fr Front) -> []Diagnostic {
    mut out = []Diagnostic.new()
    for d in diags {
        // Nothing derived, a span that already names its file, or one in the
        // author's text: printed as it came.
        if fr.derived.owners.len() == 0 || d.file != "" || d.lo < fr.at {
            out.push(d)
            continue
        } else {
            // A span in the derived text: find the method it falls in.
        }
        mut k = 0
        while k + 1 < fr.derived.starts.len() && fr.at + fr.derived.starts[k + 1] <= d.lo {
            k += 1
        }
        ro base = fr.at + fr.derived.starts[k]
        ro owner = fr.derived.owners[k]
        out.push(Diagnostic { code: d.code, severity: d.severity, lo: d.lo - base, hi: d.hi - base,
                              file: "<#impl(Serialize) of ${owner}>",
                              message: "in the `@serialize` D341 derives for `${owner}`: ${d.message}" })
    }
    out
}

/// The declaration of a row, in THIS file. `None` when the row belongs
/// elsewhere -- a std signature, whose body novac does not compile.
///
/// THROUGH THE DOOR `file_decls`, not over the root's children (registry 1794):
/// `export fn count[T]` lies INSIDE its `ExportDecl` wrapper, and a raw walk did
/// not see it -- the instance of an exported generic was then read as a body
/// handed from outside, which it is not, and iced. One file was enough to show
/// it; the program mode only made it common, a module's generic being exported.
fn decl_of_row(tree Node, ctx Ctx, row FnRow) -> Option[Node] {
    for c in file_decls(tree) {
        if c.kind_of() != NodeKind.FnDecl { continue }
        match decl_fn_row(c, ctx) {
            // Not a callable of this file: nothing to compare against.
            None => {}
            Some(r) => {
                if r == row {
                    return Some(c)
                } else {
                    // Another callable's declaration: keep looking.
                }
            }
        }
    }
    None
}

/// The instances this file needs, each typed under its own substitution.
///
/// THE E2-b2 wiring, and it lives here because pass order lives here (274 p6):
/// mono decides WHICH instances exist, `check_instance` types each body under
/// its substitution into its OWN channel (Go stenciling), and the emitter
/// renders one C function per element. Neither check nor the emitter may call
/// the other, so the walk over the set belongs to the one module that calls
/// phases.
///
/// AN INSTANCE OF A HANDED BODY (274.11 E.10 step 4c) is typed from the tree it
/// was read from: its own text (the tree is lossless, `tree_reserialize`), its
/// own node capacity, its own file name for the contracts it prints. Its
/// callees are known only once it is typed, so the walk is a WORKLIST: each
/// such body grows the set (`Reach @grow`), and the loop runs until the set
/// stops growing -- `Vec[Pt] @push` reaches `@reserve`, which reaches `@cap`.
fn instances_of(tree Node, src SourceText, ctx Ctx, mut reach Reach, decls []Node) -> ([]Diagnostic, []Instantiation) {
    mut diags = []Diagnostic.new()
    mut insts = []Instantiation.new()
    // Node ids are handed out per FILE and the root takes the last one, so the
    // root's id plus one IS the file's node capacity -- what an instance
    // channel must be sized to, because a declaration's nodes sit anywhere in
    // that range.
    ro cap = raw_node(tree.id_of()) + 1
    // A FIXPOINT over rounds: a round types the instances the previous one
    // added (`done..upto`, the range evaluated once), and the set may grow
    // while it runs; the loop stops when a round adds nothing.
    mut done = 0
    while done < reach.instances().len() {
        ro upto = reach.instances().len()
        for k in done..upto {
            ro it = reach.instances()[k]
            match decl_of_row(tree, ctx, it.row) {
                Some(decl) => {
                    ro (idiags, ichan) = check_instance(decl, src, ctx, it.row, reach.subst_of(it), cap,
                                                        tree, module_dotted(tree))
                    diags.append(idiags)
                    // What THIS instance calls is known under ITS substitution
                    // only (registry 1522): `xs.is_empty()` in `empty[T]` is
                    // `Vec[int] @is_empty` in `empty[int]`, an instance the unit
                    // makes when the shell lacks it -- and the emitter names it
                    // from this very channel (`Ctx @body_ours`). The file's
                    // walk saw the body once, under the abstract `T`, where no
                    // such instance exists; so the set grows here, from the
                    // concrete channel, through the door a handed body takes.
                    if idiags.len() == 0 {
                        ro _ = reach.grow(decl, ctx, ichan)
                    } else {
                        // SILENT-OK: the body's refusals are the verdict; its callees are not walked.
                    }
                    insts.push(Instantiation { decl, row: it.row, subst: reach.subst_of(it),
                                               ptypes: reach.ptypes_of(it), ret_id: it.ret_id, chan: ichan,
                                               src_name: "" })
                }
                None => {
                    // mono instantiated a row this file does not declare: it must
                    // be a handed body (`Ctx @instantiates`); anything else is a
                    // broken invariant -- a call to a body novac does not compile
                    // is refused BY NAME in check.
                    ro decl = ctx.handed.decl_of(it.row) ?? ice_at(
                        "novac/src/pipeline/pipeline.nv:729",
                        "pipeline: an instance of a row with no body novac was handed")
                    ro t = ctx.handed.tree_of(it.row)
                    if t < 0 || t >= decls.len() {
                        ice_at(
                            "novac/src/pipeline/pipeline.nv:734",
                            "pipeline: a handed body names a declaration tree outside the decls")
                    } else {
                        // The tree the body was read from.
                    }
                    ro htree = decls[t]
                    // The ORIGINAL text, not a reserialized copy: a position is a
                    // slice's distance from the buffer it was cut from.
                    ro htext = ctx.interop.decl_text(t) ?? ice_at(
                        "novac/src/pipeline/pipeline.nv:743",
                        "pipeline: a handed body to instantiate, but the declarations were handed undescribed")
                    ro hname = ctx.interop.decl_name(t)
                    ro hsrc = SourceText { text: htext }
                    ro hcap = raw_node(htree.id_of()) + 1
                    // The body's OWN file and module decide its names (#1521).
                    ro (idiags, ichan) = check_instance(decl, hsrc, ctx, it.row, reach.subst_of(it), hcap,
                                                        htree, module_dotted(tree))
                    // A refusal INSIDE a handed body is about the text the body
                    // was written in, not the unit's: its span is an offset into
                    // THAT file, and the diagnostic names it (#1521) -- as the
                    // oracle does (`geo.nv:5:9`). Until #1521 it was printed
                    // against the compiled file at 0..0, the body's file only in
                    // the message.
                    for d in idiags {
                        diags.push(Diagnostic { code: d.code, severity: d.severity, lo: d.lo, hi: d.hi, file: hname,
                                                message: "in the instance of `${ctx.fns.rows[raw_row(it.row)].name}`: ${d.message}" })
                    }
                    if idiags.len() == 0 {
                        ro _ = reach.grow(decl, ctx, ichan)
                    } else {
                        // SILENT-OK: the body's refusals are the verdict; its callees are not walked.
                    }
                    insts.push(Instantiation { decl, row: it.row, subst: reach.subst_of(it),
                                               ptypes: reach.ptypes_of(it), ret_id: it.ret_id, chan: ichan,
                                               src_name: path_base(hname) })
                }
            }
        }
        done = upto
    }
    (diags, insts)
}

/// Emit C for a CLEAN e1 file. Contract: call only when compile() returned
/// an empty list — the emitter never sees broken input (poisoning). Returns
/// (diags, c_text): non-empty diags means c_text is empty and must not be
/// used; no Result in signatures (274 p4.1).
export fn compile_to_c(text str, decl_texts []str) -> ([]Diagnostic, str) =>
    compile_to_c_with(text, parse_decls(decl_texts), described_surface(decl_texts))

/// The same, given declarations ALREADY parsed.
export fn compile_to_c_with(text str, decls []Node, interop InteropTable,
                            src_name str = "") -> ([]Diagnostic, str) =>
    compile_to_c_with_embeds(text, decls, interop, src_name, EmbedTable.new())

/// The same, with what the door read for the text's `embed` calls (D412).
export fn compile_to_c_with_embeds(text str, decls []Node, interop InteropTable, src_name str,
                                   embeds EmbedTable) -> ([]Diagnostic, str) {
    ro fr = front(text, decls, interop, embeds)
    ro { src, tree, ctx, .. } = fr
    ro (diags, chan) = check(tree, src, ctx)
    if diags.len() > 0 {
        return (derived_named(diags, fr), "")
    }
    // WHICH callables exist is mono's decision, and it is taken once, here:
    // the emitter is handed the answer, not the collector (E2-b2).
    mut reach = reachable(tree, ctx, chan)
    ro (idiags, insts) = instances_of(tree, src, ctx, reach, decls)
    if idiags.len() > 0 {
        return (derived_named(idiags, fr), "")
    }
    // The emitter is handed the checker's channel, not the checker: it reads
    // decisions and cannot ask for a new one (E2-b1).
    (diags, emit(tree, ctx, chan, reach, insts, src_name: src_name))
}
