// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/pipeline — tests beside the module, THROUGH the one door: the
// no-cascade property (one seeded mistake, exactly one diagnostic) is judged
// on compile(), never by naming phases — the architecture's own rule.
//
// History note (2026-08-14): this file carried a self-expiring negative
// cc-error marker for registry #659 (a synthesized derive method's dummy
// span made the receiver's C name resolve through the CU entry file; with
// a name-colliding type in the merged CU the reference went to a base
// nobody emits). The compiler fix landed the same day, the marker fell
// loudly as designed, and the six property tests below went live.
// Check-level units are possible again (the cases first lived in
// check_test.nv).

module novac.pipeline

import ../tree.{Node, NodeKind, raw_node}
import ../parse.{parse}
import ../sem.{branch_children, leaf_text, is_value_record, is_paren_form_record, InteropTable}
import ../source.{SourceText}
import ../diag.{ice}
import ../check.{check_instance}
import ../types.{TyId, no_ty}

// The std signatures these tests need, handed in the way the driver hands
// them: as TEXT through the one door. Inline and tiny on purpose — the
// tests stay hermetic (no filesystem, no path, no std dir) and still exercise
// the real declaration-reading path instead of a special case.
//
// History (2026-08-15): this used to hand an EMPTY list, which was right
// while methods were a hardcoded table and wrong the moment they became
// read data. The strings test went red and stayed red unnoticed, because
// the module tests were blocked by an unrelated oracle regression at the
// time. Handing the signatures is the honest fix; weakening the assert
// would have hidden the same hole.
fn std_decls() -> []str => []str.of("fn str @byte_len() -> int => 0\nfn str @to_ascii_upper() -> str => \"\"\nfn str @starts_with(needle str) -> bool => true\n")

fn n_diags(text str) -> int => compile(text, std_decls()).len()

test "no cascade: a run of top-level junk is one cause, one diagnostic" {
    // E1 review p.1 (2026-08-14): this used to be THREE diagnostics.
    assert(n_diags("1 2 3") == 1)
}

test "no cascade: junk between signature and block is one diagnostic" {
    assert(n_diags("fn main junk here () { }") == 1)
}

test "clean subset file: zero diagnostics" {
    assert(n_diags("module a.b\nfn main() { println(\"hi\", 1 + 2) }") == 0)
}

test "two separate causes: two diagnostics" {
    // Junk at top level AND an unterminated string inside a fn are two
    // independently seeded mistakes — the rule is one PER CAUSE, not one
    // per file.
    assert(n_diags("?? fn main() { \"unterminated") == 2)
}

test "unterminated string alone: one diagnostic, honest refusal" {
    // E1 review p.4: an unclosed string is ErrorTok now, not a plausible
    // StrLit.
    assert(n_diags("fn main() { \"oops }") == 1)
}

test "stray module after the header: one diagnostic, no hang (fuzzer 2026-08-14)" {
    // The doubled-file mutation. KwModule is a sync point for BOTH junk
    // buckets, so the top loop itself must consume it: before the fix this
    // input spun forever pushing empty Err branches until the GC died.
    assert(n_diags("fn main() { }\nmodule") == 1)
    assert(n_diags("module a\nfn main() { }\nmodule a\nfn main() { }") == 1)
}

test "recovery at EOF: diagnostic lands at end of file, no panic (fuzzer 2026-08-14)" {
    // Truncation mid-statement: primary() recovers by consuming the Eof
    // leaf. Its text used to be the "" literal — a foreign pointer for the
    // position door, killed by offset_of's contract assert. Now it is the
    // end-anchored empty slice and the report is honest.
    assert(n_diags("fn main() { mut i") == 1)
}

test "E2 strings surface: the shapes are in, a std method with no compiled body is refused" {
    // `byte_len`, `to_ascii_upper`, `starts_with` are declared in std, and their
    // BODIES live in std's own Nova source -- which novac does not compile yet.
    // Every C name is ours now (the oracle's spelling was removed on 2026-08-20
    // with the `foreign` branch), so a call to a body novac does not emit would
    // name a symbol that exists nowhere. The subset says that instead, and the
    // corpus baseline was lowered 11/5 -> 10/4 in the same wave.
    ro src = "fn main() { ro s = \"ab\"\n while s.byte_len() < 1 { println(s.to_ascii_upper()) }\n println(s.starts_with(\"a\")) }"
    // THREE refusals, one per call (274.4 step 2): until the mark replaced
    // the file-count guard in the MethodCall arm, every call after the first
    // refusal was silently resolved by type_of's own lookup -- the second
    // door -- and this line asserted 1. More refusals required, not fewer.
    assert(n_diags(src) == 3)
    // The SHAPES are still in the subset: the same `ro` and `while` without a
    // std body are clean, so the refusal above is about the missing body and
    // not about the form.
    assert(n_diags("fn main() { mut i = 0\n while i < 1 { i += 1 }\n println(i) }") == 0)
}

/// The `fn id[T](x T) -> T => x` declaration of this source, by name.
fn generic_decl_of(tree Node, want str) -> Node {
    for c in branch_children(tree) {
        if c.kind_of() != NodeKind.FnDecl { continue }
        ro kids = branch_children(c)
        if kids.len() < 2 { continue }
        if kids[1].kind_of() != NodeKind.LeafNode { continue }
        if leaf_text(kids[1]) == want { return c }
    }
    ice("pipeline_test: the fixture lost its declaration")
}

test "an instance types its body under the substitution, in its own channel (E2-b2)" {
    // Go stenciling: ONE copy of the body per instance, each typed on its own.
    // The assertion is on what the channel HOLDS, not on silence -- before
    // 2026-08-20 a generic body was not typed at all, and "no diagnostics"
    // would have passed while nothing whatever had happened.
    ro src = "fn twice[T](x T) -> T => x + x\nfn main() { println(1) }"
    ro tree = parse(tokens_of(src))
    ro ctx = context(tree, parse_decls(std_decls()), InteropTable.new())
    ro decl = generic_decl_of(tree, "twice")
    ro (diags, chan) = check_instance(decl, SourceText { text: src }, ctx,
        []TyId.of(ctx.prims.int_id), raw_node(tree.id_of()) + 1)
    assert(diags.len() == 0)
    // The tail is `x + x`, and its recorded type is the SUBSTITUTED one: int.
    // A bare name would prove nothing here -- the channel deliberately does
    // not record one (the lattice reads it from the scope), so the assertion
    // stands on an expression whose type the channel DOES carry.
    ro kids = branch_children(decl)
    mut body_t = -1
    for c in kids {
        if c.kind_of() != NodeKind.FnExprBody { continue }
        ro ek = branch_children(c)
        body_t = chan.type_of(ek[ek.len() - 1].id_of())
    }
    assert(body_t == ctx.prims.int_id)
}

test "a generic call is COMPILED: two instances, two C functions (E2-b2)" {
    // The acceptance of E2-b2, and it is asserted on the emission rather than
    // on silence: `dbl[int]` and `dbl[f64]` are two C functions of one body,
    // each named by its substitution through `c_callable`.
    ro src = "fn dbl[T](x T) -> T => x + x\nfn main() { println(dbl[int](21))\n println(dbl[f64](1.5)) }"
    ro (diags, c) = compile_to_c(src, std_decls())
    assert(diags.len() == 0)
    assert(c.contains("dbl__nova_int__to_nova_int__nova_int"))
    assert(c.contains("dbl__nova_f64__to_nova_f64__nova_f64"))
    // The generic body itself is NOT emitted as a function of its own: there is
    // no such C function, only its instances. A `dbl(` substring would match
    // the instances too, so the assertion is on the SIGNATURE the template
    // would have had -- a bare `T` parameter, which has no C spelling at all.
    assert(!c.contains("dbl(nova_int"))
}

test "a generic call without type arguments DEDUCES from the arguments (E2-b3 wave 1)" {
    // THE CONTRACT CHANGED ON PURPOSE, 2026-08-23. Until then this test asserted
    // the opposite -- one diagnostic -- and that was honest for E2-b2, where the
    // turbofish WAS the whole mapping. Wave 1 of sub-plan 9.1e added
    // argument-directed deduction (donor Go 1.18), so the same source is now
    // accepted and instantiated.
    ro (diags, c) = compile_to_c("fn dbl[T](x T) -> T => x + x\nfn main() { println(dbl(4)) }", std_decls())
    assert(diags.len() == 0)
    // The INSTANCE is what deduction has to produce -- accepting the call while
    // emitting no instance would be the weaker half of the same bug.
    assert(c.contains("dbl__nova_int__to_nova_int__nova_int"))
}

test "the UNIT return type is a type, not a tuple (E2-b3 wave 3g-2)" {
    // `-> ()` is the form novac's OWN source is written in -- hundreds of
    // signatures -- and the return-shape rule used to refuse it together with
    // the tuple `(a, b)`, because both start with `(`. Stage 5 (self-build) was
    // locked behind that one rule.
    //
    // Held by a test and not by a fixture, on purpose: a `neg_*` must assert
    // AGREEMENT about the outcome, and every negative shape measured for this
    // form disagrees -- `ro x = m.reset()` (binding a unit) is accepted by the
    // oracle and refused by novac at `println`, and `-> () => 3` (an int body
    // under a unit return) is accepted by BOTH, which is a shared typing hole
    // rather than a rule. Recorded in the plan; the pair lands when a negative
    // with an agreeing outcome exists.
    ro src = "type Box { mut n int }
fn Box mut @reset() -> () {
    @n = 0
}
fn main() { mut b = Box { n: 5 }
 b.reset()
 println(\"n = \", b.n) }"
    ro (diags, c) = compile_to_c(src, std_decls())
    assert(diags.len() == 0)
    // The emission must carry the unit's ABI name: a return type that compiled
    // to something else would be a silent layout change.
    assert(c.contains("nova_unit"))
}

test "a protocol declaration is READ and JUDGED, not refused (E2-b3 waves 3a+3b)" {
    // FOUR answers this line has given, and three of them were wrong -- kept
    // here because the sequence is the lesson:
    //   1. "syntax error: this is not a form of the language" (before wave 3a)
    //      -- a legal form of Nova called a non-language, the worst of the four:
    //      it sends the author to fix correct code.
    //   2. accepted SILENTLY (3a's parser without a judge) -- a dropped contract
    //      looks like a compiled file.
    //   3. refused BY NAME, naming the wave (3a) -- honest while nothing could
    //      check a contract.
    //   4. accepted and REGISTERED (3b) -- the signatures are in the registry
    //      and the call site filters by them, so refusing the declaration would
    //      refuse every correct program that declares one.
    //
    // The form comes from examples/tour/methods.nv, which the oracle compiles.
    ro src = "type Sized protocol {\n    @size() -> int\n}\nfn main() { println(\"ok\") }"
    assert(n_diags(src) == 0)
}

test "a bound naming an UNKNOWN protocol is still refused by name (E2-b3 wave 3b)" {
    // The bound is checked against the REGISTRY, so `Nope` -- declared nowhere --
    // keeps the refusal that every bound used to get. Without this half, making
    // known bounds legal would have made unknown ones legal too, which is the
    // silent-acceptance shape wave 3a already paid for once.
    ro src = "fn twice[T Nope](a T) -> int => 2\nfn main() { println(twice(1)) }"
    assert(n_diags(src) == 1)
}

test "deduction refuses BY NAME where it cannot decide (E2-b3 wave 1)" {
    // Two arguments wanting different types for one parameter: whichever one
    // "wins" decides which C symbol the call names, so a silent choice picks
    // somebody else's symbol.
    assert(n_diags("fn pick[T](a T, b T) -> T => a\nfn main() { println(pick(1, \"s\")) }") == 1)
    // Nothing fixes the parameter: `T` appears only in the return type, and
    // wave 1 deduces from ARGUMENTS only. The oracle passes this file at `check`
    // and dies in codegen -- class O-1c, recorded in novac-divergences.md.
    assert(n_diags("fn make[T]() -> T => make()\nfn main() { println(\"x = \", make()) }") == 1)
}

/// A declaration text carrying a `#coerce` pair, handed in the way the driver
/// hands std declarations. The pair CANNOT come from the compiled file: novac
/// compiles no method body, so the declaration is where D429 pairs live for it.
fn coerce_decls() -> []str =>
    []str.of("#coerce\nfn Cel consume @into_f64() -> f64 => 0.0\n")

/// The file both coerce tests judge: a record where an `f64` is declared.
fn coerce_src() -> str =>
    "type Cel { v f64 }\nfn show(x f64) -> f64 => x\nfn main() { ro c = Cel { v: 1.5 }\n println(show(c)) }"

test "a wrong-typed argument is REFUSED, not emitted (the key is the types, D84)" {
    // The regression this test exists for: with no pair declared, novac used to
    // ACCEPT this file and emit `novac_fn_show__nova_f64__to_nova_f64(c)` -- a
    // struct pointer where a double is declared. The call was looked up with
    // no_ty() in every argument slot, so only the arity was compared.
    assert(compile(coerce_src(), std_decls()).len() == 1)
}

test "an argument that coerces (D429) is refused for the RIGHT reason" {
    // With the pair declared, the same file is legal Nova -- the oracle compiles
    // it and prints 1.5. What novac lacks is the emission: R7 makes the
    // insertion a call to the declared method, and novac compiles no method
    // body yet. So the refusal names THAT, and not "nothing fits" -- which is
    // the difference between a boundary and a lie about the program.
    ro diags = compile(coerce_src(), coerce_decls())
    assert(diags.len() == 1)
    assert(diags[0].message.contains("#coerce"))
    // And the pair is read from the DECLARATION, not known by the compiler: the
    // same file with the same declaration minus the attribute is refused as an
    // ordinary type mismatch, with no mention of D429.
    ro plain = compile(coerce_src(), []str.of("fn Cel consume @into_f64() -> f64 => 0.0\n"))
    assert(plain.len() == 1)
    assert(!plain[0].message.contains("#coerce"))
}

test "a receiver MODE is read AND judged: a consuming method needs a consuming place" {
    // Two halves of one rule, and the second half moved this contract on
    // 2026-08-21 (P14: the receiver is parameter zero, so its mode filters the
    // call like any other position).
    //
    // Until then the parser read exactly `mut` as a receiver qualifier, so every
    // `consume` method of std -- including both finalize-lane `#coerce` pairs --
    // fell through to the free-function shape and harvested NO row at all.
    ro decls = []str.of("fn Cel consume @into_f64() -> f64 => 0.0\n")
    // A `consume` receiver does not take a `ro` binding: nothing fits, so the
    // refusal is about the call, not about a missing body.
    ro on_ro = compile("type Cel { v f64 }\nfn main() { ro c = Cel { v: 1.5 }\n println(c.into_f64()) }", decls)
    assert(on_ro.len() == 1)
    assert(!on_ro[0].message.contains("compiles no body"))
    // A `consume` BINDING is the place it does take -- the signature IS found,
    // and what novac lacks is the method's body.
    ro on_consume = compile("type Cel { v f64 }\nfn main() { consume c = Cel { v: 1.5 }\n println(c.into_f64()) }", decls)
    assert(on_consume.len() == 1)
    assert(on_consume[0].message.contains("compiles no body"))
}

test "`Self` in a declaration is the RECEIVER's type, not a missing one" {
    // `Self` names no declaration and is in no registry, so a door that only
    // asked `defs` dropped the WHOLE signature -- and the refusal at the use
    // site then said "no such method" about a method std declares. std spells
    // `Self` 264 times across 50 files (measured 2026-08-21).
    ro decls = []str.of("fn Cel @twin() -> Self => 0
")
    ro src = "type Cel { v f64 }
fn main() { ro c = Cel { v: 1.0 }
 println(c.twin().v) }"
    ro diags = compile(src, decls)
    assert(diags.len() == 1)
    // Read, and refused for the reason that is left: novac emits no method body.
    assert(diags[0].message.contains("compiles no body"))
}

test "a BOUND is not a type parameter: the arity is ONE, not two" {
    // Until 2026-08-21 the collector took every identifier of a generics list,
    // so `[T Compare]` registered TWO parameters and the honest call
    // `pick[int](3)` was refused as "a different number of type arguments" -- a
    // lie about a legal program, and the only way to satisfy the count was to
    // write `pick[int, Compare]`.
    ro src = "fn pick[T Compare](a T) -> T => a
fn main() { println(1) }"
    ro tree = parse(tokens_of(src))
    ro ctx = context(tree, parse_decls(std_decls()), InteropTable.new())
    match ctx.defs.fn_row("pick") {
        None => assert(false)
        Some(row) => assert(ctx.fns.rows[row].tparam_cnt == 1)
    }
}

test "the two CONSTRAINTS of a generics entry get two different refusals" {
    // The full form of an entry is `T [consume] [Protocol + ...]` (owner,
    // 2026-08-21). `[T consume]` constrains LINEARITY -- measured: the oracle
    // accepts `fn take[T consume](consume a T) -> T => a`, and answers
    // `[D156-strict-forget]` when the body does not consume -- while
    // `[T Compare]` constrains DISPATCH. novac has neither, and one message for
    // both would name a cause it never established.
    ro lin = compile("fn take[T consume](consume a T) -> T => a
fn main() { println(1) }", std_decls())
    assert(lin.len() == 1)
    assert(lin[0].message.contains("must-consume"))
    ro proto = compile("fn take[T Compare](a T) -> int => 1
fn main() { println(1) }", std_decls())
    assert(proto.len() == 1)
    assert(proto[0].message.contains("protocol"))
}

test "a bound is refused BY NAME, and once" {
    // novac neither dispatches a protocol nor verifies a constraint (both
    // arrive with E2-b3), and compiling the generic as if the bound were not
    // written would accept what the oracle rejects. One cause, one diagnostic.
    ro diags = compile("fn pick[T Compare](a T) -> T => a
fn main() { println(1) }", std_decls())
    assert(diags.len() == 1)
    assert(diags[0].message.contains("bound on a type parameter"))
}

test "E2 records surface is clean: type decl, ctor, punning, spread, field" {
    ro src = "type P { a f64 }\nfn main() { ro p = P { a: 1.5 }\n ro q = { ...p, a: 2.5 }\n println(q.a) }"
    assert(n_diags(src) == 0)
}

test "record ctor outside a binding initializer is refused in CHECK (E2 boundary)" {
    // The emitter's tmp scheme exists only for the binding-init shape; a
    // green check here would turn into an emitter ice killing the smoke.
    assert(n_diags("type P { a int }\nfn main() { println(P { a: 1 }) }") == 1)
}

test "unknown method is an honest subset refusal at the name" {
    assert(n_diags("fn main() { println(\"s\".reverse()) }") == 1)
}

test "no silent type defaults: fn without a return type is refused (#652 class)" {
    // The owner's rule 2026-08-14: a quiet nova_int fallback bred a bug
    // family in the current compiler — the boundary falls in check, the
    // emitter's ice is only the second floor.
    assert(n_diags("fn helper() { println(\"x\") }\nfn main() { }") == 1)
}

test "E2 match surface is clean: sum decl, arms, guards, expression fn" {
    ro src = "type S\n | A(f64)\n | B(f64, f64)\nfn area(s S) -> f64 => match s {\n A(r) => r\n B(w, h) => w * h\n}\nfn main() { println(area(A(1.5))) }"
    assert(n_diags(src) == 0)
}

test "escaped interpolation is a literal, not a refusal" {
    // E1 review p.4: `\${` is the escaped literal form — lexes as StrLit.
    // The input is assembled by concatenation so THIS file's own string
    // literal does not interpolate.
    ro src = "fn main() { println(\"\\".concat("$").concat("{x}\") }")
    assert(n_diags(src) == 0)
}

test "a static method on a GENERIC type is refused by name, never iced" {
    // FOUND BY THE CORPUS BATCH 2026-08-23, and only because a batch that dies
    // is not read as "all accepted": `novac check` over the 61 corpus files
    // exited rc=2 with `E_NOVAC_ICE ... leaf_kind on a branch node`. Carrier:
    // `examples/.../serde_encode_pointer_op.nv`, line 46.
    //
    // CAUSE: `fn P[A].mk()` puts the receiver's TYPE ARGUMENTS -- a branch --
    // exactly where the three mode readers expected a word, and they asked
    // `leaf_kind` of it. The form became reachable when wave 3g taught the
    // collector to read a method declared in the compiled file; before that
    // every non-leaf declaration head was dropped, so the ice had nowhere to
    // happen. Fixed at the class: what a mode word IS lives in one door
    // (`mode_of_leaf`), and the guard against a branch lives inside it.
    //
    // PINNED HERE AND NOT AS A FIXTURE, with the reason: the oracle COMPILES
    // this form, so a `neg_*` pair would assert a divergence as if it were a
    // rule. [INV-GUARD: check-novac-module-tests.sh] The ICE not coming back is
    // held by THIS test and by the gate step that runs it, not by anyone's
    // memory: revert the door and this file fails. That is a property of
    // novac alone -- exactly what a module test is for.
    ro src = "type P[A] { fst A }
fn P[A].mk(a A) -> int => 1
fn main() { println(1) }"
    ro (diags, _) = compile_to_c(src, std_decls())
    // Named, and named ONCE: an ice would be `E_NOVAC_ICE`, and a cascade would
    // be two diagnostics about one form.
    assert(diags.len() == 1)
    assert(!diags[0].message.contains("internal compiler error"))
    assert(diags[0].message.contains("generic parameters are not compiled yet"))
}

test "a handed-over type is KNOWN, and the file's own declaration of that name wins" {
    // TWO CRITERIA IN ONE FILE, because they are one mechanism: the handed-over
    // types are registered BEFORE the compiled file's passes, so (a) a signature
    // of the file may name one of them and (b) a name the file also declares is
    // overwritten by the file's own row -- a program is compiled against what it
    // declares.
    //
    // The shapes differ on purpose: the handed-over `Pair` has a field `a`, the
    // file's own has `b`. If the foreign row won, `p.b` would be "unknown field",
    // and if the foreign types were registered AFTER the file (the order this
    // wave corrected), `take(p Pair)` would be refused as a type novac does not
    // know. Either regression turns this test red.
    ro handed = "module std.pairs
export type Pair value { a int }
fn Pair @first() -> int => 1"
    ro src = "module m.own
type Pair { b int }
fn take(p Pair) -> int => p.b
fn main() {
 ro p = Pair { b: 7 }
 println(take(p))
}"
    ro (diags, c) = compile_to_c(src, []str.of(handed))
    assert(diags.len() == 0)
    // AND THE TYPE IS THE FILE'S OWN, asked of the REGISTRY rather than of the
    // emitted text: P24 forbids reading a C name back apart, and it is right --
    // the identity lives in the registry, and a string check would pass on a
    // substring of some other name. The file's `Pair` is a PLAIN record; the
    // handed-over one is a `value` record, so `by_value` tells them apart with
    // no spelling involved.
    // Asked through the doors of this layer: `is_value_record` is sem's own
    // answer about a type, and the type comes from the registry by name. The
    // architecture has no `pipeline -> names` edge, and a test does not get to
    // add one -- an edge is a line in the table of section 3, with a contract.
    ro ctx = context(parse(tokens_of(src)), parse_decls([]str.of(handed)), InteropTable.new())
    assert(!is_value_record(ctx, ctx.ty_of_name("Pair") ?? no_ty()))
}

test "the parenthesised record form is READ, and its brace construction refused (V2a)" {
    // `type Pair(x int, y int)` is a record whose fields are written in one
    // line (D215). Before wave V2a the parser handed the tail to `@type_ref`,
    // which read the parens as a flat run of leaves with no `Field` node, so
    // `shape_of_decl` classified Pair as a NEWTYPE over `int` -- both field
    // names and the second field vanished in silence.
    //
    // TWO criteria in one test because they are one mechanism: the declaration
    // must READ (zero diagnostics on a file that only declares it), and the
    // BRACE construction must be refused BY NAME -- the oracle accepts
    // `Pair { x: 1 }` at check and then fails to emit it (`undeclared
    // identifier 'Nova_Pair'`, measured 2026-09-03), so emitting a struct here
    // would invent a construction the fixed point does not have. The call form
    // `Pair(1, 2)` is the one that works, and it arrives with V2b.
    ro (clean, _) = compile_to_c("module m.p
type Pair(x int, y int)
fn main() { println(1) }", []str.new())
    assert(clean.len() == 0)
    // The SHAPE is the registry's answer, asked through the door (P24: no
    // reading a C name back apart).
    ro ctx = context(parse(tokens_of("module m.p
type Pair(x int, y int)
fn main() { println(1) }")), parse_decls([]str.new()), InteropTable.new())
    assert(is_paren_form_record(ctx, ctx.ty_of_name("Pair") ?? no_ty()))
    // And the brace form is refused by name, not accepted and emitted.
    ro (braced, _) = compile_to_c("module m.b
type Pair(x int, y int)
fn main() {
 ro p = Pair { x: 1, y: 2 }
 println(p.x)
}", []str.new())
    mut named = false
    for d in braced {
        if d.message.contains("constructed by call") { named = true }
    }
    assert(named)
}

test "a `value` record answers is_value_record -- the POSITIVE side of the shape" {
    // Until 2026-09-03 NOTHING held this direction: `NovaValue_` was asserted
    // nowhere and the only is_value_record test was the negative above, so the
    // whole "value record = stack" axis stood on good behaviour (found by the
    // plan-recheck of 274.6). This is the holder wave V1's reverse probe
    // reddens: stub the ValueRecord arm of `is_value_record` to answer false
    // and this assert goes red; restore it and it greens.
    //
    // Judged through the DOOR, not the C text: P24 forbids reading a C name
    // back apart, and check-novac-mangling-one-way refuses Nova-prefixed
    // spellings in test asserts -- the door IS sem's answer about the type.
    ro src = "module m.v
type P value { n int }
fn main() {
 ro p = P { n: 7 }
 println(p.n)
}"
    ro (diags, _) = compile_to_c(src, []str.new())
    assert(diags.len() == 0)
    ro ctx = context(parse(tokens_of(src)), parse_decls([]str.new()), InteropTable.new())
    assert(is_value_record(ctx, ctx.ty_of_name("P") ?? no_ty()))
}

test "a type nobody declared is still refused by name" {
    // The boundary of the same mechanism: registering handed-over types must not
    // turn every unknown name into a type. `Zork` is declared nowhere.
    ro (diags, _) = compile_to_c("module m.z
fn take(z Zork) -> int => 1
fn main() { println(1) }",
                                 []str.of("module std.pairs
export type Pair value { a int }"))
    assert(diags.len() == 1)
    assert(diags[0].message.contains("does not know this type yet"))
}

test "a handed-over GENERIC declaration is a HEAD: bare use refused by the TRUTH" {
    // THE CONTRACT MOVED WITH STEP B1, in the same merge as the code. Step A
    // skipped generics so a bare `Box` could not RESOLVE; B1 registers the head
    // and moves the hole's lid into the RESOLVER (`ty_or_none` answers no_ty
    // for a head) -- so the refusal stays, and its text stops lying: the
    // registry KNOWS `Box`, what is missing is the arguments. The oracle
    // accepts the bare head (measured 2026-08-26, PASS with no call); the
    // strictness is deliberate and named in the plan.
    ro handed = "module std.box
export type Box[T] { v T }
export type Meta { n int }"
    ro (d1, _) = compile_to_c("module m.g
fn take(b Box) -> int => 1
fn main() { println(1) }",
                              []str.of(handed))
    assert(d1.len() == 1)
    assert(d1[0].message.contains("write its type arguments"))
    // And the NON-generic neighbour from the same handed text IS visible: the
    // skip is a hole for generics, not a hole for the file that carries one.
    ro (d2, _) = compile_to_c("module m.g2
fn take(m Meta) -> int => 1
fn main() { println(1) }",
                              []str.of(handed))
    assert(d2.len() == 0)
}

test "nesting deeper than the ceiling is refused ONCE, and the stack survives (#807, #808)" {
    // Registry #807 and #808, found by the hunter 2026-08-30. The parser had no
    // depth counter: 513 nested parens were accepted in SILENCE (the oracle
    // says E_NESTING_TOO_DEEP) and 2500 killed the process with a stack
    // overflow, rc=127 -- against this file's own header promise that recovery
    // never panics or hangs.
    //
    // The test holds the CLASS in three parts: ordinary nesting still passes,
    // over-deep nesting is refused, and it is refused EXACTLY ONCE -- the
    // cascade is what made the first fix worse than the defect (511 diagnostics
    // for one mistake), so the count is the assertion that matters.
    ro std = std_decls()
    ro shallow = "fn main() {\n println(((((1)))))\n}"
    ro (d1, _) = compile_to_c(shallow, std)
    assert(d1.len() == 0)

    mut deep = "fn main() {\n println("
    for _ in 0..600 {
        deep = "${deep}("
    }
    deep = "${deep}1"
    for _ in 0..600 {
        deep = "${deep})"
    }
    deep = "${deep})\n}"
    ro (d2, _) = compile_to_c(deep, std)
    assert(d2.len() == 1)
    assert(d2[0].message.contains("nesting is deeper"))
}

test "an integer literal too large for `int` is refused, not silently wrapped (#810)" {
    // Registry #810, found by the hunter 2026-08-30. The magnitude of a decimal
    // literal was checked NOWHERE: the lexer made an IntLit of any run of
    // digits, the lattice typed it `int` without looking, and the emitter
    // printed the text verbatim with an `LL` suffix -- so `2^64` overflowed a
    // signed long long in the emitted C. A SILENT MISCOMPILE, not a missing
    // refusal; the oracle says "number too large to fit in target type".
    //
    // The test holds the CLASS, not the carrier: the boundary value passes,
    // one past it refuses, and leading zeros do not inflate the count.
    ro std = std_decls()
    ro (d1, _) = compile_to_c("fn main() {\n println(18446744073709551616)\n}", std)
    assert(d1.len() == 1)
    assert(d1[0].message.contains("does not fit in `int`"))

    ro (d2, _) = compile_to_c("fn main() {\n println(9999999999999999999999999999999999999)\n}", std)
    assert(d2.len() == 1)

    // The largest `int` is legal, and so is the same number written with
    // leading zeros: the rule compares DIGITS, and a zero is not a digit that
    // makes a number bigger.
    ro (d3, _) = compile_to_c("fn main() {\n println(9223372036854775807)\n println(0000009)\n}", std)
    assert(d3.len() == 0)
}

test "an unclosed bracket is refused, not accepted in silence (#809)" {
    // Registry #809, found by the hunter 2026-08-30 (probe `brace_only_fn`):
    // `fn main() {` with no `}` compiled with code 0 and NOT ONE diagnostic.
    // The mechanism was one door doing two jobs. `@push_if` means "the token
    // is optional at this position, and its absence is a valid outcome" --
    // true of a trailing comma, false of a bracket whose opener has already
    // been consumed. Sixteen closing brackets went through it.
    //
    // The test holds the CLASS: all three closers, because all three shared
    // the door -- 5 `}`, 6 `)` and 5 `]` call sites.
    ro std = std_decls()
    ro (d1, _) = compile_to_c("fn main() {", std)
    assert(d1.len() >= 1)

    ro (d2, _) = compile_to_c("fn main() {
 println(1
}", std)
    assert(d2.len() >= 1)

    ro (d3, _) = compile_to_c("fn main() {
 ro xs = [1, 2
 println(1)
}", std)
    assert(d3.len() >= 1)

    // The other direction of the lid: the same forms CLOSED are clean, so the
    // rule refuses the ABSENCE and not the shape. The brace and the paren are
    // shown here; the bracket is not, and the reason is the harness rather
    // than the rule -- an array literal is built from the SHELL's instance
    // set, which `std_decls()` does not carry, so a CLOSED `[1, 2]` is
    // refused here for a reason of its own (measured 2026-08-30). Its clean
    // side is held by the corpus fixture `array_lit_positions.nv` instead.
    ro (d4, _) = compile_to_c("fn main() {
 println(1)
}", std)
    assert(d4.len() == 0)
}

test "a record construction is judged against its declaration (#812)" {
    // Registry #812, same hunt. `Pt { }` on a record with a required field
    // checked CLEAN and the emitted C read a member nobody wrote. The fork
    // "is an empty literal legal" was decided by the SPEC, not by the oracle:
    // `02-types.md:152` and the numbered rules at `:1677` -- construction
    // always requires every declared field, and a name the type does not have
    // is an error.
    ro std = std_decls()

    // a declared field nobody named
    ro (d1, _) = compile_to_c("type Pt { n int }
fn main() {
 ro p = Pt { }
 println(p.n)
}", std)
    assert(d1.len() >= 1)
    assert(d1[0].message.contains("omits a declared field"))

    // a field the type does not declare
    ro (d2, _) = compile_to_c("type Pt { n int }
fn main() {
 ro p = Pt { n: 1, z: 2 }
 println(p.n)
}", std)
    assert(d2.len() >= 1)
    assert(d2[0].message.contains("does not declare"))

    // one field named twice fills the count and leaves the record short
    ro (d3, _) = compile_to_c("type Pt { n int }
fn main() {
 ro p = Pt { n: 1, n: 2 }
 println(p.n)
}", std)
    assert(d3.len() >= 1)

    // The other direction: a complete construction is clean. ONE field, not
    // two, and that is a measurement rather than a preference -- novac does
    // not read a record whose fields are separated by a comma yet (2026-08-30:
    // the refusal lands on the comma itself), so a two-field record would
    // test the parser's gap and not this rule.
    ro (d4, _) = compile_to_c("type Pt { n int }
fn main() {
 ro p = Pt { n: 1 }
 println(p.n)
}", std)
    assert(d4.len() == 0)
}

test "a token the grammar requires is refused when absent (#815)" {
    // Registry #815, class K6, found by the hunt of parse x K2: thirteen
    // probes where novac exited 0 in silence and the oracle refused. One door
    // was doing two jobs -- `@push_if` means "optional here, and absence is a
    // valid outcome", which is true of a trailing comma and false of a name.
    //
    // The test holds the CLASS, so it asks about DIFFERENT kinds of required
    // token, not one carrier: a name, an `=`, the `(` of a signature, the `{`
    // of a match. The registry is explicit that repairing thirteen listed
    // sites would be a carrier fix and not acceptance.
    ro std = std_decls()

    // a type with no name
    ro (d1, _) = compile_to_c("type { n int }
fn main() { println(1) }", std)
    assert(d1.len() >= 1)

    // a binding with no name
    ro (d2, _) = compile_to_c("fn main() {
 mut = 1
 println(1)
}", std)
    assert(d2.len() >= 1)

    // a binding with no `=`
    ro (d3, _) = compile_to_c("fn main() {
 mut b int
 println(1)
}", std)
    assert(d3.len() >= 1)

    // a signature with no `(`
    ro (d4, _) = compile_to_c("fn main {
 println(1)
}", std)
    assert(d4.len() >= 1)

    // The SECOND shape of the same class is NOT asserted here, and the reason
    // is a measurement rather than an omission. An import path is read by a
    // loop, and a loop with no minimum accepts nothing at all; the fix makes
    // an empty path plant a gap. But in THIS harness the same source is
    // refused for an unrelated reason, so an assertion on it would be green
    // with the fix removed -- the reverse proof showed exactly that, failing
    // nothing when the loop minimum was taken out.
    //
    // What holds that shape instead is the hunt probe, measured through the
    // CLI: `import` with no path used to exit 0 with not one diagnostic, and
    // now refuses, taking the parse x K2 battery from thirteen divergences to
    // zero across sixteen probes.

    // The other direction of the lid: every form above, written whole, is
    // clean. Without this the rule could be wider than the grammar and no
    // test would notice.
    ro (d6, _) = compile_to_c("type Pt { n int }
fn main() {
 mut b = 1
 println(b)
}", std)
    assert(d6.len() == 0)
}

test "an application in TYPE position resolves -- Vec[int], and []T is its D239 sugar" {
    // Step B2's acceptance, pinned at the level it changes: the SIGNATURE. Both
    // spellings are one term (D239: `[]T` IS `Vec[T]`), read by one door at
    // collection -- so a file whose parameters and return carry them checks
    // CLEAN, where before the wave the form rule refused the shape wholesale
    // (159 such refusals across novac's own files; 16 after).
    ro handed = "module std.v
export type Vec[T] { n int }"
    ro (d1, _) = compile_to_c("module m.a
fn take(xs Vec[int]) -> int => 1
fn f(xs []int) -> []int => xs
fn main() { println(1) }",
                              []str.of(handed))
    assert(d1.len() == 0)
    // The rotten pair, both directions of the lid: a WRONG-ARITY application is
    // not a type (the head refusal names what to write), and the forms B2 did
    // NOT take -- a fn type here -- stay refused by name.
    ro (d2, _) = compile_to_c("module m.b
fn t(xs Vec[int, str]) -> int => 1
fn main() { println(1) }",
                              []str.of(handed))
    assert(d2.len() == 1)
    assert(d2[0].message.contains("write its type arguments"))
    ro (d3, _) = compile_to_c("module m.c
fn t(f fn(int) -> int) -> int => 1
fn main() { println(1) }",
                              []str.of(handed))
    assert(d3.len() == 1)
    assert(d3[0].message.contains("type form"))
}

test "an array literal is built from the SHELL's instance set, and refused by name outside it" {
    // Sub-plan L, wave L1. The real surface is read from the embedded shell (the
    // wrappers hand `interop_surface()`), so this test is against what the shell
    // actually carries: an instance for `int`, none for a record of this file.
    // Both spellings are one form -- the typed `[]int.of(7, 8)` used to fall
    // apart into two diagnostics for one literal (the cascade class).
    // The hand-written std of these tests declares no `Vec`; the literal needs
    // the HEAD to exist (the slice sugar resolves to `Vec[elem]`), so a generic
    // record head is handed beside it -- the same shape `harvest_types` builds
    // from the real std.
    mut std = std_decls()
    std.push("module std.v
export type Vec[T] { n int }")
    ro (d1, _) = compile_to_c("fn take(xs []int) -> int => 1\nfn main() {\n ro v = [7, 8]\n ro w = []int.of(4)\n println(take(v))\n println(take(w))\n}", std)
    assert(d1.len() == 0)
    // The element type the shell has no instance for: refused naming the SHELL
    // and the type -- the fix is in the probe program, not in this file.
    ro (d2, _) = compile_to_c("type P { n int }\nfn main() {\n ro a = P { n: 1 }\n ro v = [a, a]\n println(1)\n}", std)
    assert(d2.len() == 1)
    assert(d2[0].message.contains("carries no"))
    // Mixed elements: named by position and by both types.
    ro (d3, _) = compile_to_c("fn main() {\n ro v = [1, \"s\"]\n println(1)\n}", std)
    assert(d3.len() == 1)
    assert(d3[0].message.contains("element 2 is str"))
    // Empty: the oracle compiles it and panics at run time; novac refuses
    // rather than diverge in behaviour.
    ro (d4, _) = compile_to_c("fn main() {\n ro v = []int.of()\n println(1)\n}", std)
    assert(d4.len() == 1)
    assert(d4[0].message.contains("empty array literal"))
    // Argument position is LEGAL since wave B8 -- the literal itself passes,
    // and the one diagnostic left is about the PRINTER: println covers the
    // four primitives, and a vector is not one of them. The wave moved the
    // refusal from the literal's position to the argument's type, which is
    // the honest place for it.
    ro (d5, _) = compile_to_c("fn main() {\n println([7, 8])\n}", std)
    assert(d5.len() == 1)
    assert(d5[0].message.contains("println covers"))
}

test "an instance method of the shell: deduced on the receiver, named by the shell, refused where the shell has none" {
    mut std = std_decls()
    std.push("module std.v
export type Vec[T] { n int }
export fn Vec[T] @len() -> int => @n
export fn Vec[T] mut @push(v T) -> @ => @
export type Opt[T] enum Got(T) | Nil
export fn Vec[T] @get(i int) -> Opt[T] => Nil
export fn Vec[T] @nope() -> int => 0")
    ro (d1, c1) = compile_to_c("fn main() {\n ro v = [7, 8]\n println(v.len())\n}", std)
    assert(d1.len() == 0)
    assert(c1.contains("Vec____nova_int_method_len"))
    // The literal's capacity is exact: `[7, 8]` constructs with 2, not 0.
    assert(c1.contains("_static_new(2)"))
    // `push` returns Self: the substituted return is the receiver's own term.
    ro (d2, c2) = compile_to_c("fn main() {\n mut v = [7]\n v.push(9)\n println(v.len())\n}", std)
    assert(d2.len() == 0)
    assert(c2.contains("Vec____nova_int_method_push"))
    assert(c2.contains("_static_new(1)"))
    // No such method at all: the refusal of the wave before, unchanged.
    ro (d3, _) = compile_to_c("fn main() {\n ro v = [7]\n println(v.zzz())\n}", std)
    assert(d3.len() == 1)
    assert(d3[0].message.contains("no such method"))
    // Declared, generic, and absent from the shell: refused naming the probe.
    ro (d4, _) = compile_to_c("fn main() {\n ro v = [7]\n println(v.nope())\n}", std)
    assert(d4.len() >= 1)
    assert(d4[0].message.contains("shell_probe.nv"))
    // A return that is an instance of a sum: the family spelling is not taken.
    // `get` and not a made-up name: the shell IS asked first, and a method the
    // shell lacks is refused for that reason before its return is judged.
    ro (d5, _) = compile_to_c("fn main() {\n ro v = [7]\n ro f = v.get(0)\n println(1)\n}", std)
    assert(d5.len() >= 1)
    assert(d5[0].message.contains("Opt[int]"))
    assert(d5[0].message.contains("instance of a sum"))
}
