// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc `check_expr_try` -- the operand's container and the enclosing
// fn's return are judged together; NOT taken: `From` on the error (D85).
// Role: acceptance tests of `x?` (D85) and `X ?? return R` (D86 amended
// 2026-09-01): `?` returns the `None` / `Err(e)` of the BODY's instance; the
// cross pairs carry the oracle's codes, a mismatched error D85's (task #15).
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file; fixtures try_option/ and
// coalesce_return/ through check-novac-no-cascade and the differential.
// novac/src/pipeline/try_test.nv -- the early-return value forms.

module novac.pipeline

test "`x?` on an Option returns the None of the body's own instance; the other pairs carry D85's codes" {
    mut std = std_decls()
    std.push("module std.o\nexport type Option[T] enum Some(T) | None\nexport type Result[T, E] enum Ok(T) | Err(E)\n")
    // The operand is an `Option[str]`, the body returns an `Option[int]`: the
    // early return is the BODY's None, not the operand's.
    ro (d0, c0) = compile_to_c("fn name(f bool) -> Option[str] => if f { Some(\"ab\") } else { None }\nfn size(f bool) -> Option[int] {\n ro s = name(f)?\n Some(s.byte_len())\n}\nfn main() {\n println(size(true) ?? -1)\n}", std)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains("return ((NovaOpt_nova_int){.tag = NOVA_TAG_Option_None});"), c0)
    // An Option in a Result body, a Result in an Option body: the oracle's codes.
    ro (d1, _) = compile_to_c("fn f(o Option[int]) -> Result[int, str] {\n ro v = o?\n return Ok(v)\n}\nfn main() {\n println(1)\n}", std)
    assert(messages(d1).contains("E_TRY_OPTION_IN_RESULT_FN"), messages(d1))
    ro (d2, _) = compile_to_c("fn g(r Result[int, str]) -> Option[int] {\n ro v = r?\n Some(v)\n}\nfn main() {\n println(1)\n}", std)
    assert(messages(d2).contains("E_TRY_RESULT_IN_OPTION_FN"), messages(d2))
    // A Result in a Result body of the same error is the language's, compiled (task #15):
    // its Err branch builds the BODY's own `Err` through the shell's maker.
    ro (d3, c3) = compile_to_c("fn h(r Result[int, int]) -> Result[int, int] {\n ro v = r?\n println(v)\n h(r)\n}\nfn main() {\n println(1)\n}", std)
    assert(d3.len() == 0, messages(d3))
    assert(c3.contains("nova_make_NovaRes_nova_int_nova_int_Err("), c3)
    // A body instance the shell does not carry is the refusal a written `Err(..)` of it
    // meets. (Another error type -- D85's compile error -- is pinned with the real std by
    // fixtures/try_result/neg_1.nv.)
    ro (d7, _) = compile_to_c("fn n(r Result[int, int]) -> Result[int, any] {\n ro v = r?\n println(v)\n n(r)\n}\nfn main() {\n println(1)\n}", std)
    assert(messages(d7).contains("carries no `Result` instance"), messages(d7))
    // CONTROL: `?? return R` in a `-> bool` body compiles; in an Option body it is
    // the oracle's E_COALESCE_RETURN_FALLBACK.
    ro (d4, _) = compile_to_c("fn pos(o Option[int]) -> bool {\n ro v = o ?? return false\n v > 0\n}\nfn main() {\n println(1)\n}", std)
    assert(d4.len() == 0, messages(d4))
    ro (d5, _) = compile_to_c("fn back(o Option[int]) -> Option[int] {\n ro v = o ?? return None\n Some(v)\n}\nfn main() {\n println(1)\n}", std)
    assert(messages(d5).contains("E_COALESCE_RETURN_FALLBACK"), messages(d5))
}

test "a `??` or `?` nested in an expression is laid down before it (registry 1619); a short circuit keeps its right side conditional" {
    mut std = std_decls()
    std.push("module std.o\nexport type Option[T] enum Some(T) | None\n")
    // Inside an operator, on the right of `=`, in a condition, and on the right of
    // `&&`: before the wave each was the ICE "a block sealed twice".
    ro (d0, c0) = compile_to_c("fn t(a bool, o Option[int]) -> bool => a && (o ?? 0) > 3\nfn u(o Option[int]) -> Option[int] {\n mut y = 0\n y = (o ?? 1) + o?\n if (o ?? 0) > y {\n  return Some(y)\n }\n Some(-y)\n}\nfn main() {\n println(1)\n}", std)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains(".tag == NOVA_TAG_Option_Some"), c0)
    // The right side of `&&` is lowered as a BRANCH: the C keeps no `&&` around a
    // laid-down `??` (CONTROL: a plain `&&` with no block form stays C's own).
    ro (d1, c1) = compile_to_c("fn v(a bool, b bool) -> bool => a && b\nfn main() {\n println(1)\n}", std)
    assert(d1.len() == 0, messages(d1))
    assert(c1.contains("&&"), c1)
}

test "`??` over a `Result` reads the `Ok` payload and runs the fallback on `Err` (D86, sweep 11)" {
    mut std = std_decls()
    std.push("module std.o\nexport type Option[T] enum Some(T) | None\nexport type Result[T, E] enum Ok(T) | Err(E)\n")
    // The end-to-end proof is novac/fixtures/coalesce_result/pos_1 (byte for byte with
    // the oracle); here the form is judged.
    ro (d, _) = compile_to_c("fn get(r Result[int, str]) -> int => r ?? -1\nfn main() {\n println(1)\n}", std)
    assert(d.len() == 0, messages(d))
    // CONTROL: `?` reads the same operand and compiles too since task #15.
    ro (d1, _) = compile_to_c("fn get(r Result[int, str]) -> Result[int, str] {\n ro v = r?\n println(v)\n get(r)\n}\nfn main() {\n println(1)\n}", std)
    assert(!messages(d1).contains("`?`"), messages(d1))
}
