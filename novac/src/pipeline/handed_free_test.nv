// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc's `extern crate` items -- a function declared elsewhere is
// resolved and type-checked like a local one and linked by its mangled symbol;
// NOT taken: cross-crate monomorphisation (a generic handed function is refused
// here until the multi-file unit arrives).
// Role: acceptance tests of wave W6 (274.7, tier 0): a FREE function of a
// handed std module is harvested into the callable table, a call to it is
// typed like any free call, the emitter spells the SHELL's symbol (the oracle's
// length-prefixed name), the checker asks the lifted surface for it, and the
// refusal names the true reason when the shell has no such symbol. Before W6:
// "this name is not a callable novac knows" (#925).
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file; fixtures handed_free_fn/
// through check-novac-no-cascade and the differential.
// novac/src/pipeline/handed_free_test.nv -- free functions of handed modules.

module novac.pipeline
import ../sem.{InteropTable, representation_of, FnRow, CheckOut, branch_children}
import ../tree.{Node, raw_node}
import ../source.{SourceText}
import ../check.{check_instance}
import ../types.{TyId, no_ty, is_ty}
import ../diag.{ice_at}
import ../parse.{parse}

test "a handed free function: resolved, judged like the file's own, spelled as the shell's symbol (W6)" {
    mut std = std_decls()
    std.push("module encoding.utf16\nexport fn is_high_surrogate(u int) -> bool => u >= 0xD800 && u <= 0xDBFF\n")
    ro decls = parse_decls(std)
    ro sym = "nova_fn_8encoding5utf1617is_high_surrogate"
    mut shell = InteropTable.new()
    shell.add(sym)
    ro prog = "import std.encoding.utf16.{is_high_surrogate}\nfn main() {\n println(is_high_surrogate(0xD800))\n}"
    // POSITIVE: the shell carries the symbol -- the call is emitted under it.
    ro (d0, c0) = compile_to_c_with(prog, decls, shell)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains("${sym}("), c0)
    // The shell WITHOUT the symbol: the unit makes the function from its handed
    // body (task 4) and calls it under ITS OWN name -- a call under the shell's
    // would not link (the defect: `nova_fn_11is_ascii_ws` undefined).
    ro (d1, c1) = compile_to_c_with(prog, decls, described_bare(std))
    assert(d1.len() == 0, messages(d1))
    assert(c1.contains("nova_print_bool(novac_fn_encoding_utf16_is_high_surrogate__"), c1)
    assert(c0.contains("nova_print_bool(${sym}("), c0)
    // ARITY against the harvested signature: judged like the file's own function
    // -- the binding refusal names the parameter left without a value (wave 4:
    // binding before arity), exactly as it would for a function of this file.
    ro (d2, _) = compile_to_c_with("import std.encoding.utf16.{is_high_surrogate}\nfn main() {\n println(is_high_surrogate())\n}", decls, shell)
    assert(d2.len() == 1, messages(d2))
    assert(messages(d2).contains("omits `u`"), messages(d2))
    // The file's OWN function of the same name shadows the handed one (D125):
    // compiled here, spelled by our own mangle, the shell never asked.
    // (The shell TEMPLATE inside the C carries std's symbol regardless, so the
    // pin is the call site: OUR mangled name is what the body calls.)
    ro (d3, c3) = compile_to_c_with("fn is_high_surrogate(u int) -> bool => u > 0\nfn main() {\n println(is_high_surrogate(1))\n}", decls, InteropTable.new())
    assert(d3.len() == 0, messages(d3))
    assert(c3.contains("novac_fn_is_high_surrogate__"), c3)
}

test "a function of ANOTHER MODULE OF THE PROGRAM: judged by its signature, named by its owner (274.11 E.10 step 2a)" {
    // The module is handed like std's -- a signature without a body -- but it is
    // marked as the PROGRAM's on the link surface: its body is compiled into the
    // same program, so the call is not refused for want of a shell symbol and
    // prints the owner's name.
    ro helpers = "module novac.helpers\nexport fn twice(n int) -> int => n + n\n"
    mut texts = std_decls()
    texts.push(helpers)
    ro decls = parse_decls(texts)
    mut link = InteropTable.new()
    mark_program(link, parse_decls([]str.of(helpers)))
    ro prog = "module novac.user\nimport ../helpers.{twice}\nfn main() {\n println(twice(3))\n}"
    ro (d0, c0) = compile_to_c_with(prog, decls, link)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains("novac_fn_novac_helpers_twice__"), c0)
    // The owner unit compiles the body: this one only CALLS it.
    assert(!c0.contains("novac_fn_novac_helpers_twice__nova_int__to_nova_int(nova_int n) {"), c0)
    // CONTROL: the same module NOT marked as the program's -- not compiled
    // anywhere else, so this unit makes it from the handed body (task 4).
    ro (d1, c1) = compile_to_c_with(prog, decls, described_bare(texts))
    assert(d1.len() == 0, messages(d1))
    assert(c1.contains("novac_fn_novac_helpers_twice__nova_int__to_nova_int(nova_int n) {"), c1)
}

test "a POINTER in a handed declaration is read: a std record with a `*mut` field is whole (274.11 E.10 step 3b)" {
    // std's `Vec[T]` keeps `mut data *mut T`; until step 3b the reference door
    // answered no type for `*`, and a record whose field it could not read was
    // a record with a hole. The PLAIN field beside it must read as before, and
    // the program that touches only it must compile.
    mut texts = std_decls()
    texts.push("module std.cellm\nexport type Cell { n int, data *mut int }\nexport fn cell_n(c Cell) -> int => c.n\n")
    ro decls = parse_decls(texts)
    ro prog = "import std.cellm.{Cell, cell_n}\nfn f(c Cell) -> int => c.n\nfn main() {\n println(1)\n}"
    ro (d0, _) = compile_to_c_with(prog, decls, InteropTable.new())
    assert(d0.len() == 0, messages(d0))
    // The POINTER field has a TYPE now, and the type is the pointer: returned
    // as an `int`, the mismatch names `*mut int` -- with no type there the
    // door had nothing to name (the hole read as silence).
    ro (d1, _) = compile_to_c_with("import std.cellm.{Cell}\nfn g(c Cell) -> int => c.data\nfn main() {\n println(1)\n}", decls, InteropTable.new())
    assert(messages(d1).contains("*mut int"), messages(d1))
}

test "a NEWTYPE of a handed module is a newtype here: laid out as its representation, not as a record pointer (2026-10-01)" {
    // `type Row int` in another module used to register as a RECORD with no
    // fields: `Row` was laid out as a pointer `Nova_Row*` -- a C signature that
    // disagrees with the owner's `nova_int` -- and `[]Row` asked the shell for a
    // `Vec____Nova_Row_p` that cannot exist (10 refusals of the 0.2 measure:
    // `Vec[FnRow]`, `Vec[TyId]`, `Vec[FieldRow]`). A newtype is laid out as its
    // representation, so a parameter of type `Row` is a `nova_int` in C.
    mut texts = std_decls()
    texts.push("module std.rowm\nexport type Row int\n")
    ro decls = parse_decls(texts)
    // The REGISTRY is asked, not the C text (P24): `Row` is a newtype whose
    // representation is `int` -- the layout and the instance spelling follow.
    ro prog = "import std.rowm.{Row}\nfn same(r Row) -> Row => r\nfn main() {\n ro r = same(Row(3))\n println(1)\n}"
    ro (d0, _) = compile_to_c_with(prog, decls, InteropTable.new())
    assert(d0.len() == 0, messages(d0))
    ro ctx = context(parse(tokens_of(prog)), decls, InteropTable.new())
    ro row = ctx.ty_of_name("Row") ?? ice_at(
        "novac/src/pipeline/handed_free_test.nv:118",
        "test: the handed `Row` is not in the registry")
    // A newtype term carries its representation as its one argument; the record
    // it used to be registered as carried none (asked without importing the
    // kind sum: `pipeline` has no edge to `builtins`, architecture s3).
    assert(ctx.tys.arg_count(row) == 1, "a handed newtype registered as another kind")
    assert(representation_of(ctx, row) == ctx.prims.int_id, "the handed newtype's representation is not `int`")
}

test "a HANDED callable knows where its body lives: the declaration tree and its FnDecl (274.11 E.10 step 4a)" {
    // A generic of std over a type of novac's own is instantiated by the
    // CONSUMER from the body it was handed -- the shell cannot know novac's
    // types. The registry keeps, per handed row, the tree it was read from and
    // its declaration node; the file's own rows have none.
    mut texts = std_decls()
    texts.push("module std.boxm\nexport type Box[T] { v T }\nexport fn Box[T] @get() -> T => @v\n")
    ro decls = parse_decls(texts)
    ro prog = "fn own() -> int => 1\nfn main() {\n println(own())\n}"
    ro ctx = context(parse(tokens_of(prog)), decls, InteropTable.new())
    mut handed_get = 0
    mut own_seen = 0
    for i in 0..ctx.fns.rows.len() {
        ro row = FnRow(i)
        if ctx.fns.rows[i].name == "get" && ctx.fns.rows[i].handed_from == "std.boxm" {
            handed_get += 1
            ro body = ctx.handed.decl_of(row) ?? ice_at(
                "novac/src/pipeline/handed_free_test.nv:144",
                "test: the handed `get` has no body noted")
            assert(body.kind_of() == NodeKind.FnDecl, "the noted node is not a declaration")
            assert(ctx.handed.tree_of(row) == texts.len() - 1, "the noted tree is not the file it came from")
        } else if ctx.fns.rows[i].name == "own" {
            own_seen += 1
            assert(ctx.handed.decl_of(row).is_none(), "the file's own row has a handed body")
        } else {
            // Another row: not this test's subject.
        }
    }
    assert(handed_get == 1, "the handed `get` was not registered once")
    assert(own_seen == 1, "the file's own `own` was not registered once")
}

test "`==` on a payload-free sum compares tags wherever A4 places it -- a fenced enum too (2026-10-01)" {
    // A sum that stands as an ARGUMENT of an application (`[]K`) is fenced to
    // the heap by A4, and `is_value_sum` answers no -- which refused every `==`
    // on it as protocol dispatch: 279 of novac's own, `@peek() == TokenKind.X`
    // in parse/ beside a `[]TokenKind`. Its value is still its tag; the fence
    // only decides `.` or `->`.
    mut texts = std_decls()
    texts.push("module std.v\nexport type Vec[T] { n int }\n")
    ro decls = parse_decls(texts)
    ro src = "#impl(Equal)\ntype Kt enum\n    | A\n    | B\n\nfn f(xs []Kt, k Kt) -> bool => k == Kt.A\n\nfn main() {\n    println(1)\n}"
    ro d = compile_with(src, decls, InteropTable.new())
    assert(d.len() == 0, messages(d))
}

/// The recorded type of the first `@field` read under `n`, or `no_ty()` when
/// none is recorded -- what the instance test below asks of the channel.
fn first_field_read_type(n Node, chan CheckOut) -> TyId {
    if n.kind_of() == NodeKind.SelfField {
        return chan.type_if_known(n.id_of())
    } else {
        // Not a field read: its children are searched.
    }
    if n.kind_of() == NodeKind.LeafNode { return no_ty() }
    for c in branch_children(n) {
        ro r = first_field_read_type(c, chan)
        if is_ty(r) { return r }
    }
    no_ty()
}

test "a HANDED generic method is typed as an instance over a type of the file (274.11 E.10 step 4c)" {
    // std's `Box[T] @get` under `T := Pt`, a type the shell cannot know: the
    // unit makes the instance from the body it was handed. Two things had to
    // hold, and each one alone fails this test: the instance's ROW is handed to
    // the checker (the body's node ids are the std tree's, and the file's
    // node->row table answers None for them -- the body went untyped), and the
    // receiver `Box[T]` is SUBSTITUTED through the application (`subst_type`
    // returned an application unchanged until this day, and the field read
    // came out `T`).
    mut texts = std_decls()
    texts.push("module std.boxm\nexport type Box[T] { v T }\nexport fn Box[T] @get() -> T => @v\n")
    ro decls = parse_decls(texts)
    // `Box[Pt]` is named in a signature, so the registry holds the term -- as
    // it does at every real call site, where it is the receiver's type.
    ro prog = "import std.boxm.{Box}\n\ntype Pt {\n    x int\n}\n\nfn hold(b Box[Pt]) -> int => 1\n\nfn main() {\n    println(1)\n}"
    ro ctx = context(parse(tokens_of(prog)), decls, InteropTable.new())
    mut row = FnRow(-1)
    for i in 0..ctx.fns.rows.len() {
        if ctx.fns.rows[i].name == "get" && ctx.fns.rows[i].handed_from == "std.boxm" {
            row = FnRow(i)
        } else {
            // Another row: not this test's subject.
        }
    }
    ro decl = ctx.handed.decl_of(row) ?? ice_at(
        "novac/src/pipeline/handed_free_test.nv:214",
        "test: the handed `get` has no body noted")
    ro tree = decls[ctx.handed.tree_of(row)]
    ro pt = ctx.ty_of_name("Pt") ?? ice_at(
        "novac/src/pipeline/handed_free_test.nv:218",
        "test: the file's `Pt` is not in the registry")
    assert(ctx.instantiates(row, []TyId.of(pt)), "an instance the shell does not carry is not made by the unit")
    // The ORIGINAL text: a position is a slice's distance from its buffer.
    ro (d, chan) = check_instance(decl, SourceText { text: texts[ctx.handed.tree_of(row)] }, ctx, row,
                                  []TyId.of(pt), raw_node(tree.id_of()) + 1, tree, "")
    assert(d.len() == 0, messages(d))
    assert(first_field_read_type(decl, chan) == pt, "the body's `@v` is not typed `Pt` under the substitution")
}


test "a HANDED function's literal default is emitted without the handed tree's identity (registry 1576, class 1563)" {
    // The omitted slot is printed AT THE CALL SITE (D102) -- in THIS file -- and
    // every reader of a literal asks the channel by the node's id. The handed
    // file is larger than the program, so its default's id points past every
    // table of the compiled file: "array: index 421 out of bounds for length 6"
    // before the fix. A string, a negative number and `false` are rebuilt
    // without an identity (sem/harvest.nv `handed_default`).
    mut helpers = "module novac.helpers\n"
    for i in 0..60 {
        helpers = "${helpers}fn filler${i}(n int) -> int => n + ${i}\n"
    }
    helpers = "${helpers}export fn greet(s str = \"dflt\") -> str => s\n\
export fn flag(v bool = false, k int = -3) -> int => if v { 1 } else { k }\n"
    mut texts = std_decls()
    texts.push(helpers)
    ro decls = parse_decls(texts)
    mut link = InteropTable.new()
    mark_program(link, parse_decls([]str.of(helpers)))
    ro prog = "module novac.user\nimport ../helpers.{greet, flag}\nfn main() {\n println(greet())\n println(flag())\n}"
    ro (d0, c0) = compile_to_c_with(prog, decls, link)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains("(false, ((nova_int)-3LL))"), "the bool and the negative default print as literals")
    assert(c0.contains("\"dflt\""), "the string default is the pool's literal")
    // CONTROL: the slots WRITTEN at the call print what the call wrote.
    ro (d1, c1) = compile_to_c_with("module novac.user\nimport ../helpers.{flag}\nfn main() {\n println(flag(v: true, k: 7))\n}", decls, link)
    assert(d1.len() == 0, messages(d1))
    assert(c1.contains("(true, ((nova_int)7LL))"), "CONTROL: written slots print as written")
}

test "a handed function's LITERAL default reaches the call as a literal of no tree (registry 1576)" {
    // The default `by int = 3` is a node of the HANDED tree, and its id belongs
    // to that tree's space: printed as-is it was read in the compiled file's
    // channel by that id -- another node's type, or past the end of the table
    // (the constant-default case iced "array: index 32 out of bounds", #1563).
    // The harvest rebuilds it without an identity, as for a constant default.
    mut std = std_decls()
    std.push("module encoding.utf16\nexport fn bump(n int, by int = 3) -> int => n + by\n")
    ro decls = parse_decls(std)
    mut shell = InteropTable.new()
    shell.add("nova_fn_8encoding5utf164bump")
    ro (d, c) = compile_to_c_with("import std.encoding.utf16.{bump}\nfn main() {\n println(bump(1))\n}", decls, shell)
    assert(d.len() == 0, messages(d))
    assert(c.contains("nova_fn_8encoding5utf164bump(((nova_int)1LL), ((nova_int)3LL))"), c)
    // THE ID CLASH, made to happen: the compiled file opens with `u8`-typed
    // literals, shifted one declaration at a time, so the handed default's id
    // lands on a typed node of THIS file in one of the shapes.
    mut pre = ""
    for k in 0..16 {
        pre = "${pre}fn k${k}() -> u8 => 7\n"
        ro prog = "import std.encoding.utf16.{bump}\n${pre}fn main() {\n println(bump(1))\n}"
        ro (d2, c2) = compile_to_c_with(prog, decls, shell)
        assert(d2.len() == 0, messages(d2))
        assert(c2.contains("nova_fn_8encoding5utf164bump(((nova_int)1LL), ((nova_int)3LL))"), "k=${k}")
    }
    // A STRING default: the literal pool keys a string by its node, so a node
    // of another tree is looked up in THIS file's pool.
    mut std3 = std_decls()
    std3.push("module encoding.utf16\nexport fn label(n int, tag str = \"zz\") -> int => n\n")
    mut shell3 = InteropTable.new()
    shell3.add("nova_fn_8encoding5utf165label")
    ro (d3, c3) = compile_to_c_with("import std.encoding.utf16.{label}\nfn main() {\n println(label(1))\n}", parse_decls(std3), shell3)
    assert(d3.len() == 0, messages(d3))
    assert(c3.contains("nova_fn_8encoding5utf165label(((nova_int)1LL), "), c3)
}

test "a HANDED body with a parse gap is refused by name in its instance, never iced (task #14)" {
    // novac never compiles std's files as files of their own, so a hole in a
    // handed body was told nowhere: the instance went straight to typing and the lattice iced
    // ("expression kind without a type rule") on `()`, the unit value novac
    // does not parse -- the carrier was `Ok(())` in std's `JsonSerializer
    // @begin_struct`. The instance pass now tells the gap, in the body's file.
    mut std = std_decls()
    std.push("module encoding.utf16\nexport fn one() -> int {\n    ro u = ()\n    1\n}\n")
    ro (d, _) = compile_to_c_with("import std.encoding.utf16.{one}\nfn main() {\n println(one())\n}",
                                  parse_decls(std), described_bare(std))
    assert(d.len() == 1, messages(d))
    assert(messages(d).contains("did not parse"), messages(d))
    assert(d[0].file != "", messages(d))
}
