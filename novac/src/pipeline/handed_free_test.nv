// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc's `extern crate` items -- a function declared elsewhere is
// resolved and type-checked like a local one and linked by its mangled symbol;
// NOT taken: cross-crate monomorphisation (a generic handed function is refused
// here until the multi-file unit arrives).
// Role: acceptance tests of wave W6 (274.7, tier 0): a FREE function of a
// handed std module is harvested into the callable table, a call to it is
// typed like any free call, the emitter spells the SHELL's symbol (the oracle's
// length-prefixed name), the checker asks the lifted surface for it, and the
// refusal names the true reason when the shell has no such symbol. Before W6:
// "this name is not a callable novac knows" (#925).
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file; fixtures handed_free_fn/
// through check-novac-no-cascade and the differential.
// novac/src/pipeline/handed_free_test.nv -- free functions of handed modules.

module novac.pipeline
import ../sem.{InteropTable, representation_of}
import ../builtins.{TypeKind}
import ../diag.{ice}
import ../parse.{parse}

test "a handed free function: resolved, judged like the file's own, spelled as the shell's symbol (W6)" {
    mut std = std_decls()
    std.push("module encoding.utf16\nexport fn is_high_surrogate(u int) -> bool => u >= 0xD800 && u <= 0xDBFF\n")
    ro decls = parse_decls(std)
    ro sym = "nova_fn_8encoding5utf1617is_high_surrogate"
    mut shell = InteropTable.new()
    shell.add(sym)
    ro prog = "import std.encoding.utf16.{is_high_surrogate}\nfn main() {\n println(is_high_surrogate(0xD800))\n}"
    // POSITIVE: the shell carries the symbol -- the call is emitted under it.
    ro (d0, c0) = compile_to_c_with(prog, decls, shell)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains("${sym}("), c0)
    // The shell WITHOUT the symbol: refused by the true reason, naming the module and the symbol.
    ro (d1, _) = compile_to_c_with(prog, decls, InteropTable.new())
    assert(d1.len() == 1, messages(d1))
    assert(messages(d1).contains("declared in module `encoding.utf16`"), messages(d1))
    assert(messages(d1).contains("carries no `${sym}`"), messages(d1))
    // ARITY against the harvested signature: judged like the file's own function
    // -- the binding refusal names the parameter left without a value (wave 4:
    // binding before arity), exactly as it would for a function of this file.
    ro (d2, _) = compile_to_c_with("import std.encoding.utf16.{is_high_surrogate}\nfn main() {\n println(is_high_surrogate())\n}", decls, shell)
    assert(d2.len() == 1, messages(d2))
    assert(messages(d2).contains("omits `u`"), messages(d2))
    // The file's OWN function of the same name shadows the handed one (D125):
    // compiled here, spelled by our own mangle, the shell never asked.
    // (The shell TEMPLATE inside the C carries std's symbol regardless, so the
    // pin is the call site: OUR mangled name is what the body calls.)
    ro (d3, c3) = compile_to_c_with("fn is_high_surrogate(u int) -> bool => u > 0\nfn main() {\n println(is_high_surrogate(1))\n}", decls, InteropTable.new())
    assert(d3.len() == 0, messages(d3))
    assert(c3.contains("novac_fn_is_high_surrogate__"), c3)
}

test "a function of ANOTHER MODULE OF THE PROGRAM: judged by its signature, named by its owner (274.11 E.10 step 2a)" {
    // The module is handed like std's -- a signature without a body -- but it is
    // marked as the PROGRAM's on the link surface: its body is compiled into the
    // same program, so the call is not refused for want of a shell symbol and
    // prints the owner's name.
    ro helpers = "module novac.helpers\nexport fn twice(n int) -> int => n + n\n"
    mut texts = std_decls()
    texts.push(helpers)
    ro decls = parse_decls(texts)
    mut link = InteropTable.new()
    mark_program(link, parse_decls([]str.of(helpers)))
    ro prog = "module novac.user\nimport ../helpers.{twice}\nfn main() {\n println(twice(3))\n}"
    ro (d0, c0) = compile_to_c_with(prog, decls, link)
    assert(d0.len() == 0, messages(d0))
    assert(c0.contains("novac_fn_novac_helpers_twice__"), c0)
    // CONTROL: the same module NOT marked as the program's -- the old refusal
    // by name, the module and the missing symbol.
    ro (d1, _) = compile_to_c_with(prog, decls, InteropTable.new())
    assert(messages(d1).contains("declared in module `novac.helpers`"), messages(d1))
}

test "a POINTER in a handed declaration is read: a std record with a `*mut` field is whole (274.11 E.10 step 3b)" {
    // std's `Vec[T]` keeps `mut data *mut T`; until step 3b the reference door
    // answered no type for `*`, and a record whose field it could not read was
    // a record with a hole. The PLAIN field beside it must read as before, and
    // the program that touches only it must compile.
    mut texts = std_decls()
    texts.push("module std.cellm\nexport type Cell { n int, data *mut int }\nexport fn cell_n(c Cell) -> int => c.n\n")
    ro decls = parse_decls(texts)
    ro prog = "import std.cellm.{Cell, cell_n}\nfn f(c Cell) -> int => c.n\nfn main() {\n println(1)\n}"
    ro (d0, _) = compile_to_c_with(prog, decls, InteropTable.new())
    assert(d0.len() == 0, messages(d0))
    // The POINTER field has a TYPE now, and the type is the pointer: returned
    // as an `int`, the mismatch names `*mut int` -- with no type there the
    // door had nothing to name (the hole read as silence).
    ro (d1, _) = compile_to_c_with("import std.cellm.{Cell}\nfn g(c Cell) -> int => c.data\nfn main() {\n println(1)\n}", decls, InteropTable.new())
    assert(messages(d1).contains("*mut int"), messages(d1))
}

test "a NEWTYPE of a handed module is a newtype here: laid out as its representation, not as a record pointer (2026-10-01)" {
    // `type Row int` in another module used to register as a RECORD with no
    // fields: `Row` was laid out as a pointer `Nova_Row*` -- a C signature that
    // disagrees with the owner's `nova_int` -- and `[]Row` asked the shell for a
    // `Vec____Nova_Row_p` that cannot exist (10 refusals of the 0.2 measure:
    // `Vec[FnRow]`, `Vec[TyId]`, `Vec[FieldRow]`). A newtype is laid out as its
    // representation, so a parameter of type `Row` is a `nova_int` in C.
    mut texts = std_decls()
    texts.push("module std.rowm\nexport type Row int\n")
    ro decls = parse_decls(texts)
    // The REGISTRY is asked, not the C text (P24): `Row` is a newtype whose
    // representation is `int` -- the layout and the instance spelling follow.
    ro prog = "import std.rowm.{Row}\nfn same(r Row) -> Row => r\nfn main() {\n ro r = same(Row(3))\n println(1)\n}"
    ro (d0, _) = compile_to_c_with(prog, decls, InteropTable.new())
    assert(d0.len() == 0, messages(d0))
    ro ctx = context(parse(tokens_of(prog)), decls, InteropTable.new())
    ro row = ctx.ty_of_name("Row") ?? ice("test: the handed `Row` is not in the registry")
    assert(ctx.tys.kind_of(row) == TypeKind.TkNewtype, "a handed newtype registered as another kind")
    assert(representation_of(ctx, row) == ctx.prims.int_id, "the handed newtype's representation is not `int`")
}

