// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: none -- the `with` statement is the language's own form (D61);
// the binding-resolution and handler-value doors are novac's own design,
// measured against the oracle's refusals. NOT taken: the `Effect[E, IRT]`
// two-argument form (D87/D88) and lowering a with statement at all -- the
// VALUE form of `with` is lowered since E.9 step 2 (its C is pinned by the
// op-call-and-with test below); a handler LITERAL is lowered in step 3, so
// the literal's tests still judge the CHECK path (`compile_with`).
// Role: acceptance tests of the E4 wave (274.11): `with X = h { body }`
// reads, resolves the binding to an effect declaration, types the handler
// value and the body, and refuses a KNOWN value type as the handler.
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file; the differential fixtures
// pos_* and divergences.allow.
// novac/src/pipeline/with_test.nv -- the with statement, as novac writes it.

module novac.pipeline
import ../sem.{InteropTable}
import ../sem.{effect_op_dispatcher_c, effect_vtable_c, effect_slot_c}

test "with: a handler value of type Effect[Fs], body typed -- accepted (E4)" {
    // POSITIVE: the self-build carrier's shape. `make()` hands a value whose
    // type is the builtin `Effect[Fs]` -- RESOLVED since the Effect seed
    // (a generic constructor row, arity 1, applied through the ordinary
    // app-term door): the with-rule accepts an application type as a
    // handler. Judged on the CHECK path (`compile_with`); the same form is
    // lowered since E.9 step 2 and its C is pinned further down.
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> []u8 }\nexport fn make() -> Effect[Fs]\n")
    // The shell carries the factory (`fx_shell`), as it carries real_fs since
    // E.9 step 1: the handler is link-checked like any call (W6 test below).
    ro d = compile_with("import std.fx.{make}\nfn g() -> int {\n with Fs = make() {\n  ro x = 1\n  println(x)\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(std), fx_shell())
    assert(d.len() == 0, messages(d))
}

test "with: several bindings in one statement (E4)" {
    // `with Fs = make(), Os = make() { ... }` -- the comma-separated form the
    // carrier (main.nv) writes. Every binding resolves independently; one
    // statement carries both. Judged on the check path like the test above;
    // the lowering installs both and restores both in reverse (ir_with.nv).
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> []u8 }\nexport type Os effect { fn args() -> []str }\nexport fn make() -> Effect[Fs]\nexport fn make_o() -> Effect[Os]\n")
    ro d = compile_with("import std.fx.{make, make_o}\nfn g() -> int {\n with Fs = make(), Os = make_o() {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(std), fx_shell())
    assert(d.len() == 0, messages(d))
}

test "with: a handler factory the shell does not carry is refused by W6, as in any position (E.9 step 1)" {
    // Until 2026-09-30 the handler expression was exempt from the W6
    // shell-symbol refusal (`link_check = false`), on the premise that no
    // probe could put real_fs into the shell. The probe lacked only the
    // import; with the exemption gone, the handler position asks the same
    // question as every other, and the self-build carrier passes because
    // the shell now carries its factories (the second half pins that).
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> []u8 }\nexport fn make() -> Effect[Fs]\n")
    ro d = compile_with("import std.fx.{make}\nfn g() -> int {\n with Fs = make() {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(std), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(messages(d).contains("carries no `nova_fn_3std2fx4make`"), messages(d))
    assert(interop_surface().has("nova_fn_3std2fs7real_fs"), "the shell must carry real_fs (E.9 step 1)")
    assert(interop_surface().has("nova_fn_3std2os7real_os"), "the shell must carry real_os (E.9 step 1)")
}

test "with: a KNOWN value type as the handler is refused, naming the cause (E4)" {
    // NEGATIVE: `with Fs = 42` diverges from the oracle if it passes -- the
    // oracle refuses int as a handler. A KNOWN non-handler type is refused
    // at the value, naming the type; unknown and application types stay
    // accepted (the named debt above).
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> []u8 }\n")
    ro (d, _) = compile_to_c("fn g() -> int {\n with Fs = 42 {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", std)
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("takes a handler"), d[0].message)
    assert(d[0].message.contains("int"), d[0].message)
}

test "with: an unknown effect name is refused as a name (E4)" {
    // CONTROL: the binding name must resolve to a declaration at all. The
    // wording is the compiler's existing unknown-name door -- a second,
    // different refusal proves the resolution ran. The handler value is
    // ORDINARY here (`make()` over the resolvable `Effect[Fs]`), so the
    // binding-name refusal is the ONLY diagnostic; coupling the control to
    // an unresolvable handler type would sink `make` itself and report a
    // second refusal about a value that is not what this door judges.
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> []u8 }\nexport fn make() -> Effect[Fs]\n")
    ro (d, _) = compile_to_c_with("import std.fx.{make}\nfn g() -> int {\n with Nope = make() {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(std), fx_shell())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("unknown name"), d[0].message)
}


// ---------------------------------------------------------------------------
// THE HANDLER LITERAL (E4 wave, 274.11): `with Fs = effect Fs {
// read(p str) -> []u8 => []u8.new() } { ... }`, measured against the oracle
// 2026-09-22. All of these judge the CHECK path (`compile_with`): a handler
// LITERAL is lowered in E.9 step 3, so `compile_to_c` would ICE after a
// clean check -- the named debt of that step.
// ---------------------------------------------------------------------------

/// The handed corpus the literal tests share: the slice head (the schema's
/// `[]u8` resolves through it, the same dependency every `[]T` signature
/// has) and the effect with a typed op and a slice-returning op.
fn handler_fx() -> []str {
    mut std = []str.new()
    std.push("module std.v\nexport type Vec[T] { n int }\n")
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> str\nfn sl(p str) -> []u8 }\nexport type Fs2 effect { fn read(p str) -> str\nfn size() -> int }\n")
    std
}

test "handler literal: expr body, typed param, judged against the schema -- accepted (E4)" {
    // POSITIVE: the literal implements the schema op exactly. The typed
    // parameter annotation is accepted and NOT cross-checked beyond the
    // schema (the named simplification: binding is positional).
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p str) -> str => p } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "handler literal: block body, BARE param the body uses -- positional binding (E4)" {
    // POSITIVE: `read(p)` binds `p` BY POSITION to the schema's `str` --
    // the body reads it, and a bare name is the oracle's own spelling.
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p) -> str {\n  println(p)\n  return p\n } } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "handler literal: several ops, newline-separated, one literal (E4)" {
    // POSITIVE: the oracle fixture's own shape -- two ops, no comma, the
    // second an expression body over a different return type.
    ro d = compile_with("fn g() -> int {\n with Fs2 = effect Fs2 {\n  read(p str) -> str => p\n  size() -> int => 7\n } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "handler literal: a binding OUTSIDE a with is routed and typed (E4)" {
    // POSITIVE: `ro h = effect Fs { ... }` -- first-class handler values
    // are deferred by E.5, but the literal's typist is one door, and a
    // binding initializer reaching it through the TupleExpr precedent is
    // typed `Effect[Fs]` rather than left to the lattice's ice.
    ro d = compile_with("fn g() -> int {\n ro h = effect Fs { read(p str) -> str => p }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "handler literal: a missing `-> T` is E_INCOMPLETE_HANDLER_OP_DECL by name (E4)" {
    // NEGATIVE: the oracle's first code. The absence is kept VISIBLE by
    // the parser (no RetType node); the checker names it, and the advice
    // spells the SCHEMA's return (`str`), matching the oracle's wording.
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p) => p } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].code == "E_NOVAC_LANG", d[0].code)
    assert(d[0].message.contains("missing its return type"), d[0].message)
    assert(d[0].message.contains("read(...) -> str => ..."), d[0].message)
}

test "handler literal: a wrong return type is E_HANDLER_OP_RETURN_TYPE_MISMATCH by name (E4)" {
    // NEGATIVE: the oracle's second code, both types named.
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p str) -> int => 1 } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].code == "E_NOVAC_LANG", d[0].code)
    assert(d[0].message.contains("declares return type `int`"), d[0].message)
    assert(d[0].message.contains("must match the effect schema exactly"), d[0].message)
}

test "handler literal: an op outside the schema is E_HANDLER_OP_UNKNOWN by name (E4)" {
    // NEGATIVE: the oracle's third code (registry 819's class). The
    // refusal names the op, the effect, and WHAT THE EFFECT DECLARES --
    // the schema's op list is in the sentence.
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { write(p str) -> str => p } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].code == "E_NOVAC_LANG", d[0].code)
    assert(d[0].message.contains("is not an operation of effect `Fs`"), d[0].message)
    assert(d[0].message.contains("it declares: read, sl"), d[0].message)
}

test "handler literal: the BODY is judged by the fn return door (E4)" {
    // NEGATIVE: `-> str => 1` passes the annotation-vs-schema comparison
    // and then the BODY refuses through the SAME return door a fn body
    // uses -- one return discipline, not a handler-flavoured copy.
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p str) -> str => 1 } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("cannot return value of type `int`"), d[0].message)
}

test "handler literal: the literal names a record, named at the name (E4)" {
    // NEGATIVE: the literal's OWN name resolves, and what it resolves to
    // is named -- the same word-the-cause rule the with binding keeps.
    ro d = compile_with("type Box { v int }\nfn g() -> int {\n with Fs = effect Box { read(p str) -> str => p } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("is a record, not one"), d[0].message)
}

test "handler literal: in every OTHER value position it is refused BY NAME -- never silent, never an ICE (registry 1312)" {
    // NEGATIVE, six positions from the hunt (docs/dev/hunts/novac/
    // 2026-09-23-check-k7.md, family A). Only the with slot and a local
    // binding's initializer call the literal's typist; before the walk gate
    // the first form below (an op the effect does not declare, as a `=>`
    // body) passed in SILENCE, `return` and the match arm died in an ICE,
    // and the argument, block tail and if branch got somebody else's cause.
    // Each form must now carry the ONE named refusal and no ICE.
    mut srcs = []str.new()
    srcs.push("fn mk() -> Effect[Fs] => effect Fs { write(p str) -> str => p }\nfn main() {\n println(1)\n}")
    srcs.push("fn mk() -> Effect[Fs] {\n return effect Fs { read(p str) -> str => p }\n}\nfn main() {\n println(1)\n}")
    srcs.push("fn g(k int) -> int {\n ro h = match k {\n  0 => effect Fs { read(p str) -> str => p }\n  _ => effect Fs { read(p str) -> str => p }\n }\n 0\n}\nfn main() {\n println(g(0))\n}")
    srcs.push("fn use_h(h Effect[Fs]) -> int => 1\nfn main() {\n println(use_h(effect Fs { read(p str) -> str => p }))\n}")
    srcs.push("fn mk() -> Effect[Fs] {\n effect Fs { read(p str) -> str => p }\n}\nfn main() {\n println(1)\n}")
    srcs.push("fn g(c bool) -> int {\n ro h = if c {\n  effect Fs { read(p str) -> str => p }\n } else {\n  effect Fs { read(p str) -> str => p }\n }\n 0\n}\nfn main() {\n println(g(true))\n}")
    for s in srcs {
        ro d = compile_with(s, parse_decls(handler_fx()), interop_surface())
        mut hit = false
        for g in d {
            assert(g.code != "E_NOVAC_ICE", "${s}\n--\n${messages(d)}")
            // The FOREIGN causes the hunt measured beside or instead of the
            // name: the block tail's "ends without a value" and the call's
            // "omits `h`". One literal, one cause.
            assert(!g.message.contains("ends without a value"), "${s}\n--\n${messages(d)}")
            assert(!g.message.contains("omits"), "${s}\n--\n${messages(d)}")
            if g.message.contains("a handler literal is compiled only as") {
                hit = true
            } else {
                // Another diagnostic beside the named one: allowed, the
                // ICE and foreign-cause checks above are what this loop guards.
            }
        }
        assert(hit, "${s}\n--\n${messages(d)}")
    }
}

test "handler literal: a handler bound by `ro` is handed on as `Effect[Fs]` -- returned and passed (registry 1323)" {
    // POSITIVE: the literal's recorded type is the SEED application
    // `Effect[Fs]`, the same term a signature's `-> Effect[Fs]` and a
    // parameter `h Effect[Fs]` resolve to. It used to be recorded as
    // `Fs[Fs]` (the effect itself as the head), and both uses below were
    // refused -- the return with "cannot return value of type `Fs[Fs]`".
    // The oracle accepts and runs this shape.
    ro d = compile_with("fn use_h(h Effect[Fs]) -> int => 1\nfn mk() -> Effect[Fs] {\n ro h = effect Fs { read(p str) -> str => p }\n h\n}\nfn g() -> int {\n ro h = effect Fs { read(p str) -> str => p }\n use_h(h)\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "handler literal: the gate leaves a JUDGED position to the typist (registry 1312, control)" {
    // CONTROL of the test above: a local binding's initializer is a judged
    // position, so an op outside the schema is refused by the literal's
    // OWN typist (E_HANDLER_OP_UNKNOWN), not by the walk gate. If the gate
    // swallowed this position too, the test above would still pass -- this
    // one would not.
    ro d = compile_with("fn g() -> int {\n ro h = effect Fs { write(p str) -> str => p }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("is not an operation of effect `Fs`"), d[0].message)
}

// ---------------------------------------------------------------------------
// THE LITERAL LOWERED (E.9 step 3, plan 274.11): the operations are functions
// of their own, the value is D474's -- no captures: one allocation and a NULL
// context; captures: ONE block, the context at the aligned tail of the table,
// `mut` bindings by address, the rest by copy. The checker says which reads
// are captures (the binding row below the literal's mark); the op's own
// parameters and locals never are.
// The shell carries the oracle's own literal allocations (real_fs builds an
// `NovaVtable_Fs` the same way), so the C is judged by COUNT against a control
// program with no literal, never by mere presence.
// ---------------------------------------------------------------------------

/// The C of the same harness with no handler literal -- the shell's own count.
fn control_c() -> str {
    ro src = "fn g() -> int {\n 0\n}\nfn main() {\n println(g())\n}"
    ro (d, c) = compile_to_c_with(src, parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
    c
}

test "handler literal: no captures -- one allocation, a NULL context, the op in its slot (E.9 step 3, D474 case 2)" {
    ro src = "fn g() -> int {\n with Fs = effect Fs { read(p str) -> str {\n  ro q = p\n  q\n } } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}"
    ro (d, c) = compile_to_c_with(src, parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
    ro vt = effect_vtable_c("Fs")
    ro c0 = control_c()
    ro alloc = "(${vt}*)nova_alloc(sizeof(${vt}));"
    assert(c.matches(alloc).len() == c0.matches(alloc).len() + 1, c)
    assert(c.matches("->ctx = NULL;").len() == c0.matches("->ctx = NULL;").len() + 1, c)
    // The op's own parameter `p` and local `q` are bound ABOVE the literal's
    // mark: no context, no alignment arithmetic.
    assert(!c.contains("_Alignof("), c)
    assert(c.contains("->read = "), c)
}

test "handler literal: captures -- one block, aligned tail, `mut` by address, `ro` by copy (E.9 step 3, D474 case 3)" {
    ro src = "fn g() -> int {\n mut n = 1\n ro b = 2\n with Fs = effect Fs { read(p str) -> str {\n  n += b\n  p\n } } {\n  1\n }\n n\n}\nfn main() {\n println(g())\n}"
    ro (d, c) = compile_to_c_with(src, parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
    ro vt = effect_vtable_c("Fs")
    // ONE allocation for the table and the context, the offset aligned.
    assert(c.contains("(sizeof(${vt}) + _Alignof("), c)
    ro c0 = control_c()
    ro alloc = "(${vt}*)nova_alloc(sizeof(${vt}));"
    assert(c.matches(alloc).len() == c0.matches(alloc).len(), c)
    assert(c.matches("->ctx = NULL;").len() == c0.matches("->ctx = NULL;").len(), c)
    assert(c.contains("->n = &n;"), c)
    assert(c.contains("->b = b;"), c)
}

test "handler literal: a literal inside another literal's op takes the outer capture from that op's context (E.9 step 3)" {
    // The OUTER op never reads `n`; only the inner literal does. The outer
    // literal must still capture it (the capture-mark stack), and the inner
    // context is filled from the outer op's context, not from `&n` -- no such
    // local exists in the op function. Two fills of `n`, one of them `&n`:
    // without the stack the outer fill is missing (one fill), without the
    // emitter half both are `&n`.
    ro inner = "with Fs2 = effect Fs2 { read(q str) -> str {\n   n += 1\n   q\n  } } {\n   println(1)\n  }\n"
    ro src = "fn g() -> int {\n mut n = 1\n with Fs = effect Fs { read(p str) -> str {\n  ${inner}  p\n } } {\n  println(2)\n }\n n\n}\nfn main() {\n println(g())\n}"
    ro (d, c) = compile_to_c_with(src, parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 0, messages(d))
    ro c0 = control_c()
    assert(c.matches("->n = ").len() == c0.matches("->n = ").len() + 2, c)
    assert(c.matches("->n = &n;").len() == c0.matches("->n = &n;").len() + 1, c)
}

test "handler literal: a HELD literal capturing a `mut` binding is refused by the position's name (E.9 step 3, E.5)" {
    // A held value may outlive the frame its `mut` capture points into.
    ro src = "fn g() -> int {\n mut n = 1\n ro h = effect Fs { read(p str) -> str {\n  n += 1\n  p\n } }\n n\n}\nfn main() {\n println(g())\n}"
    ro (d, _) = compile_to_c_with(src, parse_decls(handler_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("that captures no `mut` binding"), d[0].message)
    // CONTROL: the same held literal capturing a `ro` binding is compiled.
    ro ok_src = "fn g() -> int {\n ro n = 1\n ro h = effect Fs { read(p str) -> str {\n  println(n)\n  p\n } }\n n\n}\nfn main() {\n println(g())\n}"
    ro (d2, c2) = compile_to_c_with(ok_src, parse_decls(handler_fx()), interop_surface())
    assert(d2.len() == 0, messages(d2))
    assert(c2.contains("->n = n;"), c2)
}


// ---------------------------------------------------------------------------
// THE EFFECT-OPERATION CALL (E.4 item 2, plan 274.11): `Fs.read("p")` types
// through the effect's op schema. The oracle's acceptance: the call is
// typed with or WITHOUT an installed handler -- a missing handler is a
// RUNTIME panic there, not a check error -- so a green check with no
// `with` in sight is the acceptance, not a hole in it. Judged on the
// CHECK path (`compile_with`): how the call lowers (handler dispatch) is
// the lowering wave's debt, the same standing note the with tests carry.
// ---------------------------------------------------------------------------

/// The handed corpus the operation-call tests share: the slice head (the
/// schema's `[]u8` resolves through it), the effect with a str-parameter
/// and an int-parameter operation, and a maker the with-binding tests use.
/// The shell surface plus the fake factories of `module std.fx` these tests
/// declare. Since E.9 step 1 a `with` handler is link-checked like any call,
/// so a factory that is not in the shell is refused by W6 -- the fixtures
/// hand theirs in explicitly, the way the regenerated shell carries real_fs.
fn fx_shell() -> InteropTable {
    mut s = interop_surface()
    s.add("nova_fn_3std2fx4make")
    s.add("nova_fn_3std2fx6make_o")
    // The dispatchers of the fake `std.fx` Fs operations: since E.9 step 2 an
    // operation call is emitted as the shell's dispatcher, so the shell carries
    // it or the call is refused (the W6 test below).
    s.add(effect_op_dispatcher_c("Fs", "read"))
    s.add(effect_op_dispatcher_c("Fs", "size"))
    s
}

fn opcall_fx() -> []str {
    mut std = []str.new()
    std.push("module std.v\nexport type Vec[T] { n int }\n")
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> []u8\nfn size() -> int }\nexport fn make() -> Effect[Fs]\n")
    std
}

test "effect op call: no handler in sight -- check is green, the runtime panic is the oracle's (E.4 item 2)" {
    // THE ACCEPTANCE, verbatim from the plan: `Fs.read("p")` types without
    // a `with` anywhere; the absence of a handler is a RUNTIME error in
    // the oracle's semantics, and novac's check must not turn it into a
    // check error. (How the call lowers is the standing emit debt.)
    ro d = compile_with("fn g() -> int {\n ro b = Fs.read(\"p\")\n println(Fs.size())\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(opcall_fx()), fx_shell())
    assert(d.len() == 0, messages(d))
}

test "effect op call: inside a with body, the handler installed -- green (E.4 item 2)" {
    ro d = compile_with("import std.fx.{make}\nfn g() -> int {\n with Fs = make() {\n  ro b = Fs.read(\"p\")\n  println(Fs.size())\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(opcall_fx()), fx_shell())
    assert(d.len() == 0, messages(d))
}

test "effect op call: an operation whose dispatcher the shell does not carry is refused, W6's way (E.9 step 2)" {
    // The call is emitted as the SHELL's dispatcher `Nova_Fs_size`; a shell
    // without it is a link that cannot happen, refused by name at the
    // operation. The control is the test above: the same call with a shell
    // that carries it is green.
    ro d = compile_with("fn g() -> int {\n ro n = Fs.size() + 1\n println(n)\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(opcall_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    // One sentence for the gap (check/messages.nv, effect_without_runtime_msg):
    // the shell carries the dispatchers of EVERY operation of each effect it
    // carries (Os 17 of 17, Fs 26 of 26, measured 2026-09-30), so in a real
    // program the missing piece is the whole effect. The fake `std.fx` Fs
    // declares an operation the real one lacks -- the same refusal.
    assert(messages(d).contains("effect `Fs` has no runtime pieces"), messages(d))
}

test "effect op call and with: the C holds the dispatcher, the slot swap, the frame, and the restore (E.9 step 2)" {
    // The value form lowered: the handler in a local, swapped into the slot,
    // the body under the frame's setjmp, the slot restored and the frame
    // popped after it; the operation printed as the shell's dispatcher.
    ro (d, c) = compile_to_c_with("import std.fx.{make}\nfn g() -> int {\n with Fs = make() {\n  println(Fs.size())\n }\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(opcall_fx()), fx_shell())
    assert(d.len() == 0, messages(d))
    assert(c.contains("${effect_vtable_c("Fs")}*"), c)
    assert(c.contains(" = ${effect_slot_c("Fs")};"), c)
    assert(c.contains("nova_interrupt_push(&_novac_f0);"), c)
    assert(c.contains("setjmp(_novac_f0.jmp) == 0"), c)
    assert(c.contains("${effect_op_dispatcher_c("Fs", "size")}()"), c)
    assert(c.contains("nova_interrupt_pop();"), c)
}

test "effect op call: the operation's return type is the call's type (E.4 item 2)" {
    // `size()` declares `-> int`: the recorded type flows into arithmetic,
    // so a wrong record would refuse here -- the channel is the answer.
    ro d = compile_with("fn g() -> int {\n ro n = Fs.size() + 1\n println(n)\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(opcall_fx()), fx_shell())
    assert(d.len() == 0, messages(d))
}

test "effect op call: an operation the effect does not declare is refused by name (E.4 item 2)" {
    // The call-side sibling of the handler literal's E_HANDLER_OP_UNKNOWN:
    // the refusal names the op, the effect, and what the effect DECLARES.
    // (The oracle's exact wording for a bad operation CALL was not probed;
    // the family wording is shared on purpose -- a direct probe is filed.)
    ro d = compile_with(
        "fn g() -> int {\n ro b = Fs.write(\"p\")\n 0\n}\nfn main() {\n println(g())\n}",
        parse_decls(opcall_fx()),
        interop_surface(),
    )
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("is not an operation of effect `Fs`"), d[0].message)
    assert(d[0].message.contains("it declares: read, size"), d[0].message)
}

test "effect op call: arity mismatch names both counts (E.4 item 2)" {
    ro d = compile_with(
        "fn g() -> int {\n ro b = Fs.read(\"p\", \"q\")\n 0\n}\nfn main() {\n println(g())\n}",
        parse_decls(opcall_fx()),
        interop_surface(),
    )
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("takes 1 parameter(s)"), d[0].message)
    assert(d[0].message.contains("passes 2"), d[0].message)
}

test "effect op call: an argument against the declared parameter type (E.4 item 2)" {
    // `read` declares `p str`; the int literal is refused through the one
    // unification door, both types named.
    ro d = compile_with("fn g() -> int {\n ro b = Fs.read(1)\n 0\n}\nfn main() {\n println(g())\n}", parse_decls(opcall_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("argument 1 is `int`"), d[0].message)
    assert(d[0].message.contains("declares `str`"), d[0].message)
}

test "effect op call: a bound value named like the effect keeps the call (E.4 item 2)" {
    // CONTROL: `fn f(Fs Box)` -- the parameter shadows the effect name,
    // and the nearer scope decides what `Fs.read` names. The effect-op
    // door stays silent (its refusal family is "is not an operation",
    // and that text must NOT appear); the pre-existing type-head
    // machinery answers instead.
    ro d = compile_with("type Box { v int }\nfn f(Fs Box) -> int {\n ro b = Fs.read(\"p\")\n 0\n}\nfn main() {\n println(1)\n}", parse_decls(opcall_fx()), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(!d[0].message.contains("is not an operation of effect"), d[0].message)
}


test "with: a tail whose body RETURNS is the fn's return (E4, form-6)" {
    // POSITIVE: `with Fs = h { return 1 }` as the whole body of a
    // value-returning fn. The form-6 carrier measurement (main.nv:351,
    // `compiler_argv`) refused this "ends without a value" while the
    // oracle compiles it: the with statement terminates the fn when its
    // BODY does, through the very `stmt_terminates` door the if-let
    // precedent uses -- no with-flavoured copy of the judge.
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> str }\n")
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p str) -> str => p } {\n  return 1\n }\n}\nfn main() {\n println(g())\n}", parse_decls(std), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "with: a tail whose body does NOT return still refuses (E4, form-6)" {
    // NEGATIVE: the same tail shape with a body that falls through --
    // the statement leaves control behind it, exactly the fall-through
    // an `if` without else already refuses. The termination arm answers
    // false, and the missing-return door says its one sentence.
    mut std = std_decls()
    std.push("module std.fx\nexport type Fs effect { fn read(p str) -> str }\n")
    ro d = compile_with("fn g() -> int {\n with Fs = effect Fs { read(p str) -> str => p } {\n  println(1)\n }\n}\nfn main() {\n println(g())\n}", parse_decls(std), interop_surface())
    assert(d.len() == 1, messages(d))
    assert(d[0].message.contains("ends without a value"), d[0].message)
}

test "if-let: the sibling termination machinery still answers (control, E4)" {
    // CONTROL: a tail if-let whose branches return terminates the fn --
    // the door the with arm joined, unchanged. If the new arm disturbed
    // the enumeration, this reddens first.
    mut std = std_decls()
    std.push("module std.v\nexport type Option[T] enum Some(T) | None\n")
    ro d = compile_with("fn g() -> int {\n if Some(v) = Some(1) {\n  return v\n } else {\n  return 0\n }\n}\nfn main() {\n println(g())\n}", parse_decls(std), interop_surface())
    assert(d.len() == 0, messages(d))
}

test "handler literal: an undeclared return type is the author's error (E4, found at the nova-kim acceptance)" {
    // MEASURED 2026-09-23: in an ordinary run this was the ONLY diagnostic, and it
    // said "outside the subset ... not a type novac knows" -- calling the author's
    // misspelling novac's debt. A fn signature says "undeclared type name" for the
    // same name, and the literal now goes through that very door.
    ro d = compile_with(
        "fn g() -> int {\n with Fs = effect Fs { read(p str) -> Nope => p } {\n  1\n }\n 0\n}\nfn main() {\n println(g())\n}",
        parse_decls(handler_fx()),
        interop_surface(),
    )
    assert(d.len() == 1, messages(d))
    assert(messages(d).contains("undeclared type name `Nope`"), messages(d))
}

test "`is` on an `any`: the runtime's type test, and the narrowed name unboxed at the head of the branch (E.9 step 4b)" {
    // REACHED code with a name of its own (`x`): the shell's supervisor bridge
    // already carries `nova_any_is(err, ...)` of its own, so a function nobody
    // calls, or the name `err`, would make these asserts pass on the shell.
    mut std = []str.new()
    std.push("module std.v\nexport type Vec[T] { n int }\n")
    std.push("module std.fx\nexport type Hk effect { fn hit(x any) -> int }\n")
    ro inner = "hit(x) -> int {\n  if x is str {\n   println(x)\n   return 1\n  }\n  0\n }"
    ro src = "fn g() -> int {\n with Hk = effect Hk { ${inner} } {\n  println(1)\n }\n 0\n}\nfn main() {\n println(g())\n}"
    ro (d, c) = compile_to_c_with(src, parse_decls(std), interop_surface())
    assert(d.len() == 0, messages(d))
    assert(c.contains("nova_any_is(x, NOVA_TID_nova_str)"), c)
    assert(c.contains("*(nova_str*)nova_any_data(x);"), c)
    assert(c.contains("nova_str x = "), c)
}
