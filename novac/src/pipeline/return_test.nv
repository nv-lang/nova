// SPDX-License-Identifier: MIT OR Apache-2.0
// Donor: rustc's `check_return_expr` -- the body's value is coerced to the
// declared return type and a mismatch is E0308 at the expression; NOT taken:
// coercion (Nova has none between named types, D405), and the `!` type (a
// `panic` tail records no type here and the door says nothing).
// Role: acceptance tests of the RETURN DOOR (274.7 B5, registry #960): the
// value a body produces is the declared return type by name; a bare literal
// takes the declared type; narrowing and mismatch carry the oracle's names.
// Used by: check-novac-module-tests (the one batch runner); nothing imports it.
// Guarded by: the same guards as every test file; fixtures return_mismatch/
// and return_narrowing/ through check-novac-no-cascade and the differential.
// novac/src/pipeline/return_test.nv -- what a fn declares, its body returns.

module novac.pipeline

test "the body's value must be the declared return type, by name (274.7 B5, #960)" {
    ro std = std_decls()
    // POSITIVE FIRST: a door that never existed is switched on over a corpus
    // that never met it, and the first proof is that it lets legal code through.
    // `Meters(n)` -- a newtype built by its constructor in a tail -- was #963
    // in the first cut of this wave (the lattice asked before the construction
    // was recorded); closed the same day, so the form stands here as proof.
    ro (d0, c0) = compile_to_c("type Meters int\nfn one() -> f64 => 1\nfn byte() -> u8 => 200\nfn early(n int) -> int {\n if n > 0 { return n }\n 0\n}\nfn twice(n int) -> int => n * 2\nfn via(n int) -> int => twice(n)\nfn pick(n int) -> str {\n if n > 0 { \"pos\" } else { \"non-pos\" }\n}\nfn m(n int) -> Meters => Meters(n)\nfn main() {\n println(one())\n println(byte())\n println(early(3))\n println(via(4))\n println(pick(1))\n println(m(9))\n}", std)
    assert(d0.len() == 0, messages(d0))
    // The literal took the DECLARED type: `200` is a byte, `1` a double.
    assert(c0.contains("nova_byte)200") || c0.contains("nova_byte)0xC8"), c0)
    // A generic body is not judged in the generic shape: no false refusal.
    ro (dg, _) = compile_to_c("fn same[T](x T) -> T => x\nfn main() {\n println(same(1))\n}", std)
    assert(dg.len() == 0, messages(dg))

    // MISMATCH by name: str for int, f64 for int, int for f64, int for a newtype.
    ro (d1, _) = compile_to_c("fn f() -> int => \"s\"\nfn main() {\n println(f())\n}", std)
    assert(d1.len() == 1, messages(d1))
    assert(messages(d1).contains("cannot return value of type `str` from a function declared `-> int`") && messages(d1).contains("E7301"), messages(d1))
    ro (d2, _) = compile_to_c("fn f(x f64) -> int => x\nfn main() {\n println(f(3.9))\n}", std)
    // Two numbers are D491's (2026-10-02): the oracle's code, not E7301.
    assert(d2.len() == 1 && messages(d2).contains("E_IMPLICIT_NARROWING"), messages(d2))
    ro (d3, _) = compile_to_c("fn f(n int) -> f64 => n\nfn main() {\n println(f(7))\n}", std)
    assert(d3.len() == 1 && messages(d3).contains("E_IMPLICIT_NARROWING"), messages(d3))
    ro (d4, _) = compile_to_c("type Meters int\nfn f(n int) -> Meters => n\nfn main() {\n println(f(9))\n}", std)
    assert(d4.len() == 1 && messages(d4).contains("`-> Meters`"), messages(d4))

    // NARROWING carries the argument door's name; a `return` is judged like a tail.
    ro (d5, _) = compile_to_c("fn f(n int) -> u8 => n\nfn main() {\n println(f(300))\n}", std)
    assert(d5.len() == 1 && messages(d5).contains("E_IMPLICIT_NARROWING"), messages(d5))
    ro (d6, _) = compile_to_c("fn f(n int) -> u8 {\n if n > 0 { return n }\n 0\n}\nfn main() {\n println(f(300))\n}", std)
    assert(d6.len() == 1 && messages(d6).contains("E_IMPLICIT_NARROWING"), messages(d6))
    // A literal that does not fit the declared width is the literal's own refusal.
    ro (d7, _) = compile_to_c("fn f() -> u8 => 300\nfn main() {\n println(f())\n}", std)
    assert(d7.len() == 1 && messages(d7).contains("E_LIT_OUT_OF_RANGE"), messages(d7))
}

test "a value `if` branch may end in a NESTED `if` or a bare literal of the expected type (part 5 of p274-carina-k1)" {
    // sem.nv `generic_head_cnt` ends a branch in an `if`; lex.nv `byte_at` puts
    // `0` against `b[k]` in a `-> u8` body. Both were refused: "a branch of a
    // tail `if` ends without a value", "the branches ... must agree on a type".
    ro (d, c) = compile_to_c("fn deep(a int, b int) -> int {\n if a > 0 {\n  if b > 0 { 1 } else { 2 }\n\
 } else {\n  0\n }\n}\n\
fn main() {\n println(deep(1, 2))\n}", std_decls())
    assert(d.len() == 0, messages(d))
    // The nested branches WRITE the value; they are not evaluated and dropped.
    assert(!c.contains("(void)(((nova_int)1LL))"), c)
    ro (dl, _) = compile_to_c("fn pick(c bool, v u8) -> u8 {\n if c {\n  v\n } else {\n  0\n }\n}\n\
fn main() {\n println(1)\n}", std_decls())
    assert(dl.len() == 0, messages(dl))
    // The literal takes the position's type, and the RETURN's type is not the
    // position of a method's argument: `=> t.row(if m { 1 } else { 0 })` in a
    // `-> Row` body adapted the branch literals to `Row` until the method call
    // cleared the expectation as the free call does (types.nv `@intern`).
    ro (da, _) = compile_to_c("type Tb { n int }\ntype Row int\nfn Tb @row(h int) -> Row => Row(h)\n\
fn mk(t Tb, m bool) -> Row => t.row(if m { 1 } else { 0 })\nfn main() {\n println(1)\n}", std_decls())
    assert(da.len() == 0, messages(da))
    // CONTROL: a branch that ends in a BINDING still has no value.
    ro (dc, _) = compile_to_c("fn f(a int) -> int {\n if a > 0 {\n  ro z = 1\n } else {\n  0\n }\n}\n\
fn main() {\n println(f(1))\n}", std_decls())
    assert(messages(dc).contains("ends without a value"), messages(dc))
}

test "an `else if` chain is a value -- in a body tail and in a binding (part 5 of p274-carina-k1)" {
    // sem/mangle.nv writes `ro shell = if .. else if .. else ..`; the chain was
    // "not compiled as a value yet". It is a value `if` in the else position,
    // judged by the same door and placed into the same temporary.
    ro (d, c) = compile_to_c("fn sign(n int) -> int {\n ro s = if n > 0 { 1 } else if n < 0 { 2 } else { 3 }\n s\n}\n\
fn grade(n int) -> int {\n if n > 90 {\n  7\n } else if n > 50 {\n  8\n } else {\n  9\n }\n}\n\
fn main() {\n println(sign(1) + grade(1))\n}", std_decls())
    assert(d.len() == 0, messages(d))
    // Every arm of both chains WRITES its value; none is evaluated and dropped.
    assert(!c.contains("(void)(((nova_int)"), c)
    assert(c.contains("= ((nova_int)9LL);"), c)
    // CONTROL: a chain whose arms disagree is still refused by name.
    ro (dc, _) = compile_to_c("fn f(n int) -> int {\n if n > 0 {\n  1\n } else if n < 0 {\n  \"no\"\n } else {\n  0\n }\n}\n\
fn main() {\n println(f(1))\n}", std_decls())
    assert(dc.len() >= 1, "disagreeing arms of an else-if chain must be refused")
}

test "the tail's expectation stays outside a STATIC call's arguments (part 6 of p274-carina-k1)" {
    // `=> Tb.id(if m { 1 } else { 0 })` in a `-> Row` body: the branch literals
    // took the RETURN's type `Row` through the static call's argument walk, so
    // `T` was deduced as `Row` -- the leak part 5 closed for the method call
    // (methods.nv). The argument is the literal's position (D489), and an
    // `if` whose branches are both literals with no written type is `int`:
    // `T = int`, and the body's value is `int` where `Row` is declared -- the
    // verdict the generic METHOD of the same shape gets.
    mut std = std_decls()
    std.push("module std.s\nexport type Tb { n int }\nexport type Row int\nexport fn Tb.id[T](x T) -> T => x\n")
    ro src = "fn mk(m bool) -> Row => Tb.id(if m { 1 } else { 0 })\nfn main() {\n println(1)\n}"
    ro d = compile_with(src, parse_decls(std), interop_surface())
    assert(messages(d).contains("cannot return value of type `int`"), messages(d))
    // CONTROL: where the declared return IS `int`, the same call compiles.
    ro ok = "fn mk(m bool) -> int => Tb.id(if m { 1 } else { 0 })\nfn main() {\n println(1)\n}"
    ro d2 = compile_with(ok, parse_decls(std), interop_surface())
    assert(d2.len() == 0, messages(d2))
}
