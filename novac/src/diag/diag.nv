// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/diag — the diagnostic form (architecture §2/§7).
//
// The schema of §7 is normative and machine-first: the JSON is the product,
// human text renders FROM the structure, never the reverse. Internally a
// diagnostic carries byte offsets (produced through the one position door,
// source.offset_of); `id` is assigned at render time — it is an output-order
// fact, not a stored one.

module novac.diag

export type Severity enum
    | ErrorSev
    | WarningSev

export type Diagnostic {
    code str
    severity Severity
    lo int
    hi int
    message str
}

fn sev_str(s Severity) -> str {
    match s {
        ErrorSev => "error"
        WarningSev => "warning"
    }
}

fn esc(s str) -> str {
    consume out = StringBuilder.new()
    for b in s.bytes() {
        if b == 34 || b == 92 {
            out.append('\\')
            out.append(b as char)
        } else if b == 10 {
            out.append("\\n")
        } else {
            out.append(b as char)
        }
    }
    out
}

/// Render one diagnostic as a §7 schema JSON line. `id` = position in the
/// output stream; `file` is passed by the driver door (main).
export fn to_json(d Diagnostic, id int, file str) -> str {
    consume out = StringBuilder.new()
    out.append("{\"id\": \"d")
    out.append(id)
    out.append("\", \"code\": \"")
    out.append(d.code)
    out.append("\", \"severity\": \"")
    out.append(sev_str(d.severity))
    out.append("\", \"primary\": {\"file\": \"")
    out.append(esc(file))
    out.append("\", \"start\": ")
    out.append(d.lo)
    out.append(", \"end\": ")
    out.append(d.hi)
    out.append("}, \"message\": \"")
    out.append(esc(d.message))
    out.append("\", \"poisoned_by\": null}")
    out
}
