// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/diag — the diagnostic form (architecture §2/§7).
//
// The schema of §7 is normative and machine-first: the JSON is the product,
// human text renders FROM the structure, never the reverse. Serialization is
// std serde (owner's correction 2026-08-14 — hand-rolled StringBuilder JSON
// was a private copy of a solved judgment, class K4 in miniature): the DTO
// mirrors the schema one field to one field, and Option[str] None IS the
// schema's null by the std contract. `id` is assigned at render time — an
// output-order fact, not a stored one.

module novac.diag

import std.encoding.serde.{json_encode}

/// Diagnostic severity of the §7 schema (renders "error"/"warning").
export type Severity enum
    | ErrorSev
    | WarningSev

/// Render the severity as the §7 schema string.
export fn Severity @to_str() -> str {
    match @ {
        ErrorSev => "error"
        WarningSev => "warning"
    }
}

/// One compiler diagnostic as the phases produce it (positions in byte
/// offsets; file/id arrive at render time through the pipeline door).
export type Diagnostic {
    code str          // machine code, e.g. E_NOVAC_SUBSET / E_NOVAC_ICE
    severity Severity // error/warning — the §7 schema's severity field
    lo int            // primary span start, byte offset into the source
    hi int            // primary span end (half-open), byte offset
    message str       // human half, English (project rule)
}

/// Serde DTO of the §7 primary-span object (file + byte range).
#impl(Serialize)
type PrimaryDto {
    file str  // path exactly as the CLI received it
    start int // = Diagnostic.lo
    end int   // = Diagnostic.hi
}

/// Serde DTO of one §7 JSON line — field names ARE the schema.
#impl(Serialize)
type DiagDto {
    id str                  // stable per-run id: "d<position in stream>"
    code str                // = Diagnostic.code
    severity str            // rendered Severity (to_str)
    primary PrimaryDto      // the primary span
    message str             // = Diagnostic.message
    poisoned_by Option[str] // id of the causing diagnostic; None = root cause
}

/// Render one diagnostic as a §7 schema JSON line. `id` = position in the
/// output stream; `file` is passed by the pipeline door.
export fn to_json(d Diagnostic, id int, file str) -> str {
    ro dto = DiagDto {
        id: "d${id}",
        code: d.code,
        severity: d.severity.to_str(),
        primary: PrimaryDto { file, start: d.lo, end: d.hi },
        message: d.message,
        poisoned_by: None,
    }
    json_encode(dto) ?? ice("diag to_json: flat Serialize DTO encode failed")
}

/// The ONE internal-invariant door (novac conventions P12, D416 context).
/// diag is a PURE module (the architecture keeps effects at the door in
/// main), so ice() cannot print; instead the WHOLE section-7 JSON line IS
/// the panic message: the runtime prints it when the fiber dies, so the
/// machine reader still gets one structured E_NOVAC_ICE line, and the death
/// itself follows the language rule (panic = fiber death, observable by the
/// parent supervisor -- spec "Panic", D416).
///
/// WHY the JSON is hand-built here and not serde (owner's question
/// 2026-08-14): the last-resort door must not depend on the machinery whose
/// failure it may be reporting -- ice() routed through json_encode would
/// recurse infinitely the day json_encode itself is the broken invariant.
/// The drift risk of a hand copy is held by a unit test instead: ice_json
/// is pure and diag_test pins it to the schema field by field. `msg` is
/// compiler-internal ASCII by convention (no quotes/backslashes), so no
/// escaping pass -- the same test documents that assumption.
fn ice_json(msg str) -> str {
    "{\"id\":\"ice\",\"code\":\"E_NOVAC_ICE\",\"severity\":\"error\",\"primary\":{\"file\":\"\",\"start\":0,\"end\":0},\"message\":\"internal compiler error (novac bug, not yours): ${msg}\",\"poisoned_by\":null}"
}

/// The ONE internal-error door: print a §7 E_NOVAC_ICE line, then die (P12).
export fn ice(msg str) -> never {
    panic(ice_json(msg))
}
