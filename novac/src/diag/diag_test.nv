// novac/src/diag — tests beside the module: the JSON line carries every field
// of the architecture §7 schema (the binary-level diag-schema guard holds the
// same rule over fixtures; this unit holds it at the producer).

module novac.diag

test "to_json carries every schema field" {
    ro d = Diagnostic {
        code: "E_NOVAC_SUBSET",
        severity: Severity.ErrorSev,
        lo: 3,
        hi: 7,
        message: "outside the subset",
        file: "",
    }
    ro j = to_json(d, 0, "a.nv")
    assert(j.contains("\"id\""))
    assert(j.contains("\"code\""))
    assert(j.contains("E_NOVAC_SUBSET"))
    assert(j.contains("\"severity\""))
    assert(j.contains("error"))
    assert(j.contains("\"primary\""))
    assert(j.contains("a.nv"))
    assert(j.contains("\"message\""))
    assert(j.contains("\"poisoned_by\""))
}

test "a span that names its own file is printed against it, not the compiled file (#1521)" {
    // An instance of a handed body is refused in the file the body was written
    // in: the oracle says `geo.nv:5:9`, and so does the primary span now.
    ro d = Diagnostic { code: "E_NOVAC_SUBSET", severity: Severity.ErrorSev, lo: 3, hi: 7,
                        message: "unknown name", file: "src/geo/geo.nv" }
    ro j = to_json(d, 0, "src/main.nv")
    assert(j.contains("\"file\":\"src/geo/geo.nv\""), j)
    assert(!j.contains("main.nv"), j)
    // CONTROL: a span with no file of its own is the compiled file's, as always.
    ro own = Diagnostic { code: "E_NOVAC_SUBSET", severity: Severity.ErrorSev, lo: 3, hi: 7,
                          message: "unknown name", file: "" }
    assert(to_json(own, 0, "src/main.nv").contains("\"file\":\"src/main.nv\""))
}

test "severity renders as the schema strings" {
    assert(Severity.ErrorSev.to_str() == "error")
    assert(Severity.WarningSev.to_str() == "warning")
}

test "ice_json carries every schema field and the message" {
    // The hand-built last-resort JSON (see ice_json's doc for WHY it is not
    // serde) is pinned to the schema HERE -- silent drift of the hand copy
    // is the exact K4 risk the owner questioned, and this unit is its guard.
    ro j = ice_json("novac/src/probe.nv:7", "probe message")
    assert(j.contains("\"id\""))
    assert(j.contains("E_NOVAC_ICE"))
    assert(j.contains("\"severity\""))
    assert(j.contains("\"primary\""))
    assert(j.contains("\"message\""))
    assert(j.contains("\"poisoned_by\""))
    assert(j.contains("probe message"))
    assert(j.contains("novac bug, not yours"))
}

test "ice_json names the novac site that died, and the site is escaped" {
    // Registry 221.1 №1782: the ICE line must print file and line. A door that
    // drops the site (the old `ice(msg)`) makes this red.
    ro j = ice_json("novac/src/emit_c/emit_expr.nv:110", "probe")
    assert(j.contains("at novac/src/emit_c/emit_expr.nv:110 (novac bug"))
    ro q = ice_json("a\"b:1", "probe")
    assert(q.contains("at a\\\"b:1 (novac bug"))
}
