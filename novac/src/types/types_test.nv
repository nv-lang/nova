// SPDX-License-Identifier: MIT OR Apache-2.0
// novac/src/types — tests beside the module. The interner is a pure data
// structure, so its properties are judged directly: identity, substitution,
// concreteness. No oracle, no files, no pipeline.

module novac.types
import ../names.{DeclId}

test "interning: structurally equal terms get ONE id — equality of ids is equality of types" {
    mut it = Interner.new()
    ro int_t = it.prim(0)
    ro vec_decl = DeclId(7)
    ro a = it.app(vec_decl, []TyId.of(int_t))
    ro b = it.app(vec_decl, []TyId.of(int_t))
    assert(a == b)
    assert(it.rows.len() == 2) // int, Vec[int] — the second app did not add a row
}

test "interning: different arguments are different types — Vec[int] is not Vec[str]" {
    mut it = Interner.new()
    ro int_t = it.prim(0)
    ro str_t = it.prim(1)
    ro vec_decl = DeclId(7)
    ro vi = it.app(vec_decl, []TyId.of(int_t))
    ro vs = it.app(vec_decl, []TyId.of(str_t))
    assert(vi != vs)
    assert(it.decl_head_of(vi) == it.decl_head_of(vs)) // same constructor …
    assert(it.arg(vi, 0) != it.arg(vs, 0)) // … different arguments
}

test "interning: nesting is a term, not a name — Vec[Vec[int]] has one argument which is Vec[int]" {
    mut it = Interner.new()
    ro int_t = it.prim(0)
    ro vec_decl = DeclId(7)
    ro vi = it.app(vec_decl, []TyId.of(int_t))
    ro vvi = it.app(vec_decl, []TyId.of(vi))
    assert(it.arg_count(vvi) == 1)
    assert(it.arg(vvi, 0) == vi)
    assert(vvi != vi)
}

test "interning: the empty-argument application is the same door as generics" {
    mut it = Interner.new()
    ro d = DeclId(3)
    ro a = it.app(d, []TyId.new())
    ro b = it.app(d, []TyId.new())
    assert(a == b)
    assert(it.arg_count(a) == 0)
}

test "identity: a record and a sum with the same DeclId are still different types" {
    mut it = Interner.new()
    ro r = it.record(5)
    ro s = it.sum(5)
    assert(r != s)
}

test "subst: Param{i} becomes args[i]; nothing else changes; the result is interned" {
    mut it = Interner.new()
    ro int_t = it.prim(0)
    ro str_t = it.prim(1)
    ro p0 = it.param(0)
    ro p1 = it.param(1)
    ro pair_decl = DeclId(9)
    ro pair_p = it.app(pair_decl, []TyId.of(p0, p1)) // Pair[A, B]
    ro pair_c = it.subst(pair_p, []TyId.of(int_t, str_t)) // Pair[int, str]
    assert(it.arg(pair_c, 0) == int_t)
    assert(it.arg(pair_c, 1) == str_t)
    // interned: substituting again gives the SAME id
    assert(raw_ty(it.subst(pair_p, []TyId.of(int_t, str_t))) == raw_ty(pair_c))
    // a term without Param is returned unchanged, same id
    assert(raw_ty(it.subst(pair_c, []TyId.of(str_t, int_t))) == raw_ty(pair_c))
}

test "subst: nested — Vec[Param0] with [int] is Vec[int], and it is the interned Vec[int]" {
    mut it = Interner.new()
    ro int_t = it.prim(0)
    ro vec_decl = DeclId(7)
    ro p0 = it.param(0)
    ro vp = it.app(vec_decl, []TyId.of(p0))
    ro vi_direct = it.app(vec_decl, []TyId.of(int_t))
    ro vi_subst = it.subst(vp, []TyId.of(int_t))
    assert(vi_subst == vi_direct)
}

test "concreteness: layout's question — Param and Infer are not concrete, and it is deep" {
    mut it = Interner.new()
    ro int_t = it.prim(0)
    ro p0 = it.param(0)
    ro v0 = it.infer(0)
    ro vec_decl = DeclId(7)
    assert(it.is_concrete(int_t))
    assert(!it.is_concrete(p0))
    assert(!it.is_concrete(v0))
    assert(it.is_concrete(it.app(vec_decl, []TyId.of(int_t))))
    assert(!it.is_concrete(it.app(vec_decl, []TyId.of(p0))))
    // deep: Vec[Vec[Param0]]
    ro vp = it.app(vec_decl, []TyId.of(p0))
    assert(!it.is_concrete(it.app(vec_decl, []TyId.of(vp))))
}

test "chains: many applications of one head stay distinct and findable" {
    mut it = Interner.new()
    ro vec_decl = DeclId(7)
    mut ids = []TyId.new()
    for i in 0..6 {
        ro pi = it.prim(i)
        ids.push(it.app(vec_decl, []TyId.of(pi)))
    }
    // all distinct
    for a in 0..6 {
        for b in a + 1..6 {
            assert(ids[a] != ids[b])
        }
    }
    // and each is found again, not re-created
    ro before = it.rows.len()
    assert(it.app(vec_decl, []TyId.of(it.prim(3))) == ids[3])
    assert(it.rows.len() == before)
}
