module arm_if_stmt.pos_1

// An `if` written as an EXPRESSION in statement position -- the arm of a match
// nobody asks for a value, `None => if c {..} else {..}` -- is a branch like
// the `if` statement: one node shape, one lowering. Until 2026-10-06 it reached
// the printer as a value and died as "expression kind outside the subset"
// (task #23: check/calls.nv's arm stopped whole-program emission of novac so).
// The chain nests `if` in `if`; a construction in a chained condition braces
// the `else` the way a statement's chain does (registry 1780).
type Tally { a int, b int }

fn count(xs []int) -> int => xs.len()

fn Tally mut @hit_a(n int) -> () {
    @a += n
}

fn Tally mut @hit_b(n int) -> () {
    @b += n
}

fn Tally mut @judge(o Option[int], c int) -> () {
    match o {
        Some(x) => @hit_a(x)
        None => if c == 0 {
            @hit_b(1)
        } else if count([]int.of(c, c)) == 2 && c > 5 {
            @hit_b(10)
        } else {
            @hit_b(100)
        }
    }
    return
}

fn main() {
    mut t = Tally { a: 0, b: 0 }
    t.judge(Some(3), 0)
    t.judge(None, 0)
    t.judge(None, 9)
    t.judge(None, 2)
    println(t.a)
    println(t.b)
}
