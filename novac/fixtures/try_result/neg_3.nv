module try_result.neg_3

// ONE seeded cause: `?` over a `Result[int, RangeError]` in a fn returning a
// `Result[int, AppError]`, where `AppError` has exactly one variant over `RangeError`.
// LEGAL Nova -- D85: `E'` is "the same type or a supertype through sum extension", and
// D55's sum-coercion wraps the error into `AppError.Range(e)` (the oracle compiles and
// runs this form right: `ok 6`, then `range`, measured 2026-10-06). novac does not
// build the wrap: refused by name as outside the SUBSET, not as the language's error
// (contrast neg_1, where no variant takes the error).
// NOVAC_EXPECT wrapping the error on the way out is not compiled yet

type AppError enum
    | Range(RangeError)
    | Other(str)

fn narrow(n int) -> Result[int, RangeError] {
    if n > 1000 {
        return Err(RangeError.AboveMax)
    }
    Ok(n)
}

fn lift(n int) -> Result[int, AppError] {
    ro v = narrow(n)?
    Ok(v + 1)
}

fn main() {
    match lift(5) {
        Ok(v) => println("ok ${v}")
        Err(AppError.Range(_)) => println("range")
        Err(AppError.Other(s)) => println("other ${s}")
    }
}
