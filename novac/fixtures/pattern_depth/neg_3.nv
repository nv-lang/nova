module pattern_depth.neg_3

// A payload-less variant is a VARIANT pattern: refutable in a `for` header like
// `A(x)` (D486 s4, registry 1379). `for B in xs` passed in silence.

// NOVAC_EXPECT a `for` header takes an irrefutable pattern

type Sh enum
    | A(int)
    | B

fn count(xs []Sh) -> int {
    mut n = 0
    for B in xs {
        n += 1
    }
    n
}

fn main() {
    println(1)
}
