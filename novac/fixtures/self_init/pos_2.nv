module self_init.pos_2

// D347 R3: the initializer of a same-scope rebind reads the OLD binding, so the
// inner `x` starts from 7 and the answer is 8 then 7. The oracle reads its own
// zeroed namesake and panics (registry 221.1 No.2018); the answer is compared
// against the oracle's accepted twin (twin/pos_2.nv, D476).
fn main() -> () {
    ro x = 7
    if x > 0 {
        ro x = x + 1
        assert(x == 8)
        println(x)
    }
    assert(x == 7)
    println(x)
}

// NOVAC_TWIN twin/pos_2.nv
