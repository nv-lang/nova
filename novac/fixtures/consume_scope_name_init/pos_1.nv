module consume_scope_name_init.pos_1

// The D188 scope block with a NAME initializer: `consume f = b { BODY }`.
// The brace after a value name is the scope body, never a record
// constructor -- the oracle's looks_like_record_lit discipline (verified:
// the oracle accepts both this and the ctor-headed `Box { n: 7 } { .. }`).
// Until the 134-hunt fix the initializer read through plain `@expr()`, which
// glued `b {` into a record constructor before the scope door saw the
// brace (finding consume-scope-init-glue); the ctor-headed sibling form
// stays pinned by consume_scope_block/pos_1.nv.
// The carrier is a PLAIN value: with a must-consume `Flag` the rebind
// `consume f = file` double-settles in the oracle's codegen (the Plan 217
// disarm covers only the `consume X { }` re-consume form, so the outer
// armed binding fires @cleanup a second time at scope exit --
// D188-on-exit-double-invocation; registry 221.1 #1942), while novac
// settles once; and a parameter carrier is outside novac's subset
// (274.7 B13 refuses a must-consume move out of a view there). The
// plain carrier keeps the same parse door with identical run behaviour
// on both compilers (measured 2026-10-31: both print "7\nafter", rc=0).
type Box { n int }

fn main() {
    ro b = Box { n: 7 }
    consume f = b {
        println(f.n)
    }
    println("after")
}
