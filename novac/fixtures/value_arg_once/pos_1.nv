module value_arg_once.pos_1

// A VALUE FORM AS AN ARGUMENT RUNS ONCE (registry 1680, D484): `match`/`if` beside
// other calling arguments -- in a binding, a statement, a method argument. Until
// sweep 11 the argument was laid down twice (`1 2 3 2`). Hunt probe order-init-match.

// D484: arguments left to right, observably -- the call stands as a binding
// initializer (the `@lower_place` door), a statement (`@lower_eval`), and a
// method argument; the `match` argument calls something in its scrutinee or arm.
fn say(n int) -> int {
    println(n)
    n
}

fn three(a int, b int, c int) -> int => a * 100 + b * 10 + c

fn sink(a int, b int, c int) -> () {
    println(a * 100 + b * 10 + c)
}

type Box { n int }

fn Box @add3(a int, b int, c int) -> int => @n + a * 100 + b * 10 + c

fn main() {
    println("init, scrutinee calls: norm 1 2 3 then 123")
    ro r = three(say(1), match say(2) {
        2 => 2
        _ => 0
    }, say(3))
    println(r)
    println("init, arm calls: norm 4 5 6 then 456")
    ro r2 = three(say(4), match r {
        123 => say(5)
        _ => 0
    }, say(6))
    println(r2)
    println("statement: norm 7 8 9 then 789")
    sink(say(7), match say(8) {
        8 => 8
        _ => 0
    }, say(9))
    println("method arg in init: norm 1 2 3 then 123")
    ro b = Box { n: 0 }
    ro r3 = b.add3(say(1), match say(2) {
        2 => 2
        _ => 0
    }, say(3))
    println(r3)
    println("if control in init: norm 4 5 6 then 456")
    ro r4 = three(say(4), if say(5) > 0 { 5 } else { 0 }, say(6))
    println(r4)
}
