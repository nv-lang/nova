module value_arg_once.pos_3

// A value form as a `match` SCRUTINEE runs once (registry 1680: the scrutinee was taken
// for an argument and laid down twice). Hunt probe double-eval-scrutinee-element.

// "A value form laid down twice" without a call around it: the form stands
// as the SCRUTINEE of a `match` or as an ELEMENT of an array literal. One
// `say` per form, so each number must print exactly once. The `match`
// scrutinee is the sweep-9 form (its fixture's scrutinee calls nothing, so
// the second evaluation is invisible there); `if` and `??` are the same
// property in other syntaxes.
fn say(n int) -> int {
    println(n)
    n
}

fn sayo(n int) -> Option[int] {
    println(n)
    Some(n)
}

fn main() {
    println("match scrutinee is a match: 1 once, then 10")
    ro r1 = match match say(1) {
        1 => 1
        _ => 2
    } {
        1 => 10
        _ => 0
    }
    println(r1)
    println("match scrutinee is an if: 2 once, then 20")
    ro r2 = match if say(2) > 0 { 1 } else { 2 } {
        1 => 20
        _ => 0
    }
    println(r2)
    println("match scrutinee is a coalesce: 3 once, then 30")
    ro r3 = match sayo(3) ?? 0 {
        3 => 30
        _ => 0
    }
    println(r3)
    println("statement match on a match: 4 once, then 40")
    match match say(4) {
        4 => 1
        _ => 2
    } {
        1 => println(40)
        _ => println(0)
    }
    println("array element is a match, alone: 5 once, then 5")
    ro xs = [match say(5) {
        5 => 5
        _ => 0
    }]
    println(xs[0])
    println("array element is an if, alone: 6 once, then 6")
    ro ys = [if say(6) > 0 { 6 } else { 0 }]
    println(ys[0])
}
