module cast_numeric.neg_7

// ONE seeded cause: a char LITERAL whose codepoint the target cannot hold.
// D54 amendment 2026-10-01 (the owner's decision): a char literal goes into
// any integer IF it fits -- U+0100 is 256, past `u8` -- and otherwise it is
// E_LIT_OUT_OF_RANGE, not the low bits (until then novac and the oracle both
// printed 0 here). A `bool as u8` lived in this file before the same
// amendment made it legal; it is a cell of pos_1 now.
// NOVAC_EXPECT this char literal does not fit `u8`
fn main() {
    println('Ā' as u8)
}
