module vec_new.neg_1

// `[]T.new()` of the program's OWN record type (registry 221.1 #1457). The
// FORM is accepted -- the checker no longer calls it "not the literal form" --
// and the refusal that stays is the SHELL's: novac links its programs into a
// prebuilt shell, and the shell carries no `Vec` instance for a type it has
// never seen. That refusal names the shell and the type, because the fix is
// not in the program (the interop surface is novac/probe/shell_probe.nv).

// NOVAC_EXPECT carries no `Vec` instance for Item

type Item {
    w int
}

fn main() {
    ro xs = []Item.new()
}
