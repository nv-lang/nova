module must_consume.pos_19

// `?` LEAVES THE FUNCTION ON ITS EMPTY PATH (D85: `return None`), and an affine
// value owned there is cleaned before it leaves (D432) -- after the `?`'s operand is
// computed, innermost binding first; on the path with a value the walk goes on. A
// value moved on some paths only before the `?` is cleaned behind its drop flag
// (s5). Behaviour byte-for-byte with the oracle (novac-e1-smoke).

type Lk consume {
    id int
}

fn Lk consume @release() -> () {
    println("release ${@id}")
}

fn Lk consume @cleanup(outcome ScopeOutcome) -> () {
    println("cleanup ${@id}")
}

fn get(n int) -> Option[int] => if n > 0 { Some(n) } else { None }

fn one(n int) -> Option[int] {
    consume a = Lk { id: n }
    consume b = Lk { id: n + 100 }
    ro v = get(n)?
    println("got ${v}")
    Some(v)
}

fn flagged(n int, k int) -> Option[int] {
    consume a = Lk { id: k }
    if k > 5 {
        a.release()
    }
    ro v = get(n)?
    Some(v + k)
}

fn looped(n int) -> Option[int] {
    for k in 0..2 {
        consume a = Lk { id: 40 + k }
        ro v = get(n - k)?
        println("pass ${v}")
    }
    Some(0)
}

fn main() {
    println(one(1) ?? 0)
    println(one(-1) ?? 0)
    println(flagged(1, 3) ?? 0)
    println(flagged(-1, 3) ?? 0)
    println(flagged(-1, 7) ?? 0)
    println(looped(1) ?? 9)
}
