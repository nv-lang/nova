module must_consume.neg_13

// LEFT EARLY FROM AN ARM: legal Nova (the `return` path consumed `t` first),
// and the oracle compiles it. Step 2 joins the arms' states and does not yet
// take an arm that LEAVES out of the join (the early-exit step), so the `return`
// is refused BY NAME with its stage -- never joined wrongly.

// NOVAC_EXPECT left early by a `return` while it is still owned is not tracked yet

type Tx consume {
    id int
}

fn Tx consume @commit() -> () {
    println(@id)
}

fn Tx consume @rollback() -> () {
    println(0)
}

fn Tx @peek() -> int => @id

fn run(n int) -> () {
    consume t = Tx { id: n }
    if n > 0 {
        t.commit()
        return
    }
    t.rollback()
}

fn main() {
    run(1)
}
