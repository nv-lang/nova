module must_consume.pos_22

// AN AFFINE VALUE MOVED ON THE RIGHT OF `??` (D432 s5, registry 221.1 #1716): the
// fallback runs only when the left side is `None`, so the value is released on that
// path only and its `@cleanup` runs behind the drop flag where the left side was
// `Some`. novac walked the right side as an ordinary operand, counted the value moved
// on every path and never cleaned it. Behaviour byte-for-byte with the oracle.

type Lk consume {
    id int
}

fn Lk consume @cleanup(outcome ScopeOutcome) -> () {
    println("cleanup ${@id}")
}

fn Lk consume @release() -> () {
    println("release ${@id}")
}

fn eat(consume t Lk) -> int {
    t.release()
    0
}

fn mk(n int) -> Option[int] {
    if n > 1 { Some(n) } else { None }
}

fn run(n int) -> () {
    consume t = Lk { id: n }
    ro v = mk(n) ?? eat(t)
    println(v)
}

fn main() {
    run(1)
    run(2)
}
