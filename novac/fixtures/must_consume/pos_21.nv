module must_consume.pos_21

// THE TWIN OF pos_20: the private function declares the effect its auto-cleanup
// carries, as the oracle demands -- the same output. Byte-for-byte with the oracle
// (novac-e1-smoke).

type Lk consume {
    id int
}

fn Lk consume @release() -> () {
    println("release ${@id}")
}

fn Lk consume @cleanup(outcome ScopeOutcome) Io -> () {
    println("cleanup ${@id}")
}

export fn declared() Io -> () {
    consume a = Lk { id: 1 }
    println("declared")
}

fn inferred(n int) Io -> () {
    consume a = Lk { id: n }
    if n > 2 {
        a.release()
    }
    println("inferred ${n}")
}

fn main() Io {
    declared()
    inferred(2)
    inferred(3)
}
