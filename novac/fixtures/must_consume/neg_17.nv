module must_consume.neg_17

// A PASS'S OWN VALUE NOT CONSUMED BY THE END OF THE BODY (D133-not-consumed: the
// body is its scope). The oracle refuses it too.

// NOVAC_EXPECT is not consumed before the end of its scope

type Tx consume {
    id int
}

fn Tx consume @commit() -> () {
    println("commit ${@id}")
}

fn Tx consume @rollback() -> () {
    println("rollback ${@id}")
}

fn Tx @peek() -> int => @id

fn main() {
    for k in 0..2 {
        consume t = Tx { id: k }
        println(t.peek())
    }
}
