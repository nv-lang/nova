module must_consume.neg_36

// AN EXPORTED FUNCTION THAT LEAVES UNDECLARED AN EFFECT ITS AUTO-CLEANUP CARRIES:
// the call is generated in its body, so the effects are its own, direct (D432 s1
// amendment 2026-08-04, point 1), and an exported function declares its effects
// itself (point 3, D28/D62). The oracle refuses it as well
// (E_D432_CLEANUP_EFFECT_NOT_DECLARED).

// NOVAC_EXPECT and its `@cleanup` carries the effect `Io`, which this exported function does not declare

type Lk consume {
    id int
}

fn Lk consume @release() -> () {
    println("release ${@id}")
}

fn Lk consume @cleanup(outcome ScopeOutcome) Io -> () {
    println("cleanup ${@id}")
}

export fn opened() -> () {
    consume a = Lk { id: 1 }
    println("body")
}

fn main() Io {
    opened()
}
