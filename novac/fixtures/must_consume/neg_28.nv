module must_consume.neg_28

// USED AFTER IT WENT INTO A RECORD (D131): the pun `{ t }` moves `t` into the
// `consume` field (D133 amendment 2026-07-13). The oracle refuses it too.

// NOVAC_EXPECT `t` is used after it was consumed

type Tx consume {
    id int
}

fn Tx consume @commit() -> () {
    println("commit ${@id}")
}

fn Tx consume @rollback() -> () {
    println("rollback ${@id}")
}

fn Tx @peek() -> int => @id

type Box consume {
    consume t Tx
}

fn Box consume @close() -> () {
    println(0)
}

fn main() {
    consume t = Tx { id: 1 }
    consume b = Box { t }
    t.commit()
    b.close()
}
