module must_consume.neg_6

// CONSUMED INSIDE A LOOP: the body may run more than once, so the second pass
// would use a consumed value -- the oracle refuses it (D131 "possibly
// consumed"). Steps 1-2 of the track walk a loop with the depth raised and do
// not follow a move out of it (whether a `break` follows is the early-exit
// step), so it is refused BY NAME with its stage -- never accepted unchecked.
// (Until step 2 this fixture held a consume inside an `if`, which step 2 joins:
// that form now lives in pos_3.)

// NOVAC_EXPECT consumed inside a loop or a nested block is not tracked yet

type Tx consume {
    id int
}

fn Tx consume @commit() -> () {
    println(@id)
}

fn Tx consume @rollback() -> () {
    println(0)
}

fn Tx @peek() -> int => @id

fn main() {
    consume t = Tx { id: 1 }
    for i in 0..2 {
        println(i)
        t.commit()
    }
}
