module must_consume.neg_6

// CONSUMED INSIDE A LOOP (D131, "possibly consumed"): the body may run more than
// once, and its second pass starts from the join of the loop's entry and the
// first pass's end -- `t` is then neither owned nor gone. The oracle refuses it
// too. (Until step 3 this was a dated subset refusal; before step 2 it held a
// consume inside an `if`, which now lives in pos_3.)

// NOVAC_EXPECT is used after it was possibly consumed

type Tx consume {
    id int
}

fn Tx consume @commit() -> () {
    println("commit ${@id}")
}

fn Tx consume @rollback() -> () {
    println("rollback ${@id}")
}

fn Tx @peek() -> int => @id

fn main() {
    consume t = Tx { id: 1 }
    for i in 0..2 {
        println(i)
        t.commit()
    }
}
