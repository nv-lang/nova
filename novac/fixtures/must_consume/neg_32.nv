module must_consume.neg_32

// A `while`-let PASS'S VALUE NEVER CONSUMED (D133-not-consumed): each pass binds a
// fresh owned value (D432 s2 form 2). The oracle refuses it too.

// NOVAC_EXPECT `t` (type `Tx`) is not consumed before the end of its scope

type Tx consume {
    id int
}

fn Tx consume @commit() -> () {
    println("commit ${@id}")
}

fn Tx consume @rollback() -> () {
    println("rollback ${@id}")
}

fn Tx @peek() -> int => @id

fn next(i int) -> Option[Tx] => if i < 3 { Some(Tx { id: i }) } else { None }

fn main() {
    mut i = 0
    while Some(consume t) = next(i) {
        println(t.peek())
        i += 1
    }
}
