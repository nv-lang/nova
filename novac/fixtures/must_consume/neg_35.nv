module must_consume.neg_35

// AN AFFINE VALUE CONSUMED ON ONE PATH ONLY: legal Nova -- the oracle cleans the
// other path behind a runtime drop flag (D432 s5) -- and the oracle compiles it.
// novac places only unconditional calls, so the form is refused BY NAME with its
// stage -- never cleaned twice or not at all.

// NOVAC_EXPECT consumed on only some paths before its `@cleanup` would run (the drop flag, D432 s5)

type Lk consume {
    id int
}

fn Lk consume @release() -> () {
    println("release ${@id}")
}

fn Lk consume @cleanup(outcome ScopeOutcome) -> () {
    println("cleanup ${@id}")
}

fn run(n int) -> () {
    consume a = Lk { id: n }
    if n > 0 {
        a.release()
    }
    println("end")
}

fn main() {
    run(1)
}
