module default_named.pos_1

// DEFAULT VALUES AND NAMED ARGUMENTS (E2-b3 wave 4, D102). Four shapes in one
// file, because the wave's whole point is that they are one mechanism:
//   * a defaulted parameter OMITTED, and filled at the call site;
//   * the same parameter passed BY NAME, overriding the default;
//   * two named arguments written in the OTHER order than declared (D102
//     call-rule 4 makes them permutable, and the emission must still put each
//     value in its own slot);
//   * the same on a METHOD, whose receiver is parameter zero (plan 273) and
//     therefore slot zero of the same binding.
//
// THE WEIGHTS ARE THE POINT, not decoration. `port * 10 + mark` makes a swapped
// binding print a different number: `connect(1, mark: 3, port: 80)` is 804 when
// each value lands in its own slot and 111 when the two are exchanged. A fixture
// adding its arguments would have passed with the slots shuffled -- the
// weak-fixture class (registry #465) applied to this wave.
type Counter { n int }

fn Counter mut @bump(by int = 1) -> () {
    @n = @n + by
}

fn connect(host int, port int = 8080, mark int = 7) -> int => host + port * 10 + mark

fn main() {
    println(connect(1))
    println(connect(1, port: 900))
    println(connect(1, mark: 3, port: 80))
    mut c = Counter { n: 0 }
    c.bump()
    c.bump(by: 5)
    println(c.n)
}
