module consume_diverging_call.pos_4

// THE TWIN OF pos_2 (registry 221.1 #1762): the same program with `b` consumed on BOTH
// arms of the `if`, so the oracle -- which joins an arm that never comes out as if it did
// (its part of #1762, plan 274.10) -- compiles it. The smoke compares pos_2's run against
// this one byte for byte; novac accepts both.

fn boom(msg str) -> never {
    println(msg)
    boom(msg)
}

fn work(n int) -> str {
    consume b = StringBuilder.new(cap: 8)
    if n < 0 {
        println(b.into_str())
        boom("negative")
        "not reached"
    } else {
        b.into_str()
    }
}

fn main() {
    println("[${work(3)}]")
}
