module consume_diverging_call.pos_5

// THE TWIN OF pos_3 (registry 221.1 #1762): the same program with the empty path written
// as a `match` arm that consumes `b`, so the oracle -- which joins the right side of `??`
// as if it came out (its part of #1762, plan 274.10) -- compiles it. The smoke compares
// pos_3's run against this one byte for byte; novac accepts both.

fn give_up(consume b StringBuilder) -> never {
    println(b.into_str())
    give_up(StringBuilder.new(cap: 1))
}

fn get(n int) -> Option[int] => if n > 0 { Some(n) } else { None }

fn work(n int) -> str {
    consume b = StringBuilder.new(cap: 8)
    match get(n) {
        Some(v) => "${v}${b.into_str()}"
        None => {
            give_up(b)
            "not reached"
        }
    }
}

fn main() {
    println(work(5))
}
