module numeric_positions.neg_2

// ONE seeded cause (registry 1609, D491): a numeric value standing in
// an argument, of another numeric type. A number never changes its type
// implicitly; the refusal carries the oracle's code.
// NOVAC_EXPECT as this argument -- a number never changes its type implicitly, widening or narrowing alike (D491, E_IMPLICIT_NARROWING)
fn take(v int) -> int => v

fn main() {
    ro x = 7 as u32
    println(take(x))
}
