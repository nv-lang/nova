module numeric_positions.neg_6

// ONE seeded cause (registry 1609, D491): a numeric value standing in
// the operands of an operator, of another numeric type. A number never changes its type
// implicitly; the refusal carries the oracle's code.
// NOVAC_EXPECT (D405, D491, E_MIXED_WIDTH_ARITH)
fn main() {
    ro x = 7 as u32
    ro y = 5
    println(x + y)
}
