// Registry 984, the class measure: a REFUSED call in this reader position.
// The walk refuses the name once; every later reader of that node must find
// a decision or keep silent -- ONE diagnostic, never an internal error.
// Judged by check-novac-fixture-expect.sh (the first diagnostic) and
// check-novac-no-cascade.sh (exactly one error diagnostic).
// EXPECT_COMPILE_ERROR
// NOVAC_EXPECT no such method in the declarations handed to novac
module refused_call_positions.p04_method_recv

type Pt value { x int, y int }

fn take(i int) -> int => i
fn take2(a int, b int) -> int => a + b
fn apply(f fn(int) -> int, x int) -> int => f(x)
fn mk() -> Pt => { x: 1, y: 2 }

fn main() {
    ro x = PRO.method()
    println(x)
}
