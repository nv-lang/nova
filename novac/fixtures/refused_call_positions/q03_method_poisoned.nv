// Registry 984, the row's own carrier: `refused_call()` WITH the parentheses,
// read in this position. The walk refuses the name once; every later reader of
// that node must find a decision or keep silent -- ONE diagnostic, never an
// internal error. Judged by check-novac-fixture-expect.sh (the pinned
// diagnostic text) and check-novac-no-cascade.sh (exactly one error
// diagnostic); both glob this directory alongside neg_*.
// EXPECT_COMPILE_ERROR
// NOVAC_EXPECT outside the subset: no such method in the declarations handed to novac
module refused_call_positions.q03_method_poisoned

type Pt value { x int, y int }

fn take(i int) -> int => i
fn apply(f fn(int) -> int, x int) -> int => f(x)
fn mk_arr() -> []int => []int.of(1, 2)

fn main() {
    ro r = refused_call()
    ro x = r.method()
    println(x)
}
