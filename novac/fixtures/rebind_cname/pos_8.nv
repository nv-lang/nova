module rebind_cname.pos_8

// The handler's fresh `err` binding and the captured `base` keep distinct C
// names; the failure a child carries is a non-empty message. The oracle hands
// `on_child_fail` an EMPTY payload for the same child (registry 221.1 No.2019),
// so the answer is compared against the oracle's accepted twin (twin/pos_8.nv,
// D476) -- the twin keeps the handler shape and drops the payload reading.
fn main() -> () {
    ro base = 40
    with Supervisor = effect Supervisor {
        on_child_fail(idx, err) -> Decision {
            while err is str {
                assert(err.byte_len() > 0)
                println("caught")
                break
            }
            Decision.Stop
        }
    } {
        supervised { spawn { println(base / (base - 40)) } }
    }
    println("after")
}

// NOVAC_TWIN twin/pos_8.nv
