module cleanup_try_outcome.pos_2

// THE OTHER TAG TEST of a handed sum: `is` on the `ScopeOutcome` an auto-cleanup is
// handed, the shell's tag (`NOVA_TAG_ScopeOutcome_*`), not novac's -- pos_1 is the
// `match`. In a condition, negated, and as a value. Behaviour byte-for-byte with the
// oracle (novac-e1-smoke).

type Lk consume {
    id int
}

fn Lk consume @cleanup(outcome ScopeOutcome) -> () {
    if outcome is Success {
        println("cleanup ${@id}: success")
    }
    if !(outcome is Panic) {
        println("cleanup ${@id}: no panic")
    }
    ro failed = outcome is Failure
    println("cleanup ${@id}: failed ${failed}")
}

fn get(n int) -> Option[int] => if n > 0 { Some(n) } else { None }

fn one(n int) -> Option[int] {
    consume a = Lk { id: n }
    ro v = get(n)?
    Some(v)
}

fn main() {
    println(one(5) ?? 0)
    println(one(-5) ?? 0)
}
