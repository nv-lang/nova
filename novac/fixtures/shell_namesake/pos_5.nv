// A FILE WITH NO MODULE LINE declaring shell namesakes (wave 274.5 pre68): a
// heap record `DirEntry` (the shell's `struct Nova_DirEntry`) and a sum
// `ErrorKind` (the shell's `struct Nova_ErrorKind`). D381's base is
// `Nova_<modpath>_<Name>`; with an EMPTY modpath the oracle collapses it to the
// bare name -- which in novac's unit IS the shell's struct. novac keeps D381's
// formula as written, `Nova__DirEntry`: a type name never starts with `_`
// (D30), so the doubled separator meets no bare name.
//
// The oracle has neither std type in its unit here and compiles the bare
// names; the same lines from both compilers.
type DirEntry {
    path str
    size int
}

type ErrorKind
    | Missing(str)
    | TooBig(int)

fn check(e DirEntry) -> Option[ErrorKind] {
    if e.path == "" { return Some(Missing("no path")) }
    if e.size > 100 { return Some(TooBig(e.size)) }
    None
}

fn report(e DirEntry) -> str => match check(e) {
    None => "ok ${e.path}"
    Some(Missing(why)) => "missing: ${why}"
    Some(TooBig(n)) => "too big: ${n}"
}

fn main() {
    println(report(DirEntry { path: "a.txt", size: 10 }))
    println(report(DirEntry { path: "", size: 1 }))
    println(report(DirEntry { path: "b.bin", size: 500 }))
}
