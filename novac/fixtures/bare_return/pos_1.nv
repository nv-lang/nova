module bare_return.pos_1

// A bare `return` in a body that returns no value (`-> ()`, or main with none
// declared): the ordinary early exit -- from an `if`, from inside a loop, from
// main. novac refused every one as "`return` must carry a value" until
// 2026-09-26 (195 of its own). Behaviour byte for byte with the oracle.

fn show(n int) -> () {
    if n < 0 {
        return
    }
    println(n)
}

fn loop_until(n int) -> () {
    mut i = 0
    while true {
        if i >= n {
            return
        }
        println(i)
        i += 1
    }
}

fn main() {
    show(0 - 1)
    show(5)
    loop_until(3)
    if true {
        return
    }
    println(99)
}
