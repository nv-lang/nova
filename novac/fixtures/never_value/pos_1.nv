module never_value.pos_1

// A CALL OF A `-> never` FUNCTION IN A VALUE POSITION (D26: `never` is the
// bottom type, compatible with every type; 274.11 B10 part 3).
//
// WHY, measured 2026-10-01 on the 0.2 measure: 20 refusals "`ice` is not a
// callable novac knows in an expression" across novac's own source -- `?? ice(..)`,
// `ice(..)` as a tail, `ice(..)` as a match arm. The callee was not missing:
// `never` was not a type of novac's universe, so the handed signature
// `fn ice(msg str) -> never` was dropped whole and the name had no row.
//
// The cells: the statement form (worked before), the right side of `??`, the
// tail of a function returning a value, an arm of a value `match` beside arms
// that have values, and a branch of an `if` in value position. None of the
// diverging paths is taken at run time -- the output is the values.

// The body never returns: its tail is a `never` call itself. `panic` is not a
// callable of novac's single-file check yet (the prelude's `extern "nova" fn
// panic` has no row -- a separate gap), and a `while true` body the oracle does
// not build (its C assigns the loop to the `nova_int` result). The fixture is
// about the CALLER's side; no cell calls `boom` at run time.
fn boom(msg str) -> never {
    println(msg)
    boom(msg)
}

fn stmt_form(n int) -> int {
    if n < 0 {
        boom("negative")
    }
    n
}

fn coalesce_form(o Option[int]) -> int {
    ro v = o ?? boom("none")
    v
}

fn tail_form(n int) -> int {
    if n > 0 {
        return n
    }
    boom("not positive")
}

fn arm_form(n int) -> int {
    match n {
        0 => boom("zero")
        _ => n * 10
    }
}

fn first_arm_form(n int) -> int {
    match n {
        0 => boom("zero")
        1 => 100
        _ => n
    }
}

fn if_form(n int) -> int {
    ro v = if n > 0 { n + 1 } else { boom("not positive") }
    v
}

fn main() {
    println("${stmt_form(1)}")
    println("${coalesce_form(Some(2))}")
    println("${tail_form(3)}")
    println("${arm_form(4)}")
    println("${first_arm_form(1)}")
    println("${if_form(5)}")
}
