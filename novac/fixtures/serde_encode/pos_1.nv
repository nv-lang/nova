module serde_encode.pos_1

// THE DERIVED `@serialize` IS CALLED (D341/D345), and its output is std's JSON
// byte for byte: `json_encode` drives the method `#impl(Serialize)` synthesized
// through `JsonSerializer`. A record of every scalar kind (a narrow and an
// unsigned integer widen, a string escapes), a nested record, an `Option` both
// ways, a sum in all four externally tagged forms (unit -> bare string, single
// -> `{"V":x}`, tuple -> `{"V":[..]}`, record -> `{"V":{..}}`) and a vector of
// that sum, empty and full (E2-b3 steps 5-6, plan 274.5 3-pred64).
import std.encoding.serde.{Serialize, json_encode}

#impl(Serialize)
type Span {
    file str
    start int
    narrow i32
    wide u64
    ratio f64
    ok bool
}

#impl(Serialize)
type Shape enum
    | Dot
    | Circle(int)
    | Seg(int, int)
    | Rect { w int, h int }

#impl(Serialize)
type Dto {
    span Span
    shape Shape
    note Option[str]
    shapes []Shape
}

fn main() {
    ro sp = Span { file: "a\"b.nv", start: 3, narrow: -7, wide: 9, ratio: 0.5, ok: true }
    ro rect = Shape.Rect { w: 3, h: 4 }
    ro shapes = []Shape.of(Shape.Dot, Shape.Circle(5), Shape.Seg(1, 2), rect)
    ro d = Dto { span: sp, shape: Shape.Seg(1, 2), note: None, shapes }
    println(json_encode(d) ?? "fail")
    ro d2 = Dto { span: sp, shape: Shape.Dot, note: Some("n"), shapes: []Shape.new() }
    println(json_encode(d2) ?? "fail")
    ro rect2 = Shape.Rect { w: 0, h: -1 }
    println(json_encode(rect2) ?? "fail")
    println(json_encode(Shape.Circle(8)) ?? "fail")
}
