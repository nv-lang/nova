module tail_if_nested.pos_1

// A BRANCH OF A VALUE `if` WHOSE TAIL IS ANOTHER `if` (D49 rule 5, D34 rule 6):
// a nested `if` / `if let` as a branch's last expression, and an `else if`
// chain, each a value of its own. novac refused all three -- "a branch of a
// tail `if` ends without a value", "an `else if` chain is not compiled as a
// value yet" -- on lower/lower_match.nv:410, sem/sem.nv:493 and
// sem/mangle.nv:479 of its own source; the lowering laid a nested `if` down as
// a STATEMENT, so the result would have kept its zero.
//
// The axes: nested in the then branch and in the else branch, an `else if`
// chain of three, an `if let` whose branch ends in an `if`, an `if` whose
// branch ends in an `if let`, a `str` value, a binding initializer, a branch
// that leaves through `return` beside one that stays, and a chain inside a
// nested branch, and an `else if Some(..) = ..` link. Behaviour byte-for-byte
// with the oracle (novac-e1-smoke).

fn pick(a bool, b bool) -> int {
    if a {
        if b { 1 } else { 2 }
    } else {
        if b { 3 } else { 4 }
    }
}

fn grade(n int) -> str {
    if n >= 90 {
        "a"
    } else if n >= 80 {
        "b"
    } else if n >= 70 {
        "c"
    } else {
        "f"
    }
}

fn sign_of(o Option[int]) -> int {
    if Some(v) = o {
        if v > 0 { 1 } else if v < 0 { -1 } else { 0 }
    } else {
        -9
    }
}

fn first_or(flag bool, o Option[int]) -> int {
    if flag {
        if Some(v) = o { v } else { 100 }
    } else {
        200
    }
}

fn second(a Option[int], b Option[int]) -> int {
    if Some(x) = a {
        x
    } else if Some(y) = b {
        y * 100
    } else {
        -1
    }
}

fn early(n int) -> int {
    if n < 0 {
        return -1
    } else {
        if n == 0 { 0 } else { n * 10 }
    }
}

fn main() {
    println(pick(true, true))
    println(pick(true, false))
    println(pick(false, true))
    println(pick(false, false))
    println(grade(95))
    println(grade(85))
    println(grade(75))
    println(grade(10))
    println(sign_of(Some(5)))
    println(sign_of(Some(-5)))
    println(sign_of(Some(0)))
    println(sign_of(None))
    println(first_or(true, Some(7)))
    println(first_or(true, None))
    println(first_or(false, Some(7)))
    ro w = if pick(true, false) == 2 {
        if grade(85) == "b" { "yes" } else { "no" }
    } else {
        "never"
    }
    println(w)
    // An `else if` chain in a BINDING INITIALIZER (the parser's `IfExpr`), the
    // shape of `vec_op_c` in sem/mangle.nv.
    ro k = if w == "no" {
        1
    } else if w == "yes" {
        2
    } else {
        3
    }
    println(k)
    println(second(Some(2), Some(3)))
    println(second(None, Some(3)))
    println(second(None, None))
    println(early(-3))
    println(early(0))
    println(early(4))
}
