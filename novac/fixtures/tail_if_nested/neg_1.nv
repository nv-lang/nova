module tail_if_nested.neg_1

// A NESTED `if` AS A BRANCH'S VALUE KEEPS THE AGREEMENT RULE: its own branches
// must agree on a type, exactly as a tail `if`'s do. `if b { 1 } else { "s" }`
// has no type, and the outer branch would carry whichever one a compiler
// picked. Its pair, pos_1 beside this file, holds the nested forms that agree.

// NOVAC_EXPECT the branches of a tail `if` must agree on a type

fn pick(a bool, b bool) -> int {
    if a {
        if b { 1 } else { "s" }
    } else {
        3
    }
}

fn main() {
    println(pick(true, true))
}
