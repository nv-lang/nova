module fluent_implicit_self.neg_3

// D409 rule 3 (registry 221.1 #1538): the receiver of a `-> @` body is returned
// automatically, so `=> @` is an explicit self-return -- refused, as the
// oracle refuses it (E_EXPLICIT_SELF_RETURN). One seeded cause.

// NOVAC_EXPECT E_EXPLICIT_SELF_RETURN

type Ctr {
    n int
}

fn Ctr @same() -> @ => @

fn main() {
    mut c = Ctr { n: 5 }
    println(c.same().n)
}
