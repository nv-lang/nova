module value_arg_nested.pos_1

// A value form TWO calls deep (registry 1683): lowered before the seal at any depth.
// Until sweep 11 an ICE. Hunt probe ice-value-arg-two-deep.

// A `match` (and, as the control of the same property, an `if`) as an
// argument of a call that is ITSELF an argument of another call, the outer
// call standing as an initializer. Legal Nova; the oracle prints 3 and 3.
// Pure arms and constant scrutinees: no effect to order. Further carriers of
// the same ICE, one per program (see the report): `println(three(1, match k
// {..}, 1) * 2)`, `ro r = three(1, match k {..}, 1) * 2`,
// `println(id(match k {..}) + 1)`.
fn three(a int, b int, c int) -> int => a + b + c

fn id(x int) -> int => x

fn main() {
    ro k = 2
    ro r1 = id(three(1, match k {
        2 => 1
        _ => 0
    }, 1))
    println(r1)
    ro r2 = id(three(1, if k > 0 { 1 } else { 0 }, 1))
    println(r2)
}
