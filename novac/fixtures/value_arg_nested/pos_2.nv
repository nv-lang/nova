module value_arg_nested.pos_2

// A value form in a constructor field on the right of `=` (registry 1683). Until
// sweep 11 an ICE. Hunt probe ice-ctor-field-in-assign.

// A `match` value as a constructor FIELD (a sweep-9 position) where the
// constructor is the right side of a plain `=` (another sweep-9 position).
// Each position alone compiles; together they reach the emitter unlowered.
// Legal Nova; the oracle prints 5.
type Pv { b int, f f64 }

fn main() {
    ro k = 3
    mut q = Pv { b: 1, f: 1.0 }
    q = Pv { b: match k {
        3 => 5
        _ => 6
    }, f: 1.0 }
    println(q.b)
}
