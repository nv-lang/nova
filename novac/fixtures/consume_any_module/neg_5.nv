module consume_any_module.neg_5

// A FIELD MOVED OUT WHOLE AFTER A FIELD INSIDE IT WAS CONSUMED (registry 221.1
// #1723; D133 "Nested field paths", D131): `@inner.body` is gone, so `@inner` is no
// longer a whole `Pad`, and `@inner.finish()` would consume its body a second time.
// The ORACLE accepts this form (registry 221.1 No.TBD, oracle: one level of paths).

// NOVAC_EXPECT a field inside it, was consumed

type Pad consume {
    n int
    consume body StringBuilder
}

fn Pad consume @finish() -> str => @body.into_str()

type Outer consume {
    consume inner Pad
    k int
}

fn Outer consume @close() -> str {
    ro s = @inner.body.into_str()
    ro t = @inner.finish() // the one refusal: line 24
    "${s}${t}"
}

fn main() {
    consume o = Outer { inner: Pad { n: 0, body: StringBuilder.new(cap: 8) }, k: 1 }
    println(o.close())
}
