module const_typed.neg_3

// ONE seeded cause: a constant whose initializer NARROWS -- a `u16` value
// under `u8`. Refused at the declaration as E_IMPLICIT_NARROWING, the return
// door's words; the oracle refuses it too (its E_IMPLICIT_NARROWING).
// NOVAC_EXPECT a value of type `u16` does not become `u8` as this constant's value (written `u8`) -- a number never changes its type implicitly, widening or narrowing alike (D491, E_IMPLICIT_NARROWING)
const C u8 = (300 as u16)

fn main() {
    println(C)
}
