module const_typed.neg_2

// ONE seeded cause: a constant whose initializer is a VALUE of another type
// than the one it writes -- `u8` under `u16`. D491 (2026-10-02): a number
// never changes its type implicitly, widening included; the oracle refuses it
// too since 1608, with the same code (E_IMPLICIT_NARROWING) -- the pin moved
// from the earlier E7301 sentence with registry 1609.
// NOVAC_EXPECT a value of type `u8` does not become `u16` as this constant's value (written `u16`) -- a number never changes its type implicitly, widening or narrowing alike (D491, E_IMPLICIT_NARROWING)
const C u16 = ('x' as u8)

fn main() {
    println(C)
}
