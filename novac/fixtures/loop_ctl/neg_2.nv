module loop_ctl.neg_2

// `continue` AFTER a loop: the loop's depth is over when its body is, so the
// statement below has no loop around it (274.7 wave B10).

// NOVAC_EXPECT stand only inside the body of a `for` or `while` loop

fn main() {
    for i in 0..3 {
        println(i)
    }
    continue
}
