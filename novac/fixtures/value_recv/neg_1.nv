module value_recv.neg_1

// NOVAC_EXPECT the receiver here is a temporary
// ONE seeded cause: a 32-byte `value` record crosses to its `ro` method by
// POINTER (D488 R5), and the receiver is a call's result -- no place to take
// the address of. novac does not spill it yet; the oracle does, so novac is
// narrower here, the legal direction.
type Lg value {
    a int
    b int
    c int
    d int
}

fn Lg @sum() -> int => @a + @b + @c + @d

fn mk() -> Lg => { a: 1, b: 2, c: 3, d: 4 }

fn main() {
    println(mk().sum())
}
