// shell_probe.nv — the umbrella probe for the novac runtime shell (plan 274,
// E2). COMPILED BY THE ORACLE, never by novac: its emission IS the shell
// template. The probe's main must USE every std surface the novac emitter
// can reference, so the oracle's DCE keeps those functions in the emission;
// scripts/tools/novac-regen-shell.sh then cuts the string literals and the
// main body out and stamps the two novac slots in their place.
//
// Grow this file in the same wave that grows the emitter's subset: an
// emitter form whose runtime helper is missing here dies at link time in
// the smoke — loudly, which is the point.

module probe.shell_probe

import std.encoding.utf16.{is_high_surrogate, is_low_surrogate, decode_surrogate_pair}

fn main() {
    // E1 surface: str literals, int printing, checked arithmetic (all four
    // operators — division and subtraction are DCE-prone: nothing else in
    // the probe would keep them), comparisons, for/if/mut/+=.
    println("probe")
    println("arith = ", 2 + 3 * 4 - 6 / 2)
    mut total = 0
    for i in 0..3 {
        total += i
    }
    if total < 10 {
        println("total = ", total)
    }
    if total <= 3 {
        println("le")
    }

    // E2 strings surface: str binding, str-returning and bool-returning
    // methods, bool printing.
    ro s = "probe string"
    println("len = ", s.byte_len())
    println("upper = ", s.to_ascii_upper())
    println("starts = ", s.starts_with("p"))
    println("contains = ", s.contains("ring"))
    // The if-let wave: its carriers bind through Option-returning calls, and
    // str.find is the E2 face of that shape -- without this line the shell
    // carries no Nova_str_method_find and novac refuses the carrier by name.
    ro found = s.find("ring")
    ro ftext = match found {
        Some(i) => "at"
        None => "no"
    }
    println("find = ", ftext)

    // E2 records surface: the only NEW runtime helper is f64 printing —
    // record structs/alloc are emitted by novac itself into the BODY slot
    // (nova_alloc is already kept alive by the string methods above).
    println("f = ", 1.5)

    // E2 arrays surface (demo.nv): the []int instance is MONOMORPHIZED
    // only when used — literal + spread keep static_new/push, len/get keep
    // their methods, the Option match keeps NovaOpt_nova_int's tag/value.
    ro nums = [1, 2, 3]
    ro ext = [0, ...nums, 4]
    println("len = ", ext.len())
    // A Vec[f64] instance (274.7 B7, #940): a Vec of a NEWTYPE over f64 links as
    // Vec[f64] -- its representation -- so the shell must carry that instance.
    ro reals = [1.5, 2.5]
    println("flen = ", reals.len())
    // `cap()` — ГЕТТЕР, и он здесь не ради красоты: амендмент D239 о вместимости
    // литерала (2026-08-27) сформулирован над НАБЛЮДАЕМЫМ (`[7, 8].cap() == 2`),
    // а оболочка несла только сеттер `cap(n)` (`..._method_cap__nova_int`), потому
    // что геттер никто не звал. Без этой строки правило спеки нечем доказать
    // концом-в-конец: novac отказывал бы по имени, называя эту самую программу.
    println("cap = ", ext.cap())
    ro maybe = ext.get(100)
    ro text = match maybe {
        Some(n) => "some"
        None => "none"
    }
    println("get = ", text)

    // Wave W4 (274.7): novac CONSTRUCTS `Some(x)` / `None` as the shell's
    // compound literals, so every Option instance over a primitive that a
    // carrier may build must exist in the shell -- the typedef is the shell's
    // for primitives and handed types (novac emits it only for the file's own
    // types). Each fn below is USED, or the oracle's DCE drops its instance.
    println("os = ", opt_str(total > 100) ?? "none")
    println("of = ", opt_f64(total > 100) ?? 0.5)
    println("ob = ", opt_bool(total < 100) ?? false)
    // Wave W6 (274.7): FREE functions of a handed std module, called by name --
    // the shell must carry their symbols (`nova_fn_8encoding5utf16...`) or the
    // carrier dies at link time.
    println("hs = ", is_high_surrogate(0xD800))
    println("ls = ", is_low_surrogate(0xDC00))
    println("sp = ", decode_surrogate_pair(0xD83D, 0xDE00))

    // WAVE B1b-3 (274.7): the `@display` of a GENERIC INSTANCE in a slot.
    //
    // WHY THESE LINES ARE HERE AT ALL, since the probe never runs under novac:
    // an instance method reaches novac only through the shell's INTEROP
    // SURFACE (`c_method_symbol` + `Ctx.interop.has`, `check/methods.nv:221`),
    // and the surface is whatever the oracle's DCE kept. Measured 2026-09-18
    // before this edit: the word `display` appeared ZERO times in this file, so
    // the shell carried the method for no instance at all -- and the slot judge
    // would have refused `${Some(1)}` even once taught to look for it, because
    // the symbol is not in the link.
    //
    // THE EXPECTED BYTES COME FROM std's OWN DOC EXAMPLES, not from taste:
    // `protocols.nv:647` asserts `"${None}" == "None"` and
    // `"${Some("hi")}" == "Some(hi)"`; `:668` asserts `"${Ok(1)}" == "Ok(1)"`
    // and `"${Err("oops")}" == "Err(oops)"`; `collections/vec/protocols.nv:192`
    // asserts `"Vec[1, 2, 3]"`. novac has to print the same bytes, so the forms
    // are named here rather than guessed at the checker.
    println("d_none = ${opt_str(false)}")
    println("d_some = ${opt_str(true)}")
    // THE INT INSTANCE, and it is a separate line for a measured reason: the
    // shell carries only the instances this probe CALLS. With `opt_str` alone
    // the shell defined `Nova_Option_method_display_nova_str` and nothing else,
    // so `${Some(1)}` was refused BY NAME -- correctly, and for a reason that
    // belongs to the probe rather than to the compiler (measured 2026-09-18,
    // fixture `display_generic/neg_1.nv` asserted exactly that refusal).
    println("d_int = ${opt_int(true)}")
    println("d_ok = ${res_int(true)}")
    println("d_err = ${res_int(false)}")
    println("d_vec = ${three()}")
}

/// A Result[int, str] instance for the shell (B1b-3): both arms, because the
/// display of a sum is chosen by the TAG and a one-armed probe would keep only
/// half the emission alive.
fn res_int(f bool) -> Result[int, str] {
    if f {
        return Ok(1)
    }
    Err("oops")
}

/// A Vec[int] for the shell (B1b-3). Three elements and not one: the separator
/// between them is part of the form std's own example asserts (`Vec[1, 2, 3]`),
/// and a single-element vector would keep a shape that never prints one.
fn three() -> []int {
    mut v = []int.new()
    v.push(1)
    v.push(2)
    v.push(3)
    v
}

/// An Option[str] instance for the shell (W4).
fn opt_str(f bool) -> Option[str] {
    if f {
        return Some("yes")
    }
    None
}

/// An Option[int] instance for the shell (B1b-3): the one `@display` needs so
/// that `${Some(1)}` stops being refused for want of a symbol.
fn opt_int(f bool) -> Option[int] {
    if f {
        return Some(7)
    }
    None
}

/// An Option[f64] instance for the shell (W4).
fn opt_f64(f bool) -> Option[f64] {
    if f {
        return Some(1.5)
    }
    None
}

/// An Option[bool] instance for the shell (W4).
fn opt_bool(f bool) -> Option[bool] {
    if f {
        return Some(true)
    }
    None
}
