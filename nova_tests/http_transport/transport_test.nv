// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 178 Ф.2 — real_http() handler smoke test. Exercises the client → Http seam
// → real_http path (effect-over-effect: real_http performs Net). The https branch
// returns Err(Tls) BEFORE any socket I/O, so it is deterministic without a server.
// Live plaintext round-trips over a real socket are *_slow.nv (gated on the
// pre-existing net payload-variant codegen gap, Ф.0.5 note e).

module nova_tests.http_transport

import std.http.client.{HttpClient}
import std.http.transport.{real_http}
import std.net.{mock_net}

test "real_http: https is gated on Plan 116 → Err(Tls)" {
    with Net = mock_net() {
        with Http = real_http() {
            match HttpClient.new().get("https://secure.example/x").send() {
                Ok(r)  => { assert(match r.drain() { Ok(_) => true, Err(_) => false }); assert(false) }
                Err(e) => assert(match e.kind { Tls => true, _ => false })
            }
        }
    }
}
