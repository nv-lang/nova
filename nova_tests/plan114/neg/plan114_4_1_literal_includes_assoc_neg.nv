// Plan 114.4.1 (D200) NEG: assoc const в record literal → error.

// EXPECT_COMPILE_ERROR E_CONST_FIELD_IN_LITERAL

module neg.plan114_4_1_literal_includes_assoc_neg

type Config {
    name str
    timeout int
}

// [M-assoc-const-out-of-body-syntax] (окно №66): out-of-body каноническая форма.
const Config.VERSION int = 2

test "literal includes assoc const" {
    ro c = Config { VERSION: 5, name: "x", timeout: 1 }
    assert(c.name == "x")
}
