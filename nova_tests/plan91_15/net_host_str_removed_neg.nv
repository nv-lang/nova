// EXPECT_COMPILE_ERROR E7320
//
// Plan 91.15 P1 / Plan 178 Ф.0.5 — negative: SocketAddr.host_str() was renamed
// to .ip() (D302). The old name no longer resolves: `SocketAddr` has no such
// method, so the checker rejects it (E7320 — no field or method `host_str`).
// Address ops are pure now (AddrNet retracted) — no `with`.

module plan91_15.net_host_str_removed_neg

import std.net.{SocketAddr}

test "host_str is gone" {
    ro a = SocketAddr.loopback(80)
    ro _ = a.host_str()
}
