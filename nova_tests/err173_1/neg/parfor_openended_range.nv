// EXPECT_COMPILE_ERROR open-ended Range without end bound
//
// Plan 173.1 §5 neg: бесконечный итератор (open-ended range `0..`) нельзя
// собрать в `[]T` — неограниченный поток отвергается диагностикой
// (существующая Plan 96 Ф.2 проверка обеих границ Range покрывает
// value-mode `parallel for` тем же путём, что и обычный for-in).
// Обход: `.take(n)` / закрытый диапазон.

module neg.parfor_openended_range

test "parallel for над open-ended range отвергается" {
    ro xs = parallel for i in 0.. {
        i
    }
    assert(xs.len() > 0)
}
