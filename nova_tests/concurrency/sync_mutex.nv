// Plan 18 std.sync: Mutex tests.
//
// Verifies fiber-aware mutual exclusion: lock/unlock/try_lock.
// Mutual-exclusion test tracks `inside` — incremented under lock, decremented
// before unlock. If ever > 1, two fibers entered the critical section
// simultaneously → violation. This is an observable interleave property,
// not just a final-value check.

module nova_tests.concurrency

// D415 §2 (Plan 173.3): a bare `mut int` captured by reference in a
// `spawn` body is rejected regardless of whether it happens to be
// manually protected by an adjacent `Mutex` elsewhere — Nova's `Mutex` is
// a bare synchronization primitive (lock/unlock only), not a Rust-style
// `Mutex<T>` wrapping its own data, so the checker cannot SEE that
// discipline. `IntCell` is the test author's own audited `#share` vouch
// (same mechanism `Mutex`/`Atomic*` themselves use in std/runtime/
// sync.nv): "every access to `.val` below is wrapped in the file's own
// `m.lock()`/`m.unlock()` — this is safe." Keeps the mutual-exclusion
// tests exercising REAL non-atomic `Mutex`-guarded state (not `Atomic*`,
// which would test a different primitive).
#share
type IntCell {
    mut val int
}
fn IntCell.new(v int) -> IntCell => { val: v }

// ─── Basic API ─────────────────────────────────────────────────

test "Mutex: try_lock on fresh mutex succeeds" {
    mut m = Mutex.new()
    ro ok = m.try_lock()
    assert(ok == true)
    m.unlock()
}

test "Mutex: try_lock while locked returns false" {
    mut m = Mutex.new()
    ro ok1 = m.try_lock()
    assert(ok1 == true)
    ro ok2 = m.try_lock()
    assert(ok2 == false)
    m.unlock()
}

test "Mutex: lock and unlock in single fiber" {
    mut m = Mutex.new()
    mut counter = IntCell.new(0)
    supervised {
        spawn {
            m.lock()
            counter.val = counter.val + 1
            m.unlock()
            m.lock()
            counter.val = counter.val + 1
            m.unlock()
        }
    }
    assert(counter.val == 2)
}

// ─── Mutual exclusion ──────────────────────────────────────────

// Two fibers each take the mutex 50 times. `inside` is incremented under
// lock and decremented before unlock. If mutual exclusion holds, `inside`
// never exceeds 1 → violations == 0.
test "Mutex: mutual exclusion — inside never > 1" {
    mut m = Mutex.new()
    mut inside = IntCell.new(0)
    mut violations = IntCell.new(0)

    supervised {
        spawn {
            mut i = 0
            while i < 50 {
                m.lock()
                inside.val = inside.val + 1
                if inside.val > 1 { violations.val = violations.val + 1 }
                runtime.yield()
                inside.val = inside.val - 1
                m.unlock()
                i = i + 1
            }
        }
        spawn {
            mut i = 0
            while i < 50 {
                m.lock()
                inside.val = inside.val + 1
                if inside.val > 1 { violations.val = violations.val + 1 }
                runtime.yield()
                inside.val = inside.val - 1
                m.unlock()
                i = i + 1
            }
        }
    }
    assert(violations.val == 0)
    assert(inside.val == 0)
}

// Protected counter: two fibers increment without atomic ops — mutex must
// prevent lost updates. Final value must equal sum of both.
test "Mutex: protected counter — no lost updates" {
    mut m = Mutex.new()
    mut counter = IntCell.new(0)
    supervised {
        spawn {
            mut i = 0
            while i < 100 {
                m.lock()
                counter.val = counter.val + 1
                m.unlock()
                i = i + 1
            }
        }
        spawn {
            mut i = 0
            while i < 100 {
                m.lock()
                counter.val = counter.val + 1
                m.unlock()
                i = i + 1
            }
        }
    }
    assert(counter.val == 200)
}

// ─── M:N mode ──────────────────────────────────────────────────

// Same mutual-exclusion property under M:N scheduler with 2 workers.
// The park/wake cross-worker path gets exercised.
test "Mutex: mutual exclusion in M:N mode" {
    runtime.init(2)
    mut m = Mutex.new()
    mut inside = IntCell.new(0)
    mut violations = IntCell.new(0)
    supervised {
        spawn {
            mut i = 0
            while i < 30 {
                m.lock()
                inside.val = inside.val + 1
                if inside.val > 1 { violations.val = violations.val + 1 }
                inside.val = inside.val - 1
                m.unlock()
                i = i + 1
            }
        }
        spawn {
            mut i = 0
            while i < 30 {
                m.lock()
                inside.val = inside.val + 1
                if inside.val > 1 { violations.val = violations.val + 1 }
                inside.val = inside.val - 1
                m.unlock()
                i = i + 1
            }
        }
    }
    assert(violations.val == 0)
    runtime.shutdown()
}

// ─── Regression: Mutex as a record field ───────────────────────

// [M-atomicint-record-field-typedef-collision] regression (found + fixed
// 2026-07-11, D415 detach-migration wave): the SAME record-field forward-
// decl bug found for `AtomicInt` (see sync_atomic.nv) applied to any
// runtime-backed sync primitive, `Mutex` included — bundling a lock
// together with the data it protects (the idiomatic Rust `Mutex<T>`-style
// shape) used to CC-FAIL with a duplicate/conflicting `struct Nova_Mutex`
// typedef.
type LockedCounter {
    mu  Mutex
    val int
}
fn LockedCounter.new() -> LockedCounter => { mu: Mutex.new(), val: 0 }

test "Mutex: as a record field — no typedef collision, guards correctly" {
    mut lc = LockedCounter.new()
    lc.mu.lock()
    lc.val = lc.val + 1
    lc.mu.unlock()
    assert(lc.val == 1)
}
