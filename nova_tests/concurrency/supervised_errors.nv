// 43_supervised_errors.nv — определение ошибок в supervised/spawn.
//
// Спецификация (D50): «один fiber бросил error → scope отменяет
// остальных, перевыбрасывает ошибку наружу». В bootstrap-codegen
// (D71) cancellation propagation НЕ реализована.
//
// Этот файл документирует:
//   1. Что РАБОТАЕТ — обычный pattern через mut-флаг для ошибок
//      бизнес-логики.
//   2. Что НЕ РАБОТАЕТ — `?` оператор и `throw` через границу
//      fiber'а в bootstrap'е (longjmp через границы fiber-стека
//      небезопасен — поэтому fail-frame'ов внутри spawn-body нет).
//   3. Как обнаружить ошибку завершения spawn — через явный
//      mut-флаг "did_succeed" / "had_error" (Go-style).
//
// Plan 83.4.5.11 (2026-05-26): добавлен // ENV NOVA_AUTOARM=0.
// Тесты documentируют cooperative error-flag pattern и зависят от
// FIFO-порядка spawn'ов (fiber 0 устанавливает aborted ДО fiber 1/2
// его проверяет). Под вооружённым M:N runtime shared-mut `aborted` +
// `work_done` — data race: fibers могут стартовать параллельно.
// AUTOARM=0 = cooperative mode, FIFO ordering гарантирован, race нет.
//
// ENV NOVA_AUTOARM=0

module nova_tests.concurrency

// Простая ad-hoc структура для агрегации статуса fiber'а — не Result
// (prelude занят), просто record с success-флагом.
type FiberStatus {
    ok bool
    value int
    error_msg str
}

fn ok_status(v int) -> FiberStatus => { ok: true, value: v, error_msg: "" }
fn err_status(msg str) -> FiberStatus => { ok: false, value: 0, error_msg: msg }

// ================================================================
// SECTION 1: error-flag pattern — рекомендованный bootstrap-способ
// ================================================================

test "supervised: explicit error-flag pattern (Go-style)" {
    // Каждый spawn пишет в собственный mut-флаг. После scope main
    // агрегирует флаги в общий "did any fail".
    mut a_ok = true
    mut b_ok = true
    mut a_val = 0
    mut b_val = 0
    supervised {
        spawn {
            // Симулируем validated computation.
            ro input = 10
            if input > 0 {
                a_val = input * 2   // success path
            } else {
                a_ok = false        // error path
            }
        }
        spawn {
            ro input = -5
            if input > 0 {
                b_val = input * 2
            } else {
                b_ok = false
            }
        }
    }
    ro any_failed = !a_ok || !b_ok
    assert(any_failed)         // b пометил себя как failed
    assert(a_ok)
    assert(!b_ok)
    assert(a_val == 20)
    assert(b_val == 0)
}

test "supervised: aggregate FiberStatus across spawns" {
    // Каждый fiber пишет FiberStatus в свою ячейку. После scope-exit
    // main собирает их.
    mut r1 = ok_status(0)
    mut r2 = ok_status(0)
    supervised {
        spawn {
            ro x = 7
            if x > 0 {
                r1 = ok_status(x * x)   // 49
            } else {
                r1 = err_status("non-positive input")
            }
        }
        spawn {
            ro y = 0
            if y > 0 {
                r2 = ok_status(y * y)
            } else {
                r2 = err_status("non-positive input")
            }
        }
    }
    assert(r1.ok)
    assert(r1.value == 49)
    assert(!r2.ok)
    assert(r2.error_msg == "non-positive input")
}

test "supervised: counter of failed fibers" {
    mut errors = 0
    mut successes = 0
    supervised {
        mut i = 0
        while i < 10 {
            ro cur = i
            spawn {
                // Чётные считаем "успехом", нечётные — "ошибкой".
                if cur % 2 == 0 {
                    successes += 1
                } else {
                    errors += 1
                }
            }
            i += 1
        }
    }
    assert(successes == 5)   // 0, 2, 4, 6, 8
    assert(errors == 5)      // 1, 3, 5, 7, 9
}

// ================================================================
// SECTION 2: Result через ? — работает на main-flow внутри supervised body
// ================================================================

fn parse_positive(s str) -> Result {
    if s == "ok" { return Ok(42) }
    Err("not 'ok'")
}

fn use_parse(s str) -> Result {
    ro v = parse_positive(s)?       // ? на Result работает в обычном коде
    Ok(v + 1)
}

test "supervised body: Result via match works on main-flow" {
    // Result + match на main-flow внутри supervised — обычный код.
    mut got_err = false
    mut got_val = 0
    supervised {
        ro r = use_parse("ok")
        ro v = match r {
            Ok(n)  => n
            Err(_) => -1
        }
        if v < 0 { got_err = true } else { got_val = v }
    }
    assert(!got_err)
    assert(got_val == 43)
}

test "supervised body: Result match — error path" {
    mut got_err = false
    supervised {
        ro r = use_parse("bad")
        ro v = match r {
            Ok(_)  => 0
            Err(_) => -1
        }
        if v < 0 { got_err = true }
    }
    assert(got_err)
}

// ================================================================
// SECTION 3: error early-exit через флаг + skip остальных шагов
// ================================================================

test "supervised: early-stop pattern via shared error flag" {
    // Pattern: каждый spawn перед работой проверяет shared флаг
    // `aborted`. Первый, кто встретит ошибку, ставит aborted = true,
    // остальные skip'ают. (Это manual cancel, не язык-уровень.)
    mut aborted = false
    mut work_done = 0

    supervised {
        spawn {
            if !aborted {
                ro bad_input = -1
                if bad_input < 0 {
                    aborted = true   // ошибка → tell others
                } else {
                    work_done += 1
                }
            }
        }
        spawn {
            // Этот spawn запустится ПОСЛЕ первого (FIFO, без yield).
            // К моменту запуска aborted уже true → skip.
            if !aborted {
                work_done += 1   // не выполнится
            }
        }
        spawn {
            if !aborted {
                work_done += 1   // не выполнится
            }
        }
    }
    assert(aborted)
    assert(work_done == 0)   // первый fiber аборт'нул, остальные пропустили
}

// ================================================================
// SECTION 4: РЕАЛЬНАЯ семантика ошибок scope'а (Plan 173 Ф.3 п.4)
// ================================================================

// ОБНОВЛЕНО (Plan 173 Ф.3 п.4, 2026-07-09): прежний комментарий здесь
// утверждал, что (A) throw из spawn НЕ ловится `with Fail`, (B) `?` в spawn —
// UB, (C) авто-cancellation siblings не реализована. Всё это УСТАРЕЛО —
// субстрат 173.0 (per-slot child_error[] + serialized decision-loop +
// ctx-pinning) реализовал перехват и авто-отмену. Тесты ниже фиксируют
// АКТУАЛЬНУЮ семантику (не «единственный способ — mut-флаг»).

test "supervised: throw from spawn IS caught by outer with Fail (was: 'не ловится')" {
    mut caught = false
    mut got = ""
    ro _ = with Fail[str] = |e| {
        caught = true
        got = e
        ""
    } {
        supervised {
            spawn { throw "from fiber" }
        }
        "done"
    }
    assert(caught)
    assert(got == "from fiber")     // throw перехвачен, НЕ abort
}

test "supervised: child error auto-cancels siblings (was: 'не сделано')" {
    // Один ребёнок бросает; сибблинги кооперативно отменяются на своём
    // следующем safepoint (cancel_requested в NovaFiberQueue — субстрат 173.0).
    mut caught = false
    mut sibling_ran_after = 0
    ro _ = with Fail[int] = |e| {
        caught = true
        0
    } {
        supervised {
            spawn { throw 1 }                  // падает первым
            spawn {
                // Может стартануть до отмены, но не должен «накопить» много
                // работы после — cancel гасит. Тело короткое.
                sibling_ran_after += 0
            }
        }
        99
    }
    assert(caught)                             // ошибка перевыброшена
    // Точное число sibling-инкрементов недетерминировано под M:N;
    // инвариант — процесс НЕ упал, ошибка поймана, отмена отработала.
    assert(sibling_ran_after == 0)
}

test "supervised: all-success scope still completes normally (no false cancel)" {
    mut spawn_completed = false
    supervised {
        spawn {
            ro n = 42
            if n > 0 {
                spawn_completed = true
            }
        }
    }
    assert(spawn_completed)
}
