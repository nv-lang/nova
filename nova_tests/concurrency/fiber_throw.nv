// 44_fiber_throw.nv — fiber-safe throw.
//
// До этого PR `throw` внутри fiber-body вызывал abort() через longjmp в
// неверный setjmp-frame (frame на main-stack, fiber stack уже ушёл).
//
// Теперь spawn-entry обёрнут в локальный fail-frame на fiber-stack'е,
// nova_throw → longjmp → catch'ится прямо в fiber, fiber завершается
// чисто, scope-runner записывает первую ошибку и rethrow'ит на main.
//
// SECTION 1-3 проверяют **отсутствие abort** + Result-цепочки. SECTION 4
// (Plan 173 Ф.3 п.4) проверяет РЕАЛЬНЫЙ throw: `with Fail[E]` вокруг
// `supervised` ловит перевыброшенную ошибку (субстрат 173.0 retention +
// §1-precedence D414). Прежнее «throw неперехватываем» — устарело.

module nova_tests.concurrency

// Helper: simulates an operation that may fail via Result.
fn validated(n int) -> Result {
    if n > 0 { Ok(n) }
    else { Err("negative input") }
}

// ================================================================
// SECTION 1: spawn-body использует ? на Result успешно
// ================================================================

test "fiber: ? on Ok inside spawn body works" {
    mut got = AtomicInt.new(0)
    supervised {
        spawn {
            // ? на Ok разворачивает значение и продолжает.
            ro r = validated(7)
            ro v = match r {
                Ok(n) => n
                Err(_) => -1
            }
            got.store(v * v)
        }
    }
    assert(got.load() == 49)
}

test "fiber: ? on Err inside spawn body, error path via match" {
    mut got_ok = AtomicBool.new(false)
    mut got_err = AtomicBool.new(false)
    supervised {
        spawn {
            ro r = validated(-5)
            ro tag = match r {
                Ok(_n)  => 1
                Err(_e) => 2
            }
            if tag == 1 { got_ok.store(true) } else { got_err.store(true) }
        }
    }
    assert(!got_ok.load())
    assert(got_err.load())
}

// ================================================================
// SECTION 2: success-path — никто не throw'ит, сценарий OK
// ================================================================

test "supervised: many fibers, all succeed, scope completes normally" {
    mut counter = AtomicInt.new(0)
    supervised {
        mut i = 0
        while i < 10 {
            ro cur = i
            spawn {
                if cur >= 0 {
                    counter.fetch_add(1)
                }
            }
            i += 1
        }
    }
    assert(counter.load() == 10)   // none failed → all incremented
}

// ================================================================
// SECTION 3: записать "did_throw" флаг через Result-цепочку
// ================================================================

test "fiber: error-flag via Result.match (no real throw)" {
    mut errors = AtomicInt.new(0)
    mut successes = AtomicInt.new(0)
    supervised {
        mut i = -3
        while i <= 3 {
            ro cur = i
            spawn {
                ro r = validated(cur)
                ro tag = match r {
                    Ok(_n)  => 1
                    Err(_e) => 2
                }
                if tag == 1 { successes.fetch_add(1) } else { errors.fetch_add(1) }
            }
            i += 1
        }
    }
    // i = -3, -2, -1, 0 → Err (4 fibers)
    // i = 1, 2, 3       → Ok  (3 fibers)
    assert(errors.load() == 4)
    assert(successes.load() == 3)
}

// ================================================================
// SECTION 4: РЕАЛЬНЫЙ throw из fiber ЛОВИТСЯ (Plan 173 Ф.3 п.4)
// ================================================================
//
// ОБНОВЛЕНО (Plan 173 Ф.3 п.4, 2026-07-09): прежний комментарий здесь
// утверждал, что `throw` из fiber неперехватываем и требует особого
// test-runner'а — это УСТАРЕЛО. Субстрат 173.0 (per-slot child_error[] +
// serialized decision-loop) + retention (nova_tests/err173_0) делают throw
// из spawn-body ПЕРЕХВАТЫВАЕМЫМ: `with Fail[E]` вокруг `supervised` ловит
// перевыброшенную scope'ом ошибку (первую/primary по §1-precedence D414 §1).
// Ниже — позитивные тесты реального throw (не mut-флаг).

test "supervised: throw from spawn is caught by outer with Fail" {
    mut caught = false
    mut got = ""
    ro _ = with Fail[str] = |e| {
        caught = true
        got = e
        ""
    } {
        supervised {
            spawn { throw "boom-from-fiber" }
        }
        "unreached-if-thrown"
    }
    assert(caught)
    assert(got == "boom-from-fiber")
}

test "supervised: sole child throw surfaces as primary (single error)" {
    mut caught = false
    mut got = -1
    ro _ = with Fail[int] = |e| {
        caught = true
        got = e
        0
    } {
        supervised {
            spawn { throw 777 }
        }
        99
    }
    assert(caught)
    assert(got == 777)
}
