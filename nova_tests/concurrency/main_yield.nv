// ENV NOVA_AUTOARM=0
// 42_main_yield.nv — Time.sleep(0) at supervised-body level (not inside spawn).
//
// Spec D62: async is ambient — Time.sleep(0) callable from any context.
// In a supervised scope, Time.sleep(0) at body level (between/around spawns)
// drives one round of the queue's scheduler — main flow yields to queued fibers.
//
// Outside any scope: Time.sleep(0) is a no-op (no scheduler to yield to).
//
// This test set verifies REAL coroutine interleaving where the supervised
// body itself participates in the cooperative dance.
//
// Plan 83.4.5.5 Ф.1 (2026-05-23): added `// ENV NOVA_NO_AUTOARM=1`
// directive — полностью отключает auto-arm. Под armed runtime
// supervised body's spawn → worker deque (work-stealing), supervised_step
// на main скипает worker-owned fibers (Plan 83.4.2 Ф.1 A2 fix) →
// `Time.sleep(0)` на main НЕ продвигает fibers → encoded-log ordering
// ломается (main yield по сути no-op). Эти тесты specifically проверяют
// **cooperative interleaving semantics** — spawn в scope queue + main
// yield drives queue. Под NO_AUTOARM spawn идёт через
// nova_fiber_spawn_into → main scope queue → cooperative drain. Bootstrap
// и flip-active runs тогда дают identical execution-order.
//
// Cross-runtime: tokio `current_thread` runtime — closest equivalent
// (single-thread cooperative); Node всегда cooperative single-thread.
//
// Plan 83.10.1 (2026-05-26): STILL NEEDED — RUN-FAIL under armed M:N.
// Tests encode exact interleaving order (log == 1234675, 123456, etc.)
// which requires cooperative single-thread scheduling. Armed M:N workers
// steal fibers before main's sleep(0) can drive them, breaking log order.
// Reason: semantically cooperative — would require rewrite for M:N semantics.
// (Directive applied at top of file to stay within parser's 30-line window.)
//
// D415 §2 amendment (2026-07-11): every accumulator captured by a `spawn`
// body below migrated to `AtomicInt` (`store`/`load`/`fetch_add` replace
// the bare `=`/`+=`/`+=` on the same variable) — under NOVA_AUTOARM=0
// this is a no-op wrapper (single OS thread, cooperative round-robin), so
// the exact interleaving/ordering semantics these tests assert on are
// unchanged. Tests with NO `spawn` in them (body-level-only mutation) are
// untouched — D415 only gates spawn/parallel-for/detach boundaries.

module nova_tests.concurrency

// ================================================================
// SECTION 1: main yields between spawn registrations
// ================================================================

test "main yield: spawn, sleep(0), then read result" {
    // Spawn one fiber that writes 42 then yields.
    // Main calls Time.sleep(0) — drives scheduler — fiber runs once.
    // After scope exits, fiber finishes second half.
    mut value = AtomicInt.new(0)
    mut stage = AtomicInt.new(0)
    supervised {
        spawn {
            value.store(42)
            stage.store(1)
            Time.sleep(0)   // fiber yields back to main
            stage.store(2)
        }
        // At this point fiber hasn't run yet (queue holds it).
        Time.sleep(0)       // main drives queue once → fiber runs to its yield
        // Now fiber has paused at "stage = 1, value = 42".
        assert(stage.load() == 1)
        assert(value.load() == 42)
        // scope exit will drive remaining work → stage = 2
    }
    assert(stage.load() == 2)
}

test "main interleaves with two spawns via sleep(0)" {
    // Three actors: main, A, B. Each makes a few writes.
    // Order:
    //   main writes 1, sleep → A writes 2, B writes 3 → main resumes
    //   main writes 4, sleep → A continues (after its yield) → B continues
    //   main writes 5
    mut log = AtomicInt.new(0)
    supervised {
        spawn {
            println("  fiber A: write 2"); log.store(log.load() * 10 + 2)
            Time.sleep(0)
            println("  fiber A: write 6"); log.store(log.load() * 10 + 6)
        }
        spawn {
            println("  fiber B: write 3"); log.store(log.load() * 10 + 3)
            Time.sleep(0)
            println("  fiber B: write 7"); log.store(log.load() * 10 + 7)
        }
        println("main: write 1"); log.store(log.load() * 10 + 1)
        println("main: sleep(0) — yield to queue")
        Time.sleep(0)         // step 1: A writes 2, B writes 3
        println("main: write 4"); log.store(log.load() * 10 + 4)
        println("main: sleep(0)")
        Time.sleep(0)         // step 2: A writes 6, B writes 7
        println("main: write 5"); log.store(log.load() * 10 + 5)
        // scope exit: nothing left in queue (A and B both done)
    }
    println("3-actors log = ", log.load())
    // Steps:
    //   main: 1                        log = 1
    //   sleep(0) → A: 2, B: 3          log = 1 → 12 → 123
    //   main: 4                        log = 1234
    //   sleep(0) → A: 6, B: 7          log = 12346 → 123467
    //   main: 5                        log = 1234675
    assert(log.load() == 1234675)
}

test "main yield: counter ping-pong with one fiber" {
    // Main and one fiber alternate: each writes a digit, yields.
    mut log = AtomicInt.new(0)
    supervised {
        spawn {
            println("  F: 2"); log.store(log.load() * 10 + 2)
            Time.sleep(0)
            println("  F: 4"); log.store(log.load() * 10 + 4)
            Time.sleep(0)
            println("  F: 6"); log.store(log.load() * 10 + 6)
        }
        println("M: 1"); log.store(log.load() * 10 + 1)
        Time.sleep(0)
        println("M: 3"); log.store(log.load() * 10 + 3)
        Time.sleep(0)
        println("M: 5"); log.store(log.load() * 10 + 5)
        Time.sleep(0)
    }
    println("ping-pong log = ", log.load())
    // 1, 2, 3, 4, 5, 6 → 123456
    assert(log.load() == 123456)
}

// ================================================================
// SECTION 2: main yields, but fiber finishes earlier
// ================================================================

test "main yield: fiber finishes before main does its next yield" {
    // Fiber writes one value, no yield, exits. Main's sleep(0) is then
    // a single step that resumes-and-completes the fiber (one resume = MCO_DEAD).
    mut log = AtomicInt.new(0)
    supervised {
        spawn {
            log.store(log.load() * 10 + 2)   // no yield: fiber runs to completion in one resume
        }
        log.store(log.load() * 10 + 1)
        Time.sleep(0)            // step: fiber writes 2, dies
        log.store(log.load() * 10 + 3)
    }
    // 1, 2, 3 → 123
    assert(log.load() == 123)
}

test "main yield: with no fibers in queue is a no-op" {
    // sleep(0) outside fiber, but inside scope — drives empty queue (no-op).
    // No `spawn` here — plain body-level mutation, D415 doesn't gate this.
    mut value = 0
    supervised {
        value = 1
        Time.sleep(0)   // queue empty: no-op
        value = 2
        Time.sleep(0)   // still empty
        value = 3
    }
    assert(value == 3)
}

// ================================================================
// SECTION 3: main yields in nested supervised
// ================================================================

test "main yield in nested supervised: outer scope drives inner" {
    mut log = AtomicInt.new(0)
    supervised {
        log.store(log.load() * 10 + 1)
        supervised {
            spawn {
                log.store(log.load() * 10 + 3)
                Time.sleep(0)
                log.store(log.load() * 10 + 5)
            }
            log.store(log.load() * 10 + 2)
            Time.sleep(0)            // inner main yields → fiber: 3 (yields)
            log.store(log.load() * 10 + 4)
            // inner scope exit: drains remaining → fiber: 5
        }
        log.store(log.load() * 10 + 6)
    }
    // 1, 2, 3 (fiber via main yield), 4 (main resumes), 5 (scope drain), 6 (outer)
    assert(log.load() == 123456)
}

test "main yield in outer doesn't drive inner queue" {
    // Outer supervised has fiber X. Inner supervised within X has no relation
    // to the outer queue — outer's sleep(0) drives only outer queue.
    mut log = AtomicInt.new(0)
    supervised {
        spawn {
            log.store(log.load() * 10 + 2)
            Time.sleep(0)
            log.store(log.load() * 10 + 5)
        }
        log.store(log.load() * 10 + 1)
        Time.sleep(0)               // outer drives its queue: fiber writes 2
        log.store(log.load() * 10 + 3)
        supervised {
            log.store(log.load() * 10 + 4)
            // inner has no fibers; sleep(0) here is no-op
        }
        // outer scope exit: fiber writes 5
    }
    // 1, 2, 3, 4, 5 → 12345
    assert(log.load() == 12345)
}

// ================================================================
// SECTION 4: producer-consumer where main is consumer
// ================================================================

test "main as consumer: spawn produces, main reads after each yield" {
    // Spawn writes 5 values into `slot`, yielding after each.
    // Main reads `slot` after each yield, accumulates `received`.
    mut slot = AtomicInt.new(0)
    mut received = AtomicInt.new(0)
    supervised {
        spawn {
            mut i = 1
            while i <= 5 {
                slot.store(i)
                println("  producer: slot = ", i)
                Time.sleep(0)   // hand off to main
                i += 1
            }
        }
        // Main waits for first produce, reads, repeat.
        mut count = 0
        while count < 5 {
            Time.sleep(0)       // wait for next produce
            println("main consumer: read slot = ", slot.load())
            received.fetch_add(slot.load())
            count += 1
        }
    }
    println("main-consumer received = ", received.load())
    // Producer: 1, 2, 3, 4, 5 → received sums to 15
    assert(received.load() == 15)
}

test "main as producer: writes then yields to consumer fiber" {
    // Consumer: each iteration first sleeps (waits for main to produce),
    // then reads. With FIFO scheduler, the trace is:
    //   spawn consumer (queued, not run)
    //   main: slot=10, sleep(0) → step: consumer starts: enter while,
    //                              SLEEP (skipping the just-written 10),
    //                              yields → back to main
    //   main: slot=20, sleep(0) → consumer reads 20, sleeps
    //   main: slot=30, sleep(0) → consumer reads 30, sleeps
    //   main: slot=40, sleep(0) → consumer reads 40, sleeps
    //   main exits while
    //   scope exit → run drains: consumer wakes, reads slot=40 again
    // Consumer reads: 20, 30, 40, 40 → received = 130
    mut slot = AtomicInt.new(0)
    mut received = AtomicInt.new(0)
    supervised {
        spawn {
            mut count = 0
            while count < 4 {
                Time.sleep(0)   // wait for main to write
                received.fetch_add(slot.load())
                count += 1
            }
        }
        mut i = 1
        while i <= 4 {
            slot.store(i * 10)
            Time.sleep(0)       // hand off to consumer
            i += 1
        }
    }
    assert(received.load() == 130)
}

// ================================================================
// SECTION 5: stress
// ================================================================

test "main yield: 5 fibers each yields twice, main drives" {
    mut total = AtomicInt.new(0)
    supervised {
        spawn { total.fetch_add(1); Time.sleep(0); total.fetch_add(10) }
        spawn { total.fetch_add(2); Time.sleep(0); total.fetch_add(20) }
        spawn { total.fetch_add(3); Time.sleep(0); total.fetch_add(30) }
        spawn { total.fetch_add(4); Time.sleep(0); total.fetch_add(40) }
        spawn { total.fetch_add(5); Time.sleep(0); total.fetch_add(50) }
        Time.sleep(0)     // step 1: all fibers do first half (1+2+3+4+5 = 15)
        // After step 1: total = 15
        Time.sleep(0)     // step 2: all fibers do second half (10+20+30+40+50 = 150)
        // After step 2: total = 165
    }
    assert(total.load() == 165)
}

test "main yield: ping-pong sum across many rounds" {
    // Single fiber + main alternate increments. Each round both add 1.
    mut counter = AtomicInt.new(0)
    supervised {
        spawn {
            mut k = 0
            while k < 10 {
                counter.fetch_add(1)
                Time.sleep(0)
                k += 1
            }
        }
        mut j = 0
        while j < 10 {
            Time.sleep(0)
            counter.fetch_add(1)
            j += 1
        }
    }
    // 10 * 2 = 20
    assert(counter.load() == 20)
}
