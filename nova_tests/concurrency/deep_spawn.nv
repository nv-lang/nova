// deep_spawn_test.nv — Nova-level deep spawn/fiber tests
//
// Verifies: execution ordering, capture semantics, mutation visibility,
// pipeline chaining, state-machine patterns, nested spawns, and
// correctness under high spawn count.
//
// C-level counterpart: compiler-codegen/nova_rt/test_fibers_deep.c
// That file tests stack addresses, yield/resume ordering, fib(30), etc.
// This file tests the observable Nova semantics built on top of that runtime.
//
// D415 migration note (Plan 173.3): every `mut` accumulator/result below is
// written from inside a `spawn` body, so the static capture-check (D415 §2)
// flags a raw `mut int` regardless of whether the scope actually has more
// than one writer. Wrapped in `AtomicInt` throughout — `store`/`load`/
// `fetch_add` replace the bare `=`/`+=` on the same variable, values and
// assertions are unchanged.

module nova_tests.concurrency

type Counter1 {
    val int
}

type Stage {
    input  int
    output int
}

fn make_counter1(val int) -> Counter1 => { val }
fn make_stage(input int, output int) -> Stage => { input, output }

fn fib(n int) -> int {
    mut a = 0
    mut b = 1
    mut i = 0
    while i < n {
        ro t = a + b
        a = b
        b = t
        i += 1
    }
    a
}

fn sum_range2(n int) -> int {
    mut acc = 0
    mut i = 1
    while i <= n {
        acc += i
        i += 1
    }
    acc
}

fn factorial(n int) -> int {
    mut acc = 1
    mut i = 1
    while i <= n {
        acc = acc * i
        i += 1
    }
    acc
}

// ================================================================
// SECTION 1: execution ordering — spawn body completes before scope exit
//
// Spec D50/D71: spawn внутри supervised — fire-and-forget statement,
// возвращает unit. Результаты — через mut-захваты (см. ниже).
// scope-exit ждёт всех spawn'ов, поэтому assert после supervised
// видит уже-применённые мутации.
// ================================================================

test "supervised: single spawn mutation visible after scope exit" {
    mut log = AtomicInt.new(0)
    supervised {
        spawn { log.store(1) }
    }
    assert(log.load() == 1)
}

test "supervised: three spawns mutate shared state" {
    // No yields inside fibers → cooperative-only scheduler runs them
    // sequentially in FIFO order: 1, 2, 3.
    mut seq = AtomicInt.new(0)
    supervised {
        spawn { seq.store(seq.load() * 10 + 1) }
        spawn { seq.store(seq.load() * 10 + 2) }
        spawn { seq.store(seq.load() * 10 + 3) }
    }
    assert(seq.load() == 123)
}

test "supervised: 10 spawns in loop, mutations accumulate" {
    mut acc = AtomicInt.new(0)
    supervised {
        mut i = 0
        while i < 10 {
            ro cur = i
            spawn { acc.fetch_add(cur + 1) }   // adds 1,2,...,10
            i += 1
        }
    }
    // 1+2+...+10 = 55
    assert(acc.load() == 55)
}

test "supervised: result via mut capture (no spawn-result needed)" {
    ro x = 7
    mut r = AtomicInt.new(0)
    supervised {
        spawn { r.store(x * x * x) }   // 343
    }
    ro r2 = r.load() + 1
    assert(r.load() == 343)
    assert(r2 == 344)
}

// ================================================================
// SECTION 2: capture semantics
// ================================================================

test "supervised: captures immutable int, writes via mut" {
    ro n = 42
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(n * 2) } }
    assert(r.load() == 84)
}

test "supervised: captures multiple immutable vars" {
    ro a = 3
    ro b = 4
    ro c = 5
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(a * a + b * b + c * c) } }   // 9 + 16 + 25 = 50
    assert(r.load() == 50)
}

test "supervised: captures mutable var, mutation visible" {
    mut x = AtomicInt.new(10)
    supervised { spawn { x.store(x.load() * 3) } }
    assert(x.load() == 30)
}

test "supervised: two fibers capture same mutable var, both mutations apply" {
    mut n = AtomicInt.new(0)
    supervised {
        spawn { n.fetch_add(5) }
        spawn { n.fetch_add(3) }
    }
    assert(n.load() == 8)
}

test "supervised: captures result of function call" {
    ro n = 10
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(sum_range2(n)) } }   // 55
    assert(r.load() == 55)
}

test "supervised: captures result of expensive function" {
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(fib(20)) } }   // 6765
    assert(r.load() == 6765)
}

// ================================================================
// SECTION 3: pipeline chaining via sequential supervised scopes.
//
// Note: spawn-результат не передаётся между fiber'ами. Поэтому
// pipeline стадии — отдельные supervised-блоки с mut-захватами,
// либо просто прямые вызовы (async прозрачный — D62).
// ================================================================

test "pipeline: 2 stages via prior values" {
    ro x = 6
    mut s1 = AtomicInt.new(0)
    mut s2 = AtomicInt.new(0)
    supervised { spawn { s1.store(x * x) } }            // 36
    supervised { spawn { s2.store(s1.load() + s1.load()) } }          // 72
    assert(s1.load() == 36)
    assert(s2.load() == 72)
}

test "pipeline: 3 stages doubling-squared" {
    ro base = 2
    mut s1 = AtomicInt.new(0); mut s2 = AtomicInt.new(0); mut s3 = AtomicInt.new(0)
    supervised { spawn { s1.store(base * base) } }       // 4
    supervised { spawn { s2.store(s1.load() * s1.load()) } }          // 16
    supervised { spawn { s3.store(s2.load() * s2.load()) } }          // 256
    assert(s1.load() == 4)
    assert(s2.load() == 16)
    assert(s3.load() == 256)
}

test "pipeline: 5 stages doubling" {
    ro start = 1
    mut v1 = AtomicInt.new(0); mut v2 = AtomicInt.new(0); mut v3 = AtomicInt.new(0); mut v4 = AtomicInt.new(0); mut v5 = AtomicInt.new(0)
    supervised { spawn { v1.store(start + 1) } }   // 2
    supervised { spawn { v2.store(v1.load() * 2) } }      // 4
    supervised { spawn { v3.store(v2.load() * 2) } }      // 8
    supervised { spawn { v4.store(v3.load() * 2) } }      // 16
    supervised { spawn { v5.store(v4.load() * 2) } }      // 32
    assert(v1.load() == 2)
    assert(v3.load() == 8)
    assert(v5.load() == 32)
}

test "pipeline: fork and join (two parallel + one combiner)" {
    ro x = 10
    mut left = AtomicInt.new(0)
    mut right = AtomicInt.new(0)
    supervised {
        spawn { left.store(x + 1) }      // 11
        spawn { right.store(x * x) }     // 100
    }
    mut joined = AtomicInt.new(0)
    supervised { spawn { joined.store(left.load() + right.load()) } }   // 111
    assert(left.load() == 11)
    assert(right.load() == 100)
    assert(joined.load() == 111)
}

// ================================================================
// SECTION 4: state machine via mutation
// ================================================================

test "state machine: 3-state protocol" {
    mut state = AtomicInt.new(0)
    mut partial = AtomicInt.new(0)
    mut result = AtomicInt.new(0)
    ro input = 7

    supervised {
        spawn {
            state.store(1)
            partial.store(input * 2)   // 14
        }
    }
    assert(state.load() == 1)
    assert(partial.load() == 14)
    assert(result.load() == 0)

    supervised {
        spawn {
            result.store(partial.load() + input)   // 14 + 7 = 21
            state.store(2)
        }
    }
    assert(state.load() == 2)
    assert(result.load() == 21)
}

test "state machine: 5-step accumulator" {
    mut step = AtomicInt.new(0)
    mut total = AtomicInt.new(0)

    supervised { spawn { step.store(1); total.fetch_add(1) } }
    assert(step.load() == 1); assert(total.load() == 1)

    supervised { spawn { step.store(2); total.fetch_add(2) } }
    assert(step.load() == 2); assert(total.load() == 3)

    supervised { spawn { step.store(3); total.fetch_add(4) } }
    assert(step.load() == 3); assert(total.load() == 7)

    supervised { spawn { step.store(4); total.fetch_add(8) } }
    assert(step.load() == 4); assert(total.load() == 15)

    supervised { spawn { step.store(5); total.fetch_add(16) } }
    assert(step.load() == 5); assert(total.load() == 31)
}

// ================================================================
// SECTION 5: many fibers
// ================================================================

test "supervised: 100 fibers, sum correct" {
    mut total = AtomicInt.new(0)
    supervised {
        mut i = 1
        while i <= 100 {
            ro cur = i
            spawn { total.fetch_add(cur) }
            i += 1
        }
    }
    assert(total.load() == 5050)
}

test "supervised: 500 fibers, sum of squares" {
    mut total = AtomicInt.new(0)
    supervised {
        mut i = 0
        while i < 500 {
            ro cur = i
            spawn { total.fetch_add(cur * cur) }
            i += 1
        }
    }
    // sum(i^2, i=0..499) = 41541750
    assert(total.load() == 41541750)
}

// ================================================================
// SECTION 6: factorial and recursive calls inside spawn
// ================================================================

test "spawn: factorial(10) via mut capture" {
    ro n = 10
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(factorial(n)) } }
    assert(r.load() == 3628800)
}

test "spawn: fib(25) via mut capture" {
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(fib(25)) } }
    assert(r.load() == 75025)
}

test "spawn: sum_range2(1000) via mut capture" {
    ro n = 1000
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(sum_range2(n)) } }
    assert(r.load() == 500500)
}

// ================================================================
// SECTION 7: mutation accumulates across many fibers
// ================================================================

test "spawn: factorial via sequential spawn mutations" {
    mut acc = AtomicInt.new(1)
    supervised {
        mut i = 1
        while i <= 12 {
            ro cur = i
            spawn { acc.store(acc.load() * cur) }
            i += 1
        }
    }
    assert(acc.load() == 479001600)   // 12!
}

test "spawn: alternating add/multiply pattern" {
    mut val = AtomicInt.new(1)
    supervised {
        mut i = 0
        while i < 10 {
            ro cur = i
            spawn {
                if cur * 2 == cur + cur {
                    val.store(val.load() + cur + 1)
                }
            }
            i += 1
        }
    }
    assert(val.load() == 56)   // 1 + sum(1..10)
}

// ================================================================
// SECTION 8: captures of records inside spawn
// ================================================================

test "spawn: record field accessed via mut capture" {
    ro c = make_counter1(42)
    mut r = AtomicInt.new(0)
    supervised { spawn { r.store(c.val * 2) } }
    assert(r.load() == 84)
}

test "spawn: int captured from record before spawn" {
    ro c = make_counter1(100)
    ro cap = c.val
    mut result = AtomicInt.new(0)
    supervised { spawn { result.store(cap + 1) } }
    assert(result.load() == 101)
}

test "pipeline: records through sequential spawn stages" {
    ro s1_in = 5
    ro s1 = make_stage(s1_in, 0)
    mut r1 = AtomicInt.new(0)
    supervised { spawn { r1.store(s1.input * s1.input) } }   // 25

    ro s2_in = r1.load()
    ro s2 = make_stage(s2_in, 0)
    mut r2 = AtomicInt.new(0)
    supervised { spawn { r2.store(s2.input + 1) } }          // 26

    assert(r1.load() == 25)
    assert(r2.load() == 26)
}

// ================================================================
// SECTION 9: independence — two mutable vars, each touched by one fiber
// ================================================================

test "supervised: independent mutations don't interfere" {
    mut a = AtomicInt.new(0)
    mut b = AtomicInt.new(0)
    supervised {
        spawn { a.store(111) }
        spawn { b.store(222) }
    }
    assert(a.load() == 111)
    assert(b.load() == 222)
}

test "supervised: 10 independent pairs, no cross-contamination" {
    mut r0 = AtomicInt.new(0)
    mut r1 = AtomicInt.new(0)
    mut r2 = AtomicInt.new(0)
    mut r3 = AtomicInt.new(0)
    mut r4 = AtomicInt.new(0)
    mut r5 = AtomicInt.new(0)
    mut r6 = AtomicInt.new(0)
    mut r7 = AtomicInt.new(0)
    mut r8 = AtomicInt.new(0)
    mut r9 = AtomicInt.new(0)

    supervised {
        spawn { r0.store(0 * 7 + 1) }
        spawn { r1.store(1 * 7 + 1) }
        spawn { r2.store(2 * 7 + 1) }
        spawn { r3.store(3 * 7 + 1) }
        spawn { r4.store(4 * 7 + 1) }
        spawn { r5.store(5 * 7 + 1) }
        spawn { r6.store(6 * 7 + 1) }
        spawn { r7.store(7 * 7 + 1) }
        spawn { r8.store(8 * 7 + 1) }
        spawn { r9.store(9 * 7 + 1) }
    }

    assert(r0.load() == 1)
    assert(r1.load() == 8)
    assert(r2.load() == 15)
    assert(r3.load() == 22)
    assert(r4.load() == 29)
    assert(r5.load() == 36)
    assert(r6.load() == 43)
    assert(r7.load() == 50)
    assert(r8.load() == 57)
    assert(r9.load() == 64)
}

// ================================================================
// SECTION 10: cooperative scheduling — REAL coroutine interleave
// via supervised + Time.sleep(0).
//
// Plan 83.10.4 Ф.6 (2026-05-27): MOVED to cooperative_interleave.nv
// with NOVA_AUTOARM=0. These tests rely on FIFO single-thread scheduling
// for exact `log == NNNN` assertions, which does not hold under armed
// M:N (fibers run in parallel on workers, race on shared mut).
// ================================================================
