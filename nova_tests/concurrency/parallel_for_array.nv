// 50_parallel_for_array.nv — D71: `parallel for x in iter { expr }` evaluates to []T.
//
// Когда тело `parallel for` имеет trailing-expression — форма возвращает
// массив `[]T`, где T — тип trailing-expression.
//
// Plan 173.1 Ф.2 (D71-amend): сбор — через КАНАЛ (клон Sender'а в родителе
// на момент spawn → move в ребёнка → send trailing-значения → close на
// выходе ребёнка; выделенный drain-fiber внутри scope). Порядок элементов =
// **completion order** (плотный, без дыр) — итерационный порядок НЕ
// гарантирован (паритет: Go каналы / tokio JoinSet::join_next). Тесты ниже —
// set-equality (len + sum + contains), НЕ индексные asserts (старая
// slot-семантика `result.data[idx]` ретирована планом 173.1).
//
// Когда тело без trailing — старая семантика: parallel for как statement (unit).
//
// Plan 83.4.5.3 Ф.1 (2026-05-23): added `// ENV NOVA_MAXPROCS=1` directive
// — under armed runtime multi-worker supervised double-resume race (Plan
// 83.4.2 Ф.1 corner case) триггерит fiber arena access violation. Под
// 1 worker drain happens одним потоком — race исключён. Под bootstrap'е
// (Plan 83.2 flip OFF) directive — no-op. Полный multi-worker safety —
// Plan 83.4.5.1 cancel wake-all + cascade.
//
// ENV NOVA_MAXPROCS=1

module nova_tests.concurrency

// ================================================================
// SECTION 1: range → []int
// ================================================================

test "parallel for over range returns []int" {
    ro xs = parallel for i int in 0..5 {
        i * 2
    }
    assert(xs.len() == 5)
    mut sum = 0
    for v in xs { sum += v }
    assert(sum == 0 + 2 + 4 + 6 + 8)
    assert(xs.contains(0))
    assert(xs.contains(2))
    assert(xs.contains(4))
    assert(xs.contains(6))
    assert(xs.contains(8))
}

test "parallel for over inclusive range returns []int" {
    ro xs = parallel for i int in 1..=4 {
        i + 100
    }
    assert(xs.len() == 4)
    assert(xs.contains(101))
    assert(xs.contains(102))
    assert(xs.contains(103))
    assert(xs.contains(104))
}

test "parallel for: dense completion-order — yield не теряет элементы" {
    // D71-amend (Plan 173.1): порядок НЕ гарантирован (completion order),
    // но сбор ПЛОТНЫЙ — каждый fiber доносит ровно один элемент, yield
    // внутри тела не приводит к потере/дублированию.
    ro xs = parallel for i int in 0..4 {
        Time.sleep(0)
        i * i
    }
    assert(xs.len() == 4)
    assert(xs.contains(0))
    assert(xs.contains(1))
    assert(xs.contains(4))
    assert(xs.contains(9))
}

// ================================================================
// SECTION 2: array literal → []int
// ================================================================

test "parallel for over array literal returns []int" {
    ro xs = parallel for v int in [10, 20, 30] {
        v + 1
    }
    assert(xs.len() == 3)
    assert(xs.contains(11))
    assert(xs.contains(21))
    assert(xs.contains(31))
}

// ================================================================
// SECTION 3: capture mut outer + write to array
// ================================================================

test "parallel for: array result + mut capture work together" {
    mut total = AtomicInt.new(0)
    ro xs = parallel for i int in 0..3 {
        total.fetch_add(1)   // mutation visible after scope-run
        i * 10
    }
    assert(total.load() == 3)
    assert(xs.len() == 3)
    assert(xs.contains(0))
    assert(xs.contains(10))
    assert(xs.contains(20))
}

// ================================================================
// SECTION 4: regression — old statement-mode still unit
// ================================================================

test "parallel for without trailing yields unit (regression)" {
    // Если body НЕ имеет trailing — старая семантика: statement, unit.
    mut sum = AtomicInt.new(0)
    parallel for x in [1, 2, 3] {
        sum.fetch_add(x)
    }
    assert(sum.load() == 6)
}
