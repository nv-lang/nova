// cancellation_test.nv — Plan 47/48/49 acceptance test
// (std/concurrency/cancellation.nv: race2[T])
//
// RETRACTED (Plan 173 §3a п.4 / [M-174-retract-with-timeout], 2026-07-10):
// within[T]/with_timeout[T] tests УДАЛЕНЫ вместе с самим API — субсумированы
// supervised(timeout:)/supervised(deadline:) (D408), уже покрыты
// std/concurrency/supervised_deadline_test.nv (7 сценариев). race2[T] НЕ
// субсумирован, остаётся, тесты ниже без изменений.
//
// UN-QUARANTINED — Plan 151 Ф.2 (2026-06-13). The crash that sent this file to
// quarantine (Plan 149 fu #1) was MISDIAGNOSED as "unbounded mono-recursion in
// the mono'd within[T]/race2[T] codegen". Plan 151 Ф.0 proved that wrong:
// codegen is CLEAN (the same binary PASSES under NOVA_AUTOARM=0 / NOVA_MAXPROCS<=3).
// The real root cause was a GC-reachability bug in the M:N runtime — the closure
// heap object passed into supervised{spawn{ ro r=body() }} is rooted only on the
// main thread's native stack while main blocks in nova_supervised_run_impl; under
// >=4 workers a GC fires during _materialize_pool (before main creates its lazy
// fiber arena), Boehm's STW scan misses main's stack, the closure is prematurely
// collected, closure->fn is zeroed by reuse, and the worker fiber calls NULL
// (RIP=0) — surfaced by the arena VEH as the misleading "fiber stack overflow in
// slot 0". Fixed in Plan 151 Ф.1 (nova_rt: push main's native stack as a GC root
// in _nova_fw_gc_push_other_roots). Marker redirected to
// [M-mn-worker-fiber-closure-call-stack-overflow] and CLOSED — see docs/plans/151.

module nova_tests.concurrency

import std.concurrency.cancellation


// ──────────────────────────────────────────────────────────────────────────
// race2[T] — two-fiber competition
// ──────────────────────────────────────────────────────────────────────────

test "race2: оба возвращают одно значение → любой wins" {
    ro r = race2(|| 7, || 7)
    assert(r == 7)
}


test "race2: разные значения — winner один из них" {
    ro r = race2(|| 10, || 20)
    assert(r == 10 || r == 20)
}


// ──────────────────────────────────────────────────────────────────────────
// Edge cases — large timeout, multi-call, generic-call sanity
// ──────────────────────────────────────────────────────────────────────────


test "race2 одинаковые closures wins одинаковый" {
    ro r = race2(|| 5, || 5)
    assert(r == 5)
}


// ──────────────────────────────────────────────────────────────────────────
// Negative behavior — verify что after scope код продолжается
// ──────────────────────────────────────────────────────────────────────────


test "negative race2 не throw на normal completion" {
    ro _ = race2(|| 1, || 2)
    ro after = true
    assert(after)
}
