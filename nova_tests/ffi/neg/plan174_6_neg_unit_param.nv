// Plan 174.6 M1 (D282 rule 2) NEG — `()` (unit / zero-field tuple) has no C
// representation, so it is forbidden as a PARAMETER type (only a top-level
// `-> ()` return lowers to C `void`).
//
// EXPECT_COMPILE_ERROR E_FFI_NON_C_ABI_TYPE

module neg.plan174_6_neg_unit_param

extern "C" fn c_take_unit(x ()) -> int

test "rejects unit param over C ABI" {
    assert(1 == 1)
}
