// Plan 174.6 M1 (D353 clause 3 — soundness) NEG — coercing a fn that declares
// ANY effect (here a custom algebraic effect, not `Fail`) into a C-ABI
// `*extern "C" fn` is forbidden. C invokes the callback with no Nova
// handler-frame on the stack, so any effect-operation is unsound. This
// generalises the `Fail`-specific gate to all effects.
//
// EXPECT_COMPILE_ERROR E_CALLBACK_THROWS_OVER_C_ABI

module neg.plan174_6_neg_callback_effect

type Logger effect {
    log(msg str) -> ()
}

fn effectful_cb(x i64) Logger -> i64 {
    x
}

test "rejects effect-declaring fn coerced to *extern \"C\" fn" {
    ro cb = effectful_cb as *extern "C" fn(i64) -> i64
    assert(1 == 1)
}
