// Plan 174.6 M1 (D282 rule 2 / D353) — POS: `extern "C" fn` signatures using
// the full recursive C-ABI type-list compile cleanly (no E_FFI_NON_C_ABI_TYPE).
//
// Covers: all scalars (incl. `uint` = nova_uint, distinct from u64), raw ptrs
// (`*T` / `*()` / CStr), `str` (= {ptr,len} value-record), value-records +
// named-tuples + anon tuples with all-C-ABI fields, a cyclic value-record
// (`Node value {next *Node}`), `Option[*T]` (NPO), `-> ()` = void, and a
// `*extern "C" fn(...)` C-callback parameter (D353 fn-ptr ABI-tag).
//
// Declarations only (bodyless extern) — uncalled, so no C shim / linker symbol
// is required; the point is that the CHECKER accepts every signature.

module nova_tests.ffi

// C-ABI value-record (all fields C-ABI) — passed by-value as a C struct.
type Rect value { w int, h int }

// Named tuple (stack value type) — C-ABI iff all fields C-ABI.
type Point(x f64, y f64)

// Cyclic value-record: `next *Node` is a raw pointer → recursion stops.
type Node value { val int, next *Node }

// ─── Scalars (incl. uint, the address-sized unsigned, ≠ u64) ───────────────
extern "C" fn cffi_scalars(a int, b uint, c i8, d i16, e i32, f i64) -> int
extern "C" fn cffi_scalars_u(a u8, b u16, c u32, d u64) -> uint
extern "C" fn cffi_float_bool_char(a f32, b f64, c bool, d char) -> f64

// ─── Raw pointers (any pointee) + `*()` ────────────────────────────────────
extern "C" fn cffi_ptrs(p *u8, q *(), r *int) -> *u8

// ─── str (value-record {ptr,len}) in param AND return ──────────────────────
extern "C" fn cffi_str_roundtrip(s str) -> str

// ─── value-record / named-tuple / anon-tuple, param + return ───────────────
extern "C" fn cffi_rect_area(r Rect) -> int
extern "C" fn cffi_make_point(x f64, y f64) -> Point
extern "C" fn cffi_pair(a int, b *u8) -> (int, *u8)

// ─── cyclic value-record ───────────────────────────────────────────────────
extern "C" fn cffi_node_sum(n *Node) -> int

// ─── Option[*T] via NPO (None = NULL) ──────────────────────────────────────
extern "C" fn cffi_opt_ptr(p Option[*u8]) -> Option[*int]

// ─── C-ABI fn-pointer parameter (D353) — a real C callback, e.g. qsort ─────
extern "C" fn cffi_register(cb *extern "C" fn(*(), *()) -> i32) -> int
// fn-ptr returning + multi-scalar callback signature
extern "C" fn cffi_get_cmp() -> *extern "C" fn(i64, i64) -> i32

// ─── `-> ()` top-level return = C `void` (allowed) ─────────────────────────
extern "C" fn cffi_void_ret(x int) -> ()

test "extern \"C\" fn C-ABI signatures type-check" {
    // Declarations only — verifies the checker accepts every C-ABI signature.
    assert(1 == 1)
}
