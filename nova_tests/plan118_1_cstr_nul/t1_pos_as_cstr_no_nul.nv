// Plan 118.1 [M-118.1-cstr-nul-check] — to_cstr() succeeds on NUL-free strings
// (the embedded-NUL scan falls through, no panic). Plan 199 Ф.3: the former
// scan-free `as_cstr_unchecked()` hatch is gone — the copying `to_cstr` family
// (GC-alloc + caller-buffer overloads) replaces both `as_cstr` and
// `as_cstr_unchecked`; the caller-buffer overload truncates by design.
module plan118_1_cstr_nul.t1_pos_as_cstr_no_nul

import std.ffi.cstr.{CStr}

test "to_cstr on NUL-free strings succeeds (no panic)" {
    ro a = "hello".to_cstr()
    ro b = "".to_cstr()
    assert("hello".byte_len() == 5)
}
