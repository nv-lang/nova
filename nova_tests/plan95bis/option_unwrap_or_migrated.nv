// Plan 95.bis Ф.3.1: Option.unwrap_or — Nova-body migration verification.
//
// Прежний C-трамплин Nova_Option_method_unwrap_or_<T> заменён на
// Nova-body `=> match @ { Some(v) => v, None => default }`,
// мономорфизируется через MethodRouting::DeclaredBody с тем же C-именем.

module nova_tests.plan95bis

type User { id int, name str }

test "Option[int].unwrap_or" {
    ro some_i Option[int] = Some(42)
    ro none_i Option[int] = None
    assert(some_i ?? 0 == 42)
    assert(none_i ?? 99 == 99)
}

test "Option[str].unwrap_or" {
    ro some_s Option[str] = Some("hello")
    ro none_s Option[str] = None
    assert(some_s ?? "default" == "hello")
    assert(none_s ?? "default" == "default")
}

test "Option[char].unwrap_or" {
    ro some_c Option[char] = Some('A')
    ro none_c Option[char] = None
    assert(some_c ?? 'Z' == 'A')
    assert(none_c ?? 'Z' == 'Z')
}

test "Option[User].unwrap_or — non-primitive (lazy-emit path)" {
    ro some_u Option[User] = Some(User { id: 1, name: "Alice" })
    ro none_u Option[User] = None
    ro default_u = User { id: 0, name: "default" }
    assert(some_u ?? default_u.id == 1)
    assert(none_u ?? default_u.id == 0)
}
