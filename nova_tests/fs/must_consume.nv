// must_consume.nv — File is must-consume (D133): @close discharges and its Result
// is observable; a close error (mock ENOSPC injection) is NOT swallowed (§1a #1).
module nova_tests.fs

import std.fs.{Path, MemFs, mock_fs, Fs, File}
import std.io.{ErrorKind}

test "must-consume: File @close discharges and returns Ok" {
    mut fs = MemFs.new()
    with Fs = mock_fs(fs) {
        match File.create(Path.posix("/f.txt")) {
            Err(_) => assert(false)
            Ok(f0) => {
                mut f = f0
                match f.write("abc".to_bytes()) { Ok(n) => assert(n == 3), Err(_) => assert(false) }
                match f.close() { Ok(()) => assert(true), Err(_) => assert(false) }
            }
        }
    }
}

test "must-consume: close error (ENOSPC) is visible, not swallowed" {
    mut fs = MemFs.new()
    with Fs = mock_fs(fs) {
        match File.create(Path.posix("/f.txt")) {
            Err(_) => assert(false)
            Ok(f0) => {
                mut f = f0
                ro _ = f.write("data".to_bytes())
                fs.fail_closes()   // arm the next close to fail
                match f.close() {
                    Ok(())  => assert(false)
                    Err(e) => match e.kind { ErrorKind.StorageFull => assert(true), _ => assert(false) }
                }
            }
        }
    }
}
