// mock_atomic.nv — write_atomic durable replace + torn-write rollback via mock
// ENOSPC injection (Plan 176 Ф.2, D323 §3c).
module nova_tests.fs

import std.fs.{Path, MemFs, mock_fs, Fs, write, read_text, create_dir, write_atomic, try_exists}
import std.io.{ErrorKind}

test "mock_fs: write_atomic durable replace round-trip" {
    mut fs = MemFs.new()
    ro p = Path.posix("/cfg/app.conf")
    with Fs = mock_fs(fs) {
        ro _ = create_dir(Path.posix("/cfg"))
        match write_atomic(p, "v1".bytes()) { Ok(()) => assert(true), Err(_) => assert(false) }
        match read_text(p) { Ok(s) => assert(s == "v1"), Err(_) => assert(false) }
        match write_atomic(p, "v2-longer".bytes()) { Ok(()) => assert(true), Err(_) => assert(false) }
        match read_text(p) { Ok(s) => assert(s == "v2-longer"), Err(_) => assert(false) }
        match try_exists(Path.posix("/cfg/.app.conf.novatmp")) { Ok(b) => assert(b == false), Err(_) => assert(false) }
    }
}

test "mock_fs: torn-write injection -> write_atomic rolls back, temp removed" {
    mut fs = MemFs.new()
    ro p = Path.posix("/cfg2/data")
    with Fs = mock_fs(fs) {
        ro _ = create_dir(Path.posix("/cfg2"))
        ro _ = write(p, "original".bytes())
        fs.fail_writes()
        match write_atomic(p, "new".bytes()) {
            Ok(())  => assert(false)
            Err(e) => match e.kind { ErrorKind.StorageFull => assert(true), _ => assert(false) }
        }
        match read_text(p) { Ok(s) => assert(s == "original"), Err(_) => assert(false) }
        match try_exists(Path.posix("/cfg2/.data.novatmp")) { Ok(b) => assert(b == false), Err(_) => assert(false) }
    }
}
