// EXPECT_COMPILE_ERROR D133
// File is must-consume (D133): a File that is never @close'd is a compile error —
// the close error (ENOSPC/EIO/quota) cannot be silently dropped (§1a #1). Shown
// via a consume-param (the checker enforces consume on params + direct bindings;
// tracking through a Result/match extraction is a followup —
// [M-176-consume-through-result-match], shared with net's TcpStream).
module neg.d323_file_leak_neg

import std.fs.{File, Fs}

// `f` is a must-consume File; the body never @close's it → D133-not-consumed.
fn discard(consume f File) Fs -> () {
    ()
}
