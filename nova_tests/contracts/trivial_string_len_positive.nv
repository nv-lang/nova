// Ф.25.2 (Plan 33.6): string length non-negative — `s.len() >= 0` всегда true.
//
// Plan 182 Ф.3 DISPUTED (не тронуто): `str.len()` retired (D249, E_STR_NO_LEN).
// Механическая замена на `byte_len()` меняет характер теста — TrivialBackend
// (см. имя файла) более не может доказать `ensures result >= 0` для
// `byte_len()` (`#verify failed: trivial backend handles only
// tautologies/contradictions and simple linear-arith`), тогда как `len()`,
// по-видимому, был в allow-list тривиального бэкенда. Это либо (а) пробел
// компилятора (`byte_len` не в том же allow-list, что был у `len`), либо
// (б) тест изначально держался на спец-кейсе, которого для `byte_len` нет и
// не будет. Решение владельца нужно ДО правки — не гейтить на z3 втихую
// (поменяло бы смысл имени "trivial"), не удалять (единственный тривиальный
// non-negative-string-length репро). Оставлено RED как было.

module nova_tests.contracts

type Wrapper {
    data str,
}

#verify
fn data_len(w Wrapper) -> int
    ensures result >= 0
{
    w.data.len()
}

test "string len non-negative" {
    ro w = Wrapper { data: "hello" }
    assert(data_len(w) == 5)
}
