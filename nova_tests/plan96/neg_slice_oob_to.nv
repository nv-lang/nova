//
// Plan 96 Ф.4 — негатив: arr[0..100] где len==3 → panic.
// D-neg-panic: OOB → детерминированный panic (D13), не clamp.
// D239 ([]T≡Vec): сообщение паники `Vec: slice ... out of bounds for length N`
// (было `array: slice`). Директива выровнена под новый текст.

module nova_tests.plan96

test "neg slice oob to" panics "Vec: slice" {
    mut arr = [1, 2, 3]
    ro _ = arr[0..100]
}
