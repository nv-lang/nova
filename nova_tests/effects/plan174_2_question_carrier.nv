// Plan 174.2 Ф.B (POS) — cross-carrier `?` разрешения.
//
// `?` return-only (D85): носитель операнда обязан совпадать с носителем
// return-типа. Проверяем, что КАНОНИЧЕСКИЕ конверсии между носителями
// (`Option.ok_or(e)?` в Result-fn; `Result.ok()?` в Option-fn) компилируются
// и работают — т.е. диагностики Ф.B (E_TRY_OPTION_IN_RESULT_FN /
// E_TRY_RESULT_IN_OPTION_FN) НЕ ложно-срабатывают на правильном коде.
// Spec: spec/decisions/04-effects.md (D85).
module nova_tests.effects

type Er { code int }

fn r_ok() -> Result[int, Er] => Ok(21)
fn r_err() -> Result[int, Er] => Err(Er { code: 7 })

fn o_some() -> Option[int] => Some(4)
fn o_none() -> Option[int] => None

// Result-`?` в Result-fn — носители совпали.
fn same_result(fail bool) -> Result[int, Er] {
    ro a = r_ok()?
    if fail { ro b = r_err()?; Ok(b) } else { Ok(a + 1) }
}

// Option-`?` в Option-fn — носители совпали.
fn same_option(none bool) -> Option[int] {
    ro a = o_some()?
    if none { ro b = o_none()?; Some(b) } else { Some(a + 1) }
}

// Option → Result через `.ok_or(e)?` в Result-fn (канон конверсии).
fn opt_to_result(none bool) -> Result[int, Er] {
    ro src = if none { o_none() } else { o_some() }
    ro v = src.ok_or(Er { code: 99 })?
    Ok(v * 10)
}

// Result → Option через `.ok()?` в Option-fn (канон конверсии).
fn result_to_opt(fail bool) -> Option[int] {
    ro src = if fail { r_err() } else { r_ok() }
    ro v = src.ok()?
    Some(v + 100)
}

test "Result-`?` в Result-fn — носители совпали (D85 return-only)" {
    assert((same_result(false) ?? -1) == 22)
    assert((same_result(true) ?? -1) == -1)
}

test "Option-`?` в Option-fn — носители совпали (D85 return-only)" {
    assert((same_option(false) ?? -1) == 5)
    assert((same_option(true) ?? -1) == -1)
}

test "Option→Result: `.ok_or(e)?` в Result-fn компилируется и работает" {
    assert((opt_to_result(false) ?? -1) == 40)
    assert((opt_to_result(true) ?? -1) == -1)   // None → Err(code 99) → -1
}

test "Result→Option: `.ok()?` в Option-fn компилируется и работает" {
    assert((result_to_opt(false) ?? -1) == 121)
    assert((result_to_opt(true) ?? -1) == -1)   // Err → None → -1
}
