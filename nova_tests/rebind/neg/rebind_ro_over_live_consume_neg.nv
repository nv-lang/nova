// Plan 181 (D347) R2 — затенение НЕпотреблённого consume-обязательства.
// `consume b` объявляет obligation; `b.touch()` НЕ потребляет (не consume-метод);
// `ro b = 5` затенил бы живое обязательство → hard error E_REBIND_LIVE_CONSUME
// на месте re-binding (диагностика на точке rebind, не отложенный D133 на exit).
//
// EXPECT_COMPILE_ERROR E_REBIND_LIVE_CONSUME

module neg.rebind_ro_over_live_consume_neg

type NRbBox consume {
    v int,
}
fn NRbBox consume @close() -> () { () }
fn NRbBox @touch() -> () { () }

test "should not compile" {
    consume b = NRbBox { v: 1 }
    b.touch()          // не потребляет b — obligation жив
    ro b = 5           // rebind скрыл бы живое consume-обязательство
    assert(b == 5)
}
