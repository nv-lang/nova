// Plan 52.1 Ф.4: user-локальный тип с `#from_pairs` + правильными
// методами (new, cap, insert_new — D372 amend 2026-07-06: with_capacity
// removed, extensibility contract now checks `new`+`cap` instead) ДОЛЖЕН
// поддерживать литерал `[k: v]`.
//
// Type-checker валидирует наличие требуемых методов перед добавлением
// в from_pairs_types. Без validation user получил бы CC-error
// 'no method new' / 'no method cap' — confusing. С validation либо тип
// работает, либо silently fallback на HashMap (требует mismatch).
//
// Здесь определяем MyBag — простой wrapper над int counter (не
// настоящая мапа), но с правильной сигнатурой методов. Литерал
// должен десугариться через MyBag.new() + .cap(n) + insert_new.
module nova_tests.map_literals

#from_pairs
type MyBag[K, V] {
    count int
}

export fn MyBag[K, V].new() -> MyBag[K, V] {
    MyBag { count: 0 }
}

export fn MyBag[K, V] mut @cap(n int) -> @ {}

export fn MyBag[K, V] mut @insert_new(k K, v V) {
    @count += 1
}

export fn MyBag[K, V] @len() -> int => @count

test "user MyBag через literal — корректное число вставок" {
    ro m MyBag[int, str] = [1: "a", 2: "b", 3: "c"]
    assert(m.len() == 3)
}

test "user MyBag через literal — empty case без literal" {
    ro m = MyBag[int, str].new()
    assert(m.len() == 0)
}
