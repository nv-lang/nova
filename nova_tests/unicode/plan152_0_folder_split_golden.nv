// Plan 152.0 — acceptance fixtures.
// A0.1: methods from ALL co-equal submodules (core/search/transform/parse/chars)
//   resolve without explicit import (folder-split conforms D29; str-resolve from .nv).
// A0.5: golden byte-equivalence for the buffer-refactored methods (trim/concat/to_bytes).
// A0.6: StringBuilder and str.concat give identical results (shared Vec[u8] buffer).
module nova_tests.unicode

test "core submodule: byte_len / as_bytes / is_empty / compare" {
    ro s = "héllo"
    assert(s.byte_len() == 6)          // h + é(2) + l + l + o
    assert(s.bytes()[0] == 104)     // 'h'
    assert("".is_empty())
    assert("a".compare("b") < 0)
}

test "search submodule: find / contains / starts_with / split" {
    assert("abcabc".find("bc") == Some(1))
    assert("hello".contains("ell"))
    assert("hello".starts_with("he"))
    ro parts = "a,b,c".split(",").collect()
    assert(parts.len() == 3)
    assert(parts[0] == "a")
    assert(parts[2] == "c")
}

test "transform submodule (Ф.3 buffer-refactor golden): trim / concat / to_bytes / case" {
    assert("  hi  ".trim_ascii() == "hi")          // trim via Vec.append+steal
    assert("ab".concat("cd") == "abcd")      // concat via Vec.append+steal
    assert("Foo".to_ascii_lower() == "foo")
    assert("Foo".to_ascii_upper() == "FOO")
    ro b = "abc".bytes()                  // to_bytes via Vec.append
    assert(b.len() == 3)
    assert(b[0] == 97)
}

test "parse submodule: parse_int / ParseIntError path" {
    assert("42".to_int().ok() == Some(42))
    assert("ff".to_int(radix: 16).ok() == Some(255))
    assert("xyz".to_int().ok() == None)
}

test "chars submodule: позиционный доступ через next()-drain (nth ретрактирован)" {
    // D249/D250 + D260-амендмент: retired char_at/get(int) → codepoint-линза;
    // сам @nth тоже ретрактирован (2026-07-07) — позиционный доступ = целевая
    // итерация (for-in/next-drain), не скрытый O(n) random-access.
    mut g0 = "abc".chars()
    assert(g0.next() == Some('a'))
    mut g9 = "abc".chars()
    mut g9_i = 0
    mut g9_last Option[char] = None
    while g9_i <= 9 {
        g9_last = g9.next()
        if g9_last == None { break }
        g9_i += 1
    }
    assert(g9_last == None)
}

test "A0.6: StringBuilder (Vec[u8] wrapper) == str.concat" {
    ro via_sb = StringBuilder.from("ab").append("cd").into_str()
    assert(via_sb == "ab".concat("cd"))
    assert(via_sb == "abcd")
}
