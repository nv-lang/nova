// Plan 152.1 Ф.3 (D250): CharsIter — codepoint decoding lens. chars() yields a
// stream (Next[char]+Iter), NOT a collection: count() O(n), no Index[int];
// @nth ретрактирован (D260-амендмент 2026-07-07) — позиционный доступ = целевая
// итерация (for-in + счётчик / next()-drain).
// for c in s decodes codepoints (D58 amend, str @iter() => @chars()).
module nova_tests.unicode

test "chars().count(): ASCII + multibyte (codepoints, not bytes)" {
    assert("hello".chars().count() == 5)
    assert("héllo".chars().count() == 5)   // 5 codepoints, 6 bytes
    assert("héllo".byte_len() == 6)
    assert("".chars().count() == 0)
}

test "chars().is_empty()" {
    assert("héllo".chars().is_empty() == false)
    assert("".chars().is_empty() == true)
}

test "позиционный codepoint через enumerate-стиль (nth ретрактирован)" {
    ro s = "héllo"
    // Собираем позиции целевой итерацией — эквивалент бывших nth(0..4).
    mut idx = 0
    mut c0 = ' '
    mut c1 = ' '
    mut c2 = ' '
    mut c4 = ' '
    for c in s.chars() {
        if idx == 0 { c0 = c }
        if idx == 1 { c1 = c }
        if idx == 2 { c2 = c }
        if idx == 4 { c4 = c }
        idx += 1
    }
    assert(c0 == 'h')
    assert(c1 == 'é')
    assert(c2 == 'l')
    assert(c4 == 'o')
    assert(idx == 5)          // всего 5 codepoints — «nth(5) == None»
}

test "for c in s decodes codepoints (str @iter => as_chars)" {
    ro s = "héllo"
    mut count = 0
    mut last = ' '
    for c in s {
        count = count + 1
        last = c
    }
    assert(count == 5)        // codepoints, not 6 bytes
    assert(last == 'o')
}

test "for c in s.chars() (explicit lens, Iter self)" {
    mut n = 0
    for c in "abc".chars() {
        n = n + 1
    }
    assert(n == 3)
}

test "chars() walks first/last codepoint of multibyte" {
    ro s = "héllo"
    mut first = ' '
    mut seen = false
    for c in s {
        if !seen { first = c; seen = true }
    }
    assert(first == 'h')
}

test "4-byte codepoint (emoji)" {
    ro s = "a😀b"            // a(1) + 😀(4) + b(1) = 6 bytes, 3 codepoints
    assert(s.byte_len() == 6)
    assert(s.chars().count() == 3)
    mut it = s.chars()
    ro _ = it.next()          // пропустить 'a' (бывший nth(1))
    assert(it.next() == Some('😀'))
}
