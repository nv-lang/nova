//
// Plan 33.1 Ф.4 (D24): nova_contract_violation срабатывает при
// нарушении requires в runtime (debug сборка).

module nova_tests.runtime_panics

fn must_be_positive(x int) -> int
    requires x > 0
=> x * 2

test "contracts requires fail" panics "requires failed: x > 0" {
    ro _ = must_be_positive(-5)
    println("UNREACHABLE")
}
