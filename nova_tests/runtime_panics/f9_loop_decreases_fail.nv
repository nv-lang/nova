//
// Plan 33.3 Ф.9.8: loop body не decrement'ит decreases-измеритель →
// runtime assert_static panic в debug.

module nova_tests.runtime_panics

fn f9_loop_decreases_fail_bad_loop(n int) -> int {
    mut i = n
    mut iter = 0
    while iter < 1
        decreases i
    {
        // i не меняется → decreases не уменьшается → violation.
        iter = iter + 1
    }
    i
}

test "f9 loop decreases fail" panics "requires failed:" {
    ro _ = f9_loop_decreases_fail_bad_loop(5)
    println("UNREACHABLE")
}
