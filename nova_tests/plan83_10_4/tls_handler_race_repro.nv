// tls_handler_race_repro.nv — Plan 83.10.4 Ф.3 race reproduction test
//
// Stress-tests handler isolation under concurrent load to confirm the
// TLS race does NOT recur after the per-thread registry fix.
//
// Scenario: many fibers concurrently install handlers with unique values,
// read back their own value, and assert correctness. Under the old global
// registry, workers would read each other's handler state and see wrong values.
//
// This is intentionally run WITHOUT AUTOARM=0 to exercise full M:N scheduling.

module nova_tests.plan83_10_4

fn handler_value(v int) -> int {
    with Time = effect Time {
        sleep(_d) { return () }
        now() { return v.to_unix_millis() }
    } {
        Timestamp.now().unix_millis()
    }
}

// ================================================================
// SECTION 1: 8 fibers — each with unique handler value
// ================================================================

test "race repro: 8 concurrent fibers, unique handlers, no cross-contamination" {
    mut r0 = AtomicInt.new(-1)
    mut r1 = AtomicInt.new(-1)
    mut r2 = AtomicInt.new(-1)
    mut r3 = AtomicInt.new(-1)
    mut r4 = AtomicInt.new(-1)
    mut r5 = AtomicInt.new(-1)
    mut r6 = AtomicInt.new(-1)
    mut r7 = AtomicInt.new(-1)
    supervised {
        spawn { r0.store(handler_value(100)) }
        spawn { r1.store(handler_value(200)) }
        spawn { r2.store(handler_value(300)) }
        spawn { r3.store(handler_value(400)) }
        spawn { r4.store(handler_value(500)) }
        spawn { r5.store(handler_value(600)) }
        spawn { r6.store(handler_value(700)) }
        spawn { r7.store(handler_value(800)) }
    }
    assert(r0.load() == 100)
    assert(r1.load() == 200)
    assert(r2.load() == 300)
    assert(r3.load() == 400)
    assert(r4.load() == 500)
    assert(r5.load() == 600)
    assert(r6.load() == 700)
    assert(r7.load() == 800)
}

// ================================================================
// SECTION 2: Inherited + per-fiber combined in same supervised block
// ================================================================

test "race repro: inherited outer + per-fiber override — no contamination" {
    mut outer0 = AtomicInt.new(-1)
    mut outer1 = AtomicInt.new(-1)
    mut inner0 = AtomicInt.new(-1)
    mut inner1 = AtomicInt.new(-1)
    with Time = effect Time {
        sleep(_d) { return () }
        now() { return 999.to_unix_millis() }
    } {
        supervised {
            spawn { outer0.store(Timestamp.now().unix_millis()) }           // inherits 999
            spawn { inner0.store(handler_value(111)) }   // overrides to 111
            spawn { outer1.store(Timestamp.now().unix_millis()) }           // inherits 999
            spawn { inner1.store(handler_value(222)) }   // overrides to 222
        }
    }
    assert(outer0.load() == 999)
    assert(outer1.load() == 999)
    assert(inner0.load() == 111)
    assert(inner1.load() == 222)
}

// ================================================================
// SECTION 3: Outer handler survives after supervised block
// ================================================================

test "race repro: outer handler intact after supervised completes" {
    mut before = -1
    mut after = -1
    with Time = effect Time {
        sleep(_d) { return () }
        now() { return 12345.to_unix_millis() }
    } {
        before = Timestamp.now().unix_millis()
        supervised {
            spawn { ro _ = handler_value(1) }
            spawn { ro _ = handler_value(2) }
            spawn { ro _ = handler_value(3) }
        }
        after = Timestamp.now().unix_millis()
    }
    assert(before == 12345)
    assert(after == 12345)
}
