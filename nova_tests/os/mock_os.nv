// mock_os.nv — in-memory Os handler: env / args / cwd / exit round-trips
// (Plan 176 Ф.3, D324). Deterministic, no real process environment.
module nova_tests.os

import std.os.{MockOs, mock_os, Os, get_env, get_env_bytes, set_env, set_env_bytes, remove_env, has_env, vars, args, current_dir, set_current_dir, home_dir, temp_dir, pid, hostname, exit_process}
import std.fs.{Path}

test "mock_os: env set/get/has/overwrite/remove round-trip" {
    mut os = MockOs.new()
    with Os = mock_os(os) {
        assert(!has_env("X"))
        ro _ = set_env("X", "1")
        assert(has_env("X"))
        match get_env("X") { Some(v) => assert(v == "1"), None => assert(false) }
        ro _ = set_env("X", "2")
        match get_env("X") { Some(v) => assert(v == "2"), None => assert(false) }
        ro _ = remove_env("X")
        assert(!has_env("X"))
        match get_env("X") { Some(_) => assert(false), None => assert(true) }
    }
}

test "mock_os: byte-correct value + vars snapshot + args" {
    mut os = MockOs.new()
    os.push_arg("prog")
    os.push_arg("a")
    with Os = mock_os(os) {
        mut raw []u8 = []u8.new()
        raw.push(0xFF as u8); raw.push(0xFE as u8)
        ro _ = set_env_bytes("B".to_bytes(), raw)
        match get_env_bytes("B".to_bytes()) {
            Some(b) => { assert(b.len() == 2); assert(b[0] == (0xFF as u8)); assert(b[1] == (0xFE as u8)) }
            None    => assert(false)
        }
        ro vs = vars()
        assert(vs.len() == 1)
        assert(vs[0].key() == "B")
        ro a = args()
        assert(a.len() == 2 && a[0] == "prog" && a[1] == "a")
    }
}

test "mock_os: cwd get/set, home, pid, hostname, exit recorded" {
    mut os = MockOs.new()
    with Os = mock_os(os) {
        match current_dir() { Ok(p) => assert(p.display() == "/"), Err(_) => assert(false) }
        ro _ = set_current_dir(Path.posix("/tmp/work"))
        match current_dir() { Ok(p) => assert(p.display() == "/tmp/work"), Err(_) => assert(false) }
        assert(temp_dir().display() == "/tmp")
        match home_dir() { Some(h) => assert(h.display() == "/home/user"), None => assert(false) }
        assert(pid() == 4242)
        match hostname() { Ok(h) => assert(h == "localhost"), Err(_) => assert(false) }
        exit_process(7)
    }
    assert(os.did_exit() && os.exit_code() == 7)
}
