// Plan 184 (Р13/Р14) — режим параметра {ro, mut, consume} как ОСЬ ПЕРЕГРУЗКИ.
// Диспатч: ro-аргумент → ro-версия; mut-биндинг → mut-версия (приоритетнее ro,
// прецедент ресивера план-135); owned-временное (последняя точка использования)
// → consume-версия. Кучевой T: все три ABI-идентичны (Р6: ref H ≡ H) и
// различаются ТОЛЬКО режимом → перегрузка чисто по оси режима.
module inout_ref.p184_mode_overload_pos

type Box { v int }
fn Box.new(n int) -> Box => { v: n }
// Терминальный consume-потребитель (D131/D133) для consume-перегрузки.
fn Box consume @sink() -> int => 3

// Тройная ось режима на обычном параметре.
fn tag(x Box) -> int => 1                // ro (default)
fn tag(mut x Box) -> int => 2            // mut
fn tag(consume x Box) -> int => x.sink() // consume → 3

// Пара ro/mut (без consume).
fn kind(x Box) -> int => 10
fn kind(mut x Box) -> int => 20

// Смешение с receiver-осью (Р14: `@` = нулевой параметр).
fn Box @combo(x Box) -> int => 100
fn Box mut @combo(mut x Box) -> int => 200

test "ro binding dispatches to ro overload (Р14)" {
    ro b = Box.new(0)
    assert(tag(b) == 1)
}

test "mut binding dispatches to mut overload (Р14)" {
    mut b = Box.new(0)
    assert(tag(b) == 2)
}

test "owned temporary dispatches to consume overload (Р14)" {
    assert(tag(Box.new(0)) == 3)
}

test "ro/mut pair: ro binding -> ro (Р14)" {
    ro b = Box.new(0)
    assert(kind(b) == 10)
}

test "ro/mut pair: mut binding -> mut preferred over ro (Р14)" {
    mut b = Box.new(0)
    assert(kind(b) == 20)
}

test "receiver-axis + param-axis: ro recv + ro arg -> ro/ro (Р14)" {
    ro a = Box.new(0)
    ro b = Box.new(0)
    assert(a.combo(b) == 100)
}

test "receiver-axis + param-axis: mut recv + mut arg -> mut/mut (Р14)" {
    mut a = Box.new(0)
    mut b = Box.new(0)
    assert(a.combo(b) == 200)
}
