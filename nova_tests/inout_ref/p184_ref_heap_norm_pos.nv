// Plan 184 (Р6) — нормализация `ref H ≡ H` для кучевого H в тип-аргументе:
// `f[ref H]` легален И тождественен `f[H]` (значение уже handle, ссылка на
// handle не вводится). Плюс downward-заём `&v` в вызов (Р8 legal-путь).
module inout_ref.p184_ref_heap_norm_pos

type Node {
    v int
}
fn Node.new(x int) -> Node => { v: x }

// Generic identity — размер/представление одинаковы для H и ref H (Р6).
fn tag[T]() -> int => 7

// Downward `&v` (заём вниз по стеку) — легально (Р8(б), ffi-канон).
fn read_at(p *int) -> int => 0

test "f[ref H] equals f[H] for heap H (Р6 normalization)" {
    ro a = tag[Node]()
    ro b = tag[ref Node]()
    assert(a == b)
    assert(b == 7)
}

test "downward &v to a *int sink is legal (Р8 downward borrow)" {
    mut n = 5
    ro r = read_at(&n)
    assert(r == 0)
    assert(n == 5)
}
