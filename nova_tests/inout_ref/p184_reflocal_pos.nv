// Plan 184 (Р1, Ф.1-остаток) — ref-локалы: именованный указатель-алиас.
// `ro y ref T = <place>` — read-alias; `mut y ref T = <place>` — write-through
// (запись через алиас достигает целевого хранилища, как C++ `T& y`).
module inout_ref.p184_reflocal_pos

type Vec3 value {
    x f64
    y f64
    z f64
}
fn Vec3.new(a f64, b f64, c f64) -> Vec3 => { x: a, y: b, z: c }

test "ro ref-local reads alias target (Р1)" {
    mut v = Vec3.new(1.0, 2.0, 3.0)
    ro r ref f64 = v.y
    assert(r == 2.0)
}

test "mut ref-local write reaches target (Р1 write-through)" {
    mut v = Vec3.new(1.0, 2.0, 3.0)
    mut r ref f64 = v.x
    r = 42.0
    assert(v.x == 42.0)
    assert(v.y == 2.0)
    assert(v.z == 3.0)
}

test "mut ref-local accumulate through alias" {
    mut n = 10
    mut a ref int = n
    a = a + 5
    a = a + 7
    assert(n == 22)
}
