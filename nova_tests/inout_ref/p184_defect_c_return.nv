// Plan 184 Ф.2 acceptance — [M-184-mut-chain-return-position].
// A `value`-record fluent `mut @setter(v) -> @` chain in RETURN position must
// initialise the returned VALUE from the fleeting `ref Self` pointer (Р7: a
// value-record `-> @` returns `NovaValue_X*`). The by-value return consumer
// (implicit trailing-expr return AND explicit `return`) must deref it — the
// `ref T -> T` auto-conversion (Р5) — mirroring the let-binding and call-arg
// consumers via the shared `is_fluent_value_ptr_for_target` predicate.
//
// Before the fix, codegen emitted `NovaValue_Rec _nv_tmp = Nova_Rec_method_d(…)`
// — a pointer assigned to a value slot — a hard CC-FAIL. Depth 4 exercises the
// full chain: root materialise (`&_nv_tmp`), inner `ref Self` passthrough, and
// the final value-consumer deref.
//
// Exercised inside plain `fn`s (NOT `test` blocks): the return-position lowering
// is only reachable from a real function body.
module inout_ref.p184_defect_c_return

type Rec value {
    a int
    b int
    c int
    d int
}

fn Rec.new(a int, b int, c int, d int) -> Rec => { a, b, c, d }

fn Rec mut @a(v int) -> @ { @a = v }
fn Rec mut @b(v int) -> @ { @b = v }
fn Rec mut @c(v int) -> @ { @c = v }
fn Rec mut @d(v int) -> @ { @d = v }

// Depth-4 chain as the trailing (implicit-return) expression.
fn build_trailing() -> Rec {
    Rec.new(0, 0, 0, 0).a(1).b(2).c(3).d(4)
}

// Depth-4 chain via an explicit `return`.
fn build_explicit() -> Rec {
    return Rec.new(0, 0, 0, 0).a(1).b(2).c(3).d(4)
}

test "depth-4 mut-setter chain as trailing return — all four mutations land" {
    ro r = build_trailing()
    assert(r.a == 1)
    assert(r.b == 2)
    assert(r.c == 3)
    assert(r.d == 4)
}

test "depth-4 mut-setter chain via explicit return — all four mutations land" {
    ro r = build_explicit()
    assert(r.a == 1)
    assert(r.b == 2)
    assert(r.c == 3)
    assert(r.d == 4)
}
