// EXPECT_COMPILE_ERROR E_REF_PARAM_FORM_REMOVED
//
// D326-ревизия (Plan 184 Р3/Р10): форма `mut ref x T` в параметре удалена —
// `ref` больше не пишется в сигнатуре. Пишите `mut x T` (in-out ссылка всегда).
module neg.param_form_mut_ref

fn inc(mut ref a int) { a = a + 1 }

test "mut ref param form removed" {
    mut x = 0
    inc(x)
    assert(true)
}
