module pos.d326_mut_ref_basic

fn inc(mut ref a int) {
    a = a + 1
}

fn swap(mut ref a int, mut ref b int) {
    ro t = a
    a = b
    b = t
}

test "mut ref primitive in place" {
    mut x = 5
    inc(ref x)
    assert(x == 6)
}

test "swap via two mut ref" {
    mut p = 1
    mut q = 2
    swap(ref p, ref q)
    assert(p == 2 && q == 1)
}
