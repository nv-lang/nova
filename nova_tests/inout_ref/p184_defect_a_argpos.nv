// Plan 184 Ф.2 acceptance — [M-http-props-mut-chain-argpos-value-ptr-mismatch].
// A fleeting `-> @` chain-result on a value-type receiver used directly as a
// call argument must compile (ref Self auto-derefs to T at the value arg
// position, Р5) and be correct.
module inout_ref.p184_defect_a_argpos

type Rec value {
    ro a int
    b   int
}

fn Rec.new(a int, b int) -> Rec => { a, b }

fn Rec mut @b(v int) -> @ {
    @b = v
}

fn take(r Rec) -> int => r.b

test "mut-chain result as a direct call argument — compiles and correct" {
    mut r = Rec.new(1, 0)
    ro got = take(r.b(5))
    assert(got == 5)
    assert(r.b == 5)
}
