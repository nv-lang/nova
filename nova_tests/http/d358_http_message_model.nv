// SPDX-License-Identifier: CC-BY-4.0
// D358 — HTTP message-model (Plan 178 Ф.1). Conformance: Method(token+Other),
// StatusCode(u16+классы+reason), HeaderMap(case-insens/ordered/multi + CRLF/NUL-
// reject + CL/TE-smuggling), Version, host/URL-валидатор (SSRF obfuscation-reject),
// Cookie send-инварианты, HttpError(OPEN ErrorKind + source-chain). Один
// folder-module `spec_tests.conformance`.
module nova_tests.http

import std.http.{Method, StatusCode, Version, HeaderMap, Mime, ContentType, Cookie, SetCookie, Url, HttpError, ErrorKind}


test "D358 Method: token round-trip + Other + idempotency" {
    ro g = Method.parse("GET")!!
    assert(g.as_str() == "GET")
    assert(g.is_idempotent())
    ro pf = Method.parse("PROPFIND")!!
    assert(match pf { Other(s) => s == "PROPFIND", _ => false })
    assert(match Method.parse("bad token") { Ok(_) => false, Err(_) => true })
}

test "D358 StatusCode: class/reason + range guard" {
    ro nf = StatusCode.not_found()
    assert(nf.as_u16() == 404)
    assert(nf.reason() == "Not Found")
    assert(match nf.class() { ClientError => true, _ => false })
    assert(match StatusCode.new(700) { Ok(_) => false, Err(_) => true })
}

test "D358 Version: as_str" {
    ro v = Version.Http11
    assert(v.as_str() == "HTTP/1.1")
}

test "D358 HeaderMap: case-insensitive multi-value + CRLF/NUL reject" {
    mut h = HeaderMap.new()
    ro r1 = h.append("Set-Cookie", "a=1")
    ro r2 = h.append("set-cookie", "b=2")
    assert(h.get_all("SET-COOKIE").len() == 2)
    // response-splitting defense: CR/LF/NUL in value → reject
    assert(match h.append("X", "v\r\nInjected: 1") { Ok(_) => false, Err(_) => true })
    assert(match h.append("Bad Name", "v") { Ok(_) => false, Err(_) => true })
}

test "D358 HeaderMap: CL + TE conflict → Protocol (smuggling)" {
    mut h = HeaderMap.new()
    ro r1 = h.append("Content-Length", "5")
    ro r2 = h.append("Transfer-Encoding", "chunked")
    assert(match h.content_length() { Ok(_) => false, Err(_) => true })
}

test "D358 host-validator: SSRF IP-obfuscation rejected" {
    assert(match Url.parse("http://0x7f.0.0.1/") { Ok(_) => false, Err(_) => true })
    assert(match Url.parse("http://0177.0.0.1/") { Ok(_) => false, Err(_) => true })
    assert(match Url.parse("http://2130706433/") { Ok(_) => false, Err(_) => true })
    ro ok = Url.parse("http://[::1]:80/")!!
    assert(ok.host == Some("::1"))
    assert(ok.is_private_target())
}

test "D358 Cookie: SetCookie send-invariants enforced" {
    ro sc = SetCookie.parse("__Secure-x=1; Secure; SameSite=Lax")!!
    assert(sc.secure)
    assert(!sc.is_sendable(false))
    assert(match SetCookie.parse("a=b; SameSite=None") { Ok(_) => false, Err(_) => true })
}

test "D358 HttpError: OPEN ErrorKind + source-chain" {
    ro e = match Url.parse("no-scheme.example") { Ok(_) => HttpError.protocol_error("x"), Err(er) => er }
    // wildcard-arm обязателен (OPEN ErrorKind)
    assert(match e.kind { InvalidUrl => true, _ => false })
    assert(e.to_str().byte_len() > 0)
}
