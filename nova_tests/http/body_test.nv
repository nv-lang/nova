// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 178 Ф.1 — Body must-consume (positive discharge) + Request/Response + HttpError.
//
// АНКОР (Plan 182 Ф.2, 2026-07-07): НЕ мигрирован в std/http — как
// `module std.http` (folder-shared CU) реально ЛЮБОЙ `test{}`-блок в этом
// файле (вкл. пустой no-op) валит компилятор: [P67-LEGACY] `Ident \`msg\`
// not in var_types` (emit_c.rs:43828), т.к. появление теста в std.http
// переводит модуль из library/import-режима (DCE не эмитит недостижимое) в
// executable-режим — и латентный баг в конструкторах HttpError (Protocol(msg)
// и, по-видимому, любой message-payload ErrorKind variant) становится
// достижим. Минимальный репро: `module std.http` + `test "x" {
// HttpError.protocol_error("x") }`. В `module nova_tests.http`
// (import-режим) тот же код зелёный. Разморозить после фикса компилятора.

module nova_tests.http

import std.http.{Body, BodyReader, Request, Response, Method, StatusCode, Url, HeaderMap, HttpError, ErrorKind}

test "body: from_bytes/from_str discharge via bytes/text" {
    consume b1 = Body.from_bytes("hello".bytes())
    assert(b1.bytes()!!.len == 5)
    consume b2 = Body.from_str("héllo")
    assert(b2.text()!! == "héllo")
}

test "body: stream reader drains in order" {
    mut chunks = Vec[[]u8].new()
    chunks.push("ab".bytes())
    chunks.push("cd".bytes())
    consume b = Body.from_reader(BodyReader.from_chunks(chunks))
    assert(b.bytes()!!.len == 4)
}

test "body: with_limit → BodyTooLarge" {
    consume b = Body.from_bytes("0123456789".bytes()).with_limit(4)
    assert(match b.bytes() { Ok(_) => false, Err(e) => match e.kind { BodyTooLarge => true, _ => false } })
}

test "body: text rejects invalid UTF-8" {
    mut bad = Vec[u8].new()
    bad.push(0xFF as u8)
    bad.push(0xFE as u8)
    consume b = Body.from_bytes(bad)
    assert(match b.text() { Ok(_) => false, Err(_) => true })
}

test "response: delegating discharge (must-consume body)" {
    ro h = HeaderMap.new()
    consume resp = Response.new(StatusCode.ok(), h, "hi".bytes())
    assert(resp.is_success())
    assert(resp.status().as_u16() == 200)
    assert(resp.text()!! == "hi")
}

test "request: build + drain" {
    ro u = Url.parse("http://x/")!!
    ro h = HeaderMap.new()
    consume req = Request.new(Method.Post, u, h, "payload".bytes())
    assert(match req.method() { Post => true, _ => false })
    assert(req.body_bytes()!!.len == 7)
}

test "httperror: kind + source-chain + to_str" {
    ro e = HttpError.protocol_error("bad line")
    assert(match e.kind { Protocol(m) => m == "bad line", _ => false })
    // InvalidUrl carries a ParseUrlError source (source-chaining)
    ro ue = match Url.parse("nope") { Ok(_) => HttpError.protocol_error("x"), Err(e2) => e2 }
    assert(match ue.kind { InvalidUrl => true, _ => false })
    assert(ue.to_str().byte_len() > 0)
}
