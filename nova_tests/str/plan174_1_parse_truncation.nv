// Plan 174.1 §4 (D309) — фикс truncation-бага для sub-width целых.
//
// Корень: str→int движок парсит в i64/u64; narrowing к sub-width T
// (i8/i16/i32/u8/u16/u32) делался СЫРЫМ C-кастом без range-check →
// i8.try_from(999) молча давал Ok(-25) (C-truncation) вместо ошибки.
// Фикс: range-check перед кастом (emit_c emit_parse_range_check) — out-of-
// range → Err (try_from) / None (try_parse).
//
// Peer-файл темы nova_tests.str (§5 раскладка 174.1). value-equality asserts
// на sub-width Result опущены — hardcode-Result (Ok=nova_int/Err=nova_str)
// имеет отдельный pre-existing лимит сравнения sized-payload (не задача 174.1
// §4); проверяем ключевое: out-of-range классифицируется как Err/None.
module nova_tests.str


// ───── try_from: out-of-range → Err (было silent Ok(truncated)) ─────

test "i8 try_from 999 overflow to Err" {
    ro r = i8.try_from("999")
    assert(r.is_err())
}

test "i8 try_from 127 upper boundary Ok" {
    ro r = i8.try_from("127")
    assert(r.is_ok())
}

test "i8 try_from -128 lower boundary Ok" {
    ro r = i8.try_from("-128")
    assert(r.is_ok())
}

test "i8 try_from 128 one-over-max Err" {
    ro r = i8.try_from("128")
    assert(r.is_err())
}

test "i16 try_from 40000 overflow Err" {
    ro r = i16.try_from("40000")
    assert(r.is_err())
}

test "i16 try_from 32767 boundary Ok" {
    ro r = i16.try_from("32767")
    assert(r.is_ok())
}

test "i32 try_from 5000000000 overflow Err" {
    ro r = i32.try_from("5000000000")
    assert(r.is_err())
}

test "i32 try_from 2147483647 boundary Ok" {
    ro r = i32.try_from("2147483647")
    assert(r.is_ok())
}

test "u8 try_from 256 overflow Err" {
    ro r = u8.try_from("256")
    assert(r.is_err())
}

test "u8 try_from 255 boundary Ok" {
    ro r = u8.try_from("255")
    assert(r.is_ok())
}

test "u16 try_from 70000 overflow Err" {
    ro r = u16.try_from("70000")
    assert(r.is_err())
}

test "u32 try_from 5000000000 overflow Err" {
    ro r = u32.try_from("5000000000")
    assert(r.is_err())
}

test "u32 try_from 4294967295 boundary Ok" {
    ro r = u32.try_from("4294967295")
    assert(r.is_ok())
}


// ───── full-width не задет range-check'ом (движковый overflow-guard) ─────

test "int try_from large valid Ok" {
    ro r = int.try_from("9000000000000000000")
    assert(r.is_ok())
}

test "int try_from overflow Err via engine" {
    ro r = int.try_from("99999999999999999999999")
    assert(r.is_err())
}


// ───── try_parse (Option-форма): out-of-range → None (было Some(truncated)) ─────

test "i8 try_parse 999 to None" {
    ro r = i8.try_parse("999")
    assert(r.is_none())
}

test "i8 try_parse 100 to Some" {
    ro r = i8.try_parse("100")
    assert(r.is_some())
}

test "u8 try_parse 300 to None" {
    ro r = u8.try_parse("300")
    assert(r.is_none())
}

test "u8 try_parse 42 to Some" {
    ro r = u8.try_parse("42")
    assert(r.is_some())
}
