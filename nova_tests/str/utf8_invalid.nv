// utf8_invalid.nv — Plan 75 Ф.6, reformulated Plan 176 Ф.0.5.
//
// []u8.to_str() с невалидными UTF-8 байтами → Err(Utf8Error{byte_offset}).
// Реализация: Nova-body str.from_bytes (std/runtime/string/core.nv) прогоняет
// first_invalid_utf8; при ошибке → Err(Utf8Error{byte_offset}), str НЕ строится
// (R-UTF8). Заменяет retired-интринзик str.try_from([]u8).

module nova_tests.str

test "lone continuation byte is invalid UTF-8" {
    // 0x80 сам по себе — continuation byte без leading byte: invalid.
    mut arr []u8 = []u8.new()
    arr.push(0x80 as u8)
    assert(arr.to_str().is_err())
}

test "0xFF byte is always invalid UTF-8" {
    // 0xFF никогда не встречается в корректном UTF-8.
    mut arr []u8 = []u8.new()
    arr.push(0xFF as u8)
    assert(arr.to_str().is_err())
}

test "overlong encoding is invalid UTF-8" {
    // 0xC0 0x80 — overlong encoding нулевого символа (Modified UTF-8, не стандарт).
    mut arr []u8 = []u8.new()
    arr.push(0xC0 as u8)
    arr.push(0x80 as u8)
    assert(arr.to_str().is_err())
}

test "incomplete multibyte sequence is invalid UTF-8" {
    // 0xC3 без следующего continuation byte — неполная 2-байтная последовательность.
    mut arr []u8 = []u8.new()
    arr.push(0xC3 as u8)
    assert(arr.to_str().is_err())
}

test "valid UTF-8 bytes succeed" {
    // Контрольный позитивный тест: "Hi" в ASCII.
    mut arr []u8 = []u8.new()
    arr.push(0x48 as u8) // 'H'
    arr.push(0x69 as u8) // 'i'
    assert(arr.to_str().is_ok())
}

test "empty byte array gives Ok empty string" {
    // Пустой массив — валидный UTF-8 (пустая строка).
    mut arr []u8 = []u8.new()
    assert(arr.to_str().is_ok())
}

// ─── Utf8Error.byte_offset precision (Plan 176 Ф.0.5, §7 «прямой тест») ───

test "byte_offset points at lone continuation after valid prefix" {
    // 'H' (offset 0, valid), затем 0x80 (offset 1, lone continuation).
    mut arr []u8 = []u8.new()
    arr.push(0x48 as u8) // 'H'
    arr.push(0x80 as u8) // lone continuation byte
    match arr.to_str() {
        Ok(_)  => assert(false)
        Err(e) => assert(e.byte_offset == 1)
    }
}

test "byte_offset points at lead of incomplete trailing sequence" {
    // "ab" (offsets 0,1 valid), затем 0xE0 (offset 2) — начало 3-байтной
    // последовательности, оборванной концом входа.
    mut arr []u8 = []u8.new()
    arr.push(0x61 as u8) // 'a'
    arr.push(0x62 as u8) // 'b'
    arr.push(0xE0 as u8) // incomplete 3-byte lead
    match arr.to_str() {
        Ok(_)  => assert(false)
        Err(e) => assert(e.byte_offset == 2)
    }
}

test "byte_offset is 0 when the very first byte is invalid" {
    mut arr []u8 = []u8.new()
    arr.push(0xFF as u8)
    match arr.to_str() {
        Ok(_)  => assert(false)
        Err(e) => assert(e.byte_offset == 0)
    }
}
