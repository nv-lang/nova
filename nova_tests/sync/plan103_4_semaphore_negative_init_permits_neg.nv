// Plan 103.4 — Semaphore.new with negative permits → RUNTIME_PANIC.
//
// initial permits must be >= 0. Unconditional check (fires in Dev AND Release).
//

module nova_tests.sync

test "Semaphore.new(-1) panics with permits must be >= 0" panics "Semaphore.new: initial permits must be >= 0" {
    ro _sem = Semaphore.new(-1)
}
