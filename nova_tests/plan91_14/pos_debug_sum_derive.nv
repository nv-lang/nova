// Plan 91.14 (A7) — #impl(Debug) auto-derive on sum types
//
// Plan 180 Ф.1 (D345) replaced the V1 placeholder (which wrote the TYPE name
// for any variant) with rich per-variant synthesis: a unit variant now debugs
// as its own name. [M-126-sum-fmt-rich] CLOSED.

module plan91_14.pos_debug_sum_derive

#impl(Debug)
type Color | Red | Green | Blue

#impl(Debug)
type Status | Active | Inactive | Pending

test "Color sum debug — variant name (rich synthesis)" {
    ro c = Red as Color
    assert("${c:?}" == "Red")
    ro g = Green as Color
    assert("${g:?}" == "Green")
    ro b = Blue as Color
    assert("${b:?}" == "Blue")
}

test "Status sum debug — variant name (rich synthesis)" {
    ro st = Active as Status
    assert("${st:?}" == "Active")
    ro p = Pending as Status
    assert("${p:?}" == "Pending")
}
