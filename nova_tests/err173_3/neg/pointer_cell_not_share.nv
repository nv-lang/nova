// EXPECT_COMPILE_ERROR [E_CONCURRENT_MUT_CAPTURE] outer `mut` binding `c` captured by reference in a `spawn`/`parallel for`/`detach` body: `RawCell` is poisoned at `RawCell.p` (`* int`): a raw pointer
//
// Plan 173.3 (D415 §1): «ядовитая база» — тип, транзитивно содержащий сырой
// `*T`-указатель, НЕ-#share по построению (аналог Rust `UnsafeCell: !Sync`);
// vouch'а `#share` на типе нет → mut-захват в spawn отвергается. Поглощает
// Plan 118.3 `E_POINTER_CROSS_FIBER` принципиальной проверкой (Ф.4).
// EXPECT проверяет per-field объяснение ([M-173.3-share-leakage-explain]):
// цепочка `RawCell.p` называет ядовитое поле и причину («raw pointer»).

module neg.pointer_cell_not_share

type RawCell {
    p *int
}

fn leak_cell(c mut RawCell) -> () {
    supervised {
        spawn {
            ro _alias = c.p
        }
    }
}
