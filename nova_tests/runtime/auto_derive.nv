// auto_derive.nv — Plan 08 Ф.3 (историческое): D77 4-way auto-derive synthesis.
//
// [D73/D77 retraction 2026-07-06]: auto-derive синтез (`T.from`↔`.into()`,
// `T.try_from`↔`.try_into()`) полностью снят вместе с протоколами From/
// Into/TryFrom/TryInto — тесты на synthesized-направление удалены ниже.
// Остаются: явные `T.try_from(v)`/`T.from(v)` static-конструкторы (просто
// конвенция имени, не протокол).

module nova_tests.runtime


// Custom тип Celsius1 с try_from(int).
type Celsius1 {
    degrees int
}


export fn Celsius1.try_from(n int) -> Result[Celsius1, str] {
    // Validation: −273.15 — абсолютный ноль.
    if n < -273 {
        Err("below absolute zero")
    } else {
        Ok(Celsius1 { degrees: n })
    }
}


test "Celsius1.try_from(int) валидное" {
    ro r = Celsius1.try_from(20)
    assert(r.is_ok())
}


test "Celsius1.try_from(int) невалидное" {
    ro r = Celsius1.try_from(-300)
    assert(r.is_err())
}


// from/into auto-derive (историческое; smoke-проверка `.from` конвенции).
type Wrapper {
    inner int
}


export fn Wrapper.from(n int) -> Wrapper {
    Wrapper { inner: n }
}


test "Wrapper.from(int)" {
    ro w = Wrapper.from(42)
    assert(w.inner == 42)
}
