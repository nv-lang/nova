// Plan 177 / D325 — единый fallible-контракт: `str.parse_int -> Result`.
// Дуальная тройка (bare-throws / try_parse_int / parse_int_opt) РЕТРАКТИРОВАНА;
// одна Result-форма. Проверяет все D85-каналы: `!!` (throw), `match`
// (ветвление), `.ok()` (Result→Option), `unwrap_or`.
module nova_tests.strings

test "parse_int returns Result" {
    assert("42".to_int().is_ok())
    assert("42".to_int() ?? 0 == 42)
    assert("xyz".to_int().is_err())
}

test "parse_int !! throws → value on success" {
    ro n = "123".to_int()!!
    assert(n == 123)
}

test "parse_int .ok() → Option" {
    assert("7".to_int().ok() == Some(7))
    assert("bad".to_int().ok() == None)
}

test "parse_int match branches (radix)" {
    match "ff".to_int(radix: 16) {
        Ok(v) => assert(v == 255)
        Err(_) => assert(false, "expected Ok(255)")
    }
    match "zzz".to_int() {
        Ok(_) => assert(false, "expected Err")
        Err(_) => {}
    }
}
