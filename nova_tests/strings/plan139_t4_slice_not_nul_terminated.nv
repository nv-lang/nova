// Plan 139 Ф.4 / A4.2 — sliced (mid-buffer) str → to_cstr allocates + NUL-
// terminates. A mid-buffer slice's backing buffer was never guaranteed to be
// terminated at the slice's len (the next byte may belong to the parent), so
// a naive zero-copy CStr could make C strlen over-read into the parent.
// Under Plan 199 / D418 (retracts D26 §Nul-termination) `to_cstr()` ALWAYS
// allocates a fresh `len+1` NUL-terminated copy — for every `str`, sliced or
// not — so strlen sees exactly the slice length in every case below.
module nova_tests.strings

import std.ffi.cstr.{CStr}

extern "nova" fn p139_cstr_strlen(c CStr) -> int

test "mid-buffer slice to_cstr terminates at slice len (no over-read)" {
    ro s = "hello world"
    ro sub = s[0..5]            // "hello" — parent byte at idx 5 is ' ', not NUL
    assert(sub.byte_len() == 5)
    ro c = sub.to_cstr()
    assert(p139_cstr_strlen(c) == 5)   // 5, NOT 11 (parent length)
}

test "slice ending at parent len is also copy-terminated correctly" {
    ro s = "hello world"
    ro tail = s[6..11]          // "world" — ends at parent.len
    assert(tail.byte_len() == 5)
    ro c = tail.to_cstr()
    assert(p139_cstr_strlen(c) == 5)
}

test "full literal str to_cstr is correct" {
    ro c = "abcdef".to_cstr()
    assert(p139_cstr_strlen(c) == 6)
}
