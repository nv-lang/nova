// Plan 85.1 Ф.2 — StringBuilder метрики: byte_len / codepoint count / cap.
//
// @byte_len() — длина в байтах (D179/D249), O(1).
// codepoint count — линза+терминатор `.clone().into_str().chars().count()`,
//   O(n); дублирующее свойство `@char_len()` ретрактировано
//   [M-unwrap-twins-retraction] (2026-07-07).
// @cap()      — allocated capacity в байтах, >= byte_len (ex-`@capacity()`,
//   тот же retraction — alias дублировал канонический `@cap()`).

module nova_tests.strings


// ── @len bytes vs @char_len codepoints ───────────────────────────

test "ASCII: len == char_len" {
    consume sb = StringBuilder.new()
    sb.append("hello world")
    assert(sb.byte_len() == 11)
    assert(sb.clone().into_str().chars().count() == 11)
    ro _ = sb.into_str()
}

test "Cyrillic: len = 2 * char_len" {
    consume sb = StringBuilder.new()
    sb.append("Привет")
    assert(sb.clone().into_str().chars().count() == 6)
    assert(sb.byte_len() == 12)
    ro _ = sb.into_str()
}

test "emoji: len = 4 * char_len" {
    consume sb = StringBuilder.new()
    sb.append('😀')
    sb.append('🎉')
    assert(sb.clone().into_str().chars().count() == 2)
    assert(sb.byte_len() == 8)
    ro _ = sb.into_str()
}

test "смешанный текст: char_len < len" {
    consume sb = StringBuilder.new()
    sb.append("Hi Я 中")     // H,i,space,Я,space,中 = 6 codepoints
    assert(sb.clone().into_str().chars().count() == 6)
    // H(1)+i(1)+sp(1)+Я(2)+sp(1)+中(3) = 9 байт
    assert(sb.byte_len() == 9)
    ro _ = sb.into_str()
}

test "пустой: len == 0, char_len == 0" {
    consume sb = StringBuilder.new()
    assert(sb.byte_len() == 0)
    assert(sb.clone().into_str().chars().count() == 0)
    ro _ = sb.into_str()
}


// ── @capacity ──────────────────────────────────────────────────────

test "capacity >= len всегда" {
    consume sb = StringBuilder.new()
    sb.append("some content here")
    assert(sb.cap() >= sb.byte_len())
    ro _ = sb.into_str()
}

// [M-cap-getter-fluent-alias-false-positive] (2026-07-07, compiler defect
// found during [M-unwrap-twins-retraction] capacity()→cap() migration):
// checker's `recv_returning` registry (types/mod.rs ~20392/20458) ключуется
// ТОЛЬКО по (receiver_type, method_name), БЕЗ arity. StringBuilder
// одновременно объявляет 0-arg getter `@cap() -> int` и 1-arg fluent setter
// `mut @cap(n) -> @` под тем же именем; т.к. StringBuilder — `consume`-тип,
// `ro x = sb.cap()` (0-arg getter) ложно распознаётся D180 Rule 2 как alias
// `sb` (fluent-метод «гарантированно возвращает receiver») →
// E_VIEW_BINDING_FORBIDDEN. Репро: любой `ro/let x = <consume-type-var>.cap()`
// на типе с 1-arg fluent `cap(n)` оверлоадом. Workaround ниже (`+ 0`) ломает
// точный AST-паттерн `Call{Member{Ident}}` без изменения значения — НЕ
// компиляторный фикс (компилятор вне периметра этой задачи; нужен
// arity-aware `recv_returning`).
test "capacity растёт при переполнении" {
    consume sb = StringBuilder.with_capacity(4)
    ro cap_before = sb.cap() + 0
    sb.append("aaaaaaaaaaaaaaaa")     // 16 байт >> cap 4
    assert(sb.byte_len() == 16)
    assert(sb.cap() >= 16)
    assert(sb.cap() >= cap_before)
    ro _ = sb.into_str()
}

test "capacity не уменьшается при чтении" {
    consume sb = StringBuilder.new()
    sb.append("data")
    ro c1 = sb.cap() + 0     // [M-cap-getter-fluent-alias-false-positive] — см. выше
    ro _ = sb.byte_len()
    ro _ = sb.clone().into_str().chars().count()
    ro _ = sb.is_empty()
    assert(sb.cap() == c1)
    ro _ = sb.into_str()
}


// ── len после grow корректна ───────────────────────────────────────

test "hot-loop accumulation — len точна после многих grow" {
    consume sb = StringBuilder.with_capacity(2)
    for i in 0..200 {
        sb.append("x")
    }
    assert(sb.byte_len() == 200)
    assert(sb.clone().into_str().chars().count() == 200)
    assert(sb.cap() >= 200)
    ro _ = sb.into_str()
}

test "hot-loop Unicode — char_len codepoints, len bytes" {
    consume sb = StringBuilder.new()
    for i in 0..50 {
        sb.append('Я')
    }
    assert(sb.clone().into_str().chars().count() == 50)
    assert(sb.byte_len() == 100)
    ro _ = sb.into_str()
}
