// Plan 118.1 closeout T11 POS — str.as_cstr() returns CStr.
//
// Per D418 (Plan 199, retracts D26 §Nul-termination): `str` carries no
// trailing-NUL guarantee. as_cstr() ALWAYS copies into a fresh
// `len+1`-byte GC-managed buffer + `\0` terminator, then wraps that
// buffer's pointer in a CStr.

module nova_tests.plan118

import std.ffi.cstr.{CStr}

test "str.as_cstr() returns CStr" {
    ro s = "hello"
    ro c = s.as_cstr()
    // C-side strlen would see "hello\0" (5 bytes + terminator). Verify
    // только that method compiles + returns CStr type (.0 field test).
    assert(s.byte_len() == 5)
}

test "str.as_cstr_unchecked() returns CStr — requires unsafe {} (Plan 118.1.5)" {
    ro s = "test"
    unsafe {
        ro c = s.as_cstr_unchecked()
    }
    assert(s.byte_len() == 4)
}

test "empty str.as_cstr() works" {
    ro s = ""
    ro c = s.as_cstr()
    assert(s.byte_len() == 0)
}
