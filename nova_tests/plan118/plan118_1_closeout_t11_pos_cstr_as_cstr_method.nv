// Plan 118.1 closeout T11 POS — str.to_cstr() returns CStr (both overloads).
//
// Per D418 (Plan 199, retracts D26 §Nul-termination): `str` carries no
// trailing-NUL guarantee. `to_cstr()` ALWAYS copies into a fresh
// `byte_len()+1`-byte GC-managed buffer + `\0` terminator, then wraps that
// buffer's pointer in a CStr. The `to_cstr(buf, buf_size)` overload copies into
// a caller-provided buffer instead (zero-alloc, truncating).

module nova_tests.plan118

import std.ffi.cstr.{CStr}
import std.runtime.raw_mem.{RawMem}

test "str.to_cstr() returns CStr" {
    ro s = "hello"
    ro c = s.to_cstr()
    // C-side strlen would see "hello\0" (5 bytes + terminator). Verify
    // only that the method compiles + returns CStr type.
    assert(s.byte_len() == 5)
}

test "str.to_cstr(buf, size) copies into caller buffer + NUL-terminates" {
    ro s = "hi"
    ro buf = unsafe { RawMem.alloc(8) }   // *mut u8, 8 writable bytes
    ro c = s.to_cstr(buf, 8)
    unsafe {
        assert(buf.read_at(0) == 104 as u8)  // 'h'
        assert(buf.read_at(1) == 105 as u8)  // 'i'
        assert(buf.read_at(2) == 0 as u8)    // terminator at byte_len()
    }
}

test "empty str.to_cstr() works" {
    ro s = ""
    ro c = s.to_cstr()
    assert(s.byte_len() == 0)
}
