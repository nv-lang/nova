// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 178 Ф.3 — LIVE HTTP/1.1 server smoke over a loopback socket.
// Plan 183 Ф.3: migrated onto std.net2 (byte-surface `Net`, D407) alongside
// `std.http.servernet.handle_connection`.
//
// Proves `std.http.servernet.handle_connection` end-to-end over a real socket:
// a server fiber accepts one connection and runs the request through the pure
// server core (ServeMux/serve_once); a client fiber connects, sends a raw GET,
// and reads back the serialized response. net + http co-present in ONE compile
// unit — this is also the [M-codegen-cross-module-ctor-emission] regression:
// `NetError.IoError(msg)` (net's uv-error classifier, reachable via the socket
// read/write paths) must emit its variant constructor, not the undefined
// `Nova_NetError_static_IoError` static form — otherwise the link fails.
//
// (Result[_, NetError] is destructured via `match`, not `!!`: `!!`
// throws through `Nova_Fail_fail`, whose typed-error path is a pre-existing net
// codegen gap unrelated to this smoke — see tcp_echo_server_test.)
//
// STATUS (2026-07-06, Ф.3 re-check): the [M-codegen-cross-module-ctor-emission]
// LINK obstacle stays resolved. The prior RUN-FAIL blamed on the net-substrate
// M:N segfault was actually a MISSING `with Net = real_net() { ... }` handler
// install in this test (the effect dispatch had no handler bound, so
// `TcpListener.bind` crashed on a null vtable slot — confirmed via
// NOVA_DIAG_SEGV: fault in `Nova_Net_tcp_bind`, not in libuv/park code). Fixed
// here by wrapping the body in `with Net = real_net()`; green on std.net2.
//
// EXPECT_TIMEOUT_MS 30000

module nova_tests.http_servernet

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.http.server.{ServeMux, ServerResponse, handler_fn}
import std.http.servernet.{handle_connection}

fn routes() -> ServeMux {
    // [M-184-mut-chain-return-position]: цепочка mut-сеттеров в return-позиции
    // мискомпилируется (см. nova_tests/http_server/server_test.nv) — mut-биндинг.
    mut mux = ServeMux.new()
    mux.get("/health", handler_fn(|req| ServerResponse.text(200, "ok")))
    mux.not_found(handler_fn(|req| ServerResponse.text(404, "nope")))
    mux
}

test "servernet: live GET /health round-trip over loopback" {
    with Net = real_net() {
        ro lst = match TcpListener.bind(SocketAddr.loopback(0)) {
            Ok(l)  => l
            Err(_) => { assert(false); return }
        }
        ro port = lst.local_port()
        assert(port > 0)

        mut got []u8 = []u8.new()
        mut server_ok = false
        supervised {
            // Server fiber: accept one connection, serve it through handle_connection.
            spawn {
                match lst.accept() {
                    Ok(srv) => {
                        consume s = srv
                        match handle_connection(s, routes()) {
                            Ok(_)  => { server_ok = true }
                            Err(_) => ()
                        }
                    }
                    Err(_) => ()
                }
                lst.close()
            }
            // Client fiber: connect, send a raw GET, read the response.
            spawn {
                match TcpStream.connect(SocketAddr.loopback(port)) {
                    Ok(conn) => {
                        mut cli = conn
                        match cli.write_str("GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n") {
                            Ok(_)  => ()
                            Err(_) => ()
                        }
                        match cli.read_to_vec(4096) {
                            Ok(chunk) => got.append(chunk)
                            Err(_)    => ()
                        }
                        cli.close()
                    }
                    Err(_) => ()
                }
            }
        }
        assert(server_ok)
        ro resp = str.from_bytes_unchecked(got)
        assert(resp.contains("HTTP/1.1 200 OK"))
        assert(resp.contains("ok"))
    }
}
