// EXPECT_COMPILE_ERROR E_SUPERVISOR_RESTART_GATED
//
// Plan 173.2 §3b neg: `Decision.Restart` (и RestartAll/RestartRest) остаются
// в словаре `Decision`, но их ИСПОЛНЕНИЕ гейтится изоляцией restartable-тела
// (Plan 173.3 `#share`/consume-в-spawn). Конструирование внутри
// Supervisor-хендлера отклоняется компилятором до появления рычага изоляции.

module neg.restart_gated_neg

test "Restart без гейта изоляции отвергается" {
    with Supervisor = effect Supervisor {
        on_child_fail(idx, err) => Decision.Restart
    } {
        supervised {
            spawn { throw 1 }
        }
    }
}
