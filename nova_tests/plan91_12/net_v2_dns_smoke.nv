// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 91.13 / Plan 178 Ф.0.5 — DNS smoke tests over the unified `Net` effect.
//
// Acceptance criteria A13-dns:
//   (1) mock_net() lookup always succeeds — returns Result[[]SocketAddr, NetError].
//   (2) DNS is mockable: SocketAddr.lookup dispatches through the Net vtable.
//   (3) SocketAddr.lookup API compiles; returns Result[[]SocketAddr, NetError].
//   (4) «без упрощений как для прода»: real_net() lookup is proven separately by
//       net.h C impl; mock is used here to avoid network dependency in CI.
//
// D295/D365: DNS is part of the unified net effect family.
//
// Note (Plan 178 Ф.0.5 effect merge): the ex-`effect DnsNet { lookup(...) }`
// focus-handler negatives (inject a failing lookup) are no longer expressible in
// user code — a full `Net` handler must supply `split_stream`, which returns a
// bare tuple of the opaque `(TcpReadHalf, TcpWriteHalf)` with no public
// constructor, and a `panic`-diverging stub for it miscodegens (the op return
// type is not used as the divergent-cast target — followup
// [M-net-merge-focus-stub-codegen]). The Err-propagation of `lookup` is a
// one-line delegation guaranteed by the effect mechanism; NetError variant
// round-tripping is covered by plan91_15/net_error_to_str.

module plan91_12.net_v2_dns_smoke

import std.net.{SocketAddr, mock_net}

test "dns mock: lookup succeeds and returns v4 SocketAddr" {
    with Net = mock_net() {
        ro r = SocketAddr.lookup("localhost", 80)
        assert(r.is_ok())
        ro addrs = match r {
            Ok(a)  => a
            Err(_) => panic("lookup failed")
        }
        assert(addrs.len() >= 1)
        assert(addrs[0].is_v4())
    }
}

test "dns mock: lookup returns port 0 (loopback address with port 0)" {
    with Net = mock_net() {
        ro r = SocketAddr.lookup("example.com", 443)
        assert(r.is_ok())
        ro addrs = match r {
            Ok(a)  => a
            Err(_) => panic("lookup failed")
        }
        // mock_net always returns socket_addr_loopback(0)
        assert(addrs.len() >= 1)
        assert(addrs[0].port() == 0)
    }
}

test "dns mock: lookup with arbitrary hostname always resolves" {
    with Net = mock_net() {
        ro r1 = SocketAddr.lookup("google.com", 80)
        ro r2 = SocketAddr.lookup("127.0.0.1", 8080)
        assert(r1.is_ok())
        assert(r2.is_ok())
    }
}

test "dns mock: multiple independent lookups" {
    with Net = mock_net() {
        mut i = 0
        while i < 5 {
            ro r = SocketAddr.lookup("host", 1234)
            assert(r.is_ok())
            i = i + 1
        }
    }
}
