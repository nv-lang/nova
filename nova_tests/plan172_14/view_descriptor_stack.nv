// Plan 172.14 Ф.2 — приёмка владельца (2026-07-10): read-only виды
// `s.bytes()` и `v[a..b]` — СТРОГИЙ вид (волна view-descriptor-sret).
//
// [M-172.14-view-descriptor-stack] ЗАКРЫТ механизмом sret/_out (дизайн-секция
// docs/plans/172.14 §1-4): не-эскейпящий ro-вид конструирует 24Б-дескриптор
// ПО МЕСТУ в стек-слоте вызывающего (`S _slot = {0}; f__sret(..., &_slot)`),
// payload — zero-copy указатель внутрь исходного буфера (без memcpy).
// Эскейпящий вид (замыкание/return/арг) — классический heap-путь, семантика
// неизменна. Критерий владельца: gc.alloc_count δ = 0 на строгих видах.

module nova_tests.plan172_14

import std.runtime.gc

test "ro b = s.bytes(): стек-дескриптор, 0 аллокаций, zero-copy payload" {
    ro s = "hello world"
    ro before = gc.alloc_count()
    ro b = s.bytes()
    ro after = gc.alloc_count()
    assert(b.len() == 11)
    assert(b[0] == 104)
    assert(b[10] == 100)
    assert(after - before == 0)
}

test "ro sl = v[3..5]: стек-дескриптор, 0 аллокаций, zero-copy payload" {
    mut v = []int.new().cap(16)
    for i in 0..16 { v.push(i * 10) }
    ro before = gc.alloc_count()
    ro sl = v[3..5]
    ro after = gc.alloc_count()
    assert(sl.len() == 2)
    assert(sl[0] == 30)
    assert(sl[1] == 40)
    assert(after - before == 0)
}

test "эскейпящий вид корректен (замыкание) — heap-путь" {
    ro v = [10, 20, 30]
    ro sl = v[0..2]
    ro f = || sl.len()
    assert(f() == 2)
}

test "вид поверх mut-источника: snapshot-семантика при realloc" {
    mut v = []int.new()
    for i in 0..8 { v.push(i * 10) }
    ro sl = v[1..4]
    assert(sl.len() == 3)
    assert(sl[0] == 10)
    v.push(99)
    assert(sl[0] == 10)
}
