// 22_misc_ops.nv — `as` cast, `spawn`, block-expression-as-value
//
// В bootstrap'е:
// - `as` это no-op (значение не меняется); это заглушка для
//   будущего production-компилятора с настоящей type-coercion.
// - `spawn { body }` исполняется синхронно (нет fiber-runtime'а).
// - block expression `{ ... }` всегда даёт значение последнего
//   выражения.

module nova_tests.syntax

test "as cast int → int (no-op)" {
    ro x = 42 as int
    assert(x == 42)
}

test "as cast в выражении" {
    ro r = (10 as int) + 5
    assert(r == 15)
}

test "spawn block — результат через AtomicInt (D50/D415)" {
    // Plan 173.3 (D415 §2): mut-захват в spawn запрещён
    // (E_CONCURRENT_MUT_CAPTURE) — результат через #share-примитив.
    mut r = AtomicInt.new(0)
    supervised {
        spawn { r.store(100 + 1) }
    }
    assert(r.load() == 101)
}

test "spawn с side-эффектами через #share-примитив" {
    mut x = AtomicInt.new(0)
    supervised {
        spawn { x.store(99) }
    }
    assert(x.load() == 99)
}

test "block expression как значение" {
    ro r = {
        ro a = 10
        ro b = 20
        a + b
    }
    assert(r == 30)
}

test "вложенные block expression" {
    ro r = {
        ro outer = 1
        ro inner = {
            ro x = outer + 9
            x * 2
        }
        inner + outer
    }
    assert(r == 21)
}

test "block expression в условии" {
    ro cond = {
        ro n = 5
        n > 0
    }
    if cond {
        assert(true)
    } else {
        assert(false)
    }
}

test "block в правой части ro" {
    ro v = {
        mut acc = 0
        for i in 1..5 {
            acc += i
        }
        acc
    }
    assert(v == 10)
}
