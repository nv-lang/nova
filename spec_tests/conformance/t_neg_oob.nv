// Plan 138.1 Ф.4 NEG — []t_neg_oob_Point OOB index panics (typed-storage path)

module conformance.t_neg_oob
type t_neg_oob_Point { x int, y int }

test "[]t_neg_oob_Point v[3] on length-3 vec panics" panics "array: index" {
    ro v []t_neg_oob_Point = [t_neg_oob_Point { x: 1, y: 2 }, t_neg_oob_Point { x: 3, y: 4 }, t_neg_oob_Point { x: 5, y: 6 }]
    ro _ = v[3]
}
