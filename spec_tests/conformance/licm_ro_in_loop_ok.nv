// Plan 123.2 T1.1: ro field invariant внутри loop → hoist
// `ro _at_<F>_loop = @<F>` immediately before the loop.

module spec_tests.conformance
type Image3_1 {
    ro pixels int
    ro width int
}

fn Image3_1 @sum_pixels_for(times int) -> int {
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < times {
        // 2 reads of ro @pixels внутри loop body → LICM hoists.
        total += @pixels + @pixels
        i += 1
    }
    total + @width
}

fn Image3_1.new(p int, w int) -> Image3_1 {
    Image3_1 { pixels: p, width: w }
}

test "ro field hoisted из while loop" {
    ro img = Image3_1.new(7, 100)
    ro r = img.sum_pixels_for(3)
    // total: 3*(7+7) = 42; + width 100 = 142.
    assert(r == 142)
}
