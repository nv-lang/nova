// Plan 123.2 T-PROP.1: semantic equivalence — same algorithm
// expressed across loop forms with various inputs must yield
// identical results regardless of LICM caching.

module spec_tests.conformance
type Calc5_2 {
    ro base int
    ro step int
}

fn Calc5_2 @while_form(n int) -> int {
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        total = total + @base + @step
        i += 1
    }
    total
}

fn Calc5_2 @for_form(n int) -> int {
    mut total = 0
    for i in 0..n {
        total = total + @base + @step
    }
    total
}

fn Calc5_2 @loop_form(n int) -> int {
    mut total = 0
    mut i = 0
    loop {
        if i >= n { break }
        total = total + @base + @step
        i += 1
    }
    total
}

fn Calc5_2.new(b int, s int) -> Calc5_2 {
    Calc5_2 { base: b, step: s }
}

test "property: while/for/loop equivalence" {
    ro c = Calc5_2.new(10, 3)
    assert(c.while_form(5) == c.for_form(5))
    assert(c.for_form(5) == c.loop_form(5))
    // 5 × (10+3) = 65.
    assert(c.while_form(5) == 65)
}

test "property: zero iter preserves" {
    ro c = Calc5_2.new(99, 1)
    assert(c.while_form(0) == 0)
    assert(c.for_form(0) == 0)
    assert(c.loop_form(0) == 0)
}
