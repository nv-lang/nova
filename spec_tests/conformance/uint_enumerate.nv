// Plan 172.1 — EXPOSE the latent by-value-mono BoxIter int-collapse (named priority).
// `v.lazy().enumerate()` builds a `BoxIter<(int, T)>` value-record; if the value-record
// monomorphization erases the tuple element `T`→`nova_int` (`_NovaTuple2` instead of the
// concrete `_NovaTuple_2_8_nova_int_8_uint`), an unsigned `2^63` element reads back as a
// SIGNED negative → `pair.1 > 100` is false. A correct width-preserving lower keeps it
// positive. This is the discriminating reproduction for the by-value-mono element-resolution
// gap (gap#2 subst-timing; emit_c.rs:1982-2011 tuple all_concrete decision).
module conformance.uint_enumerate
import std.collections.vec_lazy

test "lazy enumerate preserves uint element width — no BoxIter int-collapse" {
    ro v = Vec[uint].of(0x8000000000000000)   // 2^63 — high bit set
    ro got = v.lazy().enumerate().collect()    // [(0, 2^63)]
    ro pair = got[0]
    // pair.1 is the uint element; UNANNOTATED comparison inherits its type.
    // If erased to signed nova_int → 2^63 is negative → FAIL. uint → positive.
    assert(pair.1 > 100)
}
