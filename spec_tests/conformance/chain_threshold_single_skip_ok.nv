// Plan 123.4 T1.7: single chain access — below threshold, not cached.

module spec_tests.conformance
type Layer3_1 {
    ro inner Layer_Inner
}

priv(file) type Layer_Inner {
    ro v int
}

fn Layer3_1 @single() -> int {
    @inner.v
}

fn Layer3_1.new(v int) -> Layer3_1 {
    Layer3_1 { inner: Layer_Inner { v } }
}

test "single chain access not cached" {
    ro l = Layer3_1.new(42)
    assert(l.single() == 42)
}
