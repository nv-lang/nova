// D277 — By-value мономорфизация generic value-records: `type X[T] value { ... }` lowered
// BY VALUE per mono-instance (NovaValue_<short>), no nova_alloc for wrapper record.
// Spec: spec/decisions/02-types.md D277. Part of the SINGLE `spec_tests.conformance` folder-module.
//
// D277 Stage 2 gap-fill (196.3 audit, 2026-07-12): the tests above only exercise a
// FLAT generic value-record (`D277Pair[T]`, no nested generic-over-source args). The
// zero-cost adapter model (`std.collections.vec_iter`: `MapIter[I,T,U]`/`FilterIter
// [I,T]`/…, all `value`) is D277's OTHER half — each adapter nests the UPSTREAM
// iterator type as a generic arg (`MapIter[VecIter[int],int,int]`), and a 2+-adapter
// chain mono's to a NESTED concrete instance (`FilterIter[MapIter[VecIter[int],int,
// int],int]`). That by-value nested-mono surface had no conformance coverage — added
// below (mirrors the literal example from `emit_c.rs::value_aware_subst_to_ref`'s doc
// comment).
module spec_tests.conformance

import std.collections.vec_iter

// Generic value-record
type D277Pair[T] value { first T, second T }

fn d277_swap[T](p D277Pair[T]) -> D277Pair[T] =>
    { first: p.second, second: p.first }

fn d277_first[T](p D277Pair[T]) -> T => p.first
fn d277_second[T](p D277Pair[T]) -> T => p.second

test "generic value-record D277Pair[int] by-value mono (D277)" {
    ro p D277Pair[int] = { first: 1, second: 2 }
    assert(p.first == 1)
    assert(p.second == 2)
}

test "generic value-record swap returns new value (D277)" {
    ro p D277Pair[int] = { first: 10, second: 20 }
    ro s = d277_swap(p)
    assert(s.first == 20)
    assert(s.second == 10)
}

test "generic value-record accessor functions (D277)" {
    ro p D277Pair[str] = { first: "hello", second: "world" }
    assert(d277_first(p) == "hello")
    assert(d277_second(p) == "world")
}

test "generic value-record D277Pair[bool] (D277)" {
    ro p D277Pair[bool] = { first: true, second: false }
    assert(p.first)
    assert(!p.second)
}

test "3-level nested generic-over-source chain: FilterIter[MapIter[VecIter[int],int,int],int] (D277 Stage 2)" {
    ro v = []int.of(1, 2, 3, 4, 5, 6)
    // .map(): VecIter[int] -> MapIter[VecIter[int], int, int]
    // .filter(): MapIter[..] -> FilterIter[MapIter[VecIter[int], int, int], int]
    ro got = v.iter().map(|x| x * 2).filter(|x| x > 4).collect()
    assert(got == [6, 8, 10, 12])
}

test "nested generic-over-source chain through intermediate let-bindings (D277 Stage 2, by-value local var ABI)" {
    ro v = []int.of(1, 2, 3, 4, 5)
    // Each intermediate binding's LOCAL VAR C-type must itself be the by-value
    // NovaValue_<short> mono surface (not the heap Nova_<short>*), or the chained
    // method call on the next line references an undeclared struct.
    ro mapped = v.iter().map(|x| x + 1)
    ro filtered = mapped.filter(|x| x % 2 == 0)
    assert(filtered.collect() == [2, 4, 6])
}

test "self-referential nested generic-over-source: double map (D277 Stage 2)" {
    ro v = []int.of(1, 2, 3)
    // .map().map(): MapIter[MapIter[VecIter[int],int,int], int, int] — the SECOND
    // .map() nests the FIRST MapIter instance as its own `Self` type-arg.
    ro got = v.iter().map(|x| x + 1).map(|x| x * 10).collect()
    assert(got == [20, 30, 40])
}

// D277 Stage 3 (реестр 221.1 №39, pk2-fix): a generic value-record instantiated
// by an EFFECT-typed parameter. `debt_mangled_has_nested_placeholder` (emit_c.rs)
// checked the mangled-name token against `record_schemas`/`sum_schemas`/
// `generic_types`/`opaque_ffi_types`/primitives to decide "still an unresolved
// type-param" — but never against `effect_schemas`. Any effect-typed type-arg to
// a generic `value` record therefore misread as an unresolved placeholder, and
// `drain_generic_type_worklist`'s Stage-2 skip silently dropped the by-value mono
// struct — "unknown type name NovaValue_<Name>____Nova_<Effect>_p" downstream.
// Reproduces with ONE effect-typed instance already (no second instance needed
// to trigger it — sузили диагноз пробой pk2, реестр записывал шире факта).
type M39Handler[E] value { tag str }

fn M39Handler[E].new(tag str) -> M39Handler[E] => { tag }

type M39Db effect {
    query(sql str) -> str
}

type M39Log effect {
    write(msg str) -> ()
}

fn m39_use_db(h M39Handler[M39Db]) -> str => h.tag
fn m39_use_log(h M39Handler[M39Log]) -> str => h.tag

test "generic value-record instantiated by a single effect type-param (D277 Stage 3, №39)" {
    ro h = M39Handler[M39Db].new("db")
    assert(m39_use_db(h) == "db")
}

test "generic value-record instantiated by TWO different effect type-params in one CU (D277 Stage 3, №39)" {
    ro hd = M39Handler[M39Db].new("db")
    ro hl = M39Handler[M39Log].new("log")
    assert(m39_use_db(hd) == "db")
    assert(m39_use_log(hl) == "log")
}
