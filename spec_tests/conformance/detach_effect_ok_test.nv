// detach_effect_ok_test.nv — Plan 173 Ф.3 п.2 (D50 / D414 §2) pos-twin.
//
// `detach { }` разрешён checker'ом (CapabilityCtx НЕ флагает) когда:
//   (1) enclosing-`fn` объявляет эффект `Detach` в effect-row;
//   (3) вызов из test-блока (effect-root — нет сигнатуры, дефолт LogAndDrop).
// (Форма (2) ambient `with Detach = …` — тоже exempt в checker'е через
// with_handler_stack-проверку, но требует объявленного effect-типа Detach +
// handler'а, которых нет в std bootstrap — не тестируется здесь.)
// Neg-twin (detach в fn БЕЗ Detach → E_DETACH_REQUIRES_EFFECT) —
// err173/neg/f3_detach_requires_effect.
//
// Изолированная папка (module nova_tests.err173_2) — НЕ concurrency-folder
// (у того pre-existing Duration-`-` codegen-баг в чужом файле CU).

module nova_tests.err173_2

// D415 §2 amendment (2026-07-11): detach is now a capture-check boundary,
// same as spawn/parallel for. `n` is `AtomicInt` (audited `#share`, D415
// §1) so `Ctr` is auto-#share (memberwise) — capturing `c` by reference
// into `detach { }` and mutating through the atomic field stays legal
// without a `spawn consume`/`ro` rewrite; this keeps the fixture's actual
// point (the `Detach`-effect gate, not concurrency-safety) unchanged.
//
// (Codegen aside, fixed same wave: this record-embeds-AtomicInt shape
// first hit [M-atomicint-record-field-typedef-collision] — a duplicate/
// conflicting `struct Nova_AtomicInt` typedef, CC-FAIL. Root + regression
// coverage: nova_tests/concurrency/sync_atomic.nv "AtomicInt: as a record
// field" + sync_mutex.nv "Mutex: as a record field". Fixed in
// emit_c.rs — record/sum/generic-instance forward-decl pre-passes now
// skip runtime-backed sync-primitive field types via
// `debt_is_runtime_backed_newtype`.)
type Ctr {
    n AtomicInt
}

fn Ctr.make() -> Ctr => { n: AtomicInt.new(0) }

// (1) fn с эффектом Detach — detach разрешён (не флагается).
fn spawn_bg(c mut Ctr) Detach -> () {
    detach {
        c.n.fetch_add(1)
    }
}

// (3) test-блок — effect-root, bare detach разрешён.
test "detach in test-root (effect-root) compiles + runs under default handler" {
    mut c = Ctr.make()
    detach {
        c.n.fetch_add(1)
    }
    runtime.drain_orphans()
    assert(c.n.load() == 1)
}

test "detach inside Detach-effect fn compiles + runs" {
    mut c = Ctr.make()
    spawn_bg(c)
    runtime.drain_orphans()
    assert(c.n.load() == 1)
}
