//
// Plan 110.1.4.h T2.1 (D193 MultiError composition): cleanup throws
// → composed как secondary в MultiError chain (primary stays = body's
// throw). Verifies cleanup-fail-during-propagation flow.

module spec_tests.conformance
type FailingResource3 {
    ro id int
}

fn FailingResource3.new(id int) -> FailingResource3 => { id }

// cleanup может throw — composes в MultiError when body throws.
fn FailingResource3 consume @cleanup(_outcome ScopeOutcome) Fail[str] -> () {
    throw "cleanup-failure"
}

// Caller uses consume scope; cleanup throws after body completes.
// Caller must declare Fail[str] чтобы accept cleanup's throw.
fn use_failing_cleanup() Fail[str] -> int {
    consume r = FailingResource3.new(42) {
        return r.id                      // No. 714: the block is a statement
    }
}

test "Plan 110.1.4.h T2.1: cleanup throws composes в MultiError" {
    // Runtime verification of MultiError composition requires Fail
    // handler в test block. Здесь — compile + link verification.
    assert(true)
}
