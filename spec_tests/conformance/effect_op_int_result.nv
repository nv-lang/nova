// Plan 183 Ф.4 followup — [M-183-int-to-str-module-method-collision] POSITIVE.
//
// An effect-operation result (`Clock1.tick() -> int`) now carries its declared
// return type through the checker (types/mod.rs infer_expr_type, effect-op arm).
// Before the fix `ro x = Clock1.tick()` left `x` UNTYPED in the checker scope, so
// a primitive method-call on it was NOT gated by the checker and codegen
// coarse-by-name (`method_receivers` last-wins) mis-dispatched it to a same-named
// FOREIGN method — here `NetErr @to_str` — passing the `nova_int` as an enum
// pointer (SEGV). This test proves the int is correctly typed: `str.from`,
// interpolation, and a genuine int method (`.abs()`) all resolve on the effect-op
// result even though a foreign `to_str` exists in the SAME module.

module spec_tests.conformance
type NetErr enum
    | Eof
    | Closed

// Foreign same-name method — must NOT intercept an int receiver.
export fn NetErr @to_str() -> str {
    match @ {
        Eof    => "eof"
        Closed => "closed"
    }
}

type Clock1 effect {
    tick() -> int
}

fn use_effect_int() Clock1 -> str {
    ro x = Clock1.tick()          // effect-op result — declared `-> int`
    ro doubled = x * 2 - 1       // arithmetic keeps int
    ro viastr = doubled.to_str()
    ro viainterp = "${doubled}"
    assert(viastr == viainterp)
    viastr
}

test "effect-op int result: correct typing, no foreign to_str interception" {
    ro out = with Clock1 = effect Clock1 { tick() -> int => 5 } {
        use_effect_int()
    }
    assert(out == "9")           // 5*2-1 = 9
    // Foreign method still callable on its OWN type (bind-first: the bare
    // `NetErr.Eof.to_str()` path form is a separate pre-existing P67-LEGACY
    // ICE, backlog Enum.UnitVariant.method(), not this class).
    ro e = NetErr.Eof
    assert(e.to_str() == "eof")
}
