// Plan 173.1 Ф.2 §5 pos: `parallel for → []T` для КАЖДОГО вида элемента —
// примитив / heap-record / value-record (D228) / анонимный tuple / именованный
// tuple (D215) / sum-тип / вложенный []T. Закрывает
// [M-parfor-record-result-miscompile] на всей матрице типов (критерий приёмки
// №2 плана — «обязательный, без упрощений и исключений»).
//
// Порядок элементов = completion order (D71-amend) — проверки set-equality /
// поиск по значению, НЕ индексные.

module spec_tests.conformance
// ── виды элементов ──────────────────────────────────────────────

type Health { name str; code int }              // heap-record
type Point7 value { x int; y int }               // value/stack-record (D228)
type Pair2(a int, b int)                         // именованный tuple (D215)
type Status enum Up | Down(int)                 // sum-тип (D406)

test "matrix: примитив f64 (boxed-транспорт)" {
    ro xs = parallel for i in 0..4 {
        i as f64 * 1.5
    }
    assert(xs.len() == 4)
    assert(xs.contains(0.0))
    assert(xs.contains(1.5))
    assert(xs.contains(3.0))
    assert(xs.contains(4.5))
}

test "matrix: примитив str" {
    ro xs = parallel for i in 0..3 {
        "v${i}"
    }
    assert(xs.len() == 3)
    assert(xs.contains("v0"))
    assert(xs.contains("v1"))
    assert(xs.contains("v2"))
}

test "matrix: heap-record" {
    ro xs = parallel for i in 0..3 {
        Health { name: "n${i}", code: i * 10 }
    }
    assert(xs.len() == 3)
    mut sum = 0
    for h in xs { sum += h.code }
    assert(sum == 0 + 10 + 20)
}

test "matrix: value-record (D228 stack-struct, boxed-транспорт)" {
    ro xs = parallel for i in 0..3 {
        Point7 { x: i, y: i * 2 }
    }
    assert(xs.len() == 3)
    mut sx = 0
    mut sy = 0
    for p in xs { sx += p.x; sy += p.y }
    assert(sx == 3)
    assert(sy == 6)
}

test "matrix: анонимный tuple" {
    ro xs = parallel for i in 0..3 {
        (i, i * i)
    }
    assert(xs.len() == 3)
    mut s0 = 0
    mut s1 = 0
    for t in xs { s0 += t.0; s1 += t.1 }
    assert(s0 == 3)
    assert(s1 == 0 + 1 + 4)
}

test "matrix: именованный tuple (D215)" {
    ro xs = parallel for i in 0..3 {
        Pair2(i, i + 100)
    }
    assert(xs.len() == 3)
    mut sa = 0
    mut sb = 0
    for p in xs { sa += p.a; sb += p.b }
    assert(sa == 3)
    assert(sb == 303)
}

test "matrix: sum-тип" {
    ro xs = parallel for i in 0..4 {
        if i % 2 == 0 { Up } else { Down(i) }
    }
    assert(xs.len() == 4)
    mut ups = 0
    mut downs_sum = 0
    for s in xs {
        match s {
            Up      => { ups += 1 }
            Down(n) => { downs_sum += n }
        }
    }
    assert(ups == 2)
    assert(downs_sum == 1 + 3)
}

test "matrix: вложенный []T" {
    ro xs = parallel for i in 0..3 {
        [i, i + 1, i + 2]
    }
    assert(xs.len() == 3)
    mut total = 0
    for inner in xs {
        assert(inner.len() == 3)
        for v in inner { total += v }
    }
    // sum_{i=0..2} (3i + 3) = 3+6+9 = 18
    assert(total == 18)
}
