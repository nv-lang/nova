// D86 (width extension) — the `??` coalesce unwrap must preserve the inner primitive's
// EXACT width/sign, not collapse to signed `nova_int`. DISCRIMINATING: the result binding
// is UNANNOTATED (`ro got = opt ?? fb`), inheriting the `??` result type; if `??` lowers
// `Option[uint]`'s inner as signed `nova_int`, the unsigned `2^63` reads NEGATIVE and
// `got > 100` is false. A width-preserving unwrap keeps it positive. Sibling to
// `d86_coalesce_operator.nv` (int-level). Spec: spec/decisions/04-effects.md (D86).
module conformance.d86_coalesce_width

fn d86w_huge() -> Option[uint] => Some(0x8000000000000000)   // 2^63 — high bit set
fn d86w_none() -> Option[uint] => None

test "?? on Option[uint] — Some unwrap keeps unsigned width (no signed collapse) (D86)" {
    ro got = d86w_huge() ?? 0          // Some(2^63) → 2^63, UNANNOTATED
    assert(got > 100)                  // uint: positive ; signed collapse → negative → FAIL
}

test "?? on Option[uint] — None fallback keeps unsigned width (D86)" {
    ro fb = d86w_none() ?? 0x4000000000000000   // None → fallback 2^62, UNANNOTATED
    assert(fb > 100)                   // uint fallback stays unsigned-positive
}
