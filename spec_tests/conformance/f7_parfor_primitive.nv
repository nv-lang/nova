// Plan 173 Ф.1 #7 → 173.1 Ф.2 (D71-amend): statement-mode `parallel for` с
// record-телом — результат отбрасывается, компилируется и выполняется. Прежний
// interim-guard [E_PARFOR_RESULT_UNSUPPORTED] УДАЛЁН волной 173.1 (канальный
// сбор поддерживает []T для любого T; value-mode покрыт err173_1/parfor_elem_matrix).

module spec_tests.conformance
type Ev { n int }

fn emit(i int) -> Ev => { n: i }

fn run_effects() -> () {
    parallel for i in 0..3 { emit(i) }
}

test "f7: statement-mode parallel for (record body) — not flagged, compiles+runs" {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } { run_effects() }
    assert(true)
}
