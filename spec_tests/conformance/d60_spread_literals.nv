// D60 — Spread `...x` в литералах: массив и record.
// `...src` внутри array-/record-литерала вставляет элементы/поля из src.
// Array spread: `[0, ...arr, 4]` = concatenation. Multiple spreads OK.
// Record spread: `{ ...src, field: new }` копирует поля + переопределяет явные.
//
// Discriminator: без spread нельзя кратко «клонировать-с-поправкой».
//
// Spec: spec/decisions/03-syntax.md D60. Единица: folder-module `spec_tests.conformance`.
module conformance.d60_spread_literals

type D60User { id int, name str, role str }

fn D60User.new(id int, name str, role str) -> D60User => { id, name, role }

test "array spread: element then spread (D60)" {
    ro a = [1, 2, 3]
    ro b = [0, ...a, 4]
    assert(b.len() == 5)
    assert(b[0] == 0)
    assert(b[1] == 1)
    assert(b[3] == 3)
    assert(b[4] == 4)
}

test "array spread: multiple spreads concatenate (D60)" {
    ro a = [1, 2]
    ro b = [3, 4]
    ro c = [...a, ...b]
    assert(c.len() == 4)
    assert(c[0] == 1)
    assert(c[3] == 4)
}

test "array spread: pure copy (D60)" {
    ro a = [10, 20, 30]
    ro copy = [...a]
    assert(copy.len() == 3)
    assert(copy[0] == 10)
    assert(copy[2] == 30)
}

test "record spread: override one field (D60)" {
    ro alice = D60User.new(1, "alice", "user")
    ro bob D60User = { ...alice, name: "bob" }
    assert(bob.id == 1)
    assert(bob.name == "bob")
    assert(bob.role == "user")
}

test "record spread: pure copy preserves all fields (D60)" {
    ro u = D60User.new(42, "test", "admin")
    ro copy D60User = { ...u }
    assert(copy.id == 42)
    assert(copy.name == "test")
    assert(copy.role == "admin")
}
