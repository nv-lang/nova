// [M-option-self-recursive-record-mono] POSITIVE regression (Plan 186,
// recursive-mono, 2026-07-10).
//
// A self-referential heap RECORD via `Option[Self]` — the textbook singly
// linked list shape:
//     type Node { value int; next Option[Node] }
// used to mis-monomorphize: the `next` field was emitted as `NovaOpt_nova_int`
// (the C type of the record's FIRST field) instead of the correct
// `NovaOpt_Nova_Node_p`, cascading into "assigning to incompatible type" /
// "member reference base type is not a structure" CC-FAILs at every write and
// read site.
//
// ROOT CAUSE (emit_c.rs): `record_schemas`/`being_defined_*` bookkeeping only
// registered a record's OWN schema AFTER lowering all of its fields, so a
// self-referential field's type resolution ran while the enclosing type still
// looked "unregistered" — misclassified as an unresolved generic-param stub
// and erased to `nova_int`. A SECOND, narrower instance of the same root
// surfaced downstream: `Option[Self]`'s STRUCTURAL-equality registration
// (`register_novaopt_decl`) fired eagerly (as a side effect of computing the
// field's C type) and, for the same reason, saw no schema yet — so it silently
// degraded to pointer-identity comparison instead of structural equality
// (`Some(nodeA) == Some(nodeB)` false for two separately-allocated-but-equal
// linked lists).
//
// THE FIX: `being_defined_record_types` (mirrors the pre-existing
// `being_defined_sum_types` guard used for self-referential SLICE variants)
// marks a record concrete WHILE its own fields are lowered, consulted
// UNCONDITIONALLY (the exact failing call site — `Option`'s inner-type check —
// passes the `full=false` variant that used to skip the sum-type guard
// entirely too). The eq-registration side effect is now DEFERRED
// (`pending_structural_eq_bodies`, drained once every non-generic type
// declaration is complete) instead of built eagerly mid-emission.
//
// This fixture proves: (1) the record compiles and links; (2) field
// read/write of the `next Option[Self]` slot round-trips correctly; (3)
// structural `==` on two separately-allocated-but-equal chains is TRUE
// (proves the deferred structural-eq fix, not just "doesn't crash").

module spec_tests.conformance

priv(file) type Node {
    value int
    next Option[Node]
}

fn len(n Option[Node]) -> int => match n {
    None       => 0
    Some(node) => 1 + len(node.next)
}

fn sum(n Option[Node]) -> int => match n {
    None       => 0
    Some(node) => node.value + sum(node.next)
}

test "Option[Self] linked-list round-trips through field read/write" {
    ro tail  = Node { value: 3, next: None }
    ro mid   = Node { value: 2, next: Some(tail) }
    ro head  = Node { value: 1, next: Some(mid) }
    assert(len(Some(head)) == 3, "three-node chain has length 3")
    assert(sum(Some(head)) == 6, "1 + 2 + 3")
    match head.next {
        Some(inner) => assert(inner.value == 2, "traversal reads the second node")
        None        => assert(false, "expected Some")
    }
}

test "structural == on separately-allocated-but-equal chains is TRUE" {
    ro a1 = Node { value: 1, next: None }
    ro a2 = Node { value: 2, next: Some(a1) }
    ro b1 = Node { value: 1, next: None }
    ro b2 = Node { value: 2, next: Some(b1) }
    assert(a2 == b2, "two independently-built equal chains compare structurally equal")
    ro c1 = Node { value: 9, next: None }
    ro c2 = Node { value: 2, next: Some(c1) }
    assert(!(a2 == c2), "different tail value makes the chains unequal")
    ro d2 = Node { value: 2, next: None }
    assert(!(a2 == d2), "Some(...) vs None tail makes the chains unequal")
}

test "option_self_linked_list smoke" {
    ro head = Node { value: 1, next: Some(Node { value: 2, next: None }) }
    assert(len(Some(head)) == 2, "smoke: two-node chain")
    println("all assertions passed")
}
