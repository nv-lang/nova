// Plan 150 / D248 — `==`/`!=` on bool stay legal; only relational < <= > >= are
// banned for bool operands.
//
// The `// EXPECT_STDOUT: ok` marker that stood here is REMOVED, not relaxed
// (registry #942). Written with a colon, it asked for the substring `: ok`,
// which this file's own output (`ok`, on its own line) never contained. What
// satisfied it was an unrelated test's NAME in another file -- the harness
// line `PASS: ok-path ...` -- so the verdict of this fixture hung on a string
// it does not own. The assertions below always carried the meaning, and since
// #942 they are what the runner actually judges.

module spec_tests.conformance
test "p4_bool_equality_legal smoke" {
    assert(true == true)
    assert(true != false)
    ro a = (3 < 5)
    ro b = (5 < 3)
    assert(a != b)
    assert(a == true)
    println("ok")
}
