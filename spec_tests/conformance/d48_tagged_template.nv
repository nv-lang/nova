// D48 — Tagged template literals: `tag`...${e}...`` = сахар над вызовом
// tag(parts []str, args []T) — сегменты и значения раздельно
// (spec/decisions/03-syntax.md §D48). parts.len() == args.len() + 1.
// Один folder-module `spec_tests.conformance`.
module spec_tests.conformance

fn d48_fmt(parts []str, args []int) -> str {
    mut d48_out = parts[0]
    mut d48_i = 0
    for d48_a in args {
        d48_out = d48_out.concat(d48_a.to_str()).concat(parts[d48_i + 1])
        d48_i += 1
    }
    d48_out
}

test "tagged template: desugar в tag(parts, args) (D48)" {
    ro d48_x = 1
    ro d48_y = 2
    ro d48_s = d48_fmt`x=${d48_x}, y=${d48_y}!`
    assert(d48_s == "x=1, y=2!")
}

test "tagged template: без интерполяций — один сегмент (D48)" {
    ro d48_raw = d48_fmt`plain`
    assert(d48_raw == "plain")
}
