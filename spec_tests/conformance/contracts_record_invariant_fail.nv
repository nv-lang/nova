//
// Plan 33.3 Ф.9.2: record invariant violation на конструкции →
// runtime contract violation в debug.

module spec_tests.conformance
type Account1 {
    balance int
}
    invariant balance >= 0

test "contracts record invariant fail" panics "invariant failed: balance >= 0" {
    ro bad = Account1 { balance: -100 }
    println("UNREACHABLE")
    ro _ = bad
}
