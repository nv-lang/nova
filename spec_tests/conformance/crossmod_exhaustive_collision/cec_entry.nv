// Вход, стягивающий ОБА одноимённых `CecKind` в один CU — без этого коллизии
// нет и проба ничего не показывает.
//
// ЧТО ЭТА ПАРА ФИКСТУР ДОКАЗЫВАЕТ СЕЙЧАС: обе половины компилируются и
// работают, то есть коллизия сама по себе не ломает исполнение. Красный сигнал
// живёт в соседней neg-фикстуре `neg/d65_exhaustive_blinded_by_collision_neg.nv`:
// там `match` НЕ покрывает вариант, и до окна W6 отказа НЕ БУДЕТ — проверка
// снимет себя самопроверкой разрешения.
module crossmod_exhaustive_collision.cec_entry

// `cec_b` импортируется РАДИ КОЛЛИЗИИ, а не ради вызова: его `CecKind` обязан
// попасть в тот же CU, иначе одноимённых типов два не станет. Имя оттуда не
// берём намеренно — взяв его, мы бы разрешили неоднозначность за чекера и
// проба перестала бы что-либо показывать.
import ./cec_a.{CecKind, describe_a}
import ./cec_b.{describe_b}

test "two same-named sums in one CU: both halves still work (221.1 No. 705)" {
    assert(describe_a(CecKind.Alpha) == 1)
    assert(describe_a(CecKind.Beta) == 2)
    assert(describe_a(CecKind.Gamma) == 3)
}
