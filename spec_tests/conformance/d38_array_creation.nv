// D38 — создание массивов: (1) литерал + annotation, (2) inference из контекста,
// (3) static-методы на типе массива `[]T` (`[]T.new()` / `[]T.new().cap(n)`,
// ex-`with_capacity(n)`, D372 amend 2026-07-06).
// Turbofish: `[T]` после имени без `::`.
// Spec: spec/decisions/03-syntax.md D38. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

// inference: пустой `[]` выводится из параметра `[]int`.
fn d38_len(xs []int) -> int => xs.len()
fn d38_sum(xs []int) -> int {
    mut s = 0
    for x in xs { s = s + x }
    s
}
fn d38_first_str(xs []str) -> str => if xs.len() > 0 { xs[0] } else { "" }

test "array literal + annotation — [1,2,3] (D38)" {
    ro xs []int = [1, 2, 3]
    assert(xs.len() == 3)
    assert(xs[0] == 1)
    assert(xs[2] == 3)
}

test "empty array literal + annotation, then push (D38)" {
    mut e []int = []
    assert(e.len() == 0)
    e.push(9)
    assert(e.len() == 1)
    assert(e[0] == 9)
}

test "inference of empty [] from parameter type (D38)" {
    assert(d38_len([]) == 0)
    assert(d38_len([10, 20]) == 2)
}

test "inference from str[] parameter (D38)" {
    assert(d38_first_str([]) == "")
    assert(d38_first_str(["hello", "world"]) == "hello")
}

test "static method []int.new() creates empty array (D38)" {
    ro n []int = []int.new()
    assert(n.len() == 0)
}

test "static method []int.new().cap(n) creates pre-allocated array (D38 / D372 amend)" {
    mut cap []int = []int.new(cap: 8)
    assert(cap.len() == 0)
    cap.push(1)
    cap.push(2)
    assert(cap.len() == 2)
    assert(cap[0] == 1)
    assert(cap[1] == 2)
}

test "[]str.new() and []str.new().cap(n) work (D38 / D372 amend)" {
    ro empty []str = []
    assert(empty.len() == 0)
    mut words []str = []str.new(cap: 4)
    words.push("alpha")
    words.push("beta")
    assert(words.len() == 2)
    assert(words[0] == "alpha")
}

test "array literal used directly in sum function (D38)" {
    assert(d38_sum([1, 2, 3, 4, 5]) == 15)
    assert(d38_sum([]) == 0)
}

test "array literal with bool elements (D38)" {
    ro flags []bool = [true, false, true]
    assert(flags.len() == 3)
    assert(flags[0] == true)
    assert(flags[1] == false)
    assert(flags[2] == true)
}

// [M-record-elem-vec-bare-ctor-miscompile] regression: a RECORD-element vector
// built with the `[]Rec.new()` static must lower to the real `Nova_Vec____<Rec>`
// mono — NOT an erased `nova_int`-slot NovaArray, which silently truncated the
// value-record (heap corruption) / CC-FAILed at `.get()`. Values are asserted
// AFTER the SECOND push (the point at which the erased path corrupted the slot).
type D38Kv value { ro key str, ro val int }
type D38Name value { ro n int }
type D38Val value { ro v int }

test "[]Rec.new() with NAMED record literal push — values survive 2nd push (D38)" {
    mut out = []D38Kv.new()
    out.push(D38Kv { key: "a", val: 1 })
    out.push(D38Kv { key: "b", val: 2 })
    assert(out.len() == 2)
    assert(out.get(0)!!.key == "a")
    assert(out.get(0)!!.val == 1)
    assert(out.get(1)!!.key == "b")
    assert(out.get(1)!!.val == 2)
}

test "[]Rec.new() with ANONYMOUS record literal push — values survive 2nd push (D38)" {
    mut out = []D38Kv.new()
    out.push({ key: "x", val: 10 })
    out.push({ key: "y", val: 20 })
    assert(out.len() == 2)
    assert(out.get(0)!!.key == "x")
    assert(out.get(0)!!.val == 10)
    assert(out.get(1)!!.key == "y")
    assert(out.get(1)!!.val == 20)
}

test "[]Rec.new().cap(n) (ex-with_capacity) with record literals (D38 / D372 amend)" {
    mut out = []D38Kv.new(cap: 4)
    out.push(D38Kv { key: "c", val: 3 })
    out.push({ key: "d", val: 4 })
    assert(out.len() == 2)
    assert(out.get(0)!!.val == 3)
    assert(out.get(1)!!.key == "d")
}

test "record-tuple empty literal `[](Rec, Rec) = []` push — values survive 2nd push (D38)" {
    mut out [](D38Name, D38Val) = []
    out.push((D38Name { n: 1 }, D38Val { v: 10 }))
    out.push((D38Name { n: 2 }, D38Val { v: 20 }))
    assert(out.len() == 2)
    assert(out.get(0)!!.0.n == 1)
    assert(out.get(0)!!.1.v == 10)
    assert(out.get(1)!!.0.n == 2)
    assert(out.get(1)!!.1.v == 20)
}
