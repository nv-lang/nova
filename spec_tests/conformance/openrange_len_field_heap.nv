// Plan 284 F.1 pos (heap storage class): a user-defined HEAP record
// (`type ByteBag { ... }`, default allocation — `Nova_ByteBag*`, no
// `Nova_Vec____`/`nova_str`/`NovaArray_` involved) gets `x[a..]` open-range
// slicing through its OWN `.nv` methods, by SATISFYING THE ROLE: `@index(r
// Range)` plus `@end_index() -> int`. Nothing about the type's name is
// consulted, and nothing about its FIELDS either.
//
// This file used to pin the previous test — the presence of a structural
// field literally named `len` ([M-open-range-len-source-hardcoded] Ф.2).
// That test admitted any type whose `len` happens to be a counter or a
// capacity, silently and wrongly, which is why plan 284 retires it. The
// migration is one added method: the file now proves the stronger thing,
// that the slice is reachable by a USER type through the role.
//
// Two storage classes are two fixtures on purpose (the value-record sibling
// is `openrange_len_field_value.nv`): the open end is now materialized by a
// CALL, so the C access form for a field is no longer what varies — but the
// receiver ABI still does, and a role satisfied on a heap handle must be
// satisfied on a stack value too.

module spec_tests.conformance
import std.collections.range.{Range}

type ByteBag {
    len int
}

fn ByteBag @index(r Range) -> ByteBag {
    ByteBag { len: r.end - r.start }
}

fn ByteBag @len() -> int => @len

// The role's second method: the end of THIS value's index space, asked and
// answered by the type itself. Here it coincides with the `len` field, and
// that coincidence is the point — a type is free to answer differently.
fn ByteBag @end_index() -> int => @len

test "heap user record with len int field gets open-range slice for free" {
    ro b = ByteBag { len: 10 }
    ro v = b[3..]
    assert(v.len() == 7)
}

test "heap user record with len int field: closed range still works too" {
    ro b = ByteBag { len: 10 }
    ro v = b[2..5]
    assert(v.len() == 3)
}
