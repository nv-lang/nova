//
// Plan 96 Ф.4 — негатив: arr[5..3] (a > b) → panic.
// D239 ([]T≡Vec): сообщение паники `Vec: slice [a..b] out of bounds for length N`
// (было `array: slice`). Директива выровнена под новый текст.

module spec_tests.conformance
test "neg slice a gt b" panics "Vec: slice" {
    mut arr = [1, 2, 3, 4, 5, 6]
    ro _ = arr[5..3]
}
