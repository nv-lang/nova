module spec_tests.conformance
// [M-fixed-array-value-semantics]: [N]T как поле record'а — inline-хранение
// по месту (C: `T name[N];` внутри struct), включая GC-скан для str-элементов.

type Packet {
    id int,
    mut image [4]u8,
}

test "[N]u8 field in heap record: inline storage, mutation" {
    mut p = Packet { id: 7, image: [1, 2, 3, 4] }
    assert(p.id == 7)
    assert(p.image[0] == 1)
    assert(p.image[3] == 4)
    p.image[2] = 99
    assert(p.image[2] == 99)
}

type Tags {
    mut names [3]str,
}

test "[N]str field survives forced GC (heap-record scan)" {
    mut t = Tags { names: ["", "", ""] }
    mut i = 0
    while i < 3 {
        t.names[i] = "tag_${i}_data"
        i = i + 1
    }
    mut k = 0
    while k < 3 {
        mut garbage []str = []
        mut j = 0
        while j < 1000 {
            garbage.push("junk_${j}")
            j = j + 1
        }
        gc.collect()
        k = k + 1
    }
    assert(t.names[0] == "tag_0_data")
    assert(t.names[1] == "tag_1_data")
    assert(t.names[2] == "tag_2_data")
}

type Vec2 value {
    x f64,
    y f64,
}

test "[N]ValueRecord elements" {
    mut pts [2]Vec2 = [Vec2 { x: 1.0, y: 2.0 }, Vec2 { x: 3.0, y: 4.0 }]
    assert(pts[0].x == 1.0)
    assert(pts[1].y == 4.0)
    pts[1] = Vec2 { x: 30.0, y: 40.0 }
    assert(pts[1].x == 30.0)
    assert(pts[0].x == 1.0)
}
