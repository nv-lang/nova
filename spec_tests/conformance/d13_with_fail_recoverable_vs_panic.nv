// D13 (panic — fiber-уровень) × Plan 173 Ф.1: `with Fail[E]` перехватывает
// ТОЛЬКО recoverable USER-ошибки (throw E); panic пробрасывается сквозь
// (runtime neg-тест expected_runtime/with_fail_panic_not_swallowed.nv).
// Здесь — позитив recoverable-стороны: USER throw пойман handler'ом, результат
// из interrupt; выполнение продолжается штатно (регресс-гард к panic-fix).
// Spec: spec/decisions/08-runtime.md D13. Part of the SINGLE conformance module.
module spec_tests.conformance

type D13FailErr { code int }

fn d13_may_fail(trip bool) Fail[D13FailErr] -> int {
    if trip {
        throw D13FailErr { code: 7 }
    }
    100
}

test "with Fail: recoverable USER throw пойман → handler result (D13/173)" {
    ro caught = with Fail = effect Fail {
        fail(_e) -> never { interrupt (-1) }
    } {
        d13_may_fail(true)
    }
    assert(caught == -1)   // handler отработал, вернул -1
}

test "with Fail: no-throw путь → нормальный результат (регресс-гард)" {
    ro ok = with Fail = effect Fail {
        fail(_e) -> never { interrupt (-1) }
    } {
        d13_may_fail(false)
    }
    assert(ok == 100)      // тело не бросило → его значение
}

// ── Plan 177 D325 A1 — R0/D13-граница: R1 (Result-everywhere) НЕ поглощает
// panic-категорию. «Падающая» операция в D325 R1 = EXPECTED/ENVIRONMENTAL
// (ввод, I/O, парсинг) → Result/Option (recoverable, ниже). CONTRACT-
// VIOLATION / programming error (OOB-index, integer overflow, div/0,
// mid-codepoint slice) → PANIC, НЕ Err и НЕ Fail (D13, 08-runtime.md:124-140).
// Здесь позитивно проверяется RECOVERABLE-сторона; panic-сторона доказана
// существующими EXPECT_RUNTIME_PANIC фикстурами (amend, не дублируем):
//   • v[oob]  → nova_tests/plan138/neg/t_neg_vec_index_oob.nv  ("array: index")
//   • overflow→ nova_tests/contracts/neg/int_overflow_{add,mul,compound}_panic.nv
//   • panic сквозь `with Fail` → nova_tests/expected_runtime/with_fail_panic_not_swallowed.nv
test "D325 A1/R0: expected-failure = Result/Option; panic-категория не съедена (D13)" {
    ro v []int = [10, 20, 30]
    assert(v.get(3) == None)              // OOB как ABSENCE → Option (safe, R4)
    assert(v.get(0) == Some(10))
    assert("x".to_int().ok() == None)   // bad input → Result → .ok() → None (R1)
    assert("7".to_int().ok() == Some(7))
    // Контраст (НЕ здесь — они panic'ают, аварийно завершая процесс):
    //   v[3] / (a + очень_большое) / (n / 0) → panic по D13, вне Result/Fail.
    // Их пруф — EXPECT_RUNTIME_PANIC фикстуры, перечисленные в шапке выше.
}
