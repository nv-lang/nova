// [M-c-keyword-ident-collision] (Plan 172.13) — a Nova identifier that
// collides with a reserved C keyword (`long`, `register`, `default`, ...)
// must NOT leak bare into the emitted C text: the emitter mangles it
// (`nv_<name>` prefix) at every place it becomes a bare C token — local
// var declaration/read/write, fn parameter, for-loop induction var,
// match-arm binding. Internal bookkeeping (var_types/var_mutable/etc.)
// stays keyed by the ORIGINAL Nova name; only the C-text form changes,
// so this is invisible to Nova source semantics.
//
// Discriminator: any of these four positions used to be CC-FAIL
// (`'long type-name' is invalid` / `use of undeclared identifier`)
// before the fix — a Nova program should never need to avoid the target
// C compiler's reserved words.
// Единица: folder-module `spec_tests.conformance`.
module spec_tests.conformance

// Position 1: local var (`let`/`ro`/`mut`) declared, mutated in a
// for-loop, and read — keyword `long`. Numeric accumulator (not string
// concat — perf-conventions W_STR_CONCAT_LOOP would flag `long = long +
// "a"` as O(N²); the discriminator here is the KEYWORD identifier on
// declare/assign/read, not the accumulated type).
fn c_kw_concat_pw() -> int {
    mut long = 0
    for i in 0..3 { long += 1 }
    long
}

// Position 2: fn parameter named after a C keyword (`register`).
fn c_kw_add_one(register int) -> int => register + 1

// Position 3: match-arm binding named after a C keyword (`default`),
// over a value-embedded `Option[int]` (NovaOpt_nova_int, dot-accessor). The
// manual `match` (not `o ?? 0`) is deliberate — the whole point of this case
// is a match-arm BINDING literally named `default`, which `?? 0` would erase
// entirely (no binding at all), defeating position 3.
fn c_kw_unwrap_or_zero(o Option[int]) -> int {
    // nova:allow W_MANUAL_COALESCE -- see comment above (keyword-named match-arm binding is the test subject)
    match o {
        Some(default) => default
        None => 0
    }
}

// Position 4: for-range loop induction variable itself named after a
// C keyword (`int`... no — `int` is a Nova primitive type name, use a
// non-type keyword instead: `goto`).
fn c_kw_sum_range(n int) -> int {
    mut total = 0
    for goto in 0..n { total += goto }
    total
}

test "C-keyword local var: declare/mutate/read (`long`)" {
    assert(c_kw_concat_pw() == 3)
}

test "C-keyword fn parameter (`register`)" {
    assert(c_kw_add_one(41) == 42)
}

test "C-keyword match-arm binding (`default`), value-embedded Option" {
    assert(c_kw_unwrap_or_zero(Some(7)) == 7)
    assert(c_kw_unwrap_or_zero(None) == 0)
}

test "C-keyword for-range loop induction var (`goto`)" {
    assert(c_kw_sum_range(4) == 6)  // 0+1+2+3
}

// ─── [M-c-keyword-mangle-destructure-tail] (Plan 172.13 batch 4) ───
// Batch 1 covered locals/params/for-vars/match-arm binds; these positions
// were honestly documented as NOT covered and are closed by batch 4:
// tuple-destructure bind names, record-destructure bind names (shorthand
// AND renamed), `if x is T` with a keyword-named scrutinee, defer-capture
// of a keyword-named local.

type CKwPoint {
    ro x int
    ro y int
}

type CKwShape enum
    | CKwCircle(int)
    | CKwSquare(int)

// Position 5: tuple-destructure bind names (`switch`, `case`) — both the
// direct-pairing path (`= (lit, lit)`) and the general tmp-struct path.
fn c_kw_tuple_direct() -> int {
    ro (switch, case) = (40, 2)
    switch + case
}

fn c_kw_make_pair() -> (int, int) => (40, 2)

fn c_kw_tuple_general() -> int {
    ro (switch, case) = c_kw_make_pair()
    switch + case
}

// Position 6: record-destructure bind names — shorthand `{ x }` would bind
// non-keyword names; the RENAMED form binds keywords (`signed`, `unsigned`).
fn c_kw_record() -> int {
    ro p = CKwPoint { x: 40, y: 2 }
    ro { x: signed, y: unsigned } = p
    signed + unsigned
}

// Position 7: `if x is T` narrowing with a keyword-named scrutinee binding
// (`register` holds the sum value; the is-test reads it).
fn c_kw_is(sh CKwShape) -> int {
    if sh is CKwCircle { 1 } else { 0 }
}

// Position 8: defer-capture of a keyword-named local (`union` captured and
// read inside the defer body via a keyword-named defer-local `volatile`).
fn c_kw_defer() -> int {
    mut union = 41
    defer {
        ro volatile = union
        ro _ = volatile
    }
    union += 1
    union
}

test "C-keyword tuple-destructure binds, direct pairing (`switch`/`case`)" {
    assert(c_kw_tuple_direct() == 42)
}

test "C-keyword tuple-destructure binds, general tmp path (`switch`/`case`)" {
    assert(c_kw_tuple_general() == 42)
}

test "C-keyword record-destructure renamed binds (`signed`/`unsigned`)" {
    assert(c_kw_record() == 42)
}

test "C-keyword scrutinee through `is`-narrowing (`register`)" {
    ro register = CKwCircle(5)
    assert(c_kw_is(register) == 1)
}

test "C-keyword local captured by defer (`union`/`volatile`)" {
    assert(c_kw_defer() == 42)
}
