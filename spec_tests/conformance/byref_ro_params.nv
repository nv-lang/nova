// Plan 172.14 Ф.1 — авто by-ref для больших (>16Б C-ABI) read-only
// value-struct параметров free-fn: корректность форм call-site
// (lvalue / rvalue / mut-локал / сквозная передача / именованный аргумент /
// fn-как-значение отравляет классификацию).

module spec_tests.conformance
type BigPair value { ro name str, ro value str }

fn bp_name(c BigPair) -> str => c.name
fn bp_via(c BigPair) -> str => bp_name(c)
fn bp_make(n str) -> BigPair => { name: n, value: "v" }
fn bp_taker(c BigPair) -> str => c.value

test "lvalue-аргумент ro-локал" {
    ro c = BigPair { name: "session", value: "abc" }
    assert(bp_name(c) == "session")
}

test "rvalue-аргументы (record-lit, результат вызова)" {
    assert(bp_name(BigPair { name: "rv", value: "x" }) == "rv")
    assert(bp_name(bp_make("mk")) == "mk")
}

test "mut-локал: копия-семантика сохранена" {
    mut c = BigPair { name: "m1", value: "x" }
    assert(bp_name(c) == "m1")
    c = BigPair { name: "m2", value: "y" }
    assert(bp_name(c) == "m2")
}

test "сквозная передача by-ref параметра" {
    ro c = BigPair { name: "ch", value: "x" }
    assert(bp_via(c) == "ch")
}

test "именованный аргумент" {
    ro c = BigPair { name: "nm", value: "x" }
    assert(bp_name(c: c) == "nm")
}

test "fn-как-значение отравляет by-ref (вызов через fn-pointer)" {
    ro f = bp_taker
    ro c = BigPair { name: "a", value: "fv" }
    assert(f(c) == "fv")
}
