// Plan 123.1 T2.10 (negative-style): static method `Type.method`
// — no @self/@field access → no caching attempted, no panic.

module spec_tests.conformance
type Calc3_2 {
    ro factor int
}

fn Calc3_2.constant() -> int {
    42
}

fn Calc3_2.from_pair(a int, b int) -> Calc3_2 {
    Calc3_2 { factor: a + b }
}

test "static methods unaffected" {
    ro c1 = Calc3_2.constant()
    assert(c1 == 42)
    ro c2 = Calc3_2.from_pair(3, 4)
    assert(c2.factor == 7)
}
