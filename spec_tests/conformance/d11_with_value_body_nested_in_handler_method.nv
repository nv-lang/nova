// D11 (with-синтаксис, «Форма 1: подмена через `EffectName = expr`») —
// регресс-гард на парсер-баг найденный Plan 197 audit (docs/plans/
// 197-audit-progress.md, «Системные находки» #2): `with EFFECT = value
// { ... }`, где `value` — bare-identifier (уже связанный handler,
// НЕ inline handler-литерал), не парсился, когда вложен ВНУТРИ тела
// handler-метода.
//
// Root cause: `parse_expr_or_handler_lit` (compiler-codegen/src/parser/
// mod.rs) держал obsolete pre-D61 эвристику «bare Path + `{` + первый
// токен внутри `Ident (` ⇒ трактовать как bare-form handler-литерал без
// keyword `effect`» (форма, retracted самим D11 §«Слово `handler` —
// keyword (D61)»). Эвристика ложно триггерилась на `alt { d11_helper() }`
// — вызов `d11_helper()` внутри with-тела выглядит как `Ident (`
// (сигнатура handler-метода), парсер уходил в handler-литерал-ветку и
// падал на `expected `=>` or `{` for handler-method body`, встретив
// закрывающую `}` with-тела. Fix: эвристика удалена (dead code post-D61
// — inline handler-литерал теперь ВСЕГДА требует `effect Name { ops }`),
// handler-value в `with`-биндинге парсится обычным `parse_expr()`
// (guarded `no_trailing_block`, как и раньше для non-Ident веток).
//
// Repro намеренно упрощён относительно оригинальной находки
// (orm_decorators.nv:145 — `primary.in_transaction(|| with Db = primary
// { b() })`): там `with` сидит ВНУТРИ closure-литерала, переданного
// HOF-аргументом — предметный паттерн, не существенный для самого
// парсер-бага. `parse_with`/`parse_expr_or_handler_lit` вызываются
// идентично независимо от того, обёрнут ли `with` ещё и в closure —
// существенно ТОЛЬКО «`with EFFECT = bare_ident { bare_ident2(...) }`
// внутри тела handler-метода», это и воспроизводит тест ниже
// (`alt` — bare-ident locally bound ВНУТРИ `exec()`, не захвачен из
// closure).
//
// (Было NB здесь: closure-обёрнутый вариант «один-в-один» с
// orm_decorators.nv:145 — nested closure, захватывающая ИМЕННО ТО ЖЕ
// имя, что уже #define-алиасится как context-field энклоузящего
// handler-литерала — упирался в ОТДЕЛЬНЫЙ codegen-дефект, macro-hygiene
// коллизию в emit_c.rs: `#define X (_c->X)`-алиасинг контекстного поля
// handler-method текстово подставлялся и в member-access вида
// `env_tmp->X = X;` — код, эмитируемый `emit_lambda` при инициализации
// env-структуры вложенного closure-литерала, захватывающего свободную
// переменную X — давая невалидный C `env_tmp->(_c->X) = (_c->X);`.
// ФИКС (Plan 196): env-struct поля вложенного closure переименованы в
// `_nv_fv_<lambda-id>_<name>` (см. `mangled_field` в `emit_lambda`,
// compiler-codegen/src/codegen/emit_c.rs) — токен, который никакой
// `#define` контекст-алиаса никогда не заспеллит, так что LHS
// member-access вне опасности коллизии независимо от того, какие
// capture-макросы активны в объемлющей области. Регресс-гард —
// `d11_ctx_closure_leaf`/тест «nested closure captures same-named
// context field» ниже.)
module spec_tests.conformance

type D11WithDb effect {
    exec() -> int
}

fn d11_leaf(tag int) -> Effect[D11WithDb] => effect D11WithDb {
    exec() -> int => tag
}

fn d11_helper() -> int => 99

// Handler, чей `exec()` устанавливает ВЛОЖЕННЫЙ `with` внутри
// собственного тела handler-метода (block-форма) — репродуцирует форму,
// диагностированную Plan 197 audit: `with EFFECT = value { ... }`,
// `value` — bare identifier, with-тело начинается с bare-call.
fn d11_wrapper() -> Effect[D11WithDb] => effect D11WithDb {
    exec() -> int {
        ro alt = d11_leaf(42)
        with D11WithDb = alt { d11_helper() }
    }
}

test "D11: `with EFFECT = value { ... }` парсится вложенным в тело handler-метода" {
    ro routed = d11_wrapper()
    ro result = with D11WithDb = routed { D11WithDb.exec() }
    assert(result == 99)
}

// Более простой (не-nested) вариант той же формы напрямую в обычном
// теле функции — регресс-гард, что фикс не сломал baseline-случай.
test "D11: `with EFFECT = value { ... }` — baseline (не вложенный) вариант" {
    ro primary = d11_leaf(7)
    ro result = with D11WithDb = primary { D11WithDb.exec() }
    assert(result == 7)
}

// Регресс-гард на macro-hygiene codegen-дефект из бывшего NB (см. выше):
// handler-литерал захватывает `primary` из объемлющего factory-fn как
// context-field (`#define primary (_c->primary)` активен на всё тело
// `exec()`), а внутри тела создаётся ВЛОЖЕННЫЙ closure-литерал `|| ...`,
// который захватывает переменную с ТЕМ ЖЕ ИМЕНЕМ `primary` как свой
// собственный free var. `emit_lambda` при инициализации env-структуры
// этого closure эмитит `env_tmp->primary = primary;` — без фикса LHS
// member-access `->primary` тоже подставлялся объемлющим `#define`,
// давая `env_tmp->(_c->primary) = ...` (invalid C). Паттерн — прямой
// аналог orm_decorators.nv:145 (`primary.in_transaction(|| with Db =
// primary { b() })`), упрощённый до голого closure-захвата без
// `with`-обёртки (сам `with` тут не существенен — существенно только
// имя-коллизия между context-capture'ом handler-метода и free var'ом
// вложенного closure-литерала).
// `primary` должен встречаться и НАПРЯМУЮ в теле `exec()` (это делает
// его captured context-field handler-литерала, `#define primary
// (_c->primary)`), И внутри вложенного closure-литерала (тот захватывает
// `primary` как СВОЙ собственный free var) — иначе не воспроизводится
// именно та коллизия, что была в orm_decorators.nv:145
// (`primary.in_transaction(|| with Db = primary { b() })`: `primary`
// одновременно receiver вызова снаружи И capture внутри closure'а).
fn d11_ctx_closure_leaf(primary int) -> Effect[D11WithDb] => effect D11WithDb {
    exec() -> int {
        ro base = primary
        ro doubled = || primary * 2
        base + doubled()
    }
}

test "D11: вложенный closure-литерал захватывает переменную с ТЕМ ЖЕ именем, что уже #define-алиасится как context-field handler-метода (macro-hygiene)" {
    ro h = d11_ctx_closure_leaf(21)
    ro result = with D11WithDb = h { D11WithDb.exec() }
    assert(result == 63)
}
