// D11 (with-синтаксис, «Форма 1: подмена через `EffectName = expr`») —
// регресс-гард на парсер-баг найденный Plan 197 audit (docs/plans/
// 197-audit-progress.md, «Системные находки» #2): `with EFFECT = value
// { ... }`, где `value` — bare-identifier (уже связанный handler,
// НЕ inline handler-литерал), не парсился, когда вложен ВНУТРИ тела
// handler-метода (nested в closure-аргументе вызова).
//
// Root cause: `parse_expr_or_handler_lit` (compiler-codegen/src/parser/
// mod.rs) держал obsolete pre-D61 эвристику «bare Path + `{` + первый
// токен внутри `Ident (` ⇒ трактовать как bare-form handler-литерал без
// keyword `effect`» (форма, retracted самим D11 §«Слово `handler` —
// keyword (D61)»). Эвристика ложно триггерилась на `primary { b() }` —
// `b()` внутри with-тела выглядит как `Ident (` (сигнатура handler-
// метода), парсер уходил в handler-литерал-ветку и падал на `expected
// `=>` or `{` for handler-method body`, встретив закрывающую `}`
// with-тела. Fix: эвристика удалена (dead code post-D61 — inline
// handler-литерал теперь ВСЕГДА требует `effect Name { ops }`), handler-
// value в `with`-биндинге парсится обычным `parse_expr()` (guarded
// `no_trailing_block`, как и раньше для non-Ident веток).
module spec_tests.conformance

type D11WithDb effect {
    exec() -> int
    in_transaction(b Effect[D11WithDb]) -> int
}

// Handler, чей `in_transaction` устанавливает ВЛОЖЕННЫЙ `with` внутри
// closure-аргумента, переданного в другой handler-метод (`primary.
// in_transaction(|| with D11WithDb = primary { b() })`) — ТОЧНО
// репродуцирующая форма из orm_decorators.nv:145 (Plan 197 audit).
fn d11_with_read_replica(primary Effect[D11WithDb]) -> Effect[D11WithDb] => effect D11WithDb {
    exec() => primary.exec()
    in_transaction(b) {
        primary.in_transaction(|| with D11WithDb = primary { b() })
    }
}

fn d11_make_primary(tag int) -> Effect[D11WithDb] => effect D11WithDb {
    exec() => tag
    in_transaction(b) => b()
}

test "D11: `with EFFECT = value { ... }` парсится вложенным в тело handler-метода" {
    ro primary = d11_make_primary(42)
    ro routed = d11_with_read_replica(primary)
    ro result = with D11WithDb = routed {
        D11WithDb.in_transaction(|| D11WithDb.exec())
    }
    assert(result == 42)
}

// Более простой (не-nested) вариант той же формы напрямую в обычном
// теле функции — регресс-гард, что фикс не сломал baseline-случай.
test "D11: `with EFFECT = value { ... }` — baseline (не вложенный) вариант" {
    ro primary = d11_make_primary(7)
    ro result = with D11WithDb = primary { D11WithDb.exec() }
    assert(result == 7)
}
