// const_init_runtime_ok_test.nv — Plan 173.3 addendum
// ([M-const-init-concurrency-gate]) pos-twin: ОБЫЧНЫЕ runtime-вызовы
// (обычные fn, аллокация, extern-класс net_addr_size) в module-level
// `ro`-инициализаторе ЛЕГАЛЬНЫ — E_CONST_INIT_CONCURRENCY бьёт только
// конкуренцию (spawn/supervised/detach/parallel for/select/каналы/Detach-fn).
// Neg-twins: neg/const_init_{spawn,supervised,detach_fn}.nv.

module spec_tests.conformance
fn compute_dim() -> int {
    mut acc = 0
    for i in 1..4 {
        acc += i
    }
    acc
}

// Runtime-вызов (не-constexpr) в module-level ro — легален.
ro module_dim = compute_dim()

fn alloc_len() -> int {
    // Аллокация в ro-init — легальна (single-threaded до арминга воркеров).
    // (module-ro слот V1 надёжно типизируется для скаляров — str-слоты из
    // fn-возврата пока int-дефолтятся, pre-existing module-init ограничение.)
    ro v = Vec[int].of(1, 2, 3)
    v.len()
}

ro module_len = alloc_len()

test "module-level ro runtime initializers stay legal (non-concurrent)" {
    assert(module_dim == 6)
    assert(module_len == 3)
}
