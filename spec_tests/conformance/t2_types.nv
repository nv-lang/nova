// Plan 120 (D215): T2 — various named tuple types.

module spec_tests.conformance
type Vec31(x f64, y f64, z f64)
type Color3(r u8, g u8, b u8, a u8)

// №145: positional construction — no defaults, D102 forbids named-arg form.
test "Vec31: construct and access all fields" {
    ro v = Vec31(1.0, 2.0, 3.0)
    assert(v.x == 1.0)
    assert(v.y == 2.0)
    assert(v.z == 3.0)
}

test "Color3: all four components" {
    ro c = Color3(255, 0, 128, 255)
    assert(c.r == 255)
    assert(c.g == 0)
    assert(c.b == 128)
    assert(c.a == 255)
}

test "positional anonymous tuple back-compat" {
    ro p = (3.0, 4.0)
    assert(p.0 == 3.0)
    assert(p.1 == 4.0)
}
