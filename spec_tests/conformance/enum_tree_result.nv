// [M-result-direct-recursive-enum] POSITIVE regression (Plan 186,
// recursive-mono, 2026-07-10).
//
// `Result[X, E]` where the heap sum `X` has a DIRECTLY self-recursive variant
// (tuple-, record-, and `[]X` Vec-shaped alike) used to deterministically
// blow up the compiler: builds were observed consuming 8-17+ GB / never
// finishing. Minimal trigger: an 11-variant self-recursive enum (mirroring
// `std/text/regex.nv`'s `RegexNode`) plus a SINGLE trivial function returning
// `Result[RegexNode, CompileError]` — no `==` even appears in source.
//
// ROOT CAUSE (emit_c.rs `emit_field_eq`): registering `Result[X, E]`
// (`register_novares_decl`) eagerly registers `Option[X]`/`Option[E]` too (for
// the `.ok()`/`.err()` accessor return types), which for a heap user sum/
// record `X` routes through STRUCTURAL equality synthesis. That synthesis
// re-INLINED the full per-variant/per-field comparison at every nesting
// level for a self-referential field — bounded only by a generic
// `MAX_EQ_DEPTH = 32` cutoff — so an N-variant self-recursive type produced
// `O(branching^depth)` STRING growth (many GB) well before that cutoff was
// even reached.
//
// THE FIX: `struct_eq_stack` tracks type-names currently being expanded; a
// TRUE cycle (the same type re-entered) breaks out of inlining and routes
// through a NAMED, once-emitted `nova_struct_eq_<T>` function instead — the
// self-referential field is a real C heap POINTER, so a plain recursive
// FUNCTION CALL lets the C compiler/runtime handle the actual (finite) data
// depth, instead of unrolling the comparison at COMPILE time. Non-cyclic
// types are byte-for-byte unaffected.
//
// This fixture proves: (1) the type + `Result`-returning function compile and
// link in reasonable time (no multi-GB blowup); (2) structural `==` on
// self-recursive variants (bare, nested, and inside a `Result`) is CORRECT —
// not just "doesn't hang".

module spec_tests.conformance

export type BTree enum
    | BLeaf(int)
    | BNode { left BTree, right BTree }
    | BList([]BTree)

export type BErr enum
    | BFail { msg str }

fn build(n int) -> Result[BTree, BErr] {
    if n <= 0 {
        return Ok(BLeaf(0))
    }
    Ok(BNode { left: BLeaf(n), right: BLeaf(n - 1) })
}

fn depth(t BTree) -> int => match t {
    BLeaf(_)          => 1
    BNode { left, right } => 1 + max_int(depth(left), depth(right))
    BList(items)      => 1 + fold_max_depth(items)
}

fn fold_max_depth(items []BTree) -> int {
    mut best = 0
    for it in items {
        ro d = depth(it)
        if d > best { best = d }
    }
    best
}

fn max_int(a int, b int) -> int => if a > b { a } else { b }

test "self-recursive enum through Result builds and evaluates correctly" {
    ro r = build(5)
    match r {
        Ok(t) => assert(depth(t) == 2, "one BNode level over two BLeaf children")
        Err(_) => assert(false, "should not error")
    }
}

test "structural == on self-recursive tuple/record/Vec variants" {
    ro a = BNode { left: BLeaf(1), right: BLeaf(2) }
    ro b = BNode { left: BLeaf(1), right: BLeaf(2) }
    ro c = BNode { left: BLeaf(1), right: BLeaf(3) }
    assert(a == b, "structurally identical trees compare equal")
    assert(!(a == c), "different leaf value makes the trees unequal")

    ro nested_a = BNode { left: a, right: BLeaf(9) }
    ro nested_b = BNode { left: b, right: BLeaf(9) }
    assert(nested_a == nested_b, "nested self-recursive equality (two levels)")

    ro list_a = BList([BLeaf(1), BNode { left: BLeaf(2), right: BLeaf(3) }])
    ro list_b = BList([BLeaf(1), BNode { left: BLeaf(2), right: BLeaf(3) }])
    ro list_c = BList([BLeaf(1), BNode { left: BLeaf(2), right: BLeaf(4) }])
    assert(list_a == list_b, "Vec[Self] variant compares element-wise equal")
    assert(!(list_a == list_c), "Vec[Self] variant detects a differing element")

    ro r1 = build(5)
    match r1 {
        Ok(t) => assert(t == BNode { left: BLeaf(5), right: BLeaf(4) },
                         "Result-returned tree compares structurally equal")
        Err(_) => assert(false, "should not error")
    }
}

fn main() {
    ro r = build(3)
    match r {
        Ok(t)  => assert(depth(t) == 2, "smoke: depth of a single BNode")
        Err(_) => assert(false, "should not error")
    }
    println("all assertions passed")
}
