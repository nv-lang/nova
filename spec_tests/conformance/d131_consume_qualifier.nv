// D131 — `consume` квалификатор логической линейности: receiver или параметр.
// После consume-вызова переменная-источник логически инвалидируется.
// Compile-time: flow-sensitive анализ. Runtime: метод зануляет внутренний стейт.
// Spec: spec/decisions/05-memory.md D131. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

// Consume receiver: метод забирает значение целиком
type D131Builder { data str }
fn D131Builder consume @into_finish() -> str => @data

fn d131_make(s str) -> D131Builder => { data: s }

// Consume parameter: функция забирает аргумент
fn d131_extract(consume b D131Builder) -> str => b.into_finish()

test "consume receiver: returns value and logically invalidates source (D131)" {
    ro b = d131_make("hello world")
    ro result = b.into_finish()
    assert(result == "hello world")
}

test "consume parameter: function takes ownership of argument (D131)" {
    ro b = d131_make("nova")
    ro result = d131_extract(b)
    assert(result == "nova")
}

test "consume method chaining (D131)" {
    ro b = d131_make("chain")
    assert(b.into_finish() == "chain")
}

// D347 amend (Plan 181): same-scope rebind consume-family имени после
// потребления — pipeline, тихо (R5). `d131_extract` потребляет `b`; затем имя
// `b` переопределяется str-результатом.
test "D347: rebind consume-binding имени после потребления (D131×D347)" {
    ro b = d131_make("re")
    ro b = d131_extract(b)
    assert(b == "re")
}
