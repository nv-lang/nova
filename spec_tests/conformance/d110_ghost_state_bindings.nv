// D110 — Ghost state: spec-only bindings (`ghost ro`/`ghost mut`) visible in
// requires/ensures/invariant but NEVER emitted to C. Runtime behaviour is unaffected.
// Spec: spec/decisions/02-types.md D110. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

// Function that declares a ghost binding (erased in codegen, runtime unaffected)
fn d110_fill_zeros(mut xs []int) {
    ghost ro n = xs.len()   // spec-only: tracks original length; never emitted
    for i in 0..xs.len() {
        xs[i] = 0
    }
}

fn d110_sum(xs []int) -> int {
    ghost ro len_hint = xs.len()   // ghost for spec documentation; erased
    mut total = 0
    for i in 0..xs.len() {
        total = total + xs[i]
    }
    total
}

test "ghost binding declared in function body; runtime unaffected (D110)" {
    mut v = [1, 2, 3, 4, 5]
    d110_fill_zeros(v)
    assert(v[0] == 0)
    assert(v[1] == 0)
    assert(v[4] == 0)
}

test "ghost binding in sum function; result is correct (D110)" {
    mut xs = [10, 20, 30]
    assert(d110_sum(xs) == 60)
}

test "ghost binding does not affect observable output (D110)" {
    mut v = [7, 8, 9]
    ghost ro original_len = v.len()   // spec-only: erased
    assert(v.len() == 3)
    v.push(10)
    assert(v.len() == 4)
    assert(v[3] == 10)
}
