// channel_closed_vs_value_test.nv — Plan 173 Ф.3 п.3 (D94 / D414 §3).
//
// Канон (Ред. 2): `Channel[T].recv() -> Option[T]` ОСТАЁТСЯ. Различение
// closed-vs-value — через `match rx.recv() { Some(v) => …; None => closed }`
// (None ⇔ channel closed И буфер пуст; после close буфер сперва дренится,
// потом None). Это механизм, на котором СТОИТ 173.1-десугар `parallel for`
// (completion-order dense через Option-канал). Тест фиксирует различение.

module spec_tests.conformance
test "recv distinguishes value (Some) from open-buffered channel" {
    ro ch = Channel[int].new(2)
    ro tx = ch.tx
    ro rx = ch.rx
    tx.send(7)
    ro opt = rx.recv()
    mut tag = -99
    match opt {
        Some(v) => { tag = v }
        None    => { tag = -1 }
    }
    assert(tag == 7)
}

test "recv distinguishes closed (None) from value; buffer drains before None" {
    ro ch = Channel[int].new(2)
    ro tx = ch.tx
    ro rx = ch.rx
    tx.send(11)
    tx.send(22)
    tx.close()          // close ПОСЛЕ двух send — буфер сперва дренится

    // Дренаж: два Some, затем None (closed+empty).
    mut got1 = -1
    match rx.recv() { Some(v) => { got1 = v }  None => { got1 = -1 } }
    mut got2 = -1
    match rx.recv() { Some(v) => { got2 = v }  None => { got2 = -1 } }
    mut got3 = 0
    match rx.recv() { Some(_) => { got3 = 1 }  None => { got3 = 0 } }

    assert(got1 == 11)          // буфер дренится
    assert(got2 == 22)
    assert(got3 == 0)           // None ⇔ closed+empty (различимо от Some)
    assert(rx.is_closed())      // is_closed() подтверждает closed, не просто empty
}

test "empty-open channel: is_closed false (None ≠ closed без close)" {
    ro ch = Channel[int].new(1)
    ro rx = ch.rx
    // Не читаем (recv заблокировал бы) — только проверяем closed-статус.
    assert(!rx.is_closed())     // открыт, пуст — НЕ closed
}
