// D337 — brotli C-FFI contract (Plan 179 Ф.2): brotli_decode over libbrotlidec
// (nova_rt/brotli_shim.c), conditionally linked. RFC 7932 vectors decode to the
// original bytes; bomb-cap (D334) trips OVER the FFI → Bomb; truncated/corrupt
// streams surface a typed CompressError. Vectors are the official google/brotli
// tests/testdata/*.compressed. Spec: spec/decisions/04-effects.md (D337).

module conformance.d337_brotli_ffi

import std.encoding.compress.{brotli_decode, ErrorKind}

fn d337_hex(s str) -> []u8 {
    ro chars = s.bytes()
    mut out []u8 = []u8.new(cap: chars.len() / 2)
    mut i = 0
    while i + 1 < chars.len() {
        ro hi = d337_hv(chars[i])
        ro lo = d337_hv(chars[i + 1])
        out.push(((hi << 4) | lo) as u8)
        i = i + 2
    }
    out
}

fn d337_hv(c u8) -> int {
    ro n = c as int
    if n >= 48 && n <= 57 { n - 48 }
    else if n >= 97 && n <= 102 { n - 97 + 10 }
    else if n >= 65 && n <= 70 { n - 65 + 10 }
    else { 0 }
}

test "d337: brotli_decode RFC 7932 vector (10x10y)" {
    ro comp = d337_hex("1b130000a4b0b2ea8147028a")
    assert(brotli_decode(comp, 1048576)!! == "XXXXXXXXXXYYYYYYYYYY".bytes())
}

test "d337: brotli_decode back-reference vector (64x)" {
    ro comp = d337_hex("1b3f000024b0e2998012")
    assert(brotli_decode(comp, 1048576)!! == "X".repeat(64).bytes())
}

test "d337: brotli_decode empty stream" {
    assert(brotli_decode(d337_hex("06"), 1048576)!! == []u8.new())
}

test "d337: bomb-cap trips over the FFI → Bomb (boundary exact)" {
    ro comp = d337_hex("1b130000a4b0b2ea8147028a")  // 20 bytes out
    assert(brotli_decode(comp, 19).is_err())         // 19 < 20 → Bomb
    assert(brotli_decode(comp, 20).is_ok())          // == cap → ok
    match brotli_decode(comp, 19) {
        Ok(_)  => assert(false)
        Err(e) => assert(e.is_bomb())
    }
}

test "d337: truncated stream → Err" {
    assert(brotli_decode(d337_hex("1b1300"), 1048576).is_err())
}

test "d337: corrupt stream → Err" {
    assert(brotli_decode(d337_hex("1b13ffffffffffff8147028a"), 1048576).is_err())
}
