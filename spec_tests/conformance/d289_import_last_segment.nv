// D289 — `import m`: last-segment qualified namespace (option b amend, ACTIVE).
// Норма (spec/decisions/07-modules.md §D289): `import a.b.m` без `.{}` и без `as`
// легален — последний сегмент пути (`m`) становится именем-namespace'ом в scope,
// доступ через `m.член`; `import X as X` (alias == last segment) →
// E_REDUNDANT_IMPORT_ALIAS; `import m as alias` — квалифицированный доступ через
// alias. Покрытие: (1) bare import + qualified вызов через last-segment;
// (2) `as alias` + вызов через alias. Негатив — neg/d289_redundant_alias_neg.nv.
// Шаблоны сверены с nova_tests/plan163. Один folder-module `spec_tests.conformance`.
module conformance.d289_import_last_segment

import std.runtime.raw_mem
import std.runtime.raw_mem as rmem

test "bare import: last-segment qualified доступ (D289)" {
    // raw_mem — последний сегмент std.runtime.raw_mem → namespace-имя.
    unsafe {
        ro d289_p = raw_mem.RawMem.alloc_uncollectable(8)
        raw_mem.RawMem.free_uncollectable(d289_p)
    }
}

test "import as alias: квалифицированный доступ через alias (D289)" {
    // alias (rmem ≠ last-segment) — легален; тот же модуль доступен и по
    // last-segment имени, и по alias'у.
    unsafe {
        ro d289_q = rmem.RawMem.alloc_uncollectable(4)
        rmem.RawMem.free_uncollectable(d289_q)
    }
}
