// Plan 91.3 Ф.3 (composites conformance): JSON roundtrip — flat object.
//
// `{"k": "v", "n": 42}` — простой объект с двумя полями разного типа.
// if-let semantic field checks (JsonValue без structural ==, nested match
// триггерит codegen edge case) — не зависит от порядка ключей.
//
// Plan p320 Фаза 3 (реестр 221.1 №319): `JsonValue.object()` теперь берёт
// `IndexMap[str, JsonValue]`, не `HashMap[str, JsonValue]` (D55-амендмент,
// поведенческое изменение: вывод теперь insertion-order, не sorted) —
// мигрировано вместе с ретайпом (этот тест не проверял конкретный порядок
// ключей в выводе, только len()/contains(), так что миграция чистая).
module spec_tests.conformance
import std.encoding.json.{JsonValue, Json}
import std.collections.index_map.{IndexMap}

test "parse flat object — keys present" {
    ro parsed = Json.parse("{\"k\": \"v\", \"n\": 42}")!!
    ro m_opt = parsed.object()
    assert(m_opt.is_some())
}

test "parse flat object — len = 2" {
    ro parsed = Json.parse("{\"k\": \"v\", \"n\": 42}")!!
    if Some(m) = parsed.object() {
        assert(m.len() == 2)
    } else {
        assert(false)
    }
}

test "roundtrip flat object preserves len + key existence" {
    mut m = IndexMap[str, JsonValue].new()
    m.insert("k", JsonValue.str("v"))
    m.insert("n", JsonValue.num(42.0))
    ro orig = JsonValue.object(m)
    ro encoded = orig.to_str()
    ro decoded = Json.parse(encoded)!!
    if Some(dm) = decoded.object() {
        assert(dm.len() == 2)
        assert(dm.contains("k"))
        assert(dm.contains("n"))
    } else {
        assert(false)
    }
}
