// Regression — a generic wrapper type with a protocol-bounded field whose method
// returns `Result[T, <value-record E>]`, constructed with EXPLICIT type-args
// (`Wrap[WMem].new(s)`, the std/io BufReader[BytesReader] pattern). Closes the
// value-record half of the keystone `[M-valuerecord-result-vtable-mono]`: the
// `WSrc` protocol vtable's `@pull` return type is `NovaRes_nova_int_NovaValue_WErr*`,
// now forward-declared before the vtable struct.
//
// NB: the INFERENCE form (`Wrap.new(s)` without `[WMem]`) is a SEPARATE, value-record
// independent gap (`[M-176-generic-wrapper-mono-inference]`) and is intentionally not
// exercised here.

module spec_tests.conformance

type WErr value { ro code int }

fn WErr.new(code int) -> WErr => { code }

type WSrc protocol {
    mut @pull(mut buf []u8) -> Result[int, WErr]
}

type WMem { ro data []u8, mut pos int }

fn WMem.new(data []u8) -> Self => { data, pos: 0 }

fn WMem mut @pull(mut buf []u8) -> Result[int, WErr] {
    ro cap = buf.len()
    if cap == 0 { return Ok(0) }
    ro rem = @data.len() - @pos
    if rem <= 0 { return Ok(0) }
    ro n = cap.min(rem)
    for i in 0..n {
        buf[i] = @data[@pos + i]
    }
    @pos += n
    Ok(n)
}

type Wrap[R] {
    mut inner R
    mut cnt int
}

fn Wrap[R].new(inner R) -> Self => { inner, cnt: 0 }

fn Wrap[R WSrc] mut @pull(mut buf []u8) -> Result[int, WErr] {
    @cnt += 1
    @inner.pull(buf)
}

test "generic wrapper (value-record error) with explicit type-args" {
    mut s = WMem.new("abcd")
    mut w = Wrap[WMem].new(s)
    mut buf []u8 = []u8.new()
    buf.resize(2, 0 as u8)
    match w.pull(buf) {
        Ok(n)  => { assert(n == 2); assert(buf[0] == 0x61 as u8) }
        Err(_) => assert(false)
    }
}
