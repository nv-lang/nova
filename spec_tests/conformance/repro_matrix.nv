// repro_handler_lit_records.nv — Plan 175 разведка: матрица выражений
// внутри тела оп-хендлера (`with Eff = effect Eff { op() { ... } }`),
// проверка каких форм codegen НЕ поддерживает (см. spec/decisions/04-effects.md
// D316-amend Ф.2: «codegen handler-литералов не поддерживает anonymous
// record-literal»).

module spec_tests.conformance
type Point12 { x int, y int }
type PointV value { ro x int, ro y int }

type MakesPoint effect {
    heap_record() -> Point12
    value_record() -> PointV
    anon_tuple() -> (int, int)
    ctor_call() -> Point12
}

type Shape2_2 enum
    | Circle2 { r int }
    | Square2 { side int }

type MakesShape effect {
    sum_variant() -> Shape2_2
}

test "handler-лит: heap record-литерал в теле опа" {
    with MakesPoint = effect MakesPoint {
        heap_record() -> Point12 { return Point12 { x: 1, y: 2 } }
        value_record() -> PointV => PointV { x: 3, y: 4 }
        anon_tuple() -> (int, int) => (5, 6)
        ctor_call() -> Point12 => Point12.new(7, 8)
    } {
        ro p = MakesPoint.heap_record()
        assert(p.x == 1)
        assert(p.y == 2)
        ro pv = MakesPoint.value_record()
        assert(pv.x == 3)
        assert(pv.y == 4)
        ro t = MakesPoint.anon_tuple()
        assert(t.0 == 5)
        assert(t.1 == 6)
        ro c = MakesPoint.ctor_call()
        assert(c.x == 7)
        assert(c.y == 8)
    }
}

test "handler-лит: sum-variant record в теле опа" {
    with MakesShape = effect MakesShape {
        sum_variant() -> Shape2_2 => Shape2_2.Circle2 { r: 9 }
    } {
        ro s = MakesShape.sum_variant()
        match s {
            Shape2_2.Circle2 { r } => assert(r == 9)
            _ => assert(false)
        }
    }
}

fn Point12.new(x int, y int) -> Point12 {
    Point12 { x, y }
}

// ==== Анонимные record-литералы (type_name: None) — задокументированный
// дефект D316-amend Ф.2: expected_record_type не подводится в handler-тело.

type AnonHeap effect {
    make() -> Point12
}

type AnonValue effect {
    make() -> PointV
}

test "handler-лит: анонимный heap record-литерал (=> форма)" {
    with AnonHeap = effect AnonHeap {
        make() -> Point12 => { x: 10, y: 20 }
    } {
        ro p = AnonHeap.make()
        assert(p.x == 10)
        assert(p.y == 20)
    }
}

test "handler-лит: анонимный heap record-литерал (block/return форма)" {
    with AnonHeap = effect AnonHeap {
        make() -> Point12 { return { x: 30, y: 40 } }
    } {
        ro p = AnonHeap.make()
        assert(p.x == 30)
        assert(p.y == 40)
    }
}

test "handler-лит: анонимный value record-литерал" {
    with AnonValue = effect AnonValue {
        make() -> PointV => { x: 50, y: 60 }
    } {
        ro pv = AnonValue.make()
        assert(pv.x == 50)
        assert(pv.y == 60)
    }
}

// ==== Замыкание (let-bound ClosureFull) в оп-теле — НЕ здесь.
// `ro f = fn(a int) -> int => a + 1` падает CC-FAIL («use of undeclared
// identifier f»: infer_expr_c_type(ClosureFull) → пустой ty_c) В ЛЮБОМ
// контексте, включая обычные тест-тела (nova_tests/basics/functions.nv
// падает на чистой базе 6582887e1) — предсуществующий дефект канала
// разметки ClosureFull (чекер аннотирует только zero-param ClosureLight;
// трек 172.12), НЕ хендлер-специфичный. Кейс исключён из матрицы,
// репро сохранено в отчёте волны handler-annot.

// ==== Захват + анонимный record в одном теле (не сломать capture-механизм).

type AnonWithCapture effect {
    make() -> Point12
}

test "handler-лит: захват локали + анонимный record" {
    mut base = 100
    with AnonWithCapture = effect AnonWithCapture {
        make() -> Point12 {
            base += 1
            return { x: base, y: base + 1 }
        }
    } {
        ro p = AnonWithCapture.make()
        assert(p.x == 101)
        assert(p.y == 102)
    }
    assert(base == 101)
}

// ==== Вложенные хендлеры: оба тела конструируют анонимные record'ы,
// оба захватывают локали (проверка, что per-op контекст-свитч не ломает
// capture-механизм и вложенную эмиссию #define/#undef).

type OuterEff effect {
    outer_make() -> Point12
}

type InnerEff effect {
    inner_make() -> PointV
}

test "вложенные handler-литы: анонимные record'ы + захваты на двух уровнях" {
    mut o_count = 0
    mut i_count = 0
    with OuterEff = effect OuterEff {
        outer_make() -> Point12 {
            o_count += 1
            return { x: o_count, y: o_count * 10 }
        }
    } {
        with InnerEff = effect InnerEff {
            inner_make() -> PointV {
                i_count += 5
                // вызов ВНЕШНЕГО эффекта из тела внутреннего опа
                ro op = OuterEff.outer_make()
                return { x: i_count + op.x, y: op.y }
            }
        } {
            ro pv = InnerEff.inner_make()
            assert(pv.x == 6)      // i_count(5) + op.x(1)
            assert(pv.y == 10)     // op.y = 1*10
            ro p2 = OuterEff.outer_make()
            assert(p2.x == 2)
        }
    }
    assert(o_count == 2)
    assert(i_count == 5)
}
