// D86-followup (2026-07-14): `consume X = RESULT ?? panic("msg")` (and, it
// turns out, the `!!`/`?` forms too) produced a `[D133-not-consumed]` with an
// EMPTY inferred type (`тип ``) whenever X was later flagged as not consumed.
// Root cause: `ConsumeCtx::infer_value_type` (compiler-codegen/src/types/mod.rs)
// — the AST-heuristic that fills `var_types` for the D133 linear checker — had
// NO arm at all for `Try`/`Bang`/`Coalesce`, so `consume X = expr?` / `expr!!`
// / `expr ?? fallback` all left X's var_types entry `None`. In practice
// `X.method()` still discharged the obligation via the coarse
// `is_any_consume_method` name-only fallback (28381 in types/mod.rs) — sound
// but type-blind — which is why the bug read as "Coalesce broken, Bang fine"
// even though both showed the same empty-type symptom pre-fix (verified: a
// `consume lst = T.bind(...)!!` neg-repro showed `тип ``` too). Fix:
// `infer_value_type` gained `Try`/`Bang`/`RefArg`/`Coalesce` arms that unwrap
// `Result[T,E]`/`Option[T]` → the Ok/Some-inner `T` via new
// `unwrapped_method_return_types`/`unwrapped_fn_return_types` companion
// registries (kept separate from `method_return_types`/`fn_return_types` so a
// bare, non-unwrapped call site is unaffected) — the D133 diagnostic now names
// the real type and the real consume-method (see neg/d86_coalesce_consume_neg.nv).
// Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

export type D86Res consume {
    id int,
}

export fn D86Res consume @close() -> () { () }

export fn d86_try_open(ok bool) -> Result[D86Res, str] {
    if ok { Ok(D86Res { id: 1 }) } else { Err("boom") }
}

export fn d86_try_open_opt(ok bool) -> Option[D86Res] {
    if ok { Some(D86Res { id: 2 }) } else { None }
}

test "?? consume: Result[ConsumeType,E] Ok-branch consumed via .close() (D86)" {
    consume r = d86_try_open(true) ?? panic("open failed")
    r.close()
}

test "?? consume: Option[ConsumeType] Some-branch consumed via .close() (D86)" {
    consume r = d86_try_open_opt(true) ?? panic("open failed")
    r.close()
}
