// D20 — `()` вместо `void`, сводка стрелок, function type syntax.
// `()` = unit type. `-> ()` = возвращает unit. Можно опустить.
// Символы: `->` тип возврата; `=>` тело/match-arm; `=` присваивание.
// Function type: всегда `fn(args) -> Ret` (бесколонная форма запрещена).
//
// Discriminator: без unit-type нет единого «нет значения»;
// без чёткого разделения стрелок - синтаксис неоднозначен.
//
// Spec: spec/decisions/03-syntax.md D20. Единица: folder-module `spec_tests.conformance`.
module conformance.d20_unit_type_arrows

fn d20_noop() -> () { }

fn d20_noop_implicit() { }

fn d20_apply(f fn() -> int) -> int => f()

fn d20_unit_in_option() -> Option[()] => Some(())

test "unit return explicit -> () (D20)" {
    d20_noop()
    assert(true)
}

test "unit return implicit (D20)" {
    d20_noop_implicit()
    assert(true)
}

test "function type fn() -> int as param (D20)" {
    ro r = d20_apply(fn() -> int { 42 })
    assert(r == 42)
}

test "unit as generic param Option[()] (D20)" {
    ro opt = d20_unit_in_option()
    assert(opt == Some(()))
}

test "Result[(), str] Ok(()) (D20)" {
    ro r Result[(), str] = Ok(())
    ro ok = r == Ok(())
    assert(ok)
}

test "unit array [()] has len 3 (D20)" {
    ro xs = [(), (), ()]
    assert(xs.len() == 3)
}
