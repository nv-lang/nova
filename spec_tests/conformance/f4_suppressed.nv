// Plan 173 Ф.4 #6/#7 (D158, model B — owner-approved 2026-07-06): a cleanup
// that fails while another error is propagating does NOT replace the primary.
// The primary is delivered to the catcher AS-IS (typed catch keeps working);
// the cleanup-failures travel out of band in a thread-local "pocket" and are
// read AFTER the catch via the free accessor `suppressed() -> []any`.
//
//   * #6 materialization: `suppressed()` builds a `[]any` from the runtime
//     suppressed-chain (NovaErrorChain) via `nova_failframe_suppressed_count`/
//     `_at`; each element narrows via `is T` / `.try_as[T]()`.
//   * #7 invariant: order = chronological (first-failed first); the chain
//     survives propagation (rethrow) through intermediate frames; the pocket is
//     reset on each fresh throw so it never leaks between unrelated catches.
//
// Catch idiom = the canonical `with Fail = |e| interrupt …` recovery: the throw
// runs the handler which `interrupt`s, unwinding THIS scope; a cleanup that
// fails while unwinding composes into the pocket (kind=DEFER_SCOPE keeps the
// in-flight error live). `suppressed()` is read once the block yields.

module spec_tests.conformance
type SupA { code int }
type SupB { tag int }

fn throw_a() Fail[SupA] -> () { throw SupA { code: 7 } }
fn throw_b() Fail[SupB] -> () { throw SupB { tag: 42 } }
fn throw_c() Fail -> () { throw "cleanup-C" }

// Body throws SupA (primary); one defer throws SupB (suppressed during unwind).
fn body_a_defer_b() Fail -> () {
    defer { throw_b() }
    throw_a()
}

// Body throws SupA; TWO defers fail. LIFO run order: the defer registered LAST
// (throw_c) fires FIRST, so chronological order of failures is [C, B].
fn body_a_defers_bc() Fail -> () {
    defer { throw_b() }
    defer { throw_c() }
    throw_a()
}

// Body throws SupA, no failing cleanup — pocket stays empty.
fn body_a_only() Fail -> () {
    throw_a()
}

// Intermediate fail-fn: composes C during unwind, then the primary A continues
// out to the caller's catch (chain must survive the extra frame).
fn mid_composes_c() Fail -> () {
    defer { throw_c() }
    throw_a()
}

// ── #6: single suppressed materializes and narrows ──────────────────────────
fn run_single() -> int {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_defer_b()
    }
    ro sup = suppressed()
    mut ok = 0
    if sup.len() == 1 {
        if sup.get(0)!! is SupB { ok = 1 }
    }
    ok
}

// ── #7: order = chronological firing order [C, B] ───────────────────────────
fn run_order_count() -> int {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_defers_bc()
    }
    suppressed().len()
}

fn run_order_first_is_c() -> bool {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_defers_bc()
    }
    ro sup = suppressed()
    // first-failed = C (a bare-str throw)
    match sup.get(0)!!.try_as[str]() {
        Some(m) => m == "cleanup-C"
        None => false
    }
}

fn run_order_second_is_b() -> bool {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_defers_bc()
    }
    ro sup = suppressed()
    sup.get(1)!! is SupB
}

// ── #7: empty pocket when no cleanup fails ──────────────────────────────────
fn run_empty() -> int {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_only()
    }
    suppressed().len()
}

// ── #7: chain survives propagation through an intermediate frame ────────────
fn run_rethrow() -> int {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        mid_composes_c()
    }
    suppressed().len()
}

// ── #7: unrelated sequential catches do not leak pockets ────────────────────
// First catch has suppressed [B]; a later, independent catch with no failing
// cleanup must see an EMPTY pocket (reset-on-throw), not the leftover [B].
fn run_no_leak() -> bool {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_defer_b()
    }
    ro c1 = suppressed().len()   // == 1
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        body_a_only()
    }
    ro c2 = suppressed().len()   // == 0 (did not inherit [B])
    c1 == 1 && c2 == 0
}

// ── #6 catchability (plan §6/#1, Ф.4 п.6): typed catch sees the PRIMARY as-is ─
// Body throws SupA, defer throws SupB. `with Fail[SupA]` still FIRES (the
// effect did not become Fail[MultiError]); `e` is the typed SupA (field
// readable); the cleanup failure is in the pocket, not in the handler.
fn run_typed_catch() -> int {
    ro code = with Fail[SupA] = |e| interrupt e.code {
        body_a_defer_b()
        0
    }
    ro sup = suppressed()
    mut ok = 0
    if code == 7 && sup.len() == 1 {
        if sup.get(0)!! is SupB { ok = 1 }
    }
    ok
}

// ── #7: catch + rethrow (handler-arm `throw e`) preserves the pocket ─────────
// Inner typed handler intercepts SupA and RE-THROWS it; the outer catch
// receives the same primary, and the cleanup failure composed during the
// final unwind is still visible in the pocket.
fn run_catch_rethrow() -> int {
    with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
        with Fail[SupA] = |e| throw e {
            body_a_defer_b()
            0
        }
    }
    ro sup = suppressed()
    mut ok = 0
    if sup.len() == 1 {
        if sup.get(0)!! is SupB { ok = 1 }
    }
    ok
}

test "f4 #6: single failing cleanup surfaces in suppressed() as typed any" {
    assert(run_single() == 1)
}

test "f4 #6: with Fail[Primary] catches typed primary; cleanup-fail in pocket" {
    assert(run_typed_catch() == 1)
}

test "f4 #7: catch + rethrow preserves the suppressed pocket" {
    assert(run_catch_rethrow() == 1)
}

test "f4 #7: two failing cleanups → suppressed() has both, chronological order" {
    assert(run_order_count() == 2)
    assert(run_order_first_is_c())
    assert(run_order_second_is_b())
}

test "f4 #7: no failing cleanup → suppressed() is empty" {
    assert(run_empty() == 0)
}

test "f4 #7: suppressed chain survives propagation through intermediate frame" {
    assert(run_rethrow() == 1)
}

test "f4 #7: unrelated sequential catches keep separate pockets (no leak)" {
    assert(run_no_leak())
}
