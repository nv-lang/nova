// Plan 138.1 Ф.4 — t8: []T == Vec[T] (B1/A8)
// fn f_veclit(a []int) accepts [1,2,3] literal and Vec[int].from([4,5]).

module spec_tests.conformance
import std.collections.vec.{Vec}

fn f_veclit(a []int) -> int {
    mut sum = 0
    for x in a { sum += x }
    sum
}

test "[]T param accepts array literal [1,2,3]" {
    assert(f_veclit([1, 2, 3]) == 6)
}

test "[]T param accepts Vec[int].from([4,5])" {
    ro v = Vec[int].from([4, 5])
    assert(f_veclit(v) == 9)
}

test "[]T param accepts empty literal" {
    assert(f_veclit([]) == 0)
}

test "[]T param accepts Vec[int].new() with pushes" {
    mut v = Vec[int].new()
    v.push(10)
    v.push(20)
    v.push(30)
    assert(f_veclit(v) == 60)
}
