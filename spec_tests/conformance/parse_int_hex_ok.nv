module spec_tests.conformance
import std.runtime.string.{ParseIntError}

test "hex uppercase" {
    match "FF".to_int(radix: 16) {
        Ok(n) => assert(n == 255)
        Err(_) => assert(false, "expected Ok(255)")
    }
    match "1A".to_int(radix: 16) {
        Ok(n) => assert(n == 26)
        Err(_) => assert(false, "expected Ok(26)")
    }
}

test "hex lowercase" {
    match "ff".to_int(radix: 16) {
        Ok(n) => assert(n == 255)
        Err(_) => assert(false, "expected Ok(255)")
    }
    match "1a".to_int(radix: 16) {
        Ok(n) => assert(n == 26)
        Err(_) => assert(false, "expected Ok(26)")
    }
}

test "hex mixed case and longer" {
    match "deadbeef".to_int(radix: 16) {
        Ok(n) => assert(n == 3735928559)
        Err(_) => assert(false, "expected Ok(3735928559)")
    }
    match "10".to_int(radix: 16) {
        Ok(n) => assert(n == 16)
        Err(_) => assert(false, "expected Ok(16)")
    }
}
