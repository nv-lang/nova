// Plan 83.10.3 (2026-05-26): triple-level nested supervised throw under armed M:N.
//
// Tests 3-level deep nested supervised scopes with throw propagation.
// Verifies cooperative resume works at each nesting depth.

module spec_tests.conformance
test "triple nested throw — outermost handler catches" {
    // Plan 238 Ф.4 (D441 §3): `with Fail[T]` handler runs IN THE FIBER of
    // the failing operation (Ф.0 measurement) — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER), тот же приём, что и test2 ниже.
    mut caught = AtomicBool.new(false)
    ro _ = with Fail[int] = |e| {
        caught.store(true)
        0
    } {
        supervised {
            spawn {
                supervised {
                    spawn {
                        supervised {
                            spawn { throw 42 }
                        }
                    }
                }
            }
        }
        0
    }
    assert(caught.load())
}

test "triple nested — normal completion all levels" {
    // Plan 173.3 (D415 §2): Atomic* вместо mut-захвата (E_CONCURRENT_MUT_CAPTURE).
    mut depth = AtomicInt.new(0)
    supervised {
        spawn {
            depth.fetch_add(1)
            supervised {
                spawn {
                    depth.fetch_add(1)
                    supervised {
                        spawn { depth.fetch_add(1) }
                    }
                }
            }
        }
    }
    assert(depth.load() == 3)
}
