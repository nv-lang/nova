// Plan 77 (D132) / Plan 174 (D409): user-defined `-> @` fluent-метод.
// `mut @method() -> @` — возврат receiver'а автоматический (D409); тело
// просто мутирует, chaining работает без ручного `@`.

module spec_tests.conformance
type Counter12 { mut n int }

fn Counter12.new() -> Counter12 => { n: 0 }

// fluent-метод: мутирует; возврат receiver'а — implicit (D409).
fn Counter12 mut @bump() -> @ {
    @n += 1
}

fn Counter12 @value() -> int => @n

test "user fluent-метод — chaining через -> @" {
    mut c = Counter12.new()
    ro r = c.bump().bump().bump()
    assert(r.value() == 3)
}

test "fluent + alias — потребления нет, ошибки нет" {
    mut c = Counter12.new()
    ro same = c.bump()        // same — алиас c (bump: -> @)
    assert(same.value() == 1)
}
