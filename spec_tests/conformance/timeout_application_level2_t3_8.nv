// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Plan 110.4.6.a (D192 Level 2 + D195) + Plan 173 Ф.5 п.2 (D192-РЕТРАКТ,
// миграция D195-Application-override теста с enter(timeout)-наблюдения на
// watchdog/overrun): Application effect Level-2 threshold resolution.
// ConsumeScope codegen consults `_nova_handler_Application` and dispatches
// `default_exit_timeout_ms()` IF Application handler bound, else falls back
// to Level 3 (5000ms). Порог теперь — источник watchdog-варна + overrun-флага
// exit-события (НЕ прерывания; force-timeout не существует).
//
// Наблюдение ПОВЕДЕНЧЕСКОЕ (timeout из enter-события дропнут — D185 amend):
//   - Application задаёт крошечный порог 1ms; cleanup спит 30ms →
//     overrun=true в exit-событии ⇔ Level-2 порог реально дошёл до watchdog.
//     (При Level-3 5000ms 30ms сна overrun бы НЕ дал — false-positive исключён.)
//   - Без Application-хендлера порог = Level 3 (5000ms); тот же 30ms-cleanup
//     → overrun=false. Cleanup в ОБОИХ случаях ДОБЕГАЕТ (D192-ретракт).

module spec_tests.conformance
type Res6 {
    ro id int
}

fn Res6.new(id int) -> Res6 => { id }
// Cleanup спит 30ms — при пороге 1ms (Level 2) это превышение,
// при пороге 5000ms (Level 3) — нет. Time — ambient (D62).
fn Res6 consume @cleanup(_outcome ScopeOutcome) -> () {
    (30).to_millis().sleep()
    return ()
}

test "Plan 110.4.6.a + 173 Ф.5.2: Application Level-2 порог доходит до watchdog (overrun=true)" {
    mut observed_overrun = false
    mut observed_duration = -1
    with Application = effect Application {
        register_finalizer(_f) -> () {
            return ()
        }
        default_exit_timeout_ms() -> int {
            return 1
        }
    } {
        with ResourceTrace = effect ResourceTrace {
            on_resource_enter(_label) -> () { return () }
            on_resource_exit(_label, _outcome, duration_ms, overrun) -> () {
                observed_duration = duration_ms
                observed_overrun = overrun
                return ()
            }
        } {
            consume r = Res6.new(1) {
                ro _ = r.id
            }
        }
    }
    // Cleanup ДОБЕЖАЛ (сон 30ms завершился — duration это отражает),
    // порог 1ms из Application (Level 2) превышен → overrun.
    assert(observed_duration >= 20)
    assert(observed_overrun == true)
}

test "Plan 110.4.6.a: no Application handler → Level 3 fallback 5000ms (overrun=false)" {
    mut observed_overrun = true
    mut observed_duration = -1
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, duration_ms, overrun) -> () {
            observed_duration = duration_ms
            observed_overrun = overrun
            return ()
        }
    } {
        consume r = Res6.new(2) {
            ro _ = r.id
        }
    }
    // Тот же 30ms-cleanup при Level-3 пороге 5000ms — НЕ превышение.
    assert(observed_duration >= 20)
    assert(observed_overrun == false)
}
