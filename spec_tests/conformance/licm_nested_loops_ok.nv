// Plan 123.2 T1.5: nested loops — LICM hoists at each loop boundary
// where field is invariant.

module spec_tests.conformance
type Matrix3_1 {
    ro rows int
    ro cols int
}

fn Matrix3_1 @cell_count() -> int {
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < @rows {
        mut j = 0
        // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
        while j < @cols {
            total += @cols
            j += 1
        }
        i += 1
    }
    total
}

fn Matrix3_1.new(r int, c int) -> Matrix3_1 {
    Matrix3_1 { rows: r, cols: c }
}

test "nested loops — @cols hoisted at inner boundary" {
    ro m = Matrix3_1.new(3, 4)
    ro r = m.cell_count()
    // 3 × (4 iterations × cols=4) = 3 × 16 = 48.
    assert(r == 48)
}
