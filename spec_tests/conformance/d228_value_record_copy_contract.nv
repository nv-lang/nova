// D228 — value-record allocation contract (REVISED for Plan 184 Р10, D326-ревизия).
// `type X value { ... }` is a stack value. Semantics under the revised parameter model:
//   (1) IN-OUT on pass: a value-record passed to a FREE function as a `mut` param is a
//       by-pointer in-out reference — field-mutations inside the callee ARE visible to the
//       caller (retraction of the old "copy-on-pass" model for `mut` value-record params).
//       A non-`mut` (ro) value param is still an independent copy.
//   (2) `@`-mut METHOD receiver is a pointer to the caller's stack slot (D228 §«Method receiver»):
//       mutation through `@field` IS visible to the caller after the call.
//   (3) Plain binding copy (`mut b = a`) is an independent value: mutating `b` leaves `a` intact
//       (copy-on-ASSIGN is unchanged; only parameter passing became in-out for `mut`).
// Spec: spec/decisions/02-types.md (D228 + D326-ревизия Р10). Single `spec_tests.conformance`
// folder-module; D-prefixed names are unique to avoid clashes in the shared compile unit.
module spec_tests.conformance

// Value-record: stack value. Fields are ordinary mutable fields (D36 default).
type D228Vec3 value {
    x f64
    y f64
    z f64
}

fn D228Vec3.new(a f64, b f64, c f64) -> D228Vec3 =>
    { x: a, y: b, z: c }

// `@`-MUT method receiver — pointer to the caller's stack slot: writes are visible to the caller.
fn D228Vec3 mut @scale_inplace(k f64) -> () {
    @x *= k
    @y *= k
    @z *= k
}

// Free function taking a `mut` value-record param. Under Plan 184 Р10 the param is a by-pointer
// in-out reference — these field writes reach the caller's value (the argument must be a mutable
// addressable place; the C ABI passes `&v` and the body auto-derefs).
fn d228_clobber(mut v D228Vec3) {
    v.x = 999.0
    v.y = 999.0
    v.z = 999.0
}

test "in-out: free-fn mut value-record param DOES mutate the caller (D228 revised, Р10)" {
    mut v = D228Vec3.new(1.0, 2.0, 3.0)
    d228_clobber(v)
    // The callee wrote through a pointer to v's stack slot — the writes ARE visible.
    assert(v.x == 999.0)
    assert(v.y == 999.0)
    assert(v.z == 999.0)
}

test "@-mut method receiver IS a pointer to the caller's slot; mutation visible (D228)" {
    mut v = D228Vec3.new(1.0, 2.0, 3.0)
    v.scale_inplace(10.0)
    // The mut @-receiver writes through a pointer to v's stack slot — the writes ARE visible.
    assert(v.x == 10.0)
    assert(v.y == 20.0)
    assert(v.z == 30.0)
}

test "binding copy is an independent value: mutating the copy leaves the original (D228)" {
    // D246-амендмент ([M-ro-launder-via-mut-binding], Ф.2 migration, 2026-07-23):
    // `a` is `mut` (was `ro`) — the STRICT norm now forbids an `ro`-bound
    // source flowing into a `mut` target UNCONDITIONALLY (no value-record
    // class exemption; probe E reclassified pos→neg by owner decision). The
    // fact under test here — value-copy independence on assignment — does
    // NOT depend on `a`'s OWN binding modifier, only on `D228Vec3`'s value
    // allocation kind, so `mut a` demonstrates the identical contract.
    mut a = D228Vec3.new(1.0, 2.0, 3.0)
    mut b = a            // copy-on-assign: b is an independent stack value
    b.scale_inplace(5.0)
    // b changed; a is untouched (value semantics, no shared heap identity).
    assert(b.x == 5.0)
    assert(b.y == 10.0)
    assert(b.z == 15.0)
    assert(a.x == 1.0)
    assert(a.y == 2.0)
    assert(a.z == 3.0)
}
