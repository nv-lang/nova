// №377 (window p375-ptr2) — FIXED per owner decision 2026-08-06 (variant
// A): auto-deref for METHOD calls through a typed pointer (`p.method()`,
// D216 §5) now works as designed. Root cause was `emit_c.rs`'s
// `prepare_method_recv` receiver-emission helper: it had NO case for a
// `Nova_X**` (raw pointer to a HEAP record) receiver — every OTHER shape
// it already handled (`NovaValue_X`/`NovaTuple_X` pointer-ABI receivers)
// — so the method received the ADDRESS OF THE POINTER VARIABLE itself
// (one level too shallow) instead of the pointee. Fixed by mirroring the
// sibling `ExprKind::Member` field-access arm's own `is_double_ptr` check
// (same file, ~line 34944-34958) — one level of deref before the call.
//
// This file value-checks ALL THREE auto-deref paths D216 §5 documents,
// from BOTH pointer sources, plus the round-trip through a `*mut T`
// (write-then-read-back), which is what actually exercises the fix (a
// stale/garbage receiver would silently read back the OLD value or an
// address-like garbage int, not the freshly-written one):
//
//   - `p.field` — auto-deref field READ (was already correct; regressed
//     here for completeness/symmetry with the two other paths).
//   - `p.method()` — auto-deref METHOD call (THE fix under test).
//   - `p.read().method()` — the pre-fix workaround the guide recommended
//     (`docs/guide/typed-pointers.md:205-212`) — regression guard, must
//     keep working regardless.
//
// Part of the single conformance folder-module (`Ptr377Counter` — unique
// name, no collision with `Counter`/`PtrSrcCounter` used by sibling
// pointer fixtures in this same folder-module).
module spec_tests.conformance

type Ptr377Counter { v int }

fn Ptr377Counter @val() -> int => @v

test "p.field — ro source (*T, readonly pointee)" {
    ro a = Ptr377Counter { v: 21 }
    ro p = &a
    assert(p.v == 21)
}

test "p.field — mut source (*mut T, writable pointee)" {
    mut a = Ptr377Counter { v: 21 }
    ro p = &a
    assert(p.v == 21)
}

test "p.method() auto-deref — ro source (*T) returns the real value, not garbage" {
    ro a = Ptr377Counter { v: 21 }
    ro p = &a
    assert(p.val() == 21)
}

test "p.method() auto-deref — mut source (*mut T), write-then-read round trip" {
    // №375/118.6: `&a` from a `mut`-bound `a` infers `*mut Ptr377Counter`
    // directly (no annotation/cast needed) — exercises the SAME `Nova_
    // Ptr377Counter**` receiver shape the emit_c.rs fix targets, but this
    // time through a pointer that ALSO permits writing through it.
    mut a = Ptr377Counter { v: 21 }
    ro p = &a
    assert(p.val() == 21)
    unsafe { p.write(Ptr377Counter { v: 42 }) }
    // The method call must see the FRESHLY WRITTEN value (42), not a
    // stale/garbage read off the wrong address — this is what a
    // one-level-too-shallow receiver would get wrong even if the
    // FIRST call (above) happened to look plausible.
    assert(p.val() == 42)
    assert(a.v == 42)
}

test "p.read().method() workaround stays correct (regression guard)" {
    mut a = Ptr377Counter { v: 21 }
    ro p = &a
    assert(p.read().val() == 21)
}
