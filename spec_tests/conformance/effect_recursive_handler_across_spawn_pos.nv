// Рекурсивная установка обработчика эффекта + пересечение границы `spawn`.
//
// Закрепляет ДВЕ вещи, которые до этого не пиннила ни одна фикстура (найдено
// вопросом владельца 2026-07-27 «такое работает как ожидается?»):
//
//   1. РЕКУРСИВНЫЙ `with`: каждый уровень рекурсии ставит СВОЙ обработчик,
//      захватывающий свои `i`/`j`; вызов операции попадает в БЛИЖАЙШИЙ по
//      стеку. Проверяется тем, что каждый уровень видит собственное `j`.
//   2. ОБРАБОТЧИК ПЕРЕЖИВАЕТ `spawn` под `supervised`: операция, вызванная
//      внутри порождённого файбера, находит обработчик, установленный в теле
//      функции, которая в этом файбере исполняется — значения разных файберов
//      НЕ перемешиваются.
//
// СОН ВНУТРИ — намеренно, в трёх местах: до рекурсии, после неё и перед
// вызовом операции. Он заставляет планировщик реально переключать файберы
// между уровнями рекурсии (без него всё успевает пройти линейно, и пункт 2
// проверяется формально, а не по существу).
//
// АНТИ-ФЛАКИ (docs/dev/test-conventions.md «Флаки-тесты — политика»): со сном
// МЕЖФАЙБЕРНЫЙ порядок недетерминирован по построению — поэтому здесь НЕТ
// ни одного утверждения о глобальной очерёдности. Проверяется только
// гарантированное: (а) каждый файбер собрал СВОИ значения, (б) внутри файбера
// порядок раскрутки рекурсии строгий (3,2,1,0 — операция стоит ПОСЛЕ
// рекурсивного вызова), (в) значения чужих файберов не попали в свой список.
module spec_tests.conformance

import std.time.duration

type RecEffect effect {
    emit(v int) -> ()
}

// Собирает то, что «напечатал» бы обработчик — вместо вывода в консоль, чтобы
// проверять содержимое, а не глазами смотреть на стдаут.
fn rec_job(i int, j int, mut acc Vec[int]) RecEffect -> () {
    with RecEffect = effect RecEffect {
        emit(v int) -> () { acc.push(v) }
    } {
        (2).to_millis().sleep()
        if j < 3 {
            rec_job(i, j + 1, acc)
        }
        (2).to_millis().sleep()
        RecEffect.emit(j)
        (2).to_millis().sleep()
    }
}

test "рекурсивный with: ближайший обработчик, порядок раскрутки 3..0" {
    mut got = Vec[int].new()
    rec_job(0, 0, got)
    assert(got.len() == 4)
    // Операция вызывается ПОСЛЕ рекурсивного спуска — значит раскрутка снизу вверх.
    assert(got[0] == 3)
    assert(got[1] == 2)
    assert(got[2] == 1)
    assert(got[3] == 0)
}

test "обработчик переживает spawn: файберы не перемешивают свои значения" {
    supervised {
        for i in 0..3 {
            spawn {
                mut own = Vec[int].new()
                rec_job(i, 0, own)
                // Каждый файбер обязан собрать ПОЛНЫЙ собственный набор 3,2,1,0 —
                // ни больше (чужие значения не подмешались), ни меньше.
                assert(own.len() == 4)
                assert(own[0] == 3)
                assert(own[3] == 0)
            }
        }
    }
}
