// Plan 123.7.7 (V7.7, 2026-06-04): deeper chain receiver
// `@a.b.cv6.method()` still sibling-safe.

module spec_tests.conformance
type Leaf2_2 {
    mut store []int
}

type Mid2_2 {
    mut leaf Leaf2_2
}

type Inner4_2 {
    mut mid Mid2_2
}

type Cv6_2 {
    mut tag int
    mut inner Inner4_2
}

fn Leaf2_2.new() -> Leaf2_2 => { store: []int.new() }
fn Mid2_2.new() -> Mid2_2 => { leaf: Leaf2_2.new() }
fn Inner4_2.new() -> Inner4_2 => { mid: Mid2_2.new() }

fn Cv6_2.new() -> Cv6_2 => { tag: 0, inner: Inner4_2.new() }

fn Cv6_2 mut @cycle(v int) -> int {
    ro a = @tag
    ro b = @tag
    // depth-3 chain: @inner.mid.leaf.store.push(v)
    @inner.mid.leaf.store.push(v)
    ro cv6 = @tag
    ro d = @tag
    a + b + cv6 + d
}

test "V7.7: depth-3 chain doesn't invalidate sibling cache" {
    mut cv6 = Cv6_2.new()
    cv6.tag = 5
    ro r = cv6.cycle(99)
    // tag = 5 throughout вЂ” 5*4 = 20
    assert(r == 20)
    assert(cv6.inner.mid.leaf.store.len() == 1)
    assert(cv6.inner.mid.leaf.store[0] == 99)
}
