// Plan 123.3 T1.6: three calls of pure method → single cached.

module spec_tests.conformance
type Sum2 {
    ro a int
    ro b int
    ro c int
}

#pure
fn Sum2 @total() -> int => @a + @b + @c

fn Sum2 @triple() -> int {
    @total() + @total() + @total()
}

fn Sum2.new(a int, b int, c int) -> Sum2 {
    Sum2 { a, b, c }
}

test "three calls — cached once" {
    ro s = Sum2.new(1, 2, 3)
    ro r = s.triple()
    assert(r == 18)  // 6 * 3
}
