//
// Plan 173 Ф.5 п.2 (D192-РЕТРАКТ; ранее Plan 110.x
// [M-110.x-cleanup-shield-deadline-underflow] NEGATIVE «outer deadline
// must fire») — тест ПЕРЕОСМЫСЛЕН под watchdog-семантику:
//
// Watchdog-порог армится ТОЛЬКО вокруг CLEANUP-вызова («fiber застрял в
// cleanup»), НЕ на body. Прежний тест требовал, чтобы восстановленный
// outer-порог «выстрелил» CleanupTimeoutError на body-сне — force-timeout
// ретрактирован (тип удалён), body может легитимно жить дольше
// cleanup-бюджета.
//
// Новая проверка (та же вложенная конфигурация порогов):
//   - outer порог 10ms, inner порог 100ms (вложенные consume);
//   - ДОЛГИЙ BODY-сон (50ms > 10ms) при БЫСТРЫХ cleanup'ах →
//     обе области: overrun=false (порог не применяется к body) и
//     никакого прерывания — body добегает;
//   - вложенность порогов не перетекает (D196-shadow restore держится:
//     duration inner-cleanup сравнивается с inner-порогом, outer — с outer).

module spec_tests.conformance
type InnerRes24 { ro id int }
fn InnerRes24.new(id int) -> InnerRes24 => { id }
fn InnerRes24 @exit_timeout_ms() -> int => 100
fn InnerRes24 consume @cleanup(_outcome ScopeOutcome) -> () => ()

type OuterRes24 { ro id int }
fn OuterRes24.new(id int) -> OuterRes24 => { id }
fn OuterRes24 @exit_timeout_ms() -> int => 10
fn OuterRes24 consume @cleanup(_outcome ScopeOutcome) -> () => ()

fn run_nested_body_over_threshold() -> int {
    mut counter = 0
    consume outer = OuterRes24.new(10) {
        consume inner = InnerRes24.new(1) {
            ro _ = inner.id
        }
        // Body-сон 50ms >> outer-порога 10ms: watchdog НЕ армлен на body
        // (только вокруг cleanup) → ни варна, ни прерывания — добегаем.
        (50).to_millis().sleep()
        counter = outer.id
    }
    return counter
}

test "Plan 173 Ф.5.2: watchdog армится только на cleanup — долгий body не прерывается и не overrun'ится" {
    mut overruns = 0
    mut exits = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, overrun) -> () {
            exits += 1
            if overrun {
                overruns += 1
            }
            return ()
        }
    } {
        ro r = run_nested_body_over_threshold()
        assert(r == 10)
    }
    // Оба scope-exit'а видны; НИ ОДИН cleanup (оба мгновенные) не overrun,
    // несмотря на body-сон 50ms > outer-порога 10ms.
    assert(exits == 2)
    assert(overruns == 0)
}
