// [M-static-selfreturn-value-mangle-conflict] (Plan 172.13) — a static
// namespace fn `fn Type.method(...) -> Self` (or `-> Result[Self, E]`) for a
// named-tuple/value-record type (D215/D228) COEXISTING in the same compile
// unit with an instance method `fn Type @method(...)` of the same type used
// to CC-FAIL: `conflicting types for 'Nova_<Type>_method_equal'` +
// `returning 'NovaTuple_<Type>' from a function with incompatible result
// type 'NovaTuple_<Type> *'`.
//
// Root cause: `Self` as a RETURN type resolved via `receiver_c_type` (built
// for the ACTUAL METHOD RECEIVER's ABI — always a pointer for a value type,
// so `@field` mutation propagates to the caller), but a STATIC method has NO
// receiver — its `-> Self` denotes a FRESH value being constructed, and the
// constructor body's record-literal `return Type(...)` is emitted BY VALUE,
// matching the ordinary (non-Self) named-tuple return-type lowering. The
// mismatch between the (wrongly pointer-typed) signature and the (correctly
// value-typed) body is what CC-FAILed. Fixed by tracking whether the
// enclosing fn is static (`current_receiver_is_static`) and, only then,
// resolving `Self` like an ordinary reference to the type instead of via the
// receiver-ABI helper. Instance-method `Self` (fluent `-> Self`/`-> @`) is
// unchanged.
//
// Единица: folder-module `spec_tests.conformance`.
module spec_tests.conformance

export type SctPt(x f64 = 0.0, y f64 = 0.0)

export fn SctPt.new(x f64, y f64) -> Self => SctPt(x, y)
// Одиночная fallible-операция (нет инфаллибельного сиблинга `from` — только
// `new`, другое семейство конструкторов) — обычное имя + `Result`, БЕЗ
// `try_`-префикса (R3 D325, nv-coding-style §1: `try_`/`try_from` только
// когда есть одноимённый infallible `from`).
export fn SctPt.checked(x f64, y f64) -> Result[Self, str] {
    if x < 0.0 { return Err("negative x") }
    Ok(SctPt(x, y))
}
export fn SctPt @plus(other SctPt) -> SctPt => SctPt(@x + other.x, @y + other.y)

test "static ctor (-> Self) + instance method coexist on a named tuple" {
    ro p = SctPt.new(1.0, 2.0)
    ro q = p.plus(SctPt.new(3.0, 4.0))
    assert(q.x == 4.0)
    assert(q.y == 6.0)
}

test "static Result-returning ctor (-> Result[Self, E]) + instance method coexist" {
    match SctPt.checked(1.0, 2.0) {
        Ok(p) => assert(p.x == 1.0)
        Err(_) => assert(false)
    }
    match SctPt.checked(-1.0, 2.0) {
        Ok(_) => assert(false)
        Err(e) => assert(e == "negative x")
    }
}

// #271 (2026-08-05, distinct root cause found while unblocking nova-bignum's
// BigInt named-tuple migration): the OLD marker text above ("static ctor
// Self-return ABI mismatch") does NOT describe this case — `SctPair271` has
// NO static namespace fn at all. The real trigger is `@equal` COEXISTING
// with any method returning `Result[(Self, Self), E]` (or `Option[(Self,
// Self)]`) — mirrors `BigInt @equal` + `BigInt @div_rem(...) ->
// Result[(BigInt, BigInt), DivError]`. The compiler auto-synthesizes a
// structural-equality helper for the compound `Result`/`Option`-of-tuple-of-
// named-tuple payload (needed so `==`/pattern-derived equality on it works);
// that helper's body calls the element's own `@equal` — but was emitted into
// the EARLY buffer (before ANY instance method forward-decl exists), producing
// an implicit C declaration that then conflicts with the real, later one:
// `conflicting types for 'Nova_SctPair271_method_equal'`. Fixed in
// `debt_is_late_emitted_value_payload` (emit_c.rs): a positional tuple
// (`_NovaTuple_…`) now recursively decodes its element types
// (`parse_mono_tuple_elements`) and defers to the LATE buffer (after method
// forward-decls) whenever an element is itself a named-tuple/value-record
// payload — same "early proto + late body" split the sibling branches above
// already use, just made to see through one more layer of tupling.
export type SctPair271(x int, y int)

export type SctPair271Err enum ZeroX

export fn SctPair271 @equal(other SctPair271) -> bool => @x == other.x && @y == other.y

export fn SctPair271 @split(other SctPair271) -> Result[(SctPair271, SctPair271), SctPair271Err] {
    if other.x == 0 { return Err(ZeroX) }
    Ok((@, other))
}

test "#271: @equal + method returning Result[(Self, Self), E] coexist on a named tuple" {
    ro a = SctPair271(1, 2)
    ro b = SctPair271(3, 4)
    match a.split(b) {
        Ok((p, q)) => {
            assert(p.equal(a))
            assert(q.equal(b))
        }
        Err(_) => assert(false)
    }
    match a.split(SctPair271(0, 9)) {
        Ok(_) => assert(false)
        Err(e) => assert(e == ZeroX)
    }
}
