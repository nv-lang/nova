// Plan 89 Ф.2.1 — деструктуризация боксированного Option-элемента
// массива через `if let` в теле for-in.
//
// До Plan 89: `for o in []Option[int] { if Some(v) = o }` → CC-FAIL
// (`.tag` на указателе `NovaOpt_T*`). Фикс Ф.1: emit_for деболксит
// value-sum элемент в значение.

module spec_tests.conformance
test "for-in []Option + if ro Some" {
    ro opts []Option[int] = [Some(1), None, Some(3), Some(10)]
    mut sum = 0
    for o in opts {
        if Some(v) = o {
            sum = sum + v
        }
    }
    assert(sum == 14)
}

test "for-in []Option + if ro с else" {
    ro opts []Option[int] = [Some(5), None, None, Some(2)]
    mut found = 0
    mut missing = 0
    for o in opts {
        if Some(v) = o {
            found = found + v
        } else {
            missing = missing + 1
        }
    }
    assert(found == 7)
    assert(missing == 2)
}

test "for-in []Option[str] — боксированный элемент с str payload" {
    ro names []Option[str] = [Some("alice"), None, Some("bob")]
    mut total_len = 0
    for o in names {
        if Some(n) = o {
            // [M-ro-launder-pattern-bind-not-enforced] (реестр 221.1 №106)
            // side-fix: `n`'s type reaches `scope` now (if-let pattern-bind
            // scope-population, needed as this window's own prerequisite —
            // see `f1_expr`'s `IfLet` arm) — was previously invisible to the
            // checker, masking this retired API (D249 lens model: `str.len()`
            // was retired long before, this call was simply never checked).
            // `byte_len()` is the correct O(1) replacement for pure-ASCII
            // literals like these.
            total_len = total_len + n.byte_len()
        }
    }
    assert(total_len == 8)
}
