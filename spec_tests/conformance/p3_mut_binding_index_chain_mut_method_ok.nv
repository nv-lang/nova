// Plan 128.2 Ф.2 P3 — mut binding + index chain + mut method = OK.
//
// `mut arr: []Vec36`, `arr[0].set_x(42)` — IndexAccess chain. Root
// binding `mut`, chain-walking helper walks `IndexAccess { obj: Ident
// "arr" }` → root Ident → mut → enforcement пропускает.

module spec_tests.conformance
type Vec36(x int, y int, z int)

fn Vec36 mut @set_x(v int) -> () {
    @x = v
}

test "mut binding + index chain + mut method — OK" {
    // №145: positional — no defaults, D102 forbids named-arg form.
    mut arr = [
        Vec36(1, 2, 3),
        Vec36(4, 5, 6),
    ]
    arr[0].set_x(42)
    assert(arr[0].x == 42)
    assert(arr[0].y == 2)
    assert(arr[1].x == 4)
}
