// TEMP PROBE (facet C last cell) — not a permanent fixture, deleted after probing.
module spec_tests.conformance

protocol PFactory {
    .make(tag str) -> Self
}

type PWidget { name str }
#impl(PFactory)
fn PWidget.make(tag str) -> PWidget => PWidget { name: tag }

fn[T PFactory] pbuild(tag str) -> T => T.make(tag)

test "probe a: T.make(tag) via bound type-param, minimal form" {
    ro w = pbuild[PWidget]("hi")
    assert(w.name == "hi")
}
