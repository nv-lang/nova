// D188 — `Cleanup[E]` protocol + `consume X = expr { body }` scope-block.
// cleanup() вызывается exactly-once при выходе из body (success/throw/panic/cancel).
// E = Never для infallible cleanup (нет Fail[E] в сигнатуре).
// Spec: spec/decisions/03-syntax.md D188. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

type D188Log { label str }

fn D188Log consume @cleanup(_outcome ScopeOutcome) -> () { }

fn d188_make(label str) -> D188Log => { label }

test "consume scope-block: body executes with resource binding (D188)" {
    mut seen = ""
    consume r = d188_make("hello") {
        seen = r.label
    }
    assert(seen == "hello")
}

test "consume scope-block: nested access works (D188)" {
    mut sum = 0
    consume a = d188_make("first") {
        sum = sum + a.label.byte_len()
    }
    assert(sum == 5)
}

// D188 R2 (Plan 173 Ф.5 #8): exactly-once — РЕАЛЬНЫЙ runtime-счётчик
// (`_consume_ccount` на инстансе, проверяется в прологе generated
// `Nova_<T>_consume_cleanup`), не только структурный active-флаг.
// Наблюдение: ResourceTrace.on_resource_exit срабатывает ровно один раз
// на чистый cleanup-диспатч (success- и failure-path).
type D188R2Err { msg str }

fn d188_r2_throws() Fail[D188R2Err] -> () {
    throw D188R2Err { msg: "boom" }
}

test "D188 R2: cleanup dispatches exactly once — success path" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        consume r = d188_make("r2") {
            ro _ = r.label
        }
    }
    assert(exit_calls == 1)
}

test "D188 R2: cleanup dispatches exactly once — failure path" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
            consume r = d188_make("r2f") { d188_r2_throws() }
        }
    }
    assert(exit_calls == 1)
}
