// Plan 173 Ф.2.B1 (D314): `defer(o ScopeOutcome) { … }` — outcome-несущая форма
// defer. B1 = ТОЛЬКО parser+AST: форма ПАРСИТСЯ, компилится и тело бежит на
// scope-exit как обычный defer. Материализация `o` (Success/Failure/Panic) на
// каждом exit-path — B2 (codegen). Здесь тело НЕ ссылается на `o` (ещё не
// материализован), проверяем только парсинг + что defer(o) не ломает исполнение.

module nova_tests.err173

fn run_defer_outcome() -> str {
    mut trail = ""
    {
        defer(o ScopeOutcome) { trail = trail + "A" }    // outcome-defer, LIFO last
        defer(o ScopeOutcome) { trail = trail + "B" }    // LIFO first
    }
    trail
}

test "f2.B1: defer(o ScopeOutcome) парсится + тело бежит на scope-exit (LIFO)" {
    assert(run_defer_outcome() == "BA")
}
