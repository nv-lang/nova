// D403 — reading an ELEMENT out of a `[]uint` / `[]u8` must preserve the element's
// SIZED/UNSIGNED width (uint≠int, u8≠i8) — NO silent collapse to signed `nova_int`.
// Surface = the three element-READ paths on a Vec whose element is a sized/unsigned
// primitive: subscript `v[i]`, `.first()`, and the `for x in v` loop binding. All three
// decode the element C-type from the SAME authoritative mono name `Nova_Vec____nova_uint`
// (emit_c.rs: `infer_expr_c_type` Index arm ~37122 and the `nova_idx_chk` emit ~22386 read
// the element from `generic_type_instance_info[mangled].args[0]`; the for-loop reads it from
// the mono'd `next() -> Option[T]` return = `NovaOpt_nova_uint`). Since `primitive_name_to_c`
// maps `uint`→`nova_uint` (= uintptr_t) and `u8`→`nova_byte` (= uint8_t), the element stays
// UNSIGNED.
//
// DISCRIMINATING form (mirrors D368): every result binding is UNANNOTATED (`ro got = v[i]`),
// so it inherits the call's INFERRED element type. If that width collapsed to signed
// `nova_int`, the unsigned high-bit value `0x8000000000000000` (2^63) reads NEGATIVE and
// `got > 100` is false (RUN-FAIL); a u8 element silently read as signed `i8` would turn 200
// into -56, failing `got == 200` / `got > 100`. A correct sized/unsigned read keeps both
// asserts true. Spec: spec/decisions/02-types.md (§0/§10/D368/D130 named-priority, no
// int-collapse). SINGLE `spec_tests.conformance` folder-module; all top-level names are
// `d403w_`-prefixed; depends on D232 (`[]T`), D239 (`[]T ≡ Vec[T]`).
module spec_tests.conformance

test "[]uint subscript v[i] keeps the unsigned high-bit; no signed collapse (D403)" {
    ro v = []uint.of(0x8000000000000000)   // 2^63 — high bit set; as signed int64 NEGATIVE
    ro got = v[0]                              // UNANNOTATED: inherits the element's inferred type
    assert(got > 100)                          // uint: 2^63 > 100 ✓ ; signed collapse → negative → FAIL
}

test "[]uint .first() preserves unsigned width through Option unwrap (D403)" {
    ro v = []uint.of(0x8000000000000000, 7)   // first element is 2^63
    ro got = v.first() ?? 0                       // UNANNOTATED unwrap: inherits element type uint
    assert(got > 100)                             // uint: 2^63 > 100 ✓ ; collapse → negative → FAIL
}

test "for x in []uint — loop binding inherits unsigned element width (D403)" {
    ro v = []uint.of(0x8000000000000000, 0x8000000000000001)
    mut seen = 0
    for x in v {                  // x UNANNOTATED: inherits the mono next()-return element type uint
        assert(x > 100)           // each element is >= 2^63 — unsigned > 100 ✓ ; signed → negative → FAIL
        seen = seen + 1
    }
    assert(seen == 2)             // both elements were iterated (loop ran, not collapsed away)
}

test "[]u8 subscript keeps u8 (unsigned), not a signed i8 — 200 stays 200 (D403)" {
    ro b []u8 = [200, 5]          // 200 fits u8, exceeds i8 max (127): signed i8 read → -56
    ro got = b[0]                 // UNANNOTATED: inherits the element's inferred type (u8)
    assert(got == 200)            // u8: exact 200 ✓ ; signed i8 collapse → -56 → FAIL
    assert(got > 100)             // u8: 200 > 100 ✓ ; signed i8 collapse → -56 < 100 → FAIL
}
