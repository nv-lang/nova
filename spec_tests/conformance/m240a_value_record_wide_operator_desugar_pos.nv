// РЕГРЕСС на дефект, найденный работой над BigRat (план 240, СТОП-отчёт).
// Дефект ПОЧИНЕН, но фикстурой закреплён не был — воспроизведение жило
// файлом в исходниках пакета nova-bignum, где ему не место (регресс на
// компилятор, а не функциональность пакета). Перенесено интегратором
// 2026-08-03 по вопросу владельца «что это?».
//
module spec_tests.conformance

type M240aPt value { x i64, y i64 }

fn M240aPt.new(x i64, y i64) -> M240aPt => { x, y }

type M240aRt value { a M240aPt, b M240aPt }

fn M240aRt.new(a M240aPt, b M240aPt) -> M240aRt {
    { a, b }
}

fn M240aRt @plus(other M240aRt) -> M240aRt {
    M240aRt.new(M240aPt.new(@a.x + other.a.x, @a.y + other.a.y), M240aPt.new(@b.x + other.b.x, @b.y + other.b.y))
}

fn M240aRt @equal(other M240aRt) -> bool {
    @a == other.a && @b == other.b
}

test "value-record over 16B: operator and == desugar" {
    ro p1 = M240aPt.new(1, 2)
    ro p2 = M240aPt.new(3, 4)
    ro r1 = M240aRt.new(p1, p2)
    ro r2 = M240aRt.new(p1, p2)
    ro s = r1 + r2
    assert(s.a.x == 2)
    assert(s.b.y == 8)
    assert(r1 == r2)
    assert(s != r1)
}
