//
// #672 form (1), positive side: a `consume` parameter that DOES release the
// resource stays legal. Sibling of m672_form1_consume_param_leak_neg.
module spec_tests.conformance

type M672P1Ok consume { tag int }

fn M672P1Ok consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

fn M672P1Ok consume @close() -> () { () }

fn m672_eat_ok(consume r M672P1Ok) -> () {
    assert(r.tag == 4)
    r.close()
}

fn m672_form1_ok() -> () {
    consume r = M672P1Ok { tag: 4 }
    m672_eat_ok(r)
}
