// Plan 180 [M-180-f64-shortest-roundtrip]: shortest-round-trip float→str.
//
// Prior `nova_f64_to_str` = `snprintf("%g")` (6 significant figures) was LOSSY
// for arbitrary f64 (`str.from(3.141592653589793)` → "3.14159",
// `str.from(1234567.89)` → "1.23457e+06"), which silently broke
// `decode(encode(v)) == v` on float-bearing JSON. The formatter now emits the
// MINIMAL decimal string whose `strtod` re-parses bit-for-bit to the original
// double. These tests pin that faithfulness end-to-end.
//
// Parse-back path: `Json.parse(...)!!.num()` (Option[f64], the working
// numeric-extraction path — the parser reads via nova_str_to_f64 and stores a
// true f64 in JsonValue.Num).

module spec_tests.conformance
import std.encoding.json.{JsonValue, Json}

// str.from(v) directly → parse the emitted JSON number back → identity.
priv(file) fn f64rt_direct(v f64) -> bool {
    Json.parse(str.from(v))!!.num() == Some(v)
}

// JsonValue.num(v).to_str() → Json.parse → num(): the json encode/decode path
// (`format_num` → `str.from(n)`), exactly the `decode(encode(v)) == v` gate.
priv(file) fn f64rt_json(v f64) -> bool {
    ro encoded = JsonValue.num(v).to_str()
    Json.parse(encoded)!!.num() == Some(v)
}

test "shortest-round-trip: pi (>6 sig-figs, was lossy)" {
    // Was "3.14159" — now full precision; must re-parse to the same double.
    assert(f64rt_direct(3.141592653589793))
    assert(f64rt_json(3.141592653589793))
}

test "shortest-round-trip: 1234567.89 (was 1.23457e+06)" {
    assert(f64rt_direct(1234567.89))
    assert(f64rt_json(1234567.89))
}

test "shortest-round-trip: e and 1/3 (16 sig-figs)" {
    assert(f64rt_direct(2.718281828459045))
    assert(f64rt_direct(0.3333333333333333))
    assert(f64rt_json(2.718281828459045))
    assert(f64rt_json(0.3333333333333333))
}

test "shortest-round-trip: small magnitudes (<=6 sig-figs, zero churn)" {
    // These already rendered faithfully; the fix must not change them.
    assert(f64rt_direct(0.1))
    assert(f64rt_direct(1.5))
    assert(f64rt_json(0.1))
    assert(f64rt_json(1.5))
}

test "shortest-round-trip: extreme exponents" {
    assert(f64rt_direct(1e300))
    assert(f64rt_direct(1e-300))
    assert(f64rt_json(1e300))
    assert(f64rt_json(1e-300))
}

test "shortest-round-trip: integer-valued floats" {
    assert(f64rt_direct(2.0))
    assert(f64rt_direct(42.0))
    // 2^53 — 16 sig-figs, was "9.00720e+15" under 6-sig %g.
    assert(f64rt_direct(9007199254740992.0))
    assert(f64rt_json(2.0))
    assert(f64rt_json(9007199254740992.0))
}

test "shortest-round-trip: denormal and negative zero" {
    // Smallest positive subnormal; must survive the round-trip.
    assert(f64rt_direct(5e-324))
    assert(f64rt_direct(0.0 - 0.0))
    assert(f64rt_json(5e-324))
}

test "shortest-round-trip: negative fractional" {
    assert(f64rt_direct(0.0 - 2.5))
    assert(f64rt_direct(0.0 - 3.141592653589793))
    assert(f64rt_json(0.0 - 3.141592653589793))
}
