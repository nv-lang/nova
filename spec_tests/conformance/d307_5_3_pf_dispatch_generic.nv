// [Facet-B D307 §5.3] Positive — co-exist RUNTIME, part 3/3.
//
// See `d307_5_3_pf_dispatch_bool.nv` for the full trio rationale. This third
// peer declares the GENERIC overload — `priv(file) fn[T SignedInts]
// pf_dispatch(x T) -> T => x` (identity) — the one whose bare-name
// `generic_fns`/`mono_fn_decls` registration used to hijack every same-named
// call in the whole folder-CU. This file's OWN calls must still correctly
// monomorphize the identity body (41 → 41, -5 → -5); `SignedInts` is the
// stdlib type-set from prelude (Plan 172.3), no local declaration needed
// (mirrors `stdlib_use.nv`).

module spec_tests.conformance

// D246-амендмент ([M-ro-launder-via-mut-binding], Ф.2 миграция, 2026-07-23):
// `mut x` — `SignedInts` bound не признаётся чекером за scalar-safe
// доказательство (нет bound-aware анализа в Ф.1).
priv(file) fn[T SignedInts] pf_dispatch(mut x T) -> T => x

test "D307 §5.3 co-exist: own-file generic priv(file) pf_dispatch mono's correctly" {
    assert(pf_dispatch(41) == 41)
    assert(pf_dispatch(-5) == -5)
}
