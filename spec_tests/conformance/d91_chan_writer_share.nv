// D91 + Plan 201 — `ChanWriter.share()` (переименование clone→share,
// 2026-07-13): alias-семантика («второй владелец того же буфера, канал
// закрывается когда закроется ПОСЛЕДНИЙ writer») именуется share();
// Clone-протокол = независимая глубокая копия — имя clone для alias
// запрещено. Канон многофиберного доступа: share-копия per-fiber.
// Spec: spec/decisions/03-syntax.md D188 §«Re-consume форма» п.5;
// docs/guide/channels.md §«share — multi-writer».
// Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

test "chan: fan-in — два writer'а через share(), закрывает последний" {
    ro { tx, rx } = Channel[int].new(8)
    ro tx2 = tx.share()                // writer_count = 2
    mut sum = AtomicInt.new(0)         // #share — легальный капчур (D415 §2)
    supervised {
        spawn { tx.send(1);  tx.send(2);  tx.send(3);  tx.close() }
        spawn { tx2.send(10); tx2.send(20); tx2.send(30); tx2.close() }
        spawn {
            while Some(v) = rx.recv() { sum.fetch_add(v) }
        }
    }
    assert(sum.load() == 66)
}

test "chan: share() per-fiber — канал жив до закрытия последнего writer'а" {
    ro { tx, rx } = Channel[int].new(4)
    mut got = AtomicInt.new(0)         // #share — легальный капчур (D415 §2)
    supervised {
        ro w1 = tx.share()
        ro w2 = tx.share()
        spawn { w1.send(7);  w1.close() }
        spawn { w2.send(35); w2.close() }
        spawn {
            while Some(v) = rx.recv() { got.fetch_add(v) }
        }
        tx.close()                     // корневой writer
    }
    assert(got.load() == 42)
}
