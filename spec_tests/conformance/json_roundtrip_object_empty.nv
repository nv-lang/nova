// Plan 91.3 Ф.3 (composites conformance): JSON roundtrip — empty object.
//
// Validates encode/decode/roundtrip для `{}`. format_object не должен
// эмитить trailing comma при empty map; parser принимает `{}` как
// `Object(IndexMap.new())` без полей.
//
// Plan p320 Фаза 3 (реестр 221.1 №319): `JsonValue.object()` теперь берёт
// `IndexMap[str, JsonValue]`, не `HashMap[str, JsonValue]` — мигрировано
// вместе с ретайпом (empty-object output "{}" не зависит от порядка).
module spec_tests.conformance
import std.encoding.json.{JsonValue, Json}
import std.collections.index_map.{IndexMap}

test "encode empty object" {
    ro m = IndexMap[str, JsonValue].new()
    ro v = JsonValue.object(m)
    ro encoded = v.to_str()
    assert(encoded == "{}")
}

test "parse empty object" {
    ro parsed = Json.parse("{}")!!
    assert(parsed.is_object())
    match parsed.object() {
        Some(m) => assert(m.len() == 0)
        None    => assert(false)
    }
}

test "roundtrip empty object" {
    ro m = IndexMap[str, JsonValue].new()
    ro orig = JsonValue.object(m)
    ro encoded = orig.to_str()
    ro decoded = Json.parse(encoded)!!
    // Re-encode + string compare (JsonValue без structural ==).
    ro re_encoded = decoded.to_str()
    assert(re_encoded == encoded)
}
