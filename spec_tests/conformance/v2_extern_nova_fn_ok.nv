// D282 — positive: `extern "nova" fn` is the canonical runtime-fn syntax.
//
// Verifies that `extern "nova" fn` compiles and is usable in place of the
// retracted `external fn` keyword.

module spec_tests.conformance
extern "nova" fn Nova_intrinsic_unreachable() -> never

test "extern nova fn declaration accepted" {
    // Just declaring the fn is enough — type-check + codegen accept it.
    assert(true)
}
