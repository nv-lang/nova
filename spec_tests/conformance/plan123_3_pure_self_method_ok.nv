// Plan 123.3 T1.1: @<pure_method>() called 2+ times → cached.

module spec_tests.conformance
type Vec3_2 {
    ro x int
    ro y int
    ro z int
}

#pure
fn Vec3_2 @magnitude_sq() -> int => @x * @x + @y * @y + @z * @z

fn Vec3_2 @double_test() -> int {
    // Two @magnitude_sq() calls → cache (no @F write in body).
    @magnitude_sq() + @magnitude_sq()
}

fn Vec3_2.new(x int, y int, z int) -> Vec3_2 {
    Vec3_2 { x, y, z }
}

test "pure method @magnitude_sq cached" {
    ro v = Vec3_2.new(3, 4, 12)
    ro r = v.double_test()
    // mag_sq = 9+16+144 = 169. Twice = 338.
    assert(r == 338)
}
