// Plan 123.7.1 T2.1: LICM hoists mut @field inside loop even when
// loop body has self-method calls that don't write that field.

module spec_tests.conformance
type Worker4_1 {
    mut total int
    mut log int
}

// Writes ONLY @log — IPA write_set = {"log"}.
fn Worker4_1 mut @bump_log() -> () {
    @log += 1
}

fn Worker4_1 mut @work(n int) -> int {
    mut accum = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        // Loop body: 2 reads of @total + call @bump_log() (writes @log,
        // not @total). V7 conservative would skip mut LICM here.
        // V7.1 IPA: @bump_log doesn't write @total → can hoist.
        accum = accum + @total + @total
        @bump_log()
        i += 1
    }
    accum
}

fn Worker4_1.new(t int, l int) -> Worker4_1 {
    Worker4_1 { total: t, log: l }
}

test "LICM IPA: mut field hoisted despite non-writing call in loop" {
    mut w = Worker4_1.new(5, 0)
    ro r = w.work(3)
    // total=5 throughout (bump_log writes only @log).
    // accum = 3 * (5+5) = 30.
    assert(r == 30)
}
