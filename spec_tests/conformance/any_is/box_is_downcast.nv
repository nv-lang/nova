// Plan 174.3 (D53/D54 v1) — `any` top-type: boxing (`v as any`), runtime
// type-check (`is`), smart-cast narrowing, and optional downcast (`try_as[T]`).
//
// Covers: box a value into `any` → `is T` (match) / `is U` (no-match);
// `try_as[T]()` extracts on match and yields `None` on mismatch; flow-narrowing
// `if x is T { use x-as-T }`; identity (`v as any is <type-of-v>`); heterogeneous
// element types (int / str / record) through the same erased `any`.

module any_is.box_is_downcast
type Point { x int, y int }

test "int: box → is → narrowing → try_as" {
    ro n any = 42 as any
    assert(n is int)          // match
    assert(!(n is str))       // no-match
    // smart-cast narrowing: n has type int inside the block
    if n is int {
        assert(n == 42)
        assert(n + 1 == 43)
    }
    // optional downcast — match extracts the value
    if Some(v) = n.try_as[int]() {
        assert(v == 42)
    } else {
        assert(false)
    }
    // optional downcast — mismatch yields None (neg-as-None semantics)
    assert(n.try_as[str]().is_none())
}

test "str: box → is → narrowing (method on narrowed value)" {
    ro s any = "hello" as any
    assert(s is str)
    assert(!(s is int))
    if s is str {
        assert(s.len() == 5)                 // s narrowed to str → str methods work
        assert(s.starts_with("hel"))
    }
    if Some(v) = s.try_as[str]() {
        assert(v == "hello")
    } else {
        assert(false)
    }
    assert(s.try_as[int]().is_none())
}

test "record: box → is → try_as extracts fields" {
    ro p0 = Point { x: 1, y: 2 }
    ro p any = p0 as any
    assert(p is Point)
    assert(!(p is int))
    if Some(pt) = p.try_as[Point]() {
        assert(pt.x == 1)
        assert(pt.y == 2)
    } else {
        assert(false)
    }
}

test "identity: v as any is (type of v)" {
    assert((42 as any) is int)
    assert(("x" as any) is str)
    assert((true as any) is bool)
}

test "any parameter: heterogeneous dispatch via is / try_as" {
    assert(describe(7 as any) == "int:7")
    assert(describe("hi" as any) == "str:hi")
    assert(describe(true as any) == "other")
}

test "implicit upcast: call arg / let / return without `as any`" {
    // implicit call-arg upcast (D53 supertype) — no explicit `as any`
    assert(describe(7) == "int:7")
    assert(describe("hi") == "str:hi")
    // implicit let upcast
    ro n any = 42
    assert(n is int)
    // implicit return upcast (`fn -> any => concrete`)
    ro w any = boxed(9)
    if Some(v) = w.try_as[int]() {
        assert(v == 9)
    } else {
        assert(false)
    }
}

fn boxed(n int) -> any => n

fn describe(x any) -> str {
    if x is int {
        return "int:${x}"          // x narrowed to int here
    }
    if Some(s) = x.try_as[str]() {
        return "str:${s}"
    }
    "other"
}
