// int128-связка P1: [M-neg-not-selectors-dce-gap].
//
// `@neg`/`@not` on a user type dispatch correctly (pre-existing mechanism),
// but reachability-DCE's `collect_used_names` (lints.rs) never seeded these
// two magic selectors (the SAME class of gap that `bitand`/`bitor`/`bitxor`/
// `bitnot` had before plan 234 Ф.1 added them) — a type whose ONLY caller of
// `@neg`/`@not` is the OPERATOR form (`-x`, `!x`, never a literal `.neg()`/
// `.not()` call) had its method body dropped as dead, producing an
// undefined-symbol link error. This fixture's `@neg`/`@not` are used
// ONLY through the operator, by construction.
module spec_tests.conformance

type M128Neg { m128_v int }

export fn M128Neg @neg() -> M128Neg => { m128_v: -@m128_v }
export fn M128Neg @not() -> M128Neg => { m128_v: @m128_v + 1000 }

test "234/int128-связка: @neg/@not только-операторное использование выживает DCE" {
    ro m128_a = M128Neg { m128_v: 7 }
    ro m128_n = -m128_a
    assert(m128_n.m128_v == -7)
    ro m128_nn = !m128_a
    assert(m128_nn.m128_v == 1007)
}
