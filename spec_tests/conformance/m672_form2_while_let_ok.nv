//
// #672 form (2), positive side: the while-let pattern binding is consumed on
// every iteration, so the loop stays legal.
module spec_tests.conformance

type M672W2Ok consume { tag int }

fn M672W2Ok consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

fn M672W2Ok consume @close() -> () { () }

fn m672_next_ok(n int) -> Option[M672W2Ok] {
    if n > 0 { Some(M672W2Ok { tag: n }) } else { None }
}

fn m672_form2_ok() -> () {
    mut i = 2
    while Some(consume r) = m672_next_ok(i) {
        i -= 1
        assert(r.tag > 0)
        r.close()
    }
}
