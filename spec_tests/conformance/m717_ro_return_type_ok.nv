// SPDX-License-Identifier: MIT OR Apache-2.0
//
// #717, variant (в) boundary (owner's ruling 2026-08-18, NOT withdrawn):
// declaring the return `-> ro T` is the sanctioned way to hand a ro source
// back, and eight corpus sites already stand on it. This fixture pins that
// form so the alias rule cannot quietly take it away -- variant (в) is about
// INFERRING this annotation, and until it is implemented the explicit form
// is the whole of it.
module spec_tests.conformance

fn m717_explicit_ro_return(v []int) -> ro []int {
    v
}

fn m717_explicit_ro_return_via_alias(v []int) -> ro []int {
    ro al = v
    al
}

fn m717_explicit_ro_return_via_branch(v []int, flag bool) -> ro []int {
    ro al = v
    if flag { al } else { v }
}
