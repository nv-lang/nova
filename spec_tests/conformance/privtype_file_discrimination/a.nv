// [M-198-f4c-1-privfile-type-not-discriminated] — regression test (fixed
// 2026-07-17). Two files, same folder-module, each declare their OWN
// `priv(file) type Rect` with a DIFFERENT shape. Before the fix, checker
// resolve did not discriminate priv(file) TYPES by declaring file (D307
// covered method/fn symbols — 2d5f64e91 — but not type symbols): b.nv's
// `Rect` shape bled into a.nv's own `area(r Rect)`, which must only ever
// see ITS OWN `Rect { w, h }`.
//
// Was CODEGEN-FAIL — error: [E7320] no field or method `w` on type `Rect`,
// note: `Rect` has fields: name, tag (that was b.nv's Rect winning the
// name-keyed `types` registry slot). Fixed via a file-scoped type registry
// overlay (checker: `TypeCheckCtx.file_local_types`/`types_get_for_file`)
// plus three mirrored codegen sites (struct/tag naming, `current_emit_file_id`
// gating, bare record-literal qualification). Promoted out of
// `fixtures/known_red/` into conformance now that it is green.
module conformance.privtype_file_discrimination

priv(file) type Rect { w int, h int }

fn area(r Rect) -> int => r.w * r.h

test "a: own Rect(w,h) shape" {
    ro r = Rect { w: 3, h: 4 }
    assert(area(r) == 12)
}
