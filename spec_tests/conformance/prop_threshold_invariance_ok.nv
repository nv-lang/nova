// Plan 123.1 T-PROP.2: property test — threshold invariance.
// Same method evaluated repeatedly через различные dispatches must
// give same answer regardless of caching.

module spec_tests.conformance
type Counter9_3 {
    ro init int
}

fn Counter9_3 @factorial_like(n int) -> int {
    // @init accessed n times через recursion-like loop.
    mut total = @init
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        total *= @init
        i += 1
    }
    total
}

fn Counter9_3.new(x int) -> Counter9_3 {
    Counter9_3 { init: x }
}

test "property: caching never changes result" {
    ro c = Counter9_3.new(2)
    assert(c.factorial_like(0) == 2)        // just init
    assert(c.factorial_like(1) == 4)        // 2 * 2
    assert(c.factorial_like(3) == 16)       // 2 * 2*2*2 = 16
    assert(c.factorial_like(5) == 64)       // 2 * 2^5 = 64
}

test "property: zero/positive args invariant" {
    ro c = Counter9_3.new(5)
    // 5 * 5^n
    assert(c.factorial_like(0) == 5)
    assert(c.factorial_like(2) == 125)
}
