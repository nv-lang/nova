// [M-fixed-array-value-semantics] (D27-амендмент, 2026-07-10) — bounds-check
// на inline `[N]T`: N — компайл-тайм литерал (нет рантайм len/cap заголовка),
// проверка через nova_fixarr_idx_chk (чтение) / инлайн-гард (запись).
// Panics-клаузула — D348.

module fixed_array.oob_panics

test "read oob panics" panics "array: index 5 out of bounds for length 5" {
    mut a [5]int = [1, 2, 3, 4, 5]
    ro i = 5
    ro _ = a[i]
}

test "write oob panics" panics "array: index 7 out of bounds for length 3" {
    mut a [3]int = [1, 2, 3]
    ro i = 7
    a[i] = 42
}

test "negative index panics" panics "array: index -1 out of bounds for length 3" {
    mut a [3]int = [1, 2, 3]
    ro i = 0 - 1
    ro _ = a[i]
}
