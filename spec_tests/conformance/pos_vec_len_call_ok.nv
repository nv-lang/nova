// std-hygiene positive: `.len()` (explicit call syntax) on `Vec[T]` keeps
// working from OUTSIDE `collections.vec` after the priv-field-bare-access fix
// (compiler-codegen/src/types/mod.rs, [M-173-priv-field-samename-bypass]) —
// regression guard that the fix targets ONLY the non-call (`is_call_func ==
// false`) same-name-method branch and does not perturb the call form.

module conformance.pos_vec_len_call_ok
test "Vec[T].len() call works from outside collections.vec (regression guard)" {
    mut v = Vec[int].new()
    v.push(1)
    v.push(2)
    v.push(3)
    assert(v.len() == 3)
}
