module spec_tests.conformance
// [M-fixed-array-value-semantics] GC-проверка: value-массив УКАЗАТЕЛЕЙ
// ([N]str — nova_str содержит ptr на heap-пейлоад) живёт в стек-кадре
// (inline struct { nova_str data[N]; }). Boehm сканирует стек консервативно —
// пейлоады обязаны удерживаться на протяжении стек-жизни массива,
// в том числе через принудительный полный mark-sweep.

fn build_names() -> [4]str {
    // Строки строятся динамически (конкатенация → heap-аллокация),
    // чтобы пейлоады НЕ были интернированными статиками (иначе GC
    // нечего было бы освобождать и тест был бы вакуумным).
    mut out [4]str = ["", "", "", ""]
    mut i = 0
    while i < 4 {
        out[i] = "name_" + "${i}" + "_payload"
        i = i + 1
    }
    out
}

test "[4]str survives forced GC (stack scan holds payloads)" {
    ro names = build_names()
    // Мусорим кучу + форсируем полный сбор несколько раз.
    mut junk = 0
    mut k = 0
    while k < 3 {
        mut garbage []str = []
        mut j = 0
        while j < 1000 {
            garbage.push("garbage_${j}")
            j = j + 1
        }
        junk = junk + garbage.len()
        gc.collect()
        k = k + 1
    }
    assert(junk == 3000)
    // Пейлоады живы и НЕ перезаписаны мусором.
    assert(names[0] == "name_0_payload")
    assert(names[1] == "name_1_payload")
    assert(names[2] == "name_2_payload")
    assert(names[3] == "name_3_payload")
}

priv(file) type Holder { tag str }

fn build_holders() -> [3]Holder {
    mut out [3]Holder = [
        Holder { tag: "h" + "0" },
        Holder { tag: "h" + "1" },
        Holder { tag: "h" + "2" },
    ]
    out
}

test "[3]Holder (heap-record pointers) survives forced GC" {
    ro hs = build_holders()
    mut k = 0
    while k < 3 {
        mut garbage []int = []
        mut j = 0
        while j < 2000 {
            garbage.push(j)
            j = j + 1
        }
        gc.collect()
        k = k + 1
    }
    assert(hs[0].tag == "h0")
    assert(hs[1].tag == "h1")
    assert(hs[2].tag == "h2")
}
