// Plan 123.1 T-PROP.3: property test — name collision avoidance.
// User-local `_at_x` exists; pass должен emit `_at_x_1` (or similar
// suffix) — user-local untouched, semantics preserved.

module spec_tests.conformance
type Bag3_plan1231propcollisionavoidanceok {
    ro x int
    ro y int
}

fn Bag3_plan1231propcollisionavoidanceok @combine_with_existing() -> int {
    // D487 (2026-10-01): a program may no longer DECLARE `_at_x` -- `_at_`
    // is the field cache's own namespace (`E_RESERVED_NAME`, see
    // neg/d487_reserved_local_ro_neg.nv), so the collision this fixture was
    // written for is impossible by construction. What stays: a user local
    // that differs from the cache name only by the leading `_` -- in C the
    // two must still be distinct names.
    ro at_x = 100
    // @x accessed 3 times, @y accessed 2 times → both cached.
    // user's at_x = 100 — preserved.
    (@x + @x + @x) + (@y + @y) + at_x
}

fn Bag3_plan1231propcollisionavoidanceok.new(x int, y int) -> Bag3_plan1231propcollisionavoidanceok {
    Bag3_plan1231propcollisionavoidanceok { x, y }
}

test "property: user local at_x not clobbered" {
    ro r = Bag3_plan1231propcollisionavoidanceok.new(2, 3).combine_with_existing()
    // 3*2 + 2*3 + 100 = 6+6+100 = 112
    assert(r == 112)
}

test "property: multiple user collisions" {
    ro r = Bag3_plan1231propcollisionavoidanceok.new(7, 11).combine_with_existing()
    // 3*7 + 2*11 + 100 = 21+22+100 = 143
    assert(r == 143)
}
