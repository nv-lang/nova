// Plan 123.1 T2.7: while/for loops СЃ ro @field reads вЂ” cache valid
// РїРѕСЃРєРѕР»СЊРєСѓ ro fields immutable.

module spec_tests.conformance
type IterData3_1 {
    ro start int
    ro count int
}

fn IterData3_1 @sum_arithmetic() -> int {
    // @start used 2 times (in loop), @count used 2 times (1 in cond,
    // 1 in body via @count check). Both ro в†’ cache emitted.
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < @count {
        total += @start + i
        i += 1
    }
    // After loop вЂ” last accesses of @start, @count for verification.
    if @count == 0 {
        @start
    } else {
        total
    }
}

fn IterData3_1.new(s int, c int) -> IterData3_1 {
    IterData3_1 { start: s, count: c }
}

test "ro caching across loops" {
    ro r = IterData3_1.new(10, 3).sum_arithmetic()
    // i=0: total=10, i=1: total=21, i=2: total=33. Return 33.
    assert(r == 33)
    ro r2 = IterData3_1.new(7, 0).sum_arithmetic()
    // count=0, loop skipped, return @start=7.
    assert(r2 == 7)
}
