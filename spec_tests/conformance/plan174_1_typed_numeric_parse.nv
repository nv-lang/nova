// Plan 174.1 — POSITIVE conformance for the `str @to_*` numeric conversion
// surface (std/runtime/string/parse.nv). `str.parse_int` (D177/D178/D325
// triad) is RETRACTED as public API; conversions are METHODS ON THE SOURCE
// (`s.to_int()`, `s.to_i64()`, `s.to_u64()`, `s.to_u32()`, `s.to_u8()`,
// `s.to_f64()` — owner decision 2026-07-08, superseding a same-day static
// `T.parse(s)` design), mirroring the pre-existing float conversion
// ([M-f64-try-parse-to-parse-f64]).
//
// Coverage: decimal happy-path, sign, empty/garbage/invalid-radix errors,
// radix (hex/binary), full-width overflow (int/i64, u64), and — the
// historical bug this closes — sub-width TRUNCATION: `u8.parse("999")`
// (nee `i8.try_parse`) must be `Err(AboveMax)` (2026-09-05: was `Overflow`), not a silently-wrapped
// narrow value (see Plan 174.1 §4). Part of the SINGLE conformance module
// (spec_tests.conformance).
//
// NB matches below are FLAT (`Err(AboveMax) => ..`, not `Err(e) => match e
// {..}`) — a nested match on the `Err` payload after a callee for-loop with
// early `return Err(..)` was found (2026-07-08) to mis-resolve the bound
// variant in this toolchain (pre-existing, separately-tracked; see
// backlog-followups.md). Flat-matching the payload directly avoids it.
module spec_tests.conformance

import std.runtime.string.{ParseIntError, ParseFloatError}

// ── int / i64 — full 64-bit signed domain, no range-check needed ───────────

test "174.1: str.to_int — decimal, sign, boundary, overflow, empty, garbage" {
    assert("42".to_int() == Ok(42))
    assert("-42".to_int() == Ok(-42))
    assert("+7".to_int() == Ok(7))
    assert("0".to_int() == Ok(0))
    assert("9223372036854775807".to_int() == Ok(9223372036854775807))   // i64::MAX
    assert("-9223372036854775807".to_int() == Ok(-9223372036854775807))
    match "99999999999999999999".to_int() {
        Ok(_)         => assert(false, "expected AboveMax for a 64-bit-busting literal")
        Err(AboveMax) => {}
        Err(_)        => assert(false, "expected AboveMax, got a different error")
    }
    match "".to_int() {
        Ok(_)      => assert(false, "expected Empty for \"\"")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty, got a different error")
    }
    match "-".to_int() {
        Ok(_)      => assert(false, "expected Empty for sign-only \"-\"")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty, got a different error")
    }
    match "12x".to_int() {
        Ok(_)             => assert(false, "expected InvalidDigit for trailing garbage")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit, got a different error")
    }
    match " 42".to_int() {
        Ok(_)             => assert(false, "no-trim canon: leading space must not parse")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "no-trim canon: expected InvalidDigit")
    }
}

test "174.1: str.to_int — radix (hex/binary), invalid radix" {
    assert("ff".to_int(radix: 16) == Ok(255))
    assert("1010".to_int(radix: 2) == Ok(10))
    match "42".to_int(radix: 1) {
        Ok(_)               => assert(false, "expected InvalidRadix for radix 1")
        Err(InvalidRadix)   => {}
        Err(_)              => assert(false, "expected InvalidRadix, got a different error")
    }
    match "42".to_int(radix: 37) {
        Ok(_)               => assert(false, "expected InvalidRadix for radix 37")
        Err(InvalidRadix)   => {}
        Err(_)              => assert(false, "expected InvalidRadix, got a different error")
    }
}

test "174.1: str.to_i64 — same domain as int, Result[i64, ParseIntError]" {
    assert("123".to_i64() == Ok(123 as i64))
    assert("-9223372036854775807".to_i64() == Ok(-9223372036854775807 as i64))
    match "bad".to_i64() {
        Ok(_)             => assert(false, "expected InvalidDigit")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit, got a different error")
    }
}

// ── u64 — full 64-bit unsigned domain ──────────────────────────────────────

test "174.1: str.to_u64 — full range, '-' is InvalidDigit (no negative uint)" {
    assert("18446744073709551615".to_u64() == Ok(18446744073709551615 as u64))  // u64::MAX
    match "-1".to_u64() {
        Ok(_)             => assert(false, "unsigned '-' must be InvalidDigit")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit, got a different error")
    }
    match "".to_u64() {
        Ok(_)      => assert(false, "expected Empty")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty, got a different error")
    }
    match "18446744073709551616".to_u64() {   // u64::MAX + 1
        Ok(_)         => assert(false, "expected AboveMax one past u64::MAX")
        Err(AboveMax) => {}
        Err(_)        => assert(false, "expected AboveMax, got a different error")
    }
    assert("ff".to_u64(radix: 16) == Ok(255 as u64))
}

// ── u32/u8 — sub-width unsigned: range-checked, TRUNCATION bug closed ──────

test "174.1: str.to_u32 — boundary Ok, one-past-boundary Overflow" {
    assert("4294967295".to_u32() == Ok(4294967295 as u32))    // u32::MAX
    match "4294967296".to_u32() {
        Ok(_)         => assert(false, "expected AboveMax one past u32::MAX")
        Err(AboveMax) => {}
        Err(_)        => assert(false, "expected AboveMax, got a different error")
    }
    match "-1".to_u32() {
        Ok(_)             => assert(false, "unsigned '-' must be InvalidDigit")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit, got a different error")
    }
}

test "174.1: str.to_u8 — the historical truncation bug, closed" {
    assert("255".to_u8() == Ok(255 as u8))
    // Historically: raw C narrowing-cast silently wrapped "999" into some
    // in-range garbage byte instead of erroring. Must be a clean Overflow now.
    match "999".to_u8() {
        Ok(_)         => assert(false, "\"999\" must be Err(AboveMax), not a wrapped value")
        Err(AboveMax) => {}
        Err(_)        => assert(false, "expected AboveMax, got a different error")
    }
    match "256".to_u8() {
        Ok(_)         => assert(false, "expected AboveMax one past u8::MAX")
        Err(AboveMax) => {}
        Err(_)        => assert(false, "expected AboveMax, got a different error")
    }
    match "-1".to_u8() {
        Ok(_)             => assert(false, "unsigned '-' must be InvalidDigit")
        Err(InvalidDigit { .. }) => {}
        Err(_)            => assert(false, "expected InvalidDigit, got a different error")
    }
}

// ── f64 — float conversion, sibling of the integer family ──────────────────

test "174.1: str.to_f64 — happy path, empty, malformed (D85 channels)" {
    assert("1.5".to_f64() == Ok(1.5))
    assert("-3.25".to_f64() == Ok(-3.25))
    ro v = "2.5".to_f64()!!
    assert(v == 2.5)
    assert("2.5".to_f64().ok() == Some(2.5))
    match "".to_f64() {
        Ok(_)      => assert(false, "expected Empty for \"\"")
        Err(Empty) => {}
        Err(_)     => assert(false, "expected Empty, got a different error")
    }
    match "not-a-number".to_f64() {
        Ok(_)        => assert(false, "expected Malformed for garbage")
        Err(Malformed { .. }) => {}
        Err(_)       => assert(false, "expected Malformed, got a different error")
    }
}
