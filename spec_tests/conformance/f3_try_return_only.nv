// Plan 173 Ф.1 (#3 / Plan 174.2 / D85): `?` строго return-only. В функции,
// возвращающей Result/Option, `?` пробрасывает ЗНАЧЕНИЕМ (return Err / return
// None) — return-mode. Регресс-гард, что новый чекер E_TRY_IN_FAIL_FN НЕ ломает
// легитимный return-only `?` (ret_ok=true для Result/Option-возврата).

module spec_tests.conformance
fn parse_ok(s str) -> Result[int, str] {
    if s == "ok" { return Ok(7) }
    Err("bad input")
}

fn use_result(s str) -> Result[int, str] {
    ro v = parse_ok(s)?                          // Err → return Err (return-only)
    Ok(v + 1)
}

fn find(n int) -> Option[int] {
    if n > 0 { return Some(n) }
    None
}

fn use_option(n int) -> Option[int] {
    ro v = find(n)?                              // None → return None (return-only)
    Some(v * 2)
}

test "f3: `?` on Result — unwrap Ok / propagate Err (return-only)" {
    ro ok = match use_result("ok") { Ok(v) => v, Err(_) => -1 }
    assert(ok == 8)
    ro er = match use_result("no") { Ok(_) => -1, Err(_) => 99 }
    assert(er == 99)
}

test "f3: `?` on Option — unwrap Some / propagate None (return-only)" {
    ro s = match use_option(5) { Some(v) => v, None => -1 }
    assert(s == 10)
    ro n = match use_option(-1) { Some(_) => -1, None => 99 }
    assert(n == 99)
}
