// registry_size.nv — Plan 174.4: effect-registry compile-time размер.
//
// Объявлены 40 user-эффектов; вместе с built-in Fail/Time/Mem per-thread
// handler-storage registry (effects.h: NovaEffectRegistry/NovaEffectSnapshot)
// держит >32 записей. До 174.4 таблица была хардкод-32 и МОЛЧА дропала
// любой эффект, зарегистрированный за слотом 32 → его handler НЕ сохранялся/
// восстанавливался вокруг исполнения фибера (тихий correctness-баг). N теперь
// вычисляется на компиляции (= число эффектов), silent-drop невозможен.
//
// Тесты: (1) spawn наследует outer-handler'ы ВСЕХ 40 эффектов; (2) outer-handler
// высокоиндексного (>32) эффекта не затирается завершившимися дочерними фиберами
// (аналог concurrency/per_fiber_handlers SECTION 2+4, но для эффекта за слотом 32).

module spec_tests.conformance
type Eff01 effect { get() -> int }
type Eff02 effect { get() -> int }
type Eff03 effect { get() -> int }
type Eff04 effect { get() -> int }
type Eff05 effect { get() -> int }
type Eff06 effect { get() -> int }
type Eff07 effect { get() -> int }
type Eff08 effect { get() -> int }
type Eff09 effect { get() -> int }
type Eff10 effect { get() -> int }
type Eff11 effect { get() -> int }
type Eff12 effect { get() -> int }
type Eff13 effect { get() -> int }
type Eff14 effect { get() -> int }
type Eff15 effect { get() -> int }
type Eff16 effect { get() -> int }
type Eff17 effect { get() -> int }
type Eff18 effect { get() -> int }
type Eff19 effect { get() -> int }
type Eff20 effect { get() -> int }
type Eff21 effect { get() -> int }
type Eff22 effect { get() -> int }
type Eff23 effect { get() -> int }
type Eff24 effect { get() -> int }
type Eff25 effect { get() -> int }
type Eff26 effect { get() -> int }
type Eff27 effect { get() -> int }
type Eff28 effect { get() -> int }
type Eff29 effect { get() -> int }
type Eff30 effect { get() -> int }
type Eff31 effect { get() -> int }
type Eff32 effect { get() -> int }
type Eff33 effect { get() -> int }
type Eff34 effect { get() -> int }
type Eff35 effect { get() -> int }
type Eff36 effect { get() -> int }
type Eff37 effect { get() -> int }
type Eff38 effect { get() -> int }
type Eff39 effect { get() -> int }
type Eff40 effect { get() -> int }

// Читает каждый из 40 эффектов и возвращает сумму. При outer-handler'ах
// Eff_k.get() == k сумма = 1+2+...+40 = 820.
fn read_all() -> int {
    mut s = 0
    s += Eff01.get()
    s += Eff02.get()
    s += Eff03.get()
    s += Eff04.get()
    s += Eff05.get()
    s += Eff06.get()
    s += Eff07.get()
    s += Eff08.get()
    s += Eff09.get()
    s += Eff10.get()
    s += Eff11.get()
    s += Eff12.get()
    s += Eff13.get()
    s += Eff14.get()
    s += Eff15.get()
    s += Eff16.get()
    s += Eff17.get()
    s += Eff18.get()
    s += Eff19.get()
    s += Eff20.get()
    s += Eff21.get()
    s += Eff22.get()
    s += Eff23.get()
    s += Eff24.get()
    s += Eff25.get()
    s += Eff26.get()
    s += Eff27.get()
    s += Eff28.get()
    s += Eff29.get()
    s += Eff30.get()
    s += Eff31.get()
    s += Eff32.get()
    s += Eff33.get()
    s += Eff34.get()
    s += Eff35.get()
    s += Eff36.get()
    s += Eff37.get()
    s += Eff38.get()
    s += Eff39.get()
    s += Eff40.get()
    s
}

// Дочерние helper'ы ставят СВОЙ inner-handler для высокоиндексного Eff40
// (слот 41 в registry — за пределом старого лимита 32) и читают его,
// перезаписывая глобал `_nova_handler_Eff40` внутри фибера.
fn eff40_inner_a() -> int {
    with Eff40 = effect Eff40 { get() -> int => 100 } {
        Eff40.get()
    }
}

fn eff40_inner_b() -> int {
    with Eff40 = effect Eff40 { get() -> int => 200 } {
        Eff40.get()
    }
}

test "spawn наследует handler'ы всех 40 эффектов (>32 registry)" {
    // Plan 173.3 (D415 §2): Atomic* вместо mut-захвата (E_CONCURRENT_MUT_CAPTURE).
    mut s1 = AtomicInt.new(-1)
    mut s2 = AtomicInt.new(-1)
    with Eff01 = effect Eff01 { get() -> int => 1 },
         Eff02 = effect Eff02 { get() -> int => 2 },
         Eff03 = effect Eff03 { get() -> int => 3 },
         Eff04 = effect Eff04 { get() -> int => 4 },
         Eff05 = effect Eff05 { get() -> int => 5 },
         Eff06 = effect Eff06 { get() -> int => 6 },
         Eff07 = effect Eff07 { get() -> int => 7 },
         Eff08 = effect Eff08 { get() -> int => 8 },
         Eff09 = effect Eff09 { get() -> int => 9 },
         Eff10 = effect Eff10 { get() -> int => 10 },
         Eff11 = effect Eff11 { get() -> int => 11 },
         Eff12 = effect Eff12 { get() -> int => 12 },
         Eff13 = effect Eff13 { get() -> int => 13 },
         Eff14 = effect Eff14 { get() -> int => 14 },
         Eff15 = effect Eff15 { get() -> int => 15 },
         Eff16 = effect Eff16 { get() -> int => 16 },
         Eff17 = effect Eff17 { get() -> int => 17 },
         Eff18 = effect Eff18 { get() -> int => 18 },
         Eff19 = effect Eff19 { get() -> int => 19 },
         Eff20 = effect Eff20 { get() -> int => 20 },
         Eff21 = effect Eff21 { get() -> int => 21 },
         Eff22 = effect Eff22 { get() -> int => 22 },
         Eff23 = effect Eff23 { get() -> int => 23 },
         Eff24 = effect Eff24 { get() -> int => 24 },
         Eff25 = effect Eff25 { get() -> int => 25 },
         Eff26 = effect Eff26 { get() -> int => 26 },
         Eff27 = effect Eff27 { get() -> int => 27 },
         Eff28 = effect Eff28 { get() -> int => 28 },
         Eff29 = effect Eff29 { get() -> int => 29 },
         Eff30 = effect Eff30 { get() -> int => 30 },
         Eff31 = effect Eff31 { get() -> int => 31 },
         Eff32 = effect Eff32 { get() -> int => 32 },
         Eff33 = effect Eff33 { get() -> int => 33 },
         Eff34 = effect Eff34 { get() -> int => 34 },
         Eff35 = effect Eff35 { get() -> int => 35 },
         Eff36 = effect Eff36 { get() -> int => 36 },
         Eff37 = effect Eff37 { get() -> int => 37 },
         Eff38 = effect Eff38 { get() -> int => 38 },
         Eff39 = effect Eff39 { get() -> int => 39 },
         Eff40 = effect Eff40 { get() -> int => 40 } {
        supervised {
            spawn { s1.store(read_all()) }
            spawn { s2.store(read_all()) }
        }
    }
    assert(s1.load() == 820)
    assert(s2.load() == 820)
}

test "outer Eff40 (>32 registry) не затирается завершившимися фиберами" {
    mut outer_after = -1
    with Eff01 = effect Eff01 { get() -> int => 1 },
         Eff02 = effect Eff02 { get() -> int => 2 },
         Eff03 = effect Eff03 { get() -> int => 3 },
         Eff04 = effect Eff04 { get() -> int => 4 },
         Eff05 = effect Eff05 { get() -> int => 5 },
         Eff06 = effect Eff06 { get() -> int => 6 },
         Eff07 = effect Eff07 { get() -> int => 7 },
         Eff08 = effect Eff08 { get() -> int => 8 },
         Eff09 = effect Eff09 { get() -> int => 9 },
         Eff10 = effect Eff10 { get() -> int => 10 },
         Eff11 = effect Eff11 { get() -> int => 11 },
         Eff12 = effect Eff12 { get() -> int => 12 },
         Eff13 = effect Eff13 { get() -> int => 13 },
         Eff14 = effect Eff14 { get() -> int => 14 },
         Eff15 = effect Eff15 { get() -> int => 15 },
         Eff16 = effect Eff16 { get() -> int => 16 },
         Eff17 = effect Eff17 { get() -> int => 17 },
         Eff18 = effect Eff18 { get() -> int => 18 },
         Eff19 = effect Eff19 { get() -> int => 19 },
         Eff20 = effect Eff20 { get() -> int => 20 },
         Eff21 = effect Eff21 { get() -> int => 21 },
         Eff22 = effect Eff22 { get() -> int => 22 },
         Eff23 = effect Eff23 { get() -> int => 23 },
         Eff24 = effect Eff24 { get() -> int => 24 },
         Eff25 = effect Eff25 { get() -> int => 25 },
         Eff26 = effect Eff26 { get() -> int => 26 },
         Eff27 = effect Eff27 { get() -> int => 27 },
         Eff28 = effect Eff28 { get() -> int => 28 },
         Eff29 = effect Eff29 { get() -> int => 29 },
         Eff30 = effect Eff30 { get() -> int => 30 },
         Eff31 = effect Eff31 { get() -> int => 31 },
         Eff32 = effect Eff32 { get() -> int => 32 },
         Eff33 = effect Eff33 { get() -> int => 33 },
         Eff34 = effect Eff34 { get() -> int => 34 },
         Eff35 = effect Eff35 { get() -> int => 35 },
         Eff36 = effect Eff36 { get() -> int => 36 },
         Eff37 = effect Eff37 { get() -> int => 37 },
         Eff38 = effect Eff38 { get() -> int => 38 },
         Eff39 = effect Eff39 { get() -> int => 39 },
         Eff40 = effect Eff40 { get() -> int => 40 } {
        supervised {
            spawn { ro _ = eff40_inner_a() }
            spawn { ro _ = eff40_inner_b() }
        }
        // после supervised outer-handler Eff40 должен снова давать 40,
        // а не значение (100/200) последнего дочернего фибера.
        outer_after = Eff40.get()
    }
    assert(outer_after == 40)
}

