// Plan 123.2.1 (V2.1, 2026-06-04): loop-body LICM coordination.
// Closes [M-123.1.2-loop-body-licm-coordination].
//
// V1.1 top-level region scanner weights reads inside loop bodies
// by NOVA_FC_LOOP_ITERS (default 8). Semantic preservation
// проверяется: cached path equals uncached.

module spec_tests.conformance
type Counter15 {
    mut x int
}

fn Counter15.new(start int) -> Counter15 => { x: start }

fn Counter15 mut @sum_in_loop(n int) -> int {
    mut acc = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        acc += @x
        i += 1
    }
    acc
}

test "V2.1: loop-body read accumulates correctly" {
    mut c = Counter15.new(3)
    ro r = c.sum_in_loop(5)
    // 3 * 5 = 15
    assert(r == 15)
}
