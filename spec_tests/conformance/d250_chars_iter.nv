// D250 — `CharsIter`: codepoint-итератор (Plan 152.1 Ф.3, IMPLEMENTED; D410
// rename 2026-07-06: as_chars→chars, as_ префикс упразднён). Норма
// (spec/decisions/03-syntax.md §D250/§D410): `chars()` — ленивая decoding-линза
// (итератор-поток, НЕ коллекция; без Index/at/len — «no hidden O(n)»);
// mut @next() -> Option[char]; @count() O(n); @is_empty(); positional
// `@nth(i)` ретрактирован (D260-амендмент, 2026-07-06) — воссозданный
// запрещённый `s[i]` по codepoint; целевая итерация: `for`/`.indices()`/
// manual next()-drain.
// `for c in s` через str @iter() => @chars(). Конвенция (D410): голое
// существительное = вид/линза (заём), `.collect()` на месте вызова = owned
// копия. Один folder-module `spec_tests.conformance`.
module conformance.d250_chars_iter

test "as_chars: next декодит codepoint'ы по порядку (D250)" {
    mut d250_it = "abc".chars()
    assert(d250_it.next() == Some('a'))
    assert(d250_it.next() == Some('b'))
    assert(d250_it.next() == Some('c'))
    assert(d250_it.next() == None)
}

test "as_chars: multi-byte UTF-8 codepoint'ы (D250)" {
    mut d250_u = "ёж".chars()
    assert(d250_u.next() == Some('ё'))
    assert(d250_u.next() == Some('ж'))
    assert(d250_u.next() == None)
}

test "count/nth/is_empty (D250)" {
    assert("hello".chars().count() == 5)
    assert("ёж".chars().count() == 2)
    // `@nth(i)` ретрактирован (D260-амендмент) — CharsIter не имеет
    // `.skip()`/`.enumerate()` (это методы других адаптеров), поэтому целевая
    // итерация здесь — ручной counted-drain через `next()`.
    mut d250_it2 = "hello".chars()
    mut d250_r2 Option[char] = None
    for d250_k2 in 0..2 { d250_r2 = d250_it2.next() }
    assert(d250_r2 == Some('e'))
    mut d250_it3 = "hi".chars()
    mut d250_r3 Option[char] = None
    for d250_k3 in 0..11 { d250_r3 = d250_it3.next() }
    assert(d250_r3 == None)
    assert("".chars().is_empty())
    assert(!"x".chars().is_empty())
}

test "for c in s — итерация через as_chars-линзу (D250)" {
    mut d250_n = 0
    mut d250_last = ' '
    for d250_c in "нова" {
        d250_n = d250_n + 1
        d250_last = d250_c
    }
    assert(d250_n == 4)
    assert(d250_last == 'а')
}
