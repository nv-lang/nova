// D409 — NESTED record-literal sized/unsigned FIELD coercion + two-level read-back.
// Surface: `type Outer { inner Inner }`, `Inner { v uint }`; construct with a NESTED
// literal `D409wOuter { inner: D409wInner { v: <lit> } }` and read `o.inner.v`.
//
// Why discriminating (int-collapse hunt): the nested `Inner { v: <lit> }` is a TYPED
// literal that, in emit_record_lit's plain-record arm (emit_c.rs ~:31433), assigns each
// field via emit_record_field_value(v, field_ty_c). field_ty_c comes from the Inner
// schema, built by type_ref_to_c(`uint`) → primitive_name_to_c("uint") = "nova_uint"
// (~:11887, ~:6394). emit_record_field_value → emit_expr_with_target_type(lit,"nova_uint");
// since is_typed_integer("nova_uint") is true (~:35949) it lowers via
// emit_typed_int_literal(n,"nova_uint") → `((nova_uint)0x..ULL)` (~:5381) — UNSIGNED.
// Read-back: `o.inner.v` infers via the legacy Member arm — obj_ty(o.inner)=Nova_Inner*,
// then record_schemas["...Inner"]["v"] = "nova_uint" returned verbatim (~:39633), so the
// UNANNOTATED `ro got = o.inner.v` inherits nova_uint (uintptr_t, 64-bit unsigned).
// If ANY level collapsed to signed nova_int, the unsigned high-bit 2^63 would read NEGATIVE
// → `got > 100` false (RUN-FAIL), or a sized/value mismatch (CC-FAIL). A correct path keeps
// it positive and round-trips 200 (> i8 max 127). Spec: spec/decisions/02-types.md (D130,
// named-priority uint≠int / u8≠i8≠int). One folder-module CU; all names D409w-prefixed to
// avoid duplicate-top-level-name collisions with sibling conformance files.
module spec_tests.conformance

type D409wInnerU {
    v uint
}

type D409wOuterU {
    inner D409wInnerU
}

type D409wInnerB {
    b u8
}

type D409wOuterB {
    inner D409wInnerB
}

type D409wInnerI {
    n int
}

type D409wOuterI {
    inner D409wInnerI
}

test "nested record uint field preserves high-bit through construct + o.inner.v (D409)" {
    ro o = D409wOuterU { inner: D409wInnerU { v: 0x8000000000000000 } }   // 2^63
    // direct two-level read — field-typed nova_uint context:
    assert(o.inner.v > 100)        // unsigned: 2^63 > 100 ✓ ; signed collapse → negative → FAIL
    // UNANNOTATED binding inherits the inferred field C type (nova_uint if no collapse):
    ro got = o.inner.v
    assert(got > 100)              // collapse-to-signed → 2^63 reads negative → FAIL
    assert(got != 0)
}

test "nested record u8 field round-trips 200 (>i8 max) via o.inner.b (D409)" {
    ro o = D409wOuterB { inner: D409wInnerB { b: 200 } }   // 200 fits u8, exceeds i8 max 127
    ro got = o.inner.b             // UNANNOTATED: inherits inferred field type
    assert(got == 200)             // exact value preserved (no truncation/sign-flip)
    assert(got > 100)              // unsigned 8-bit: 200 > 100 ✓
}

test "nested record int field still round-trips negative (control) (D409)" {
    ro o = D409wOuterI { inner: D409wInnerI { n: -5 } }   // signed int control
    ro got = o.inner.n
    assert(got == -5)
    assert(got < 0)
}
