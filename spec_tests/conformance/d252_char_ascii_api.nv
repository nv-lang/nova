// D252 — `char` ASCII-core API (152.3a, IMPLEMENTED): классификация / case / to_digit,
// семантика == Rust `char::is_ascii_*`/`to_digit` (codepoint-сравнения, без Unicode-таблиц).
// Behavioral: предикаты различают класс символа; case-конверсия меняет только буквы;
// to_digit возвращает значение цифры в radix или None. Spec: spec/decisions/03-syntax.md (D252).
module conformance.d252_char_ascii_api

test "char ASCII-классификация (D252)" {
    assert('5'.is_ascii_digit())
    assert(!('a'.is_ascii_digit()))
    assert('a'.is_ascii_alphabetic())
    assert(!('5'.is_ascii_alphabetic()))
    assert('A'.is_ascii_uppercase())
    assert(!('a'.is_ascii_uppercase()))
    assert('a'.is_ascii_lowercase())
    assert('f'.is_ascii_hexdigit())
    assert(!('g'.is_ascii_hexdigit()))
}

test "char ASCII case-конверсия — меняет только буквы (D252)" {
    assert('a'.to_ascii_uppercase() == 'A')
    assert('Z'.to_ascii_lowercase() == 'z')
    assert('5'.to_ascii_uppercase() == '5')      // не-буква без изменений
    assert('A'.to_ascii_uppercase() == 'A')      // уже верхний — без изменений
}

test "char to_digit(radix) → Option (D252)" {
    assert('7'.to_digit(10) == Some(7))
    assert('0'.to_digit(10) == Some(0))
    assert('f'.to_digit(16) == Some(15))
    assert('g'.to_digit(16).is_none())           // не hex-цифра → None
    assert('9'.to_digit(8).is_none())            // 9 вне radix 8 → None
}
