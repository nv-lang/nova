//
// Plan 145 — негатив: индексация Vec за границей → panic через nova_idx_chk.
// `fn main` (не test-блок): panic должен дойти до runtime-frame.

module spec_tests.conformance
import std.collections.vec.{Vec}

test "neg vec index oob" panics "out of bounds" {
    ro v = [1, 2, 3]
    ro _ = v[5]
}
