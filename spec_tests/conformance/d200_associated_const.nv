// D200 — associated `const`: accessible через namespace `Type.CONST_NAME`,
// НЕ часть instance layout (type конструируется из instance-полей без const'ов).
// [M-assoc-const-out-of-body-syntax] (D200 AMEND, окно №66): каноническая форма
// сменилась с in-body (`type X { const N = v }`) на out-of-body
// `const Type.NAME <Тип> = <значение>` — симметрично `fn Type.new`/`fn Type @method`.
// Spec: spec/decisions/02-types.md (D200). Норма §«Семантика» п.2-3 без изменений.
module spec_tests.conformance

type D200Config {
    name str
    timeout int
}

const D200Config.VERSION int = 2
const D200Config.PROTOCOL str = "v2"
const D200Config.MAX_PEERS int = 1024

test "namespace access: Type.CONST резолвится к const-значению (D200)" {
    assert(D200Config.VERSION == 2)
    assert(D200Config.MAX_PEERS == 1024)
    assert(D200Config.PROTOCOL == "v2")
}

test "const-поля НЕ в instance layout: type instantiable без них (D200)" {
    ro c = D200Config { name: "alice", timeout: 30 }
    assert(c.name == "alice")
    assert(c.timeout == 30)
}

test "assoc const участвует в constexpr-арифметике на namespace (D200)" {
    ro doubled = D200Config.MAX_PEERS * 2
    assert(doubled == 2048)
}

// [M-d200-assoc-const-composite-value] финализация (2026-07-23): assoc const
// со СОСТАВНЫМ (record-литерал) constexpr-значением — top-level C-символ
// `Type_FieldName` со struct-инициализатором в .rodata (та же семантика
// §«Семантика» п.2-3, расширенная с скаляров на записи). Скоуп: скаляры +
// вложенные записи-из-скаляров. Конструктор-вызов (`= Type.mk(...)`) и
// str-поля в композитной записи — НЕ расширены (см. neg-фикстуры
// plan114/neg/d200_composite_ctor_call_neg.nv,
// plan114/neg/d200_composite_str_field_neg.nv).

type D200StatusCode value {
    priv code int
}

const D200StatusCode.OK D200StatusCode = { code: 200 }
const D200StatusCode.NOT_FOUND D200StatusCode = { code: 404 }

type D200Point value {
    x int
    y int
}

type D200Rect value {
    origin D200Point
    size int
}

const D200Rect.UNIT D200Rect = { origin: { x: 0, y: 0 }, size: 1 }

test "assoc const композитное значение: namespace-доступ + чтение поля (D200 финализация)" {
    assert(D200StatusCode.OK.code == 200)
    assert(D200StatusCode.NOT_FOUND.code == 404)
}

test "assoc const композитное значение: вложенная запись (D200 финализация)" {
    assert(D200Rect.UNIT.origin.x == 0)
    assert(D200Rect.UNIT.origin.y == 0)
    assert(D200Rect.UNIT.size == 1)
}

test "assoc const композитное значение: использование в выражении/сравнении (D200 финализация)" {
    ro a = D200StatusCode.OK
    ro b = D200StatusCode { code: 200 }
    assert(a.code == b.code)
    assert(D200StatusCode.OK.code + 1 == 201)
}

// [M-assoc-const-out-of-body-syntax] (окно №66): instance-доступ к assoc const
// через значение — по-прежнему ошибка (namespace-only access, §Семантика п.3),
// независимо от того, что декларация теперь вне тела типа.
test "instance-доступ к assoc const остаётся namespace-only (D200, окно №66)" {
    ro c = D200Config { name: "bob", timeout: 5 }
    // c.VERSION — было бы E_CONST_INSTANCE_ACCESS; не вызываем здесь (позитивный
    // test-файл), см. neg-фикстуру plan114/neg/d200_oob_instance_access_neg.nv.
    assert(c.name == "bob")
}
