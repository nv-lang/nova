// Plan 164 Ф.3 — skip(n).next() on FilterIter returns correct Option[int].
//
// Regression guard: `@nth` is retracted (W_RETIRED_NAME, migrate to
// `.skip(n).next()` / index `[n]`) — this file keeps testing the underlying
// generic dispatch: each adapter's own `@skip` overload must return the
// right concrete `SkipIter[Self, T]`, whose blanket `#impl(Next[T]) @next()`
// must consume the first n matching elements and return the (n+1)-th.
module spec_tests.conformance
import std.collections.vec_iter

test "skip(n).next() on VecIter" {
    ro v = Vec[int].of(10, 20, 30, 40, 50)
    assert(v.iter().skip(0).next() == Some(10))
    assert(v.iter().skip(2).next() == Some(30))
    assert(v.iter().skip(4).next() == Some(50))
}

test "skip(n).next() on FilterIter returns correct indexed element" {
    ro v = Vec[int].of(1, 2, 3, 4, 5, 6, 7, 8)
    // FilterIter yields: 2, 4, 6, 8 — skip(1).next() = 4, skip(3).next() = 8
    ro r0 = v.iter().filter(|x| x % 2 == 0).skip(0).next()
    ro r1 = v.iter().filter(|x| x % 2 == 0).skip(1).next()
    ro r3 = v.iter().filter(|x| x % 2 == 0).skip(3).next()
    assert(r0 == Some(2))
    assert(r1 == Some(4))
    assert(r3 == Some(8))
}

test "skip(n).next() out of range on FilterIter returns None" {
    ro v = Vec[int].of(1, 2, 3, 4, 5)
    ro r = v.iter().filter(|x| x % 2 == 0).skip(10).next()
    assert(r == None)
}

test "skip(n).next() on empty FilterIter returns None" {
    ro v = Vec[int].of(1, 3, 5)
    ro r = v.iter().filter(|x| x % 2 == 0).skip(0).next()
    assert(r == None)
}

test "skip(n).next() after map on FilterIter" {
    ro v = Vec[int].of(1, 2, 3, 4, 5, 6)
    // map(*10) → MapIter; filter(>25) keeps 30,40,50,60; skip(2).next() = 50
    ro r = v.iter().map(|x| x * 10).filter(|x| x > 25).skip(2).next()
    assert(r == Some(50))
}
