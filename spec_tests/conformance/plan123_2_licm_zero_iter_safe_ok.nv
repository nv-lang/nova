// Plan 123.2 T1.7: zero-iteration loop — hoisted load executed in
// vain (side-effect-free for record-field). Semantics preserved.

module spec_tests.conformance
type Container3_plan1232licmzeroitersafeok {
    ro value int
}

fn Container3_plan1232licmzeroitersafeok @sum_n(n int) -> int {
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        total = total + @value + @value
        i += 1
    }
    total
}

fn Container3_plan1232licmzeroitersafeok.new(v int) -> Container3_plan1232licmzeroitersafeok {
    Container3_plan1232licmzeroitersafeok { value: v }
}

test "zero-iter loop — semantic equivalence" {
    ro c = Container3_plan1232licmzeroitersafeok.new(99)
    assert(c.sum_n(0) == 0)
    assert(c.sum_n(3) == 3 * (99 + 99))
}
