// Plan 177 Ф.2c [M-177-result-tuple-over-array-codegen]: generic free fns whose
// return type is a Result / Option / tuple OVER a generic array payload
// (`Result[[]T, E]`, `Option[[]T]`, `([]T, []E)`) must monomorphize with the
// Vec-flipped payload C-type (`Nova_Vec____<elem>*`) on BOTH the mono signature
// AND the caller-side call-return inference. Regression: the caller inferred the
// pre-D239 raw-array form (`NovaRes_NovaArray_nova_int_p_nova_str*`), a typedef
// that was never emitted → CC-FAIL "unknown type name", plus erased match-arm
// bindings (`Nova_T*`/`Nova_E*`). Fixed in value_aware_subst_to_ref (Vec-flip
// with the same generic-stub → nova_int erasure resolved_array_to_c uses).

module spec_tests.conformance
// Two-generic collector: Result over a generic-array Ok payload.
fn[T, E] err177_sequence(items []Result[T, E]) -> Result[[]T, E] {
    mut out []T = []
    for r in items {
        match r {
            Ok(v) => out.push(v)
            Err(e) => return Err(e)
        }
    }
    Ok(out)
}

// One-generic collector: fixed str error, generic-array Ok payload.
fn[T] err177_sequence_str(items []Result[T, str]) -> Result[[]T, str] {
    mut out []T = []
    for r in items {
        match r {
            Ok(v) => out.push(v)
            Err(e) => return Err(e)
        }
    }
    Ok(out)
}

// Tuple over two generic arrays (`([]T, []E)`) — same erasure hazard.
fn[T, E] err177_partition(items []Result[T, E]) -> ([]T, []E) {
    mut oks []T = []
    mut errs []E = []
    for r in items {
        match r {
            Ok(v) => oks.push(v)
            Err(e) => errs.push(e)
        }
    }
    (oks, errs)
}

test "sequence all-Ok collects into Result[[]int, str]" {
    ro xs []Result[int, str] = [Ok(1), Ok(2), Ok(3)]
    match err177_sequence(xs) {
        Ok(v) => assert(v.len() == 3)
        Err(_) => assert(false)
    }
}

test "sequence short-circuits on first Err with the typed payload" {
    ro xs []Result[int, str] = [Ok(1), Err("bad"), Ok(3)]
    match err177_sequence(xs) {
        Ok(_) => assert(false)
        Err(e) => assert(e == "bad")
    }
}

test "sequence over empty input is Ok of empty" {
    ro xs []Result[int, str] = []
    match err177_sequence(xs) {
        Ok(v) => assert(v.len() == 0)
        Err(_) => assert(false)
    }
}

test "one-generic sequence_str all-Ok" {
    ro xs []Result[int, str] = [Ok(10), Ok(20)]
    match err177_sequence_str(xs) {
        Ok(v) => assert(v.len() == 2)
        Err(_) => assert(false)
    }
}

test "one-generic sequence_str propagates Err" {
    ro xs []Result[int, str] = [Ok(1), Err("nope")]
    match err177_sequence_str(xs) {
        Ok(_) => assert(false)
        Err(e) => assert(e == "nope")
    }
}

test "partition splits Ok and Err into two generic arrays" {
    ro xs []Result[int, str] = [Ok(1), Err("a"), Ok(2), Err("b")]
    ro pr = err177_partition(xs)
    assert(pr.0.len() == 2)
    assert(pr.1.len() == 2)
}
