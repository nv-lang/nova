// D32 — Parameter-passing semantics (REVISED for Plan 184 Р10, D326-ревизия). A `mut x T`
// parameter is an IN-OUT reference for ALL types: field/value writes inside the callee are
// VISIBLE to the caller. For managed-heap records the value is already a handle, so mutation
// has always reached the caller. For VALUE/primitive types (`int`, value-records) `mut x T` is
// now lowered to a pointer to the caller's storage (`T*`) — the old "private copy" model is
// retracted. The argument must therefore be a mutable, addressable lvalue (else
// E_MUT_ARG_NOT_MUTABLE). Matches the revised spec: `fn deposit(mut acc Account, amount)
// { acc.balance += amount }` (visible) and `fn bump(mut x int) { x = 999 }` (NOW visible).
// Spec: spec/decisions/02-types.md (D32 + D326-ревизия Р10). Single `spec_tests.conformance`
// folder-module; D-prefixed names avoid clashes.
module spec_tests.conformance

// Managed-heap record (reference category): passed by reference.
type D32Account {
    balance int
}

// `mut` record param — mutation through the param is visible to the caller (by reference).
fn d32_deposit(mut acc D32Account, amount int) {
    acc.balance += amount
}

// `mut` primitive param — IN-OUT (Plan 184 Р10): the reassignment IS visible to the caller
// (`x` is a pointer to the caller's `int` storage).
fn d32_bump(mut x int) {
    x = 999
}

test "mut record param: caller sees the field mutation (D32, by reference)" {
    mut acc = D32Account { balance: 100 }
    d32_deposit(acc, 50)
    // The record lives on the managed heap and is passed by reference, so the deposit
    // performed inside d32_deposit is observable here.
    assert(acc.balance == 150)
}

test "mut primitive param: caller SEES the reassignment (D32 revised, in-out Р10)" {
    mut n = 5
    d32_bump(n)
    // `int` is now passed as an in-out reference; d32_bump wrote through a pointer to `n`.
    assert(n == 999)
}

test "both passing modes are in-out on the SAME call sequence (D32 revised)" {
    mut acc = D32Account { balance: 10 }
    mut k = 10
    d32_deposit(acc, 5)   // reference: visible
    d32_bump(k)           // in-out primitive: NOW visible
    assert(acc.balance == 15)
    assert(k == 999)
}
