// D404 — арифметика над sized/unsigned ОПЕРАНДАМИ должна СОХРАНЯТЬ тип операнда,
// а не схлопываться в знаковый `nova_int`. Различающая форма: результат-биндинг
// UNANNOTATED (`ro got = a + b`), поэтому он наследует INFERRED тип бинарного
// выражения. Если бы ширина/знак схлопнулись в `nova_int`:
//   • `uint+uint` с высоким битом (2^63) читался бы НЕГАТИВОМ → `got > 100` ложь
//     (RUN-FAIL), и не было бы беззнакового переноса;
//   • `u8`/`u16` wrapping НЕ шёл бы по ширине типа (44 / 54464), а дал бы полное
//     знаковое значение (300 / 120000) → точный `==` ловит коллапс.
//
// Plan 206 Ф.1b/Ф.2 (D423): под sized-int trap-default голый `*`/`+` на sized-типах
// ТРАПИТ на переполнении. Раньше D404 использовал WRAP-по-ширине голого оператора
// как сигнал «тип не схлопнулся» (u8: 300→44, u16: 120000→54464). Под 206 wrap —
// уже не поведение голого оператора, поэтому width-preservation-проверка переехала
// на ЯВНЫЙ `.wrapping_add`/`.wrapping_mul` (тот же различающий сигнал: коллапс в
// nova_int дал бы 300/120000, u8/u16-ширина → 44/54464). uint+uint (2^63 < uint.MAX)
// и i32+i32 (control) НЕ переполняются — голый `+` там остаётся. Что голый
// `u8+u8`/`u16*u16` теперь ТРАПИТ на верной ширине — пинится отдельно в
// spec_tests/soundness/neg/u16_overflow_mul_width_panic.nv.
//
// Codegen-путь (обоснование прогноза PASS): для `a + b`, где `a`,`b` — Ident'ы на
// типизированные локалы, checker-арм `f1_expr` (types/mod.rs Binary, U.4.5) берёт
// `infer_expr_type` каждого операнда из scope (Ident → объявленный тип) и пропускает
// оба через ЕДИНУЮ `number_exprs::promote_arith_rt`: при ДВУХ sized/unsigned операндах
// (ни один не wide-default `nova_int`) правило возвращает ЛЕВЫЙ тип — ширина/знак
// сохраняются (Plan 172.1.1 RANK 1: убран positional-luck коллапс `2*a` → int).
// Результат пишется в `resolved_types[expr.id]`; codegen `infer_expr_c_type`
// (emit_c.rs U.4.5) читает его АВТОРИТЕТНО и лоуэрит через `resolved_type_to_c` →
// `int_name` → `primitive_name_to_c`: u8→nova_byte(uint8_t), u16→uint16_t,
// uint→nova_uint(uint64_t). Тип операнда НЕ схлопывается. Сами C-операции wrap'ятся
// по ширине целевого слота (`nova_byte got = (a+b)` усекает), unsigned `+` определён.
// Spec: spec/decisions/02-types.md (sized/unsigned ≠ int). Один folder-module CU
// spec_tests.conformance; все top-level имена D404-префиксны (тут только тесты).
module spec_tests.conformance

test "uint+uint сохраняет беззнаковость: high-bit сумма читается ПОЗИТИВОМ (D404)" {
    ro d404w_a uint = 0x4000000000000000   // 2^62
    ro d404w_b uint = 0x4000000000000000   // 2^62
    ro got = d404w_a + d404w_b             // UNANNOTATED: наследует inferred тип суммы
    // unsigned: 2^62 + 2^62 = 2^63, высокий бит установлен. Как signed int64 — НЕГАТИВ.
    assert(got > 100)                      // uint: 2^63 > 100 ✓ ; signed-коллапс → negative → FAIL
    assert(!(got < 0))                     // uint: никогда не отрицателен ; signed-коллапс → got < 0
}

test "u8 wrapping_add сохраняет ширину u8, а не signed nova_int (D404 под 206)" {
    ro d404w_x u8 = 200                    // 200 > i8 max (127); влезает в u8
    ro d404w_y u8 = 100
    // Plan 206 Ф.2: голый `+` теперь ТРАПИТ (300 > 255); width-preservation-
    // проверка переехала на явный wrapping_add (модульно по ширине u8).
    ro got = d404w_x.wrapping_add(d404w_y) // UNANNOTATED: inferred u8 (не int)
    // u8-слот: 300 mod 256 = 44. nova_int-коллапс дал бы полное 300.
    assert(got == 44)                      // u8 wrap ✓ ; коллапс → 300 → FAIL
    assert(got != 300)                     // прямой страж против схлопывания в широкий int
}

test "u16 wrapping_mul сохраняет ширину u16, а не signed nova_int (D404 под 206)" {
    ro d404w_p u16 = 60000                 // влезает в u16 (max 65535), > i16 max
    ro d404w_q u16 = 2
    // Plan 206 Ф.2: голый `*` теперь ТРАПИТ на ШИРИНЕ u16 (120000 > 65535 —
    // отдельно пинится neg/u16_overflow_mul_width_panic); width-preservation-
    // проверка переехала на явный wrapping_mul (модульно по ширине u16).
    ro got = d404w_p.wrapping_mul(d404w_q) // UNANNOTATED: inferred u16
    // u16-слот: 120000 mod 65536 = 54464. nova_int-коллапс дал бы полное 120000.
    assert(got == 54464)                   // u16 wrap ✓ ; коллапс → 120000 → FAIL
    assert(got < 65536)                    // остаётся в 16-битном диапазоне ; коллапс → ≥65536
}

test "i32+i32 control: signed-32 round-trips корректно, не теряет знак (D404)" {
    ro d404w_m i32 = -1000000
    ro d404w_n i32 = 5
    ro got = d404w_m + d404w_n             // UNANNOTATED: inferred i32 (control)
    assert(got == -999995)                 // знаковый i32 round-trip
    assert(got < 0)                        // отрицательность сохранена
}
