//
// Plan 33.1 Ф.4 (D24): nova_contract_violation срабатывает при
// нарушении ensures в runtime (debug сборка).
//
// `ensures_buggy` фейлит ensures result == x * 2, потому что body возвращает x + 1.

module spec_tests.conformance
fn ensures_buggy(x int) -> int
    requires x > 0
    ensures result == x * 2
=> x + 1

test "contracts ensures fail" panics "ensures failed:" {
    ro _ = ensures_buggy(5)
    println("UNREACHABLE")
}
