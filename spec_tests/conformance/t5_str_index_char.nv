// Plan 138 Ф.4 — t5: was `s[i] -> char` (D238 `str | int | char`).
// Plan 152.1 (D249 + D238 AMEND): integer-indexing a str is RETRACTED — codepoint
// indexing UTF-8 is O(n) hiding behind `[i]`. The i-th codepoint went through
// the `chars()` lens via `.nth(i)`; `@nth` is itself retracted (D260-амендмент,
// W_RETIRED_NAME) — CharsIter has no `@skip`, so the safe (Option-returning,
// OOB/negative-guarded) replacement is `.collect().get(i)` (Vec[char] `@get`).
// The compile-error for `s[i]` lives in plan152_1/n_str_int_index.

module spec_tests.conformance
test "chars().collect().get(i): i-th codepoint" {
    ro s = "abc"
    assert(s.chars().collect().get(0) == Some('a'))
    assert(s.chars().collect().get(1) == Some('b'))
    assert(s.chars().collect().get(2) == Some('c'))
}

test "chars().collect().get on str literal" {
    assert("hello".chars().collect().get(0) == Some('h'))
    assert("hello".chars().collect().get(4) == Some('o'))
}
