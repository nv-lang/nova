// Plan 123.2 T1.2: mut field inside loop where Plan 123.1 mut path
// bailed (call before loop invalidates mut prefix region). LICM
// emits hoisted cache immediately before loop.

module spec_tests.conformance
type Counter4_2 {
    mut threshold int
}

fn Counter4_2.helper(x int) -> int {
    x + 1
}

fn Counter4_2 mut @sum_above() -> int {
    // 123.1 mut path: prefix region ends at the helper Call.
    // Loop body has 2 reads of @threshold, no writes, no calls.
    // LICM should hoist @threshold immediately before loop.
    mut bias = Counter4_2.helper(5)
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < 4 {
        total += @threshold + @threshold
        i += 1
    }
    total + bias
}

fn Counter4_2.new(x int) -> Counter4_2 {
    Counter4_2 { threshold: x }
}

test "LICM hoists mut field after-call inside loop" {
    mut c = Counter4_2.new(3)
    ro r = c.sum_above()
    // bias = helper(5) = 6; loop 4 iterations × (3+3) = 24; + 6 = 30.
    assert(r == 30)
}
