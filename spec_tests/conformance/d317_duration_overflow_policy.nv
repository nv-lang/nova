// d317_duration_overflow_policy.nv — D317: Duration/instant overflow-policy.
// 3-tier дисциплина (Rust/Swift-паритет; бьёт Go silent-wrap и Zig build-mode-UB):
//   (1) операторы траппят (rt-фикстуры nova_tests/time/rt/); (2) checked_* → Option;
//   (3) saturating_* → clamp к ±MAX. Плюс @abs(i64::MIN), @div(0), f64-NaN/inf,
//   boundary-saturate инстантов, Timestamp-окно 1677..2262 (Q16).
module spec_tests.conformance

import std.time.duration

const d317_MAX = 9_223_372_036_854_775_807
const d317_MIN = -9_223_372_036_854_775_807 - 1

test "d317: checked_* — None on overflow, Some in range" {
    // add/sub at boundary
    assert(d317_MAX.to_nanos().checked_add(1.to_nanos()).is_none())
    assert(d317_MIN.to_nanos().checked_sub(1.to_nanos()).is_none())
    // mul: i64::MAX*2 overflows; i64::MIN*-1 overflows (two's-complement)
    assert(d317_MAX.to_nanos().checked_mul(2).is_none())
    assert(d317_MIN.to_nanos().checked_mul(-1).is_none())
    // div: /0 и i64::MIN/-1
    assert(10.to_nanos().checked_div(0).is_none())
    assert(d317_MIN.to_nanos().checked_div(-1).is_none())
    // in-range → Some(exact)
    match (1.to_hours()).checked_add(30.to_minutes()) {
        Some(r) => assert(r == 90.to_minutes())
        None => assert(false)
    }
}

test "d317: saturating_* clamps to ±MAX (never wraps)" {
    ro top = d317_MAX.to_nanos()
    assert(top.saturating_add(1.to_seconds()).nanos() == d317_MAX)
    assert(top.saturating_mul(2).nanos() == d317_MAX)
    assert(top.saturating_mul(-2).nanos() == -d317_MAX)
    assert((-d317_MAX).to_nanos().saturating_sub(1.to_seconds()).nanos() == -d317_MAX)
}

test "d317: @abs(i64::MIN) saturates to MAX (asymmetry, no UB)" {
    assert(d317_MIN.to_nanos().abs().nanos() == d317_MAX)
    assert((-7.to_seconds()).abs() == 7.to_seconds())
}

test "d317: f64 conversions reject NaN/inf/out-of-range (checked_* → None)" {
    ro g = 1_000_000_000.0
    assert((g * g).checked_to_seconds().is_none())        // 1e27 ns ≫ i64
    assert(d317_MAX.to_nanos().checked_mul_f64(g).is_none())
    match 1.5.checked_to_seconds() {
        Some(r) => assert(r.millis() == 1500)
        None => assert(false)
    }
}

test "d317: Timestamp boundary-saturate + 2262-horizon (Q16)" {
    ro tmax = d317_MAX.to_unix_nanos()
    // checked over horizon → None; @plus saturates (НЕ wrap в 1677)
    assert(tmax.checked_add(1.to_seconds()).is_none())
    assert((tmax + 1.to_seconds()).unix_nanos() == d317_MAX)
    ro tmin = d317_MIN.to_unix_nanos()
    assert(tmin.checked_sub(1.to_nanos()).is_none())
    assert((tmin - 1.to_seconds()).unix_nanos() == d317_MIN)
    // Timestamp - Timestamp → saturating Duration diff
    assert((1042.to_unix_seconds() - 1000.to_unix_seconds()) == 42.to_seconds())
}
