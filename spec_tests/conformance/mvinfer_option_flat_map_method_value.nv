// [M-method-value-arg-in-generic-combinator-infer] POS: method-level
// type-param `U` inferred from an UNBOUND method-value arg through
// `Option[T].flat_map[U](fn(T) -> Option[U]) -> Option[U]` — the
// method-value's return type ITSELF is `Option[U]`, not a bare `U`
// (mirrors Step 2's ClosureFull handling of the same nested shape).

module spec_tests.conformance

type MvInferBox { value int }

fn MvInferBox.new(v int) -> Self => { value: v }
fn MvInferBox @unwrap() -> Option[int] => Some(@value)

test "method-value arg infers method-level type-param (Option.flat_map)" {
    ro b Option[MvInferBox] = Some(MvInferBox.new(7))
    ro r = b.flat_map(MvInferBox.@unwrap)
    match r {
        Some(v) => assert(v == 7)
        None => assert(false)
    }
}

test "method-value arg infers method-level type-param (Option.flat_map, None receiver)" {
    ro b Option[MvInferBox] = None
    ro r = b.flat_map(MvInferBox.@unwrap)
    match r {
        Some(_) => assert(false)
        None => assert(true)
    }
}
