//
// #672 form (3), positive side: all three release shapes stay legal --
// the `@cleanup` delegate, the must-consume return, and the hand-off.
module spec_tests.conformance

type M672R3Ok consume { tag int }

type M672R3Half consume { tag int }

fn M672R3Half consume @cleanup(_outcome ScopeOutcome) -> () { @drop() }

fn M672R3Half consume @drop() -> () { () }

fn M672R3Ok consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

// Release shape 1: this is what `@cleanup` delegates to.
fn M672R3Ok consume @close() -> () { () }

// Release shape 2: ownership travels onward inside a must-consume return.
fn M672R3Ok consume @into_half() -> M672R3Half {
    M672R3Half { tag: @tag }
}

// Release shape 3: the receiver itself is handed off.
fn m672_swallow_ok(consume r M672R3Ok) -> () { r.close() }

fn M672R3Ok consume @hand_on() -> () {
    m672_swallow_ok(@)
}
