module spec_tests.conformance
test "copy semantics: assignment copies, not aliases" {
    mut a [3]int = [1, 2, 3]
    mut b = a
    b[0] = 999
    assert(a[0] == 1)
    assert(b[0] == 999)
}

test "mut param (D326: in-out always) mutates caller" {
    mut a [3]int = [1, 2, 3]
    mutate_inout(a)
    assert(a[0] == 777)
}

fn mutate_inout(mut x [3]int) -> () {
    x[0] = 777
}

test "explicit local copy inside fn does NOT leak (D326 Р11)" {
    mut a [3]int = [1, 2, 3]
    mutate_local_copy(a)
    assert(a[0] == 1)
}

// D246-амендмент ([M-ro-launder-via-mut-binding], Ф.2 migration, 2026-07-23):
// `x` is `mut` (was bare/ro-default) — the STRICT norm forbids an `ro`-bound
// param source flowing into a `mut` local UNCONDITIONALLY (no value-type
// exemption). The fact under test — a fresh `mut y = x` copy does NOT leak
// back to the caller — is unaffected: per D228 revised (Р10), a plain
// binding-copy (`mut y = x`) is independent regardless of `x`'s own
// mutability; only `mut`-PARAM passing became in-out, not binding-copy.
fn mutate_local_copy(mut x [3]int) -> () {
    mut y = x
    y[0] = 888
}

test "nested [N][M]int" {
    mut m [2][3]int = [[1, 2, 3], [4, 5, 6]]
    assert(m[0][0] == 1)
    assert(m[1][2] == 6)
    m[1][2] = 60
    assert(m[1][2] == 60)
    assert(m[0][0] == 1)
}

test "str elements" {
    ro names [3]str = ["a", "bb", "ccc"]
    assert(names[0] == "a")
    assert(names[2] == "ccc")
}

test "return [N]T from fn" {
    ro r = make_arr()
    assert(r[0] == 10)
    assert(r[1] == 20)
}

fn make_arr() -> [2]int {
    ro out [2]int = [10, 20]
    out
}
