// Plan 123.2 T1.8: while-let form — LICM hoists invariant @field.

module spec_tests.conformance
type Counter7_1 {
    ro limit int
}

fn Counter7_1 @count_options() -> int {
    mut x = 0
    mut state = Some(0)
    while Some(v) = state {
        if v >= @limit + @limit {
            state = None
        } else {
            x += 1
            state = Some(v + 1)
        }
    }
    x
}

fn Counter7_1.new(l int) -> Counter7_1 {
    Counter7_1 { limit: l }
}

test "while-let — @limit hoisted" {
    ro c = Counter7_1.new(3)
    ro r = c.count_options()
    // 2*3=6 iterations.
    assert(r == 6)
}
