// Plan 103.2 Ф.9 positive — AtomicInt / AtomicUint (platform-word atomics).
// Plan 207 (2026-07-16 консолидация): AtomicIsize → AtomicInt, AtomicUsize →
// AtomicUint (имена типов Nova — int/uint; изolированных isize/usize нет).
//
// AtomicInt wraps `int` (`nova_int` = `intptr_t`, address-sized — Plan 133),
// AtomicUint wraps `uint` (`nova_uint` = `uintptr_t`, address-sized).
// These are the recommended types for platform-native counters.

module spec_tests.conformance
test "AtomicInt new and load" {
    mut a = AtomicInt.new(42)
    assert(a.load() == 42)
}

test "AtomicInt store and fetch_add" {
    mut a = AtomicInt.new(0)
    a.store(10)
    ro prev = a.fetch_add(5)
    assert(prev == 10)
    assert(a.load() == 15)
}

test "AtomicInt compare_exchange" {
    mut a = AtomicInt.new(100)
    ro ok = a.compare_exchange(100, 200).is_ok()
    assert(ok)
    assert(a.load() == 200)
}

test "AtomicInt swap" {
    mut a = AtomicInt.new(7)
    ro old = a.swap(99)
    assert(old == 7)
    assert(a.load() == 99)
}

test "AtomicUint new and load" {
    mut a = AtomicUint.new(1000)
    assert(a.load() == 1000)
}

test "AtomicUint fetch_add" {
    mut a = AtomicUint.new(5)
    ro prev = a.fetch_add(10)
    assert(prev == 5)
    assert(a.load() == 15)
}

test "AtomicUint compare_exchange failure" {
    mut a = AtomicUint.new(77)
    ro ok = a.compare_exchange(0, 999).is_ok()
    assert(!ok)
    assert(a.load() == 77)
}
