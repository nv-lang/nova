// D74 — математические операции = INSTANCE-методы через `@` на числовых типах (НЕ static
// Math.fn / free fn). Behavioral: результаты различают корректную математику.
// Spec: spec/decisions/08-runtime.md (D74). Один folder-module CU.
//
// signum/is_negative/is_positive на int добавлены в std/runtime/defaults.nv (D74 мандатит
// их для int — §2253-2256 спеки); раньше отсутствовали → CC-FAIL «member reference base
// nova_int». clamp на int работает (Nova_int_method_clamp). Остаётся §1-finding: чекер
// ПРИНИМАЕТ genuinely-undefined int-метод (напр. `pow` пока нет .nv-тела) → CC-FAIL leak
// вместо чистой диагностики (анти-паттерн §0/§1 «категориальное несовпадение ловит C»).
module spec_tests.conformance

test "int math-методы — abs/min/max (D74)" {
    ro a int = -5
    assert(a.abs() == 5)
    assert(42.abs() == 42)
    assert(3.min(8) == 3)
    assert(3.max(8) == 8)
}

test "int sign-методы — signum/is_negative/is_positive/clamp (D74)" {
    assert((-5).signum() == -1)
    assert(0.signum() == 0)
    assert(7.signum() == 1)
    ro neg int = -5
    assert(neg.is_negative())
    assert(!(neg.is_positive()))
    assert(7.is_positive())
    assert(!(7.is_negative()))
    assert(15.clamp(0, 10) == 10)      // выше hi → hi
    assert(5.clamp(0, 10) == 5)        // в диапазоне → сам
    assert((-3).clamp(0, 10) == 0)       // ниже lo → lo
}

test "f64 math-методы — sqrt/abs/floor/ceil/round/min/max (D74)" {
    assert(9.0.sqrt() == 3.0)
    assert((-2.5).abs() == 2.5)
    assert(3.7.floor() == 3.0)
    assert(3.2.ceil() == 4.0)
    assert(3.7.round() == 4.0)
    assert(3.2.round() == 3.0)
    assert(2.5.min(1.5) == 1.5)
    assert(2.5.max(1.5) == 2.5)
}

test "f64 предикаты — is_finite/is_nan (D74)" {
    assert(1.5.is_finite())
    assert((f64.NAN).is_nan())
    assert(!(1.5.is_nan()))
    assert(!((f64.NAN).is_finite()))
    assert(!((f64.INFINITY).is_finite()))
}
