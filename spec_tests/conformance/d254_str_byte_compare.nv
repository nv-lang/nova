// D254 — дефолтное сравнение `str` = BYTE-lexicographic (locale-НЕзависимое, как Rust/Go):
// `@compare` = memcmp-style на байтах + length-tiebreak; операторы `<`/`==`/… синтезируются
// из Nova-body (D-R4). `@eq_ignore_ascii_case` складывает ТОЛЬКО ASCII A-Z/a-z. V2: пустой
// паттерн в split/find/contains — определённый край, НЕ паника. Behavioral: сравнения
// различают byte-порядок (а не case-folded/locale). Spec: spec/decisions/03-syntax.md (D254).
module spec_tests.conformance

test "str сравнение — byte-lexicographic порядок (D254)" {
    assert("abc" < "abd")          // 'c'(0x63) < 'd'(0x64)
    assert("abc" < "abcd")         // префикс < длиннее (length-tiebreak)
    assert("Z" < "a")              // 'Z'(0x5A) < 'a'(0x61) — байты, НЕ case-folding
    assert(!("abc" < "abc"))       // равны → не меньше
    assert("abd" > "abc")
    assert("abc" == "abc")
    assert("abc" != "abd")
}

test "str @compare возвращает знак (отриц/0/полож) (D254)" {
    assert("a".compare("b") < 0)
    assert("b".compare("a") > 0)
    assert("a".compare("a") == 0)
}

test "eq_ignore_ascii_case складывает только ASCII A-Z/a-z (D254)" {
    assert("Hello".eq_ignore_ascii_case("hello"))
    assert("ABC".eq_ignore_ascii_case("abc"))
    assert(!("abc".eq_ignore_ascii_case("abd")))   // разные буквы — не равны
}

test "пустой паттерн — определённый результат, не паника (D254 V2)" {
    assert("hi".contains(""))                 // пустой паттерн содержится
    assert("hi".find("") == Some(0))          // find("") = Some(0)
    assert("hi".split("").collect().len() == 1)         // split("") = ["hi"]
}
