// Plan 100.4.1 (D158): defer-fail во время error-propagation — compile
// pass. Runtime composite chain — partial в bootstrap (Plan 100.4.4
// followup для full composite materialize'а).

module spec_tests.conformance
type WorkErr2 { msg str }
type CommitErr1 { msg str }

fn commit1() Fail[CommitErr1] -> () { () }

fn do_work_that_fails() Fail[WorkErr2] -> () {
    throw WorkErr2 { msg: "operation failed" }
}

// fn-sig объявляет generic Fail (union для WorkErr2 | CommitErr1).
priv(file) fn process1() Fail -> () {
    defer { commit1() }                          // failable cleanup (D158)
    do_work_that_fails()                         // throws WorkErr2 (Plan 173 #3: `?` на unit no-op, дропнут)
}

test "do_work fails + failable-defer compile pass" {
    with Fail = effect Fail { fail(_msg) -> never { interrupt () } } {
        process1()
    }
}
