//
// Plan 110.1.4.h T2.11 (D85 + D188 R3 cancel-shield) → Plan 173 Ф.4 #5
// (D188/D190, [M-110-multierror-any] closed): typed error dispatch в cleanup
// body через ScopeOutcome match → `if err is T` narrowing на `Failure(any)`.
// Ранее — bootstrap str-prefix discrimination ("cancel: "); теперь типизированно.

module spec_tests.conformance
type TxRes3 {
    ro id int
}

fn TxRes3.new(id int) -> TxRes3 => { id }

// cleanup inspects outcome variant + typed narrowing на `err: any`
// для cancel-vs-throw discrimination (Ф.4 #5).
fn TxRes3 consume @cleanup(outcome ScopeOutcome) -> () {
    match outcome {
        Success => ()
        Failure(err) => {
            // Typed narrowing (D54/174.3): cancel surfaces as CancelError.
            if err is CancelError {
                // Cancel path — different cleanup behavior.
                ()
            } else {
                // Regular failure — generic rollback.
                ()
            }
        }
        Panic(_) => ()
    }
}

fn use_typed_dispatch() -> int {
    mut result = 0
    consume tx = TxRes3.new(7) {
        result = tx.id
    }
    result
}

test "Plan 110.1.4.h T2.11: typed error dispatch via outcome match" {
    assert(use_typed_dispatch() == 7)
}
