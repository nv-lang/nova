// Plan 128.2 Ф.2 P1 — mut binding + member chain + mut method = OK.
//
// `mut b` binding, `Wrapper2 { mut inner Vec32_2 }`, b.inner.set_x(42).
// Verifies positive path: chain-walking enforcement allows mutation
// когда root binding `mut` и intermediate field `mut`.

module spec_tests.conformance
type Vec32_2(x int, y int, z int)

fn Vec32_2 mut @set_x(v int) -> () {
    @x = v
}

type Wrapper2 {
    mut inner Vec32_2
}

fn Wrapper2.new() -> Self => {
    // №145: positional — no defaults, D102 forbids named-arg form.
    inner: Vec32_2(1, 2, 3),
}

test "mut binding + member chain + mut method — OK" {
    mut b = Wrapper2.new()
    b.inner.set_x(42)
    assert(b.inner.x == 42)
    assert(b.inner.y == 2)
    assert(b.inner.z == 3)
}
