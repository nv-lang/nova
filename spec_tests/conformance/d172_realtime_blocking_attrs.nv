// D172 — `#realtime` / `#blocking` attribute-only model + sync-class annotations
// (Plan 103.6, amended Plan 113; final). Норма (spec/decisions/06-concurrency.md §D172):
// `#realtime fn` — callee guarantee (в теле только #realtime-операции: атомики,
// try_lock/try_acquire, fence, OnceCell.get/set, Lazy.is_forced); `#blocking fn` —
// вся fn выполняется на libuv-threadpool (fiber паркуется); #wakes-операции
// (unlock/release) разрешены в #blocking, запрещены в #realtime. Sync-class берётся
// из annotation-driven реестра (`#realtime/#parks/#wakes` на `external fn` в .nv),
// НЕ из hardcode. Негативы (E_REALTIME_SYNC_PARK / E_BLOCKING_SYNC_PARK /
// E_REALTIME_NESTED_SYNC_VIA_FN) — neg/d172_*.nv. Шаблоны сверены с
// nova_tests/plan103_6. Один folder-module `spec_tests.conformance`.
module spec_tests.conformance

// ── #realtime: только leaf-операции без scheduler-взаимодействия ──

#realtime fn d172_rt_try_lock(mut d172_m Mutex) -> bool {
    d172_m.try_lock()
}

#realtime fn d172_rt_atomic(mut d172_a AtomicI64, delta int) -> int {
    d172_a.fetch_add(delta)
}

#realtime fn d172_rt_oncecell_get(d172_c OnceCell[int]) -> Option[int] {
    d172_c.get()
}

test "#realtime: Mutex.try_lock разрешён; семантика try (D172)" {
    mut d172_lm = Mutex.new()
    ro d172_acq = d172_rt_try_lock(d172_lm)
    assert(d172_acq == true)
    d172_lm.unlock()
    d172_lm.lock()
    ro d172_second = d172_rt_try_lock(d172_lm)
    assert(d172_second == false)
    d172_lm.unlock()
}

test "#realtime: атомики разрешены (D172)" {
    mut d172_la = AtomicI64.new(100)
    ro d172_prev = d172_rt_atomic(d172_la, 50)
    assert(d172_prev == 100)
    assert(d172_la.load() == 150)
}

test "#realtime: OnceCell.get разрешён (D172)" {
    mut d172_lc = OnceCell[int].new()
    assert(d172_rt_oncecell_get(d172_lc) == None)
    d172_lc.set(7)
    assert(d172_rt_oncecell_get(d172_lc) == Some(7))
}

// ── #blocking: threadpool-offload; #realtime и #wakes операции разрешены ──

#blocking fn d172_blk_fetch_add(mut d172_a AtomicI64, delta int) -> int {
    d172_a.fetch_add(delta)
}

#blocking fn d172_blk_unlock(mut d172_m Mutex) {
    d172_m.unlock()
}

test "#blocking: атомики (leaf #realtime) разрешены; offload исполняется (D172)" {
    mut d172_la = AtomicI64.new(1)
    ro d172_prev = d172_blk_fetch_add(d172_la, 2)
    assert(d172_prev == 1)
    assert(d172_la.load() == 3)
}

test "#blocking: Mutex.unlock (#wakes) разрешён (D172)" {
    mut d172_lm = Mutex.new()
    d172_lm.lock()
    d172_blk_unlock(d172_lm)
    ro d172_acq = d172_lm.try_lock()
    assert(d172_acq == true)
    d172_lm.unlock()
}

// ── #realtime nogc: как #realtime, плюс запрет managed-heap-аллокаций ──
// №273 (D172 nogc amend): scalar-only body — никаких alloc-вызовов, поэтому
// `#realtime nogc fn` компилируется и работает как обычный `#realtime fn`.
// Negative-стороны (Vec[int].of / Vec[int].new внутри #realtime nogc fn) —
// neg/d172_realtime_nogc_alloc_neg.nv, neg/d172_realtime_nogc_turbofish_neg.nv.

#realtime nogc fn d172_rt_nogc_scalar(a int, b int) -> int {
    a + b * 2
}

test "#realtime nogc: scalar-only body без аллокаций разрешён (D172)" {
    assert(d172_rt_nogc_scalar(3, 4) == 11)
}
