// Plan 123.4 T1.2: depth-3 chain `@parent.inner.cfg`.

module spec_tests.conformance
priv(file) type Cfg {
    ro limit int
}

priv(file) type Inner1 {
    ro cfg Cfg
}

type Parent3_1 {
    ro inner Inner1
}

fn Parent3_1 @check_limits() -> int {
    // 3 reads of chain @inner.cfg.limit (depth 3).
    @inner.cfg.limit + @inner.cfg.limit * 2 + @inner.cfg.limit
}

fn Parent3_1.new(lim int) -> Parent3_1 {
    Parent3_1 { inner: Inner1 { cfg: Cfg { limit: lim } } }
}

test "3-level chain cached" {
    ro p = Parent3_1.new(7)
    ro r = p.check_limits()
    // 7 + 14 + 7 = 28.
    assert(r == 28)
}
