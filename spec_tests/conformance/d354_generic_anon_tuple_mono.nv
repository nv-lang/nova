// D354 — generic anonymous tuple `(T, U)` is MONOMORPHIZED per instantiation with REAL
// element types (no nova_int erasure): each turbofish instantiation gets a unique
// length-prefixed typedef, the tuple is a value-type (no heap-box), positional `.0`/`.1`
// access and destructure work after mono, and heterogeneous element types (str + int) hold.
// Extends D123 (positional tuple codegen) with the generic-aware substitution path.
module spec_tests.conformance

// Single type-param: (T, T) — same element type, two distinct call-site instantiations.
// `-> (ro T, ro T)`, не `(T, T)`: возврат ro-параметра внутри кортежа —
// E_READONLY_COERCE по D246 (№7717 дыра 1 ФОРМА, 2026-08-23). Предмет этой
// фикстуры — мономорфизация кортежа, а не ro-ность; `ro` — квалификатор
// вида, не отдельный тип, так что предмет сохранён.
fn[T] d354_dup(v T) -> (ro T, ro T) => (v, v)

// Two type-params: (T, U) — heterogeneous element types per instantiation.
fn[T, U] d354_pair(x T, y U) -> (ro T, ro U) => (x, y)

test "generic (T, T) mono + destructure with REAL int types (D354)" {
    ro (a, b) = d354_dup[int](42)
    assert(a == 42)
    assert(b == 42)
}

test "same generic fn, second instantiation (str) is an independent mono (D354)" {
    ro (s, t) = d354_dup[str]("hi")
    assert(s == "hi")
    assert(t == "hi")
}

test "positional .0 / .1 access on mono'd generic tuple (D354)" {
    ro p = d354_dup[int](100)
    assert(p.0 == 100)
    assert(p.1 == 100)
}

test "heterogeneous (T, U) mono: int + str hold after destructure (D354)" {
    ro (i, s) = d354_pair[int, str](7, "x")
    assert(i == 7)
    assert(s == "x")
}
