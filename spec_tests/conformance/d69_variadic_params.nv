// D69 — Variadic-параметры через `...items []T`.
// Последний параметр с `...` принимает N отдельных аргументов → собирает в []T.
// Внутри функции — обычный []T. Call-site: `f(a, b, c)` или `f(...arr)`.
//
// Discriminator: без variadic нужно явно передавать `f([a, b, c])`.
//
// Spec: spec/decisions/03-syntax.md D69. Единица: folder-module `spec_tests.conformance`.
module spec_tests.conformance

fn d69_sum(...items []int) -> int {
    mut total = 0
    for x in items {
        total = total + x
    }
    total
}

fn d69_join(...items []str) -> int {
    mut total = 0
    for s in items {
        total = total + s.byte_len()
    }
    total
}

test "variadic: zero args gives empty slice (D69)" {
    ro s = d69_sum()
    assert(s == 0)
}

test "variadic: single arg (D69)" {
    ro s = d69_sum(42)
    assert(s == 42)
}

test "variadic: multiple args summed (D69)" {
    ro s = d69_sum(1, 2, 3, 4, 5)
    assert(s == 15)
}

test "variadic: spread existing slice (D69)" {
    ro nums = [10, 20, 30]
    ro s = d69_sum(...nums)
    assert(s == 60)
}

test "variadic: str items byte_len sum (D69)" {
    ro total = d69_join("ab", "cde")
    assert(total == 5)
}
