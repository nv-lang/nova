// №363 [operand-losing-address-on-byref-other]: named-tuple binary-operator
// desugar (`==`/`+`/`-`/`*`/`/`/`<`/`<=`/`>`/`>=`) always emitted the RIGHT
// operand bare, never wrapped in `&(...)`. This matched the callee's ABI
// only when the non-self `other` param happened to be by-VALUE (small
// types). For a "large" (>16B, Plan 172.14 `method_byref_flag`) named-tuple
// type — e.g. one nesting ANOTHER named tuple as a field — the C signature
// takes `other` BY POINTER, and the bare (unaddressed) argument was a
// deterministic CC-FAIL ("passing 'NovaTuple_X' to parameter of
// incompatible type 'NovaTuple_X *'; take the address with &"), reproduced
// with a two-field-of-named-tuple wrapper. Root cause: emit_c.rs's
// NovaTuple `==`/arith/compare arms (~34248/~34289) never consulted
// `method_byref_flag` for the right operand (only ever materialized the
// LEFT operand into an addressable temp). Fixed to take `&(r)` when
// `method_byref_flag(type_name, method_name, 0)` says the callee wants a
// pointer. This is a hard compile failure in ALL configurations tried
// (standalone build, small/large compile-unit) — never a silent wrong
// value; investigated and ruled out as the cause of a separately-observed
// RUN-FAIL in nova-bignum (that symptom traces to a different defect).
// Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

export type P363Frac(sign int, mag int)

export fn P363Frac.new(sign int, mag int) -> P363Frac => P363Frac(sign, mag)

export fn P363Frac @plus(other P363Frac) -> P363Frac =>
    P363Frac.new(1, @mag + other.mag)

export fn P363Frac @times(other P363Frac) -> P363Frac =>
    P363Frac.new(1, @mag * other.mag)

export fn P363Frac @equal(other P363Frac) -> bool {
    @sign == other.sign && @mag == other.mag
}

// P363Big nests P363Frac twice (>16B) — "not fully stack" — its OWN
// instance methods take `other` by pointer (`method_byref_flag` true),
// unlike `P363Frac` above whose `other` stays by-value (small, 2 ints).
export type P363Big(num P363Frac, den P363Frac)

export fn P363Big.new(num P363Frac, den P363Frac) -> P363Big => P363Big(num, den)

export fn P363Big @plus(other P363Big) -> P363Big {
    P363Big.new(@num.plus(other.num), @den.plus(other.den))
}

export fn P363Big @times(other P363Big) -> P363Big {
    P363Big.new(@num.times(other.num), @den.times(other.den))
}

export fn P363Big @equal(other P363Big) -> bool {
    @num.equal(other.num) && @den.equal(other.den)
}

test "named-tuple `==` on a by-ref-other type computes the correct value (№363)" {
    ro a = P363Big.new(P363Frac.new(1, 3), P363Frac.new(1, 5))
    ro b = P363Big.new(P363Frac.new(1, 3), P363Frac.new(1, 5))
    ro c = P363Big.new(P363Frac.new(1, 4), P363Frac.new(1, 5))
    assert(a == b)
    assert(!(a == c))
}

test "named-tuple `+`/`*` on a by-ref-other type compute the correct value (№363)" {
    ro a = P363Big.new(P363Frac.new(1, 3), P363Frac.new(1, 5))
    ro b = P363Big.new(P363Frac.new(1, 4), P363Frac.new(1, 6))

    ro sum = a + b
    assert(sum.num.mag == 7)
    assert(sum.den.mag == 11)

    ro prod = a * b
    assert(prod.num.mag == 12)
    assert(prod.den.mag == 30)
}

// Same by-ref-other defect, `<`/`<=`/`>`/`>=` sibling arm (~34289, `@compare`
// dispatch for named tuples, №247's codegen home).
export type P363Ord(lo P363Frac, hi P363Frac)

export fn P363Ord.new(lo P363Frac, hi P363Frac) -> P363Ord => P363Ord(lo, hi)

export fn P363Ord @compare(other P363Ord) -> int {
    ro m = @hi.mag - @lo.mag
    ro o = other.hi.mag - other.lo.mag
    if m < o { -1 } else if m > o { 1 } else { 0 }
}

test "named-tuple `<`/`>` on a by-ref-other type compute the correct value (№363)" {
    ro narrow = P363Ord.new(P363Frac.new(1, 1), P363Frac.new(1, 2))
    ro wide = P363Ord.new(P363Frac.new(1, 1), P363Frac.new(1, 9))
    assert(narrow < wide)
    assert(wide > narrow)
    assert(!(wide < narrow))
}
