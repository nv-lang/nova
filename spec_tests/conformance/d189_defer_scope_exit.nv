// D189 — `defer { ... }` выполняется при выходе из scope; несколько defer — в LIFO-порядке.
// Behavioral: эффект defer наблюдаем ПОСЛЕ scope (не внутри); порядок нескольких defer —
// обратный регистрации. Spec: spec/decisions/03-syntax.md (D189). Один folder-module CU.
module conformance.d189_defer_scope_exit

test "defer выполняется при выходе из scope, не раньше (D189)" {
    mut x = 0
    {
        defer { x = x + 10 }
        x = x + 1
        assert(x == 1)            // внутри scope: defer ещё НЕ выполнен
    }
    assert(x == 11)               // после scope: defer добавил 10
}

test "несколько defer — LIFO (обратный регистрации) порядок (D189)" {
    mut seq = 0
    {
        defer { seq = seq * 10 + 1 }   // зарегистрирован 1-м → выполнится ПОСЛЕДНИМ
        defer { seq = seq * 10 + 2 }   // зарегистрирован 2-м → выполнится ПЕРВЫМ
    }
    // LIFO: сначала +2 (0→2), затем +1 (2→21)
    assert(seq == 21)             // если бы FIFO — было бы 12
}
