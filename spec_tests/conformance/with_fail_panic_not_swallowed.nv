//
// Plan 173 Ф.1 (D13 soundness, [M-172-with-fail-swallows-panic]): panic внутри
// `with Fail[E]`-блока НЕ должен глотаться Fail-handler'ом. `with Fail`
// перехватывает ТОЛЬКО USER/USER_TYPED (recoverable errors); panic
// (bug/abort-class, D13) обязан пробрасываться нагору → runtime panic.
//
// Ранее (баг): catch-ветка проверяла только error_kind==CANCEL, PANIC
// проваливался в USER-path → result=default, выполнение продолжалось
// (panic проглочен). Fix: PANIC re-throw через nova_rethrow_with_suppressed.
//
// Если баг жив — panic проглотится, main дойдёт до нормального завершения
// БЕЗ panic → test-runner НЕ увидит EXPECT_RUNTIME_PANIC → FAIL.
// Если fix — panic доходит до runtime → "panic: boom" → PASS.

module spec_tests.conformance
type WFErr { msg str }

fn wf_panics() Fail[WFErr] -> int {
    panic("boom")
}

test "with fail panic not swallowed" panics "boom" {
    ro _r = with Fail = effect Fail {
        fail(_m) -> never { interrupt 0 }
    } {
        wf_panics()
    }
    // Недостижимо при корректном fix (panic пробросился выше).
    panic("UNREACHABLE: panic was swallowed by with Fail (D13 violation)")
}
