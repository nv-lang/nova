// SPDX-License-Identifier: MIT OR Apache-2.0
// [M-176-xmod-payload-variant-ctor]: the OTHER half of the `Phase` collision
// pair (see `_b`). Referenced only via functions (never `Phase` bare) so this
// file compiles, while its declaration still makes the bare name `Phase`
// collide across modules in the merged CU.
module conformance.m176_variant_ctor_method_c

export type Phase enum
    | Stop
    | Go

export fn make_phase_c() -> Phase => Stop

export fn phase_c_render(p Phase) -> str {
    match p {
        Stop => "c-stop"
        Go   => "c-go"
    }
}
