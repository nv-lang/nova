//
// Plan 173 Ф.5 п.2 (D192-РЕТРАКТ; ранее Plan 110.2.2.a
// [M-110-deadline-fire-fixture]) POSITIVE E2E — watchdog вместо
// force-timeout:
// Per-type Level 1 `exit_timeout_ms()` set к 1ms + cleanup sleeps 30ms →
// порог превышен, но cleanup ДОБЕГАЕТ ДО КОНЦА («defer всегда добегает»,
// §3a; CleanupTimeoutError и throw-механизм УДАЛЕНЫ). Превышение
// наблюдаемо структурно: overrun=true в ResourceTrace exit-событии.
// (stderr-варн «fiber stuck in cleanup» — та же ветка watchdog на
// suspend-точке внутри fiber; проверяется Rust-интеграционным тестом
// раннера, не .nv-фикстурой.)
//
// Pipeline verified:
//   1. consume scope entry → nv_consume_enter_shield (mask only)
//   2. cleanup dispatch → nv_cleanup_watchdog_arm(1ms из Level 1)
//   3. cleanup body (30).to_millis().sleep() → suspend → nv_shield_check_deadline →
//      (в fiber-контексте) one-shot stderr-варн, БЕЗ прерывания
//   4. cleanup завершается → nv_cleanup_watchdog_disarm →
//      exit-событие (duration≈30ms, overrun=true, порог 1ms < 30ms)

module spec_tests.conformance
type SlowCleanup4 { ro id int }

fn SlowCleanup4.new(id int) -> SlowCleanup4 => { id }

// Plan 110.9.2 V1.1 Level 1: tiny budget — beats default 5000ms hard-fallback.
fn SlowCleanup4 @exit_timeout_ms() -> int => 1

// Медленный cleanup: 30ms >> 1ms порога. Time — ambient (D62).
// D192-ретракт: НЕ прерывается — добегает до конца.
fn SlowCleanup4 consume @cleanup(_outcome ScopeOutcome) -> () {
    30.to_millis().sleep()
    return ()
}

test "Plan 173 Ф.5.2 (ex-110.2.2.a): Level-1 порог превышен → overrun=true, cleanup добегает" {
    mut observed_overrun = false
    mut observed_duration = -1
    mut result = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, duration_ms, overrun) -> () {
            observed_duration = duration_ms
            observed_overrun = overrun
            return ()
        }
    } {
        consume r = SlowCleanup4.new(42) {
            result = r.id
        }
    }
    // Body выполнился, cleanup ДОБЕЖАЛ (duration отражает полный сон),
    // Level-1 порог 1ms превышен → overrun.
    assert(result == 42)
    assert(observed_duration >= 20)
    assert(observed_overrun == true)
}
