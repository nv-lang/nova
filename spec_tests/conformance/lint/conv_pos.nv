// Фикстура-позитив плана 185 (`nova lint` самотест): этот файл ДОЛЖЕН давать
// ровно 7 находок реестра конвенционных правил:
//   W_NONVARIADIC_OF      — static `of` без вариадика (§21б)
//   W_RETIRED_PREFIX      — `as_`-метод (D410)
//   W_WITH_MUTATOR        — with_* с mut-приёмником (§21)
//   W_STR_CONCAT_LOOP     — конкатенация строкового литерала в цикле
//   W_DESTRUCTURE_SNAPSHOT — 2 подряд полевых снапшота одного источника (§26, D411)
//   W_LEADING_BINOP_CONTINUATION — ведущий `||` в начале continuation-строки
//     (footgun D417-класс — needs_quoting/is_ascii_ident_char, 2026-07-10)
//   W_REDUNDANT_OF        — `Vec[int].of(1, 2, 3)` избыточен: литерал `[1, 2, 3]`
//     дал бы ТОТ ЖЕ `Vec[int]` (§28)
// Прогон: nova lint nova_tests/lint/conv_pos.nv → exit 1, 7 finding(s).
// Для `nova test` файл — обычный компилируемый unit (main + вызовы).

module lint.conv_pos
type Widget { ro kind int, mut label str }

// W_NONVARIADIC_OF: не-вариадик of.
export fn Widget.of(kind int) -> Widget => { kind, label: "" }

// W_RETIRED_PREFIX: as_-имя.
export fn Widget @as_label() -> str => @label

// W_WITH_MUTATOR: with_* мутирует приёмник.
export fn Widget mut @with_label(v str) -> () {
    @label = v
}

// W_DESTRUCTURE_SNAPSHOT: 2 подряд полевых снапшота одного источника `w`
// (канон D411 — `ro { kind, label } = w`).
fn describe(w Widget) -> str {
    ro kind = w.kind
    ro label = w.label
    "${kind}${label}"
}

// W_STR_CONCAT_LOOP: строковая конкатенация в цикле.
fn join(parts []str) -> str {
    mut s = ""
    for p in parts {
        s = s.concat(",").concat(p)
    }
    s
}

// W_LEADING_BINOP_CONTINUATION: ведущий `||` в начале continuation-строки —
// предыдущая строка (паренthesized bool-выражение) сбалансирована по скобкам
// и похожа на завершённый statement; парсер парсит `|| (...)` как ОТДЕЛЬНЫЙ
// zero-arg closure-литерал (discarded statement), а не продолжение
// выражения. Реальный прецедент: needs_quoting/is_ascii_ident_char
// (2026-07-10) были always-true ровно из-за этого.
fn is_ascii_letter_leading(c int) -> bool {
    mut result = false
    (c >= 65 && c <= 90)
    || (c >= 97 && c <= 122)
    result
}

// W_REDUNDANT_OF: `Vec[int].of(...)` избыточен — литерал `[1, 2, 3]` дал бы
// ТОТ ЖЕ `Vec[int]` (§28).
fn redundant_of() -> []int {
    Vec[int].of(1, 2, 3)
}

fn main() -> () {
    mut w = Widget.of(1)
    w.with_label("x")
    ro _lbl = w.as_label()
    ro _s = join(["a", "b"])
    ro _d = describe(w)
    ro _letter = is_ascii_letter_leading(70)
    ro _v = redundant_of()
    ()
}
