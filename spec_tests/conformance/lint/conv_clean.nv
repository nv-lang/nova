// Фикстура-негатив плана 185 (`nova lint` самотест): канонические формы тех же
// операций — НОЛЬ находок реестра.
// Прогон: nova lint nova_tests/lint/conv_clean.nv → exit 0, 0 finding(s).

module lint.conv_clean
type Widget { ro kind int, mut label str }

// Канон §21б: new + дефолт-параметры (не `of`).
export fn Widget.new(kind int, label str = "") -> Widget => { kind, label }

// Канон D410: вид — голое существительное.
export fn Widget @label_view() -> str => @label

// Канон D117 AMEND-2: мутирующее свойство `mut @x(v) -> @`.
export fn Widget mut @label(v str) -> @ {
    @label = v
}

// Канон-исключение (owner 2026-07-17, nv-coding-style «with_»-раздел):
// `with_*`, принимающий ЗАМЫКАНИЕ — scope-guard (RAII: «выполнить body под
// ресурсом», прецедент Kotlin `withLock`), НЕ field-copy — mut-приёмник
// здесь легитимен, W_WITH_MUTATOR молчит (сигнатура — fn-типовый параметр).
export fn Widget mut @with_label_scope[R](body fn() -> R) -> R {
    ro saved = @label
    @label = "locked:${saved}"
    ro r = body()
    @label = saved
    r
}

// Канон §26 (D411): деструктуризация одним биндингом вместо полевых снапшотов.
fn describe(w Widget) -> str {
    ro { kind, label } = w
    "${kind}${label}"
}

// Канон perf-conventions: StringBuilder в цикле.
fn join(parts []str) -> str {
    consume sb = StringBuilder.new()
    mut first = true
    for p in parts {
        if !first { sb.append(",") }
        sb.append(p)
        first = false
    }
    // №520: implicit #coerce finalization now counts as a consumption, so the
    // bare value is the canonical form here and the explicit call would be
    // genuinely redundant. This file is the no-false-positives reference, so it
    // must show the canonical form — the finding on the old line was TRUE, not
    // false.
    sb
}

// Канон nv-coding-style §27: TRAILING-оператор в конце строки (не ведущий на
// continuation-строке) — тот же паттерн, что is_ascii_letter_leading в
// conv_pos.nv, но безопасная форма.
fn is_ascii_letter_trailing(c int) -> bool {
    mut result = false
    (c >= 65 && c <= 90) ||
    (c >= 97 && c <= 122)
    result
}

// Канон §28: `.of` легален, когда фиксирует тип, которого литерал не даёт —
// здесь `u32` (литерал `[1, 2, 3]` дал бы `Vec[int]`, не `Vec[u32]`).
fn legit_of_narrowing() -> []u32 {
    Vec[u32].of(1, 2, 3)
}

fn main() -> () {
    mut w = Widget.new(1)
    w.label("x")
    ro _lbl = w.label_view()
    ro _scope = w.with_label_scope(|| 1)
    ro _s = join(["a", "b"])
    ro _d = describe(w)
    ro _letter = is_ascii_letter_trailing(70)
    ro _v = legit_of_narrowing()
    ()
}
