// d318_monotonic_non_regression.nv — D318: Monotonic non-regression contract.
// При кажущемся регрессе часов (HW/VM/OS-баг, JDK-6458294) elapsed/@minus
// SATURATE-to-ZERO (никогда negative, никогда panic, без global-lock —
// урок Rust 1.60-saga); checked_duration_since → None. Monotonic never goes
// backwards by contract; clock-source per-OS документирован в D318/docs.
module spec_tests.conformance

import std.time.duration

test "d318: elapsed_since saturates to zero on apparent regress" {
    ro m = Monotonic.now()
    ro earlier = m - 10.to_seconds()
    // forward → exact
    assert(m.elapsed_since(earlier) == 10.to_seconds())
    // equal marks → zero
    assert(m.elapsed_since(m).nanos() == 0)
    // regress (earlier before m) → saturate-to-zero, NEVER negative
    ro back = earlier.elapsed_since(m)
    assert(back.nanos() == 0)
    assert(!back.is_negative())
}

test "d318: checked_duration_since → None on regress, Some forward" {
    ro m = Monotonic.now()
    ro earlier = m - 3.to_seconds()
    assert(earlier.checked_duration_since(m).is_none())
    match m.checked_duration_since(earlier) {
        Some(r) => assert(r == 3.to_seconds())
        None => assert(false)
    }
    // equal → Some(ZERO)
    match m.checked_duration_since(m) {
        Some(r) => assert(r.nanos() == 0)
        None => assert(false)
    }
}

test "d318: Monotonic ± Duration saturates at boundary" {
    ro m = Monotonic.now()
    // forward/back within range round-trips
    ro fwd = m + 5.to_seconds()
    assert(fwd.elapsed_since(m) == 5.to_seconds())
    ro bwd = m - 5.to_seconds()
    assert(m.elapsed_since(bwd) == 5.to_seconds())
}
