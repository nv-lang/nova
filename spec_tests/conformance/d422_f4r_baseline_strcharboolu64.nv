// Plan 208 Ф.4R (owner 2026-07-20, docs/plans/208-unified-formatter.md §10R)
// — Ш0 BASELINE: byte-exact snapshot of str/char/bool/u64 display output
// from the CURRENT (pre-Ф.4R) `nova_rt/conv.h` chain, captured by
// building+running the unmodified main-repo binary on 2026-07-20. See
// d422_f4r_baseline_int.nv header — same byte-parity contract, DO NOT edit.
module spec_tests.conformance

test "Ф.4R baseline: str/char Display + Debug-quoted (as-is, escape rules unchanged)" {
    ro hello = "hello"
    assert("${hello}" == "hello")
    assert("${hello:?}" == "\"hello\"")
    ro esc_s = "a\nb\tc\rd\\e\"f"
    assert("${esc_s:?}" == "\"a\\nb\\tc\\rd\\\\e\\\"f\"")
    ro nul_s = "a\0b"
    assert("${nul_s:?}" == "\"a\\0b\"")
    // Non-printable control bytes (< 0x20) NOT in {\n \t \r \0} escape as
    // `\xHH` (lowercase hex, NO braces — conv.h `nova_str_to_debug_str`'s
    // own header comment says `\x{HH}` but the actual code emits `\xHH`;
    // this fixture pins the real runtime behavior, not the stale comment).
    ro ctrl_s = "\u{01}\u{1f}"
    assert("${ctrl_s:?}" == "\"\\x01\\x1f\"")

    ro cx = 'x'
    assert("${cx}" == "x")
    assert("${cx:?}" == "'x'")
    ro cnl = '\n'
    assert("${cnl:?}" == "'\\n'")
    ro cq = '\''
    assert("${cq:?}" == "'\\''")
    ro cb = '\\'
    assert("${cb:?}" == "'\\\\'")
    // Printable multi-byte codepoint — passthrough, no escaping.
    ro cu = '\u{4E2D}'
    assert("${cu:?}" == "'中'")
}

test "Ф.4R baseline: bool" {
    assert("${true}" == "true")
    assert("${false}" == "false")
    assert("${true:?}" == "true")
}

test "Ф.4R baseline: u64 MAX / i64 MIN bare interpolation" {
    // [M-u64-uint-to-str-prints-signed] FIXED (ICE-пачка п.9, 2026-08-01):
    // was pinned here as a KNOWN QUIRK — bare `${u64_value}` interpolation
    // had no dedicated u64/uint entry in emit_c.rs's numeric-to-str
    // dispatch (println's `infer_print_helper` and the interpolation
    // user-type fallback both only recognized "nova_int"'s C type) — it
    // fell through to the generic numeric-cast fallback
    // `nova_int_to_str((nova_int)(v))`, which reinterpreted the u64 bit
    // pattern as SIGNED `nova_int` (`u64.MAX` printed "-1"). Fixed with a
    // dedicated `nova_uint_to_str`/`nova_print_uint` runtime pair (`%llu`)
    // wired into both dispatch surfaces for the "uint64_t"/"nova_uint" C
    // types. Byte-parity contract updated to the CORRECT unsigned value —
    // see spec_tests/conformance/m_ice_u64_uint_to_str_unsigned_pos.nv for
    // the full regression coverage of this class.
    ro u64max = u64.MAX
    assert("${u64max}" == "18446744073709551615")
    ro i64min = i64.MIN
    assert("${i64min}" == "-9223372036854775808")
}
