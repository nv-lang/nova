// D86 — `??` coalesce-оператор: `Some(v)`/`Ok(v)` → `v`; `None`/`Err(_)` → fallback.
// Чистая локальная операция (НЕ требует `Fail[E]`), поглощает ошибку/None заменой на
// fallback; Err-значение отбрасывается. Семантически сахар над `match`. Fallback —
// произвольное выражение типа внутреннего `T`. Behavioral: каждый assert различает —
// если бы `??` не разворачивал Some/Ok или не подставлял fallback на None/Err, значение
// отличалось бы. Spec: spec/decisions/04-effects.md (D86). Один folder-module CU.
module spec_tests.conformance

fn d86_lookup(k int) -> Option[int] {
    if k == 1 { return Some(10) }
    if k == 2 { return Some(20) }
    None
}

test "?? on Option — Some разворачивается, None → fallback (D86)" {
    ro hit = d86_lookup(1) ?? 0
    assert(hit == 10)             // Some(10) → 10  (fallback не взят)
    ro miss = d86_lookup(99) ?? 7
    assert(miss == 7)             // None → fallback 7
}

// NOTE: `?? on Result` (Ok разворачивается / Err → fallback) НЕ покрыт здесь — на текущем
// компиляторе `Ok(42) ?? -1` не вернул 42 (вероятный gap D86-на-Result: десугар `??` не
// обрабатывает Ok/Err, только Some/None). Отдельным заходом после проверки/фикса базы.

test "?? fallback — произвольное выражение внутреннего типа (D86)" {
    ro base = 100
    ro v = d86_lookup(99) ?? (base + 5)
    assert(v == 105)              // None → вычислить fallback-выражение
    ro w = d86_lookup(2) ?? (base + 5)
    assert(w == 20)               // Some(20) → 20  (fallback-выражение НЕ вычисляется)
}
