// Plan 173.1 Ф.1 smoke: supervised{} — value-expression.
module spec_tests.conformance
test "supervised trailing value propagates" {
    ro v = supervised {
        42
    }
    assert(v == 42)
}

test "supervised void-form (no trailing) still unit" {
    supervised {
        ro x = 1
        assert(x == 1)
    }
}

test "supervised value after spawn join" {
    // D415: голый mut-захват = E_CONCURRENT_MUT_CAPTURE; аккумулятор — #share-тип.
    mut acc = AtomicInt.new(0)
    ro v = supervised {
        spawn { acc.fetch_add(1) }
        spawn { acc.fetch_add(1) }
        acc.load()
    }
    assert(v == 2)
}

test "supervised nested value" {
    ro v = supervised {
        ro inner = supervised {
            7
        }
        inner + 1
    }
    assert(v == 8)
}
