// D215 + Plan 172.12 A8 — ИМЕНОВАННЫЙ КОРТЕЖ ВНУТРИ ЛИТЕРАЛА МАССИВА.
//
// ЗАЧЕМ ЭТА ФИКСТУРА. Инвариант «элемент-структура не проезжает через
// целочисленное стирание» до сих пор охранялся только двумя модульными
// тестами (`array_lit_named_tuple_box_tests`), которые тыкают приватный
// эмиттер напрямую. Сквозного покрытия не было ни одного: греп по
// `d215_named_tuple_*` не находит ни одного литерала массива. Тесты при этом
// закрепляли СНЯТЫЙ путь — легаси-боксинг `NovaArray_<T>*` через
// `nova_alloc` + `nova_array_push_nova_int`, — который Plan 172.12 A8 убрал
// 2026-07-09: `[]T` с тех пор подпёрт `Vec[T]` (D239, `[]T ≡ Vec[T]`), и
// элемент хранится ПО ЗНАЧЕНИЮ в типизированном буфере.
//
// То есть охранялся механизм, которого больше нет, а тот, что пришёл ему на
// смену, не охранялся ничем. Найдено 2026-08-18 при разборе №723 (наборы
// тестов, которые не гонял никто).
//
// ЧТО ИМЕННО ПРОВЕРЯЕТСЯ: значения переживают укладку в литерал и чтение из
// него. Если элемент снова начнут стирать в `nova_int`, поля вернутся мусором
// или сборка отвалится на Си — и то, и другое поймается здесь, на настоящем
// конвейере, а не на приватном методе эмиттера.
//
// Часть единого модуля-папки `spec_tests.conformance`; префикс D в имени
// разводит с соседями.
module spec_tests.conformance

type A8Vec3(x f64, y f64, z f64)

fn A8Vec3 @sum() -> f64 => @x + @y + @z

test "named tuple survives an array literal: fields read back intact (D215, Plan 172.12 A8)" {
    ro vs = [A8Vec3(1.0, 2.0, 3.0), A8Vec3(4.0, 5.0, 6.0)]

    assert(vs.len() == 2)

    // Поля первого элемента — по одному, чтобы отказ назвал поле.
    assert(vs[0].x == 1.0)
    assert(vs[0].y == 2.0)
    assert(vs[0].z == 3.0)

    // И второго: одиночный элемент прошёл бы даже при сломанном шаге.
    assert(vs[1].x == 4.0)
    assert(vs[1].y == 5.0)
    assert(vs[1].z == 6.0)

    // Метод на элементе, взятом из массива: приёмник обязан быть
    // полноценным значением, а не восстановленным из стёртого целого.
    assert(vs[0].sum() == 6.0)
    assert(vs[1].sum() == 15.0)
}

test "named tuple in an array literal: element copied by value, not aliased (D215)" {
    ro one = A8Vec3(7.0, 8.0, 9.0)
    ro vs = [one, one]

    // Копирование по значению (D215): два элемента независимы и равны
    // источнику. Проверяется именно чтение — записи в элемент здесь нет.
    assert(vs[0].x == 7.0)
    assert(vs[1].z == 9.0)
    assert(one.sum() == 24.0)
}
