// D432 — авто-`@cleanup` для непотреблённых consume-переменных (гибрид C).
// type X consume с ЭФФЕКТ-ЧИСТЫМ @cleanup → аффинный (≤1): непотребление к
// концу скоупа НЕ ошибка, компилятор авто-вставляет @cleanup(outcome) на
// висячих exit-путях. Flow-sensitive: дизармится на return-голом
// идентификаторе и на явном receiver-вызове зарегистрированного
// consume-метода. Spec: spec/decisions/02-types.md D432. Part of the
// SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

type D432Res consume { id int }

fn D432Res consume @cleanup(_outcome ScopeOutcome) -> () {
    ()
}

fn D432Res consume @close() -> () {
    ()
}

fn d432_make(id int) -> D432Res => { id }

// (1) bare consume-let, NEVER explicitly consumed — NOT a D133-not-consumed
// error (auto-cleanup covers it); cleanup runs exactly once.
test "D432: bare consume-let never touched — auto-cleanup at normal exit" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        consume r = d432_make(1)
        ro _x = r.id
    }
    assert(exit_calls == 1)
}

fn d432_return_it(id int) -> D432Res {
    consume r = d432_make(id)
    return r
}

// (2) return-disarm: `r` inside d432_return_it is returned bare — its
// auto-cleanup must NOT fire. The caller's `r2` (never touched) DOES get
// auto-cleaned. If return-disarm were broken we'd see exit_calls == 2.
test "D432: return disarms auto-cleanup on the returning path" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        consume r2 = d432_return_it(2)
        ro _y = r2.id
    }
    assert(exit_calls == 1)
}

// (3) explicit receiver-call `.close()` (a consume-method, NOT `@cleanup`
// itself) as a bare statement disarms auto-cleanup — no double-fire.
test "D432: explicit consume-method call disarms auto-cleanup (no double-fire)" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        consume r = d432_make(3)
        r.close()
    }
    assert(exit_calls == 0)
}

// (4) MaybeConsumed / drop-flag: consumed on ONE branch only.
fn d432_maybe(should_close bool, id int) -> () {
    consume r = d432_make(id)
    if should_close {
        r.close()
    } else {
        ro _x = r.id
    }
}

test "D432: MaybeConsumed drop-flag — closed branch does NOT double-cleanup" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        d432_maybe(true, 4)
    }
    assert(exit_calls == 0)
}

test "D432: MaybeConsumed drop-flag — non-closed branch still auto-cleans" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        d432_maybe(false, 5)
    }
    assert(exit_calls == 1)
}

// (5) LIFO: two auto-cleanup bindings (DISTINCT types so ResourceTrace's
// per-type label lets us observe order) — `b` (declared second) fires first.
type D432LogA consume { tag str }
type D432LogB consume { tag str }

fn D432LogA consume @cleanup(_outcome ScopeOutcome) -> () { () }
fn D432LogB consume @cleanup(_outcome ScopeOutcome) -> () { () }

fn d432_log_a(tag str) -> D432LogA => { tag }
fn d432_log_b(tag str) -> D432LogB => { tag }

test "D432: LIFO order for two auto-cleanup bindings" {
    mut order = ""
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(label, _outcome, _duration_ms, _overrun) -> () {
            order = "${order}${label}"
            return ()
        }
    } {
        consume a = d432_log_a("A")
        consume b = d432_log_b("B")
        ro _p = a.tag
        ro _q = b.tag
    }
    assert(order == "D432LogBD432LogA")
}

// (6) loop: a consume-let declared INSIDE a loop body must be auto-cleaned
// EVERY iteration (not leaked across iterations, not just once).
test "D432: consume-let inside loop body auto-cleans every iteration" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        mut i = 0
        while i < 5 {
            consume r = d432_make(i)
            ro _x = r.id
            i = i + 1
        }
    }
    assert(exit_calls == 5)
}

// (7) throw-path: auto-cleanup still fires when the enclosing scope throws.
type D432Boom { msg str }

fn d432_boom() Fail[D432Boom] -> () {
    throw D432Boom { msg: "boom" }
}

test "D432: auto-cleanup fires on throw-path too" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        with Fail = effect Fail { fail(_m) -> never { interrupt () } } {
            consume r = d432_make(9)
            d432_boom()
        }
    }
    assert(exit_calls == 1)
}

// (8) spawn-closure: a BARE consume-let (no `{ … }` scope-block) whose
// auto-cleanup synthesizes INSIDE a `spawn { … }` closure —
// [M-217-spawn-closure-consume-cleanup-undefined] regression guard. Found
// via `nova build examples/net/echo_server.nv --strict-effects`
// (`consume stream = conn` inside spawn), which surfaced TWO independent
// defects in the same area:
//   (a) method-DCE was pruning the synthesized `Nova_<T>_consume_cleanup`
//       definition (the bare-consume-let form had no `collect_used_names`
//       seed, unlike the block-form `Stmt::ConsumeScope`) while the call
//       site — driven directly by AST, independent of DCE — still linked
//       against it → `undefined symbol Nova_TcpStream_consume_cleanup` at
//       link time in every spawn-closure caller (echo_server/echo_client
//       net+tls). Guarded by the `bare_consume_let_seeds_cleanup_method`
//       Rust unit test in emit_c.rs plus the flagship `nova build
//       --strict-effects` gates (echo_server/echo_client net+tls,
//       aggregator).
//   (b) `emit_spawn`'s own top-level body-statement loop skipped
//       `enter_defer_scope`/`leave_defer_scope` entirely (unlike every
//       OTHER block-emission site — match arms, `if`/`while` bodies,
//       `emit_supervised`'s own body) — a BARE auto-cleanup consume-let
//       placed DIRECTLY at spawn-body top level (no enclosing match/if)
//       never got its `active_var`/`consume_policy` armed at all, so
//       `@cleanup` silently never ran (found via THIS test, which failed
//       at runtime with `exit_calls == 0` even after fix (a) alone).
// `nova test`'s harness has no `fn main`, so reachability-DCE never
// engages for THIS file (see `compute_dead_decls_with`'s `has_main`
// gate) — this test therefore only exercises defect (b) functionally;
// defect (a) is guarded separately as noted above.
test "D432: bare consume-let inside spawn closure auto-cleans exactly once" {
    // Plan 238 Ф.4 (D441 §3): ResourceTrace-хендлер исполняется в файбере
    // ребёнка — AtomicInt вместо mut-счётчика (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut exit_calls = AtomicInt.new(0)
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls.fetch_add(1)
            return ()
        }
    } {
        supervised {
            spawn {
                consume r = d432_make(10)
                ro _x = r.id
            }
        }
    }
    assert(exit_calls.load() == 1)
}

// (9) [M-217-break-continue-loop-boundary-bleed] regression guard: a `break`
// inside a NESTED, trivial `loop { … }` (no `defer`/consume-let of its OWN)
// must NOT prematurely fire an OUTER, still-open auto-cleanup consume-let's
// `@cleanup` — the outer scope has not exited. Found as a follow-up
// regression while verifying the (8) fix above: `enter_defer_scope` early-
// returns (no C boilerplate, no `self.defer_scopes` entry) for a loop body
// with no defer/auto-cleanup-let of its own — a deliberate perf shortcut.
// But `Stmt::Break`'s `emit_early_exit_cleanup(stop_at_loop=true)` walks
// `self.defer_scopes` from the top looking for the NEAREST `is_loop_body`
// marker to stop at; when the loop being broken registered none, the walk
// "overshoots" past the (absent) loop boundary straight into whatever
// ENCLOSING scope is actually on top instead — firing ITS `@cleanup` early.
// Reproducible with NO spawn/parallel-for at all (plain sequential code) —
// a pre-existing gap in the shared break/continue machinery, merely never
// exercised for a spawn/parallel-for body before this wave's (a)+(b) fixes
// (spawn bodies never registered a real auto-cleanup scope prior to fix (b),
// so this path was unreachable via spawn). Real-world trigger:
// `readguard_writeguard_separated.nv`'s "multiple ReadGuards can coexist" —
// `consume rg = rw.read(); loop { … if … { break } … }; rg.unlock()` (a
// CAS-retry loop) double-released the guard (`@cleanup` via the break, THEN
// the manual `.unlock()`) → runtime panic "read_unlock() called without a
// matching read()". Mirrors that shape with a local resource + `exit_calls`
// instead of an RwLock, isolating the codegen defect from the native guard.
test "D432: break inside a nested empty loop must not bleed into an outer auto-cleanup scope" {
    mut exit_calls = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(_label) -> () { return () }
        on_resource_exit(_label, _outcome, _duration_ms, _overrun) -> () {
            exit_calls += 1
            return ()
        }
    } {
        consume r = d432_make(11)
        mut now = 5
        mut old_max = 0
        loop {
            if now <= old_max { break }
            old_max = now
            break
        }
        ro _x = r.id
    }
    assert(exit_calls == 1)
}
