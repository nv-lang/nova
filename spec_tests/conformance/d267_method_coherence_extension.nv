// D267 — Method coherence: extension = да, override = E_METHOD_REDEFINITION.
// Nova не имеет orphan rule: метод на любом типе можно объявить из любого модуля.
// Но переопределение существующего метода (та же сигнатура) → E_METHOD_REDEFINITION.
// Spec: spec/decisions/10-overloading.md D267. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

// 1. Extension method на built-in type с новым именем — нет orphan rule
fn str @d267_exclaim() -> str => "${@}!"

// 2. Extension overload по типу аргумента (D84 axis) — различимые сигнатуры разрешены
fn str @d267_prefixed(tag str) -> str => "[${tag}] ${@}"
fn str @d267_prefixed(n int) -> str => if n > 0 { "[+] ${@}" } else { "[-] ${@}" }

// 3. Extension методы на user type
type D267Counter { value int }
fn D267Counter @d267_incremented() -> D267Counter => { value: @value + 1 }
fn D267Counter @d267_incremented(by int) -> D267Counter => { value: @value + by }
fn D267Counter @d267_is_positive() -> bool => @value > 0

test "extension method on built-in str: no orphan rule (D267)" {
    assert("hello".d267_exclaim() == "hello!")
    assert("".d267_exclaim() == "!")
}

test "extension overload by arg-type on str (D267)" {
    assert("hello".d267_prefixed("warn") == "[warn] hello")
    assert("hello".d267_prefixed(1) == "[+] hello")
    assert("hello".d267_prefixed(-1) == "[-] hello")
}

test "extension methods on user type (D267)" {
    ro c = D267Counter { value: 5 }
    ro c2 = c.d267_incremented()
    assert(c2.value == 6)
    ro c3 = c.d267_incremented(10)
    assert(c3.value == 15)
    assert(c.d267_is_positive() == true)
    ro zero = D267Counter { value: 0 }
    assert(zero.d267_is_positive() == false)
}
