// Plan 123.7.1 T-PROP.1: semantic equivalence — V7.1 caching
// behavior identical to baseline across various input data.

module spec_tests.conformance
type Acc4_2 {
    mut count int
    ro factor int
}

fn Acc4_2 mut @inc_count() -> () {
    @count += 1
}

fn Acc4_2 mut @compute(n int) -> int {
    // Multiple reads/writes pattern.
    mut total = @factor + @factor
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        // ro @factor — D217 cache.
        // mut @count — V7.1 IPA-aware (inc_count writes @count → barrier).
        total = total + @factor + @factor
        @inc_count()
        i += 1
    }
    total
}

fn Acc4_2.new(c int, f int) -> Acc4_2 {
    Acc4_2 { count: c, factor: f }
}

test "various inputs produce correct results" {
    mut a1 = Acc4_2.new(0, 3)
    assert(a1.compute(2) == (3+3) + 2*(3+3))   // 6 + 12 = 18.

    mut a2 = Acc4_2.new(0, 5)
    assert(a2.compute(3) == (5+5) + 3*(5+5))   // 10 + 30 = 40.

    mut a3 = Acc4_2.new(0, 2)
    assert(a3.compute(0) == 2+2)               // 4 (no loop iterations).
}
