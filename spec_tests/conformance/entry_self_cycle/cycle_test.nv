// [M-imports-entry-folder-module-self-cycle-empty-exports] /
// [M-imports-order-dependent-cycle] — POSITIVE (flipped 2026-07-20, see
// `cyc_a.nv`/`cyc_b.nv` for the full history). D291 (07-modules.md)
// explicitly allows cross-module import cycles; this fixture used to encode
// a NEGATIVE expectation (compile MUST fail) that was actually just an
// unfixed instance of the SAME order-dependent cycle-guard bug the
// [M-imports-order-dependent-cycle] wave fixed (fmt_buf<->string_builder,
// Plan 208 Ф.4R Ш1 finding) — `cyc_a`/`cyc_b` is structurally identical (a
// module reached via a direct import, whose own nested import cycles back
// to it) to the fmt_buf-first ordering that used to CODEGEN-FAIL. Now both
// `cyc_a.a_val` (calls `b_val`) and `cyc_b.b_calls_a` (calls `a_val` back
// across the cycle) resolve correctly.
module entry_self_cycle.cycle_test

import ./cyc_a.{a_val}
import ./cyc_b.{b_calls_a}

test "genuine two-way import cycle resolves (D291)" {
    assert(a_val() == 3)
    assert(b_calls_a() == 3)
}
