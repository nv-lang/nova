// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 183 Ф.4: net2-эквивалент plan83_12/tcp_bind_used_port_test.nv —
// проверка, что класс P67-LEGACY ICE («Path call return type unknown for
// method=bind») НЕ воспроизводится на новом слое std/net2. На старом std/net
// тот же bind-путь падает ICE при `nova test` (репро 2026-07-06); на net2 —
// компилируется и проходит.

module spec_tests.conformance
import std.net.{TcpListener, UdpSocket, SocketAddr, real_net}

test "net2: TcpListener bind to already-used port → Err (no P67-LEGACY ICE)" {
    with Net = real_net() {
        match TcpListener.bind(SocketAddr.loopback(0)) {
            Ok(consume lst) => {
                ro port = lst.local_port()
                assert(port > 0)
                // Второй bind на тот же порт → EADDRINUSE.
                match TcpListener.bind(SocketAddr.loopback(port)) {
                    Ok(consume dup) => { dup.close(); assert(false) }
                    Err(_)  => assert(true)
                }
                lst.close()
            }
            Err(_) => assert(false)
        }
    }
}

test "net2: UdpSocket bind to already-used port → Err (no P67-LEGACY ICE)" {
    with Net = real_net() {
        match UdpSocket.bind(SocketAddr.loopback(0)) {
            Ok(consume s1) => {
                ro port = s1.local_port()
                assert(port > 0)
                match UdpSocket.bind(SocketAddr.loopback(port)) {
                    Ok(consume dup) => { dup.close(); assert(false) }
                    Err(_)  => assert(true)
                }
                s1.close()
            }
            Err(_) => assert(false)
        }
    }
}
