// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Plan 110.4.7 (D195 R6) + Plan 173 Ф.5 п.2 (миграция с enter(timeout)
// на watchdog/overrun — D192-ретракт): cross-fiber Application propagation.
// Spawn child fiber sees parent's Application handler via the D80
// effect-snapshot mechanism (TLS effect registry + per-fiber init
// snapshot — Plan 83.4.5.4 + Plan 83.10.4 Ф.3).
//
// Наблюдение ПОВЕДЕНЧЕСКОЕ: parent Application задаёт порог 1ms; child-fiber
// consume-scope с 30ms-cleanup → overrun=true в exit-событии ⇔ Level-2
// порог реально унаследован ребёнком (при Level-3 5000ms overrun был бы
// false). ResourceTrace-хендлер наследуется тем же снапшотом.
//
// Acceptance:
//   A110.4.7.a — child fiber's ConsumeScope inherits parent's
//                Application handler → threshold resolves via
//                inherited handler, not Level 3 fallback.

module spec_tests.conformance
type Res3 {
    ro id int
}

fn Res3.new(id int) -> Res3 => { id }
// 30ms-cleanup: превышает Application-порог 1ms, но НЕ Level-3 5000ms.
fn Res3 consume @cleanup(_outcome ScopeOutcome) -> () {
    (30).to_millis().sleep()
    return ()
}

test "Plan 110.4.7 A110.4.7.a: child fiber inherits Application via D80 snapshot" {
    // Plan 238 Ф.4 (D441 §3): ResourceTrace-хендлер исполняется в файбере
    // ребёнка (spawn-содержащее тело) — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut child_overrun = AtomicBool.new(false)
    with Application = effect Application {
        register_finalizer(_f) -> () {
            return ()
        }
        default_exit_timeout_ms() -> int {
            return 1
        }
    } {
        with ResourceTrace = effect ResourceTrace {
            on_resource_enter(_label) -> () { return () }
            on_resource_exit(_label, _outcome, _duration_ms, overrun) -> () {
                child_overrun.store(overrun)
                return ()
            }
        } {
            // Spawn a child fiber that opens a consume scope —
            // its watchdog threshold must resolve to Application's 1ms
            // через D80 snapshot → 30ms-cleanup = overrun.
            supervised {
                spawn {
                    consume r = Res3.new(1) {
                        ro _ = r.id
                    }
                }
            }
        }
    }
    assert(child_overrun.load() == true)
}
