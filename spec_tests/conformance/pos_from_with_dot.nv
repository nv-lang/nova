// Plan 97 Ф.4 — .from* static-конструктор с leading-точкой (D35) работает.
//
// Регресс-позитив: реализация через `fn Type.from_X` компилируется, вызов
// работает.
//
// [D73/D77 retraction 2026-07-06]: второй тест файла ("Into[Celsius2]
// auto-derive из From[Fahrenheit]") удалён — протоколы From/Into и их
// auto-derive ретрактированы; `.from` остаётся просто конвенцией имени
// конструктора-конверсии (не протокол).
//
// [W_STATIC_CONVERSION, ретракция 2026-07-09]: голый `Type.from(x)` — запрещённая
// «пятая дверь» (nv-coding-style §1а). Канон: `from` легален только под
// содержательным именем концепт-источника (`from_polar`) — переименовано в
// `from_fahrenheit`, D35 leading-dot static-синтаксис по-прежнему тестируется
// тем же вызовом `Type.method(args)`.

module spec_tests.conformance
type Fahrenheit {
    value f64
}

type Celsius2 {
    value f64
}

// Celsius2.from_fahrenheit(Fahrenheit) — реализация через D35 static.
fn Celsius2.from_fahrenheit(f Fahrenheit) -> Celsius2 =>
    { value: (f.value - 32.0) * 5.0 / 9.0 }


test "прямой Celsius2.from_fahrenheit(f) работает" {
    ro f = Fahrenheit { value: 212.0 }
    ro c = Celsius2.from_fahrenheit(f)
    // 212F = 100C
    assert(c.value > 99.9 && c.value < 100.1)
}
