// Plan 97 Ф.4 — .from static-конструктор с leading-точкой (D35) работает.
//
// Регресс-позитив: реализация через `fn Type.from` компилируется, вызов
// работает.
//
// [D73/D77 retraction 2026-07-06]: второй тест файла ("Into[Celsius2]
// auto-derive из From[Fahrenheit]") удалён — протоколы From/Into и их
// auto-derive ретрактированы; `.from` остаётся просто конвенцией имени
// конструктора-конверсии (не протокол).

module spec_tests.conformance
type Fahrenheit {
    value f64
}

type Celsius2 {
    value f64
}

// Celsius2.from(Fahrenheit) — реализация через D35 static.
fn Celsius2.from(f Fahrenheit) -> Celsius2 =>
    { value: (f.value - 32.0) * 5.0 / 9.0 }


test "прямой Celsius2.from(f) работает" {
    ro f = Fahrenheit { value: 212.0 }
    ro c = Celsius2.from(f)
    // 212F = 100C
    assert(c.value > 99.9 && c.value < 100.1)
}
