// Plan 91.13 (Ф.3 conformance smoke): JSON roundtrip — primitives.
//
// Verifies basic encode-then-decode + decode-then-encode equivalence
// for null/bool/num/str values.

// #1638: integer values are built with `JsonValue.int(..)` -- an `F64`
// (`JsonValue.num(1.0)`) now prints as `1.0`, distinct from the integer `1`.
module spec_tests.conformance
import std.encoding.json.{JsonValue, Json}

test "encode null" {
    ro v = JsonValue.null()
    ro encoded = v.to_str()
    assert(encoded == "null")
}

test "encode bool true" {
    ro v = JsonValue.bool(true)
    ro encoded = v.to_str()
    assert(encoded == "true")
}

test "encode bool false" {
    ro v = JsonValue.bool(false)
    ro encoded = v.to_str()
    assert(encoded == "false")
}

test "encode num integer" {
    ro v = JsonValue.int(42)
    ro encoded = v.to_str()
    assert(encoded == "42")
}

test "encode num negative" {
    ro v = JsonValue.int(-17)
    ro encoded = v.to_str()
    assert(encoded == "-17")
}

test "encode str simple" {
    ro v = JsonValue.str("hello")
    ro encoded = v.to_str()
    assert(encoded == "\"hello\"")
}

test "parse null" {
    ro parsed = Json.parse("null")!!
    assert(parsed.is_null())
}

test "parse bool true" {
    ro parsed = Json.parse("true")!!
    assert(parsed.bool() == Some(true))
}

test "parse num int" {
    ro parsed = Json.parse("42")!!
    assert(parsed.num() == Some(42.0))
}

test "parse str simple" {
    ro parsed = Json.parse("\"hello\"")!!
    assert(parsed.str() == Some("hello"))
}

test "roundtrip bool" {
    ro orig = JsonValue.bool(true)
    ro encoded = orig.to_str()
    ro decoded = Json.parse(encoded)!!
    assert(decoded.bool() == Some(true))
}

test "roundtrip num" {
    ro orig = JsonValue.num(123.0)
    ro encoded = orig.to_str()
    ro decoded = Json.parse(encoded)!!
    assert(decoded.num() == Some(123.0))
}

test "roundtrip str" {
    ro orig = JsonValue.str("world")
    ro encoded = orig.to_str()
    ro decoded = Json.parse(encoded)!!
    assert(decoded.str() == Some("world"))
}
