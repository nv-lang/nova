// Plan 123.4 T1.1: @parent.inner accessed 2+ times → chain cached.

module spec_tests.conformance
type Inner2_1 {
    ro value int
}

type Outer3_1 {
    ro inner Inner2_1
    ro mark int
}

fn Outer3_1 @sum_with_chain() -> int {
    // 3 reads of @inner.value (= chain length 2 = "inner.value").
    @inner.value + @inner.value + @inner.value + @mark
}

fn Outer3_1.new(v int, m int) -> Outer3_1 {
    Outer3_1 { inner: Inner2_1 { value: v }, mark: m }
}

test "chain @inner.value cached" {
    ro o = Outer3_1.new(7, 5)
    ro r = o.sum_with_chain()
    // 3*7 + 5 = 26.
    assert(r == 26)
}
