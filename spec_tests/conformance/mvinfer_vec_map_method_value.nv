// [M-method-value-arg-in-generic-combinator-infer] POS: method-level
// type-param `U` inferred from an UNBOUND method-value arg on a DIFFERENT
// generic sum (`Result[T, E] @map[U](fn(T) -> U) -> Result[U, E]`,
// prelude/core.nv) — confirms the fix isn't Option-specific. Uses a
// custom record receiver so the method-value is a genuine concrete
// (non-blanket) declaration (conformance = язык + прелюдия only, no
// std/collections — no `[]T @map`/`@filter` here, see test-conventions.md
// §1).

module spec_tests.conformance

type MvInferPair { value int }
fn MvInferPair.new(v int) -> Self => { value: v }
fn MvInferPair @to_str() -> str => "${@value}"

test "method-value arg infers method-level type-param (Result.map, Ok)" {
    ro r Result[MvInferPair, str] = Ok(MvInferPair.new(9))
    ro mapped = r.map(MvInferPair.@to_str)
    match mapped {
        Ok(v) => assert(v == "9")
        Err(_) => assert(false)
    }
}

test "method-value arg infers method-level type-param (Result.map, Err)" {
    ro r Result[MvInferPair, str] = Err("boom")
    ro mapped = r.map(MvInferPair.@to_str)
    match mapped {
        Ok(_) => assert(false)
        Err(e) => assert(e == "boom")
    }
}
