// D335 — streaming incremental coder: feed(chunk) + read(max_emit) + finish;
// window/bit-leftover/checksum-state сохраняются между вызовами; bounded-per-call;
// EOF-семантика (is_done). Ключевой инвариант: streaming feed-по-1-байту ==
// one-shot байт-в-байт. Spec: spec/decisions/04-effects.md (D335).

module spec_tests.conformance

import std.encoding.compress.{inflate, Inflater, GzipReader}

fn d335_hex(s str) -> []u8 {
    ro chars = s.to_bytes()
    mut out []u8 = []u8.with_capacity(chars.len() / 2)
    mut i = 0
    while i + 1 < chars.len() {
        ro hi = d335_hv(chars[i])
        ro lo = d335_hv(chars[i + 1])
        out.push(((hi << 4) | lo) as u8)
        i = i + 2
    }
    out
}

fn d335_hv(c u8) -> int {
    ro n = c as int
    if n >= 48 && n <= 57 { n - 48 }
    else if n >= 97 && n <= 102 { n - 97 + 10 }
    else { 0 }
}

test "D335: streaming feed-by-1-byte + bounded read(8) == one-shot" {
    ro comp = d335_hex("2bc94855282ccd4cce56482aca2fcf5348cbaf50c82acd2d2856c82f4b2d5228c94855c849acaa5448c94fd703f346158f2a1e555c4e4dc500")
    ro oneshot = inflate(comp, 4096)!!
    mut inf = Inflater.new(4096)
    mut out []u8 = []u8.with_capacity(900)
    for idx in 0..comp.len() {
        mut one []u8 = []u8.with_capacity(1)
        one.push(comp[idx])
        inf.feed(one)!!
        loop {
            ro c = inf.read(8)!!
            if c.len() > 0 {
                assert(c.len() <= 8)             // bounded-per-call
                out.append(c)
            } else { break }
        }
    }
    inf.finish()!!
    loop {
        ro c = inf.read(8)!!
        if c.len() > 0 { out.append(c) } else { break }
    }
    assert(out == oneshot)
    assert(inf.is_done())
}

test "D335: GzipReader streaming framing (feed/read/finish)" {
    ro comp = d335_hex("1f8b08000000000000fff348cdc9c9d751707175f3710c71550400acccee010f000000")
    mut gr = GzipReader.new(1048576)
    gr.feed(comp)!!
    gr.finish()!!
    mut out []u8 = []u8.with_capacity(16)
    loop {
        ro c = gr.read(1024)!!
        if c.len() > 0 { out.append(c) } else { break }
    }
    assert(out == "Hello, DEFLATE!".to_bytes())
    assert(gr.is_done())
}
