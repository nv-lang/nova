//
// Plan 96 Ф.4 — негатив: arr[-1..3] → panic (D-neg-panic, не Python-wrap).
// Plan 194 Ф.3 (vrange-роутинг): `v[a..b]` теперь дисптачится в `.nv`
// `Vec[T] @index(Range)` (slice.nv) — паника оттуда, текст
// `Vec: slice range out of bounds` (было codegen-интринсик
// `Vec: slice [a..b] out of bounds for length N`).

module spec_tests.conformance
test "neg slice a negative" panics "requires failed" {
    mut arr = [10, 20, 30, 40, 50]
    ro _ = arr[-1..3]
}
