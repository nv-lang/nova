// Plan 88 Ф.3.1 — static-метод `T.new` (user-defined через protocol)
// на type-параметре. Обобщённый путь, не спец-кейс под один метод `from`.
//
// [D73/D77 retraction 2026-07-06]: вторая часть файла (`T.try_from` через
// `TryFrom[int, str]` bound) удалена — протокол `TryFrom` ретрактирован,
// покрытие generic-bound static-dispatch остаётся через `Buildable` ниже.

module conformance.static_methods
// --- T.new() — user-defined static-метод через protocol ---
type Buildable protocol { @new() -> Self }

type Counter { n int }
fn Counter.new() -> Counter => { n: 0 }

type Score { points int }
fn Score.new() -> Score => { points: 100 }

fn fresh[T Buildable]() -> T => T.new()


test "T.new() static на typevar — Counter" {
    ro c = fresh[Counter]()
    assert(c.n == 0)
}

test "T.new() static на typevar — Score" {
    ro s = fresh[Score]()
    assert(s.points == 100)
}
