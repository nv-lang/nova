// D402 — ШИРИНА (знаковость) ВОЗВРАТА ЗАМЫКАНИЯ. Поверхность: closure-return-sized.
// `uint` UNSIGNED (≠ signed `int`, D130). Когда замыкание `|v| <uint-выражение>`
// сохраняется в UN-аннотированный let-биндинг и затем вызывается, ширина/знаковость
// его ВОЗВРАТА должна сохраниться (`uint`). РАСПОЗНАЮЩАЯ форма: результат вызова
// привязывается БЕЗ аннотации (`ro got = f(big)`) — он наследует INFERRED-тип вызова.
//
// Codegen-путь (compiler-codegen/src/codegen/emit_c.rs), почему это БАГ-детектор:
//   • let-bound light-closure без fn-аннотации регистрируется в `fn_param_sigs`
//     с ДЕФОЛТАМИ `(["nova_int"], "nova_int")` (~:18935-18936) — `uint` теряется.
//   • Литерал замыкания `emit_lambda(ctx=None, ann=None)`: параметр дефолтит
//     `nova_int` (~:33699), тело `v` инферит `nova_int`; clos_struct = `NovaClos_ii`
//     (~:33989), тело-fn возвращает signed `nova_int`.
//   • Вызов `f(big)` → `clos_call_macro(["nova_int"],"nova_int")` = `NOVA_CLOS_CALL_ii`
//     (nova_rt.h: `nova_fn_ii` → `nova_int` SIGNED).
//   • `ro got = f(big)` инферит тип через `fn_param_sigs["f"].ret = "nova_int"`
//     (~:38251) ⇒ `got` объявлен ЗНАКОВЫМ `nova_int`.
// Биты `0x8000000000000000` (2^63) round-trip'ятся (uint==intptr на 64-bit), НО
// `got` знаковый ⇒ `got > 100` — ЗНАКОВОЕ сравнение ⇒ 2^63 читается НЕГАТИВОМ ⇒
// assert ложь (RUN-FAIL). Корректный un-collapsed `uint`-возврат остаётся
// положительным. Контроль (тест 3): closure-full с явным `-> uint` НЕ коллапсит.
// Spec: spec/decisions/02-types.md (D130/uint-unsigned). Один folder-module CU
// `spec_tests.conformance`; все top-level имена D402-prefixed во избежание клэша.
module conformance.d402_closure_return_width

// HOF-контроль: declared `fn(uint) -> uint` param даёт правильный контекст
// (этот путь ширину СОХРАНЯЕТ — используется как позитивный контраст в тесте 3).
fn d402w_apply(big uint, f fn(uint) -> uint) -> uint => f(big)

test "let-bound light closure: возврат должен остаться UNSIGNED, не signed-collapse (D402)" {
    ro big uint = 0x8000000000000000   // 2^63 — старший бит; как signed int64 это НЕГАТИВ
    ro f = |v| v                        // light closure, БЕЗ fn-аннотации
    ro got = f(big)                     // UN-аннотирован: наследует inferred-тип вызова
    assert(got > 100)                   // uint: 2^63 > 100 = true ; signed-collapse → negative → FAIL
    assert(!(got < 0))                  // uint никогда не < 0 ; signed-collapse → 2^63<0 true → FAIL
}

test "let-bound light closure с uint-арифметикой в теле: высокий бит выживает (D402)" {
    ro base uint = 0x8000000000000001   // 2^63 + 1
    ro g = |v| v                         // тождество; ширина возврата = ширина uint-входа
    ro out = g(base)                     // UN-аннотирован
    assert(out > 1000)                  // unsigned: огромное положительное ; signed → negative → FAIL
    assert(out != 0)                    // ненулевое в любом случае (sanity)
}

// === Контроль: явно типизированный closure-full `-> uint` СОХРАНЯЕТ ширину (D402) ===
// Тот же 2^63, но через HOF c declared `fn(uint) -> uint` контекстом — здесь
// возврат НЕ коллапсит; ассерт распознаёт корректное unsigned-поведение.
test "control: closure через declared `fn(uint)->uint` HOF сохраняет unsigned-возврат (D402)" {
    ro big uint = 0x8000000000000000
    ro got = d402w_apply(big, |v| v)    // ctx из declared param-sig: uint -> uint
    assert(got > 100)                   // должно быть unsigned-положительным
    assert(!(got < 0))
}
