// Plan 123.4 T1.4: chain inside loop body — composition с D218 LICM
// (LICM hoists single-field @F, V4 chain caches the deeper path).

module spec_tests.conformance
type Holder3_1 {
    ro inner Holder_Inner
}

priv(file) type Holder_Inner {
    ro value int
}

fn Holder3_1 @loop_sum(n int) -> int {
    mut total = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        total = total + @inner.value + @inner.value
        i += 1
    }
    total + @inner.value
}

fn Holder3_1.new(v int) -> Holder3_1 {
    Holder3_1 { inner: Holder_Inner { value: v } }
}

test "chain inside loop body cached" {
    ro h = Holder3_1.new(4)
    ro r = h.loop_sum(3)
    // 3 × 8 + 4 = 28.
    assert(r == 28)
}
