// D407 — USER sum-type payload must keep its EXACT primitive width/sign through the full
// construct→match round-trip, distinct from the built-in Result/Option payload path (d85/d126).
// Surface: `type d407T | V(uint) | W(u8)` — a non-generic sum whose variant carries a sized,
// UNSIGNED payload. Codegen path read (compiler-codegen/src/codegen/emit_c.rs):
//   - emit_sum_type (:10937) lowers the field via type_ref_to_c(uint) → primitive_name_to_c
//     = "nova_uint" (NOT collapsed); the union field is declared `nova_uint _0;` and the schema
//     stores ["nova_uint"]. The constructor is `nova_make_d407T_V(nova_uint _0)`.
//   - collect_pattern_inner_bindings (:30686) types the match binding `v` from the registry
//     field_c_types ("nova_uint"), so emit_match result_ty = nova_uint and the UNANNOTATED
//     `ro got = match …` inherits nova_uint (NOT signed nova_int).
//   - pattern_bind_typed (:32877) reads the same schema → `nova_uint v = scr->payload.V._0;`.
// DISCRIMINATING: `ro got` is UNANNOTATED, so it inherits the call's INFERRED type. If the
// sized payload silently collapsed to signed `nova_int`, the unsigned high-bit `0x8000000000000000`
// (2^63) would read NEGATIVE → `got > 100` is false (RUN-FAIL); `W(200)` (>i8 max 127) checks the
// 8-bit unsigned field likewise. Each assert distinguishes collapse from correctness.
// Spec: spec/decisions/02-types.md (named-priority uint≠int, u8≠i8≠int). One folder-module
// `spec_tests.conformance`; all top-level names D407-prefixed to avoid CU collisions.
module spec_tests.conformance

type d407T enum
    | d407V(uint)
    | d407W(u8)

// Unannotated-extracting helpers: the match-result type is INFERRED from the bound payload,
// so a collapse to signed `nova_int` would be observable at the `ro got` binding below.
fn d407_extract_uint(d d407T) -> uint => match d {
    d407V(v) => v
    d407W(_) => 1
}

fn d407_extract_u8(d d407T) -> u8 => match d {
    d407W(w) => w
    d407V(_) => 0
}

test "user sum payload keeps uint width: 2^63 stays unsigned-positive (D407)" {
    ro d = d407V(0x8000000000000000)   // 2^63 — high bit set; as signed int64 this is NEGATIVE
    ro got = d407_extract_uint(d)      // UNANNOTATED: inherits the call's inferred (uint) type
    assert(got > 100)                  // uint: 2^63 > 100 = true ; signed collapse → negative → FAIL
}

test "user sum payload keeps u8 identity: 200 not signed/narrowed (D407)" {
    ro d = d407W(200)                  // 200 fits u8, exceeds i8 max (127)
    ro got = d407_extract_u8(d)        // UNANNOTATED: inherits inferred u8 type
    assert(got == 200)                 // exact value preserved through construct+match
    assert(got > 100)                  // unsigned: 200 > 100 = true (signed i8 200 would be -56)
}

test "match extraction routes the right variant; uint payload round-trips (D407)" {
    ro big = d407V(0x8000000000000000)
    ro small = d407V(42)
    assert(d407_extract_uint(big) > 100)   // 2^63 unsigned-positive
    assert(d407_extract_uint(small) == 42) // ordinary value round-trips
    // direct inline match on a freshly-constructed value (no helper indirection):
    ro inl = match d407V(0x8000000000000000) {
        d407V(v) => v                       // UNANNOTATED bind v : uint
        d407W(_) => 0
    }
    assert(inl > 100)                    // signed collapse → negative → FAIL
}
