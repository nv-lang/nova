// №513 (D79-амендмент 2026-08-09): bare `Channel.new` (no `[T]`) больше не
// компилируется вообще (`E_CHANNEL_NEW_BARE`) — first-send-inference-
// модель этого файла (Plan 221.1 №286, window p286, 2026-08-04:
// `seed_channel_bare_send_hints`) отменена, канон — явный `Channel[T].new`.
//
// История (сохранена для контекста): p-chan tracked `T` end-to-end ONLY
// when declared explicitly (turbofish/annotation) — a bare form left `T`
// permanently untracked, and an untyped channel's erased `recv()` result
// let `.method()` calls through to the legacy name-only `method_receivers`
// codegen fallback, so a co-present unrelated type sharing a method name
// could silently win (№286 class). This file's own `.len()` call is
// deliberately placed in the SAME compile-unit as `d412d_embed_dir.nv`
// (both `module spec_tests.conformance` — the top-level flat-file group
// compiles as one CU) whose `EmbeddedDir.len()` is the exact collision
// partner that caused the original №286 finding — see
// `docs/plans/repros/p286-bare-channel-erased/bare_len_probe.nv` for the
// isolated RED-before/GREEN-after repro. №513 closes the SAME collision
// risk more directly: no untyped channel can exist at all, so the erased-
// recv path this file used to probe is now unreachable by construction.
// Kept as a regression guard using the canonical explicit form.

module spec_tests.conformance

test "Channel[T].new: explicit T resolves .len() by the REAL type, not by name" {
    ro (tx, rx) = Channel[[]int].new(2)
    mut v []int = []int.new()
    v.push(10)
    v.push(20)
    v.push(30)
    tx.send(v)
    ro got = rx.recv()
    match got {
        Some(vv) => { assert(vv.len() == 3) }
        None => { assert(false) }
    }
    tx.close()
}
