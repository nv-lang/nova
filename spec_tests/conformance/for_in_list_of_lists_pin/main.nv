// EXPECT_STDOUT list-of-lists-forin ok
// Pin (crew-harness spikes/env item 52): `for item in [["a"], ["b", "c"]]` —
// a for over a BARE array literal whose items are themselves arrays.
// Oracle 0.1.0 and main failed with CODEGEN-FAIL "for-in: cannot resolve
// iterator type for expression of C-type 'nova_unit'" (same root as items
// 33/36: the literal's Vec mono instance is never registered, so the
// implicit `.iter()` return inference collapses to nova_unit). Fixed in
// emit_c.rs [M-for-in-array-literal-vec].
module for_in_list_of_lists_pin.main

fn count(items []str) -> int => items.len()

fn main() Io -> () {
    mut total = 0
    for item in [["a"], ["b", "c"]] { total += count(item) }
    if total == 3 {
        println("list-of-lists-forin ok")
    }
}
