// EXPECT_COMPILE_ERROR plus
//
// Дверь ретрактированного оператора закрыта и под именем метода: `s.plus(t)`
// больше не существует (реестр 221.1 №1010).
//
// Оператор `+` для `str` владелец ретрактировал 2026-07-21
// (`spec/decisions/02-types.md`: «string-конкатенация через `+` больше не
// существует в языке»), и запрет держался чекером — `[E_STR_CONCAT_PLUS]`,
// негатив `str_concat_plus_neg.nv` рядом. Но в std оставался
// `export fn str @plus(other str) -> str => @concat(other)`: та же операция под
// именем метода, ЭКСПОРТИРОВАННАЯ. Вызывающих у неё было ноль, а кодоген для
// `str + str` и без неё выпускал `Nova_str_method_concat` напрямую — то есть
// метод не был нужен даже компилятору. На теге он уехал бы в публичное API 0.1
// обещанием совместимости, противоречащим собственной ретракции.
//
// Эта фикстура — замок на дверь: она краснеет, если метод вернут.
// ЧЕСТНАЯ ГРАНИЦА: маркер ловит слово `plus` в тексте отказа, а не код
// диагностики, потому что отказ приходит общим путём «нет такого метода» и
// замену (`@concat`) он НЕ называет. Диагностика с именем замены — отдельная
// работа, и её отсутствие здесь названо, а не подразумевается.
//
// Канон остаётся один: `s.concat(t)` либо интерполяция `"${a}${b}"`.
module neg.str_plus_method_gone_neg

fn join(a str, b str) -> str {
    // nova:expect plus -- метод снят вместе с оператором (№1010); канон — `a.concat(b)`
    a.plus(b)
}

fn main() Io -> () => print(join("x", "y"))
