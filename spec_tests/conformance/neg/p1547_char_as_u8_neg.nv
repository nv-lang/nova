// before any C (the table used to live in the emitter, and this cell passed).
// The positive half: spec_tests/conformance/standalone/p1547_as_d54_legal.nv.
module neg.p1547_char_as_u8_neg

fn main() Io -> () {
    ro c = 'B'
    // nova:expect E_AS_CAST_FORBIDDEN -- a `char` VALUE converts only to i32/u32/int/uint/i64/u64 (D54 amendment 2026-10-01 p.2)
    println((c as u8).to_str())
}
