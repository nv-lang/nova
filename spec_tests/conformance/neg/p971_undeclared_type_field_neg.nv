// EXPECT_COMPILE_ERROR E_UNKNOWN_TYPE
//
// Registry 221.1 #971: an undeclared type name in a record FIELD type. Before the fix the
// checker turned any unknown name into an opaque nominal type and every check
// in that position went quiet (`check` PASS). The legal forms are pinned by
// `standalone/p971_visible_type_names_pos`.
module neg.p971_undeclared_type_field_neg

// nova:expect E_UNKNOWN_TYPE -- `Nmbr` is declared nowhere; the field type used to be an opaque hole
type P971Box { v Nmbr }

fn main() Io -> () {
    println(1)
}
