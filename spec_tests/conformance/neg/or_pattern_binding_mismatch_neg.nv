// EXPECT_COMPILE_ERROR E_OR_PATTERN_BINDING_MISMATCH
//
// Альтернативы дизъюнкции обязаны вводить ОДИН набор биндеров (реестр 221.1
// №1009, блокер тега; НАЙДЕНО ОХОТНИКОМ 2026-09-07, трек oracle).
//
// До этого правила чекер принимал такой арм, а эмиттер печатал биндеры по
// разметке ПЕРВОЙ альтернативы (`pattern_bind_typed`, арм `Pattern::Or`, где
// стояло признание, что подмножество этого не сверяет; правило
// `E_OR_PATTERN_BINDING_MISMATCH` и эта фикстура сделали его неактуальным).
// На значении `Q(7)` тело читало
// `b`, которого вариант `Q` не вводит ВООБЩЕ, — и печатало `7`, взятое из
// чужого места union'а. Вторая проба охоты, со строкой в первом варианте,
// печатала ПУСТУЮ СТРОКУ: из int-варианта читался указатель, которого туда
// никто не клал. Ни паники, ни предупреждения, `exit 0`.
//
// Корпус этого не ловил, потому что в нём нет арма с РАЗНОЙ арностью
// альтернатив — класс №989: зелёный корпус доказывает отсутствие ФОРМЫ, а не
// отсутствие дефекта. Эта фикстура и есть недостающая форма.
// Имя типа НЕ `T`: односимвольное имя сталкивается с генерик-параметром std
// в том же CU (`Option[Result[T, E]] @transpose`, `std/src/prelude/core.nv:249`)
// и даёт `[E_RECV_GENERIC_SHADOWS_TYPE]` — замер 2026-09-07, стоил прогона.
module neg.or_pattern_binding_mismatch_neg

type OrPair enum P(int, int) | Q(int)

fn probe(t OrPair) -> int {
    match t {
        // nova:expect E_OR_PATTERN_BINDING_MISMATCH -- `Q` не вводит `b`, а тело его читает
        P(a, b) | Q(a) => a + b
    }
}

fn main() Io -> () => print("${probe(Q(7))}")
