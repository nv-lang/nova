// EXPECT_COMPILE_ERROR D188-not-consumable
//
// Plan 110.1.2 (D188 / D196): type WITHOUT `cleanup` method не может быть
// использован как init для `consume X = init { body }` scope-block.
// Type-checker emits [D188-not-consumable] error с suggestion как
// implement Cleanup.

module neg.neg_consume_not_consumable
// NotConsumable — record без cleanup method.
type NotConsumable {
    ro value int
}

fn NotConsumable.new(value int) -> NotConsumable => { value }

fn bad_use() -> int {
    // ❌ NotConsumable не implements Cleanup[E] — нет cleanup method.
    consume r = NotConsumable.new(5) {
        return r.value               // No. 714: the block is a statement
    }
}
