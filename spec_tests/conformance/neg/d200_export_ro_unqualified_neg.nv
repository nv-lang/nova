// EXPECT_COMPILE_ERROR E_EXPORT_RO_UNQUALIFIED
//
// Реестр 221.1 №701 (а), решение владельца 2026-09-18: голый
// `export ro NAME = …` на уровне модуля — НЕ форма языка.
//
// ЧЕМ ЭТА КЛЕТКА ОТЛИЧАЕТСЯ ОТ «ПРОСТО ЗАПРЕТА». Отвергается СОЧЕТАНИЕ
// `export` + голое имя, а не модульный `ro` сам по себе: приватный модульный
// `ro` законен и живёт в std десятками. Поэтому рядом стоит позитивная клетка
// `standalone/d200_export_ro_private_ok.nv` — без неё запрет был бы неотличим
// от «модульный `ro` сломали вообще».
//
// ИНИЦИАЛИЗАТОР ЗДЕСЬ — РАНТАЙМНЫЙ, И ЭТО НЕ СЛУЧАЙНОСТЬ. С литералом
// (`= 7`) клетка краснела бы и у компилятора БЕЗ этого запрета — сработало бы
// чужое правило строгого раздела `const`/`ro` (E_RO_FOR_CONSTEXPR_PREFER_CONST,
// D199). Клетка обязана судить СВОЙ предмет, а не соседний.
//
// ЗАМЕР, ИЗ-ЗА КОТОРОГО ФОРМА ОТВЕРГАЕТСЯ, А НЕ ЧИНИТСЯ: слово `export` перед
// модульным `ro` считывалось парсером и терялось. Владелец модуля собирался
// МОЛЧА, а импортёр падал с `undefined identifier` — то есть отказ приходил
// чужому коду и в другом файле. Канон по D200-амендменту — квалифицированная
// форма `export ro Type.NAME Тип = …`; голой спека не описывает вовсе.
module neg.d200_export_ro_unqualified_neg

fn compute() -> int => 7

// nova:expect E_EXPORT_RO_UNQUALIFIED -- голое имя под `export`; канон — `export ro Type.NAME Тип = …` (D200-амендмент)
export ro universe int = compute()

fn main() -> () {
    ro _ = universe
}
