// Plan 181 (D347) R1 — после rebind со сменой типа старая версия недоступна.
// `ro v = 42` (int); `ro v = "s"` (str) — теперь `v` это str. Обращение к `v`
// как к int ниже по тексту невозможно: имя резолвится в НОВЫЙ (str) биндинг.
//
// EXPECT_COMPILE_ERROR E7301

module neg.rebind_type_change_stale_neg

test "should not compile" {
    ro v = 42
    ro v = "changed"
    ro bad int = v + 1      // v — str; арифметика/присвоение int невозможны
    assert(bad == 43)
}
