// EXPECT_COMPILE_ERROR E_CHAR_RAW_CONTROL
//
// D478 §3, САМАЯ ВАЖНАЯ ИЗ ТРЁХ: литерал с сырым переводом строки внутри —
// он пересекает строку исходника. Именно эту форму носитель обхода в novac
// называет причиной сломанного `is_space`: собранный бинарь зациклился на
// выделении памяти до смерти Boehm («Too many heap sections»).
//
// ФАЙЛ ЗАЩИЩЁН ОТ НОРМАЛИЗАЦИИ EOL (`.gitattributes` рядом, `-text`). Без
// этого git на выкладке превратил бы LF в CRLF, и клетка проверяла бы уже
// ДРУГОЙ байт — то есть тихо сменила бы предмет.
module neg.d478_char_raw_lf_neg
fn main() -> () {
    // nova:expect E_CHAR_RAW_CONTROL -- литерал ниже разорван настоящим переводом строки; канон — `'\n'`
    ro c = '
'
    ro _ = c as int
}
