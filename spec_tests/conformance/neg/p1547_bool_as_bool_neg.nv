module neg.p1547_bool_as_bool_neg

fn main() Io -> () {
    // nova:expect E_AS_CAST_NO_RULE -- an identity cast of a `bool` has no rule in D54 (`bool` converts to a number only)
    println((true as bool).to_str())
}
