// EXPECT_COMPILE_ERROR E_NEG_UNSIGNED
// Regression for registry 221.1 #1547: D54 `as`, cell `neg_unsigned` -- refused by `nova check`,
// before any C (the table used to live in the emitter, and this cell passed).
// The positive half: spec_tests/conformance/standalone/p1547_as_d54_legal.nv.
module neg.p1547_neg_unsigned_neg

fn main() Io -> () {
    ro f = 2
    // nova:expect E_NEG_UNSIGNED -- `-f as u8` is `-(f as u8)` (D54 amendment 2026-10-01 p.3), and unary minus is for signed types only (D405)
    println((-f as u8).to_str())
}
