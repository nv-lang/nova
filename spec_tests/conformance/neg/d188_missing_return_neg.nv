// EXPECT_COMPILE_ERROR E_MISSING_RETURN
//
// Реестр 221.1 №714, K1. Функция объявляет не-unit возврат, а её блочное тело
// заканчивается STATEMENT'ом — значения нет.
//
// ЧТО БЫЛО ДО ЭТОЙ ФИКСТУРЫ. Ровно эта форма проходила `nova check` И
// `nova build` зелёными, а на исполнении возвращала НЕИНИЦИАЛИЗИРОВАННУЮ
// память: три запуска носителя напечатали 2215532322800, 2051552337904,
// 2410814857200 вместо 41. Кодоген доходил до последней ветки
// `emit_block_stmts` и выпускал СИ-функцию вообще без `return` — вызывающий
// читал регистр. Зеркальная проверка (`E_MISSING_RETURN_TYPE`: тело есть,
// аннотации нет) существовала давно; этой половины не было вовсе.
//
// ПОЧЕМУ ПРАВИЛО ОБЩЕЕ, А НЕ «ПРО consume». Биндинг-форма consume-блока — лишь
// одна из statement-форм: `ro x = 1`, присваивание и пустое тело приводят ровно
// в ту же ветку эмиттера. Радиус измерен по всему корпусу перед посадкой: узкое
// и общее правило отвергают ОДНИ И ТЕ ЖЕ места, значит общее не стоит ничего
// сверх — и закрывает четыре двери вместо одной.
//
// ЧТО ЗАКОННО И ЗДЕСЬ НЕ ЛОВИТСЯ (см. парный позитив
// d188_missing_return_pos.nv): `return` изнутри тела блока — очистка при этом
// отрабатывает; хвостовое выражение после блока; re-consume форма
// `consume X { body }`, которая по D188-амендменту Plan 201 ЕСТЬ выражение;
// расходящееся тело (`throw` в хвосте); метод с `-> @` (D409).
module neg.d188_missing_return_neg

type ResM consume { id int }

fn ResM consume @cleanup(_o ScopeOutcome) -> () => ()

fn mk() -> ResM => { id: 1 }

// Биндинг-форма consume-блока в хвосте не-unit функции: значение блока —
// unit (разворачивание D188), возвращать нечего — а до этой проверки
// здесь выпускалась СИ-функция без `return` вовсе.
// nova:expect E_MISSING_RETURN -- consume-блок в хвосте не даёт значения
fn tail_consume_block() -> int {
    consume h = mk() {
        40 + h.id
    }
}

// Та же дыра без всякого consume: тело кончается обычным биндингом —
// именно поэтому правило общее, а не «про consume».
// nova:expect E_MISSING_RETURN -- биндинг в хвосте не даёт значения
fn tail_binding() -> int {
    ro x = 41
}

test "No. 714: a non-unit fn whose body ends in a statement is refused" {
    // Компилироваться не должно; тело теста не исполняется.
    assert(true)
}
