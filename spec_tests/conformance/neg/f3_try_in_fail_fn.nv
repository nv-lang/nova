// EXPECT_COMPILE_ERROR E_TRY_IN_FAIL_FN
//
// Plan 173 Ф.1 (#3 / Plan 174.2 / D85): `?` строго return-only. Свободный `?`
// пробрасывает ЗНАЧЕНИЕМ (return Err/None) — осмыслен только в Result/Option-fn.
// Здесь enclosing fn возвращает `int` через Fail-эффект (не Result/Option), а
// `get()?` — свободный `?` → `[E_TRY_IN_FAIL_FN]`. Замена: `!!` или `throw`.

module neg.f3_try_in_fail_fn
type WErr { msg str }

fn get() -> Result {
    Ok(5)
}

fn use_it() Fail[WErr] -> int {
    ro v = get()?                                // ❌ [E_TRY_IN_FAIL_FN]
    v + 1
}
