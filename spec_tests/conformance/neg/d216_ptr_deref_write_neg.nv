// Plan 174.5 Ф.3 (retraction, §3/§9, D216 amend) — `*p = v` deref WRITE on a
// raw pointer is retired. Use `p.write(v)`.
//
// EXPECT_COMPILE_ERROR E_POINTER_OP_USE_METHOD

module neg.d216_ptr_deref_write_neg

test "rejects `*p = v` deref write" {
    mut x int = 1
    unsafe {
        ro p = &x
        *p = 42
    }
    assert(x == 42)
}
