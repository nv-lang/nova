module neg.fiber_unsafe_arg_transitive_neg

fn p238f3_helper(g fn() -> ()) {
    supervised {
        spawn {
            g()
        }
    }
}

fn p238f3_middleware(f fn() -> ()) {
    p238f3_helper(f)
}

fn main() {
    mut acc = Vec[int].new()
    ro push = || { acc.push(1) }
    p238f3_middleware(push)
}
