// EXPECT_COMPILE_ERROR E_CONSUME_KEYWORD_MISSING
//
// №325 Ш.2 (D156-амендмент 2026-08-04, plan 246 step B): the Ш.0 barrier
// that used to fire here (`E_CONSUME_IN_STD_COLLECTION`, a hardcoded
// 8-name std-collection list) is REMOVED — replaced by the general rule
// "a generic container inherits linearity from its element" (works for
// std AND user containers alike). `Vec[P325TwoOwnersRes]` is must-consume
// because `P325TwoOwnersRes` is, so `mut v = …` is now the error itself
// (D180: must-consume RHS requires `consume v = …`) — caught before the
// original two-live-owners scenario (`v.push(r)` leaving `r` separately
// live while a copy also sits in `v`) is even reached. `push` itself still
// doesn't take ownership of its argument (that remains plan 246's later,
// blocked-on-mangling work, №309/№317) — this window only closes the
// container-obligation gap, not per-element push ownership-transfer.

module neg.consume_collection_vec_push_two_owners_neg

type P325TwoOwnersRes consume { x int }

fn P325TwoOwnersRes consume @into_finish() -> int { self.x }

test "container of a must-consume element requires `consume` on its own binding" {
    mut v = Vec[P325TwoOwnersRes].new()
    consume r = P325TwoOwnersRes { x: 1 }
    v.push(r)
    assert(r.into_finish() == 1)
}
