// The positive half: spec_tests/conformance/standalone/p1547_as_d54_legal.nv.
module neg.p1547_char_as_i16_neg

fn main() Io -> () {
    ro c = 'B'
    // nova:expect E_AS_CAST_FORBIDDEN -- a `char` VALUE into a narrow integer may not fit (D54 amendment 2026-10-01 p.2)
    println((c as i16).to_str())
}
