// EXPECT_COMPILE_ERROR [E_CONCURRENT_MUT_CAPTURE]
//
// РЕГРЕСС НА НАСТОЯЩИЙ ДЕФЕКТ, а не на форму из головы: эта фикстура
// повторяет `BackgroundTasks` из nova-polaris, где гонка жила с плана
// 222.16 и была вскрыта расширением энфорса (№289, окно p-s1a2,
// 2026-08-03).
//
// Форма отличается от пяти фикстур `field_sink_call_*` тем, что замыкание
// попадает в поле не присваиванием и не литералом, а МЕТОДОМ-накопителем
// (`@add`), поле — ВЕКТОР замыканий, а исполнение идёт обходом этого
// вектора внутри `spawn`. Ни одна из тех пяти такой формы не закрепляла
// (проверено грепом при приёмке), поэтому дефект мог вернуться незамеченным.
//
// Что здесь неверно: `order` — внешняя `mut`-привязка, захваченная лямбдой
// по ссылке; лямбда уезжает в дочерний файбер и мутирует `order`
// одновременно с родителем. Под M:N это гонка данных по построению.
// Легальные пути (D415 §2): `#share`-тип под замком (как `OrderLog` в
// полярисе после фикса), `consume`-передача владения, либо `ro`-захват.

module neg.field_sink_call_task_queue_neg

type TaskQueueSink {
    items []fn() -> ()
}

fn TaskQueueSink mut @add(f fn() -> ()) -> () {
    @items.push(f)
}

fn TaskQueueSink @drain() -> () {
    supervised {
        for t in @items {
            spawn { t() }
        }
    }
}

test "mut-захват уезжает в файбер через метод-накопитель и вектор замыканий" {
    mut order = Vec[int].new()
    mut queue = TaskQueueSink { items: Vec[fn() -> ()].new() }
    queue.add(|| { order.push(1) })
    queue.drain()
    assert(order.len() >= 0)
}
