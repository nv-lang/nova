// Plan 183 Ф.4 followup — [M-183-int-to-str-module-method-collision] NEGATIVE.
//
// EXPECT_COMPILE_ERROR E_UNKNOWN_METHOD
//
// `x.to_str()` where `x` is an int derived from an effect-op result
// (`Clock.tick() -> int`), in a module that ALSO declares `NetErr @to_str`.
// int owns no `to_str`; the checker must reject this with a clean
// [E_UNKNOWN_METHOD] instead of silently letting codegen coarse-by-name
// mis-dispatch the int to `Nova_NetErr_method_to_str` (int-as-enum-pointer SEGV).
// Regression guard: before the fix the effect-op result was UNTYPED in the
// checker scope, so this call slipped past the primitive unknown-method gate.

module neg.int_to_str_effect_collision_neg

type NetErr enum
    | Eof
    | Closed

export fn NetErr @to_str() -> str {
    match @ {
        Eof    => "eof"
        Closed => "closed"
    }
}

type Clock effect {
    tick() -> int
}

fn bad() Clock -> str {
    ro x = Clock.tick()
    x.to_str()               // int has no to_str → must be E_UNKNOWN_METHOD
}

test "should not compile" {
    ro _ = with Clock = effect Clock { tick() => 5 } { bad() }
    assert(true)
}
