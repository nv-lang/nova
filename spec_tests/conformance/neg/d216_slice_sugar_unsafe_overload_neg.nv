// [M-d216-unsafe-map-single-file-gaps] (2026-07-17): the `[]T` slice-sugar
// spelling of the same call (`[]u8.new(ptr, len)` ≡ `Vec[u8].new(ptr, len)`,
// D239) WITHOUT an `unsafe { }` wrap must ALSO be rejected —
// `E_UNSAFE_CALL_REQUIRES_WRAP` (D216 §9). This shape parses to `Member{
// obj: Path(["__array", "u8"]), name: "new" }` — a DIFFERENT AST shape from
// the `Vec[T].new` TurboFish form (see the companion
// d216_generic_static_unsafe_overload_neg.nv), both funnelled through the
// same arg-count-based per-overload resolution. Exact repro shape of
// `str @bytes()` (std/runtime/string/core.nv), minus the `unsafe {}` wrap.
//
// EXPECT_COMPILE_ERROR E_UNSAFE_CALL_REQUIRES_WRAP

module neg.d216_slice_sugar_unsafe_overload_neg

test "calling unsafe []u8.new(ptr, len) slice-sugar without unsafe wrap" {
    mut buf []u8 = [1, 2, 3]
    ro p = buf.ptr()
    ro v = []u8.new(p, 3)   // ERROR: missing unsafe { } wrap
    assert(v.len() == 3)
}
