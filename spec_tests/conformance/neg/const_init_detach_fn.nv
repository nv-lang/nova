// EXPECT_COMPILE_ERROR E_CONST_INIT_CONCURRENCY
//
// Plan 173.3 addendum ([M-const-init-concurrency-gate]): вызов fn, чья
// сигнатура несёт эффект конкуренции (`Detach`), из module-level
// `ro`-инициализатора запрещён — детач-файбер посреди nova_consts_init()
// армит воркеров до конца инициализации констант.

module neg.const_init_detach_fn
fn bg_task() Detach -> int {
    detach {
        ro _x = 1
    }
    5
}

ro eager_bg = bg_task()
