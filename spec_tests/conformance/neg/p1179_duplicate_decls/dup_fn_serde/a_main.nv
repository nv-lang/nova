// EXPECT_COMPILE_ERROR E_DUPLICATE_DECL
//
// Registry 221.1 #1179/#1183/#1186: two peer files of ONE module (D281 Rule C)
// both declare the same top-level function; `b_peer.nv` holds the second one.
// That is a duplicate, refused with the same code in `nova check`, `nova
// build` and `nova test`.
//
// #1183: `json_kind` is also declared inside `std.encoding.serde` (json.nv, not exported).
// Before the fix a name the IMPORTED CU also declared excused the collision, and this pair compiled with one of
// the two declarations picked silently. If that std name is ever renamed, pick
// another one it declares -- the point of this case is the import overlap.
//
// This file sorts first (entry) and carries the pinned expectation: the
// refusal sits on the first declaration, its note on the repeat.

module p1179_duplicate_decls.dup_fn_serde

import std.encoding.serde.{json_encode}

// nova:expect E_DUPLICATE_DECL -- `b_peer.nv` declares this function again in the same module
fn json_kind(x int) -> int => x + 1

fn encode_one() -> bool => json_encode(1).is_ok()

test "unreachable: the module does not compile" {
    assert(1 == 1)
}
