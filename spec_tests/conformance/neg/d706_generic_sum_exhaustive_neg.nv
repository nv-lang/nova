// EXPECT_COMPILE_ERROR E_MATCH_NON_EXHAUSTIVE
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №706. Исчерпаемость `match` обязана проверяться и для
// GENERIC именованной суммы, а не только для негенерической.
//
// ЧТО БЫЛО ДО ПРАВКИ: разбор снимался целиком, если у типа скрутини есть
// хоть один аргумент. Условие стояло прямо в шапке проверки —
// `TypeRef::Named { generics, .. } if generics.is_empty()`, с оговоркой
// «generic-инстанс и builtin'ы пока вне разбора». То есть правило было
// объявлено, а половина закрытых множеств из-под него выпадала молча.
//
// ЧЕМ ИЗМЕРЕНО, а не предположено. Две пробы на одном бинаре, различие в
// ОДНОМ — есть ли у суммы параметр: негенерическая сумма с пропущенным
// вариантом отвергалась (`[E_MATCH_NON_EXHAUSTIVE]`), а generic-сумма с
// ровно тем же пропуском давала `PASS: 1  FAIL: 0`.
//
// ПОЧЕМУ ПРАВКА ЗАКОННА: имена вариантов суммы НЕ зависят от аргументов
// типа, а исчерпаемость считается по именам. Подстановка нагрузки
// вариантов на разбор имён не влияет, поэтому снятие условия ничего не
// огрубляет — оно лишь перестаёт терять половину случаев.
//
// Контроль на ЗАКОННУЮ форму (полный разбор той же generic-суммы обязан
// проходить) — `standalone/d706_generic_sum_exhaustive_pos.nv`.

module neg.d706_generic_sum_exhaustive_neg

type D706Gen[T] enum
    | D706GA(T)
    | D706GB
    | D706GC

fn probe(k D706Gen[int]) -> int {
    // nova:expect E_MATCH_NON_EXHAUSTIVE -- generic-сумма разбирается не вся: нет арма на третий вариант
    match k {
        D706GA(x) => x
        D706GB    => 2
    }
}
