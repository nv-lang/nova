module neg.fn_proto_method_param_any_neg

type PSlot protocol { @one(x any) -> int }
type QFound protocol { @one(x int) -> int }

fn takes(f fn(PSlot) -> int) -> () {}
fn callee(x QFound) -> int => 0

fn main() {
    // nova:expect E_FN_PROTO_METHOD_PARAM_MISMATCH -- item 2 exact equality: method param any != int
    takes(callee)
}