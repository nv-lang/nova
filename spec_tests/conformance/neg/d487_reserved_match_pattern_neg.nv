// EXPECT_COMPILE_ERROR E_RESERVED_NAME
//
// D487 (owner decision 2026-10-01): a name bound by a match pattern may not be declared in the
// compiler's namespace `_nova_` -- the code generator writes its own names
// there in the generated C, and `c_ident` (codegen/emit_c/c_name.rs) lets
// that namespace through unescaped, so a program name there could meet one
// of them (registry 221.1 #1440, question 1). One kind of declaration per
// file: the parser stops at the first refusal.
module neg.d487_reserved_match_pattern_neg

fn pick(o Option[int]) -> int => match o {
    // nova:expect E_RESERVED_NAME -- a name bound by a match pattern in the reserved namespace `_nova_` (D487)
    Some(_nova_v) => 1
    None => 0
}
