// реестр 221.1 №510 (интегратор, класс переписан 2026-08-09): «ни одно
// выражение не должно молча разваливаться на два — неразобранный хвост
// обязан быть ошибкой разбора». `[]T.method(...)` sugar (`parse_array_lit`,
// compiler-codegen/src/parser/mod.rs, ветка D38 array-type-static-method,
// ~строка 9858) распознаёт ТОЛЬКО голый identifier перед `.` (lookahead
// на ОДИН токен: `Ident` затем `Dot`). Когда `T` несёт турбофиш-аргументы
// (`[]Ent[str, int].new()`), после identifier'а идёт `[`, не `.` —
// условие не срабатывает, и парсер молча трактует уже поглощённое `[]`
// как ЗАВЕРШЁННЫЙ пустой array-литерал. Хвост `Ent[str, int].new()`
// становится ОТДЕЛЬНЫМ, никак не связанным выражением-стейтментом —
// текст ПРИНЯТ, но смысл ИЗМЕНЁН, без единой ошибки на этом этапе.
//
// НАМЕРЕННО КРАСНАЯ фикстура (test-conventions.md, «Правило для проб»,
// инвертирующий маркер в --full-лейне): дефект №510 в этом окне (p502-
// named-tuple) НЕ чинится — вне мандата (стадия parse, не check/codegen,
// отдельная волна). Маркер ниже фиксирует ЖЕЛАЕМЫЙ контракт (ошибка
// разбора при неразобранном хвосте) как ОЖИДАНИЕ; сегодняшнее реальное
// поведение — молчаливый mis-parse → downstream link-error на случайном
// символе (наблюдался `undefined symbol: Nova_EmbeddedDir_static_new`,
// НЕ детерминированный — зависит от того, что первым совпадёт в
// static-dispatch таблице) — этому маркеру НЕ соответствует, так что
// `nova test --full` покажет эту фикстуру FAIL уже сегодня. Это и есть
// цель: позеленение станет видимым сигналом «парсер починен, проверь
// текст сообщения» (или «проба протухла»), а не тихим фактом.
//
// EXPECT_COMPILE_ERROR E_ARRAY_SUGAR_TRAILING_TYPE_ARGS

module neg.m510_vec_generic_bracket_sugar_turbofish_neg

type M510NegEnt[K, V] { key K, value V }

fn bad() -> int {
    mut xs = []M510NegEnt[str, int].new()
    xs.len()
}
