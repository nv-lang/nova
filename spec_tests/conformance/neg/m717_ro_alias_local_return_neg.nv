// EXPECT_COMPILE_ERROR E_READONLY_COERCE
//
// #717 hole (3) ORDER (registry 221.1, owner's ruling 2026-08-21): a local
// that ALIASES a ro source is itself ro. The direct form
// `fn f(v []int) -> []int { v }` was already rejected; the same array handed
// through one local was `PASS: 1  FAIL: 0`, because `f1_block` restores its
// ro-name set at block exit and the return check runs AFTER that restore.
// Provenance is now recorded once, at the binding, so the restore cannot
// erase it.
module neg.m717_ro_alias_local_return_neg

fn m717_launder_via_local(v []int) -> []int {
    ro al = v
    // nova:expect E_READONLY_COERCE -- `al` aliases the ro parameter `v`, so returning it under a non-ro return type launders the freeze exactly as returning `v` would (#717 alias rule)
    al
}

fn main() {
    mut arr = []int.of(1, 2, 3)
    ro got = m717_launder_via_local(arr)
    assert(got.len() == 3)
}
