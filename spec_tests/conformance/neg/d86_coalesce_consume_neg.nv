// EXPECT_COMPILE_ERROR D133-not-consumed
// D86-followup: `??` must NOT weaken D133 — a consume-var bound via `RESULT
// ?? panic(...)` that is never consumed still must be flagged. Companion pos
// test: ../d86_coalesce_consume.nv. Named record literal `Ok(D86NegRes { id: 1 })`.
module neg.d86_coalesce_consume_neg

type D86NegRes consume {
    id int,
}

fn D86NegRes consume @close() -> () { () }

fn d86_neg_try_open(ok bool) -> Result[D86NegRes, str] {
    if ok { Ok(D86NegRes { id: 1 }) } else { Err("boom") }
}

test "?? consume-var забыта на exit — D133-not-consumed остаётся (D86)" {
    consume r = d86_neg_try_open(true) ?? panic("open failed")
    ro _sum = r.id + 1
}
