// EXPECT_COMPILE_ERROR duplicate definition `I.summarize` with same signature
//
// №129 (реестр 221.1, приёмка 2026-07-30, итоговая семантика): два blanket'а
// на РАЗНЫЕ протоколы (`P129SourceA`/`P129SourceB`), одна буква typevar (`I`),
// одно имя метода и ОДИНАКОВАЯ форма сигнатуры. Пиннится факт: чекер отклоняет
// такую пару СВОИМ сигнатурным дедупом («duplicate definition ... with same
// signature») ДАЖЕ кросс-протокольно — до codegen-реестра она не доживает.
// Значит единственные легальные пары на одном ключе (получатель, метод) в
// `mono_method_decls` — D84-overload'ы РАЗНОЙ формы (арность/mut/return), а
// для них диспетч у вызова идёт по точной перегрузке ([M-138.2]/№130 by-span).
// Проверка E_MONO_METHOD_KEY_COLLISION (mono_method_registry.rs) остаётся как
// defense-in-depth на внутренний инвариант: одинаковая форма на одном ключе =
// нарушение, которого легальный исходник дать не может.
//
// История приёмки: первый вариант проверки (сравнение только span'ов) ложно
// бил по легальному арность-overload'у `Router130 @get` в мега-CU; уточнён до
// сравнения формы. Первый вариант ЭТОЙ фикстуры (mut-axis пара) по уточнённой
// семантике легален и переехал в pos-соседа.
//
module neg.mono_method_decl_collision_neg

type P129SourceA[T] protocol {
    mut @pull_a() -> Option[T]
}

type P129SourceB[T] protocol {
    mut @pull_b() -> Option[T]
}

type P129CountA {
    mut n int
}
fn P129CountA mut @pull_a() -> Option[int] {
    if @n <= 0 { None }
    else { @n -= 1; Some(@n) }
}

fn[I P129SourceA[T]] I @summarize() -> int {
    111
}

fn[I P129SourceB[T]] I @summarize() -> int {
    222
}

test "reachability bait — keeps the blanket decls from being DCE'd away" {
    mut a = P129CountA { n: 3 }
    assert(a.n == 3)
}
