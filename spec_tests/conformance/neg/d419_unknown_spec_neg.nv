// Plan 152.7.2 (D419) NEG — unknown format-spec SYNTAX is still rejected
// regardless of `@display_fmt`. The D419 "softening" is about SEMANTICS
// (`#`/`.N` reaching a type via `@display_fmt`), not about relaxing
// E_FORMAT_SPEC_UNKNOWN for a genuinely-unknown type-char — the parser has
// no type information at all (spec/decisions/02-types.md#d419 §4). No
// regression from pre-D419 behavior (nova_tests/plan91_14/t3_neg_unknown_format_spec.nv).
//
// EXPECT_COMPILE_ERROR E_FORMAT_SPEC_UNKNOWN

module neg.d419_unknown_spec_neg

type Tagged { s str }

fn Tagged @display_fmt(mut f Fmt) -> () { f.write(@s) }

test "unknown format spec type-char still rejected even for a type WITH @display_fmt" {
    ro t = Tagged { s: "x" }
    ro out = "${t:zz}"
    assert(out == "x")
}
