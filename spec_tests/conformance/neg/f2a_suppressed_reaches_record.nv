// EXPECT_RUNTIME_PANIC suppressed [1]: CLEANUP-FAILED
//
// План 173.4 Ф.2 (а), реестр 221.1 №445: цепочка ПОДАВЛЕННЫХ ошибок (D158
// model B) обязана доезжать до записи отказа. Здесь cleanup ДЕЙСТВИТЕЛЬНО
// бросает поверх ещё летящей первичной — в отличие от defer_throw_single и
// соседей, где defer только печатает и составной ошибки нет вовсе.
//
// Замер ДО починки (2026-08-15): запись печатала `suppressed:[]`, хотя узлы
// цепочки были собраны, связаны и доезжали до fail-кадра `_ff`. Терялись они
// в ОДНОЙ точке: `nova_fiber_report_error_kinded` брал три аргумента, среди
// которых цепочки не было, а у `NovaFiberQueue` не было поля, куда её
// положить. Файбер умирал, стек уходил, цепочка становилась мусором.
//
// Ожидание пришпилено к СТРОКЕ ПОДАВЛЕННОЙ ошибки, а не к заголовку: заголовок
// («composite» или обычный) — вопрос представления, а предмет фикстуры в том,
// что вторая ошибка НЕ ПОТЕРЯНА. Тот же контракт держит исполнением страж
// `check-panic-report-contract.sh` (дорожка runtime-panic в гейт не входит,
// см. №445 п.(а)).

module neg.f2a_suppressed_reaches_record

fn tx() Fail -> () {
    defer { throw "CLEANUP-FAILED" }
    throw "PRIMARY-FAILED"
}

fn main() Io -> () {
    tx()
    println("UNREACHABLE")
}
