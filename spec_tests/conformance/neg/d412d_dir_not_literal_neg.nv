module neg.d412d_dir_not_literal_neg

fn d412d_dynamic_dir() -> int {
    ro p = "d412d_dir"
    ro d = embed_dir(p)          // ✗ не литерал — E_EMBED_ARG_NOT_STR_LITERAL
    d.len()
}
