// EXPECT_COMPILE_ERROR E_STR_RAW_NEWLINE
//
// План 277 Ф.2 / D467 §2 / реестр 221.1 №794.
//
// Сырой перевод строки внутри `"..."` — хард-ошибка. До 2026-09-06 лексер
// оракула глотал его как любой другой байт (ветка `_` в `lex_string`), и
// многострочный `"..."` работал ДЕ-ФАКТО, нигде не будучи санкционированным:
// спека такой формы не знала, а лексер `novac` её сознательно отвергал. Два
// компилятора расходились в базовом правиле языка.
//
// Законные формы никуда не делись: продолжение строки `\` + перенос (Ф.1) и
// backtick (Ф.3) — обе стоят в позитивной фикстуре рядом.
//
// Пин стоит перед ОТКРЫВАЮЩЕЙ кавычкой: диагностика указывает на начало
// литерала (`span(start, pos)`), а не на строку с самим переводом.
module neg.p277_str_raw_newline_neg

fn raw_newline_bad() -> str {
    // nova:expect E_STR_RAW_NEWLINE -- a raw newline inside "..." must be refused at lex time
    "abc
    def"
}

fn main() Io -> () => println(raw_newline_bad())
