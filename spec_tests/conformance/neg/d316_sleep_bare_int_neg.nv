// EXPECT_COMPILE_ERROR no method `sleep` on primitive type `int`

// D316/Q6 (Ред. 2 anti-Zig-footgun) — `sleep` — МЕТОД на typed `Duration`
// (Plan 175 Ф.2-v3: free `sleep(Duration)` retracted, method-only canon),
// НЕ на голом int (unit-ambiguous: ms? ns? seconds?). В отличие от
// `Zig sleep(u64 ns)`, Nova не даёт implicit int→Duration conversion —
// unit должен быть явным на call-site (`100.to_millis().sleep()`, не
// `100.sleep()`) — bare `int` has no `.sleep()` method at all.
module neg.d316_sleep_bare_int_neg

import std.time.duration

fn d316_neg_sleep_int() Time -> () {
    100.sleep()
}
