// EXPECT_COMPILE_ERROR E7301
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №710. Тело handler-литерала, записанного ПРЯМО в
// `with`-позиции, обязано проверяться чекером — так же, как тело того же
// самого литерала, вынесенного в переменную.
//
// ЧТО БЫЛО ДО ПРАВКИ: `nova check` на этом файле давал `PASS: 1  FAIL: 0`,
// то есть НОЛЬ диагностик, а отказ приходил уже от компилятора C:
// `error: initializing 'nova_int' (aka 'long long') with an expression of
// incompatible type 'const nova_str'`. Ошибка в исходнике Nova объяснялась
// в словах сгенерированного Си — ровно тот класс, который реестр и заводит.
//
// ЧТО ИЗОЛИРОВАЛО КОРЕНЬ: тот же литерал, присвоенный переменной
// (`ro h = effect Probe { ... }`, затем `with Probe = h { ... }`), ЛОВИЛСЯ
// чекером как `[E7301]` на том же бинаре. Различие между «ловится» и «не
// ловится» было в ОДНОЙ переменной — позиции литерала, — и потому указывало
// не на пробел в правилах, а на пропущенный спуск обхода.
//
// КОРЕНЬ: `f1_expr_inner` разбирал узел как `ExprKind::With { body, .. }` и
// терял `bindings`, где и живут handler-литералы. Арм `HandlerLit` в том же
// проходе всё это время умел проверять тела методов — до него просто не
// доходили. Правка — спуск в `bindings`; она делает две формы записи одной.
//
// Контроль на ЗАКОННУЮ форму (корректный handler в той же позиции, который
// обязан собираться и исполняться) — `standalone/d710_handler_body_pos.nv`.

module neg.d710_handler_body_unchecked_neg

type Probe effect { fill(x int) -> int }

fn probe() -> int {
    with Probe = effect Probe {
        fill(x) -> int => {
            ro q int = "not an int"
            x + 1
        }
    } {
        42
    }
}
