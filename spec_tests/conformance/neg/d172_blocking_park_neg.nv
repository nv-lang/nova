// EXPECT_COMPILE_ERROR E_BLOCKING_SYNC_PARK
// D172: Mutex.lock — #parks; запрещён в #blocking fn (fiber-park на
// threadpool-worker недопустим — worker не участвует в M:N-планировании).
module neg.d172_blocking_park_neg

// [реестр 221.1 №493] `-> MutexGuard` added: `m.lock()`'s real
// return type (Mutex.lock() -> MutexGuard, std/runtime/sync.nv;
// №616/2026-08-12: no `consume` modifier written here anymore -- the
// TYPE's own `consume` declaration carries the obligation, D180) --
// carrier scan hit for E_MISSING_RETURN_TYPE (incidental to this
// fixture's actual point, E_BLOCKING_SYNC_PARK; kept annotated so the
// two diagnostics don't co-occur).
#blocking fn blk_lock(mut m Mutex) -> MutexGuard {
    m.lock()
}

test "Mutex.lock в #blocking fn — E_BLOCKING_SYNC_PARK" {
    mut m = Mutex.new()
    blk_lock(m)
}
