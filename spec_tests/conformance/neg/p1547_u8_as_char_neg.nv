// before any C (the table used to live in the emitter, and this cell passed).
// The positive half: spec_tests/conformance/standalone/p1547_as_d54_legal.nv.
module neg.p1547_u8_as_char_neg

fn main() Io -> () {
    ro b u8 = 66
    // nova:expect E_AS_CAST_FORBIDDEN -- an integer VALUE to `char` is in the forbidden table (D54): the checked form is `n.to_char()?`, the escape is `unsafe { }`
    println((b as char).to_str())
}
