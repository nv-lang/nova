// EXPECT_COMPILE_ERROR E_SUPERVISOR_HANDLER_SUSPEND
//
// Plan 173.2 Q-блок neg: suspend-операции (`Time.sleep`) внутри
// Supervisor-хендлера запрещены — заблокировали бы serialized drive-цикл
// scope'а (решения по падениям перестали бы приниматься).

module neg.handler_sleep_neg
test "Time.sleep в Supervisor-хендлере отвергается" {
    with Supervisor = effect Supervisor {
        on_child_fail(idx, err) {
            (100).to_millis().sleep()
            Decision.Escalate
        }
    } {
        supervised {
            spawn { throw 1 }
        }
    }
}
