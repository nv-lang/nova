// №367 (window p375-ptr2) — READ-form parity: `y = p[i]` index READ on a raw
// pointer must be retired exactly like the already-closed WRITE sibling
// (`p[i] = v`, №353). Also exercises №368's classification fix (`p`'s
// pointer type must be inferred from the UNANNOTATED `buf.ptr()` RHS for
// this check to even see `p` as a pointer at all).

// EXPECT_COMPILE_ERROR E_POINTER_OP_USE_METHOD

module neg.d367_ptr_index_read_neg

test "rejects `y = p[i]` index read on a raw pointer" {
    mut buf []int = [10, 20, 30]
    unsafe {
        ro p = buf.ptr()
        mut y = p[1]
        y = y + 1
        assert(y == 21)
    }
}
