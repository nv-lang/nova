// Plan 174.5 Ф.3 (retraction, §3/§9, D216 amend) — `p-q` pointer subtraction
// is retired. Use `p.dist(q)`.
//
// EXPECT_COMPILE_ERROR E_POINTER_OP_USE_METHOD

module neg.d216_ptr_sub_dist_neg

test "rejects `p-q` distance operator" {
    mut buf []int = [10, 20, 30]
    unsafe {
        ro p = buf.ptr()
        ro q = p.offset(2)
        ro d = q - p
        assert(d == 2)
    }
}
