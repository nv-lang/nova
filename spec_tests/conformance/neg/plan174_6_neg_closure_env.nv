// Plan 174.6 M1 (D353) NEG — coercing an environment-capturing closure into a
// C-ABI `*extern "C" fn` is forbidden: a C callback must be captureless.
//
// EXPECT_COMPILE_ERROR E_CLOSURE_HAS_ENV

module neg.plan174_6_neg_closure_env
test "rejects closure-with-env coerced to *extern \"C\" fn" {
    ro cb = (fn(x i64) -> i64 => x * 2) as *extern "C" fn(i64) -> i64
    assert(1 == 1)
}
