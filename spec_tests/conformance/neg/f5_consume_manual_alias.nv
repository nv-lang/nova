// EXPECT_COMPILE_ERROR D188-r2-manual-on-exit
//
// Plan 173 Ф.5 (#8) hardening: widened `D188-r2-manual-on-exit` checker
// (Plan 110.1.5 originally matched ONLY the literal `binding.cleanup(...)`
// identifier form) now also catches a same-scope alias
// (`ro y = r; y.cleanup(...)`) — a realistic double-invocation escape that
// the manual call inside `f5_consume_exactly_once.nv`'s compile-time gate
// would otherwise have missed, letting the manual call and the scope's own
// generated dispatch both reach `Nova_F5AliasRes_consume_cleanup` at
// runtime (genuine D188 R2 violation).

module neg.f5_consume_manual_alias

type F5AliasRes { ro id int }
fn F5AliasRes.new(id int) -> F5AliasRes => { id }
fn F5AliasRes consume @cleanup(_o ScopeOutcome) -> () => ()

fn bad_alias_call() -> () {
    consume r = F5AliasRes.new(1) {
        ro y = r
        y.cleanup(Success)
    }
}
