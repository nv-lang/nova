// EXPECT_COMPILE_ERROR E_SUPERVISOR_HANDLER_INTERRUPT
//
// Plan 173.2 Q-блок neg: `interrupt` внутри Supervisor-хендлера запрещён —
// хендлер исполняется сериализованно на drive-цикле scope'а; ранний выход
// из with-блока бросил бы drain с ещё живыми детьми.

module neg.handler_interrupt_neg
test "interrupt в Supervisor-хендлере отвергается" {
    ro _ = with Supervisor = effect Supervisor {
        on_child_fail(idx, err) -> Decision {
            interrupt 5
        }
    } {
        supervised {
            spawn { throw 1 }
        }
        0
    }
}
