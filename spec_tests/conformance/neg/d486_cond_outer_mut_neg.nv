// EXPECT_COMPILE_ERROR E_OUTER_MUT_IN_CONDITION
// Regression for the spec hunt 2026-10-01 (rows 1580-1585; the integrator's ruling
// 2026-10-02): in an if/while condition a word before the pattern is the mode of a
// BARE NAME only (D486 s4 rule 3). Before, the parser took any pattern after `ro`/`mut`
// and the program compiled. Positive half: standalone/d486_cond_mode_ok.nv.
module neg.d486_cond_outer_mut_neg

fn find(k int) -> Option[int] => if k > 0 { Some(k) } else { None }

fn main() Io {
    // nova:expect E_OUTER_MUT_IN_CONDITION -- `mut` before a constructor pattern
    if mut Some(u) = find(3) {
        u += 1
        println("u ${u}")
    }
}
