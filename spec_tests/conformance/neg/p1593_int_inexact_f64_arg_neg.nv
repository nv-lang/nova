// EXPECT_COMPILE_ERROR E_LIT_INEXACT
// Regression for registry 221.1 #1593 (D489): a literal takes the
// type of its position only if its EXACT value is representable there; an integer
// literal in a float only if exact (E_LIT_INEXACT), a fraction not past infinity
// (E_LIT_OUT_OF_RANGE). Before, the number was silently replaced. Positive half:
// standalone/p1593_literal_exact_ok.nv.
module neg.p1593_int_inexact_f64_arg_neg

fn take(x f64) Io -> () => println("${x}")

fn main() Io {
    // nova:expect E_LIT_INEXACT -- 2^53 + 1 has no f64
    take(9007199254740993)
}
