// EXPECT_COMPILE_ERROR D133-not-consumed
//
// #672 form (3): a `consume` RECEIVER that disposes of nothing. The caller
// hands ownership over (and disarms its own auto-cleanup doing so), the
// method swallows it, and `@cleanup` never runs for anybody. Three shapes are
// exempt, and each was named by a std carrier that reddened while measuring:
// a `@cleanup` delegate (`File.close`), a must-consume return type
// (`TcpStream.into_split`), and a hand-off on any path (`TcpStream.close`).
// `@swallow` below is none of the three.
module neg.m672_form3_consume_receiver_leak_neg

type M672R3 consume { tag int }

fn M672R3 consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

fn M672R3 consume @close() -> () { () }

// nova:expect D133-not-consumed -- the consume receiver is never handed on, never released, and is not what `@cleanup` delegates to (#672 form 3)
fn M672R3 consume @swallow() -> () {
    assert(@tag == 3)
}

fn main() {
    consume r = M672R3 { tag: 3 }
    r.swallow()
}
