// EXPECT_COMPILE_ERROR D131
//
// [M-channel-heap-value-shared-not-moved] (Plan 221.1 №144, 2026-07-27):
// канал ЗАБИРАЕТ владение отправленным значением (D79/D91-амендмент,
// spec/decisions/06-concurrency.md §D91). Измеренный дефект ДО фикса:
// отправитель клал Vec[int] с одним элементом, ПОСЛЕ `send` дописывал
// второй — получатель видел ОБА (канал передавал общий указатель на кучу
// без изоляции; под M:N это гонка данных по построению, два файбера мутируют
// один объект). Фикс: параметр `send`/`try_send` — consume; использование
// значения после отправки ловится существующей линейной проверкой (D131),
// не runtime-гонкой.

module neg.channel_send_consume_use_after_neg

test "send забирает владение — использование значения после send = D131" {
    ro (tx, rx) = Channel[Vec[int]].new(4)
    mut v = Vec[int].of(1)
    tx.send(v)
    // ОШИБКА D131: `v` уже потреблена вызовом `tx.send(v)` выше.
    v.push(2)
    ro _got = rx.recv()
}
