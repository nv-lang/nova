// Plan 174.6 M1 (D353 clause 3, generalises D216 §10/§20) NEG — coercing a fn
// that declares the `Fail` effect into a C-ABI `*extern "C" fn` is forbidden:
// C invokes the callback with no Nova handler-frame on the stack.
//
// EXPECT_COMPILE_ERROR E_CALLBACK_THROWS_OVER_C_ABI

module neg.plan174_6_neg_callback_fail
fn throwing_cb(x i64) Fail -> i64 {
    x
}

test "rejects Fail-fn coerced to *extern \"C\" fn" {
    ro cb = throwing_cb as *extern "C" fn(i64) -> i64
    assert(1 == 1)
}
