// EXPECT_COMPILE_ERROR E_READONLY_COERCE
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №717, дыра (3) ПОРЯДОК. `ro`-источник, пропущенный через
// локаль, обязан отвергаться так же, как возвращённый напрямую.
//
// ЧТО БЫЛО ДО ПРАВКИ: `fn f(v []int) -> []int { v }` отвергался
// (`E_READONLY_COERCE`), а тот же массив через `ro al = v` — проходил
// `PASS: 1  FAIL: 0`. Причина не в правиле, а в порядке: `f1_block`
// восстанавливает свой набор `ro`-имён на выходе (и это верно само по себе —
// иначе `ro x` течёт в объемлющую область), а проверка ХВОСТА тела функции
// шла ПОСЛЕ восстановления, когда локали уже невидимы.
//
// ПОЧЕМУ ПРАВКА НЕ СВОДИТСЯ К «ПОКАЗАТЬ ЛОКАЛИ» — это главное в фикстуре.
// Первая попытка так и сделала и дала 773 отказа в std при каноне 26:
// набор `ro_binding_names` держит ВСЯКУЮ немутабельную привязку, поэтому
// `ro removed = <свежее значение>` в нём неотличим от `ro al = v`. Понадобился
// ОТДЕЛЬНЫЙ набор происхождения (`ro_source_names`): в него входят только
// не-`mut` параметры (по D176 параметр псевдонимит значение вызывающего) и
// локали, чей инициализатор — ГОЛОЕ имя, уже состоящее в наборе.
//
// Парная положительная фикстура пиняет ровно ту форму, что взорвалась:
// `standalone/d717_ro_fresh_local_pos.nv`.

module neg.d717_ro_leak_via_local_neg

fn leak_via_local(v []int) -> []int {
    ro al = v
    // nova:expect E_READONLY_COERCE -- `ro`-источник утёк через локаль-псевдоним
    al
}
