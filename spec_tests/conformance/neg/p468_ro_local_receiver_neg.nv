// EXPECT_COMPILE_ERROR E_LOCAL_NOT_MUT
//
// №468 follow-up (owner 2026-08-09): a `ro`-bound local initialized from
// a bare primitive literal (`ro n = 5`) used to leave `var_types` without
// a type entry for `n` (`infer_value_type` had no arm for bare literals),
// so the existing E_LOCAL_NOT_MUT registry lookup silently found nothing
// and let `n.p468_inc(10)` through -- harmless while no primitive could
// ever have a REGISTERED mut-method (E_PRIMITIVE_MUT_METHOD banned every
// declaration), a real enforcement gap once that ban is retired. This
// pins the fix (`infer_value_type` literal arms in
// `compiler-codegen/src/types/mod.rs`): the exact same call on a
// record-typed `ro`-local already correctly fired E_LOCAL_NOT_MUT before
// this fix -- the gap was primitive-literal-specific.
module neg.p468_ro_local_receiver_neg

fn int mut @p468_inc(by int) -> () {
    @ += by
}

test "mut-method call on a ro-bound primitive local is rejected" {
    ro n = 5
    n.p468_inc(10)
    assert(true)
}
