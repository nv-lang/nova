// Plan 174.6 M1 (D282 rule 2) NEG — a heap GC-record (no `value` keyword) is
// by-reference `Nova_X*`, not a C-ABI by-value struct → forbidden as an
// `extern "C" fn` parameter.
//
// EXPECT_COMPILE_ERROR E_FFI_NON_C_ABI_TYPE

module neg.plan174_6_neg_heap_record_param
type HeapRec { a int, b int }

extern "C" fn c_take_heap(r HeapRec) -> int

test "rejects heap-record param over C ABI" {
    assert(1 == 1)
}
