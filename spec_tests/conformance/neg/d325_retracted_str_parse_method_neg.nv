// EXPECT_COMPILE_ERROR E_UNKNOWN_METHOD
//
// Plan 177 Ф.3 / D325 (NEG) — [E_UNKNOWN_METHOD] / closes the pre-existing
// [M-checker-unknown-method-stackoverflow] blocker.
//
// D325 / Plan 177 Ф.2b RETRACTED the `try_parse_int` (Result) and `parse_int_opt`
// (Option) spellings, leaving `str.parse_int()` as the single Result-returning
// form; Plan 174.1 (2026-07-08) then retracted `str.parse_int()` itself too —
// replaced by `s.to_int()` (std/runtime/string/parse.nv), still a str method,
// just a different name/error-domain split. A call to a RETRACTED (or any nonexistent) method on a PRIMITIVE
// receiver must be rejected by the CHECKER with a clean `[E_UNKNOWN_METHOD]`
// diagnostic (§0/§1/§6) — it must NOT leak to codegen, which previously
// PANICKED `[P67-LEGACY]` (emit_c.rs "method call return type unknown —
// checker must annotate") on an `int` receiver and mis-typed a `str` receiver to
// `nova_int` → CC-FAIL. That leak is exactly what blocked this fixture from being a
// clean `EXPECT_COMPILE_ERROR` (the panic aborted the whole runner process).
//
// The checker consults every legitimate resolution channel first — built-in
// primitive methods (D109/D74), prelude/protocol methods (`method_table`), and
// any generic `fn[T] T @method` blanket — so a REAL method (`s.to_int()`,
// `x.abs()`, `c.is_alphabetic()`) is never flagged; only a genuinely-missing
// name reaches this diagnostic. (D73/D77 `into`/`try_into` auto-derive channel
// retracted 2026-07-06 — no longer part of this list.)

module neg.d325_retracted_str_parse_method_neg

fn d325_retracted() -> int {
    ro s = "42"
    // ✗ E_UNKNOWN_METHOD — `try_parse_int` was retracted (D325); use `s.to_int()`.
    match s.try_parse_int() {
        Ok(v) => v
        Err(_) => 0
    }
}

test "D325: retracted `str.try_parse_int` is rejected as an unknown method" {
    ro _ = d325_retracted()
}
