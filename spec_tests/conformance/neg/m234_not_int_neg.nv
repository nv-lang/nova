// EXPECT_COMPILE_ERROR E_UNARY_OPERAND_TYPE
//
// План 234 (владелец 2026-07-27: "пройтись единообразно одной волной" по
// всем неподдерживаемым комбинациям унарных `!`/`-`/`~` × типы) — `!5` на
// `int`: `!` — ЛОГИЧЕСКОЕ отрицание (только `bool`), не побитовое (то — `~`,
// D46-амендмент). Честная ошибка чекера вместо тихого C `!5` (валиден в C,
// молча даёт 0 — не то, что подразумевает Nova-семантика).
module neg.m234_not_int_neg

fn main() {
    ro m234_x = 5
    ro m234_y = !m234_x
    println("${m234_y}")
}
