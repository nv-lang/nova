// EXPECT_RUNTIME_PANIC propagation trace
//
// [M-173-error-return-trace] (Plan 173 хвост, 2026-07-13): ПОЛНЫЙ
// propagation-trace (Zig error-return-trace парность) — ring-buffer
// rethrow-точек цепочки `?`-проброса поверх throw-site минимума Ф.5 п.7.
// Err рождается в leaf, пробрасывается value-mode `?` через mid и mid2,
// конвертится `!!` в Fail-эффект в outer (site-mark БЕЗ сброса трассы),
// не пойман → abort-дамп содержит
// `propagation trace (`?`-chain, oldest first):` + `via <file>:<line> (?)`
// на каждое звено. Twin минимума — f5_uncaught_trace_throw.nv.

module neg.f5_propagation_trace_full

fn leaf() -> Result[int, str] {
    Err("leaf-error")
}

fn mid() -> Result[int, str] {
    ro v = leaf()?               // звено 1: value-mode `?` (return Err)
    Ok(v + 1)
}

fn mid2() -> Result[int, str] {
    ro v = mid()?                // звено 2: value-mode `?` (return Err)
    Ok(v + 1)
}

fn outer() Fail -> int {
    ro v = mid2()!!              // звено 3: `!!` (Err → throw, трасса жива)
    v
}

fn main() Io -> () {
    ro x = outer()
    println("UNREACHABLE {x}")
}
