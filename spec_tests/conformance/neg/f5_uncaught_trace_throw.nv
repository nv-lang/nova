// EXPECT_RUNTIME_PANIC (throw site)
//
// Plan 173 Ф.5 п.7 (Zig-парность, минимум — §2 риск 5): uncaught throw в
// debug-билде печатает throw-site `at <file>:<line> (throw site)` в stderr
// (codegen стемпит nova_throw_site_set перед каждым user-throw/panic;
// abort-ветки effects.h печатают дамп). Полный propagation-trace —
// [M-173-error-return-trace].

module neg.f5_uncaught_trace_throw

fn boom() Fail -> () {
    throw "uncaught-from-main"
}

fn main() Io -> () {
    boom()
    println("UNREACHABLE")
}
