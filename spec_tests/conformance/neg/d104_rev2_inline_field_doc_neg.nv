// EXPECT_COMPILE_ERROR E_RECORD_FIELD_MISSING_SEPARATOR
//
// D104 rev-2 (2026-08-15): the INLINE form `field T /// text` is NOT a doc
// form — `///` is a token, not trivia, so the parser sees a second field on
// the same line without a separator. The owner decided one binding rule
// only: the doc goes on the line ABOVE the field. The error text now
// carries that hint. Spec: spec/decisions/03-syntax.md D104 rev-2 p.2.
module spec_tests.conformance.neg.d104_rev2_inline_field_doc_neg

type Bad {
    // nova:expect E_RECORD_FIELD_MISSING_SEPARATOR -- `///` is a token, not trivia: the parser sees a second field on the same line without a separator; the doc for a field goes on the line ABOVE it (D104 rev-2 p.2)
    lo int /// end offset, inline -- not a form
    hi int
}

fn main() {
    ro b = Bad { lo: 1, hi: 2 }
    println("${b.lo}")
}
