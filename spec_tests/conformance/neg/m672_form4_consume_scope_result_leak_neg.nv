// EXPECT_COMPILE_ERROR D133-not-consumed
//
// #672 form (4): the RESULT binding of a consume scope. The checker stayed
// silent and the codegen emitted a bare declaration with no DeferEntry, so
// nobody owned the scope's result: the probe printed the cleanup for `s` and
// never the one for `out`.
module neg.m672_form4_consume_scope_result_leak_neg

type M672S4 consume { tag int }

fn M672S4 consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

fn M672S4 consume @close() -> () { () }

fn M672S4 @share() -> M672S4 => { tag: @tag * 10 }

// nova:expect D133-not-consumed -- the consume-scope result binding `out` owns the scope's value and gets no auto-cleanup; the diagnostic is pinned at the scope exit, i.e. this body (#672 form 4)
fn main() {
    consume s = M672S4 { tag: 7 }
    consume out = consume s { s.share() }
    assert(out.tag == 70)
}
