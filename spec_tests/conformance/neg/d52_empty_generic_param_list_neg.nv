// EXPECT_COMPILE_ERROR E_EMPTY_GENERIC_PARAM_LIST
//
// Реестр 221.1 №728, решение владельца 2026-08-18: пустой `[]` в позиции
// списка generic-параметров ОТВЕРГАЕТСЯ.
//
// ЧТО БЫЛО. По D52 скобка сразу после имени типа объявляет параметры, и
// пустой список принимался без единой диагностики: остаток строки становился
// базой newtype. `type Bytes []u8` молча означал newtype над `u8`, а не над
// срезом, — `ro a Bytes = 7` при этом ПРИНИМАЛОСЬ. Пользователь писал один
// тип и получал другой, ничего об этом не узнавая.
//
// КАК ЭТО ВСКРЫЛОСЬ. Не жалобой, а тестом: `v7_6_refactor_newtype_array_is_ref`
// годами проверял ветку Newtype→Array и оказался байт-в-байт дубликатом
// соседа по Newtype→Primitive — потому что его `type` объявлял не то, что
// заявлял. Тест, проверяющий не ту ветку, зелен так же убедительно, как
// проверяющий нужную.
//
// ПОЧЕМУ ОТКАЗ, А НЕ НОВЫЙ СМЫСЛ ФОРМЫ. Дать `[]` значение среза — изменение
// языка и амендмент к D52; решение владельца — отвергать, D52 остаётся как
// есть. Обе законные записи названы в подсказке отказа.

module neg.d52_empty_generic_param_list_neg

// nova:expect E_EMPTY_GENERIC_PARAM_LIST -- an empty `[]` declares no generic parameters; before this wave the form silently made a newtype over `u8` instead of a slice (registry No. 728)
type Bytes []u8

fn main() Io -> () {
    ro a Bytes = 7
    println("${a}")
}
