// EXPECT_COMPILE_ERROR [E_CONCURRENT_MUT_CAPTURE] outer `mut` binding `flag` captured by reference in a `spawn`/`parallel for`/`detach` body: `int` is a writable cell

// Plan 173.3 (D415 §2 amendment, owner P1 2026-07-11): `detach { }` is an
// orphan fiber on the worker pool — fire-and-forget, never joined with the
// parent — the identical race surface as `spawn`. The original Ф.2 sweep
// only wired the capture-check into `spawn`/`parallel for`; this fixture
// pins the closed gap: an outer `mut` (non-`#share`) captured by reference
// inside `detach { }` must be rejected exactly like inside `spawn { }`.

module neg.mut_capture_in_detach
fn racy_detach() Detach -> () {
    mut flag = 0
    detach {
        flag = 1
    }
}
