// EXPECT_COMPILE_ERROR E_READONLY_COERCE
//
// Registry 221.1 #1480 (D55 amendment 2026-10-01, owner's decision, option (a)): an element of
// `[][]u8` (not `[]ro []u8`) is an OWNED position -- `xs[0][0] = 65 as u8` writes through it. A
// `str` reaches `[]u8` only as the read-only view `#coerce str @bytes() -> ro []u8`, so before
// the fix the write below went into the literal's `.rodata` bytes (SIGSEGV). Probe:
// `docs/plans/repro/d55-str-bytes/launder_elem_segfault.nv.txt`. The owned spelling is
// `s.bytes().clone()`; the view spelling is `[]ro []u8`
// (`standalone/p1480_str_bytes_owned_positions.nv`). The binding's own mode does not matter:
// the element type is what the collection owns.

module neg.p1480_str_bytes_owned_elem_neg

fn p1480_nm() -> str => "abc"

fn main() Io -> () {
    ro s = "abc"
    // nova:expect E_READONLY_COERCE -- a literal as an element of an owned `[][]u8`
    mut xs [][]u8 = ["abc"]
    xs[0][0] = 65 as u8
    // nova:expect E_READONLY_COERCE -- a `str` variable as an element of `[][]u8`, even under a `ro` binding
    ro ys [][]u8 = [s]
    // nova:expect E_READONLY_COERCE -- a call result as an element of `[][]u8`
    ro zs [][]u8 = [p1480_nm()]
    println(ys.len().to_str())
    println(zs.len().to_str())
}
