// EXPECT_COMPILE_ERROR E_NO_STATIC_METHOD
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №729. Вызов НЕСУЩЕСТВУЮЩЕГО статического метода на типе,
// объявленном в этом же CU, обязан отвергаться ЧЕКЕРОМ.
//
// ЧТО БЫЛО ДО ПРАВКИ: `nova check` возвращал НОЛЬ, а отказ приходил от
// линковщика и в его словах — `lld-link: undefined symbol:
// Nova_Box_static_new`. Опечатка в имени статика выяснялась на этапе Си.
//
// ПОЧЕМУ ЗДЕСЬ ВСЕ ТРИ ФОРМЫ СРАЗУ, а не одна. Приёмка строки требует именно
// этого: дыра была УЗКОЙ и очерчивалась двумя работающими соседями. Порознь
// они ничего не доказывают — доказывает то, что все три промаха ловятся
// ОДНОЙ сборкой:
//   (1) свободная функция  — `undefined identifier`;
//   (2) метод экземпляра   — `[E7320] no field or method`;
//   (3) СТАТИК             — `[E_NO_STATIC_METHOD]`, и его до 2026-08-19
//       не ловило ничто.
//
// Контроль на ЗАКОННЫЕ формы (настоящий статик и конструктор варианта суммы,
// который выглядит как статик) — `standalone/d729_static_and_variant_pos.nv`.
// Тот случай важнее прочих: первая попытка этой правки была откачена именно
// об него.

module neg.d729_static_miss_neg

type Box { v int }

fn Box.new(n int) -> Box => { v: n }

fn Box @get() -> int => @v

fn probe() -> int {
    ro b = Box.new(1)
    ro _x = definitely_not_a_free_fn(1)
    ro _y = b.definitely_not_a_method()
    ro _z = Box.definitely_not_a_static(2)
    b.get()
}
