// EXPECT_COMPILE_ERROR E_MATCH_NON_EXHAUSTIVE
//
// D65-амендмент 2026-08-16 (решение владельца), реестр 221.1 №703: `match` по
// сумме обязан покрывать ВСЕ варианты; непокрытый — ОШИБКА компиляции с их
// перечислением (прецедент rustc E0004).
//
// ЧТО БЫЛО ДО ЭТОЙ ФИКСТУРЫ. Ровно эта форма проходила `nova check` И
// `nova build` зелёными, а на исполнении печатала ПУСТУЮ строку и выходила с
// кодом 0 — то есть функция, объявленная `-> str`, возвращала не-str-мусор на
// законном входе. Найдено окном 274 (novac), воспроизведено интегратором.
//
// ПОЧЕМУ ОШИБКА, А НЕ ПРЕДУПРЕЖДЕНИЕ (довод о необратимости, тот же что в
// D464): «ошибка → предупреждение» ослабить позже можно, ни одна программа не
// сломается; «предупреждение → ошибка» ломает чужой код и потому не делается
// никогда — язык остался бы с тихой порчей навсегда. Спека до амендмента
// говорила ОБА варианта сразу (D59 — ошибка, D65 — warning), а реализация не
// делала НИ ТОГО, НИ ДРУГОГО.

module neg.d65_match_non_exhaustive_neg

type Color enum
    | Red
    | Green
    | Blue

fn name(c Color) -> str {
    match c {
        Red   => "r"
        Green => "g"
    }
}

fn main() Io -> () {
    println(name(Color.Blue))
}
