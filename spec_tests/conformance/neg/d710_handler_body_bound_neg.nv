// EXPECT_COMPILE_ERROR does not satisfy
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №710, ВТОРОЙ ПРОЁМ ТОЙ ЖЕ ФОРМЫ. Проверка bound'ов обязана
// заходить в тело handler-литерала, записанного в `with`-позиции.
//
// ПОЧЕМУ ЭТО ОТДЕЛЬНАЯ ФИКСТУРА, А НЕ ДУБЛЬ СОСЕДНЕЙ. Проверок в чекере
// несколько, и они обходят дерево ПОРОЗНЬ. Первая правка №710 включила
// спуск в `bindings` у прохода `f1_expr_inner` — и этого хватило, чтобы
// поймать несоответствие типа в `ro`-объявлении (`d710_handler_body_
// unchecked_neg.nv`), но bound-проход остался слепым: у него был СВОЙ
// узел `With { body, .. }` и, сверх того, СВОЙ арм `HandlerLit`, прямо
// объявленный пустым — «без рекурсии в bound-проверке», без указания
// причины. Спуск в `bindings` доводил обход до узла литерала, а тот
// молча возвращал управление. Потому правок две, и фикстур тоже две.
//
// ЧЕМ ИЗМЕРЕНО, а не предположено. Контроль на том же бинаре:
//   ВНЕ обработчика  — `HashMap[UserId, int].new()` даёт
//                      `type `UserId` does not satisfy `Hash` bound`;
//   ВНУТРИ тела      — тот же вызов давал `PASS: 1  FAIL: 0`.
// Контроль здесь важнее самой пробы: первая попытка этой проверки была
// написана на пользовательской generic-функции с bound'ом, и КОНТРОЛЬ
// оказался зелёным — то есть проба была неспособна упасть и не сказала
// бы ничего. Форма с `HashMap` взята потому, что её отказ наблюдался
// вживую (`examples/real_world/orm_demo.nv`).

module neg.d710_handler_body_bound_neg

type UserId { v int }

type D710Bound effect { go() -> int }

fn probe() -> int {
    with D710Bound = effect D710Bound {
        go() -> int {
            // nova:expect E_BOUND_NOT_SATISFIED -- bound-проверка обязана заходить в тело handler-литерала
            ro m = HashMap[UserId, int].new()
            return m.len()
        }
    } {
        7
    }
}
