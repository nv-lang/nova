// EXPECT_COMPILE_ERROR E_CHAR_RAW_CONTROL
//
// D478 §3 (решение владельца 2026-09-18, реестр 221.1 №675): сырой
// управляющий символ внутри char-литерала отвергается. Здесь — настоящая
// ТАБУЛЯЦИЯ между кавычками, а не escape `\t`.
//
// ПОЧЕМУ ЭТА КЛЕТКА ВЫГЛЯДИТ ПУСТОЙ: её предмет НЕВИДИМ. В этом весь дефект
// — прежде форма принималась молча и давала ПРАВИЛЬНЫЙ байт, так что ни тест,
// ни ревью поймать её не могли: глазу не на что смотреть. Если однажды кто-то
// «почистит» строку ниже, заменив табуляцию пробелом, клетка позеленеет и
// перестанет что-либо проверять.
module neg.d478_char_raw_tab_neg
fn main() -> () {
    // nova:expect E_CHAR_RAW_CONTROL -- между кавычками стоит байт 0x09; канон — escape `'\t'` (D478 §3)
    ro c = '	'
    ro _ = c as int
}
