//
// EXPECT_COMPILE_ERROR requires single identifier binding
//
// 2026-08-06 (№378): ожидание обновлено с общего парсерного `unexpected
// `consume` in expression` на специализированную диагностику D188. Причина —
// НЕ ослабление: до №378 lookahead-гейт `KwConsume` не пускал `(`/`{`, форма
// падала в expr-парсер раньше, чем доходила до проверки D188. №378 расширил
// гейт (деструктуризация в raw-форме `consume (a, b) = expr` стала законной),
// и та же самая форма СО scope-блоком теперь доходит до ветки D188 и получает
// точный текст. Норма не менялась: scope-block по-прежнему требует single-ident
// и по-прежнему отвергается — сменился только текст диагностики, в лучшую
// сторону. Проверено: позиция ошибки та же (22:37).
//
// Plan 110.1.1 (D188): scope-block требует **single-ident** binding.
// Destructure pattern (`consume (a, b) = init() { body }`) не
// разрешается — D188 §«Syntax» "single name". Для linear ownership
// transfer destructure → используйте raw `consume X = expr` (D180).

module neg.neg_consume_scope_destructure_binding
type Pair {
    ro a int
    ro b int
}

fn Pair.new(a int, b int) -> Pair => { a: a, b: b }

fn Pair consume @cleanup(_outcome ScopeOutcome) -> () => ()

fn bad() -> int {
    // ❌ destructure pattern в consume scope-block — invalid.
    consume (x, y) = Pair.new(1, 2) {
        x + y
    }
}
