// EXPECT_COMPILE_ERROR E_MATCH_NON_EXHAUSTIVE
//
// Реестр 221.1 №725, найдено окном 274 (novac) 2026-08-18, воспроизведено
// интегратором на своём бинаре.
//
// ЧТО БЫЛО. Проверка исчерпаемости (№703) разбирала три формы арма — `_`,
// голое имя, `Variant` — а всё остальное считала «формой вне разбора» и по
// доктрине консервативности снимала проверку СО ВСЕГО `match`. OR-образец
// `p | q | r` попадал именно туда, хотя понимается точно.
//
// ПОЧЕМУ ЭТО БЫЛО ХУЖЕ ОДНОГО ПРОПУСКА. `|` — идиоматичный способ собрать
// «здесь ничего не делаем» в одну строку, то есть проверка молча отключалась
// ровно в САМЫХ БОЛЬШИХ таблицах. Окно 274 нашло это на таблице из 64 видов
// токенов, собравшейся без двух из них; novac держится на обещании «новый
// вариант суммы ломает сборку там, где о нём надо решить», и обещание не
// держалось именно там, где оно нужнее всего.
//
// ЗАМЕР ТОГДА: те же пять вариантов с одним непокрытым — армы по одному имени
// дают E_MATCH_NON_EXHAUSTIVE, а `Green | Blue | Amber => 0` принимается, и
// собранная программа печатает нулевое значение типа результата без единой
// диагностики.

module neg.d65_or_pattern_non_exhaustive_neg

type Color enum Red | Green | Blue | Amber | White

fn code(c Color) -> int {
    // nova:expect E_MATCH_NON_EXHAUSTIVE -- `White` is not covered; the OR-pattern arm used to disable the whole exhaustiveness check, so this compiled clean and returned a zero value at runtime (registry No. 725)
    match c {
        Red => 1
        Green | Blue | Amber => 0
    }
}

fn main() Io -> () {
    println("${code(Color.White)}")
}
