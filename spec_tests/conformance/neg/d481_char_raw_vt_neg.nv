// EXPECT_COMPILE_ERROR E_CHAR_RAW_CONTROL
//
// D481 §3. Вторая клетка НЕ дубль первой: у 0x0B нет своего escape, и
// диагностика обязана предложить общую форму `'\u{...}'`, а не выдумать
// несуществующий `'\v'`. Без этой клетки подсказка, верная для табуляции,
// молча осталась бы неверной для всех остальных управляющих.
// GUARD-ALLOW-CONTROL-CHARS: 0x0B here is the SUBJECT of the test, not a
// typo -- a fixture for E_CHAR_RAW_CONTROL has to carry the raw byte, or it
// checks something other than what it claims (D481 section 3).
module neg.d481_char_raw_vt_neg
fn main() -> () {
    // nova:expect E_CHAR_RAW_CONTROL -- байт 0x0B; escape'а `\v` в языке нет, канон — `'\u{000B}'`
    ro c = ''
    ro _ = c as int
}
