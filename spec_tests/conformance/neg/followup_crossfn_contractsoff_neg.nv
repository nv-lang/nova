// Plan 140.2 followup §2 SOUNDNESS GUARD (retargeted Plan 194 A2.1: build-
// level `--contracts=off` retired — `checked`/`optimized`/`verified` all
// enforce contracts, no global bypass remains under any flag value; see
// `ContractsMode` doc in compiler-codegen/src/ast/mod.rs). Per-fn
// `#unchecked(requires)` is the closest surviving mechanism that leaves
// fn-`requires` NOT enforced (the precondition check on `at_unchecked`'s
// input is stripped). With requires unenforced for THIS fn, contract-based
// элизию `v[i]` применять НЕЛЬЗЯ — codegen-гейт (`index_site_elided`
// учитывает `contracts_elided_here()`) оставляет bounds-check → OOB (i=5
// ≥ len=3) ловится в runtime. Если бы гейт ошибочно элидировал — был бы
// UB вместо чистого panic.
// EXPECT_RUNTIME_PANIC array: index

module neg.followup_crossfn_contractsoff_neg

import std.collections.vec.{Vec}

#unchecked(requires)
fn at_unchecked(v Vec[int], i int) -> int
    requires 0 <= i && i < v.len()
{
    v[i]
}

test "contracts #unchecked(requires): contract-based v[i] NOT elided → OOB traps" {
    ro v = Vec[int].of(1, 2, 3)
    ro r = at_unchecked(v, 5)
    assert(r == 0)
}
