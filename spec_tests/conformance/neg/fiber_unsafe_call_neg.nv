// EXPECT_COMPILE_ERROR [E_FIBER_UNSAFE_CALL] call to `Counter.bump`

// Plan 238 Ф.2 (D446 "Ф.8-НОВАЯ" П.2, seeding-point enforcement): a `spawn`
// body calling a function whose total M:N-safety бирка (Ф.1,
// `compiler-codegen/src/types/fiber_safety.rs`) is NOT `Safe` is a hard
// error — умолчание перевёрнуто, "not proven ⇒ unsafe". `Counter.bump`
// mutates its own `@count` field; `Counter` is an ordinary record (no
// `#share`, no `consume`), so its бирка is `Unsafe("unguarded_mutation")`
// UNCONDITIONALLY (computed from `bump`'s own body, independent of any
// particular caller) — calling it from `spawn` is flagged even though `c`
// itself is created fresh INSIDE this very `spawn` body (no lexical
// capture at all, so D415/D441's own capture-check has nothing to say
// here — this is specifically Ф.8's transitive-call-graph half, not a
// restatement of the older capture check).

module neg.fiber_unsafe_call_neg

type Counter { mut count int }

fn Counter mut @bump() {
    @count = @count + 1
}

fn spawns_unsafe_call() {
    supervised {
        spawn {
            mut c = Counter { count: 0 }
            c.bump()
        }
    }
}
