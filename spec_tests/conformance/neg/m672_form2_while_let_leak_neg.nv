// EXPECT_COMPILE_ERROR D133-not-consumed
//
// #672 form (2): `while Some(consume r) = expr { ... }` never went through
// `consume_declare_arm_pattern` at all -- the branch declared bare names, so
// BOTH D133 and E_CONSUME_PATTERN_REQUIRED were dead there and the loop's
// guard was dropped on the floor. This program compiled without a word.
module neg.m672_form2_while_let_leak_neg

type M672W2 consume { tag int }

fn M672W2 consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

fn M672W2 consume @close() -> () { () }

fn m672_next(n int) -> Option[M672W2] {
    if n > 0 { Some(M672W2 { tag: n }) } else { None }
}

fn main() {
    mut i = 2
    // nova:expect D133-not-consumed -- the while-let pattern binding owns the resource on every iteration and gets no auto-cleanup (#672 form 2)
    while Some(consume r) = m672_next(i) {
        i = i - 1
        assert(r.tag > 0)
    }
}
