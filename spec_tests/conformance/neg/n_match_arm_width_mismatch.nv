// EXPECT_COMPILE_ERROR E_MATCH_ARM_WIDTH_MISMATCH
// [M-match-arm-mixed-int-width-sentinel-coerce] (Plan 172.2 followup, P1, fixed
// 2026-07-21): match arms with GENUINELY incompatible int-family widths — here `i32`
// (the `Some(v)` payload) vs `u32` (the `None` sentinel local) — same width, opposite
// signedness, neither direction safely widens into the other (D54 `would_narrow_into`:
// "signed → unsigned: never implicit"). Pre-fix this bailed SILENTLY out of
// `infer_match_common_primitive` and let the legacy codegen re-derive pick an arbitrary
// arm's width. Now a hard checker error — cast one arm explicitly. See the POS
// complement `d129_match_arm_width_widen.nv` (safe-widening mixes, e.g. `u32` + `int`,
// unify WITHOUT an explicit cast) and `docs/plans/172.2-method-arg-type-checking.md`.
// Spec: spec/decisions/02-types.md (D129, D54-widen amendment).
module neg.n_match_arm_width_mismatch

test "t" {
    ro o Option[i32] = None
    ro u u32 = 5
    ro r = match o {
        Some(v) => v,
        None => u,
    }
    println(r)
}
