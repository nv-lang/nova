// Plan 174.5 Ф.3 (retraction, §3/§9, D216 amend) — `*p` deref READ on a raw
// pointer is retired. Use `p.read()`.
//
// EXPECT_COMPILE_ERROR E_POINTER_OP_USE_METHOD

module neg.d216_ptr_deref_read_neg

test "rejects `*p` deref read" {
    ro x int = 42
    unsafe {
        ro p = (&x) as *int
        ro v = *p
        assert(v == 42)
    }
}
