// Plan 174.5 Ф.3 (retraction, §3/§9, D216 amend) — `p[i]` index READ on a raw
// pointer is retired. Use `p.read_at(i)`.
//
// EXPECT_COMPILE_ERROR E_POINTER_OP_USE_METHOD

module neg.d216_ptr_index_read_neg

test "rejects `p[i]` index read" {
    mut buf []int = [10, 20, 30]
    unsafe {
        ro p = buf.ptr()
        ro v = p[1]
        assert(v == 20)
    }
}
