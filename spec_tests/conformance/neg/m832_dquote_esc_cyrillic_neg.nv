// EXPECT_COMPILE_ERROR unknown escape: \я
//
// Registry 221.1 #832: the escaped character can be MULTI-BYTE, and the
// lexer used to skip a fixed TWO BYTES past a backslash -- landing inside
// the character and panicking with `byte index is not a char boundary`.
// That was an ICE on legal source: anyone writing non-Latin text in a
// string hit it, and the language server died on every keystroke.
//
// D467 section 2: inside `"..."` the escape set is CLOSED, so a character
// that is not in it must be a DIAGNOSTIC -- never a crash.
//
// THE MARKER PINS THE CHARACTER ITSELF, and that is the whole point of this
// fixture rather than a weaker `unknown escape`. On the quoted path the
// shared root had a MILDER symptom than the crash it caused in backtick
// literals: it read one BYTE as Latin-1, so the message named a character
// the source never contained -- `\я` was reported as `\Ñ`. A marker matching
// only `unknown escape` would stay green through exactly that lie.
//
// This one carries a two-byte Cyrillic letter after the backslash.
module neg.m832_dquote_esc_cyrillic_neg

fn main() Io -> () {
    // nova:expect unknown escape -- a multi-byte character is not in the closed escape set of a quoted literal (D467 section 2), so it must be a diagnostic and never a crash; the pin matches TEXT because this diagnostic carries no code
    println("\я")
}
