// [M-d55-str-literal-coercion-name-gated] fix — NEG companion to
// d55_bytes_lit_type_directed.nv. D55's str-литерал→`[]u8` coercion is
// LITERAL-only (spec/decisions/02-types.md §"почему литерал, не любое
// str-значение") — a str VARIABLE (not a bare literal) at an expected
// `[]u8` position is NOT coerced; D176 still requires an explicit
// `.bytes()`. Generalizing the coercion to be type-directed (any `[]u8`
// position, any method/fn — not just `.write(...)`) must NOT loosen this
// literal-only gate.
// EXPECT_COMPILE_ERROR [E7301]

module neg.d55_bytes_lit_var_not_coerced_neg

fn d55_bytes_lit_var_not_coerced_neg() -> int {
    ro s = "not a literal"
    ro b []u8 = s
    b.len()
}
