// EXPECT_COMPILE_ERROR no field or method `sleep_until` on type `Timestamp`

// D316/Q3 — `sleep_until` — МЕТОД, существующий ТОЛЬКО на `Monotonic`
// (дедлайн иммунен к NTP/DST) — Plan 175 Ф.2-v3: free `sleep_until`
// retracted, method-only canon (`Monotonic @sleep_until()`,
// std/time/duration/monotonic.nv). `Timestamp` has no `.sleep_until()`
// method at all — wall-clock абсолютный сон — явный
// `ts.time_until().sleep()` (footgun виден на call-site).
module neg.d316_sleep_until_timestamp_neg

import std.time.duration

fn d316_neg_sleep_until(ts Timestamp) Time -> () {
    ts.sleep_until()
}

test "probe" {
    d316_neg_sleep_until(Timestamp.now())
}
