// EXPECT_COMPILE_ERROR E_CONSUME_RECEIVER_RETURNS_AT
//
// D326 R6: `consume` receiver и `-> @` несовместимы.
module neg.d326_consume_returns_at_neg

type D326Box { v int }

fn D326Box consume @drain() -> @ {
    @
}

test "consume receiver returns at" {
    ro b = D326Box{v: 1}
    ro _ = b.drain()
    assert(true)
}
