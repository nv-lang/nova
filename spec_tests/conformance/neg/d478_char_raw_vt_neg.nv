// несуществующий `'\v'`. Без этой клетки подсказка, верная для табуляции,
// молча осталась бы неверной для всех остальных управляющих.
module neg.d478_char_raw_vt_neg
fn main() -> () {
    // nova:expect E_CHAR_RAW_CONTROL -- байт 0x0B; escape'а `\v` в языке нет, канон — `'\u{000B}'`
    ro c = ''
    ro _ = c as int
}
