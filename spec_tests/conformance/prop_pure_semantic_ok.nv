// Plan 123.3 T-PROP.1: semantic equivalence — pure method results
// invariant per call regardless of caching.

module spec_tests.conformance
type Pair4 {
    ro a int
    ro b int
}

#pure
fn Pair4 @sum() -> int => @a + @b

#pure
fn Pair4 @diff() -> int => @a - @b

fn Pair4 @combine() -> int {
    @sum() * @sum() - @diff() * @diff()
}

fn Pair4.new(a int, b int) -> Pair4 {
    Pair4 { a, b }
}

test "pure semantic preserved across various inputs" {
    // (a+b)^2 - (a-b)^2 = 4ab.
    ro p1 = Pair4.new(3, 5)
    assert(p1.combine() == 4 * 3 * 5)
    ro p2 = Pair4.new(2, 7)
    assert(p2.combine() == 4 * 2 * 7)
    ro p3 = Pair4.new(10, 1)
    assert(p3.combine() == 4 * 10 * 1)
}
