// Plan 123.3 T-NEG.3: pure methods with args → V3 skip (V3.1 enhance).

module spec_tests.conformance
type Calc1 {
    ro base int
}

#pure
fn Calc1 @add(x int) -> int => @base + x

fn Calc1 @sum() -> int {
    // @add(1) + @add(1) — same args, but V3 doesn't recognize identity.
    @add(1) + @add(1) + @add(2)
}

fn Calc1.new(b int) -> Calc1 {
    Calc1 { base: b }
}

test "pure method with args — semantic preserved (V3 skip)" {
    ro c = Calc1.new(10)
    ro r = c.sum()
    // 11 + 11 + 12 = 34.
    assert(r == 34)
}
