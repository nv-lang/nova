// D88 — Default-значения generic-параметров: `[T = Default]`.
// T имеет default когда компилятор не выводит его из аргументов.
// Inference (если есть аргументы) побеждает default.
// Явный `[T_val]` перекрывает default.
//
// Discriminator: без default generic нужно всегда писать [T] явно.
//
// Spec: spec/decisions/03-syntax.md D88. Единица: folder-module `spec_tests.conformance`.
module spec_tests.conformance

type D88Pair[A = int, B = str] { first A, second B }

fn D88Pair[A, B].make(first A, second B) -> D88Pair[A, B] => { first, second }

// D246-амендмент ([M-ro-launder-via-mut-binding], Ф.2 миграция, 2026-07-23):
// `mut val` — generic `T` не статически value-safe.
fn d88_wrap[T = int](mut val T) -> T => val

test "generic type default: omit T → inferred from args (D88)" {
    ro p = D88Pair[int, str].make(1, "hello")
    assert(p.first == 1)
    assert(p.second == "hello")
}

test "generic fn default: explicit T (D88)" {
    ro v = d88_wrap[int](42)
    assert(v == 42)
}

test "generic fn default: inferred from arg (D88)" {
    ro v = d88_wrap("text")
    assert(v == "text")
}

test "generic type explicit override: f64 (D88)" {
    ro p = D88Pair[f64, str].make(3.14, "pi")
    assert(p.first == 3.14)
    assert(p.second == "pi")
}
