// Plan 138 Ф.4 — t6: was `str.get(i) -> Option[char]` (D238 safe int-index).
// Plan 152.1 (D249 + D238 AMEND): `str.get(i)` (int) RETIRED with the lens model.
// The safe i-th codepoint went through `s.chars().nth(i)`; `@nth` is itself
// retracted (D260-амендмент, W_RETIRED_NAME) — CharsIter has no `@skip`, so the
// replacement is `.collect().get(i)` (Vec[char] `@get`), which is None on OOB /
// negative exactly like `Vec[T] @get`, so the semantics carry over exactly.

module spec_tests.conformance
test "chars().collect().get in-bounds returns Some" {
    ro s = "abc"
    assert(s.chars().collect().get(0) == Some('a'))
    assert(s.chars().collect().get(1) == Some('b'))
    assert(s.chars().collect().get(2) == Some('c'))
}

test "chars().collect().get out-of-bounds returns None" {
    ro s = "abc"
    assert(s.chars().collect().get(3) == None)
    assert(s.chars().collect().get(9) == None)
    assert(s.chars().collect().get(-1) == None)
}

test "chars().collect().get on empty string" {
    ro s = ""
    assert(s.chars().collect().get(0) == None)
}
