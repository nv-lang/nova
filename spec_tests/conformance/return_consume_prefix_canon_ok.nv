// №301 (221.1) — канон `-> consume T` (ПРЕФИКС), симметрично `-> ro T` /
// `-> mut T`. Было: `ro`/`mut` пишутся ПЕРЕД типом, а `consume` — ПОСЛЕ
// (`-> MutexGuard consume`, 5 мест в std). Решение владельца 2026-08-03:
// «модификатор ВСЕГДА стоит перед тем, что описывает» — перед именем
// привязки (ro v/mut v/consume v), перед ресивером (consume @), перед
// типом возвращаемого значения (`-> consume T`), перед телом типа
// (`consume { … }`). Постфикса не существует нигде. Миграция: 5 мест в
// std/src/runtime/sync.nv (Mutex@lock, RwLock@read/@write, Once@make_guard,
// Semaphore@acquire). D-амендмент: spec/decisions/02-types.md /
// 05-memory.md.
module spec_tests.conformance

type P301Guard consume {
    id int,
}

fn P301Guard consume @close() -> int => @id

fn p301_make(n int) -> consume P301Guard => { id: n }

test "№301 `-> consume T` — префиксная форма парсится и работает" {
    consume g = p301_make(7)
    ro id = g.close()
    assert(id == 7)
}
