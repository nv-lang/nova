// D170 — Coordination primitives: Semaphore / CountDownLatch (Plan 103.4, final).
// Норма (spec/decisions/06-concurrency.md §D170): Semaphore — счётчик разрешений
// (try_acquire/release/available_permits, Permit-guard — d174); CountDownLatch —
// one-shot счётчик (count_down/count_down_n с насыщением в 0, try_await,
// await на завершённом — мгновенный). Single-fiber-safe подмножество
// (parking Barrier/Condvar-rendezvous — runtime-корпус plan103_4).
// Шаблоны сверены с nova_tests/plan103_4. Один folder-module `spec_tests.conformance`.
module spec_tests.conformance

test "Semaphore: try_acquire (Option[Permit]) / счётчик разрешений (D170; R3-пара acquire/try_acquire)" {
    // auto-`@cleanup` РАЗВЁРНУТ обратно (обход снят): симптом №122
    // ([M-cleanup-permit-lost-in-folder-cu]) на реальном folder-CU НЕ
    // воспроизводится после №114-влития; absorb_external-гипотеза ОТВЕРГНУТА
    // доказательно (см. надгробие в types/mod.rs — 6 NEG-тестов permit_leak-
    // семьи кодируют обратное намеренно). Root cause открыт — №122 в реестре
    // как наблюдение; рецидив ЭТОГО теста = переоткрытие. Match-arm форма
    // покрыта парой standalone/permit_cleanup_folder_cu_pair.nv (§231-п.3).
    mut d170_sem = Semaphore.new(2)
    assert(d170_sem.available_permits() == 2)
    {
        consume d170_p1 = match d170_sem.try_acquire() {
            Some(consume p) => p
            None => panic("permit 1 must be available")
        }
        consume d170_p2 = match d170_sem.try_acquire() {
            Some(consume p) => p
            None => panic("permit 2 must be available")
        }
        assert(d170_sem.available_permits() == 0)
        match d170_sem.try_acquire() {
            Some(_) => assert(false)
            None    => ()
        }
    }
    assert(d170_sem.available_permits() == 2)
    {
        consume d170_p3 = match d170_sem.try_acquire() {
            Some(consume p) => p
            None => panic("permit must be available after release")
        }
        assert(d170_sem.available_permits() == 1)
    }
    assert(d170_sem.available_permits() == 2)
}

test "CountDownLatch: count_down_n с насыщением, try_await, await-на-нуле (D170)" {
    mut d170_l = CountDownLatch.new(10)
    assert(d170_l.current_count() == 10)
    d170_l.count_down_n(3)
    assert(d170_l.current_count() == 7)
    assert(d170_l.try_await() == false)
    d170_l.count_down_n(7)
    assert(d170_l.current_count() == 0)
    assert(d170_l.try_await() == true)
    d170_l.await()

    mut d170_s = CountDownLatch.new(3)
    d170_s.count_down_n(100)   // насыщение в 0, без underflow
    assert(d170_s.current_count() == 0)
}
