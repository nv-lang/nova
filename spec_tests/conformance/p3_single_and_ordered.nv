// Plan 150 / D248 — single (unchained) comparisons on ordered types stay legal.
//
// EXPECT_STDOUT: ok

module spec_tests.conformance
test "p3_single_and_ordered smoke" {
    assert(3 < 5)
    assert(5 > 3)
    assert(3 <= 3)
    assert(5 >= 3)
    assert(2 == 2)
    assert(2 != 3)
    println("ok")
}
