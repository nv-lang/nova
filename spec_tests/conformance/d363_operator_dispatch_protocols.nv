// D363 — Operator dispatch via protocols: == dispatches @equal, < dispatches @compare.
// Primitives (int/bool/f64/char) use built-in C dispatch without method call.
// User types dispatch == via @equal and </<=/>/>=  via @compare (returns int sign).
// Spec: spec/decisions/03-syntax.md D363. Part of the SINGLE `spec_tests.conformance` folder-module.
module conformance.d363_operator_dispatch_protocols

type D363Item { value int }

fn D363Item @equal(other D363Item) -> bool => @value == other.value
fn D363Item @compare(other D363Item) -> int =>
    if @value < other.value { -1 } else if @value > other.value { 1 } else { 0 }

test "== and != dispatch through @equal on user type (D363)" {
    ro a = D363Item { value: 42 }
    ro b = D363Item { value: 42 }
    ro c = D363Item { value: 99 }
    assert(a == b)
    assert(a != c)
}

test "< and > dispatch through @compare on user type (D363)" {
    ro small = D363Item { value: 1 }
    ro big   = D363Item { value: 9 }
    assert(small < big)
    assert(big > small)
    assert(small <= big)
    assert(big >= small)
    assert(small <= small)
    assert(big >= big)
}
