// EXPECT_STDOUT private=7
//
// КОНТРОЛЬНАЯ клетка к запрету №701 (а). Её дело — не дать принять запрет за
// поломку модульного `ro` вообще: ПРИВАТНЫЙ модульный `ro` законен, живёт в
// std десятками и обязан работать. Отвергается ровно сочетание `export` +
// голое имя.
//
// Без этой клетки negative-фикстура рядом была бы зелёной и у компилятора,
// который сломал модульный `ro` целиком.
//
// ИНИЦИАЛИЗАТОР РАНТАЙМНЫЙ намеренно: модульный `ro` с constexpr-правой
// частью отвергает ДРУГОЕ правило — строгий раздел `const`/`ro` (D199,
// `E_RO_FOR_CONSTEXPR_PREFER_CONST`). Клетка про экспорт не должна зависеть от
// соседнего запрета.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ — ЭТО ЗАМЕР, А НЕ ЗАБЫВЧИВОСТЬ. Сюда просилась вторая
// половина: КВАЛИФИЦИРОВАННАЯ форма `ro Cfg.DEFAULT int = …`. Она сломана, и
// замер трёх её видов даёт вывод хуже, чем «один случай не работает»:
//   `ro Cfg.NAME int = f()`  — сборка падает, `lld-link: undefined symbol` на
//                              функцию-инициализатор (в ОДНОМ файле, без
//                              всякого экспорта);
//   `ro Cfg.NAME int = 41`   — отвергается ПРАВИЛОМ: строгий раздел
//                              `const`/`ro` действует и на ассоциированном
//                              уровне (`E_RO_FOR_CONSTEXPR_PREFER_CONST`,
//                              D200-амендмент) и требует писать `const`;
//   `const Cfg.NAME int = 41` — работает, печатает 41.
// ТО ЕСТЬ У АССОЦИИРОВАННОГО `ro` НЕ ОСТАЁТСЯ НИ ОДНОЙ РАБОЧЕЙ ФОРМЫ: то, что
// правило разрешает, компилятор не собирает, а то, что собралось бы, правило
// запрещает. Это половина (б) строки реестра №701, у неё своя починка.
//
// ПЕРВАЯ РЕДАКЦИЯ ЭТОГО КОММЕНТАРИЯ УТВЕРЖДАЛА, что constexpr-форма работает.
// Это была догадка в костюме факта: я не запускал её. Запустил — отвергается
// правилом. Оставляю след, потому что комментарий в фикстуре читают как замер.
module standalone.d200_export_ro_private_ok

fn seven() -> int => 7

ro private_universe int = seven()

fn main() Io -> () {
    println("private=${private_universe}")
}
