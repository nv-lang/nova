// EXPECT_STDOUT 5 2 5 1|5 2 5 1|5 2 5 1|5 2 5 1
// Один литерал `[5, 2, 5, 1]` в слоте `[]u8` отвечает ОДИНАКОВО в четырёх позициях:
// модульная константа, локальный `ro`, поле записи, возврат функции (реестр 221.1
// №1008 — там же названа пятая, позиция аргумента, которую чекер пока отвергает
// своей отдельной диагностикой; она закрывается той строкой, не этой фикстурой).
//
// Фикстура заведена как ХРАНИТЕЛЬ РАВЕНСТВА позиций: до фикса три из четырёх
// печатали верное, а константа — `5 0 0 0`, и расхождение обнаружилось случайно,
// при работе над сторонним планом. Здесь оно обнаружится прогоном.
module standalone.array_literal_same_in_every_position

const K []u8 = [5, 2, 5, 1]

type Box { ro t []u8 }

fn make() -> []u8 => [5, 2, 5, 1]

fn show(t []u8) Io -> () => print("${t[0]} ${t[1]} ${t[2]} ${t[3]}|")

fn main() Io -> () {
    show(K)
    ro local []u8 = [5, 2, 5, 1]
    show(local)
    ro b = Box { t: [5, 2, 5, 1] }
    show(b.t)
    print("${make()[0]} ${make()[1]} ${make()[2]} ${make()[3]}")
}
