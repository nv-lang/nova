// EXPECT_STDOUT n=10 t=9 r=13 z=0 q=39 d=34 bs=92 u=128512
//
// D478 §2: закрытый набор escape в char-литерале. Клетка позитивная и
// намеренно проверяет ЗНАЧЕНИЯ, а не факт компиляции: запрет сырых
// управляющих (§3) обязан оставить escape'ы нетронутыми, а «собралось» об
// этом не говорит ничего.
//
// ЧЕГО ЗДЕСЬ НЕТ И ПОЧЕМУ: `\b` и `\f` компилятор ОТВЕРГАЕТ (`unknown char
// escape`), хотя старая страница открытых вопросов их называла; формы
// `\uHHHH` без фигурных скобок тоже нет. D478 §2 записан по ЗАМЕРУ, и эта
// клетка — тот самый замер.
module standalone.d478_char_escapes

fn main() Io -> () {
    ro n = '\n'
    ro t = '\t'
    ro r = '\r'
    ro z = '\0'
    ro q = '\''
    ro d = '\"'
    ro bs = '\\'
    ro u = '\u{1F600}'
    println("n=${n as int} t=${t as int} r=${r as int} z=${z as int} q=${q as int} d=${d as int} bs=${bs as int} u=${u as int}")
}
