// EXPECT_STDOUT 17218479456385750618 2 3|7 8 9|5 2 5 1
// Модульная `const [N]T` собирается И индексируется (реестр 221.1 №998, блокер тега).
//
// Две половины, обе были красные. Первая: одно ОБЪЯВЛЕНИЕ красило каждый CU, в чьё
// замыкание прелюдии попадал файл, — «assigning to `_NovaFixArr_651_8_uint64_t` from
// incompatible type `Nova_Vec____nova_int *`», потому что слот фиксированный массив,
// а значение строилось Vec-указателем. Вторая: индексация давала внутреннюю панику
// `[E_CODEGEN_TYPE_UNKNOWN] Index element type unknown for obj_ty="_NovaFixArr_..."` —
// тип элемента ЗАКОДИРОВАН в имени, но путь индексации об этом не спрашивал.
//
// Три типа элемента: `u64` (носитель окна 283), `int` (доказывает, что дело не в u64)
// и `u8` (узкий — обе половины на элементе шириной байт).
module standalone.const_fixed_array_decl_and_index

const A [3]u64 = [0xEEF453D6923BD65A, 2, 3]
const C [3]int = [7, 8, 9]
const N [4]u8 = [5, 2, 5, 1]

fn main() Io -> () {
    print("${A[0]} ${A[1]} ${A[2]}|")
    print("${C[0]} ${C[1]} ${C[2]}|")
    print("${N[0]} ${N[1]} ${N[2]} ${N[3]}")
}
