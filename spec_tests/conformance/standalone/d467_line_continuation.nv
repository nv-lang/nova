// EXPECT_STDOUT abc def=7
// D467 §3 (план 277 Ф.1): `\` перед переводом строки — продолжение строки.
// Съедает и сам перенос, и ведущие пробелы/табы следующей строки, оставляя
// ОДИН литерал: длинный текст без переводов строк пишется в несколько строк
// исходника. До D467 `\`+перенос был `unknown escape` (слот был свободен),
// поэтому позитивная фикстура достаточна — форма была ошибкой, стала законной.
// Проба обе стороны: снять арм `b'\r' | b'\n'` в lexer/mod.rs — этот файл
// перестанет компилироваться (`unknown escape`), то есть краснеет без фикса.
module standalone.d467_line_continuation

fn joined() -> str {
    "abc \
     def"
}

fn main() Io -> () {
    ro s = joined()
    println("${s}=${s.byte_len()}")
}
