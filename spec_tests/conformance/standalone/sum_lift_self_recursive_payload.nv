// EXPECT_STDOUT k0
// EXPECT_STDOUT k2
// EXPECT_STDOUT w9
// EXPECT_STDOUT inner2
// EXPECT_STDOUT n0
// EXPECT_STDOUT s9
// EXPECT_STDOUT loop-ok
// EXPECT_STDOUT box0
// EXPECT_STDOUT lift2
//
// Pin: registry 221.1 zz146 — the D55 single-wrapper sum-lift must be IDENTITY
// when the value's own type IS the target sum type. A self-recursive
// single-field variant (`S9(ZZVal)` inside `ZZVal` itself) matched the bare
// value's kind exactly, so `pick_wrap_candidate` chose it and the bare value
// was re-wrapped at call-argument and return-tail positions:
// `kind(N0)` compiled as `kind(S9(N0))` (kind 9 instead of 0), and the
// recursive `norm(inner, x)` became `norm(inner, S9(x))` — the payload never
// got peeled, so the normalizer looped forever ("loop at 0: kind=9").
// Carrier: alula's runtime Value (`| SomeV(SomeBox{inner Value})` workaround),
// repro verified red on official Oracle 0.1.2 and 0.1.3; the workaround's
// removal condition is "an official Oracle whose notes fix the sum-lift of a
// bare value into a self-recursive variant, with repro A green".
//
// Fixed in `pick_wrap_candidate` (types/mod.rs): a `Named(X)` found-kind whose
// X equals the target type's own name returns None — one answer for the
// checker (`assignable`) and the rewrite pass (`try_wrap_leaf`/
// `wrap_return_tail`), per #1637. The box form (payload behind a record) never
// wrapped and stays green; the LEGITIMATE lift (a foreign-typed leaf into the
// sum, `lift5`) must keep working.
module standalone.sum_lift_self_recursive_payload

type ZzVal
    | ZzN0
    | ZzI2(int)
    | ZzT4(str)
    | ZzL5([]ZzVal)
    | ZzS9(ZzVal)

type ZzSpec
    | ZzSInt
    | ZzSText
    | ZzSOpt(ZzSpec)

fn kind(v ZzVal) -> int {
    match v {
        ZzN0 => 0
        ZzI2(n) => 2
        ZzT4(s) => 4
        ZzL5(xs) => 5
        ZzS9(x) => 9
    }
}

fn norm(spec ZzSpec, v ZzVal) -> ZzVal {
    match spec {
        ZzSOpt(inner) => {
            match v {
                ZzN0 => v
                ZzS9(x) => ZzS9(norm(inner, x))
                _ => ZzS9(norm(inner, v))
            }
        }
        _ => v
    }
}

type ZzBox { inner ZzVal }

fn kind_box(b ZzBox) -> int {
    kind(b.inner)
}

fn main() {
    // A1 — bare UNIT-VARIANT constructor as a call argument: no wrap.
    println("k${kind(ZzN0)}")
    // A2 — a constructor call as a call argument: no wrap.
    println("k${kind(ZzI2(5))}")
    // A3 — bare variable (norm's wrap result) as a call argument: no wrap.
    ro w = norm(ZzSOpt(ZzSInt), ZzI2(5))
    println("w${kind(w)}")
    // A4 — pattern-bound payload as a call argument: no wrap.
    match w {
        ZzS9(inner) => println("inner${kind(inner)}")
        _ => println("inner?")
    }
    // A5 — return tail of the inner match: bare ZzN0 must NOT be wrapped.
    ro n = norm(ZzSOpt(ZzSInt), ZzN0)
    println("n${kind(n)}")
    // A6 — the S9 arm keeps the source's own wrap: kind 9.
    ro s = norm(ZzSOpt(ZzSInt), ZzS9(ZzI2(7)))
    println("s${kind(s)}")
    // A7 — the normalizer loop terminates with kinds intact.
    mut i = 0
    mut ok = true
    while i < 3000 {
        ro v = norm(ZzSInt, ZzI2(i))
        if kind(v) != 2 { ok = false }
        i += 1
    }
    println("loop-${if ok { "ok" } else { "bad" }}")
    // B — the box form (payload behind a record): the carrier workaround.
    ro b = ZzBox{inner: ZzN0}
    println("box${kind_box(b)}")
    // C — positive control: the LEGITIMATE single-wrapper lift still fires —
    // a bare int literal accepted into an annotated ZzVal binding wraps into
    // ZzI2 (the checker's own fallback path, unchanged by the fix).
    ro lifted ZzVal = 5
    println("lift${kind(lifted)}")
}
