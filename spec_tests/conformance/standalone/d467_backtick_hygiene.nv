// EXPECT_STDOUT block=19 tight=16 one=5 inner=10
// D467 §7 (план 277 Ф.5): гигиена тела backtick в БЛОЧНОЙ форме — четыре
// правила, и все четыре меряются длиной в байтах, а не глазами.
//
//   1. перевод строки сразу за открывающим backtick — НЕ содержимое;
//   2. снимается общий отступ (минимум по непустым строкам И по строке
//      закрывающего backtick — правило Java text blocks);
//   3. хвост симметричен голове: перевод последней содержательной строки
//      остаётся, строка закрывающего backtick содержимого не даёт;
//   4. `\r\n` в теле нормализуется в `\n` — правило есть, но меряется НЕ ЗДЕСЬ:
//      в git файл хранится с LF, и фикстура с CRLF зависела бы от настроек
//      выкачки. Эта ось закреплена юнит-тестом парсера (`crlf_normalized`),
//      где вход задаётся строкой в коде и от git не зависит вовсе.
//
// ПРОБА ОБЕ СТОРОНЫ (замер 2026-08-30, не арифметика на бумаге): если вернуть
// `indent = 0` в `backtick_block_shape`, `block` даёт 27 вместо 19 и `inner` 22
// вместо 10 — фикстура краснеет на обеих. Числа ниже — вывод настоящего
// прогона, а не ожидание автора: первая редакция этой фикстуры несла
// придуманные 24/17/5/8 и покраснела, что и было первой пробой.
module standalone.d467_backtick_hygiene

fn main() Io -> () {
    // Голова съедена, отступ 4 снят, хвостовой перевод один:
    // "line one is here\n" (17) + "x\n" (2) = 19.
    ro block = `
    line one is here
    x
    `
    // Закрывающий backtick сразу за содержимым — хвостового перевода НЕТ:
    // "line one is here" = 16.
    ro tight = `
    line one is here`
    // Однострочная форма не меняется: ни головы, ни хвоста, ни отступа.
    ro one = `plain`
    // Отступ — минимум по ВСЕМ непустым строкам И по строке закрывающего
    // backtick: min(8, 6, 6) = 6, значит "  deep\n" (7) + "up\n" (3) = 10.
    // Именно это и есть запасной выход Java text blocks: сдвинул закрывающий
    // backtick левее — получил более широкое поле.
    ro inner = `
        deep
      up
      `
    println("block=${block.byte_len()} tight=${tight.byte_len()} one=${one.byte_len()} inner=${inner.byte_len()}")
}
