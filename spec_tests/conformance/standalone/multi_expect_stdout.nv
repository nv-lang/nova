// EXPECT_RUNTIME_PANIC panic: done
//
// ОЖИДАНИЕ ИСПРАВЛЕНО 2026-08-16 (№445, план 173.4 Ф.2): стояло
// `unhandled Fail (D158 composite): done` при том, что здесь `panic`, а три
// `defer`'а только печатают. Предмет фикстуры — ПОРЯДОК LIFO (THIRD,
// SECOND, FIRST) — не тронут и проверяется строками stdout ниже.
// EXPECT_STDOUT FIRST
// EXPECT_STDOUT SECOND
// EXPECT_STDOUT THIRD
//
// multi-EXPECT: test-runner проверяет несколько EXPECT_STDOUT паттернов
// одновременно с EXPECT_RUNTIME_PANIC. До fix'а только первый маркер
// проверялся. После fix'а все паттерны из Vec<ExpectMarker> проверяются.

module standalone.multi_expect_stdout
fn main() Io -> () {
    defer { println("FIRST") }
    defer { println("SECOND") }
    defer { println("THIRD") }
    panic("done")
}
