// EXPECT_STDOUT plain=named noelse=ok value=7 nested_value=9 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №764, план 274.10 пункт 4. Вложенный `if Some(..)`, внутренняя
// ветвь которого уходит `return`'ом, выдавал в C строку ` _nv_if_let_NNN;` —
// БЕЗ ТИПА, то есть не объявление, а чтение необъявленного имени. `check`
// проходил, падал clang: `use of undeclared identifier '_nv_if_let_493'`.
//
// ПРИЧИНА — ДВЕ ДВЕРИ НА ОДИН ВОПРОС, а не область видимости, как значилось в
// реестре. Вывод типа (`infer_expr_c_type`, ветка `IfLet`) спрашивал канал
// ТОЛЬКО по трейлингам ветвей; у ветви, уходящей `return`'ом, трейлинга нет
// вовсе, у пустого `else` — тоже, и ответом становилась ПУСТАЯ СТРОКА. Эмиссия
// того же узла в этом же случае пишет `nova_unit`. Замер: трассировка печатала
// `result_ty=""` у внешней временной и `result_ty="nova_unit"` у внутренней.
//
// ОСЬ, КОТОРОЙ НЕ БЫЛО В ОПИСАНИИ, И БЕЗ КОТОРОЙ ДЕФЕКТ НЕ ВИДЕН: `else` У
// ВНУТРЕННЕГО if-let. Носитель в Карине называл три условия (вложенность,
// `return`, код после внешнего `if`) — по ним написанная проба оказалась
// ЗЕЛЁНОЙ, и человек, проверяющий «по описанию», заключил бы, что дефекта нет.
// Поэтому клетка `noelse` стоит здесь как КОНТРОЛЬ: она была зелёной и до
// починки, и её задача — не дать принять за фикс то, что чинит лишь одну форму.
//
// КЛЕТКА `value` СТЕРЕЖЁТ МОЮ СОБСТВЕННУЮ ПРАВКУ С ДРУГОЙ СТОРОНЫ. Починка
// отвечает `nova_unit` там, где значения нет ПО ПОСТРОЕНИЮ (трейлинга нет ни у
// одной ветви). Если бы она отвечала так всегда, if-let-ВЫРАЖЕНИЕ со значением
// молча получило бы тип `unit` — то есть громкий отказ сборки превратился бы в
// тихо неверный тип, что хуже исходного дефекта. `value` и `nested_value`
// требуют настоящих чисел и краснеют ровно на таком «переусердствовании».
module standalone.p764_nested_if_let_return

fn refusal(n int) -> Option[str] => if n == 1 { Some("named") } else { None }
fn only_row(n int) -> Option[int] => if n > 0 { Some(n) } else { None }

// Клетка `plain`: внешний if-let, внутренний if-let С `else`, внутренняя ветвь
// несёт `return`, за внешним `if` следует ещё одно ветвление. Ломалось.
fn report(n int) -> str {
    ro only = only_row(n)
    if Some(row) = only {
        if Some(why) = refusal(row) {
            return why
        } else {
            // Связывается: причина в типах, названа ниже.
        }
    } else {
        // Перегружено или неизвестно: вопросы ниже отвечают.
    }
    if n > 100 { "many" } else { "arity" }
}

// Клетка `noelse`: то же самое БЕЗ `else` у внутреннего. Было зелено всегда —
// контроль против «починил одну форму и счёл класс закрытым».
fn report_noelse(n int) -> str {
    if Some(row) = only_row(n) {
        if Some(why) = refusal(row) {
            return why
        }
    }
    "ok"
}

// Клетки `value` / `nested_value`: if-let как ВЫРАЖЕНИЕ со значением — тип
// обязан остаться настоящим, а не стать `unit`.
fn value_of(n int) -> int {
    ro v = if Some(row) = only_row(n) { row + 6 } else { 0 }
    v
}

fn nested_value_of(n int) -> int {
    ro v = if Some(row) = only_row(n) {
        if Some(_) = refusal(row) { row + 8 } else { row + 7 }
    } else { 0 }
    v
}

fn main() {
    println("plain=${report(1)} noelse=${report_noelse(2)} value=${value_of(1)} nested_value=${nested_value_of(1)} ok")
}
