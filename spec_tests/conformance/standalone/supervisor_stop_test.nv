// supervisor_stop_test.nv — Plan 173.2 pos-тест: политика `Stop`.
//
// Гейт плана: `with Supervisor = sup.stop()` — N детей, один падает →
// остальные НЕ отменяются, scope продолжает (ошибка наружу НЕ летит).
// Упавший ребёнок «выкинут» (Erlang temporary): его ошибка остаётся
// retained per-slot (173.0), но не эскалируется.
//
// Детектор «ошибка НЕ вышла наружу»: тесты НЕ оборачиваются в `with Fail`
// — если бы Stop не сработал (escalate), supervised перевыбросил бы ошибку
// на main-flow и тест упал бы сам. Прохождение теста + счётчик done =
// доказательство обеих половин семантики.
//
// Бежит ARMED на дефолтном worker-count (M:N — периметр политики).

module standalone.supervisor_stop_test
import std.concurrency.supervisor as sup
// Plan 175.2 Ф.2-v4 (П6): (5).to_millis() used to resolve without an
// explicit import — an accidental side effect of Time (and its
// Duration/Timestamp/Monotonic import) living in std.prelude.effects
// (auto-imported into every CU). Now that Time moved to std.time.duration,
// this file needs its own explicit import for the to_millis() blanket.
import std.time.duration

test "Supervisor=stop: один падает — siblings доживают, scope продолжает" {
    ro n = 8
    mut done = AtomicInt.new(0)
    mut after_scope = 0
    with Supervisor = sup.stop() {
        supervised {
            for i in 0..n {
                ro tag = i
                spawn {
                    if tag == 3 {
                        throw 4242
                    }
                    // Пережить момент падения ребёнка 3: yield-точка — при
                    // escalate-политике здесь бы прилетела отмена.
                    20.to_millis().sleep()
                    done.fetch_add(1)
                }
            }
        }
        after_scope = 1
    }
    // Scope продолжил (ошибка не вышла), все 7 siblings доработали.
    assert(after_scope == 1)
    assert(done.load() == n - 1)
}

test "Supervisor=stop: несколько падений — все выкинуты, scope продолжает" {
    ro n = 12
    mut done = AtomicInt.new(0)
    mut after_scope = 0
    with Supervisor = sup.stop() {
        supervised {
            for i in 0..n {
                ro tag = i
                spawn {
                    if tag % 3 == 0 {
                        throw 1000 + tag
                    }
                    10.to_millis().sleep()
                    done.fetch_add(1)
                }
            }
        }
        after_scope = 1
    }
    assert(after_scope == 1)
    assert(done.load() == n - 4)   // 0,3,6,9 упали — 8 доработали
}

test "Supervisor=stop: panic ребёнка тоже доходит до решения (Stop глотает на границе fiber'а)" {
    ro n = 4
    mut done = AtomicInt.new(0)
    mut after_scope = 0
    with Supervisor = sup.stop() {
        supervised {
            for i in 0..n {
                ro tag = i
                spawn {
                    if tag == 0 {
                        panic("child catastrophe")
                    }
                    10.to_millis().sleep()
                    done.fetch_add(1)
                }
            }
        }
        after_scope = 1
    }
    assert(after_scope == 1)
    assert(done.load() == n - 1)
}
