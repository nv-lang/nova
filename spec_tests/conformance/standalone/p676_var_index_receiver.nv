// EXPECT_STDOUT lit=3 local=3 param=3 field=3 bound=3 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №676, план 274.10 пункт 2. Метод, вызванный на `xs[i]` с
// ПЕРЕМЕННЫМ индексом, берёт ресивером КОНТЕЙНЕР, а не элемент.
//
// ТИХАЯ ФОРМА ХУЖЕ ГРОМКОЙ, и она здесь основная: когда у контейнера есть метод
// с тем же именем — а `len` есть у всякого Vec — ничто не отвергается, и
// программа отвечает числом КОНТЕЙНЕРА. `xs[i].len()` печатает 1 (длину
// внешнего вектора) вместо 3 (длину внутреннего). Громкая половина живёт
// отдельно: `docs/dev/repro/o1/676_var_index_method` даёт
// `E_RECV_METHOD_MISMATCH`.
//
// ПЯТЬ КЛЕТОК — ЭТО ИЗМЕРЕННАЯ ГРАНИЦА (замер 2026-08-18), а не пять похожих
// вызовов. Дефект зависит от ДВУХ вещей сразу: каков индекс и откуда взялся
// контейнер:
//   lit    литеральный индекс           — было ВЕРНО и обязано остаться;
//   local  переменный индекс, локаль    — было НЕВЕРНО (1 вместо 3);
//   param  переменный индекс, параметр  — было НЕВЕРНО;
//   field  переменный индекс, ПОЛЕ      — было ВЕРНО, и это подсказка о причине:
//          у поля тип ресивера спрашивают у канала, у локали — угадывают;
//   bound  промежуточный биндинг        — было ВЕРНО, и это тот самый обход,
//          которым Карина платит: `ro pj = vec[j]` в ДЕВЯТИ файлах.
//
// Клетки `lit`, `field` и `bound` здесь не для полноты: они держат границу с
// другой стороны. Починка, которая чинит `local`/`param` и ломает их, выглядела
// бы зелёной на трёх клетках из пяти.
//
// ПОЧЕМУ ВЕКТОР ВЕКТОРОВ, А НЕ СТРОКИ, как в августовском репро: `str.len()`
// снят (D249, у строки три разные длины), и старое репро протухло вместе с
// языком. Предмет от этого не меняется — нужен лишь контейнер, у которого есть
// метод с тем же именем, что у элемента.
module standalone.p676_var_index_receiver

type Holder { datas [][]int }

fn via_param(xs [][]int, i int) -> int => xs[i].len()

fn main() {
    ro xs [][]int = [[10, 20, 30]]
    ro i = 0
    ro h = Holder { datas: [[10, 20, 30]] }
    ro bound = xs[i]
    println("lit=${xs[0].len()} local=${xs[i].len()} param=${via_param(xs, i)} field=${h.datas[i].len()} bound=${bound.len()} ok")
}
