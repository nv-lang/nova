// neg_max_clamp.nv — Plan 149 D233 AC5: NOVA_FIBERS_PER_WORKER above SLOT_COUNT_MAX →
// clamp + warn, NEVER crash.
//
// NOVA_FIBERS_PER_WORKER=999999999 far exceeds the compile-time SLOT_COUNT_MAX
// (262144 on 64-bit / Windows). The arena rounds up to a multiple of 64 then
// CLAMPS to MAX, printing ONE stderr warning ("exceeds max ... clamped"). The
// program runs normally on the clamped slot count and exits 0. EXPECT_STDERR
// asserts the clamp warning; the test passing asserts no crash.
//
// NOVA_MAXPROCS=1 keeps it to one worker arena.
//
// ENV NOVA_FIBERS_PER_WORKER=999999999
// ENV NOVA_MAXPROCS=1
// EXPECT_STDERR exceeds max

module standalone.neg_max_clamp
test "huge NOVA_FIBERS_PER_WORKER: clamped to MAX, fibers still spawn" {
    // Plan 173.3 (D415 §2): Atomic* вместо mut-захвата (E_CONCURRENT_MUT_CAPTURE).
    mut total = AtomicInt.new(0)
    supervised {
        mut i = 1
        while i <= 25 {
            ro cur = i
            spawn { total.fetch_add(cur) }
            i += 1
        }
    }
    // 1 + 2 + ... + 25 = 325
    assert(total.load() == 325)
}
