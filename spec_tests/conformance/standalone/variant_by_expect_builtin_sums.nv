// EXPECT_STDOUT 3
// EXPECT_STDOUT 4
// EXPECT_STDOUT 5
// EXPECT_STDOUT 0
// EXPECT_STDOUT 7
//
// Pin: registry 221.1 №1647 (oracle regression of the 0.1.3 module-local-wins
// keystone) — a bare variant-ctor call resolves by the POSITION'S EXPECTED
// type when that type is a generic builtin sum (Option/Result), BEFORE the
// file-local sum preference. A file that declares its own `Ok`/`Err`/`None`
// beside the language's `Result`/`Option` used to make `Ok(3)` under a
// `Result[int, int]` parameter infer the file's sum (E7301 Verdict vs
// Result), where novac — D478 rule 2 — accepts; the novac-differential gate
// caught it (fixture variant_by_expect/pos_1, red since the 0.1.3 keystone,
// green at fb91c3c9b 2026-10-02).
//
// Fixed in `TypeCheckCtx::assignable` (types/mod.rs): on a direct mismatch,
// `expected_builtin_variant_sum` recognizes the bare ctor call against the
// expected Option/Result and accepts the expected sum's reading (one answer
// with emit's own Result/Ok/Err lowering arm). Non-generic user sums keep the
// №658 channel path (fixture variant_by_expect/pos_2 — green throughout).
module standalone.variant_by_expect_builtin_sums

type Verdict enum
    | Ok(int)
    | Err(int)
    | None

fn take(r Result[int, int]) -> int {
    match r {
        Ok(x) => x
        Err(e) => e
    }
}

fn opt() -> Option[int] => None

fn mine() -> Verdict => Ok(7)

fn main() {
    // The call argument position: expected Result wins over the file's Verdict.
    println(take(Ok(3)))
    // The annotated-binding position.
    ro r Result[int, int] = Err(4)
    println(take(r))
    // Some against Option with the file's own None in scope.
    ro o Option[int] = Some(5)
    match o {
        Some(x) => println(x)
        None => println(0)
    }
    // The language's None under an Option-returning call.
    match opt() {
        Some(x) => println(x)
        None => println(0)
    }
    // The file's OWN sum still works on its own positions.
    match mine() {
        Ok(x) => println(x)
        Err(e) => println(e)
        None => println(-1)
    }
}
