// CONTRACTS checked
// EXPECT_RUNTIME_PANIC assert failed: r > 0
//
// Plan 194 A2.2 (D421 §3) companion to t6_debug_prefix_erased_optimized.nv:
// `#debug assert(r > 0)` violated (r = -2; `bad` here carries NO contracts
// of its own, so the call itself cannot fire first) under `checked` — NOT
// erased, aborts. The same violated assert under `optimized` is erased —
// see t6_debug_prefix_erased_optimized.nv.

module standalone.t6_debug_prefix_checked_assert_panics

fn bad(x int) -> int
=> x * 2

fn main() Io -> () {
    ro r = bad(-1)
    #debug assert(r > 0)
    println("UNREACHABLE")
}
