// EXPECT_STDOUT scalar=7 nested=9 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №760, план 274.10 пункт 1. Возврат `ro`-связанного NEWTYPE над
// стековым носителем отвергался `E_READONLY_COERCE` с доводом «запись у
// caller'а была бы видна источнику» — для копируемого носителя это не может
// быть верно по построению.
//
// ЧЕГО ЭТО СТОИЛО КАРИНЕ: десять обходов в шести файлах (маркер
// `LEGACY-#760-newtype-ro-launder`), включая дверь `types/types.nv:same_ty`,
// где тот же id пересобирался ЗАНОВО только чтобы отказ не сработал. То есть
// дефект оракула был виден в её коде как лишняя машинерия — ровно тот признак,
// по которому налог и опознаётся.
//
// ДВЕ КЛЕТКИ — ЭТО ГЛУБИНА НОСИТЕЛЯ, а не два похожих случая: newtype над
// примитивом и newtype НАД NEWTYPE (рекурсия обязана дойти до дна). Без второй
// клетки правка «развернуть один слой» выглядела бы полной.
//
// ТРЕТЬЯ КЛЕТКА БЫЛА НАПИСАНА И СНЯТА, и причина названа: newtype над
// ИМЕНОВАННЫМ КОРТЕЖЕМ чекер после этой правки пропускает (проверено отдельно —
// `nova check` даёт PASS), а падает КОДОГЕН: `unknown type name NovaTuple_Pair`.
// Это другой слой и другой дефект; держать его здесь значило бы красить эту
// фикстуру чужой причиной.
//
// ЧЕГО ФИКСТУРА НЕ ПОКРЫВАЕТ: newtype над HEAP-типом — там изъятие НЕВЕРНО и
// отказ обязан остаться. Эта сторона проверяется выключателем, а не клеткой.
module standalone.p760_newtype_ro_return_pos

type TyId int
type Inner TyId

fn same(t TyId) -> TyId => t

fn same_nested(t Inner) -> Inner => t

fn main() {
    ro a = TyId(7)
    ro n = Inner(TyId(9))
    println("scalar=${same(a).0} nested=${same_nested(n).0.0} ok")
}
