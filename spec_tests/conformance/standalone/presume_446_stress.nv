// presume_446_stress.nv — stress repro for 221.1 registry entries №446/№447
// EXPECT_TIMEOUT_MS 420000
//   Свой бюджет, а не общий: замер 2026-09-04 — ОДНА на свободной машине
//   8с, внутри полного conformance убита на 64.7с (дважды). Фикстура будит
//   тысячи запаркованных файберов на нескольких воркерах, и под параллельным
//   корпусом соревнуется за ядра с ним же. 180с было 2.7x от наблюдавшейся
//   тогда точки убийства, а не круглое число.
//
//   ПОДНЯТО ДО 420с 2026-09-05, И ПРИЧИНА ВАЖНЕЕ ЧИСЛА: в ночном прогоне
//   гейта фикстура снята на 186.5с — то есть ТОЧКА УБИЙСТВА УЕХАЛА с 64.7с
//   до >180с за одни сутки, пока корпус и сам гейт росли. Бюджет, выраженный
//   как «столько-то раз от наблюдавшейся точки», стареет молча: множитель
//   выглядит запасом, а мерит вчерашнюю нагрузку. Проверено в тот же час:
//   с `--timeout 300` фикстура ПРОХОДИТ, то есть код не сломан — краснела
//   среда. 420с — 2.25x от сегодняшних 186.5с.
//
//   И это ВТОРОЙ носитель одного класса за сутки: шаг `crate-tests` в гейте
//   так же снимался своим пределом (601с при 61с на тёплом кэше) и читался
//   как «тесты красные». Класс — «предел выставлен по ненагруженному случаю,
//   а шаг встречает нагруженный»; лечится замером под нагрузкой, а не
//   урезанием работы. Работа этой фикстуры не тронута ни тогда, ни теперь.
//   РАБОТА ФИКСТУРЫ НЕ ТРОНУТА НАМЕРЕННО: урезать раунды ради того, чтобы
//   влезть в общий бюджет, значит ослабить тест — а тест здесь авторитет.
// (окно presume-cas-gate, 2026-08-08).
//
// GOAL: try to organically materialize the "duplicate pop of an already-
// dead `co`" race described in №446 (runtime.c:1340-1350/1416-1454 pre-
// fix) — many CONCURRENT fibers parked at once, woken by a SINGLE mass
// `tok.cancel()` (the boehm-eager-cost trigger shape from mn-coding-
// conventions.md §10: "массовый tok.cancel() будит 2000 запаркованных
// файберов разом"), spread across MULTIPLE workers (NOVA_MAXPROCS>1) so
// cross-worker steal / wake_pending duplicate-push races (runtime.c
// :1327-1334) have real concurrency to race under, repeated across many
// ROUNDS within a single process run to multiply attempts.
//
// Run under scripts/tools/stress_bisect.sh with NOVA_DIAG_446=1 set in the
// environment (the direct-.exe path does NOT honour `// ENV` directives —
// export NOVA_MAXPROCS by hand for a stress run, see debugging-races.md
// §3.3). `nova test` (this file's own harness) DOES honour the ENV
// directives below for a single run.
//
// ENV NOVA_MAXPROCS=8
// ENV NOVA_FIBERS_PER_WORKER=4000

module standalone.presume_446_stress

import std.time.duration

test "stress: repeated mass-cancel of many concurrently parked fibers, multi-worker (221.1 №446/№447 diagnosis)" {
    for _round in 0..50 {
        ro tok = CancelToken.new()
        supervised(cancel: tok) {
            for _ in 0..400 {
                spawn { 2_000.to_millis().sleep() }
            }
            // A cluster of racing cancellers (not just one) — more chances
            // for concurrent wake sources to collide on the same parked
            // fiber (organic timer-fire vs mass-cancel wake).
            for _ in 0..4 {
                spawn {
                    0.to_millis().sleep()
                    tok.cancel()
                }
            }
        }
    }
    assert(true)
}
