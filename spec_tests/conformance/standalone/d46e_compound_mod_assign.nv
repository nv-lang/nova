// EXPECT_STDOUT a=6 b=-2 v1=1 u=4 ok
//
// D46-амендмент (E), 2026-08-16: `%=` — последний из одиннадцати операторов
// уровня 1 таблицы приоритетов, которого не было в языке. Найдено окном 274
// при сверке novac с оракулом: десять принимались, `%=` давал
// `unexpected `=` in expression`.
//
// Почему это не было осознанным пропуском: амендмент (C) добавлял битовое
// семейство со словами владельца «мы просто забыли про них» — `%=` забыли
// в тот же раз; а D427 (2026-07-16) зафиксировал следствие как факт языка
// («в языке НЕТ `%=`»), не заметив, что таблица приоритетов его требует.
//
// Фикстура держит ЧЕТЫРЕ формы, каждая ловила бы свой промах лоуэринга:
//   * `int` — основной путь (nova_int хардкод-арм checked-хелпера);
//   * `i64` ОТРИЦАТЕЛЬНЫЙ — знак остатка берётся от делимого (C-семантика),
//     а не от делителя: подмена на `rem_euclid` покраснеет здесь;
//   * элемент вектора `v[1] %= 5` — place-путь, не переменная: именно на нём
//     №676 показал, что ресивер по переменному индексу резолвится иначе;
//   * `u8` — sized-путь (общий sized_checked_helper), не хардкод-арм.
//
// Деление на ноль (паника, а не SIGFPE) проверяется отдельно — здесь нельзя:
// ожидание в шапке требует нормального завершения. Guard достался бесплатно от
// D427: `nova_<T>_checked_rem` уже существовал для каждого члена `Ints`.
//
// ЛОВУШКА ПРИ ПРАВКЕ ЭТОГО ФАЙЛА: раннер ищет маркер ожидания по ВСЕМУ файлу и
// берёт ПОСЛЕДНЕЕ вхождение — упоминание имени маркера в теле комментария
// молча становится ожиданием (наступил здесь при написании фикстуры).

module standalone.d46e_compound_mod_assign

fn main() Io -> () {
    mut a = 20
    a %= 7
    print("a=", a, " ")

    mut b i64 = -20
    b %= 6
    print("b=", b, " ")

    mut v = []int.of(10, 21, 32)
    v[1] %= 5
    print("v1=", v[1], " ")

    mut u u8 = 200
    u %= 7
    print("u=", u, " ")

    // Десугар — ровно `a = a % b`, отдельного метода нет: результат обязан
    // совпасть с явной формой байт в байт.
    mut c = 20
    c = c % 7
    mut d = 20
    d %= 7
    if c == d { println("ok") } else { println("MISMATCH") }
}
