// EXPECT_STDOUT full=3 spread=7 embed=9 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №1142, ПОЛОЖИТЕЛЬНАЯ сторона. Негатив живёт отдельно
// (`neg/neg_record_missing_field.nv`): там литерал без объявленного поля обязан
// отвергаться.
//
// ЗАЧЕМ ЭТОТ ФАЙЛ. Проверку полноты легко написать так, что она покраснеет на
// здоровом коде, и тогда её отключат первым же окном. Три формы, которые она
// ОБЯЗАНА пережить, названы были ДО кода (строка реестра), и каждая здесь своя
// клетка, а не «примерно похожий случай»:
//
//   1. ПОЛНЫЙ литерал — самая обычная запись, и если бы падала она, дефект был
//      бы виден сразу; клетка нужна как контроль осмысленности остальных;
//   2. SPREAD (`...other`) — недостающие поля доезжают из донора, полнота от
//      автора НЕ требуется;
//   3. EMBED (`use base Base`) — у встроенного поля имя СИНТЕТИЧЕСКОЕ
//      (`__embed_<T>`), требовать его от автора литерала нельзя в принципе.
//
// ЧЕГО ЗДЕСЬ НЕТ: приватного поля вне области типа. У него свой отказ и своя
// фикстура; дублировать чужой предмет значило бы судить не своё.
module standalone.p1142_record_completeness_pos

type Point value { x int, y int }

type Base value { id int }

type Wrap value { use base Base, tag int }

fn main() {
    ro full = Point { x: 1, y: 2 }
    ro donor = Point { x: 3, y: 4 }
    ro spread = Point { x: 3, ...donor }
    ro emb = Wrap { base: Base { id: 4 }, tag: 5 }
    println("full=${full.x + full.y} spread=${spread.x + spread.y} embed=${emb.base.id + emb.tag} ok")
}
