// EXPECT_STDOUT SUPPRESSED_SEEN=1
//
// План 173.4 Ф.2 (в), реестр 221.1 №445: карман подавленных ошибок обязан быть
// наполнен К МОМЕНТУ вызова руки супервизора.
//
// Замер ДО починки (2026-08-15): `suppressed()` в `on_child_fail` возвращал
// ПУСТО, хотя cleanup упавшего ребёнка заведомо бросал. Причина: карман
// наполняется в момент ЛОВЛИ, а рука супервизора — не ловля; данные ребёнка
// лежат в слоте очереди родителя, и цепочки среди них не было вовсе.
//
// Починка той же формы, что у снимка site/trace: поле в слоте, запись ПОД
// ЗАМКОМ и СТРОГО ДО release-стора `published` (едет по существующему
// happens-before), восстановление кармана вокруг вызова руки.
//
// Результат печатается, а НЕ накапливается во внешний `mut`: D441 §3 запрещает
// захват внешнего `mut` рукой, установленной вокруг тела со `spawn` — рука
// выполняется В ФАЙБЕРЕ упавшего ребёнка, и обновления теряются (замер Ф.0:
// 2 прогона из 5 под 64×20 параллельных падений). Проверка сработала на первой
// версии этой фикстуры, и это правильно.
//
// ОГОВОРКА, записанная и в коде: восстановление герметично для Fail-пути.
// `interrupt` из руки едет отдельным стеком (`_nova_interrupt_top`) и прыгает
// мимо восстановления — дыра структурная и уже существующая (тот же longjmp
// бросает и сам drive-цикл), этой правкой не вносится и не чинится.

module standalone.f2v_supervisor_sees_suppressed

fn tx() Fail -> () {
    defer { throw "CLEANUP-FAILED" }
    throw "PRIMARY-FAILED"
}

fn main() Io -> () {
    with Supervisor = effect Supervisor {
        on_child_fail(idx, err) -> Decision {
            // Ровно одна подавленная: cleanup бросил один раз поверх первичной.
            println("SUPPRESSED_SEEN=", suppressed().len())
            return Decision.Stop
        }
    } {
        supervised {
            spawn { tx() }
        }
    }
}
