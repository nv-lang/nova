// EXPECT_STDOUT opt-plain=7 opt-default=7 res-plain=7 res-default=7 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №1147. `??` ТЕРЯЕТ ЛЕНИВОСТЬ, когда запасная ветка зовёт функцию
// С УМОЛЧАНИЕМ у параметра: блок, в который `callnorm` переписывает такой вызов,
// выполняется БЕЗУСЛОВНО, а не внутри ленивой ветки.
//
// ЧЕТЫРЕ КЛЕТКИ — ЭТО ПРОИЗВЕДЕНИЕ ДВУХ ОСЕЙ, А НЕ СПИСОК ИСТОРИЙ:
//   ось 1 — НОСИТЕЛЬ оператора: `Option` и `Result`. Их ровно два;
//   ось 2 — есть ли у запасной функции УМОЛЧАНИЕ (это и есть предмет).
// Пара без умолчания обязательна: без неё дефект читался бы как «`??` вообще не
// ленив», а это неверно и увело бы починку не туда.
//
// ПОЧЕМУ ОСЬ НОСИТЕЛЯ ПОЯВИЛАСЬ ТОЛЬКО ВТОРОЙ РЕДАКЦИЕЙ, и это урок дороже самой
// починки: первая правка чинила Option и проверялась пробой на Option — ТЕМ ЖЕ
// носителем, на котором делалась. Три пробы окна Карины были тоже Option. Никто
// не спросил, сколько ТИПОВ несёт `??`. Вскрылось худшим носителем:
// `json_encode(dto) ?? ice(...)` в `to_json` Карины — `json_encode` возвращает
// Result, и компилятор перестал печатать ЛЮБУЮ диагностику, потому что `ice`
// срабатывал на каждом успешном кодировании.
//
// ЧЕГО ФИКСТУРА НЕ ПОКРЫВАЕТ (названо, а не подразумевается): вложенные `??`,
// запасная ветка-выражение без вызова, умолчание, ссылающееся на предыдущий
// параметр. И отдельно — вопрос, на который у неё ответа нет: РАСТЁТ ЛИ число
// носителей (новая сумма с поддержкой `??` завтра). Проба на одном носителе
// приёмкой класса больше не считается.
module standalone.p1147_default_arg_breaks_elvis_laziness

fn die_default(msg str, code int = 2) -> never => panic("${msg}/${code}")

fn die_plain(msg str) -> never => panic(msg)

fn maybe(n int) -> Option[int] => if n > 0 { Some(n) } else { None }

fn tryit(n int) -> Result[int, str] => if n > 0 { Ok(n) } else { Err("no") }

// Значение ЕСТЬ во всех четырёх — запасная ветка не должна выполняться нигде.
fn opt_plain(n int) -> int => maybe(n) ?? die_plain("not positive")

fn opt_default(n int) -> int => maybe(n) ?? die_default("not positive")

fn res_plain(n int) -> int => tryit(n) ?? die_plain("not ok")

fn res_default(n int) -> int => tryit(n) ?? die_default("not ok")

fn main() {
    println("opt-plain=${opt_plain(7)} opt-default=${opt_default(7)} res-plain=${res_plain(7)} res-default=${res_default(7)} ok")
}
