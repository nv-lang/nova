// EXPECT_STDOUT plain=7 default=7 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №TBD. `??` ТЕРЯЕТ ЛЕНИВОСТЬ, когда запасная ветка зовёт функцию
// С УМОЛЧАНИЕМ у параметра: блок, в который `callnorm` переписывает вызов с
// умолчанием, выполняется БЕЗУСЛОВНО, а не внутри ленивой ветки `??`.
// Найдено окном Карины 2026-09-17 при исполнении поручения владельца о
// `caller_loc()` в `ice()`; подтверждено интегратором этой фикстурой.
//
// ПОЧЕМУ ЗДЕСЬ ДВЕ ФОРМЫ, А НЕ ОДНА: они различаются РОВНО ОДНИМ признаком —
// наличием умолчания у параметра запасной функции. Без пары `plain` дефект
// читался бы как «`??` вообще не ленив», а это неверно и увело бы починку не
// туда. `plain` обязан печататься ПЕРВЫМ: если сломается он, дефект другой.
//
// ЧЕГО ФИКСТУРА НЕ ПОКРЫВАЕТ (названо, а не подразумевается): `??` с запасной
// веткой-выражением без вызова, вложенные `??`, и умолчание, ссылающееся на
// предыдущий параметр. Это соседние формы того же узла, и они не проверены.
module standalone.p1147_default_arg_breaks_elvis_laziness

fn die_default(msg str, code int = 2) -> never => panic("${msg}/${code}")

fn die_plain(msg str) -> never => panic(msg)

fn maybe(n int) -> Option[int] => if n > 0 { Option.Some(n) } else { Option.None }

// Значение ЕСТЬ (7 > 0) — запасная ветка выполняться не должна ни в одной форме.
fn strict_plain(n int) -> int => maybe(n) ?? die_plain("not positive")

fn strict_default(n int) -> int => maybe(n) ?? die_default("not positive")

fn main() {
    println("plain=${strict_plain(7)} default=${strict_default(7)} ok")
}
