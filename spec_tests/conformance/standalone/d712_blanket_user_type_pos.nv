// EXPECT_STDOUT tag=tag size=7 rec=tag recsize=7 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №712, СЛУЧАЙ (A). Blanket-метод (`fn[T] T @m(...)`), чей тип
// возврата НЕ зависит от собственных generic-параметров метода, на
// ПОЛЬЗОВАТЕЛЬСКОМ типе ронял кодоген в `[INTERNAL-PANIC]
// [E_CODEGEN_TYPE_UNKNOWN] method call `.m` return type unknown`, тогда как
// тот же самый метод на ВСТРОЕННОМ типе работал (парная фикстура —
// `d712_blanket_builtin_regress_pos.nv`).
//
// КОРЕНЬ БЫЛ НЕ В КОДОГЕНЕ, и это главное в этой фикстуре. Чекер принимал
// blanket ранним `return`'ом (`f3_check_member_ctx`, маркер
// `[M-blanket-method-resolve]`) — чтобы не выдать ложный E7320, поскольку в
// реестре метод лежит под ключом ПАРАМЕТРА ("T"), а не под именем конкретного
// типа, — но тип результата при этом не разрешался и в канал
// `resolved_types` не попадал. Кодоген затем честно отказывал терминальной
// диагностикой на дыру канала. Правка — только вперёд: аннотировать, а не
// запрещать; ранний `return` остался на месте.
//
// ФОРМА ВЫЗОВА ВЫБРАНА НЕ СЛУЧАЙНО: `ro s = k.d712_tag()`. Тот же blanket в
// позиции АРГУМЕНТА (`print(k.d712_tag())`) проходил и ДО правки — там тип
// приходит из параметра `print`, а не из вызова. Фикстура, написанная в
// аргументной форме, была бы зелёной без правки и не доказывала бы ничего.
//
// ДВА ПОЛУЧАТЕЛЯ — сумма и запись — потому что паника показывала
// `obj_ty="Nova_<T>*"`, и на одном виде пользовательского типа фикстура не
// отличила бы класс от носителя. ДВА ВОЗВРАТА — `str` и `int` — потому что
// однотипная фикстура прошла бы и при захардкоженном `str`.
//
// ГРАНИЦА ЗАПИСИ НАЗВАНА ЯВНО: случай (B) (`@pipe[U](f fn(T) -> U) -> U`,
// возврат — собственный параметр метода, выводимый из аргумента-замыкания)
// этой правкой НЕ закрывается и остаётся открытым в строке №712.
module standalone.d712_blanket_user_type_pos

type D712Kind enum A | B | C

type D712Rec { x int }

fn[T] T @d712_tag() -> str => "tag"

fn[T] T @d712_size() -> int => 7

fn main() Io -> () {
    ro k = D712Kind.A
    ro tag = k.d712_tag()
    ro size = k.d712_size()
    ro r = D712Rec { x: 1 }
    ro rtag = r.d712_tag()
    ro rsize = r.d712_size()
    print("tag=${tag} size=${size} rec=${rtag} recsize=${rsize} ok")
}
