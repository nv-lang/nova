// Plan 187 (flagship integration) — [M-187-interp-to_str-fallback-valuerecord-recv]
// POS: string interpolation of a VALUE-record (`type X value {...}`) reached
// only through the D410 `@to_str()` fallback (no `@display`/`@debug` impl)
// previously passed the receiver BY VALUE to the generated
// `Nova_X_method_to_str(NovaValue_X*)` (pointer-receiver ABI, D226/A6) instead
// of `&obj` — a C compile error ("passing struct to parameter of incompatible
// type ... take the address with &"). Repro requires the value arriving via
// enum-variant pattern-match destructuring (`Has(e) => ...`), the exact shape
// that broke on `http`'s `ErrSource.Compress(CompressError)`
// (nova-http `error.nv` `HttpError @to_str()`, `Some(Compress(e)) =>
// "${base}: ${e}"`) while building `examples/flagship/aggregator`.
//
// Fix: `emit_interpolated_str`'s D410 to_str()-fallback branch
// (compiler-codegen/src/codegen/emit_c.rs) now routes the receiver through
// `prepare_method_recv` — the same value-struct receiver adaptation already
// used by the neighboring @display/@debug branch (Plan 175 Ф.3(d)) and every
// other value-struct method-call site. No language change — codegen-only.

module standalone.d187_interp_to_str_fallback_valuerecord_recv

type D187VErr value { ro code int }

// Only `@to_str()` — deliberately NO `@display`/`@debug` impl, so
// interpolation must take the D410 fallback path (not the display/debug
// branch, which already had the `prepare_method_recv` fix).
fn D187VErr @to_str() -> str => "verr(${@code})"

type D187Wrap enum D187Has(D187VErr) | D187Empty

fn d187_describe(w D187Wrap) -> str {
    match w {
        D187Has(e) => "${e}"
        D187Empty  => "none"
    }
}

test "interpolation of value-record via to_str()-fallback, reached through enum pattern-match binding" {
    ro w = D187Has(D187VErr { code: 7 })
    assert(d187_describe(w) == "verr(7)")
    assert(d187_describe(D187Empty) == "none")
}
