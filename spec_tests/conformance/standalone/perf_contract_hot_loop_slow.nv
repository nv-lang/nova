// EXPECT_STDOUT PERF_DONE
// EXPECT_EXIT_CODE 0
//
// Plan 140 Ф.5 — perf fixture: contract-heavy hot loop.
//
// `sq_plus` carries a NONLINEAR postcondition `ensures result >= x` provable
// only with multiplication reasoning (result = x*x + x; for x >= 0 this is
// >= x). Z3 (`--features z3-backend`, NOVA_SMT_BACKEND=z3) DISCHARGES this VC
// → the ensures lands in `proven_contracts` → it is ELIDED at codegen
// (zero-cost). The TrivialBackend (linear-arith only, no nonlinear) CANNOT
// discharge it → it stays runtime-checked → the POST check runs on EVERY
// loop iteration.
//
// So this single fixture, built two ways, isolates contract overhead:
//   (A) Z3 checked/optimized/verified → ensures elided      → zero-cost
//   (B) Trivial checked/optimized/verified → ensures checked Nx → overhead (no-Z3 degrade)
//
// Plan 194 A2.1: scenario (C) `--contracts=off` (legacy global unconditional
// elision, independent of proof) is retired along with the `off` flag value
// — `checked`/`optimized`/`verified` all enforce unproven contracts, so
// there is no longer a build-policy path that elides this ensures WITHOUT
// Z3 discharging it. See t5_build_policy_off.nv for the retargeted
// `optimized`-proven-elision coverage.
//
// The `requires x >= 0` precondition is a CALLER obligation and is never in
// `report.proven` — it always stays emitted (PRE check). It is cheap (one
// compare) and present in both configs, so it does not distort the
// PRE-vs-POST elision contrast (the POST is the per-iteration cost).
//
// Behaviourally identical in both configs (no violation occurs) — only
// throughput differs. Asserts exit 0 + stdout so it doubles as a correctness
// regression guard.

module standalone.perf_contract_hot_loop_slow
fn sq_plus(x int) -> int
    requires x >= 0
    ensures result >= x
=> x * x + x

fn main() Io -> () {
    mut acc = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- perf-isolation fixture (Plan 140 Ф.5): measures contract-check overhead in a raw loop; for-in's iterator-protocol desugar (D58) would add overhead of its own and dilute the exact signal this fixture isolates
    while i < 20000000 {
        ro v = sq_plus(i % 1000)
        acc = (acc + v) % 1000000007
        i += 1
    }
    if acc >= 0 {
        println("PERF_DONE")
    } else {
        println("UNEXPECTED")
    }
}
