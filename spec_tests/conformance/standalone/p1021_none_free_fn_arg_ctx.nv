// EXPECT_STDOUT arg=None
// Реестр 221.1 №1021, форма 2 (найдена агентом sonnet при №1348): голый
// `None`, переданный АРГУМЕНТОМ обычной (не generic, не метод) свободной
// функции с параметром `Option[[]u8]` (`show_param(None)`), типизировался
// как `NovaOpt_nova_int` — CC-FAIL «passing … to parameter of incompatible
// type». Тот же корень, что и форма 1 (закрытая соседней фикстурой
// `p1021_none_closure_return_ctx.nv`): `self.current_fn_return_ty` в точке
// эмиссии call-аргумента — ещё возврат ОКРУЖАЮЩЕЙ fn (`main`), не параметр
// КОЛЛИ (`show_param`). Форма «аргумент метода мономорфа» была починена
// раньше, коммитом 350f9c4d6 — эта фикстура её не повторяет.
//
// Ширина замерена той же волной (докладом чинившего окна, не здесь):
// `Ok(v)`/`Err(e)` и голый вариант ПОЛЬЗОВАТЕЛЬСКОЙ generic-суммы
// аргументом свободной функции этот баг НЕ воспроизводят (у них есть
// значение payload, через которое резолвится тип независимо от текущего
// `current_fn_return_ty`) — узко голый `None`.
module standalone.p1021_none_free_fn_arg_ctx

fn show_param(o Option[[]u8]) Io -> () {
    match o {
        Some(_) => print("arg=Some")
        None => print("arg=None")
    }
}

fn main() Io -> () {
    show_param(None)
}
