// Plan 67 closure regression-guard — pattern из bench/corpus/02_arithmetic_loop.nv:
// println(local_var.to_str()) для разных числовых типов (int + float).
// Проверяет что infer_print_helper → infer_expr_c_type unification
// корректно резолвит локальные переменные через var_types lookup.
// Plan 174.2: мигрировано со `str.from(local_var)` (ретрактирован) на `.to_str()`.

module standalone.f12_corpus_02_pattern_regression
// EXPECT_STDOUT results
// EXPECT_STDOUT 100
// EXPECT_STDOUT 6765

fn fib(n int) -> int =>
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }

fn main() Io -> () {
    ro r = 100              // int local
    ro f = fib(20)          // int via fn-return inference
    println("results")
    println(r.to_str())
    println(f.to_str())
}
