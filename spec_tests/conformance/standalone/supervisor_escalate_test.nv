// supervisor_escalate_test.nv — Plan 173.2 pos-тесты: `Escalate` (= дефолт),
// пользовательская политика с состоянием/narrowing, Escalate-with-error.
//
// Паритет с дефолтом: тела тестов "escalate" и "default" ИДЕНТИЧНЫ (кроме
// `with Supervisor = sup.escalate()`), и оба обязаны дать одинаковый
// наблюдаемый результат: ошибка ребёнка перевыбрасывается наружу scope'а,
// код после supervised НЕ исполняется.
//
// Бежит ARMED на дефолтном worker-count (M:N — периметр политики).

module standalone.supervisor_escalate_test
import std.concurrency.supervisor as sup
// Plan 175.2 Ф.2-v4 (П6): (5).to_millis() used to resolve without an
// explicit import — an accidental side effect of Time (and its
// Duration/Timestamp/Monotonic import) living in std.prelude.effects
// (auto-imported into every CU). Now that Time moved to std.time.duration,
// this file needs its own explicit import for the to_millis() blanket.
import std.time.duration

test "Supervisor=escalate: падение эскалируется — паритет с дефолтом" {
    // Plan 238 Ф.4 (D441 §3): `with Fail[T]` handler — AtomicBool/AtomicInt
    // вместо mut-флагов (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut caught = AtomicBool.new(false)
    mut got = AtomicInt.new(-1)
    mut after_scope = 0
    ro _ = with Fail[int] = |e| {
        caught.store(true)
        got.store(e)
        0
    } {
        with Supervisor = sup.escalate() {
            supervised {
                for i in 0..4 {
                    ro tag = i
                    spawn {
                        if tag == 2 { throw 4242 }
                        (5).to_millis().sleep()
                    }
                }
            }
            after_scope = 1   // недостижимо: rethrow на main-flow
        }
        99
    }
    assert(caught.load())
    assert(got.load() == 4242)
    assert(after_scope == 0)
}

test "дефолт (нет супервизора): тот же исход что и escalate" {
    // Plan 238 Ф.4 (D441 §3): та же миграция, что и в тесте выше.
    mut caught = AtomicBool.new(false)
    mut got = AtomicInt.new(-1)
    mut after_scope = 0
    ro _ = with Fail[int] = |e| {
        caught.store(true)
        got.store(e)
        0
    } {
        supervised {
            for i in 0..4 {
                ro tag = i
                spawn {
                    if tag == 2 { throw 4242 }
                    (5).to_millis().sleep()
                }
            }
        }
        after_scope = 1   // недостижимо: rethrow на main-flow
        99
    }
    assert(caught.load())
    assert(got.load() == 4242)
    assert(after_scope == 0)
}

test "пользовательская политика: (idx, err)-narrowing + mut-состояние" {
    ro n = 6
    mut done = AtomicInt.new(0)
    // №173: carve-out D416§2 отозван (сериализация on_child_fail опровергнута
    // перезамером) — mut-состояние хендлера мигрировано на AtomicInt.
    mut stopped = AtomicInt.new(0)
    mut seen_int = AtomicInt.new(0)
    mut after_scope = 0
    with Supervisor = effect Supervisor {
        on_child_fail(idx, err) -> Decision {
            // idx — валидный retention-слот; err — typed payload (int).
            assert(idx >= 0)
            assert(idx < n)
            if err is int { ro _ = seen_int.fetch_add(1) }
            ro _ = stopped.fetch_add(1)
            return Decision.Stop
        }
    } {
        supervised {
            for i in 0..n {
                ro tag = i
                spawn {
                    if tag < 2 { throw 700 + tag }
                    (10).to_millis().sleep()
                    done.fetch_add(1)
                }
            }
        }
        after_scope = 1
    }
    assert(after_scope == 1)
    assert(stopped.load() == 2)       // хендлер вызван по разу на каждое падение
    assert(seen_int.load() == 2)      // typed payload сужается `err is int`
    assert(done.load() == n - 2)
}

test "Escalate-with-error: throw в хендлере становится primary-ошибкой scope'а" {
    // Plan 238 Ф.4 (D441 §3): `with Fail[T]` handler — AtomicBool/AtomicInt
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER). №173: carve-out D416§2 отозван,
    // Supervisor-обработчики мигрированы так жее.
    mut caught = AtomicBool.new(false)
    mut got = AtomicInt.new(-1)
    mut after_scope = 0
    ro _ = with Fail[int] = |e| {
        caught.store(true)
        got.store(e)
        0
    } {
        with Supervisor = effect Supervisor {
            on_child_fail(idx, err) -> Decision {
                throw 7777    // Q-блок: Fail в хендлере = Escalate-with-error
            }
        } {
            supervised {
                for i in 0..3 {
                    ro tag = i
                    spawn {
                        if tag == 1 { throw 4242 }
                        (5).to_millis().sleep()
                    }
                }
            }
            after_scope = 1
        }
        99
    }
    assert(caught.load())
    assert(got.load() == 7777)        // primary = ошибка хендлера, не ребёнка
    assert(after_scope == 0)
}
