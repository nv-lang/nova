// supervisor_escalate_test.nv — Plan 173.2 pos-тесты: `Escalate` (= дефолт),
// пользовательская политика с состоянием/narrowing, Escalate-with-error.
//
// Паритет с дефолтом: тела тестов "escalate" и "default" ИДЕНТИЧНЫ (кроме
// `with Supervisor = sup.escalate()`), и оба обязаны дать одинаковый
// наблюдаемый результат: ошибка ребёнка перевыбрасывается наружу scope'а,
// код после supervised НЕ исполняется.
//
// Бежит ARMED на дефолтном worker-count (M:N — периметр политики).

module standalone.supervisor_escalate_test
import std.concurrency.supervisor as sup

test "Supervisor=escalate: падение эскалируется — паритет с дефолтом" {
    mut caught = false
    mut got = -1
    mut after_scope = 0
    ro _ = with Fail[int] = |e| {
        caught = true
        got = e
        0
    } {
        with Supervisor = sup.escalate() {
            supervised {
                for i in 0..4 {
                    ro tag = i
                    spawn {
                        if tag == 2 { throw 4242 }
                        (5).to_millis().sleep()
                    }
                }
            }
            after_scope = 1   // недостижимо: rethrow на main-flow
        }
        99
    }
    assert(caught)
    assert(got == 4242)
    assert(after_scope == 0)
}

test "дефолт (нет супервизора): тот же исход что и escalate" {
    mut caught = false
    mut got = -1
    mut after_scope = 0
    ro _ = with Fail[int] = |e| {
        caught = true
        got = e
        0
    } {
        supervised {
            for i in 0..4 {
                ro tag = i
                spawn {
                    if tag == 2 { throw 4242 }
                    (5).to_millis().sleep()
                }
            }
        }
        after_scope = 1   // недостижимо: rethrow на main-flow
        99
    }
    assert(caught)
    assert(got == 4242)
    assert(after_scope == 0)
}

test "пользовательская политика: (idx, err)-narrowing + mut-состояние" {
    ro n = 6
    mut done = AtomicInt.new(0)
    mut stopped = 0
    mut seen_int = 0
    mut after_scope = 0
    with Supervisor = effect Supervisor {
        on_child_fail(idx, err) {
            // idx — валидный retention-слот; err — typed payload (int).
            assert(idx >= 0)
            assert(idx < n)
            if err is int { seen_int += 1 }
            stopped += 1
            return Decision.Stop
        }
    } {
        supervised {
            for i in 0..n {
                ro tag = i
                spawn {
                    if tag < 2 { throw 700 + tag }
                    (10).to_millis().sleep()
                    done.fetch_add(1)
                }
            }
        }
        after_scope = 1
    }
    assert(after_scope == 1)
    assert(stopped == 2)       // хендлер вызван по разу на каждое падение
    assert(seen_int == 2)      // typed payload сужается `err is int`
    assert(done.load() == n - 2)
}

test "Escalate-with-error: throw в хендлере становится primary-ошибкой scope'а" {
    mut caught = false
    mut got = -1
    mut after_scope = 0
    ro _ = with Fail[int] = |e| {
        caught = true
        got = e
        0
    } {
        with Supervisor = effect Supervisor {
            on_child_fail(idx, err) {
                throw 7777    // Q-блок: Fail в хендлере = Escalate-with-error
            }
        } {
            supervised {
                for i in 0..3 {
                    ro tag = i
                    spawn {
                        if tag == 1 { throw 4242 }
                        (5).to_millis().sleep()
                    }
                }
            }
            after_scope = 1
        }
        99
    }
    assert(caught)
    assert(got == 7777)        // primary = ошибка хендлера, не ребёнка
    assert(after_scope == 0)
}
