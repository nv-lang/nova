// EXPECT_STDOUT 42
module standalone.overload_mode_axis_single_pos

fn f(consume a int, b int, c int) -> int => a

fn main() Io -> () {
    mut y = 10
    mut z = 20
    print("${f(41 + 1, y, z)}")
