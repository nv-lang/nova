// EXPECT_RUNTIME_PANIC p1100 cleanup fired
//
// Registry 221.1 #1100, D432 §4 point 3: the call-arg disarm asks the overload
// the call RESOLVES to. `use(g, 1)` resolves to the view overload, so nobody
// consumes `g` and its auto-`@cleanup` must run at the end of `run` -- it
// panics, which is the sentinel. Before #1100 the never-called
// `fn use(consume x Boom)` disarmed `g` by a union over the name: silent leak.

module standalone.p1100_free_two_overloads_view_called

type Boom consume { id int }

fn Boom consume @cleanup(_o ScopeOutcome) -> () {
    panic("p1100 cleanup fired")
}

fn Boom consume @defuse() -> () { }

fn mk(v int) -> Boom => { id: v }

fn use(consume x Boom) -> int {
    x.defuse()
    9
}

fn use(x Boom, tag int) -> int => tag

fn run() -> int {
    consume g = mk(7)
    use(g, 1)
}

fn main() Io -> () {
    ro r = run()
    println("p1100 result=${r} no cleanup")
}
