// реестр 221.1 №502 — companion to m510_generic_record_vec_element_
// access_forms.nv (same 3 access forms + len()-only, mirrored 1:1),
// named-tuple sibling. Pinned down by direct verification (build WITHOUT
// the checker change vs WITH it — see revert commit for the exact test):
// named tuple needs ONLY the codegen fix, not any checker change. Record
// (m510 sibling) needed NEITHER — it already worked via explicit `Vec[T]`
// syntax before this window (see that file's header for the retracted
// "shared checker root" hypothesis). Named tuple's actual gap is codegen-
// only: `TypeDeclKind::NamedTuple` had NO arm in
// `emit_generic_type_instance_body` (struct body + `nova_ctor_<short>`
// constructor never emitted — Record already had a `TypeDeclKind::Record`
// arm there) plus `try_infer_named_tuple_mono_args` + its `emit_call`
// routing (bare `Ent(k, v)` constructor dispatch — Record has no
// equivalent call-form, it always uses `{ field: val }` record-literal
// syntax, which already worked). Once the codegen fix populates
// `record_schemas`/`generic_type_instance_info` for the mono instance,
// the pre-existing LEGACY codegen fallback resolves field types on its
// own — no checker-channel change needed.
//
// Explicit `Vec[T]` syntax throughout (not `[]T.new()` sugar) — same
// reasoning as the Record sibling: the sugar form with a turbofished
// element type hits an unrelated, separate parser gap (№510, see
// m510_vec_generic_bracket_sugar_turbofish_neg.nv).
module standalone.m502_generic_named_tuple_vec_element_access_forms

type M502vEnt[K, V](key K, value V)

type M502vBox[K, V] priv { xs Vec[M502vEnt[K, V]] }

export fn M502vBox[K, V].new() -> Self => { xs: Vec[M502vEnt[K, V]].new() }

export fn M502vBox[K, V] mut @push(k K, v V) {
    @xs.push(M502vEnt(k, v))
}

export fn M502vBox[K, V] @direct_index_key() -> K {
    @xs[0].key
}

export fn M502vBox[K, V] @bind_then_access_key() -> K {
    ro e = @xs[0]
    e.key
}

export fn M502vBox[K, V] @for_loop_sum_values() -> int {
    mut total = 0
    for e in @xs {
        total = total + e.value
    }
    total
}

export fn M502vBox[K, V] @len_only() -> int => @xs.len()

test "№502: generic named tuple element in Vec[T] — direct index access" {
    mut b = M502vBox[str, int].new()
    b.push("a", 1)
    assert(b.direct_index_key() == "a")
}

test "№502: generic named tuple element in Vec[T] — bind then access" {
    mut b = M502vBox[str, int].new()
    b.push("b", 2)
    assert(b.bind_then_access_key() == "b")
}

test "№502: generic named tuple element in Vec[T] — for-loop access" {
    mut b = M502vBox[str, int].new()
    b.push("a", 1)
    b.push("b", 2)
    assert(b.for_loop_sum_values() == 3)
}

test "№502: generic named tuple element in Vec[T] — len() only, no field access" {
    ro b = M502vBox[str, int].new()
    assert(b.len_only() == 0)
}
