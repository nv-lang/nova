// EXPECT_STDOUT ok 18446744073709551551 18446744073709551551 -5 1 0 66 66 97 65 66 B 5 254 A
// SPDX-License-Identifier: MIT OR Apache-2.0
// Regression for registry 221.1 #1547: the legal half of D54 `as` (spec/decisions/
// 03-syntax.md, amendments 2026-09-04 and 2026-10-01), every cell in one line.
//
// - `int as uint` takes the LOW BITS, like every integer pair (amendment 2026-09-04:
//   "`int as uint` -- the same operation", D130 Q2 retracted). The oracle saturated it
//   (`nova_int_to_uint`, negative -> 0) and printed `0`: a silently wrong value.
//   `as u64` and `as uint` agree now, and the bits read back as the same `int`.
// - `bool as` a number: 1/0 (p.1).
// - a `char` VALUE into i32/u32/int/uint/i64/u64; a `char` LITERAL into any integer it
//   fits (p.2); an integer LITERAL into `char` (a Unicode scalar).
// - inside `unsafe { }` the forbidden table opens for a value -- `c as u8`, `b as char`
//   -- and the cast IS the block's operation: before #1547 `unsafe { c as u8 }` was
//   E_UNSAFE_UNUSED.
// - an identity cast between numbers (`i32 as i32`) is the integer rule; `(-f) as u8` is
//   a minus on the signed `f`, then the low bits (p.3).
module standalone.p1547_as_d54_legal

fn main() Io -> () {
    ro n = 65
    ro to_uint = (0 - n) as uint
    ro to_u64 = (0 - n) as u64
    ro back = (0 - 5) as uint
    ro t = true
    ro f = false
    ro c = 'B'
    ro b u8 = 66
    ro c8 = unsafe { c as u8 }
    ro bc = unsafe { b as char }
    ro i i32 = 5
    ro two = 2
    println("ok ${to_uint} ${to_u64} ${back as int} ${t as int} ${f as f64 as int} ${c as u32} ${c as int} ${'a' as u8} ${'A' as i8} ${c8} ${bc} ${i as i32} ${(-two) as u8} ${65 as char}")
}
