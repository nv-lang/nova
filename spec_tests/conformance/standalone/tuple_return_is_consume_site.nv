// EXPECT_STDOUT ok
// Реестр 221.1 №1092, амендмент D133 от 2026-09-14: перемещение в
// ВОЗВРАЩАЕМЫЙ КОРТЕЖ — место потребления.
//
// До амендмента `pair` отвергалась дважды: «переменная `a` не consumed до
// scope-exit» и то же про `b`, — при том что тело функции ЕСТЬ весь её
// результат. Диагностика сама называла `return a` законным местом; возврат в
// СОСТАВЕ кортежа таковым не считался, потому что перечень мест потребления
// его не упоминал.
//
// Цена умолчания стояла в std два месяца: `split_pair` (`net/tcp.nv`) и
// `recv_bytes_pair` (`net/udp.nv`) отдавали владение, но были вынуждены лгать о
// нём в подписи — параметры оставлены видовыми, результат помечен `ro`, и
// собственный комментарий признавал компромисс словами «`ro` would be the wrong
// canon here».
//
// ЧТО ДЕРЖИТ ЭТА ФИКСТУРА: обе половины разом. Функция ОТДАЁТ два владения
// кортежем (и потому обязана компилироваться), а вызывающий их ПРИНИМАЕТ и
// обязан потребить — иначе D133 покраснеет у него. Имя типа не односимвольное:
// D30 §naming запрещает такие, и проба на `W` этим и отвлекла.
module standalone.tuple_return_is_consume_site

type Cell consume value { h int }

fn Cell consume @close() -> () => ()

fn Cell @peek() -> int => @h

// Ровно форма, утверждённая владельцем для `split_pair`: consume-параметры,
// возврат кортежем БЕЗ `ro`. Тело — сам кортеж, то есть весь результат функции.
fn pair(consume a Cell, consume b Cell) -> (Cell, Cell) => (a, b)

// Вторая форма того же правила: кортеж стоит трейлингом БЛОКА, а не выражением.
// Эти два пути в чекере разные, и правило обязано работать на обоих.
fn pair_block(consume a Cell, consume b Cell) -> (Cell, Cell) {
    (a, b)
}

fn main() Io -> () {
    consume (x, y) = pair(Cell { h: 1 }, Cell { h: 2 })
    consume (p, q) = pair_block(Cell { h: 3 }, Cell { h: 4 })
    ro total = x.peek() + y.peek() + p.peek() + q.peek()
    x.close()
    y.close()
    p.close()
    q.close()
    if total == 10 {
        print("ok")
    } else {
        print("total mismatch")
    }
}
