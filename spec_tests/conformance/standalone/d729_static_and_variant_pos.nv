// EXPECT_STDOUT box=41 kind=5 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №729, КОНТРОЛЬ НА ЗАКОННЫЕ ФОРМЫ. Правило «у этого типа нет
// такого статика» обязано молчать там, где всё в порядке, — иначе оно хуже
// своего отсутствия.
//
// ЭТА ФИКСТУРА ВАЖНЕЕ СВОЕЙ ДЛИНЫ. Первая попытка правки (2026-08-18) была
// написана, измерена и ОТКАЧЕНА ровно об этот случай: конформанс как единый
// CU дал два ложных отказа — `Kind.Info(5)` и `Node.Leaf(7)`, — оба
// КОНСТРУКТОРЫ ВАРИАНТОВ, которые синтаксически неотличимы от статика.
//
// Виновата была не проверка, а коллизия голых имён (№705): карта типов
// ключевалась простым именем, поднимался ЧУЖОЙ одноимённый `Kind` — запись
// вместо суммы, — и вопрос «есть ли у типа такой член» относился к другому
// типу. После трёх волн окна W6 разрешение идёт по файлу ВЫРАЖЕНИЯ, и
// исключение по вариантам опирается на ТОТ САМЫЙ тип.

module standalone.d729_static_and_variant_pos

type Kind enum Info(int) | Warn

type Box { v int }

fn Box.new(n int) -> Box => { v: n }

fn Box @get() -> int => @v

fn kind_payload(k Kind) -> int {
    match k {
        Info(x) => x
        Warn    => 0
    }
}

fn main() Io -> () {
    ro b = Box.new(41)
    ro k = Kind.Info(5)
    println("box=${b.get()} kind=${kind_payload(k)} ok")
}
