fn main() Io -> () {
    print("${p1403_iter_small_sort_by()} ${p1403_iter_small_sort()} ${p1403_iter_small_reverse()} ${p1403_iter_small_swap()} ${p1403_iter_big_sort_by()} ${p1403_iter_big_sort()} ${p1403_iter_big_reverse()} ${p1403_iter_big_swap()}")
