    out.sort_by(fn(a P1403Big, b P1403Big) -> int => a.percent - b.percent)
    // nova:allow W_MANUAL_COLLECT -- the push loop IS the reference the fixture compares `.collect()` against (#1403); `.collect()` here would compare the form with itself
    mut pushed []P1403Big = []
    for w in ws {
        pushed.push(w)
    }
    pushed.sort_by(fn(a P1403Big, b P1403Big) -> int => a.percent - b.percent)
    "[${p1403_show_big(out)}]=[${p1403_show_big(pushed)}]"
