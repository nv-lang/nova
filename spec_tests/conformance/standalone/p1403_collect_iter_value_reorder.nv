// EXPECT_STDOUT [1 2 3 ]=[1 2 3 ] [1 2 3 ]=[1 2 3 ] [2 1 3 ]=[2 1 3 ] [1 3 2 ]=[1 3 2 ] [a1 b2 c3 ]=[a1 b2 c3 ] [a1 b2 c3 ]=[a1 b2 c3 ] [b2 a1 c3 ]=[b2 a1 c3 ] [a1 c3 b2 ]=[a1 c3 b2 ]
// Registry 221.1 #1403, control rows of the class: `.iter().collect()` on a
// value record, then an in-place reorder -- must equal the push-loop form.

module standalone.p1403_collect_iter_value_reorder

type P1403Big value { name str, kind str, percent int, used int, note str }

#impl(Compare)
fn P1403Big @compare(other P1403Big) -> int => @percent - other.percent

fn p1403_show_big(v []P1403Big) -> str {
    mut s = ""
    for w in v {
        s = "${s}${w.name}${w.percent} "
    }
    s
}

type P1403Small value { v int }

#impl(Compare)
fn P1403Small @compare(other P1403Small) -> int => @v - other.v

fn p1403_show_small(v []P1403Small) -> str {
    mut s = ""
    for w in v {
        s = "${s}${w.v} "
    }
    s
}

fn p1403_iter_small_sort_by() -> str {
    mut ws []P1403Small = []
    ws.push(P1403Small { v: 3 })
    ws.push(P1403Small { v: 1 })
    ws.push(P1403Small { v: 2 })
    mut out = ws.iter().collect()
    out.sort_by(fn(a P1403Small, b P1403Small) -> int => a.v - b.v)
    // nova:allow W_MANUAL_COLLECT -- the push loop IS the reference the fixture compares `.collect()` against (#1403); `.collect()` here would compare the form with itself
    mut pushed []P1403Small = []
    for w in ws {
        pushed.push(w)
    }
    pushed.sort_by(fn(a P1403Small, b P1403Small) -> int => a.v - b.v)
    "[${p1403_show_small(out)}]=[${p1403_show_small(pushed)}]"
}

fn p1403_iter_small_sort() -> str {
    mut ws []P1403Small = []
    ws.push(P1403Small { v: 3 })
    ws.push(P1403Small { v: 1 })
    ws.push(P1403Small { v: 2 })
    mut out = ws.iter().collect()
    out.sort()
    // nova:allow W_MANUAL_COLLECT -- the push loop IS the reference the fixture compares `.collect()` against (#1403); `.collect()` here would compare the form with itself
    mut pushed []P1403Small = []
    for w in ws {
        pushed.push(w)
    }
    pushed.sort()
    "[${p1403_show_small(out)}]=[${p1403_show_small(pushed)}]"
}

fn p1403_iter_small_reverse() -> str {
    mut ws []P1403Small = []
    ws.push(P1403Small { v: 3 })
    ws.push(P1403Small { v: 1 })
    ws.push(P1403Small { v: 2 })
    mut out = ws.iter().collect()
    out.reverse()
    // nova:allow W_MANUAL_COLLECT -- the push loop IS the reference the fixture compares `.collect()` against (#1403); `.collect()` here would compare the form with itself
    mut pushed []P1403Small = []
    for w in ws {
        pushed.push(w)
    }
    pushed.reverse()
    "[${p1403_show_small(out)}]=[${p1403_show_small(pushed)}]"
}

fn p1403_iter_small_swap() -> str {
    mut ws []P1403Small = []
    ws.push(P1403Small { v: 3 })
    ws.push(P1403Small { v: 1 })
    ws.push(P1403Small { v: 2 })
    mut out = ws.iter().collect()
    out.swap(0, 1)
    // nova:allow W_MANUAL_COLLECT -- the push loop IS the reference the fixture compares `.collect()` against (#1403); `.collect()` here would compare the form with itself
    mut pushed []P1403Small = []
    for w in ws {
        pushed.push(w)
    }
    pushed.swap(0, 1)
    "[${p1403_show_small(out)}]=[${p1403_show_small(pushed)}]"
}

fn p1403_iter_big_sort_by() -> str {
    mut ws []P1403Big = []
    ws.push(P1403Big { name: "c", kind: "k", percent: 3, used: 0, note: "n" })
    ws.push(P1403Big { name: "a", kind: "k", percent: 1, used: 0, note: "n" })
    ws.push(P1403Big { name: "b", kind: "k", percent: 2, used: 0, note: "n" })
