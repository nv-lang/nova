// EXPECT_STDOUT tail=None|early=None
// Реестр 221.1 №1021, форма 1: голый конструктор варианта (`None`) внутри
// ТЕЛА ЗАМЫКАНИЯ типизировался по УМОЛЧАНИЮ (`NovaOpt_nova_int`), а не по
// объявленному возврату замыкания (`fn() -> Option[[]u8]` → `NovaOpt_
// Nova_Vec____nova_byte_p`) — чекер молчал, C-компилятор отказывал
// («incompatible result type»). Причина: `current_fn_return_ty` (единый
// канал, которым дальше пользуется None/Ok/Err-диспетчер в `emit_call`)
// сохранял значение ОКРУЖАЮЩЕЙ fn/замыкания на всё время эмиссии тела
// замыкания — собственный, уже резолвленный `ret_c_ty` замыкания в него не
// попадал. Позиция не важна — обе формы дают одну и ту же ошибку:
// хвостовая ветка (`tail`) и ранний `return` (`early`).
module standalone.p1021_none_closure_return_ctx

fn main() Io -> () {
    ro flag = true
    ro tail_getter fn() -> Option[[]u8] = fn() -> Option[[]u8] {
        if flag {
            None
        } else {
            Some("x".bytes())
        }
    }
    match tail_getter() {
        Some(_) => print("tail=Some|")
        None => print("tail=None|")
    }

    ro early_getter fn() -> Option[[]u8] = fn() -> Option[[]u8] {
        if flag {
            return None
        }
        Some("x".bytes())
    }
    match early_getter() {
        Some(_) => print("early=Some")
        None => print("early=None")
    }
}
