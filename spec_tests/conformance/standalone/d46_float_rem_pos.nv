// EXPECT_STDOUT f64=1.5 compound=1.5 f32=1.5 neg=-1.5 int=1 ok
//
// D46-амендмент (F), 2026-08-17, реестр №707: `%` определён и на ПЛАВАЮЩИХ.
//
// ЧТО БЫЛО. Чекер принимал `7.5 % 2.0`, а кодоген эмитил СЫРОЙ C `%` — в C
// этот оператор определён только для целых, поэтому сборка падала ошибкой
// clang «invalid operands to binary expression», и текст ЧУЖОГО компилятора
// утекал пользователю вместо диагностики Nova. Найдено окном 274 при сверке
// novac с оракулом; класс тот же, что у `%=` (№704): чекер и кодоген
// расходятся в том, что считать законным.
//
// ПОЧЕМУ ЗАКОНЕН, А НЕ ЗАПРЕЩЁН (решение владельца через постановку вопроса):
// таблица приоритетов перечисляет `%` без ограничения по типам; D46 даёт
// `a % b -> @rem(b)` перегружаемым, то есть операция мыслится общей; C
// (`fmod`), Rust (`%` на float) её имеют, запрещает только Go. Запрет сузил
// бы язык ради обхода дефекта кодогена.
//
// ЧЕТЫРЕ ФОРМЫ, каждая ловит свой промах лоуэринга:
//   * `f64` — основной путь (`fmod`);
//   * составной `%=` — ОТДЕЛЬНЫЙ путь кодогена, чинился отдельно: он эмитил
//     сырой C `%=`, невалидный для double так же, как бинарный `%`;
//   * `f32` — узкий путь (`fmodf`, не `fmod`: иначе двойное округление);
//   * ОТРИЦАТЕЛЬНОЕ делимое — знак остатка берётся от ДЕЛИМОГО (семантика C и
//     Rust). Подмена на евклидов остаток покраснеет здесь: `-7.5 % 2.0` дало
//     бы `0.5` вместо `-1.5`.
// Плюс целочисленная ветка рядом — она обязана остаться на C-операторе `%`,
// а не уехать в `fmod` (проверка, что правка не задела целые).

module standalone.d46_float_rem_pos

fn main() Io -> () {
    ro a = 7.5
    ro b = 2.0
    print("f64=", a % b, " ")

    mut c = 7.5
    c %= 2.0
    print("compound=", c, " ")

    ro d f32 = 7.5
    ro e f32 = 2.0
    print("f32=", d % e, " ")

    ro neg = -7.5
    print("neg=", neg % 2.0, " ")

    ro i = 7
    print("int=", i % 2, " ")

    // Десугар составной формы обязан совпасть с явной — то же обещание, что
    // D46 (E) даёт для целых.
    mut x = 7.5
    x %= 2.0
    ro y = 7.5 % 2.0
    if x == y { println("ok") } else { println("MISMATCH") }
}
