// EXPECT_STDOUT ok
//
// Реестр 221.1 №1073: имя теста уезжало В СТРОКУ ФОРМАТА сгенерированного
// `printf`, и спецификаторы в нём подставлялись — имя печаталось мусором, а у
// мест с настоящими аргументами сдвигался весь список.
//
// Здесь живёт ЗЕЛЁНАЯ половина пробы: имя со спецификаторами на ПРОХОДЯЩЕМ
// тесте (сайты PASS). Красная половина корпусом быть не может — намеренно
// падающий тест сделал бы суиту красной, — и лежит пробой в
// `docs/plans/repro/1073-test-name-in-format/` с дословными вердиктами обеих
// сторон, снятыми на ОДНОМ бинаре.
module standalone.test_name_format_specifiers

test "name with %s and %d and %g and %% specifiers" {
    assert(1 == 1)
}

fn main() Io -> () => print("ok")
