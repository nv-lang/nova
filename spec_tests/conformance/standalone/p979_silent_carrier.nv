// EXPECT_STDOUT fn
//
// 221.1 №979 — ТИХИЙ НОСИТЕЛЬ. Это самая важная из трёх фикстур строки, потому
// что она пинит не отказ, а МОЛЧАНИЕ.
//
// Две другие ловятся сишным компилятором: там типы расходились
// (`nova_int` против `NovaValue_Color`), и отказ был громким. Здесь функция
// возвращает ТУ ЖЕ сумму, что и вариант, — сишный тип у обеих сторон один, и
// Си не скажет ничего. Разница видна только в выводе.
//
// Замер 2026-09-06 на одном бинаре: с выключателем `NOVA_KILL_VARIANT_SHADOW=1`
// программа собирается и печатает `variant` — то есть подставлен КОНСТРУКТОР
// ВАРИАНТА вместо вызова функции, молча и без единой диагностики. Без
// выключателя печатает `fn`.
//
// Строка реестра требовала померить это ПЕРВЫМ ДЕЛОМ и до сегодняшнего дня
// говорила «тихий носитель не найден и не опровергнут». Найден. Поэтому
// вердикт «блокирует тег» у №979 стоит по ЗАМЕРУ, а не по доводу.
module standalone.p979_silent_carrier

type Color enum Red | Green

fn Red() -> Color => Green

fn main() Io -> () {
    match Red() {
        Red => println("variant")
        Green => println("fn")
    }
}
