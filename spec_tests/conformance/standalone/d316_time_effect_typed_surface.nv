// d316_time_effect_typed_surface.nv — D316: `Time` плумбинг-эффект, единый
// источник схемы, TimerMetrics-split, ns-канон, typed user-facing surface
// (Timestamp.now()/Monotonic.now()/(Duration).sleep()/(Monotonic).sleep_until()
// МЕТОД-канон — Plan 175 Ф.2-v3, 2026-07-22: free `sleep`/`sleep_until`
// RETRACTED, method-only), мокабельность.
module standalone.d316_time_effect_typed_surface

import std.time.duration
import std.testing.handlers as d316_th

test "d316: Timestamp.now()/Monotonic.now() мокабельны через один handler (mock-coherence)" {
    with Time = d316_th.mut_clock(1_000 as u64) {
        ro d316_ts0 = Timestamp.now()
        ro d316_m0 = Monotonic.now()
        2.to_seconds().sleep()
        ro d316_ts1 = Timestamp.now()
        ro d316_m1 = Monotonic.now()
        // Один handler двигает ОБА чтения на одну и ту же дельту (Ред.2 Q14).
        assert(d316_ts1.minus(d316_ts0) == 2.to_seconds())
        assert(d316_m1.elapsed_since(d316_m0) == 2.to_seconds())
    }
}

test "d316: TimerMetrics вынесен из Time — read-only опы диспатчатся независимо" {
    ro d316_before = TimerMetrics.timer_alloc_total()
    supervised {
        spawn {
            ro d316_t = ChanReader.close_after(1.to_millis())
            ro _ = d316_t.recv()
        }
    }
    ro d316_after = TimerMetrics.timer_alloc_total()
    assert(d316_after - d316_before >= 1)
}

test "d316: (Duration).sleep()/(Monotonic).sleep_until() — канонический метод-вызов, не Time.sleep напрямую" {
    with Time = d316_th.mut_clock(0 as u64) {
        500.to_millis().sleep()
        assert(Timestamp.now().unix_millis() == 500)
        ro d316_deadline = Monotonic.now() + 1.to_seconds()
        d316_deadline.sleep_until()
        assert(Timestamp.now().unix_millis() == 1500)
    }
}

test "d316: ns-канон — Duration/Timestamp/Monotonic nanos round-trip" {
    assert(123.to_nanos().nanos() == 123)
    assert(456.to_unix_nanos().unix_nanos() == 456)
    // Monotonic — opaque (нет to_nanos-конструктора), но nanos() escape-hatch есть.
    ro d316_m = Monotonic.now()
    ro d316_n = d316_m.nanos()
    assert(d316_n >= 0 || d316_n < 0)  // любое i64 валидно — просто проверяем доступность
}
