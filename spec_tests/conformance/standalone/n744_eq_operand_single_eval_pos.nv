// EXPECT_STDOUT sum_matched=1 sum_unmatched=1 sum_unit=1 sum_record=1 sum_nested=1 value_record=1 tuple=1 | eq=true false true true true true true
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №744 (K1): операнд структурного `==` обязан вычисляться РОВНО
// ОДИН раз.
//
// Дефект. `emit_field_eq` строит цепочку
//   `l->tag == r->tag && (l->tag != A || <поля A>) && (l->tag != B || ...)`,
// а `l` и `r` — это ТЕКСТ C-выражения. Каждая клауза печатала операнд заново,
// поэтому вызов справа исполнялся один раз на каждую клаузу, пережившую
// короткое замыкание. Замер до правки (тот же бинарь, `NOVA_KILL_744=1`):
//
//   совпавший вариант с одним полем ..... 2
//   вариант-запись с двумя полями ....... 3      // 1 + число полей варианта
//   вложенный payload ................... 2
//   значимая запись ..................... 2
//   кортеж .............................. 2
//   несовпавший вариант / unit .......... 1      // клаузы отсекаются `&&`
//
// Это дублирование ПОБОЧНЫХ ЭФФЕКТОВ, а не только лишняя аллокация, — потому
// K1, а не перф-заметка.
//
// Почему счётчик, а не сравнение результатов: значения `==` были верны и ДО
// правки (это проверено отдельно и повторяется последним полем вывода). Если
// фикстура сверяет только `true`/`false`, она зелёная при обоих поведениях и
// не сторожит ничего. Наблюдаемое различие тут ровно одно — сколько раз
// исполнился правый операнд, — поэтому фикстура считает вызовы.
//
// Формы покрыты все, по которым дефект воспроизводился: сумма (совпавший,
// несовпавший, unit, вариант-запись, вложенный payload), значимая запись,
// кортеж. Четыре первых — обязательные по строке реестра; остальные добавлены
// потому, что замер показал их поражёнными той же цепочкой.
//
// Красная без правки: `NOVA_KILL_744=1` возвращает прежнюю эмиссию на ЭТОМ ЖЕ
// бинаре — фикстура обязана покраснеть. Кеш сборки ключуется по исходнику, а
// НЕ по env, поэтому между двумя прогонами каталог `target/.nova-cache`
// обязан быть снесён; без этого второй прогон переиспользует артефакт первого
// и «доказательство» получается ложным (наступил при снятии замера).
module standalone.n744_eq_operand_single_eval_pos

type Inner { mut k int }

type Tagged enum
    | Text(str)
    | Num(int)
    | Rec { id int, name str }
    | Wrap(Inner)
    | Blank

type VRec value { ro a int, ro b int }

// Каждая фабрика отмечается в журнале ровно одним push при каждом вызове.
fn n_sum(mut log Vec[int], v int) -> Tagged { log.push(1); Num(v) }
fn n_txt(mut log Vec[int]) -> Tagged { log.push(1); Text("t") }
fn n_bln(mut log Vec[int]) -> Tagged { log.push(1); Blank }
fn n_rec(mut log Vec[int]) -> Tagged { log.push(1); Rec { id: 1, name: "n" } }
fn n_wrp(mut log Vec[int]) -> Tagged { log.push(1); Wrap(Inner { k: 3 }) }
fn n_vr(mut log Vec[int]) -> VRec { log.push(1); VRec { a: 1, b: 2 } }
fn n_tp(mut log Vec[int]) -> (int, str) { log.push(1); (1, "x") }

fn main() {
    // (1) совпавший вариант с payload — было 2
    mut l1 = Vec[int].new(8)
    ro a1 = Num(5) == n_sum(l1, 5)

    // (2) несовпавший вариант — было 1, обязано остаться 1
    mut l2 = Vec[int].new(8)
    ro a2 = Num(5) == n_txt(l2)

    // (3) unit-вариант — было 1, обязано остаться 1
    mut l3 = Vec[int].new(8)
    ro a3 = Blank == n_bln(l3)

    // (4) вариант-запись, два поля — было 3
    mut l4 = Vec[int].new(8)
    ro a4 = Rec { id: 1, name: "n" } == n_rec(l4)

    // (5) вложенный payload (payload варианта — сама запись) — было 2
    mut l5 = Vec[int].new(8)
    ro a5 = Wrap(Inner { k: 3 }) == n_wrp(l5)

    // (6) значимая запись — было 2
    mut l6 = Vec[int].new(8)
    ro a6 = VRec { a: 1, b: 2 } == n_vr(l6)

    // (7) кортеж — было 2
    mut l7 = Vec[int].new(8)
    ro a7 = (1, "x") == n_tp(l7)

    // Счётчики И результаты в одной строке: первые сторожат №744, вторые
    // сторожат то, что правка не поехала по семантике сравнения.
    print("sum_matched=${l1.len()} sum_unmatched=${l2.len()} sum_unit=${l3.len()} sum_record=${l4.len()} sum_nested=${l5.len()} value_record=${l6.len()} tuple=${l7.len()} | eq=${a1} ${a2} ${a3} ${a4} ${a5} ${a6} ${a7}")
}
