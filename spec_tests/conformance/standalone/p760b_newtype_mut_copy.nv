// EXPECT_STDOUT ret=5 walk=3 flat=3 nested=4 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №760, ВТОРАЯ ФОРМА. Её нашло окно Карины 2026-09-18, и нашло
// правильно: приёмка строки называла только форму ВОЗВРАТА (`fn f(t TyId) ->
// TyId => t`), а тот же класс ломает и mut-копию из ro-параметра — причём
// ДРУГОЙ ветвью того же правила. Это видно в текстах самих диагностик на
// дофиксном оракуле: возврат отвергался как «объявленный тип возврата не `ro`»
// (Ф.1б), а `mut cur = at` — как «присваивается в mutable content-view» (Ф.1).
//
// ПОЧЕМУ ФАЙЛ ЗАВЕДЁН, ХОТЯ ФИКС УЖЕ ЗАКРЫЛ ОБЕ ВЕТВИ: закрыл — это ЗАМЕР, а
// не свойство фикса. Фикс целился в общий предикат (`is_fully_stack_value_
// guarded`), и обе ветви спрашивают его; но ровно сегодня мы видели обратный
// случай — №1147, где починка одного носителя (Option) оставила второй (Result)
// живым и выглядела полной. Ветвь, которую не проверяет ни одна фикстура,
// закрыта только на словах.
//
// КОНТРОЛЬ `flat` — та же форма цикла на ПЛОСКОМ `int`. Он был зелёным и до
// фикса, и его дело — не дать принять за доказательство то, что доказывает лишь
// работоспособность `while`: если однажды покраснеет он, дело не в newtype.
module standalone.p760b_newtype_mut_copy

export type Tick int
export type Wrap Tick

fn ret(t Tick) -> Tick => t

// Форма 2: mut-копия из ro-параметра.
fn walk(at Tick, stop Tick) -> int {
    mut cur = at
    mut n = 0
    while cur != stop {
        cur = (cur as int + 1) as Tick
        n += 1
    }
    n
}

// Контроль: плоский носитель, без обёртки.
fn walk_flat(at int, stop int) -> int {
    mut cur = at
    mut n = 0
    while cur != stop {
        cur = cur + 1
        n += 1
    }
    n
}

// Та же форма на newtype ПОВЕРХ newtype: без этой клетки починка «снять один
// слой» выглядела бы полной — тот же довод, что у фикстуры формы 1.
fn walk_nested(at Wrap, stop Wrap) -> int {
    mut cur = at
    mut n = 0
    while cur != stop {
        cur = ((cur as Tick) as int + 1) as Wrap
        n += 1
    }
    n
}

fn main() {
    ro r = ret(5 as Tick) as int
    println("ret=${r} walk=${walk(0 as Tick, 3 as Tick)} flat=${walk_flat(0, 3)} nested=${walk_nested(0 as Wrap, 4 as Wrap)} ok")
}
