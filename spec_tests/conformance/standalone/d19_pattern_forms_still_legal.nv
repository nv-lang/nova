// EXPECT_STDOUT bind=7 guard=1 variant=41 shadow=2
//
// КОНТРОЛЬ к запрету №762/№1157. Его дело — не дать принять запрет за поломку
// голого имени в образце вообще: связывание свежим именем законно, и именно оно
// пишется в каждом втором `match`.
//
// ЧЕТЫРЕ КЛЕТКИ — ЧЕТЫРЕ РАЗНЫХ ВОПРОСА, а не одна форма в четырёх позах:
//   bind    — голое имя, которое НЕ константа: связывание, работает как прежде;
//   guard   — КАНОН, который называет сама диагностика: сравнение через `if`.
//             Без этой клетки запрет советовал бы форму, никем не проверенную;
//   variant — имя, которое ЕСТЬ вариант суммы: остаётся вариантом. Условие в
//             чекере проверяет варианты ПЕРВЫМИ, и если этот порядок однажды
//             перевернут, константа с именем варианта убьёт законный разбор;
//   shadow  — связывание именем, СОВПАДАЮЩИМ с параметром функции (а не с
//             константой): тень законна, запрет её не касается.
module standalone.d19_pattern_forms_still_legal

const LIMIT = 41

type Tier enum
    | Low
    | High

fn take(n int) -> int => match n {
    x => x
}

fn guarded(w str) -> int => match w {
    x if x == "mut" => 1
    _ => 0
}

fn tier_of(t Tier) -> int => match t {
    High => LIMIT
    Low => 0
}

fn shadowing(v int) -> int => match v {
    v => v
}

fn main() Io -> () {
    ro b = take(7)
    ro g = guarded("mut")
    ro v = tier_of(Tier.High)
    ro sh = shadowing(2)
    println("bind=${b} guard=${g} variant=${v} shadow=${sh}")
}
