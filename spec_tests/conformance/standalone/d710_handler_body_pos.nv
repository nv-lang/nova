// EXPECT_STDOUT fill=42 twice=84 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №710, КОНТРОЛЬ НА ЗАКОННУЮ ФОРМУ. Спуск чекера в
// `bindings` узла `With` (правка №710) обязан МОЛЧАТЬ там, где тело
// обработчика в порядке, — иначе он хуже своего отсутствия.
//
// ЧТО ИМЕННО ЗДЕСЬ ПИНЯЕТСЯ, а не просто «ещё один зелёный тест».
// Главный риск правки был не в том, что она пропустит ошибку, а в том, что
// она НАЙДЁТ НЕСУЩЕСТВУЮЩУЮ: тело обработчика проверяется теперь в области
// видимости места записи, и если параметр операции (`x`) в ней не
// разрешается, всякий рабочий handler начнёт отвергаться с «unknown
// identifier». Поэтому в теле стоят ОБА признака сразу:
//   (1) `ro doubled int = x * 2` — локаль с АННОТАЦИЕЙ ТИПА, то есть ровно
//       та конструкция, которую проверка №710 и включила;
//   (2) её правая часть читает `x` — ПАРАМЕТР ОПЕРАЦИИ, чьё разрешение и
//       было под вопросом.
// Обе — законные, и обе обязаны пройти молча.
//
// Парный отрицательный случай — `neg/d710_handler_body_unchecked_neg.nv`.

module standalone.d710_handler_body_pos

type D710Probe effect {
    fill(x int) -> int
}

fn use_probe() -> int {
    with D710Probe = effect D710Probe {
        fill(x) -> int {
            ro doubled int = x * 2
            return doubled
        }
    } {
        D710Probe.fill(21)
    }
}

fn main() Io -> () {
    ro v = use_probe()
    println("fill=${v} twice=${v * 2} ok")
}
