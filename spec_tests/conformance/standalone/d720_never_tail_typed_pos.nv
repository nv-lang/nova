// EXPECT_STDOUT s=zero i=10 b=true r=7 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №720. Расходящееся выражение в ХВОСТЕ функции (`panic(...)`,
// `throw`, вызов `-> never`) лоуэрилось заглушкой int-семейства
// (`(nova_int)0LL`), и эта заглушка становилась ИНИЦИАЛИЗАТОРОМ возвращаемого
// временного.
//
// ЧЕТЫРЕ ТИПА ВОЗВРАТА ЗДЕСЬ НЕ ДЛЯ ПОЛНОТЫ, А ПОТОМУ ЧТО В НИХ ВЕСЬ ДЕФЕКТ.
// До фикса `-> int` и `-> bool` СОБИРАЛИСЬ И РАБОТАЛИ — типы C случайно
// совпадали, — а `-> str` падал ошибкой чужого компилятора при зелёном
// `nova check`. То есть громкий отказ был ВЕЗЕНИЕМ, а не проверкой, и фикстура
// только на `str` закрепила бы симптом вместо дефекта. Требование взять три
// варианта пришло от окна 274 и принято дословно; запись `Box` добавлена
// сверх — она идёт через типизированный ноль `((T){0})`, отдельную ветку.
//
// ПОЧЕМУ ЭТО НЕ №711 И НЕ №714. Там возврат был ЛИШНИМ (фабрикованный
// `return NOVA_UNIT`) и ОТСУТСТВУЮЩИМ (`E_MISSING_RETURN` не существовал).
// Здесь возврат ЕСТЬ, и тип у него чужой — третья дверь на одной территории.
module standalone.d720_never_tail_typed_pos

type Box { id int }

fn kind_s(k int) -> str {
    if k == 0 { return "zero" }
    panic("no such kind")
}

fn kind_i(k int) -> int {
    if k == 0 { return 10 }
    panic("no such kind")
}

fn kind_b(k int) -> bool {
    if k == 0 { return true }
    panic("no such kind")
}

fn kind_r(k int) -> Box {
    if k == 0 { return { id: 7 } }
    panic("no such kind")
}

fn main() {
    println("s=${kind_s(0)} i=${kind_i(0)} b=${kind_b(0)} r=${kind_r(0).id} ok")
}
