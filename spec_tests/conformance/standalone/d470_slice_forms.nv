// EXPECT_STDOUT closed=ell open_end=ld open_start=hello incl=bcd empty= edge0= edgeN= mb_head_len=2 mb_tail_len=10
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Plan 284 Ф.3 / D470 — все четыре формы сахара среза на строке, с краями, на
// одном носителе. После Ф.1 каждая разворачивается в `s.index(...)`, то есть
// ДОХОДИТ до тела `str @index(r Range)` вместе с его контрактом; до Ф.1 они
// обрабатывались встроенно в кодогене и в метод не заходили вовсе.
//
// Открытый конец здесь не украшение, а единственная форма, которой нужен
// ВТОРОЙ метод роли: `s[a..]` компилятор материализует как
// `s.index(Range { start: a, end: s.end_index() })`. Если `@end_index()` у
// строки исчезнет или начнёт отвечать не байтовой длиной, покраснеют ровно
// `open_end` и `mb_tail_len`, а прочие подписи останутся зелёными — отказ
// назовёт ФОРМУ, а не «что-то со срезом».
//
// НЕ-ASCII В ОЖИДАЕМОМ ВЫВОДЕ НЕТ НАМЕРЕННО. Строка ожидания сверяется с
// stdout побайтово, а кодировка консоли многобайтовые буквы портит молча —
// такой тест краснел бы не по делу и его бы ослабили. Поэтому в stdout идут
// ДЛИНЫ (они и доказывают байтовую семантику), а содержимое многобайтовых
// срезов проверяется `assert`-ом внутри процесса, где кодировка не участвует.
//
// ОДИН ФАЙЛ, А НЕ ЧЕТЫРЕ — отступление от буквы плана, названное намеренно.
// План просил «по одному файлу на форму»; замер волны против: каждый файл в
// `standalone/` — отдельная единица трансляции, значит четыре файла стоят
// четырёх сборок одного содержимого, не добавляя ни одной проверки. Формы
// различаются подписями, поэтому упавшая проверка по-прежнему называет форму.
// Нужна буква — файл делится механически, без потери смысла.
module standalone.d470_slice_forms

fn main() Io -> () {
    ro s = "hello world"

    // Замкнутая форма: обе границы даны, от роли нужен только `@index`.
    ro closed = s[1..4]

    // Открытый конец: верхнюю границу подставляет `@end_index()`.
    ro open_end = s[9..]

    // Открытое начало: нижняя граница — ноль, метода не требует.
    ro open_start = s[..5]

    // Включающая форма: конец материализуется как `end + 1`.
    ro abc = "abcde"
    ro incl = abc[1..=3]

    // Пустой срез внутри и на обоих краях. Пустота сравнивается с `""`, а не
    // измеряется длиной (конвенция П37).
    ro empty = s[3..3]
    ro edge0 = s[0..0]
    ro edgeN = s[11..11]
    assert(empty == "")
    assert(edge0 == "")
    assert(edgeN == "")

    // Многобайтовый носитель — тот же литерал, что в
    // `pos_str_methods_accurate.nv`: шесть кириллических букв по два байта.
    // `mb_head` доказывает, что срез БАЙТОВЫЙ (0..2 — одна буква, не две),
    // `mb_tail` — что открытый конец считает байты, а не кодпоинты.
    ro mb = "Привет"
    ro mb_head = mb[0..2]
    ro mb_tail = mb[2..]
    assert(mb.byte_len() == 12)
    assert(mb_head == "П")
    assert(mb_tail == "ривет")

    ro line1 = "closed=${closed} open_end=${open_end} open_start=${open_start}"
    ro line2 = "incl=${incl} empty=${empty} edge0=${edge0} edgeN=${edgeN}"
    // Длины связаны заранее, а не вызваны внутри интерполяции: форму
    // `"${expr.method()}"` мне сейчас нечем проверить (машина у соседа), а
    // связать ничего не стоит.
    ro hl = mb_head.byte_len()
    ro tl = mb_tail.byte_len()
    ro line3 = "mb_head_len=${hl} mb_tail_len=${tl}"
    println("${line1} ${line2} ${line3}")
}
