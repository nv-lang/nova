// EXPECT_STDOUT none=-1 some=7 ok=41 err=-2
//
// Реестр 221.1 №763: ПОЛЕ ЗАПИСИ С ТИПОМ GENERIC-СУММЫ (`Option[T]`,
// `Result[T,E]`). Дефект найден окном 274 2026-08-23: `check` проходил, а
// сборка падала двумя разными способами — литерал записи кастовал конструктор
// в скаляр (`_nv_tmp.d = (nova_int)(intptr_t)nova_make_Option_None();`), а
// привязка `if Some(v) = r.d` получала не тот тип.
//
// ЗАЧЕМ ЭТА ФИКСТУРА ЗАВЕДЕНА, ЕСЛИ ДЕФЕКТ НЕ ВОСПРОИЗВОДИТСЯ. Именно поэтому.
// Строка реестра прямо говорит, ПОЧЕМУ его не находили раньше: ни в `std`, ни
// в novac НЕТ НИ ОДНОГО поля-`Option` — форма не была пробована ни разу, хотя
// «поле, которого может не быть» пишется первым делом. Класс, у которого нет
// ни одного носителя в дереве, не имеет и судьи: он чинится и ломается молча.
// Здесь судья появляется.
//
// ЧЕТЫРЕ КЛЕТКИ — ЭТО ЧЕТЫРЕ ОТДЕЛЬНЫХ ПУТИ ЭМИССИИ, а не один в четырёх позах:
//   none  — конструктор БЕЗ payload в литерале записи (та самая форма, которая
//           кастовалась в скаляр);
//   some  — конструктор С payload-ЗАПИСЬЮ плюс привязка через `if Some(v) =`
//           (вторая форма отказа, с несовместимым типом);
//   ok    — `Result[T,E]`, арм успеха: другая generic-сумма, два параметра;
//   err   — тот же `Result`, арм ошибки со СТРОКОВЫМ payload — именно на строке
//           вылезало `assigning to 'nova_str' from incompatible type 'nova_int'`.
module standalone.p763_generic_sum_in_field

type Nd { id int }

type Holder {
    d Option[int]
    n Option[Nd]
    r Result[int, str]
}

fn main() Io -> () {
    ro empty = Holder { d: None, n: None, r: Ok(0) }
    // `??` — канон D86; ручной `match` по Option в этой позиции линт отвергает
    // (`W_MANUAL_COALESCE`), и фикстура обязана быть написана каноном: её читают
    // как образец формы, а не только как проверку.
    ro none_val = empty.d ?? -1

    ro full = Holder { d: Some(1), n: Some(Nd { id: 7 }), r: Ok(41) }
    ro some_val = if Some(v) = full.n { v.id } else { -1 }
    ro ok_val = full.r ?? -1

    ro bad = Holder { d: None, n: None, r: Err("no") }
    ro err_val = bad.r ?? -2

    println("none=${none_val} some=${some_val} ok=${ok_val} err=${err_val}")
}
