// Реестр 221.1 №716 — КВАЛИФИЦИРОВАННЫЙ КОНСТРУКТОР ВАРИАНТА GENERIC-СУММЫ.
//
// ЧТО БЫЛО. `Option[int].Some(10)` и `Option[int].None` печатали в Си имена
// ИЗ ИСХОДНИКА: `return Option->Some(((nova_int)10LL));` и
// `return ((Option)[nv_int]->None);` — ссылки на несуществующие
// идентификаторы. Голая форма `Some(10)` при этом работала.
//
// ПОЧЕМУ ДВЕ ФОРМЫ ЛОМАЛИСЬ ПО-РАЗНОМУ. Парсер признаёт turbofish, только
// если за `]` идёт `(`. Поэтому вариант С НАГРУЗКОЙ приходит как
// `Member{TurboFish}`, а БЕЗ нагрузки откатывается в `Member{Index}` —
// один и тот же конструктор расщеплялся на два разных узла по СЛЕДУЮЩЕМУ
// ТОКЕНУ, и ни один не разбирался как конструктор.
//
// ПОЧЕМУ ФИКСТУРА ДЕРЖИТ ОБЕ ФОРМЫ И ОБЕ СУММЫ. Починить одну и решить, что
// класс закрыт, здесь особенно легко: формы выглядят одинаково в исходнике и
// расходятся только в разборе.
//
// Пятый и шестой случаи — контроль в обратную сторону: статический МЕТОД на
// generic-типе (`Vec[int].of`) не вариант, и переписывание не смеет его
// перехватывать.

module standalone.d38_qualified_generic_variant_ctor_pos

type MyOpt[T] enum None_ | Some_(T)

// `??`, а не ручной `match`: канон для Option/Result (W_MANUAL_COALESCE).
// Предмет фикстуры — конструктор, и разворачивание не должно тянуть за собой
// собственных замечаний линта.
fn unwrap_or(o Option[int], d int) -> int => o ?? d

fn my_unwrap_or(o MyOpt[int], d int) -> int {
    match o {
        Some_(v) => v
        None_ => d
    }
}

fn res_or(r Result[int, str], d int) -> int => r ?? d

fn main() Io -> () {
    // (1) голая форма — контроль: она работала и обязана работать дальше
    assert(unwrap_or(Some(10), -1) == 10)

    // (2) квалифицированная, С НАГРУЗКОЙ — `Member{TurboFish}`
    assert(unwrap_or(Option[int].Some(10), -1) == 10)

    // (3) квалифицированная, БЕЗ нагрузки — `Member{Index}`
    assert(unwrap_or(Option[int].None, -1) == -1)

    // (4) вторая встроенная сумма, два типовых аргумента
    assert(res_or(Result[int, str].Ok(7), -1) == 7)

    // (5) ПОЛЬЗОВАТЕЛЬСКАЯ generic-сумма — обе формы
    assert(my_unwrap_or(MyOpt[int].Some_(3), -1) == 3)
    assert(my_unwrap_or(MyOpt[int].None_, -1) == -1)

    // (6) контроль в обратную сторону: статический метод на generic-типе —
    // не вариант, перехватывать его нельзя.
    ro xs = Vec[u32].of(1, 2, 3)
    assert(xs.len() == 3)
}
