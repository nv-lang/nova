// supervisor_parfor_test.nv — Plan 173.2 pos-тест: политика на `parallel for`.
//
// `parallel for` (array-mode, 173.1) — свой supervised-scope: политика
// Stop даёт «собери выживших» — упавшая итерация не отменяет остальных и
// не роняет scope; её элемент просто отсутствует (dense, 173.1 §2.3).
//
// Бежит ARMED на дефолтном worker-count (M:N — периметр политики).

module standalone.supervisor_parfor_test
import std.concurrency.supervisor as sup

test "Supervisor=stop + parallel for: собери выживших (упавшая итерация отсутствует)" {
    ro xs = with Supervisor = sup.stop() {
        parallel for i in 0..40 {
            if i % 10 == 3 { throw i }   // 3, 13, 23, 33 падают
            i * 2
        }
    }
    assert(xs.len() == 36)
    // Сумма выживших: 2*(sum(0..39) - (3+13+23+33)) = 2*(780 - 72) = 1416.
    mut total = 0
    for v in xs { total += v }
    assert(total == 1416)
}

test "Supervisor=escalate + parallel for: падение итерации эскалируется (паритет с дефолтом)" {
    // Plan 238 Ф.4 (D441 §3): `with Fail[T]` handler — AtomicBool/AtomicInt
    // вместо mut-флагов (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut caught = AtomicBool.new(false)
    mut got = AtomicInt.new(-1)
    ro _ = with Fail[int] = |e| {
        caught.store(true)
        got.store(e)
        0
    } {
        ro xs = with Supervisor = sup.escalate() {
            parallel for i in 0..8 {
                if i == 5 { throw 555 }
                i
            }
        }
        xs.len()
    }
    assert(caught.load())
    assert(got.load() == 555)
}
