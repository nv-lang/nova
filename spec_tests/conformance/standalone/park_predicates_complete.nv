// EXPECT_STDOUT park predicates completed
// EXPECT_TIMEOUT_MS 20000

module standalone.park_predicates_complete

import std.fs

fn main() Io Time Proc -> () {
    for i in 0..512 {
        ro ch = Channel[int].new(1)
        ro { tx, rx } = ch
        // A second arm exercises multi-arm parking instead of plain recv.
        ro idle = Channel[int].new(1)
        ro { tx: idle_tx, rx: idle_rx } = idle
        supervised {
            spawn {
                Time.sleep(1.to_millis())
                if i % 2 == 0 {
                    assert(tx.send(i))
                }
                tx.close()
            }
            if i % 2 == 0 {
                mut received = false
                select {
                    Some(value) = rx => { assert(value == i); received = true }
                    Some(_) = idle_rx => { assert(false) }
                }
                assert(received)
            } else {
                mut closed = false
                select {
                    None = rx => { closed = true }
                    Some(_) = idle_rx => { assert(false) }
                }
                assert(closed)
            }
        }
        idle_tx.close()
    }
    with Fs = fs.real_fs() {
        for _ in 0..32 {
            assert(fs.metadata(".".to_path()).is_ok())
        }
    }
    print("park predicates completed")
}
