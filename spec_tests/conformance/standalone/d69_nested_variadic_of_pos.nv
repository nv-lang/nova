// Реестр 221.1 №726 — вложенный вариадик внутри аргументов вариадика.
//
// ЧТО БЫЛО. `Vec[Vec[u32]].of(Vec[u32].of(1, 2, 3))` НЕ СОБИРАЛСЯ. Отказ
// приходил не от Nova, а от clang, и звучал внутренними именами Си:
// `too many arguments to function call, expected single argument 'args'`.
//
// МЕХАНИЗМ. Вариадик-вызов переписывается в обычный (хвост аргументов
// собирается в синтезированный массив), и `emit_call` вызывается рекурсивно с
// поднятым флагом подавления — иначе тот же вызов перемаршрутизировался бы
// бесконечно. Флаг оставался поднятым на всю эмиссию, включая АРГУМЕНТЫ, и
// вложенный `.of` внутри них терял упаковку: в Си уходили три голых аргумента
// при сигнатуре с одним.
//
// ПОЧЕМУ ФИКСТУРА ПИНИТ И СОСЕДЕЙ. Отказ вскрылся не там, где стоял триггер:
// ошибка Си указывала на строку с `push`, хотя ломала её строка с внешним
// `.of` ниже. Форма (1) собиралась сама по себе и переставала собираться от
// появления формы (4) в том же модуле — поэтому здесь стоят все пять сразу,
// в одном модуле: порознь они ничего не доказывают.
//
// ПОЧЕМУ `u32`, А НЕ `int`. Первая версия была на `int` и получила
// `W_REDUNDANT_OF`: для голых `int`-литералов канон — литерал `[...]`, и `.of`
// там лишний (nv-coding-style §28). Но фикстура именно про `.of`, литерал не
// задел бы разбираемый путь вовсе. То же правило называет законный случай:
// `.of` оправдан, когда литерал не даёт нужный тип, — сужение до `u32` и есть
// он. Путь вариадика при этом ровно тот же.

module standalone.d69_nested_variadic_of_pos

fn take(v Vec[u32]) -> int {
    v.len()
}

fn main() Io -> () {
    // (1) вариадик в обычной позиции
    ro flat = Vec[u32].of(1, 2, 3)
    assert(flat.len() == 3)

    // (2) вариадик аргументом МЕТОДА
    mut built = Vec[Vec[u32]].new()
    built.push(Vec[u32].of(1, 2, 3))
    assert(built.len() == 1)
    assert(built[0].len() == 3)

    // (3) вариадик аргументом свободной функции
    assert(take(Vec[u32].of(4, 5)) == 2)

    // (4) вариадик внутри аргументов ДРУГОГО вариадика — сам дефект
    ro nested = Vec[Vec[u32]].of(Vec[u32].of(1, 2, 3))
    assert(nested.len() == 1)
    assert(nested[0].len() == 3)

    // (5) две вложенных группы разом
    ro two = Vec[Vec[u32]].of(Vec[u32].of(1), Vec[u32].of(2, 3))
    assert(two.len() == 2)
    assert(two[1].len() == 2)
}
