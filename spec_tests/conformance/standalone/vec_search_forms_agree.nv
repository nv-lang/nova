// EXPECT_STDOUT int: 1 3 3 true 2 2 2 | res: 1 3 3 true 2 2 2 | closed=90
//
// Plan 246, D464 amendment 2026-09-25 (linearity axis): the search methods of
// Vec come as a pair -- a general `[T consume]` form that looks at elements
// through `view_at`, and a fast plain `[T]` form that reads them directly. An
// ordinary `T` (`int`) takes the fast form, a must-consume `T` (`Res`) the
// general one, and the pair owes EQUAL results: the same queries over the
// same keys print the same line for both. Every `Res` is closed once.

module standalone.vec_search_forms_agree

type Res consume {
    id int
}

fn Res consume @close() -> int => @id

fn at(r Result[int, int]) -> int => match r {
    Ok(i) => i
    Err(i) => 100 + i
}

fn main() Io -> () {
    ro v = Vec[int].of(10, 20, 30, 20)
    ro s = Vec[int].of(10, 20, 30, 40)
    ro ip = v.position(|x| x == 20) ?? -1
    ro ir = v.rposition(|x| x == 20) ?? -1
    ro ic = if v.contains(20) { 3 } else { 0 }
    ro isr = s.is_sorted_by(|a, b| a - b)
    ro ib = at(s.binary_search_by(|x| x - 30))
    ro ik = at(s.binary_search_by_key(|x| x / 10, 3))
    ro ii = v.index_of(30) ?? -1
    print("int: ${ip} ${ir} ${ic} ${isr} ${ib} ${ik} ${ii} | ")

    consume w = Vec[Res].new()
    w.push(Res { id: 10 })
    w.push(Res { id: 20 })
    w.push(Res { id: 30 })
    w.push(Res { id: 20 })
    ro rp = w.position(|r| r.id == 20) ?? -1
    ro rr = w.rposition(|r| r.id == 20) ?? -1
    ro rc = if w.position(|r| r.id == 20).is_some() { 3 } else { 0 }
    consume t = Vec[Res].new()
    t.push(Res { id: 1 })
    t.push(Res { id: 2 })
    t.push(Res { id: 3 })
    t.push(Res { id: 4 })
    ro rs = t.is_sorted_by(|a, b| a.id - b.id)
    ro rb = at(t.binary_search_by(|r| r.id - 3))
    ro rk = at(t.binary_search_by_key(|r| r.id, 3))
    ro ri = w.position(|r| r.id == 30) ?? -1
    print("res: ${rp} ${rr} ${rc} ${rs} ${rb} ${rk} ${ri} | ")
    mut closed = 0
    for consume r in w {
        closed += r.close()
    }
    for consume r in t {
        closed += r.close()
    }
    print("closed=${closed}")
}
