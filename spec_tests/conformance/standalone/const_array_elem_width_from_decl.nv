// EXPECT_STDOUT 5 2 5 1|5 300 65535|1 10 100
// Ширина элемента константного массива берётся из ОБЪЯВЛЕНИЯ, а не из литералов
// (реестр 221.1 №1003, блокер тега; окно 283 нашло на таблице степеней пяти).
//
// До фикса `const T []u8 = [5, 2, 5, 1]` строился как вектор `int` — восемь байт на
// элемент, — и клался в слот `[]u8`: однобайтовое чтение попадало ВНУТРЬ первого
// `int`, и элемент 1 оказывался его вторым байтом, то есть нулём. Печаталось
// `5 0 0 0` при верных `T.len()` и `T[0]` — из-за этого дефект и не был замечен
// раньше: длина и нулевой элемент верны всегда.
//
// Три ширины НАМЕРЕННО: `[]int`, `[]u64`, `[]f64` работали и до фикса, потому что
// ширина литерала СЛУЧАЙНО совпадала с объявленной, — «работает» там было везением.
// Страдали узкие: u8/u16/u32 и f32 (литерал дроби по умолчанию f64).
module standalone.const_array_elem_width_from_decl

const B8 []u8 = [5, 2, 5, 1]
const B16 []u16 = [5, 300, 65535]
const F32 []f32 = [1e0, 1e1, 1e2]

fn main() Io -> () {
    print("${B8[0]} ${B8[1]} ${B8[2]} ${B8[3]}|")
    print("${B16[0]} ${B16[1]} ${B16[2]}|")
    print("${F32[0] as int} ${F32[1] as int} ${F32[2] as int}")
}
