// EXPECT_STDOUT cfg-ok
module standalone.cfg_target_os_item

#cfg(target_os = "windows")
fn selected_os() -> str => "windows"

#cfg((target_os = "linux" || target_os = "macos") && !target_os = "windows")
fn selected_os() -> str => "posix"

fn main() Io -> () {
    ro selected = selected_os()
    if selected == "windows" {
        println("cfg-ok-windows")
    } else {
        println("cfg-ok-posix")
    }
}
