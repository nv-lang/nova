// SPDX-License-Identifier: MIT OR Apache-2.0
// EXPECT_STDOUT main done
// EXPECT_STDERR NOVA_ORPHAN_DRAIN_GIVEUP_SECS=0 restores
// EXPECT_EXIT_CODE 70
// EXPECT_TIMEOUT_MS 60000
//
// Registry 221.1 #2046 (owner word 2026-11-28): the pre-exit orphan drain
// used to wait FOREVER for a detached fiber it cannot cancel — one blocked
// in a raw extern "C" call has no safepoints and registers no stop_cb, so
// neither the early orphan cancel nor the periodic stop ever reaches it
// (carrier: hub_test wide run, all checks green, then a silent hang with
// `pre-exit-drain-...-remote-4`). The fix: no decrease of the remote count
// for NOVA_ORPHAN_DRAIN_GIVEUP_SECS seconds (default 60) -> a loud stderr
// line, a final state dump, and _exit(70) (EX_SOFTWARE).
//
// This fixture is the RED shape made deterministic: a detached fiber
// blocked 30 s in a raw libc Sleep/sleep (the carrier's candidate (a)),
// give-up shortened to 5 s via the env the drain reads at exit. Expected:
// "main done", the give-up line on stderr, exit code 70 — the process must
// NOT wait out the 30 s block and must NOT hang. On a pre-fix runtime this
// fixture times out instead (EXPECT_TIMEOUT_MS is the red verdict).

module standalone.p2046_orphan_drain_giveup

import std.os.{env}

#cfg(target_os = "windows")
extern "C" fn Sleep(ms int) -> ()

#cfg(!target_os = "windows")
extern "C" fn sleep(secs int) -> int

#cfg(target_os = "windows")
fn blocker() -> () { Sleep(30000) }

#cfg(!target_os = "windows")
fn blocker() -> () { ro _ = sleep(30) }

fn main() Io Os Detach -> () {
    match env("NOVA_ORPHAN_DRAIN_GIVEUP_SECS", "5") {
        Ok(_) => ()
        Err(e) => panic("set env failed")
    }
    detach { blocker() }
    println("main done")
    // Pre-exit orphan drain from here: the blocked detached fiber never
    // finishes; 5 s without progress -> stderr line + dump + exit 70.
}
