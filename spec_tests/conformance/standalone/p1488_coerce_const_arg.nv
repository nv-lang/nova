// --- `const` imported from another module (`import std.unicode.{UNICODE_VERSION}`)

const P1488_GB_IMPORT []u8 = UNICODE_VERSION

fn via_import(mut w P1488Sink) -> () { w.put(UNICODE_VERSION) }

fn ra_import() -> ro []u8 => UNICODE_VERSION

fn rs_import(k int) -> ro []u8 {
    if k > 5 {
        return "early"
    }
    return UNICODE_VERSION
}

fn show_import(pos str, got str) Io -> () {
    println("import ${pos} ${got == UNICODE_VERSION}")
}

fn run_import() Io -> () {
    ro bx = P1488Box { n: 0 }
    show_import("free", echo(UNICODE_VERSION))
    show_import("method", bx.echo(UNICODE_VERSION))
    mut t = P1488Tally { got: "" }
    t.put(UNICODE_VERSION)
    show_import("mutmethod", t.got)
    mut tp = P1488Tally { got: "" }
    via_import(tp)
    show_import("proto", tp.got)
    ro b []u8 = UNICODE_VERSION
    show_import("rolet", dec(b))
    show_import("retarrow", dec(ra_import()))
    show_import("retstmt", dec(rs_import(0)))
    ro xs []ro []u8 = [UNICODE_VERSION, "zz"]
    show_import("elem", dec(xs[0]))
    ro h = P1488Hold { data: UNICODE_VERSION }
    show_import("recfield", dec(h.data))
    mut ar ro []u8 = "zz"
    ar = UNICODE_VERSION
    show_import("assignro", dec(ar))
    show_import("modlet", dec(P1488_GB_IMPORT))
}

fn main() Io -> () {
    run_lconst()
    run_lconstann()
    run_modro()
    run_modroann()
    run_assoc()
    run_assocunann()
    run_constfield()
    run_assocfield()
    run_import()
}
