// EXPECT_STDOUT one=a=7 two=7+1=8 esc=${i} tick=a`b blocklen=4 deeplen=8
// D467 §5 (план 277 Ф.3): голый backtick — тег ПО УМОЛЧАНИЮ, то есть
// интерполирует так же, как `"..."`. До Ф.3 голая форма отдавала СЫРУЮ строку
// и `${i}` печаталось буквально (замер реестра №795) — при том, что
// тегированная форма рядом, в том же файле, интерполировала.
//
// ПРОБА ОБЕИХ СТОРОН. Верни в parser/mod.rs голую ветку `TokenKind::Backtick`
// к прежнему виду (`StrLit(parts.concat())` без разбора аргументов) — и
// фикстура покраснеет ЧЕТЫРЬМЯ полями сразу: one/two/block напечатают
// `${...}` дословно, а `esc` совпадёт случайно (он и должен быть буквальным) —
// то есть краснота видна, а поле-контроль показывает, что она не тотальная.
module standalone.d467_bare_backtick_interp

fn main() Io -> () {
    ro i = 7
    // простая интерполяция в голой форме
    ro one = `a=${i}`
    // выражение, а не только имя; и две интерполяции в одной строке
    ro two = `${i}+1=${i + 1}`
    // `\$` (D467 §6, один из ровно трёх escape) даёт БУКВАЛЬНЫЙ `${i}`:
    // интерполяции здесь нет, и это контроль против «покраснело всё подряд»
    ro esc = `\${i}`
    // `\`` — второй из трёх escape; до Ф.3 однострочная голая форма вообще не
    // проходила через сплиттер, и здесь оставалось два символа вместо одного
    ro tick = `a\`b`
    // блочная форма интерполирует и держит гигиену тела (§7): голова снята,
    // общий отступ снят, перевод последней содержательной строки ОСТАЁТСЯ.
    // Строка ЗАКРЫВАЮЩЕГО backtick участвует в общем отступе — здесь она
    // выровнена с содержимым, поэтому снимаются все 8 пробелов и тело равно
    // `x=7\n`, ровно 4 байта. Меряю длиной, а не сравнением строк: хвостовой
    // перевод иначе съел бы разделитель в `println`.
    ro block = `
        x=${i}
        `
    // а здесь закрывающая строка отступлена МЕНЬШЕ содержимого — общий отступ
    // равен её четырём пробелам, и содержимое сохраняет лишние четыре:
    // `    x=7\n` = 8 байт. Замерено, а не предположено: первая редакция этой
    // фикстуры ждала здесь 4 и покраснела — правило оказалось не тем, что я
    // помнил, и выиграл компилятор.
    ro deep = `
        x=${i}
    `
    println("one=${one} two=${two} esc=${esc} tick=${tick} blocklen=${block.byte_len()} deeplen=${deep.byte_len()}")
}
