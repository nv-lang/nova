// Ratchet: after every stage of plan 280, a fresh NOVA_CACHE=0 emission of
// this file must equal m280_price_ratchet_baseline.expected.c byte-for-byte.
module standalone.m280_price_ratchet_baseline

fn greet(tag str = "ok") -> str => tag

fn add(a int, b int = 5) -> int
    requires a > 0, "a must be positive"
{
    a + b
}

fn middle(x int) -> int {
    assert(x > 0, "x must be positive")
    add(x, b: 10)
}

fn main() Io -> () {
    ro g = greet()
    ro s1 = add(2)
    ro s2 = middle(2)
    println("${g} ${s1} ${s2} done")
}
