// scope_multierror_test.nv — Plan 173 хвост (D414 §1 ← Ф.4): scope
// MultiError-агрегация. «Не-primary ошибки уходят в suppressed-карман»
// (спека D414 §1) — теперь реализовано: re-throw хвост supervised собирает
// все прочие retained детские падения (кроме CANCEL-производных и
// Stop-решённых) в suppressed-цепочку primary-броска; после ловли primary
// они читаются `suppressed() -> []any` (D158 модель Б, как cleanup-ошибки).
//
// Детерминизм теста 1: в supervisor-режиме отмена siblings НЕ летит до
// решения хендлера (173.2) — хендлер спин-ждёт, пока ОБА ребёнка
// зафиксируют падение (fetch_add строго перед throw, между ними нет
// yield-точки), затем эскалирует. Оба слота retained гарантированно.
//
// Бежит ARMED на дефолтном worker-count (M:N — периметр семантики).

module standalone.scope_multierror_test

import std.concurrency.supervisor as sup
// Plan 175.2 Ф.2-v4 (П6): (5).to_millis() used to resolve without an
// explicit import — an accidental side effect of Time (and its
// Duration/Timestamp/Monotonic import) living in std.prelude.effects
// (auto-imported into every CU). Now that Time moved to std.time.duration,
// this file needs its own explicit import for the to_millis() blanket.
import std.time.duration

test "MultiError: не-primary детская ошибка читается suppressed() после ловли primary" {
    mut failed = AtomicInt.new(0)
    mut caught = -1
    ro _ = with Fail[int] = |e| {
        caught = e
        0
    } {
        with Supervisor = effect Supervisor {
            on_child_fail(_idx, _err) -> Decision {
                // Дождаться фиксации ОБОИХ падений — потом эскалировать.
                mut spins = 0
                while failed.load() < 2 { spins += 1 }
                return Decision.Escalate
            }
        } {
            supervised {
                spawn {
                    failed.fetch_add(1)
                    throw 111
                }
                spawn {
                    failed.fetch_add(1)
                    throw 222
                }
            }
        }
        99
    }
    assert(caught == 111 || caught == 222)
    ro supd = suppressed()
    assert(supd.len() == 1)
    ro want = if caught == 111 { 222 } else { 111 }
    ro e0 = supd.get(0)!!
    assert(e0 is int)
    if Some(v) = e0.try_as[int]() {
        assert(v == want)
    } else {
        assert(false)
    }
}

test "MultiError: Stop-решённые ошибки retained, но в suppressed не текут" {
    // Свежая пойманная ошибка сбрасывает карман (D158: новый throw =
    // новый карман) — изолируемся от предыдущего теста в том же CU.
    mut reset = -1
    ro _ = with Fail[int] = |e| {
        reset = e
        0
    } {
        throw 5
        99
    }
    assert(reset == 5)

    mut done = AtomicInt.new(0)
    mut after = 0
    with Supervisor = sup.stop() {
        supervised {
            spawn { throw 333 }
            spawn {
                (5).to_millis().sleep()
                done.fetch_add(1)
            }
        }
        after = 1
    }
    assert(after == 1)          // Stop: ошибка наружу не вышла
    assert(done.load() == 1)    // sibling дожил
    assert(suppressed().len() == 0)  // выкинутая ошибка не течёт в карман
}

test "MultiError: default-Escalate — suppressed ⊆ прочие детские ошибки, без дублей primary" {
    // Default-режим: первая эскалация отменяет siblings кооперативно —
    // сколько успело зафиксироваться, столько retained (0..2). Инвариант
    // (любое расписание): каждый suppressed-элемент — int из набора тегов,
    // НЕ равный primary; CANCEL-производные не попадают.
    mut caught = -1
    ro _ = with Fail[int] = |e| {
        caught = e
        0
    } {
        supervised {
            spawn { throw 501 }
            spawn { throw 502 }
            spawn { throw 503 }
        }
        99
    }
    assert(caught >= 501 && caught <= 503)
    ro supd = suppressed()
    assert(supd.len() <= 2)
    mut i = 0
    while i < supd.len() {
        ro e = supd.get(i)!!
        assert(e is int)
        if Some(v) = e.try_as[int]() {
            assert(v >= 501 && v <= 503)
            assert(v != caught)
        } else {
            assert(false)
        }
        i += 1
    }
}
