// EXPECT_STDOUT btag=tag neg=true abs=5 ok
// SPDX-License-Identifier: MIT OR Apache-2.0
//
// Реестр 221.1 №712, РЕГРЕСС-ПОЛОВИНА. Blanket-метод на ВСТРОЕННОМ типе
// работал и ДО правки — легаси-вывод кодогена справлялся с ним сам. Правка
// №712 дописывает такому вызову запись в канал `resolved_types`, и это
// НЕ инертное действие: канал читают и другие места кодогена. Значит цена
// правки измеряется здесь, а не на пользовательском типе.
//
// ЧЕГО ИМЕННО БОЯЛИСЬ, названо прямо: превратить ранний `return` в
// `f3_check_member_ctx` в отказ было НЕЛЬЗЯ — это сломало бы ровно то, что
// пинит эта фикстура. Поэтому здесь стоит и СВОЙ blanket на `int`, и ДВА
// настоящих blanket'а прелюдии (`std/src/prelude/protocols.nv`):
//   * `is_negative()` — `fn[T SignedInts] T @is_negative() -> bool`, СЛУЧАЙ (A):
//     возврат фиксирован, значит правка его аннотирует, и он обязан остаться
//     верным;
//   * `abs()` — `fn[T SignedInts] T @abs() -> T`, СЛУЧАЙ (B): возврат — тот
//     самый параметр-получатель, правка обязана здесь ПРОМОЛЧАТЬ и оставить
//     прежний путь.
// Пара «аннотируется / не аннотируется» на соседних строках и есть проверка
// границы, а не просто ещё два зелёных вызова.
module standalone.d712_blanket_builtin_regress_pos

fn[T] T @d712_btag() -> str => "tag"

fn main() Io -> () {
    ro n = 5
    ro btag = n.d712_btag()
    ro m = -5
    ro neg = m.is_negative()
    ro a = m.abs()
    print("btag=${btag} neg=${neg} abs=${a} ok")
}
