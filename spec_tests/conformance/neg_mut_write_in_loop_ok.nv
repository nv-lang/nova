// Plan 123.2 T-NEG.1: @F = ... inside loop body → no hoist (LICM
// correctness preserved). Semantic equivalence verified.

module spec_tests.conformance
type Counter10_1 {
    mut value int
}

fn Counter10_1 mut @increment_n(n int) -> int {
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        @value += 1   // ← write to @value inside loop
        i += 1
    }
    @value
}

fn Counter10_1.new(v int) -> Counter10_1 {
    Counter10_1 { value: v }
}

test "write in loop blocks LICM — correctness preserved" {
    mut c = Counter10_1.new(0)
    ro r = c.increment_n(5)
    // value 0 → 5.
    assert(r == 5)
}
