// D372-amend2 — shared fixture type for the generic-static-ctor default-arg
// regression test (d372_canonical_new_defaults.nv). Declared in its OWN
// peer file (folder-module co-equal peer, D29 — `spec_tests/conformance`
// is one folder-module, so this file merges with every sibling `.nv` here
// into the SAME compile unit, no import needed) so the call-site in the
// sibling D372 test file exercises a genuine CROSS-FILE merge, matching the
// pattern `types_<domain>.nv` + `d<NNN>_<topic>.nv` used elsewhere in this
// suite (e.g. `types_value_record.nv` + `d328_value_record_eq.nv`).
module spec_tests.conformance

/// A user-defined GENERIC type with a STATIC constructor taking a DEFAULT
/// argument — the exact shape (generic-static-ctor + default-arg) that
/// exposed the callnorm/codegen default-backfill gap
/// `[M-vec-new-cap-default-arg-backfill]` for `Vec[T].new(cap int = 0)`.
/// `slot` mirrors an arbitrary payload; `cap` mirrors Vec's own `cap`
/// default-arg (D372 amend 2).
export type D372Box[T] { slot T, cap int }

/// Generic-static ctor with a DEFAULT arg — called via the explicit
/// turbofish spelling `D372Box[int].make(...)` at the call-site. Parses to
/// `Member{obj: TurboFish{base: Ident("D372Box"), ..}, name: "make"}` —
/// the AST shape `try_normalize_call` (callnorm.rs) previously
/// misclassified as a plain instance-method call (falling into
/// `instance_by_name`, which has no "make" entry) instead of the
/// `static_methods` table where this declaration actually lives, so the
/// omitted `cap` was never backfilled and the call reached codegen with
/// too few arguments against the mono'd C signature (which always takes
/// `cap` — Nova default-args are a caller-side AST rewrite, never a C-level
/// default).
export fn D372Box[T].make(slot T, cap int = 42) -> Self => { slot, cap }
