//
// Plan 173 Ф.5 (#8, D188 R2): the RUNTIME exactly-once guard — hidden
// per-instance `_consume_ccount` checked in the `Nova_<T>_consume_cleanup`
// prologue (the single chokepoint every invocation path funnels through).
// Vector here: a manual `.cleanup(...)` call smuggled through a FUNCTION
// BOUNDARY (a helper taking the resource as a view param) — invisible to
// the compile-time D188-r2-manual-on-exit checker (it walks only the
// consume-scope body), yet a genuine second invocation at runtime.
// First invocation = the helper's manual call; second = the consume-scope's
// own scope-exit dispatch → prologue guard panics.

module nova_tests.err173

type DblRes { ro id int }
fn DblRes.new(id int) -> DblRes => { id }
fn DblRes consume @cleanup(_o ScopeOutcome) -> () => ()

// Helper: manual cleanup on a view param — past the syntactic checker.
fn sneaky_manual(v DblRes) -> () {
    v.cleanup(Success)
}

test "f5 double invoke panic" panics "D188-on-exit-double-invocation" {
    consume r = DblRes.new(1) {
        sneaky_manual(r)
    }
    println("UNREACHABLE")
}
