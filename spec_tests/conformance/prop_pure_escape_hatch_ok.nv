// Plan 123.3 T-PROP.2: escape hatch — semantic equivalence under
// NOVA_FIELD_CACHE_PURE=0.

module spec_tests.conformance
type Polynomial2 {
    ro coeff int
    ro power int
}

#pure
fn Polynomial2 @value() -> int {
    mut r = 1
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < @power {
        r *= @coeff
        i += 1
    }
    r
}

fn Polynomial2 @sum_three() -> int {
    @value() + @value() + @value()
}

fn Polynomial2.new(c int, p int) -> Polynomial2 {
    Polynomial2 { coeff: c, power: p }
}

test "pure cache escape hatch preserves semantics" {
    ro p = Polynomial2.new(2, 5)
    ro r = p.sum_three()
    // 2^5 = 32, ×3 = 96.
    assert(r == 96)
}
