// D55 — Literal coercion в позиции с ЯВНЫМ целевым типом T (spec/decisions/02-types.md:947).
// Покрыто: (2) record-coercion (анонимный {field:val} получает тип T), (4) numeric literal coercion
// (int-литерал принят без `as` если влезает в диапазон). (1) sum-coercion (D55.1) —
// Plan 200 (sql-autoconv, 2026-07-12) закрыл ранее задокументированный
// компилятор-gap: «обёртка ровно в один совпадающий unary-вариант» теперь
// работает и для литералов, и для переменных (не только для literal'ов),
// а также единообразно для newtype (`type X Y`) — см. D55 amend §«Obvious
// single-wrapper coercion». Покрывает и array-literal element-позицию
// (`[]SumType`), и call-arg позицию (в т.ч. desugar'енный tag-template
// D48 `` sql`${expr}` ``, тест — std/data/sql_test.nv).
module spec_tests.conformance

type D55Rec { n int }

type D55Sum enum I(int) | S(str) | B(bool)
type D55UserId int

test "record-coercion: анонимный { n: 7 } → D55Rec без имени типа (D55.2)" {
    ro r D55Rec = { n: 7 }
    assert(r.n == 7)
}
test "numeric literal coercion: int-литерал → u8 без `as` (D55.4)" {
    ro b u8 = 200
    assert(b == 200)
}
test "sum-coercion: литерал → единственный совпадающий unary-вариант (D55.1)" {
    ro a D55Sum = 42
    ro b D55Sum = "hi"
    ro c D55Sum = true
    match a { D55Sum.I(n) => assert(n == 42), _ => assert(false) }
    match b { D55Sum.S(s) => assert(s == "hi"), _ => assert(false) }
    match c { D55Sum.B(x) => assert(x == true), _ => assert(false) }
}
test "sum-coercion: ПЕРЕМЕННАЯ (не только литерал) → единственный вариант (D55.1 amend)" {
    ro n = 7
    ro v D55Sum = n
    match v { D55Sum.I(x) => assert(x == 7), _ => assert(false) }
}
test "sum-coercion: array-literal элементная позиция (D55.1 amend)" {
    ro xs []D55Sum = [1, "two", false]
    assert(xs.len() == 3)
    match xs[0] { D55Sum.I(n) => assert(n == 1), _ => assert(false) }
    match xs[1] { D55Sum.S(s) => assert(s == "two"), _ => assert(false) }
    match xs[2] { D55Sum.B(b) => assert(b == false), _ => assert(false) }
}
test "sum-coercion: явный конструктор не двойно оборачивается (D55.1 amend)" {
    ro v D55Sum = D55Sum.I(5)
    match v { D55Sum.I(n) => assert(n == 5), _ => assert(false) }
}
test "newtype-coercion: литерал И переменная → newtype без `as` (D55 amend, D52 open question closed)" {
    ro a D55UserId = 100
    ro n = 100
    ro b D55UserId = n
    assert((a as int) == 100)
    assert((b as int) == 100)
}

// Plan 208 Ф.3 (owner instruction 2026-07-16): str-литерал → `[]u8` coercion
// в `.write(...)`-call-arg позиции (D55 amend "Str-литерал → []u8 coercion",
// см. spec/decisions/02-types.md "Статус реализации" — codegen support для
// ИМЕННО этой формы, `emit_c.rs::synthesize_write_str_lit_bytes_coercion`).
type D55WriteSink { s str }

fn D55WriteSink @display(mut f Fmt) -> () {
    f.write("[")               // str-литерал, БЕЗ `.bytes()` — коэрсия (D55)
    f.write(@s.bytes())        // str-ПЕРЕМЕННАЯ (поле) — явный `.bytes()` всё ещё нужен
    f.write("]")
}

test "str-литерал → []u8 без .bytes() в Fmt.write(...) call-arg (D55 amend, Plan 208 Ф.3)" {
    ro w = D55WriteSink { s: "mid" }
    assert("${w}" == "[mid]")
}
