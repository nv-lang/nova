// Plan 284 F.1 pos (stack/value storage class): a user-defined VALUE record
// (`type SmallBag value { ... }`, monomorphizes to the stack-allocated
// `NovaValue_SmallBag`, no heap allocation) gets `x[a..]` open-range slicing
// by SATISFYING THE ROLE — `@index(r Range)` plus `@end_index() -> int` —
// exactly like its heap sibling `openrange_len_field_heap.nv`.
//
// Both storage classes are mandatory here for the same reason they were
// under the retired structural test (owner's rule, §"класс хранения — ОБА
// обязательны"): the receiver ABI differs (`NovaValue_`-prefixed non-pointer
// versus a heap handle), so a role satisfied on one says nothing about the
// other. What no longer differs is HOW the open end is read: it is a call to
// `@end_index()` now, not a `.len`/`->len` field access chosen by storage
// class.

module spec_tests.conformance
import std.collections.range.{Range}

type SmallBag value {
    len int
}

fn SmallBag @index(r Range) -> SmallBag {
    SmallBag { len: r.end - r.start }
}

fn SmallBag @len() -> int => @len

// The role's second method: the end of THIS value's index space, asked and
// answered by the type itself. Here it coincides with the `len` field, and
// that coincidence is the point — a type is free to answer differently.
fn SmallBag @end_index() -> int => @len

test "value-record with len int field gets open-range slice for free" {
    ro b = SmallBag { len: 9 }
    ro v = b[2..]
    assert(v.len() == 7)
}
