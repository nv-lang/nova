// Plan 123.2 T-PROP.2: LICM composes correctly with Plan 123.1
// (no double-cache, no shadowing, all reads correctly resolved).

module spec_tests.conformance
type Mix3_2 {
    ro factor int
    mut counter int
}

fn Mix3_2 mut @combined(n int) -> int {
    // Reads outside loop + reads inside loop:
    // @factor: 1 outside + (2 × n) inside = 1 + 2n.
    // @counter: 2 inside + 1 outside (assign) = 3.
    ro initial = @factor
    mut sum = 0
    mut i = 0
    // nova:allow W_WHILE_COUNTER_FOR_RANGE -- Plan 123 LICM/field-cache conformance fixture: pins the optimizer behavior specifically on a while-shaped loop; for-in desugars through the iterator protocol (D58), a different codegen path — rewriting would risk silently exercising something else
    while i < n {
        sum += @factor * @factor
        i += 1
    }
    @counter += 1
    sum + initial + @counter
}

fn Mix3_2.new(f int, c int) -> Mix3_2 {
    Mix3_2 { factor: f, counter: c }
}

test "LICM + Plan 123.1 composition correct" {
    mut m = Mix3_2.new(3, 10)
    ro r = m.combined(4)
    // initial=3, sum = 4*(3*3)=36, counter 10→11, return 36+3+11=50.
    assert(r == 50)
}

test "composition zero iter" {
    mut m = Mix3_2.new(5, 0)
    ro r = m.combined(0)
    // initial=5, sum=0, counter 0→1, return 0+5+1=6.
    assert(r == 6)
}
