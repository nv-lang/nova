// [M-compress-checksum-structvariant-ctor-xmodule] (P1, Plan 173 P1-волна): mod_b —
// СОВЕРШЕННО ДРУГАЯ сумма, названная ТЕМ ЖЕ именем `Kind`, что и в
// `xmodule_struct_variant_ctor_a` (зеркалит co-presence `ErrorKind` из std/io И
// std/encoding/compress в одном http-CU). Ни один вариант здесь НЕ struct-payload —
// коллизия важна только на уровне ИМЕНИ СУММЫ (`Kind`), не вариантов.
module conformance.xmodule_struct_variant_ctor_b

export type Kind enum
    | Bad(str)
    | Empty

export fn make_bad(msg str) -> Kind =>
    Bad(msg)
