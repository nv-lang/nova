// D249 — Строковая координатная модель: str-координаты = байты; str[i] int запрещён;
// str[a..b] — byte-range view; bytes() → ro []u8; byte_len() = единственная длина.
// Spec: spec/decisions/03-syntax.md D249. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

fn d249_byte_len(s str) -> int => s.byte_len()

fn d249_starts_with(s str, prefix str) -> bool => s.starts_with(prefix)

fn d249_ends_with(s str, suffix str) -> bool => s.ends_with(suffix)

test "str.byte_len() is O(1) length in bytes (D249)" {
    assert("hello".byte_len() == 5)
    assert("".byte_len() == 0)
    assert("ab".byte_len() == 2)
}

test "str.byte_len() via function param (D249)" {
    assert(d249_byte_len("xyz") == 3)
    assert(d249_byte_len("") == 0)
}

test "str.starts_with / ends_with (D249)" {
    assert("hello world".starts_with("hello"))
    assert("hello world".ends_with("world"))
    assert(!"hello world".starts_with("world"))
    assert(!"hello world".ends_with("hello"))
}

test "str equality (D249)" {
    assert("abc" == "abc")
    assert(!("abc" == "def"))
    assert("" == "")
}

test "str concatenation produces correct byte_len (D249)" {
    mut s = "foo"
    s = s.concat("bar")
    assert(s == "foobar")
    assert(s.byte_len() == 6)
}

test "str.find() returns byte offset (D249)" {
    mut pos = "hello world".find("world")
    assert(pos == Some(6))
    mut miss = "hello".find("xyz")
    assert(miss == None)
}
