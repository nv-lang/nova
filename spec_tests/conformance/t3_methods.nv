// Plan 120 (D215): T3 — methods on named tuples.

module spec_tests.conformance
type Vec35(x f64, y f64, z f64)

fn Vec35 @dot(other Vec35) -> f64 =>
    @x * other.x + @y * other.y + @z * other.z

fn Vec35 @scale(s f64) -> Vec35 =>
    Vec35(@x * s, @y * s, @z * s)

fn Vec35 @add(other Vec35) -> Vec35 =>
    Vec35(@x + other.x, @y + other.y, @z + other.z)

// №145: positional construction — no defaults, D102 forbids named-arg form.
test "Vec35 dot product" {
    ro a = Vec35(1.0, 0.0, 0.0)
    ro b = Vec35(0.0, 1.0, 0.0)
    assert(a.dot(b) == 0.0)
    ro c = Vec35(1.0, 2.0, 3.0)
    ro d = Vec35(1.0, 2.0, 3.0)
    assert(c.dot(d) == 14.0)
}

test "Vec35 scale" {
    ro v = Vec35(1.0, 2.0, 3.0)
    ro scaled = v.scale(2.0)
    assert(scaled.x == 2.0)
    assert(scaled.y == 4.0)
    assert(scaled.z == 6.0)
}

test "Vec35 add" {
    ro a = Vec35(1.0, 2.0, 3.0)
    ro b = Vec35(4.0, 5.0, 6.0)
    ro sum = a.add(b)
    assert(sum.x == 5.0)
    assert(sum.y == 7.0)
    assert(sum.z == 9.0)
}
