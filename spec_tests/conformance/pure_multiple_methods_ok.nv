// Plan 123.3 T1.3: multiple pure methods cached independently.

module spec_tests.conformance
type Stat2 {
    ro n int
    ro k int
}

#pure
fn Stat2 @doubled() -> int => @n * 2

#pure
fn Stat2 @tripled() -> int => @n * 3

fn Stat2 @combined() -> int {
    @doubled() + @tripled() + @doubled() + @tripled()
}

fn Stat2.new(n int, k int) -> Stat2 {
    Stat2 { n, k }
}

test "multiple pure methods independently cached" {
    ro s = Stat2.new(5, 1)
    ro r = s.combined()
    // 10+15+10+15 = 50.
    assert(r == 50)
}
