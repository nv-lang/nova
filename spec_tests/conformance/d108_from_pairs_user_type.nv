// D108 (Plan 52 Ф.23) — `#from_pairs` расширяемость: map-литерал `[k: v]`
// десугарится не только в `HashMap[K, V]` (см. `d108_map_literal.nv`),
// но и в ЛЮБОЙ user-тип, помеченный `#from_pairs` + реализующий протокол
// (spec/decisions/03-syntax.md:5421 — правило-десугаринг):
//   - `static new() -> Self`
//   - `mut @cap(n int) -> @`        (D372 amend: замена `with_capacity`)
//   - `mut @insert_new(key K, val V) -> ()`
// Type-checker (`MapLitCtx::build` в types/mod.rs) валидирует наличие
// всех трёх методов ПЕРЕД тем как добавить тип в `from_pairs_types` —
// без этой валидации user получил бы confusing codegen-error
// («no method new» / «no method cap» / «no method insert_new»).
//
// До этой фикстуры user-#from_pairs протокол проверялся только в
// nova_tests/map_literals/positive_user_from_pairs_with_methods.nv —
// а nova_tests НЕ гейт корректности (только byte-identical baseline,
// см. feedback-nova-tests-not-correctness-gate). conformance-покрытие
// отсутствовало.
module spec_tests.conformance

#from_pairs
type D108Bag[K, V] {
    count int
}

// D450 (2026-08-09): the contract is now ONE constructor with an optional
// capacity — the former trio (new / cap / insert_new) is retired. The `cap`
// parameter is accepted and ignored here; this type only counts insertions.
export fn D108Bag[K, V].new(cap int = 0) -> D108Bag[K, V] {
    ro _ = cap
    D108Bag { count: 0 }
}

export fn D108Bag[K, V] mut @cap(n int) -> @ {}

export fn D108Bag[K, V] mut @insert_new(k K, v V) {
    @count += 1
}

export fn D108Bag[K, V] @len() -> int => @count

test "from_pairs: user-тип получает map-литерал через #from_pairs протокол" {
    ro b D108Bag[int, str] = [1: "a", 2: "b", 3: "c"]
    assert(b.len() == 3)
}

// [M-108-empty-frompairs-nonhashmap-kv-infer-gap] fix (2026-07-10, ветка
// recordlit-callarg-fix): пустой литерал `[]` в позиции user-типа с
// `#from_pairs` (НЕ named `HashMap`) раньше давал RUN-FAIL — `extract_hashmap_kv`
// (types/mod.rs) был захардкожен на literal-имя `"HashMap"`, поэтому K/V не
// выводились для generic non-HashMap `#from_pairs`-типа в EMPTY/all-spread
// map-lit ветке (`inferred_key`/`inferred_value` = None → desugar шёл через
// fallback-callee `Bag.new` (Path) без K/V-мономорфизации). Непустой литерал
// работал (unify берёт типы из элементов). Фикс: kv-тип определяется по
// декларативному `#from_pairs`-атрибуту (`expected_is_from_pairs`), не по
// имени. Ниже — три ранее-падавших empty-контекста.
test "from_pairs: empty-литерал для user-типа (let с явным типом)" {
    ro b D108Bag[int, str] = []
    assert(b.len() == 0)
}

fn d108_make_empty_bag() -> D108Bag[str, int] => []

test "from_pairs: empty-литерал в return-позиции user-типа" {
    ro b = d108_make_empty_bag()
    assert(b.len() == 0)
}

fn d108_takes_bag(b D108Bag[int, str]) -> int => b.len()

test "from_pairs: empty-литерал в call-arg позиции user-типа" {
    ro n = d108_takes_bag([])
    assert(n == 0)
}
