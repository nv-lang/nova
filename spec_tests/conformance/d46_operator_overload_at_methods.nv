// D46 — Перегрузка операторов через `@`-методы с фиксированными именами.
// `a + b` → @plus, `a - b` → @minus, `a * b` → @times, `a / b` → @div,
// `-a` → @neg, `!a` → @not, `a == b` → @equal, `a != b` выводится из @equal.
// Dispatch по первому операнду. Custom-операторы запрещены.
// Spec: spec/decisions/03-syntax.md D46. Part of the SINGLE `spec_tests.conformance` folder-module.
module spec_tests.conformance

// --- Vec2: +, -, *, /, unary -, ! на парах f64 ---

type D46Vec2 {
    x f64
    y f64
}

fn D46Vec2.mk(x f64, y f64) -> D46Vec2 => { x, y }

fn D46Vec2 @plus(other D46Vec2) -> D46Vec2 =>
    { x: @x + other.x, y: @y + other.y }

fn D46Vec2 @minus(other D46Vec2) -> D46Vec2 =>
    { x: @x - other.x, y: @y - other.y }

fn D46Vec2 @times(other D46Vec2) -> D46Vec2 =>
    { x: @x * other.x, y: @y * other.y }

fn D46Vec2 @div(other D46Vec2) -> D46Vec2 =>
    { x: @x / other.x, y: @y / other.y }

fn D46Vec2 @neg() -> D46Vec2 =>
    { x: -@x, y: -@y }

fn D46Vec2 @equal(other D46Vec2) -> bool =>
    @x == other.x && @y == other.y

// --- Bool wrapper for @not ---

type D46BoolBox {
    v bool
}

fn D46BoolBox.mk(v bool) -> D46BoolBox => { v }
fn D46BoolBox @not() -> D46BoolBox => { v: !@v }
fn D46BoolBox @equal(other D46BoolBox) -> bool => @v == other.v

// --- Overloaded @times: scalar vs vector ---

type D46Scalar {
    v f64
}

fn D46Scalar.mk(v f64) -> D46Scalar => { v }
fn D46Scalar @times(other D46Scalar) -> D46Scalar => { v: @v * other.v }

// --- Тесты ---

test "operator + dispatches to @plus (D46)" {
    ro a = D46Vec2.mk(1.0, 2.0)
    ro b = D46Vec2.mk(3.0, 4.0)
    ro c = a + b
    assert(c.x == 4.0)
    assert(c.y == 6.0)
}

test "operator - dispatches to @minus (D46)" {
    ro a = D46Vec2.mk(5.0, 3.0)
    ro b = D46Vec2.mk(2.0, 1.0)
    ro c = a - b
    assert(c.x == 3.0)
    assert(c.y == 2.0)
}

test "operator * dispatches to @times component-wise (D46)" {
    ro a = D46Vec2.mk(2.0, 3.0)
    ro b = D46Vec2.mk(4.0, 5.0)
    ro c = a * b
    assert(c.x == 8.0)
    assert(c.y == 15.0)
}

test "operator / dispatches to @div (D46)" {
    ro a = D46Vec2.mk(10.0, 6.0)
    ro b = D46Vec2.mk(2.0, 3.0)
    ro c = a / b
    assert(c.x == 5.0)
    assert(c.y == 2.0)
}

test "== dispatches to @equal (D46)" {
    ro a = D46Vec2.mk(1.0, 2.0)
    ro b = D46Vec2.mk(1.0, 2.0)
    ro c = D46Vec2.mk(1.0, 3.0)
    assert(a == b)
    assert(!(a == c))
}

test "!= is derived from @equal (D46)" {
    ro a = D46Vec2.mk(1.0, 2.0)
    ro b = D46Vec2.mk(1.0, 2.0)
    ro c = D46Vec2.mk(5.0, 6.0)
    assert(!(a != b))
    assert(a != c)
}

test "chained operator overloads: (a + b) - c (D46)" {
    ro a = D46Vec2.mk(1.0, 2.0)
    ro b = D46Vec2.mk(3.0, 4.0)
    ro c = D46Vec2.mk(1.0, 1.0)
    ro d = (a + b) - c
    assert(d.x == 3.0)
    assert(d.y == 5.0)
}

test "@times on scalar type (D46)" {
    ro a = D46Scalar.mk(3.0)
    ro b = D46Scalar.mk(4.0)
    ro c = a * b
    assert(c.v == 12.0)
}

test "unary - dispatches to @neg (D46)" {
    ro a = D46Vec2.mk(3.0, -5.0)
    ro neg = -a
    assert(neg.x == -3.0)
    assert(neg.y == 5.0)
}

test "unary ! dispatches to @not (D46)" {
    ro t = D46BoolBox.mk(true)
    ro f = !t
    assert(f.v == false)
    ro t2 = !f
    assert(t2.v == true)
}

