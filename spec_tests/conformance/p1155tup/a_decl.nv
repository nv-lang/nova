// потребитель во ВТОРОМ (`b_use.nv`). Порядок назван намеренно: пиры модуля
// обрабатываются отсортированными (`nova-cli/src/main.rs`, `files.sort()`), и
// без указания порядка фикстура зелена от того, КАК НАЗВАЛИ ФАЙЛЫ, а не от
// того, что починено (правило — `docs/dev/test-conventions.md`).
//
// ОБРАТНЫЙ ПОРЯДОК ДЕРЖИТ СОСЕДНЯЯ КЛЕТКА `z_reverse.nv`: там объявление во
// ВТОРОМ файле, и она была зелёной и до починки. Её дело — не дать принять за
// доказательство то, что доказывает лишь работоспособность сборки.
module p1155tup.a_decl

export type Pair (int, int)
