// D368 (generic-return extension) — a sized/unsigned primitive must survive a GENERIC
// instance-method `-> T` return WITHOUT collapsing to signed `nova_int`. The named-priority
// invariant (uint≠int, u8≠i8≠int) under monomorphization: `Box[uint].get()` infers `uint`,
// `Box[u8].get()` infers `u8`. DISCRIMINATING form — the result binding is UNANNOTATED
// (`ro got = b.get()`), so it inherits the call's INFERRED type: if the mono `-> T` body
// erases `T`→`nova_int`, `got` becomes signed `int` and the unsigned high-bit `2^63` reads
// NEGATIVE → `got > 100` is false (RUN-FAIL); a correct `uint` return keeps it positive.
// Spec: spec/decisions/02-types.md (D368). Single `spec_tests.conformance` folder-module;
// D368-prefixed names avoid top-level collisions with the sibling `d126_no_int_collapse.nv`.
module conformance.d368_generic_return_width

type D368GBox[T] {
    gv T
}

fn D368GBox[T].d126_gbox_new(x T) -> Self =>
    { gv: x }

// generic instance method returning the element type T — the U.4.3 erasure surface.
fn D368GBox[T] @d126_get() -> T =>
    @gv

test "generic `-> T` return preserves uint high-bit; no signed collapse (D368)" {
    ro b = D368GBox[uint].d126_gbox_new(0x8000000000000000)   // 2^63
    ro got = b.d126_get()          // UNANNOTATED: inherits the call's inferred type
    assert(got > 100)              // uint: 2^63 > 100 ✓ ; signed collapse → negative → FAIL
}

test "generic `-> T` return preserves u8 identity, not widened/signed (D368)" {
    ro b = D368GBox[u8].d126_gbox_new(200)   // 200 fits u8, exceeds i8 max (127)
    ro got = b.d126_get()                     // UNANNOTATED: inherits inferred type
    assert(got == 200)
    assert(got > 100)
}

test "generic `-> T` return: int instance still round-trips (control) (D368)" {
    ro b = D368GBox[int].d126_gbox_new(-5)   // signed int negative — control case
    ro got = b.d126_get()
    assert(got == -5)
    assert(got < 0)
}
