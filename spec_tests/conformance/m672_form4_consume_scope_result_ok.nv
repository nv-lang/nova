//
// #672 form (4), positive side: the consume-scope result binding is consumed,
// so the scope stays legal.
module spec_tests.conformance

type M672S4Ok consume { tag int }

fn M672S4Ok consume @cleanup(_outcome ScopeOutcome) -> () { @close() }

fn M672S4Ok consume @close() -> () { () }

fn M672S4Ok @share() -> M672S4Ok => { tag: @tag * 10 }

fn m672_form4_ok() -> () {
    consume s = M672S4Ok { tag: 7 }
    consume out = consume s { s.share() }
    assert(out.tag == 70)
    out.close()
}
