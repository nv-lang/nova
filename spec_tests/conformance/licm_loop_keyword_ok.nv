// Plan 123.2 T1.4: `loop { ... break ... }` form.

module spec_tests.conformance
type Wrap3_2 {
    ro limit int
}

fn Wrap3_2 @find_first() -> int {
    mut x = 0
    loop {
        if x >= @limit + @limit { break }
        x += 1
    }
    x
}

fn Wrap3_2.new(l int) -> Wrap3_2 {
    Wrap3_2 { limit: l }
}

test "loop keyword form — @limit hoisted" {
    ro w = Wrap3_2.new(5)
    ro r = w.find_first()
    // limit*2 = 10, x increments from 0 to 10.
    assert(r == 10)
}
