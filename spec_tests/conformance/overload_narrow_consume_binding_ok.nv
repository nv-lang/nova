// №309 (221.1) — форма привязки аргумента влияет на выбор перегрузки по
// режиму параметра {ro,mut,consume} (Plan 184 `narrow_by_param_mode`, D84
// амендмент). spec/decisions/10-overloading.md описывал правило дословно:
// сужение по режиму «от способности аргумента-биндинга» — но реализация
// смотрела ТОЛЬКО на временность значения (rvalue vs place), а не на
// объявленную форму привязки. Правило владельца (2026-08-03, дословно):
// «временное ИЛИ забирающее — перемещается, остальное копируется».
// Три пробы (ровно как в реестре 221.1 №309, пара
// `fn Bag @put(v int)` / `fn Bag @put(consume v int)`):
//   1. временное (`b.put(make())`)         → забирающая
//   2. обычная привязка (`mut x = 5; ...`) → копирующая
//   3. забирающая привязка (`consume t = 7; ...`) → забирающая (БЫЛО:
//      копирующая — вот и есть дефект №309)
module spec_tests.conformance

type P309Bag {
    total int,
}

fn P309Bag @put(v int) -> int => 0
fn P309Bag mut @put(consume v int) -> int {
    v
}

fn p309_make(n int) -> int => n

test "№309 временное значение — забирающая перегрузка" {
    mut b = P309Bag { total: 0 }
    ro r = b.put(p309_make(7))
    assert(r == 7)
}

test "№309 обычная (не-consume) привязка — копирующая перегрузка" {
    mut b = P309Bag { total: 0 }
    mut x = 5
    ro r = b.put(x)
    assert(r == 0)
}

test "№309 забирающая привязка — забирающая перегрузка (дефект был здесь)" {
    mut b = P309Bag { total: 0 }
    consume t = 7
    ro r = b.put(t)
    assert(r == 7)
}

test "№309 ro-привязка (немутабельная, не-consume) — тоже копирующая" {
    mut b = P309Bag { total: 0 }
    ro y = 9
    ro r = b.put(y)
    assert(r == 0)
}
