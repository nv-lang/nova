// Plan 221.1 №113/№428 (D85 ENFORCED): регресс-гард — легитимные `!!`-формы
// НЕ ломаются чекером `E_BANG_REQUIRES_FAIL` (`compiler-codegen/src/types/
// fail_reach.rs::run`, called from `check_module_impl`). Покрывает:
// (1) private fn без Fail — D28 auto-inference, exempt из этого энфорса;
// (2) exported fn с явным `Fail[E]` (Result-`!!`); (3) exported fn с
// `Fail[RuntimeNoneError]` (Option-`!!`); (4) `?? panic(...)` fallback —
// `!!` не участвует, Fail не нужен; (5) `!!` внутри `with Fail = ...` —
// throw ловится ЛОКАЛЬНО этим handler'ом (D158-семья), enclosing fn Fail
// не нужен.
//
// №428 (transitive-property fix) добавляет: (6) exported fn, легитимно
// объявляющая `Fail[E]`, чтобы ПОКРЫТЬ транзитивную цепочку из НЕСКОЛЬКИХ
// private helper'ов (глубина > 1) — сама fn не содержит `!!` буквально;
// (7) то же через МЕТОД (`Type.method`) вместо свободной fn; (8) `!!`
// внутри closure, вызванного синхронно в теле exported fn — closure несёт
// capability ОКРУЖАЮЩЕЙ fn (не своё собственное), Fail на exported fn
// покрывает его; (9) вся цепочка обёрнута `with Fail = ...` СНАРУЖИ —
// транзитивный вызов через несколько hops гасится ОДНИМ handler'ом, как и
// прямой `!!` (форма 5 выше).

module spec_tests.conformance

type ParseErr { msg str }

fn parse(s str) -> Result[int, ParseErr] {
    if s == "" { Err(ParseErr { msg: "empty" }) } else { Ok(1) }
}

fn first_pos(xs []int) -> Option[int] {
    for x in xs { if x > 0 { return Some(x) } }
    None
}

// (1) private fn, Result-`!!`, БЕЗ явного Fail в сигнатуре — D28
// auto-inference подставит `Fail` молча; энфорс №113 приватные fn не трогает.
fn private_uses_bang(s str) -> int {
    parse(s)!!
}

// (2) exported fn, явный `Fail[ParseErr]`.
export fn ok_result_with_fail(s str) Fail[ParseErr] -> int {
    parse(s)!!
}

// (3) exported fn, Option-`!!`, явный `Fail[RuntimeNoneError]`.
export fn ok_option_with_fail(xs []int) Fail[RuntimeNoneError] -> int {
    first_pos(xs)!!
}

// (4) exported fn, `?? panic(...)` — `!!` не задействован вовсе.
export fn ok_panic_fallback(s str) -> int {
    parse(s) ?? panic("unreachable in test")
}

// (5) exported fn, `!!` внутри `with Fail = ...` — локальный catch.
export fn ok_local_with_fail(s str) -> int {
    with Fail = effect Fail { fail(_e) -> never { interrupt (-1) } } {
        parse(s)!!
    }
}

test "d85 №113: private fn `!!` без Fail — D28 auto-inference (exempt)" {
    assert(private_uses_bang("x") == 1)
}

test "d85 №113: exported fn с явным Fail[E] — Result `!!` легален" {
    with Fail[ParseErr] = |_| interrupt (-1) {
        assert(ok_result_with_fail("x") == 1)
    }
}

test "d85 №113: exported fn с явным Fail[RuntimeNoneError] — Option `!!` легален" {
    with Fail[RuntimeNoneError] = |_| interrupt (-1) {
        assert(ok_option_with_fail([1, 2]) == 1)
    }
}

test "d85 №113: `?? panic` fallback — Fail не требуется" {
    // Только happy-path: `panic(...)` при Err аварийно завершил бы процесс
    // (не возвращает значение) — здесь важно лишь что компилируется/линкуется
    // БЕЗ Fail в сигнатуре ok_panic_fallback.
    assert(ok_panic_fallback("x") == 1)
}

test "d85 №113: `!!` внутри `with Fail = ...` — throw пойман локально" {
    assert(ok_local_with_fail("x") == 1)
    assert(ok_local_with_fail("") == -1)
}

// ─────────────────────────────────────────────────────────────────────────
// №428 (D62 §Правило 2 амендмент): transitive-property regression guard —
// see `d85_bang_requires_fail_transitive_neg.nv` for the NEGATIVE
// companion (the exact shape these legitimate forms are adjacent to).

fn chain3(s str) -> int {
    ro v = parse(s)!!
    v
}
fn chain2(s str) -> int => chain3(s)
fn chain1(s str) -> int => chain2(s)

// (6) exported fn, three-hop private chain, Fail declared ONCE at the
// boundary — none of `chain1`/`chain2`/`chain3` (private) needs it.
export fn ok_transitive_chain_declared(s str) Fail[ParseErr] -> int {
    chain1(s)
}

type ChainHolder { dummy int }

fn ChainHolder.compute(s str) -> int {
    ro v = parse(s)!!
    v
}

// (7) same shape, through a METHOD call (`Type.method`) instead of a free
// fn — `fail_reach`'s `resolved_callees`-based resolution must see through
// this exactly like the free-fn case.
export fn ok_method_chain_declared(s str) Fail[ParseErr] -> int {
    ChainHolder.compute(s)
}

// (8) `!!` inside a closure literal, invoked synchronously in the exported
// fn's own body — the closure carries the ENCLOSING fn's effect
// capability (D28 "эффект-capability" — not its own), so declaring Fail
// on the exported fn covers it, same as a literal `!!` written directly.
export fn ok_closure_bang_declared(s str) Fail[ParseErr] -> int {
    ro f = || parse(s)!!
    f()
}

// (9) three-hop chain wrapped in a SINGLE `with Fail = ...` around the
// outermost call — discharges the whole transitive chain locally, exactly
// like it discharges a direct `!!` (form 5 above); exported fn needs no
// `Fail` in its own signature.
export fn ok_transitive_chain_with_handler(s str) -> int {
    with Fail = effect Fail { fail(_e) -> never { interrupt (-1) } } {
        chain1(s)
    }
}

test "d85 №428: transitive 3-hop private chain, Fail declared once at boundary" {
    with Fail[ParseErr] = |_| interrupt (-1) {
        assert(ok_transitive_chain_declared("x") == 1)
    }
}

test "d85 №428: transitive chain through a METHOD call, Fail declared" {
    with Fail[ParseErr] = |_| interrupt (-1) {
        assert(ok_method_chain_declared("x") == 1)
    }
}

test "d85 №428: `!!` inside a synchronously-invoked closure, Fail declared" {
    with Fail[ParseErr] = |_| interrupt (-1) {
        assert(ok_closure_bang_declared("x") == 1)
    }
}

test "d85 №428: transitive chain wrapped in ONE outer `with Fail = ...`" {
    assert(ok_transitive_chain_with_handler("x") == 1)
    assert(ok_transitive_chain_with_handler("") == -1)
}
