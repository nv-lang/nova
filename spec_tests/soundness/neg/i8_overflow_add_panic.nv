// Plan 206 Ф.1b (D422, решение A): переполнение `i8` при сложении → panic
// (было — сырой C `+`, signed-UB). Sized-типы теперь трапят на overflow
// консистентно с безграничным `int` (Plan 33.8).
// EXPECT_RUNTIME_PANIC integer overflow

// SOUNDNESS_REGRESSION — Plan 206 Ф.1b: закрывает sized-int signed-UB дыру.
module neg.i8_overflow_add_panic

fn add_one(x i8) -> i8 => x + 1

test "i8 + overflow panics" {
    ro _ = add_one(i8.MAX)
}
