// EXPECT_RUNTIME_PANIC integer overflow
// REQUIRES_SMT_BACKEND z3
// Plan 140.4 OE3 NEG (soundness boundary), retargeted Plan 194 A2.1: build-
// level `--contracts=off` retired — `checked`/`optimized`/`verified` all
// enforce contracts, no global bypass remains under any flag value (see
// `ContractsMode` doc in compiler-codegen/src/ast/mod.rs). Per-fn
// `#unchecked(requires)` is the closest surviving mechanism that leaves
// fn-`requires` NOT enforced. `a+b` доказуемо in-range ТОЛЬКО через
// `requires`. С `#unchecked(requires)` requires НЕ enforced ⇒ contract-based
// элизия снимается ⇒ `nova_int_checked_add` ОСТАЁТСЯ. Вызов с int.MAX
// (нарушает requires, но он не проверяется под `#unchecked(requires)`) ⇒
// overflow-чек срабатывает ⇒ паника. Доказывает, что contract-based сайты
// НЕ элидируются при снятых (для этой fn) контрактах (always-safe —
// элидировались бы; этот сайт contract-based).
// SOUNDNESS_REGRESSION
module neg.ovf_contracts_off_panic_neg

#unchecked(requires)
fn bounded_add(a int, b int) -> int
    requires 0 <= a && a <= 1000
    requires 0 <= b && b <= 1000
=> a + b

test "contract-based overflow check kept under #unchecked(requires)" {
    ro _ = bounded_add(int.MAX, 1)
}
