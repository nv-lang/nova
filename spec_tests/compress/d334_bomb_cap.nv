// D334 — bomb-cap (decompression-DoS инвариант): каждый decode-путь несёт
// `max_output`; превышение выхода → Bomb(limit) инкрементально (НЕ OOM/hang).
// Граница: output == max_output → ok; первый байт сверх → Bomb.
// Spec: spec/decisions/05-stdlib.md (D334). §8.0-critical.

module spec_tests.compress

import std.encoding.compress.{inflate, ErrorKind}

fn d334_hex(s str) -> []u8 {
    ro chars = s.to_bytes()
    mut out = []u8.with_capacity(chars.len() / 2)
    mut i = 0
    while i + 1 < chars.len() {
        ro hi = d334_hv(chars[i])
        ro lo = d334_hv(chars[i + 1])
        out.push(((hi << 4) | lo) as u8)
        i = i + 2
    }
    out
}

fn d334_hv(c u8) -> int {
    ro n = c as int
    if n >= 48 && n <= 57 { n - 48 }
    else if n >= 97 && n <= 102 { n - 97 + 10 }
    else { 0 }
}

test "D334: inflation beyond max_output → Bomb (not OOM/hang)" {
    // 8-байтный DEFLATE раздувается в 300 байт 'a'; cap 100 < 300.
    ro comp = d334_hex("4b4c1c0589440200")
    ro r = inflate(comp, 100)
    assert(match r {
        Err(e) => match e.kind { ErrorKind.Bomb(_) => true, _ => false }
        Ok(_) => false
    })
}

test "D334: cap boundary — output == max_output is OK" {
    ro comp = d334_hex("4b4c1c0589440200")
    assert(inflate(comp, 300)!!.len() == 300)   // ровно cap
}

test "D334: cap+1 boundary — first byte over the cap → Bomb" {
    ro comp = d334_hex("4b4c1c0589440200")
    ro r = inflate(comp, 299)                    // на 1 меньше выхода
    assert(match r {
        Err(e) => match e.kind { ErrorKind.Bomb(_) => true, _ => false }
        Ok(_) => false
    })
}

test "D334: max_output == 0 is the unlimited escape-hatch" {
    ro comp = d334_hex("4b4c1c0589440200")
    assert(inflate(comp, 0)!!.len() == 300)
}
