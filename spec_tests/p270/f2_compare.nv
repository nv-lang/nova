module p270.f2_compare
import std.io
type Colour enum Red | Green | Blue(int)
fn Colour @compare(other Colour) -> int => 424242
fn main() Io -> () {
    ro c = Colour.Blue(7)
    ro d = Colour.Blue(9)
    ro r = c.compare(d)
    if r == 424242 {
        print("OVERRIDE")
    } else {
        print("BUILTIN-OR-OTHER")
    }
}
