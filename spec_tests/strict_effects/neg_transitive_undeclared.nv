// Plan 197 (--strict-effects fixture, NEGATIVE — the (b) repro from the
// Plan 197 brief).
// Diagnostic: E_UNDECLARED_TRANSITIVE_EFFECT.
// Must compile CLEAN without --strict-effects (byte-identical-behavior
// guarantee — this is the pre-existing, unsound gap). Must FAIL with
// --strict-effects: `caller_bad` calls `tick` (which carries `Counter`)
// without declaring `Counter` itself and without an enclosing lexical
// `with Counter = ...` handler.

module strict_effects.neg_transitive_undeclared

type Counter effect {
    next() -> int
}

fn tick() Counter -> int =>
    Counter.next()

fn caller_bad() -> int =>
    tick()

fn main() {
    with Counter = effect Counter {
        next() -> int => 1
    } {
        ro a = caller_bad()
        println(a)
    }
}
