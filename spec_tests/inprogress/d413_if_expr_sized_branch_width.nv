// D413 — an `if`-EXPRESSION used as a VALUE must preserve the unsigned/sized width of its
// branches; it must NOT silently collapse to signed `nova_int`. Surface: `ro got = if c { … }
// else { … }` (UNANNOTATED binding). The result binding inherits the if-expr's INFERRED type.
//
// DISCRIMINATING form: a branch holds `0x8000000000000000` (2^63 — high bit set). As an
// UNSIGNED `uint` this is a large POSITIVE value (> 100); reinterpreted as signed `nova_int`
// (i64) the same bit pattern is `i64::MIN` (NEGATIVE). So `assert(got > 100)` SEPARATES the
// two: it holds iff the if-result kept unsigned width, and is FALSE under a signed collapse.
//
// Codegen path (compiler-codegen/src/codegen/emit_c.rs::emit_if_expr): the if-result type
// `if_ty` is derived from the branch trailing types (`branch_trailing_c_type_with_locals` →
// `infer_expr_c_type`) and/or the checker's If-expr atom (`resolved_types[if_id]`). A BARE
// integer literal in an unannotated context infers `int` (types/mod.rs:9765 →
// `infer_expr_c_type_legacy` :36794 `IntLit => nova_int`); both branches are `int` ⇒ the
// common primitive is `int` ⇒ `if_ty = nova_int`. No sized/unsigned target flows into the
// branches (the binding is unannotated), so the 2^63 high-bit literal is stored as the
// wrapping `i64::MIN` (lexer Plan 172.1-K4, bits preserved) and emitted `((nova_int)…LL)`.
// The if-result is therefore SIGNED → reads negative. This is the int-collapse on the
// if-expression-as-value surface. Spec: spec/decisions/02-types.md (named-priority, uint≠int).
// Single `spec_tests.conformance` folder-module; all top-level names d413w_-prefixed to avoid
// duplicate-top-level-name collisions with sibling files in the CU.
module inprogress.d413_if_expr_sized_branch_width

// Plain bool source so the `if`-condition is a genuine runtime branch (not const-folded away).
fn d413w_pick(b bool) -> bool => b

test "if-expr value keeps unsigned high-bit; no signed collapse (D413)" {
    ro c = d413w_pick(true)
    ro got = if c { 0x8000000000000000 } else { 0 }   // UNANNOTATED: inherits if-expr inferred type
    assert(got > 100)        // uint: 2^63 > 100 ✓ ; signed collapse → i64::MIN → negative → FAIL
}

test "if-expr value: high-bit taken via the ELSE branch too (D413)" {
    ro c = d413w_pick(false)
    ro got = if c { 0 } else { 0x8000000000000000 }   // high-bit literal in the else arm
    assert(got > 100)        // same discriminator from the opposite branch
    assert(!(got < 0))       // unsigned: not negative ; signed collapse → < 0 holds → FAIL
}

test "if-expr value: two high-bit results compare EQUAL unsigned (D413)" {
    ro a = if d413w_pick(true)  { 0x8000000000000000 } else { 1 }
    ro b = if d413w_pick(false) { 1 } else { 0x8000000000000000 }
    assert(a == b)           // both are 2^63 — equal regardless of signedness (sanity)
    assert(a > 100)          // discriminator: positive only if unsigned width preserved
    assert(b > 100)
}

test "if-expr value: signed-int branches still round-trip (control) (D413)" {
    ro c = d413w_pick(true)
    ro got = if c { -5 } else { 7 }   // genuinely signed int — control case, must stay signed
    assert(got == -5)
    assert(got < 0)
}

