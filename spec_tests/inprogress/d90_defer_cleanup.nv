// D90 — `defer` и `errdefer` — scope-level cleanup statement.
// `defer body` выполняется при любом exit из scope (в LIFO-порядке).
// Тестируем через мутацию shared record (heap-allocated — изменения видны caller).
//
// Spec: spec/decisions/03-syntax.md D90. Единица: folder-module `spec_tests.conformance`.
module inprogress.d90_defer_cleanup

type D90Cnt { val int }
fn D90Cnt.zero() -> D90Cnt => { val: 0 }

fn d90_run_defer(c mut D90Cnt) {
    defer { c.val = c.val + 1 }
    c.val = 10
}

fn d90_lifo(c mut D90Cnt) {
    defer { c.val = c.val * 10 }   // 3rd: 2 * 10 = 20
    defer { c.val = c.val + 1 }    // 2nd: 1 + 1 = 2
    defer { c.val = 1 }             // 1st: sets c.val = 1
}

fn d90_early_return(c mut D90Cnt, flag bool) {
    defer { c.val = c.val + 100 }
    c.val = 5
    if flag {
        return
    }
    c.val = 99
}

test "defer: body runs after fn body, mutates shared record (D90)" {
    mut c = D90Cnt.zero()
    d90_run_defer(c)
    assert(c.val == 11)
}

test "defer: LIFO order — last registered first run (D90)" {
    mut c = D90Cnt.zero()
    d90_lifo(c)
    assert(c.val == 20)
}

test "defer: runs on early return path too (D90)" {
    mut c = D90Cnt.zero()
    d90_early_return(c, true)
    assert(c.val == 105)
}

test "defer: runs on normal return path (D90)" {
    mut c = D90Cnt.zero()
    d90_early_return(c, false)
    assert(c.val == 199)
}
