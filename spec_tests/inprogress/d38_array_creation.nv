// D38 — создание массивов: (1) литерал + annotation, (2) inference из контекста,
// (3) static-методы на типе массива `[]T` (`[]T.new()` / `[]T.with_capacity(n)`).
// Spec: spec/decisions/03-syntax.md (D38). `[]T` — встроенный синтаксис; после канонизации
// Plan 172.1 (`[]T`≡`Vec[T]`, D239) static-методы на `[]T` резолвятся как на `Vec[T]`.
// Behavioral: длины/элементы различают корректное создание. Один folder-module CU.
module spec_tests.conformance

// inference: пустой `[]` выводится из параметра `[]int`.
fn d38_len(xs []int) -> int => xs.len()

test "литерал + annotation — [] и [1,2,3] (D38)" {
    ro xs []int = [1, 2, 3]
    assert(xs.len() == 3)
    assert(xs[2] == 3)
    mut e []int = []                  // пустой литерал + annotation
    assert(e.len() == 0)
    e.push(9)
    assert(e[0] == 9)                 // растёт как Vec
}

test "inference пустого [] из контекста параметра (D38)" {
    assert(d38_len([]) == 0)          // [] выводится из `[]int`-параметра
    assert(d38_len([10, 20]) == 2)
}

test "static-методы на типе массива []T (D38, канонизация → Vec[T])" {
    ro n = []int.new()                // []int.new() ≡ Vec[int].new()
    assert(n.len() == 0)
    mut cap = []int.with_capacity(8)  // pre-allocation
    assert(cap.len() == 0)
    cap.push(1)
    cap.push(2)
    assert(cap.len() == 2)
    assert(cap[1] == 2)
    ro strs []str = []
    assert(strs.len() == 0)
}
