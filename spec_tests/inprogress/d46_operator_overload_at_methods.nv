// D46 — Перегрузка операторов через `@`-методы с фиксированными именами.
// `a + b` вызывает `a.@plus(b)`, `a - b` → `@minus`, `a * b` → `@times`.
// Dispatch по первому операнду; оба операнда должны быть Nova_T*.
//
// Discriminator: без operator dispatch через @-методы операторы на record-типах
// не работают (struct не арифметичен в C). Тесты проверяют результат совпадает
// с арифметикой на полях.
//
// Spec: spec/decisions/03-syntax.md D46. Единица: folder-module `spec_tests.conformance`.
module inprogress.d46_operator_overload_at_methods

type D46Vec2 {
    x f64
    y f64
}

fn D46Vec2.mk(x f64, y f64) -> D46Vec2 => { x, y }

fn D46Vec2 @plus(other D46Vec2) -> D46Vec2 =>
    { x: @x + other.x, y: @y + other.y }

fn D46Vec2 @minus(other D46Vec2) -> D46Vec2 =>
    { x: @x - other.x, y: @y - other.y }

fn D46Vec2 @times(other D46Vec2) -> D46Vec2 =>
    { x: @x * other.x, y: @y * other.y }

test "operator + dispatches to @plus (D46)" {
    ro a = D46Vec2.mk(1.0, 2.0)
    ro b = D46Vec2.mk(3.0, 4.0)
    ro c = a + b
    assert(c.x == 4.0)
    assert(c.y == 6.0)
}

test "operator - dispatches to @minus (D46)" {
    ro a = D46Vec2.mk(5.0, 3.0)
    ro b = D46Vec2.mk(2.0, 1.0)
    ro c = a - b
    assert(c.x == 3.0)
    assert(c.y == 2.0)
}

test "operator * dispatches to @times component-wise (D46)" {
    ro a = D46Vec2.mk(2.0, 3.0)
    ro b = D46Vec2.mk(4.0, 5.0)
    ro c = a * b
    assert(c.x == 8.0)
    assert(c.y == 15.0)
}

test "chained operator overloads: (a + b) - c (D46)" {
    ro a = D46Vec2.mk(1.0, 2.0)
    ro b = D46Vec2.mk(3.0, 4.0)
    ro c = D46Vec2.mk(1.0, 1.0)
    ro d = (a + b) - c
    assert(d.x == 3.0)
    assert(d.y == 5.0)
}
