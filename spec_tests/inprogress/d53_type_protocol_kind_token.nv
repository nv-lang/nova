// D53 — `protocol` как kind-токен в системе D52: `type X protocol { ... }` вместо отдельного keyword.
// Structural typing: тип автоматически satisfies protocol если @-методы совпадают.
// Spec: spec/decisions/02-types.md D53. Part of the SINGLE `spec_tests.conformance` folder-module.
module inprogress.d53_type_protocol_kind_token

// Named protocol declared via `type X protocol { ... }` (D53 kind-token syntax)
type D53Sized protocol {
    @size() -> int
}

// User types — satisfy D53Sized structurally (no declared relationship)
type D53Box { items []int }
fn D53Box @size() -> int => @items.len()

type D53Bag { count int }
fn D53Bag @size() -> int => @count

// Generic function with protocol bound
fn d53_is_empty[T D53Sized](x T) -> bool => x.size() == 0

fn d53_describe[T D53Sized](x T) -> str =>
    if x.size() == 0 { "empty" } else { "non-empty" }

test "type X protocol kind-token: method dispatch on D53Box (D53)" {
    mut b = D53Box { items: [1, 2, 3] }
    assert(b.size() == 3)
}

test "type X protocol kind-token: method dispatch on D53Bag (D53)" {
    mut g = D53Bag { count: 0 }
    assert(g.size() == 0)
}

test "structural protocol dispatch: D53Box satisfies D53Sized (D53)" {
    ro b = D53Box { items: [] }
    assert(d53_is_empty(b))
    ro b2 = D53Box { items: [42] }
    assert(!d53_is_empty(b2))
}

test "structural protocol dispatch: D53Bag satisfies D53Sized (D53)" {
    ro g = D53Bag { count: 5 }
    assert(!d53_is_empty(g))
    assert(d53_describe(g) == "non-empty")
}

// Second protocol with more methods
type D53Named protocol {
    @name() -> str
    @tag() -> int
}

type D53Widget { label str, id int }
fn D53Widget @name() -> str => @label
fn D53Widget @tag() -> int => @id

fn d53_name_len[T D53Named](x T) -> int => x.name().byte_len() + x.tag()

test "multi-method protocol declared with type-kind-token (D53)" {
    ro w = D53Widget { label: "btn", id: 7 }
    assert(w.name() == "btn")
    assert(w.tag() == 7)
    assert(d53_name_len(w) == 10)
}
