// D183 — Canonical comparison protocols: Equal.equals / Compare.compare.
// `==` на int/str dispatches через builtin; user type implements @equal+@eq (D184 transitional).
// Spec: spec/decisions/02-types.md D183. Part of the SINGLE `spec_tests.conformance` folder-module.
module inprogress.d183_canonical_comparison_protocols

// int comparison via == / != / < / > (builtin Compare semantics)
test "int canonical comparison operators (D183)" {
    assert(1 == 1)
    assert(!(1 == 2))
    assert(1 != 2)
    assert(1 < 2)
    assert(2 > 1)
    assert(1 <= 1)
    assert(2 >= 2)
}

// str Equal — dispatches to @eq
test "str equality via == (D183)" {
    assert("hello" == "hello")
    assert(!("hello" == "world"))
    assert("" == "")
}

// bool Equal
test "bool equality via == (D183)" {
    assert(true == true)
    assert(false == false)
    assert(!(true == false))
}

// Ordering comparison: int sign convention (compare -> int < 0 / 0 / > 0)
fn d183_sign(a int, b int) -> int =>
    if a < b { -1 } else if a > b { 1 } else { 0 }

test "Compare.compare int sign convention (D183)" {
    assert(d183_sign(1, 2) < 0)
    assert(d183_sign(2, 1) > 0)
    assert(d183_sign(3, 3) == 0)
}

// str compare (str implements Compare via str.compare(other str) -> int)
test "str.compare() returns negative/zero/positive (D183)" {
    assert("abc".compare("abd") < 0)
    assert("abd".compare("abc") > 0)
    assert("abc".compare("abc") == 0)
}
