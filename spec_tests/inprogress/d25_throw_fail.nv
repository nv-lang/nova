// D25 вЂ” `throw` Рё РїР°СЂР°РјРµС‚СЂРёР·Р°С†РёСЏ `Fail[E]`. РќРѕСЂРјР° (spec/decisions/04-effects.md В§D25):
// `throw expr` вЂ” РѕРїРµСЂР°С†РёСЏ СЌС„С„РµРєС‚Р° `Fail`, РЅРµ РјР°РіРёСЏ: В«С‚Р° Р¶Рµ РїСЂРѕРІРµСЂРєР°, С‡С‚Рѕ РґР»СЏ Db.queryВ».
// РџРµСЂРµС…РІР°С‚ вЂ” РўРћР›Р¬РљРћ С‡РµСЂРµР· handler `with Fail = effect Fail { fail(msg) { ... interrupt v } }`
// (try/catch РѕС‚РІРµСЂРіРЅСѓС‚). Р—РґРµСЃСЊ POS-РЅР°Р±Р»СЋРґР°РµРјРѕРµ СЏРґСЂРѕ D25: throw РЅР° error-path Р»РѕРІРёС‚СЃСЏ
// handler'РѕРј (msg РґРѕСЃС‚СѓРїРµРЅ), Р° ok-path handler РќР• С‚СЂРёРіРіРµСЂРёС‚. РЁР°Р±Р»РѕРЅ СЃРІРµСЂРµРЅ СЃ
// nova_tests/effects/fail_handler.nv.
// РћРґРёРЅ folder-module `spec_tests.conformance`; РёРјРµРЅР° D25-prefixed.
module inprogress.d25_throw_fail

fn d25_parse(s str) -> int {
    if s == "ok" { return 42 }
    throw "parse failed"
}

test "throw Р»РѕРІРёС‚СЃСЏ with-Fail handler, msg РґРѕСЃС‚СѓРїРµРЅ (D25)" {
    mut caught = ""
    mut handler_ran = false
    with Fail = effect Fail {
        fail(msg) {
            caught = msg
            handler_ran = true
            interrupt ()
        }
    } {
        ro _ = d25_parse("bad")
    }
    assert(handler_ran)
    assert(caught == "parse failed")
}

test "ok-path РќР• С‚СЂРёРіРіРµСЂРёС‚ Fail handler, Р·РЅР°С‡РµРЅРёРµ РїСЂРѕС…РѕРґРёС‚ (D25)" {
    mut handler_ran = false
    mut got = 0
    with Fail = effect Fail {
        fail(_msg) {
            handler_ran = true
            interrupt ()
        }
    } {
        got = d25_parse("ok")
    }
    assert(!handler_ran)
    assert(got == 42)
}

