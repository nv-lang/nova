// Plan 172.4 acceptance (владелец 2026-06-21): value-record fluent mut @ -> @ + структурное ==
module inprogress.p172_4_acceptance

type P1724Point value { x int, y int }
fn P1724Point mut @inc(a int) -> @ { @x += a; @y += a; @ }

test "172.4 acceptance: fluent mut @ -> @ на value-record + структурное ==" {
    mut p P1724Point = { x: 0, y: 0 }
    ro p2 = p.inc(10).inc(20)
    assert(p == p2 && p.x == 30)
}
