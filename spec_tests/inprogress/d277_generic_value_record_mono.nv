// D277 — By-value мономорфизация generic value-records: `type X[T] value { ... }` lowered
// BY VALUE per mono-instance (NovaValue_<short>), no nova_alloc for wrapper record.
// Spec: spec/decisions/02-types.md D277. Part of the SINGLE `spec_tests.conformance` folder-module.
module inprogress.d277_generic_value_record_mono

// Generic value-record
type D277Pair[T] value { first T, second T }

fn d277_swap[T](p D277Pair[T]) -> D277Pair[T] =>
    { first: p.second, second: p.first }

fn d277_first[T](p D277Pair[T]) -> T => p.first
fn d277_second[T](p D277Pair[T]) -> T => p.second

test "generic value-record D277Pair[int] by-value mono (D277)" {
    ro p D277Pair[int] = { first: 1, second: 2 }
    assert(p.first == 1)
    assert(p.second == 2)
}

test "generic value-record swap returns new value (D277)" {
    ro p D277Pair[int] = { first: 10, second: 20 }
    ro s = d277_swap(p)
    assert(s.first == 20)
    assert(s.second == 10)
}

test "generic value-record accessor functions (D277)" {
    ro p D277Pair[str] = { first: "hello", second: "world" }
    assert(d277_first(p) == "hello")
    assert(d277_second(p) == "world")
}

test "generic value-record D277Pair[bool] (D277)" {
    ro p D277Pair[bool] = { first: true, second: false }
    assert(p.first)
    assert(!p.second)
}
