// D85 — `?` оператор = RETURN-стиль (Plan 174.2: return-only) для ОБОИХ Result и Option:
//   Result: Ok(v) → v ; Err(e) → return Err(e) из enclosing fn.
//   Option: Some(v) → v ; None → return None из enclosing fn.
// `?` больше НЕ задействует Fail (унификация). Behavioral: на Err/None ранний return виден
// снаружи как Err/None; на Ok/Some — продолжение с разворотом. Извлечение в asserts — через
// `??` (D86). Spec: spec/decisions/04-effects.md (D85). Один folder-module CU.
module inprogress.d85_question_return

fn d85_ok() -> Result[int, str] => Ok(10)
fn d85_err() -> Result[int, str] => Err("boom")

// `?` на Result: Ok разворачивается; Err → ранний `return Err(e)` из ЭТОЙ fn.
fn d85_use_q(fail bool) -> Result[int, str] {
    ro base = d85_ok()?              // Ok(10) → 10
    if fail {
        ro x = d85_err()?            // Err → немедленно return Err("boom")
        Ok(x)                        // недостижимо при fail
    } else {
        Ok(base + 5)
    }
}

fn d85_some() -> Option[int] => Some(7)
fn d85_none() -> Option[int] => None

// `?` на Option: Some разворачивается; None → ранний `return None`.
fn d85_opt_q(use_none bool) -> Option[int] {
    ro a = d85_some()?               // Some(7) → 7
    if use_none {
        ro b = d85_none()?           // None → return None
        Some(b)
    } else {
        Some(a + 1)
    }
}

test "? на Result — Ok разворачивается, Err → ранний return Err (D85)" {
    assert((d85_use_q(false) ?? -1) == 15)   // Ok(15) → 15
    assert((d85_use_q(true) ?? -1) == -1)    // `?` на Err → return Err → `??` → -1
}

test "? на Option — Some разворачивается, None → ранний return None (D85)" {
    assert((d85_opt_q(false) ?? -1) == 8)    // Some(8) → 8
    assert((d85_opt_q(true) ?? -1) == -1)    // `?` на None → return None → `??` → -1
}
