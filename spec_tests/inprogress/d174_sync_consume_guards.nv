// GAP [M-172.1-d174-sync-consume-registry]: КРАСНЫЙ до U.1.3b (sync Gap B) — LinearityRegistry
// не знает consume-методы MutexGuard/Permit/... (external sync-типы приходят через
// load_builtins, реестр строится из module.items). Pre-existing: nova_tests/plan103_9
// guard_cross_scope_transfer красный на baseline 69d64b7a (проверено 2026-07-02).
// D174 — Sync primitives consume integration (Plan 103.9, final): V2 guard-returning API.
// Норма (spec/decisions/06-concurrency.md §D174): `lock()/read()/write()/acquire()`
// возвращают linear guard (`MutexGuard/ReadGuard/WriteGuard/Permit consume`,
// must-be-consumed D133) — забытый unlock/double-unlock ловятся СТАТИЧЕСКИ;
// `Once.try_start() -> Option[OnceGuard]` — commit()/abort() потребляют guard;
// `with_lock(fn)` — thin-wrapper (backward compat). Негативы (guard-leak /
// double-unlock) — neg/d174_*.nv (класс D133/D131 на guard-типах). Шаблоны сверены
// с nova_tests/plan103_9. Один folder-module `spec_tests.conformance`.
module inprogress.d174_sync_consume_guards

test "MutexGuard: lock→guard, unlock потребляет; mutex свободен (D174)" {
    mut mu = Mutex.new()
    consume g = mu.lock()
    g.unlock()
    ro acquired = mu.try_lock()
    assert(acquired == true)
    mu.unlock()
}

test "MutexGuard: defer g.unlock() закрывает обязательство (D174)" {
    mut mu = Mutex.new()
    {
        consume g = mu.lock()
        defer g.unlock()
    }
    ro acquired = mu.try_lock()
    assert(acquired == true)
    mu.unlock()
}

test "Permit: acquire→release, счётчик семафора восстановлен (D174)" {
    mut sem = Semaphore.new(2)
    consume p = sem.acquire()
    assert(sem.available_permits() == 1)
    p.release()
    assert(sem.available_permits() == 2)
}

test "ReadGuard/WriteGuard: раздельные guard-типы RwLock (D174)" {
    mut rw = RwLock.new()
    consume rg = rw.read()
    rg.unlock()
    consume wg = rw.write()
    wg.unlock()
    ro can_read = rw.try_read()
    assert(can_read == true)
    rw.read_unlock()
}

test "OnceGuard: try_start Some у победителя, commit → DONE (D174)" {
    mut once = Once.new()
    match once.try_start() {
        Some(g) => g.commit()
        None    => assert(false)
    }
    // повторный try_start после DONE — None
    match once.try_start() {
        Some(g) => {
            g.abort()
            assert(false)
        }
        None => assert(true)
    }
}

test "with_lock — thin wrapper, backward compat (D174)" {
    mut mu = Mutex.new()
    ro r = mu.with_lock(|| 41 + 1)
    assert(r == 42)
    ro acquired = mu.try_lock()
    assert(acquired == true)
    mu.unlock()
}
