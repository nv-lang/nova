// D238 — `Index[K, V]` protocol: `a[key]` десугарится в `a.@index(key)`.
// Builtin для []T: int-index → T, Range-index → []T slice.
// User-типы могут реализовать через `fn Type @index(key K) -> V`.
//
// Spec: spec/decisions/03-syntax.md D238. Единица: folder-module `spec_tests.conformance`.
module inprogress.d238_index_protocol

type D238Pair { x int, y int }
fn D238Pair @index(key int) -> int =>
    if key == 0 { @x } else { @y }

test "builtin slice index: xs[i] (D238)" {
    ro xs = [10, 20, 30, 40, 50]
    assert(xs[0] == 10)
    assert(xs[4] == 50)
    assert(xs[2] == 30)
}

test "slice Range index xs[1..3] returns sub-slice (D238)" {
    ro xs = [10, 20, 30, 40, 50]
    ro sub = xs[1..3]
    assert(sub.len() == 2)
    assert(sub[0] == 20)
    assert(sub[1] == 30)
}

test "slice Range index xs[0..n] (D238)" {
    ro xs = [1, 2, 3, 4, 5]
    ro first3 = xs[0..3]
    assert(first3.len() == 3)
    assert(first3[0] == 1)
    assert(first3[2] == 3)
}

test "str Range index s[0..3] returns prefix (D238)" {
    ro s = "hello"
    ro prefix = s[0..3]
    assert(prefix == "hel")
}

test "user type @index: key 0 → x (D238)" {
    ro p = D238Pair { x: 7, y: 13 }
    assert(p[0] == 7)
    assert(p[1] == 13)
}
