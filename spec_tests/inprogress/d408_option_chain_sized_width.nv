// D408 — sized/unsigned width preservation through Option ADAPTER CHAINS (`.map`/`.or`/
// `.unwrap_or`). `Some(uint)` lowers to `NovaOpt_nova_uint` (sanitize_for_novaopt(nova_uint),
// emit_c.rs:38181), and the per-T DeclaredBody trampolines (`Nova_Option_method_<m>_<elem_ty>`)
// are keyed on `elem_ty` derived from the RECEIVER's inferred `obj_ty`. The discriminating defect:
// codegen's `resolved_types` annotation channel (types/mod.rs:6366-6434, the U.4.5 authoritative
// override) is populated ONLY for Ident/SelfAccess/Index/Member/Block/If/Match/Path/RecordLit —
// a *MethodCall* (`.map(..)`) gets NO annotation. So the OUTER adapter's receiver type is taken
// from the LEGACY degraded path `infer_method_level_return_for_sum` (emit_c.rs:34917-34942), which
// re-infers the closure body `|x| x` WITHOUT binding `x` in var_types → unbound Ident `x` falls to
// `nova_int` (emit_c.rs:37082) → method-level `U` binds `nova_int` → `.map` infers `NovaOpt_nova_int`.
// The inner `.map` is EMITTED correctly as `Nova_Option_method_map_nova_uint(..)` (the &mut
// `resolve_method_level_subst` DOES bind var_types, emit_c.rs:14628-14649), so the value carries the
// real `NovaOpt_nova_uint`; but the OUTER `.unwrap_or` is emitted against the collapsed `elem_ty =
// nova_int` → trampoline `Nova_Option_method_unwrap_or_nova_int` expects a `NovaOpt_nova_int`
// struct yet is handed a `NovaOpt_nova_uint` (distinct C struct) → C-incompatible-type (CC-FAIL);
// were the structs layout-pun-compatible the signed `-> nova_int` return reads the 2^63 high-bit
// NEGATIVE → `got > 100` false (RUN-FAIL). Either way the chain DIVERGES from the no-adapter control.
// DISCRIMINATING: result bindings are UNANNOTATED (`ro got = <chain>`) so they inherit the call's
// inferred (possibly collapsed) type; each assert separates collapse from correctness.
// Spec: spec/decisions/02-types.md (D126 named-priority: uint≠int, u8≠i8≠int). Single
// `spec_tests.conformance` folder-module; all top-level names D408w-prefixed to avoid CU clashes.
module inprogress.d408_option_chain_sized_width

// CONTROL — no adapter: `Some(uint).unwrap_or(_)`. The receiver is the literal `Some(..)` call,
// whose `obj_ty` infers `NovaOpt_nova_uint` directly (emit_c.rs:38178-38183), so `.unwrap_or`
// emits `Nova_Option_method_unwrap_or_nova_uint` and the unsigned 2^63 round-trips. Expected PASS;
// it pins that the collapse below is the ADAPTER-CHAIN regression, not a base unwrap_or defect.
test "control: Some(uint).unwrap_or keeps unsigned 2^63 (no adapter) (D408)" {
    ro big uint = 0x8000000000000000        // 2^63 — high bit; as signed int64 this is NEGATIVE
    ro got = Some(big).unwrap_or(0)          // UNANNOTATED: inherits call's inferred type
    assert(got > 100)                        // unsigned: 2^63 > 100 ✓ ; signed collapse → FAIL
}

// KEYSTONE — `.map(|x| x)` identity adapter then `.unwrap_or`. The OUTER `.unwrap_or` receiver is a
// MethodCall (no resolved_types annotation) → degraded inference collapses `U`→`nova_int` →
// `NovaOpt_nova_int` elem_ty → CC-FAIL (NovaOpt_nova_uint vs NovaOpt_nova_int param) or, if puns,
// signed read → 2^63 negative → assert false (RUN-FAIL).
test "map(|x| x) identity adapter must preserve uint width before unwrap_or (D408)" {
    ro big uint = 0x8000000000000000
    ro got = Some(big).map(|x| x).unwrap_or(0)   // UNANNOTATED; adapter chain must keep nova_uint
    assert(got > 100)                            // collapse → negative/typed-mismatch → FAIL
}

// `.or(Some(_))` fallback adapter then `.unwrap_or`. `.or` returns `Option[T]`; its MethodCall
// receiver of the final `.unwrap_or` again misses the annotation channel → same collapse surface,
// independent of a closure (isolates the MethodCall-receiver inference gap from closure inference).
test "or(Some(_)) fallback adapter must preserve uint width before unwrap_or (D408)" {
    ro big uint = 0x8000000000000000
    ro got = Some(big).or(Some(1)).unwrap_or(0)  // Some wins; value must stay unsigned 2^63
    assert(got > 100)                            // collapse → signed negative / mismatch → FAIL
}

// Sized-unsigned u8 through `.map`: 200 fits u8 (nova_byte) but exceeds i8 max (127). A collapse to
// signed widening reads 200 unchanged numerically here, so the DISCRIMINATOR is the precise value
// AND that the chain type-checks at all (NovaOpt_nova_byte vs NovaOpt_nova_int trampoline mismatch
// → CC-FAIL). Distinct width (nova_byte ≠ nova_int) is the named-priority point.
test "map(|x| x) preserves u8 identity through the adapter, not collapsed (D408)" {
    ro b u8 = 200                                // fits u8 (nova_byte), exceeds i8 max 127
    ro got = Some(b).map(|x| x).unwrap_or(0)     // UNANNOTATED; must stay nova_byte through map
    assert(got == 200)
    assert(got > 100)
}
