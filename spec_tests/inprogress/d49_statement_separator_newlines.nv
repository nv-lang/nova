// D49 — Statement separator: newline — основной разделитель; `;` опционален.
// Лексер продолжает statement при висящем бинарном операторе, внутри `(`, `[`, `{`,
// перед `.` (method chain), перед `||`/`&&`.
//
// Discriminator: без этих правил многострочные выражения не парсируются
// (или считаются несколькими отдельными statements). Тесты проверяют что
// результаты одинаковы для однострочной и многострочной форм.
//
// Spec: spec/decisions/03-syntax.md D49. Единица: folder-module `spec_tests.conformance`.
module inprogress.d49_statement_separator_newlines

test "newline separates statements — no semicolons needed (D49)" {
    ro x = 1
    ro y = 2
    ro z = x + y
    assert(z == 3)
}

test "semicolon allows multiple statements on one line (D49)" {
    ro a = 3; ro b = 4; ro c = a + b
    assert(c == 7)
}

test "continuation: binary op at end of line, rhs on next (D49)" {
    ro total = 10 +
               20 +
               30
    assert(total == 60)
}

test "continuation: method chain — dot at start of next line (D49)" {
    ro s = "hello world"
    ro n = s
        .byte_len()
    assert(n == 11)
}

test "continuation: logical OR at end of line, rhs on next (D49)" {
    ro x = 5
    ro ok = x < 0 ||
        x > 3
    assert(ok == true)
}

test "continuation: logical AND at end of line, rhs on next (D49)" {
    ro x = 5
    ro ok = x > 0 &&
        x < 10
    assert(ok == true)
}
