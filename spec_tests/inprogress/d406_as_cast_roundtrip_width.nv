// D406 — `as`-cast ROUNDTRIP сохраняет точную ШИРИНУ и ЗНАК sized-unsigned типов.
// Поверхность: narrow→widen цепочка `(x as uW) as int`. Если промежуточный sized
// unsigned (u8/u16) молча схлопнулся бы в ЗНАКОВЫЙ тип (int8_t/int16_t/nova_int),
// значения с установленным старшим битом ширины (u8: 200 > i8-max 127; u16: 40000 >
// i16-max 32767) при widening читались бы НЕГАТИВОМ (sign-extend), а не положительным
// числом (zero-extend). Распознающий характер: каждый assert ложен при signed-коллапсе.
//
// Codegen-обоснование (compiler-codegen/src/codegen/emit_c.rs):
//   • As-арм (:21786) эмитит `((type_ref_to_c(T))(emit_expr(inner)))` — целевой C-тип
//     берётся из `primitive_name_to_c` (:6386): u8→nova_byte(uint8_t), u16→uint16_t,
//     uint→nova_uint. Ширина+знак НЕ теряются на сайте каста.
//   • Внутренний widening `… as int` = `((nova_int)(<uint8_t/uint16_t expr>))` — zero-
//     extend, т.к. промежуточный тип беззнаковый ⇒ 200/40000 остаются положительными.
//   • `nova_int as uint` (:21850) маршрутизируется в `nova_int_to_uint` (cast.h:173) —
//     SATURATION neg→0 (документированная D54-семантика, НЕ коллапс): test 4 проверяет
//     именно её (отрицательный int → uint = 0), чтобы зафиксировать asymmetry-инвариант.
// `as` биндит ТУЖЕ унарного минуса (см. d54_as_cast_conversions) ⇒ явные скобки.
// Spec: spec/decisions/02-types.md (D54). Один folder-module spec_tests.conformance;
// все имена D406w-префиксные во избежание top-level-коллизий с соседними файлами CU.
module spec_tests.conformance

test "u8-roundtrip: (200 as u8) as int сохраняет zero-extend (200, не -56) (D406)" {
    ro got = (200 as u8) as int   // UNANNOTATED: наследует inferred тип каста (int)
    assert(got == 200)            // unsigned widening: 200 ; signed-i8 collapse → -56
    assert(got > 127)             // > i8-max ⇒ ложь при знаковом коллапсе
}

test "u16-roundtrip: (40000 as u16) as int сохраняет zero-extend (40000, не -25536) (D406)" {
    ro got = (40000 as u16) as int
    assert(got == 40000)          // unsigned widening: 40000 ; signed-i16 collapse → -25536
    assert(got > 32767)           // > i16-max ⇒ ложь при знаковом коллапсе
}

test "u8-truncation-then-widen: (300 as u8) as int = 44, остаётся положит. (D406)" {
    ro got = (300 as u8) as int   // narrow: 300 & 0xFF = 44 (wraparound), затем widen
    assert(got == 44)             // truncate младших битов сохранён через roundtrip
    assert(got >= 0)              // беззнаковый промежуточный ⇒ неотрицателен
}

test "int→uint SATURATION (neg→0), не bit-reinterpret — asymmetry-инвариант (D406)" {
    ro neg = 0 - 5                // отрицательный nova_int (-5)
    ro got = neg as uint          // nova_int_to_uint: neg → 0 (НЕ 0xFFFF...FFFB)
    assert(got == 0)              // saturation ; bit-reinterpret дал бы огромное unsigned
}
