// [M-198-f4c-1-privfile-type-not-discriminated] — re-verified live 2026-07-17
// (Plan 212 pt.7). Two files, same folder-module, each declares its OWN
// `priv(file) type Rect` with a DIFFERENT shape. Checker resolve does NOT
// discriminate priv(file) TYPES by declaring file (D307 covers method/fn
// symbols but not type symbols) — b.nv's `Rect` shape bleeds into a.nv's
// own `area(r Rect)`, which should only ever see ITS OWN `Rect { w, h }`.
//
// Current (2026-07-17) symptom: CODEGEN-FAIL —
//   error: [E7320] no field or method `w` on type `Rect`
//   note: `Rect` has fields: name, tag        <- that's b.nv's Rect!
//
// Quarantined here (fixtures/, walker-skip) — NOT a language-choice
// regression, a real live checker bug. Restore as a real (green) test
// once fixed.
module known_red.privtype_file_discrimination

priv(file) type Rect { w int, h int }

fn area(r Rect) -> int => r.w * r.h

test "a: own Rect(w,h) shape" {
    ro r = Rect { w: 3, h: 4 }
    assert(area(r) == 12)
}
