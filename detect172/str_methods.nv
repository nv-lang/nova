// [DETECT-U.1.3] probe: str-методы (to_int/pad) без import std.runtime.string.
// Plan 174.1: `str.parse_int` retracted → `str.to_int()` (conversion-on-source canon).
// `!!` unwraps the Result (D85) — the receiver-less check was comparing a
// bare `Result` to `42` pre-174.1-touch; fixed alongside the call-site migration.
module detect172

test "str.to_int + pad без import" {
    assert("42".to_int()!! == 42)
    assert("7".pad_start(3, ' ') == "  7")
}
