module p383_method_bound_neg

// №383 Корень А: method-own generic-parameter bound (`@combine[S Clone]`,
// bound declared ON THE METHOD, not on the receiver or a free function).
// NoClone13 lacks `@clone` — must be rejected on check, not silently
// compiled into an identity return (`return other;`).

type Box13 { val int }

type NoClone13 { junk int }

fn Box13 @combine[S Clone](other S) -> S => other.clone()

fn main() Io -> () {
    ro h = Box13 { val: 1 }
    ro v = NoClone13 { junk: 1 }
    ro r = h.combine(v)
    print("${r.junk}")
}
