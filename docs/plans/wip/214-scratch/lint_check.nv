// Plan 214 Ф.3b smoke — W_COERCE_EXPLICIT_REDUNDANT pos/neg.
module wip.d214lintcheck

fn d214_take_bytes(v []u8) -> int => v.len()

// pos: explicit .bytes() in a let with explicit []u8 annotation — redundant.
fn pos_redundant_let() -> int {
    ro s = "hello"
    ro b []u8 = s.bytes()
    return b.len()
}

// pos: explicit .bytes() in return arrow-body matching declared return type.
fn pos_redundant_return() -> []u8 => "abc".bytes()

// neg: untyped binding — bare value wouldn't coerce here (no expected type).
fn neg_untyped_binding() -> int {
    ro s = "hello"
    ro b = s.bytes()
    return b.len()
}

// neg: call-arg position — not flagged (out of scope for the syntactic lint).
fn neg_call_arg() -> int {
    ro s = "hello"
    return d214_take_bytes(s.bytes())
}

// pos: block-body trailing expr (implicit return, no `return` keyword) —
// pervasive std idiom (`fn f() -> str { ...; buf.into_str() }`).
fn pos_redundant_block_trailing() -> []u8 {
    ro s = "hello"
    s.bytes()
}
