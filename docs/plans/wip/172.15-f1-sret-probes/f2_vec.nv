// Ф.1 ось «алиас `[]T` ≡ `Vec[T]`»: спеллинг `Vec[T]`.
// Близнец — f1_alias.nv, тот же метод спеллингом `[]T`. C обязан совпасть.
type Src { n int }
fn Src @view() -> Vec[int] => Vec[int].new(4)
fn use_view() -> int {
    ro s = Src { n: 1 }
    ro v = s.view()
    v.cap()
}
fn main() -> () {
    assert(use_view() == 4)
}
