// bench3_select.nv — план 244, Ф.0. `select` с несколькими ветвями (2, 4, 8),
// РОВНО ОДНА готова — итераций/сек (проверяет пул и случайный обход
// ТЕКУЩЕЙ, сишной реализации select). Каждый раунд: select забирает
// значение из готового канала и тут же кладёт новое туда же — канал,
// который срабатывает, остаётся единственным готовым все раунды.
//
// Build: nova build docs/plans/wip/bench-p244/bench3_select.nv -o bench3
module bench.p244_select

import std.time.duration

fn select_bench_2(rounds int) Time -> f64 {
    ro (tx0, rx0) = Channel[int].new(1)
    ro (tx1, rx1) = Channel[int].new(1)
    ro _ = tx0.send(1)
    ro t0 = Monotonic.now()
    for i int in 0..rounds {
        select {
            Some(v) = rx0 => { ro _ = tx0.send(1) }
            Some(v) = rx1 => { ro _ = tx1.send(1) }
        }
    }
    ro dt = Monotonic.now().elapsed_since(t0)
    (rounds as f64) / dt.seconds_f64()
}

fn select_bench_4(rounds int) Time -> f64 {
    ro (tx0, rx0) = Channel[int].new(1)
    ro (tx1, rx1) = Channel[int].new(1)
    ro (tx2, rx2) = Channel[int].new(1)
    ro (tx3, rx3) = Channel[int].new(1)
    ro _ = tx0.send(1)
    ro t0 = Monotonic.now()
    for i int in 0..rounds {
        select {
            Some(v) = rx0 => { ro _ = tx0.send(1) }
            Some(v) = rx1 => { ro _ = tx1.send(1) }
            Some(v) = rx2 => { ro _ = tx2.send(1) }
            Some(v) = rx3 => { ro _ = tx3.send(1) }
        }
    }
    ro dt = Monotonic.now().elapsed_since(t0)
    (rounds as f64) / dt.seconds_f64()
}

fn select_bench_8(rounds int) Time -> f64 {
    ro (tx0, rx0) = Channel[int].new(1)
    ro (tx1, rx1) = Channel[int].new(1)
    ro (tx2, rx2) = Channel[int].new(1)
    ro (tx3, rx3) = Channel[int].new(1)
    ro (tx4, rx4) = Channel[int].new(1)
    ro (tx5, rx5) = Channel[int].new(1)
    ro (tx6, rx6) = Channel[int].new(1)
    ro (tx7, rx7) = Channel[int].new(1)
    ro _ = tx0.send(1)
    ro t0 = Monotonic.now()
    for i int in 0..rounds {
        select {
            Some(v) = rx0 => { ro _ = tx0.send(1) }
            Some(v) = rx1 => { ro _ = tx1.send(1) }
            Some(v) = rx2 => { ro _ = tx2.send(1) }
            Some(v) = rx3 => { ro _ = tx3.send(1) }
            Some(v) = rx4 => { ro _ = tx4.send(1) }
            Some(v) = rx5 => { ro _ = tx5.send(1) }
            Some(v) = rx6 => { ro _ = tx6.send(1) }
            Some(v) = rx7 => { ro _ = tx7.send(1) }
        }
    }
    ro dt = Monotonic.now().elapsed_since(t0)
    (rounds as f64) / dt.seconds_f64()
}

fn main() Time {
    ro rounds = 100_000
    ro r2 = select_bench_2(rounds)
    println("arms=2 iters/sec=${r2}")
    ro r4 = select_bench_4(rounds)
    println("arms=4 iters/sec=${r4}")
    ro r8 = select_bench_8(rounds)
    println("arms=8 iters/sec=${r8}")
}
