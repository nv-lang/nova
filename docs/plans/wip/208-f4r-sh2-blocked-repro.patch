+// ─── Ш2 (Plan 208 Ф.4R, owner 2026-07-20): primitive Display/Debug bodies ──
+//
+// MOVED from `prelude/protocols.nv` — were CIRCULAR stubs
+// (`fn int @display(mut f Fmt) { f.write("${@}".bytes()) }`) that called
+// BACK into interpolation (allocating a temp StringBuilder + re-parsing a
+// literal format string) to render a value the compiler already had in
+// hand. These bodies render DIRECTLY via the buffer primitives above (no
+// StringBuilder concretely required — `f` is only a `Fmt`, so `@append`/
+// `*_display_spec`'s StringBuilder-specific reserve/spare/advance protocol
+// doesn't apply here; a small scratch `[]u8` + ONE `f.write(...)` call is
+// the zero-recursion replacement).
+//
+// Axes are NOT consulted (`f.width()`/`f.align()`/etc. stay unread) —
+// UNCHANGED from the bodies these replace (see the removed comment in
+// protocols.nv: "Radix/width/alternate axes on `f` are therefore NOT read
+// here... out of THIS phase's scope" — Ф.4R is a carrier swap, not a new
+// feature). `str`'s `@display` was ALREADY non-circular
+// (`f.write(@bytes())`) and stays in protocols.nv untouched; `str`'s
+// `@debug` WAS circular and moves here alongside the others.
+import std.prelude.protocols.{Fmt, Display, Debug}
+
+#impl(Display)
+fn int @display(mut f Fmt) -> () {
+    mut buf []u8 = []u8.new(cap: DISPLAY_INT_CAP)
+    ro n = unsafe { int_fmt_into(@, buf.ptr(), DISPLAY_INT_CAP) }
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
+#impl(Debug)
+fn int @debug(mut f Fmt) -> () { @display(f) }
+
+#impl(Display)
+fn f64 @display(mut f Fmt) -> () {
+    mut buf []u8 = []u8.new(cap: DISPLAY_F64_SHORTEST_CAP)
+    ro n = unsafe { f64_fmt_shortest_into(@, buf.ptr(), DISPLAY_F64_SHORTEST_CAP) }
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
+#impl(Debug)
+fn f64 @debug(mut f Fmt) -> () { @display(f) }
+
+// Plan 180: f32 display/debug — f32-PRECISE shortest-round-trip formatter
+// (`f32_fmt_shortest_into`/`nova_f32_shortest`), NOT widened to f64 first
+// (`0.1f` stays `"0.1"`, not the f64-widened mantissa tail
+// `"0.10000000149011612"`) — matches the bare `${f32val}` interp dispatch.
+#impl(Display)
+fn f32 @display(mut f Fmt) -> () {
+    mut buf []u8 = []u8.new(cap: DISPLAY_F32_CAP)
+    ro n = unsafe { f32_fmt_shortest_into(@, buf.ptr(), DISPLAY_F32_CAP) }
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
+#impl(Debug)
+fn f32 @debug(mut f Fmt) -> () { @display(f) }
+
+#impl(Display)
+fn bool @display(mut f Fmt) -> () {
+    mut buf []u8 = []u8.new(cap: DISPLAY_BOOL_CAP)
+    ro n = bool_fmt(@, buf.ptr(), DISPLAY_BOOL_CAP)
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
+#impl(Debug)
+fn bool @debug(mut f Fmt) -> () { @display(f) }
+
+#impl(Display)
+fn char @display(mut f Fmt) -> () {
+    mut buf []u8 = []u8.new(cap: DISPLAY_CHAR_CAP)
+    ro n = char_fmt(@, buf.ptr(), DISPLAY_CHAR_CAP)
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
+#impl(Debug)
+fn char @debug(mut f Fmt) -> () {
+    mut buf []u8 = []u8.new(cap: DISPLAY_CHAR_DEBUG_CAP)
+    ro n = char_debug_fmt(@, buf.ptr(), DISPLAY_CHAR_DEBUG_CAP)
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
+
+// `str @display` is ALREADY non-circular (`f.write(@bytes())`, prelude/
+// protocols.nv) and stays there untouched — only `@debug` moves here.
+#impl(Debug)
+fn str @debug(mut f Fmt) -> () {
+    ro cap = @byte_len() * 4 + 2
+    mut buf []u8 = []u8.new(cap: cap)
+    ro n = str_debug_fmt(@, buf.ptr(), cap)
+    unsafe { buf.advance(n) }
+    f.write(buf)
+}
