// NOT part of spec_tests/conformance — deliberately kept OUTSIDE the gate. Reference
// repro for Plan 196.5 "producers-widen" (2026-07-13), Class-1 closure-return-bound
// follow-up gap. See docs/plans/196.5-producers-widen-notes.md §closure-lowering-gap
// for the trace evidence (NOVA_NODE_SUBSTS_TRACE) and the generated-C excerpt.
//
// STATUS: the `node_substs` CHANNEL side of this subclass is now FIXED (this wave) —
// Producer A (`types/mod.rs` `f1_check_call`'s free-fn generic-return arm,
// ~10727-10800) now closes a callee generic left unbound after the structural
// arg-unify pass by peeking a closure-literal ARG's inferred body-return type
// (`closure_arg_return_peek`, mirrors the legacy codegen `resolve_mono_type_args`
// Source 2b at the checker/TypeRef level). Trace confirms:
//   [NODE_SUBSTS] producer=A call_id=ExprId(82) callee=d30_ror_from_closure n=1
//   [NODE_SUBSTS] consumer=mono_type_args call_id=ExprId(82) hit n=1
// — T=int/T=str now materializes into `node_substs` AND the call-site's own C mono
// name (`nova_fn_d30_ror_from_closure____nova_int`) is correctly specialized.
//
// REMAINING GAP (separate, NOT a channel-population problem — a closure-LOWERING
// problem, out of this wave's scope per the 196.5 task boundary): the closure
// LITERAL's own emitted C function (`nova_lambda_N_body`) keeps an ERASED
// `Nova_T*` return type regardless of what the call-site's channel resolves to —
// codegen decides a closure literal's OWN C signature independently of (and
// earlier than) the call-site's `node_substs` lookup. Reproduced (isolated
// test-build, clang):
//
//   error: returning 'const nova_str' from a function with incompatible result
//   type 'Nova_T *' (aka 'struct Nova_T *')
//
// for the SECOND call below (`|| "x"`) — the FIRST call's closure body
// (`|| 7`, nova_int) is masked by struct-vs-scalar C coercion rules and does not
// itself error, but the underlying erased-signature defect is the same for both.
//
// This exact defect was independently found and diagnosed in
// docs/plans/196.5-perd-d30-verification.md §3.2 ("CC-FAIL репро (closure-return-
// peek подкласс, d30_ror_from_closure)") BEFORE this wave — marked there as
// "не мой регион для фикса" (closure-lowering, not channel-population). This
// wave's producer-widen closed the channel half of the gap; the remaining half
// (closure literal C-signature erasure) needs a follow-up in emit_c.rs's closure
// codegen (the function that decides `nova_lambda_N_body`'s declared C return
// type) — likely needs to consult `node_substs`/the call-site's resolved return
// too, not just the closure's own (unresolved, generic) declared signature.
module spec_tests.conformance

type D30RorErr { msg str }

// T bound via CLOSURE RETURN TYPE peek (no turbofish, no direct-T param) — B10j
// Source 2 heuristic that populates `subst` before `resolve_result_option_ret`
// lowers the return (legacy codegen path); channel-side now ALSO fires (see
// STATUS above), but the closure literal's own C signature stays erased.
fn d30_ror_from_closure[T](ok bool, f fn() -> T, e str) -> Result[T, D30RorErr] {
    if ok {
        Ok(f())
    } else {
        Err(D30RorErr { msg: e })
    }
}

test "generic free-fn Result[T,E] — T from closure-return peek (D30/D85 ror) [KNOWN GAP, not gated]" {
    ro r = d30_ror_from_closure(true, || 7, "boom")
    match r {
        Ok(v) => assert(v == 7)
        Err(_) => assert(false)
    }
    ro s = d30_ror_from_closure(false, || "x", "boom2")
    match s {
        Ok(_) => assert(false)
        Err(e) => assert(e.msg == "boom2")
    }
}
