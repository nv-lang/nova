// Probe: does the new first-send T-inference (window p286) also catch a
// SECOND send of a mismatched type on the same bare-Channel.new writer,
// in the same block? Expect a compile error once T is inferred from the
// first send (int), same as the turbofish-declared case.
module spec_tests.conformance

test "bare channel: first send infers T, second mismatched send is now a checker error" {
    ro (tx, rx) = Channel.new(2)
    tx.send(10)
    tx.send("oops")
}
