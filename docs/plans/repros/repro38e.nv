// EXPECT_TIMEOUT_MS 20000
// [221.1 #38] repro38e: real TcpListener.bind()+accept() (a real accepted
// TcpStream sitting around), but the INNER supervised(deadline:) races a
// plain Time-only spawn (no `.share()`/`.read_bytes()` at all) — isolates
// whether merely having done a real accept() in a PRIOR test is enough to
// break the SECOND test's supervised(deadline:), independent of
// TcpStream.share()/read.
module scratch38.repro38e

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.time.duration

fn try_once(tag str, _stream mut TcpStream) Time {
    ro (tx, rx) = Channel.new(1)
    mut timed_out = false
    ro t0 = Monotonic.now()
    ro dl = t0 + 60.to_seconds()
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(deadline: dl) {
            spawn {
                (10).to_millis().sleep()
                ro _ = tx.try_send(true)
            }
        }
    }
    ro elapsed = Monotonic.now().elapsed_since(t0).millis()
    if timed_out {
        print("ZZDBG ${tag} TimedOut elapsed_ms=${elapsed.to_str()}")
    } else {
        match rx.try_recv() {
            Some(_v) => print("ZZDBG ${tag} got-value elapsed_ms=${elapsed.to_str()}")
            None     => print("ZZDBG ${tag} NO-VALUE-no-timeout(?!) elapsed_ms=${elapsed.to_str()}")
        }
    }
}

fn run_test(tag str) Net Time Detach {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        supervised {
            spawn {
                consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                    Ok(consume l) => l
                    Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                }
                ro _ = port_tx.try_send(lst.local_port())
                match lst.accept() {
                    Ok(consume stream) => {
                        try_once(tag, stream)
                        stream.close()
                    }
                    Err(_) => ()
                }
                lst.close()
            }
            spawn {
                ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                match TcpStream.connect(SocketAddr.loopback(port)) {
                    Ok(consume conn) => {
                        consume cli = conn
                        (200).to_millis().sleep()
                        cli.close()
                    }
                    Err(_) => ()
                }
            }
        }
    }
}

test "run A: real accept(), inner spawn is Time-only (no share/read)" {
    run_test("A")
}

test "run B: second call, sequential, same process" {
    run_test("B")
}
