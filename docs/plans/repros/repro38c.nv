// EXPECT_TIMEOUT_MS 20000
// [221.1 #38] repro38c: ULTRA-minimal — no networking at all. Two sequential
// top-level tests, each just running a `supervised(deadline: Monotonic.now()
// + 60s)` block racing a `spawn` that sleeps 10ms then sends on a channel.
// If this alone reproduces "second call times out almost instantly", the
// bug is a GENERIC defect in `supervised(deadline:)`'s own bookkeeping
// (nothing to do with net.c / TcpListener / detach at all).
module scratch38.repro38c

import std.time.duration

fn try_once(tag str) Time {
    ro (tx, rx) = Channel.new(1)
    mut timed_out = false
    ro t0 = Monotonic.now()
    ro dl = t0 + 60.to_seconds()
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(deadline: dl) {
            spawn {
                (10).to_millis().sleep()
                ro _ = tx.try_send(true)
            }
        }
    }
    ro elapsed = Monotonic.now().elapsed_since(t0).millis()
    if timed_out {
        print("ZZDBG ${tag} TimedOut elapsed_ms=${elapsed.to_str()}")
    } else {
        match rx.try_recv() {
            Some(_v) => print("ZZDBG ${tag} got-value elapsed_ms=${elapsed.to_str()}")
            None     => print("ZZDBG ${tag} NO-VALUE-no-timeout(?!) elapsed_ms=${elapsed.to_str()}")
        }
    }
}

test "try_once A (first call in process)" {
    try_once("A")
}

test "try_once B (second call, sequential, same process)" {
    try_once("B")
}

test "try_once C (third call)" {
    try_once("C")
}
