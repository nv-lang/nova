// EXPECT_TIMEOUT_MS 20000
// [221.1 #38] repro38b: narrows repro38 down to the EXACT shape that
// reproduces the bug in nova-http (confirmed empirically against the real
// package): NESTED supervised — an outer `supervised(timeout:)` (the test's
// own bound) wraps an accept-loop whose per-connection `detach` body calls
// `read_attempt` (a SEPARATE fn, mirrors nova-http's `servernet/policy.nv`
// `read_attempt`), which runs a SECOND, INNER `supervised(deadline:
// Monotonic.now() + idle)` racing a `spawn consume ws = s.share() {
// ws.read_bytes(...) }` against that deadline. Two IDENTICAL such server
// instances run SEQUENTIALLY in one process: instance A's inner deadline-
// guarded read succeeds; instance B's fails (see task report for elapsed_ms
// evidence gathered against the real package before this file existed).
module scratch38.repro38b

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.time.duration

type ReadAttempt enum
    | Bytes([]u8)
    | TimedOut
    | Errored

fn read_attempt(s mut TcpStream, deadline Monotonic) Net Time -> ReadAttempt {
    ro (tx, rx) = Channel.new(1)
    mut timed_out = false
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(deadline: deadline) {
            spawn consume ws = s.share() {
                match ws.read_bytes(4096) {
                    Ok(chunk) => { ro _ = tx.try_send(chunk) }
                    Err(_)    => ()
                }
            }
        }
    }
    if timed_out {
        ReadAttempt.TimedOut
    } else {
        match rx.try_recv() {
            Some(chunk) => ReadAttempt.Bytes(chunk)
            None        => ReadAttempt.Errored
        }
    }
}

fn handle_one(stream mut TcpStream, tag str) Net Time {
    ro t0 = Monotonic.now()
    ro idle_dl = t0 + 60.to_seconds()
    ro result = read_attempt(stream, idle_dl)
    ro elapsed = Monotonic.now().elapsed_since(t0).millis()
    match result {
        ReadAttempt.Bytes(chunk) => {
            print("ZZDBG ${tag} Bytes len=${chunk.len().to_str()} elapsed_ms=${elapsed.to_str()}")
            ro _ = stream.write_str("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
        }
        ReadAttempt.TimedOut => print("ZZDBG ${tag} TimedOut elapsed_ms=${elapsed.to_str()}")
        ReadAttempt.Errored => print("ZZDBG ${tag} Errored elapsed_ms=${elapsed.to_str()}")
    }
}

test "instance A: nested supervised(deadline:) read succeeds" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        with Fail[TimeoutError] = |_e| {} {
            supervised(timeout: 3.to_seconds()) {
                spawn {
                    consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                        Ok(consume l) => l
                        Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                    }
                    ro _ = port_tx.try_send(lst.local_port())
                    mut running = true
                    while running {
                        match lst.accept() {
                            Ok(consume stream) => {
                                detach consume stream {
                                    handle_one(stream, "A")
                                    stream.close()
                                }
                            }
                            Err(_) => { print("ZZDBG accept-loop Err retry (orphan-check)"); (20).to_millis().sleep() }
                        }
                    }
                    lst.close()
                }
                spawn {
                    ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                    match TcpStream.connect(SocketAddr.loopback(port)) {
                        Ok(consume conn) => {
                            consume cli = conn
                            ro _ = cli.write_str("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
                            match cli.read_bytes(4096) {
                                Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                                Err(_) => ()
                            }
                            cli.close()
                        }
                        Err(_) => ()
                    }
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        ro s = unsafe { got.to_str_unchecked() }
        assert(s.contains("200"))
    }
}

test "instance C: single-shot accept (NO loop, NO outer cancellation ever) — control" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        supervised {
            spawn {
                consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                    Ok(consume l) => l
                    Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                }
                ro _ = port_tx.try_send(lst.local_port())
                match lst.accept() {
                    Ok(consume stream) => {
                        handle_one(stream, "C")
                        stream.close()
                    }
                    Err(_) => ()
                }
                lst.close()
            }
            spawn {
                ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                match TcpStream.connect(SocketAddr.loopback(port)) {
                    Ok(consume conn) => {
                        consume cli = conn
                        ro _ = cli.write_str("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
                        match cli.read_bytes(4096) {
                            Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                            Err(_) => ()
                        }
                        cli.close()
                    }
                    Err(_) => ()
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        ro s = unsafe { got.to_str_unchecked() }
        print("ZZDBG C outer-done s_contains_200=${s.contains(\"200\").to_str()}")
        assert(s.contains("200"))
    }
}

test "instance B: SAME shape, sequential in one process — expected to fail before fix" {
    with Net = real_net() {
        ro (port_tx, port_rx) = Channel.new(1)
        ro (got_tx, got_rx) = Channel.new(1)
        with Fail[TimeoutError] = |_e| {} {
            supervised(timeout: 3.to_seconds()) {
                spawn {
                    consume lst = match TcpListener.bind(SocketAddr.loopback(0)) {
                        Ok(consume l) => l
                        Err(_) => { ro _ = port_tx.try_send(0 as u16); return }
                    }
                    ro _ = port_tx.try_send(lst.local_port())
                    mut running = true
                    while running {
                        match lst.accept() {
                            Ok(consume stream) => {
                                detach consume stream {
                                    handle_one(stream, "B")
                                    stream.close()
                                }
                            }
                            Err(_) => { print("ZZDBG accept-loop Err retry (orphan-check)"); (20).to_millis().sleep() }
                        }
                    }
                    lst.close()
                }
                spawn {
                    ro port = match port_rx.recv() { Some(p) => p, None => 0 as u16 }
                    match TcpStream.connect(SocketAddr.loopback(port)) {
                        Ok(consume conn) => {
                            consume cli = conn
                            ro _ = cli.write_str("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
                            match cli.read_bytes(4096) {
                                Ok(chunk) => { ro _ = got_tx.try_send(chunk) }
                                Err(_) => ()
                            }
                            cli.close()
                        }
                        Err(_) => ()
                    }
                }
            }
        }
        got_tx.close()
        ro got = got_rx.try_recv() ?? []u8.new()
        ro s = unsafe { got.to_str_unchecked() }
        assert(s.contains("200"))
    }
}
