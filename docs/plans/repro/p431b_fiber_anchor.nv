// SPDX-License-Identifier: MIT OR Apache-2.0
//
// №431 ОСТАТОК — окно p431b-fiber-anchor. Проверяет ровно то, что осталось
// незакрытым после окна p431: поздняя отмена, которой некому доставить,
// обязана завершать ТОЛЬКО свой файбер, а программа должна жить дальше.
//
// Чем это отличается от `p431_direct_repro.nv` (окно p431): тот стенд зовёт
// хук из `main()`, то есть из корневого main-файбера, у которого якоря нет
// намеренно (см. `_nova_cancel_no_handler`, `nova_rt/effects.c`) — он
// проверяет только «процесс не падает». Здесь хук зовётся ИЗ ТЕЛА `spawn`,
// то есть из обычного файбера с якорем, и проверяется весь наблюдаемый
// контракт разом:
//
//   * файбер, поймавший позднюю отмену, НЕ доходит до следующего оператора
//     («child-A: unreachable» не печатается никогда);
//   * его СОСЕД по области доживает до конца («child-B: finished»);
//   * область не считает себя упавшей — отмена наверх не рапортуется
//     (иначе `supervised` перебросил бы ошибку и `main` не досчитал бы);
//   * `main` доходит до конца и процесс завершается кодом 0.
//
// Хук `nova_p431b_fiber_repro` (`nova_rt/effects.c`, помечен TEMPORARY)
// форсирует РОВНО задокументированное состояние отказа — `_nova_fail_top ==
// NULL` — и зовёт `nova_throw_cancel`. Область файбера при этом НЕ трогается:
// эпилог entry-функции (освобождение слота планировщика, декремент
// `pending_remote`) обязан отработать так же, как у нормально завершившегося
// файбера — иначе «тихое завершение» превратилось бы в утечку слота.
//
// ДО ФИКСА (окно p431): три кооперативные уступки и `exit(1)` — процесс
// уходил целиком, «main: alive» не печаталось.
// ПОСЛЕ ФИКСА: печатается всё, кроме «child-A: unreachable», код возврата 0,
// в stderr — итоговая строка счётчика поздних отмен.
module nova_repro.p431b_fiber_anchor

extern "C" fn nova_p431b_fiber_repro() -> ()

fn main() {
    println("main: entering scope")
    supervised {
        spawn {
            println("child-A: about to take a late cancel with no handler")
            nova_p431b_fiber_repro()
            println("child-A: unreachable")
        }
        spawn {
            println("child-B: finished")
        }
    }
    println("main: alive after the retired fiber")
}
