// One consume-required type, four ways to build it. The bodies are identical on
// purpose: if the verdicts differ, the difference is the NAME.

module probe_consume_name.secret

#impl(Debug)
export type Secret consume {
    secret str
}

// D133 refuses a `consume` type with no consume-method at all, and without this line
// EVERY form above failed on THAT instead -- the control caught it. Copied from the
// real type in `src/accounts/login.nv:70`.
export fn Secret consume @into_secret() -> str => @secret

export fn Secret.new(secret str) -> Secret => { secret }
export fn Secret.of(secret str) -> Secret => { secret }
export fn Secret.make(secret str) -> Secret => { secret }
export fn build_secret(secret str) -> Secret => { secret }
