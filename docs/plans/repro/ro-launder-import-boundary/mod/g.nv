// ПРОБА G строки 72 реестра, поставленная ЗА границу импорта.
//
// Строка 72 закрыта 2026-07-24 с явной границей: исключение ro-launder распространяется на
// ПОЛНОСТЬЮ-стековые value-типы, а value-запись с КУЧЕВЫМ полем ОСТАЁТСЯ neg -- мелкая копия
// разделяет кучевое поле, и запись через новый `mut` видна вызывающему. Это не придирка к
// форме, а звучность: ровно тот случай, ради которого правило существует.
//
// Здесь та же форма живёт в ИМПОРТИРУЕМОМ файле. Если сборка через точку входа её принимает,
// дыра не формальная: `ro`-параметр вызывающего меняется в вызываемом.
module mod

/// Оболочка стековая, поле кучевое -- та самая проба G.
export type Resp value {
    hdr []int
}

/// `r` связан как `ro` (параметр без `mut`). Копия в `mut` мелкая: `hdr` общий с
/// вызывающим, и `push` виден ему.
export fn leak(r Resp) -> int {
    mut m = r
    m.hdr.push(999)
    m.hdr.len()
}
