// №419 (K1) audit probe — `Vec[T].new(ptr, len, cap)` (std/src/collections/vec/core.nv:150)
// is documented as "unsafe-obligated at the call site" but its declaration
// (`export fn Vec[T].new(ptr *mut T, len int, cap int) -> Self`) carries NO
// `unsafe` keyword — unlike its 2-arg VIEW-form sibling three lines above it
// (`export unsafe fn Vec[T].new(ptr *T, len int) -> ro Self`). The obligation
// is prose only; the checker does not require a caller-side `unsafe { }`
// block to invoke the 3-arg form. Demonstrated below: the only `unsafe`
// block in `main` wraps the raw allocation — the `Vec[Status].new(...)` call
// that hands zeroed memory off as `len` live `Status` values sits OUTSIDE
// any `unsafe { }`, and still fabricates an invalid `Status`.
//
// Run: nova build docs/plans/repro/p419-vec-new-ptr-len-cap.nv -o /tmp/p419b && /tmp/p419b

module repro.p419_vec_new_ptr_len_cap

import std.runtime.raw_mem.{RawMem}

type Status value {
    priv code int
}

fn Status.new(c int) -> Result[Status, str] {
    if c < 100 || c > 599 {
        return Err("out of range: ${c}")
    }
    Ok({ code: c })
}

fn Status @is_valid() -> bool => @code >= 100 && @code <= 599
fn Status @code() -> int => @code

fn main() -> () {
    // The one and only `unsafe` obligation this probe actually pays: raw
    // alloc of zeroed memory sized for one `Status`.
    ro raw_ptr = unsafe { RawMem.alloc(size_of[Status]()) as *mut Status }

    // NOT wrapped in `unsafe { }` — and it still compiles. Per the
    // docstring this call is "unsafe-obligated at the call site", but the
    // signature doesn't say `unsafe fn`, so the checker never asks for the
    // block here.
    ro v = Vec[Status].new(raw_ptr, 1, 1)

    ro fabricated = v.get(0).unwrap()
    println("Vec[Status].new(ptr,1,1) fabricated Status OUTSIDE unsafe{}: code=", fabricated.code(), " is_valid=", fabricated.is_valid())
}
