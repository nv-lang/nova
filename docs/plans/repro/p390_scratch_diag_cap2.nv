// SCRATCH (p390 diagnosis, NOT a committed repro): identical to
// p249_second_read_after_partial_hangs.nv EXCEPT ch_result has capacity 2
// and the test drains it TWICE. Hypothesis: the original "hangs forever"
// is not a lost network wake but a capacity-1 double-send race — the
// cancelled reader fiber finishes normally (Result-based cancel, no throw)
// and sends its own value, while the outer Fail[TimeoutError] handler ALSO
// sends, blocking forever on a full, un-drained channel. If this variant
// prints both values without hanging, that confirms the race.

module scratch390.diagcap2

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.time.duration

fn b(vals []int) -> []u8 {
    mut out []u8 = []u8.new()
    for v in vals { out.push(v as u8) }
    out
}

test "diag: capacity-2 channel drains both the reader's result and the timeout handler's" {
    with Net = real_net() {
        ro ch_port = Channel.new(1)
        ro ch_result = Channel.new(2)
        with Fail[TimeoutError] = |_e| { ro _ = ch_result.tx.send(-777) } {
            supervised(timeout: 2000.to_millis()) {
                spawn {
                    consume lst = TcpListener.bind(SocketAddr.loopback(0))!!
                    ch_port.tx.send(lst.local_port())
                    ro accepted = lst.accept()
                    lst.close()
                    match accepted {
                        Ok(consume conn) => {
                            ro _ = conn.write_all(b([]int.of(0x05)))  // 1 byte
                            conn.close()                               // real FIN
                        }
                        Err(_) => ()
                    }
                }
                spawn {
                    ro port = match ch_port.rx.recv() { Some(p) => p  None => 0 as u16 }
                    match TcpStream.connect(SocketAddr.loopback(port as int)) {
                        Ok(consume conn) => {
                            mut buf1 []u8 = []u8.new()
                            buf1.resize(1, 0 as u8)
                            ro n1 = match conn.read(buf1) { Ok(k) => k  Err(_) => -1 }
                            mut buf2 []u8 = []u8.new()
                            buf2.resize(1, 0 as u8)
                            ro n2 = match conn.read(buf2) { Ok(k) => k  Err(_) => -2 }
                            conn.close()
                            ro _ = ch_result.tx.send(n1 * 100 + n2)
                        }
                        Err(_) => { ro _ = ch_result.tx.send(-999) }
                    }
                }
            }
        }
        ro first = match ch_result.rx.recv() { Some(v) => v  None => -998 }
        ro second = match ch_result.rx.recv() { Some(v) => v  None => -997 }
        assert(first == -777 || first == 98 || first == 100)
        assert(second == -777 || second == 98 || second == 100)
        assert(first != second)
    }
}
