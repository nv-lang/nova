// №419 (K1) audit follow-up — independent re-confirmation of the integrator's
// finding (2026-08-07): a bound on a GENERIC-TYPE method's RECEIVER type
// parameter (`Vec[T Ints]`, as opposed to a bound on an ordinary parameter
// or on a bare `T` method-level generic) is not checked at the call site at
// all. `Vec[Status]` with `Status` NOT in `Ints` still resolves `.zz(1)`
// with zero diagnostics. This is why a hypothetical
// `Vec[T ZeroBytes] mut @append_zero(...)` bound would be decorative today —
// the mechanism that would enforce it doesn't run for receiver-position
// bounds. Sixth known instance of the class closed partially by №383/№386/№388.
//
// Run: nova check docs/plans/repro/p419-receiver-bound-not-checked.nv
// Expectation if the bound worked: a diagnostic on `.zz(1)` (Status is not
// in Ints). Observed: PASS, no diagnostic.

module repro.p419_receiver_bound_not_checked

type Status value {
    priv code int
}

fn Status.new(c int) -> Result[Status, str] {
    if c < 100 || c > 599 {
        return Err("out of range: ${c}")
    }
    Ok({ code: c })
}

// Bound on the RECEIVER type parameter — mirrors the shape a
// `Vec[T ZeroBytes] mut @append_zero` fix would take.
export fn Vec[T Ints] mut @zz(n int) -> @ {}

fn main() -> () {
    mut v = Vec[Status].new()
    // `Status` is not in `Ints` — this line should be rejected if the
    // receiver-position bound were actually checked.
    v.zz(1)
    println("compiled + ran: receiver bound Vec[T Ints] did NOT reject Vec[Status]")
}
