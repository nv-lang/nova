module probe

// Проба ОДНОГО вопроса: входит ли `Result` в подмножество novac как ТИП.
// Без `??` вовсе — иначе отказ по коалесценции скрыл бы отказ по контейнеру,
// и проба ответила бы на соседний вопрос (класс «проверка мерит не свой предмет»).
fn take() -> Result[int, str] => Ok(7)

fn main() -> () {
    ro r = take()
    match r {
        Ok(v) => println("${v}")
        Err(e) => println("${e}")
    }
}
