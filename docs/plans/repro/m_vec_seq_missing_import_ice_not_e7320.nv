// KNOWN-BROKEN reference repro — NOT part of any test suite (would silently
// pass `nova check` when it should E7320, then ICE at C-codegen if built).
// Do not add to spec_tests/conformance, nova_tests, or any glob-discovered
// test path — kept here purely as an executable-by-hand diagnostic artifact
// for [M-vec-seq-missing-import-ice-not-e7320].
//
// Diagnosed 2026-08-01 (window p-ice-pack, п.10, sonnet) — see
// docs/plans/backlog-followups.md's entry for the full root-cause trace and
// why a real fix was out of this window's budget (the exact divergence
// line was not pinned via static reading — every branch of
// check_instance_overload/infer_arg_ty examined SHOULD behave identically
// for a primitive-elem vs user-record-elem Vec receiver on paper; a
// runtime eprintln-trace is needed to find where they actually diverge).
//
// KEY FINDING (broader than the original title suggests): this is NOT
// specifically about a missing `import std.collections.vec_seq` — the
// checker silently accepts ANY method name (even one that exists nowhere)
// called on a `Vec[UserRecordType]` receiver, heap OR value record,
// regardless of explicit type annotation. The identical check correctly
// rejects the same bogus method name on `Vec[int]`/`Vec[str]` with a clean
// [E7320].
//
// To reproduce: nova check docs/plans/repro/m_vec_seq_missing_import_ice_not_e7320.nv
//   → currently: "ok" (should be [E7320] no field or method ...)
//   → nova build (same file): ICE [P67-LEGACY] method call `.totally_bogus_method_xyz` ...
module nova_repro.vec_seq_missing_import_ice_not_e7320

type ReproItemHeap { v int }
type ReproItemValue value { v int }

fn probe_heap() {
    ro xs []ReproItemHeap = [ReproItemHeap { v: 1 }, ReproItemHeap { v: 2 }]
    ro ys = xs.totally_bogus_method_xyz()
    println(ys)
}

fn probe_value() {
    ro xs []ReproItemValue = [ReproItemValue { v: 1 }, ReproItemValue { v: 2 }]
    ro ys = xs.totally_bogus_method_xyz()
    println(ys)
}

// Control: the SAME bogus-method shape on a primitive-element Vec already
// correctly rejects with [E7320] — proves the divergence is specifically
// about the element being a user-declared type, not about the method name.
fn probe_control_primitive() {
    ro xs = [1, 2, 3]
    ro ys = xs.totally_bogus_method_xyz()
    println(ys)
}

fn main() {
    probe_heap()
    probe_value()
    probe_control_primitive()
}
