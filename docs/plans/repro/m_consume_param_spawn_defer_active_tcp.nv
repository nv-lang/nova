// РЕПРО для [M-consume-param-spawn-defer-active] (codegen-половина), собран
// интегратором 2026-08-06 по запросу окна p364: «нужен репро ближе к реальному
// TcpListener, у него более полная close/cleanup-машинерия».
//
// Симптом (nova build --strict-effects): C-ошибка
//   use of undeclared identifier '_defer_3_1_active'; did you mean '_defer_5_0_active'?
// т.е. рассинхрон индексов defer-скоупа: объявлен один, дизармится другой.
//
// Форма — САНКЦИОНИРОВАННАЯ (D415 §4 явный move `spawn consume leg { … }`),
// гейт №364 её НЕ трогает; `nova check` проходит чисто, падает линковка/кодоген.
//
// Контекст: это единственная известная запись двунаправленного relay после
// закрытия №364 — `spawn consume` двигает ОДНО значение, а файберу нужны ОБЕ
// половинки `into_split()`, поэтому они упакованы в один consume-тип `Leg`.
// НЕ в тест-раннере (build ломается) — референс для следующего окна.

module scratch38.leg

import std.net.{TcpListener, TcpStream, TcpReadHalf, TcpWriteHalf, SocketAddr}

type Leg consume {
    consume r TcpReadHalf
    consume w TcpWriteHalf
}

fn Leg consume @drain() Net -> () {
    ro _ = @r.close()
    ro _ = @w.close()
}

// D432: эффект-чистый @cleanup — авто-закрытие + определение символа для кодогена.
fn Leg consume @cleanup(_o ScopeOutcome) -> () { }

fn pipe_bidirectional(consume a TcpStream, consume b TcpStream) Net -> () {
    ro (ar, aw) = a.into_split()
    ro (br, bw) = b.into_split()
    consume leg1 = Leg { r: ar, w: bw }
    consume leg2 = Leg { r: br, w: aw }
    supervised {
        spawn consume leg1 { leg1.drain() }
        spawn consume leg2 { leg2.drain() }
    }
}

fn main() Net -> () {
    match TcpListener.bind(SocketAddr.loopback(18985)) {
        Ok(consume l) => {
            supervised {
                match l.accept() {
                    Ok(consume c1) => match TcpStream.connect(SocketAddr.loopback(18984)) {
                        Ok(consume c2) => pipe_bidirectional(c1, c2)
                        Err(_) => { ro _ = c1.close() }
                    }
                    Err(_) => ()
                }
            }
        }
        Err(_) => panic("bind")
    }
}
