// EXPECT_COMPILE_ERROR
// Класс: альтернативы дизъюнкции вводят РАЗНЫЕ наборы биндеров, а биндеры
// читаются по разметке ПЕРВОЙ альтернативы (реестр 221.1 №1009; блокер тега).
//
// В оракуле это давало тихое чтение чужого члена union: на значении `Q(7)` тело
// печатало `7` для биндера `b`, которого `Q` не вводит вовсе, а в варианте со
// строкой — пустую строку, прочитанную как указатель из int-варианта. Ни паники,
// ни предупреждения, exit 0.
//
// Правильное поведение — ОТКАЗ ЧЕКЕРА: в арме дизъюнкции не может быть биндера,
// которого нет в каждой альтернативе. У оракула это `E_OR_PATTERN_BINDING_MISMATCH`;
// у Карины код диагностики будет свой, потому маркер здесь без кода.
//
// ВНИМАНИЕ ПРИ ПЕРЕНОСЕ: имя типа НЕ односимвольное — `T` сталкивается с
// генерик-параметром std в общем CU.
module from_oracle.or_pattern_binding_sets

type OrPair enum P(int, int) | Q(int)

fn probe(t OrPair) -> int {
    match t {
        P(a, b) | Q(a) => a + b
    }
}

fn main() Io -> () => print("${probe(Q(7))}")
