// EXPECT_STDOUT 5 2 5 1
// Класс: ширина элемента константного массива берётся из ЛИТЕРАЛОВ, а не из
// ОБЪЯВЛЕНИЯ (реестр 221.1 №1003; у оракула был блокером тега).
//
// В оракуле `const T []u8 = [5, 2, 5, 1]` строился как вектор `int` — восемь
// байт на элемент — и клался в слот `[]u8`: однобайтовое чтение попадало ВНУТРЬ
// первого `int`, и элемент 1 оказывался его вторым байтом. Печаталось `5 0 0 0`
// при верных `T.len()` и `T[0]` — из-за этого дефект и жил незамеченным.
//
// Почему форма именно такая: `[]int`, `[]u64`, `[]f64` работали и до фикса,
// потому что ширина литерала СЛУЧАЙНО совпадала с объявленной. Страдают узкие:
// u8/u16/u32 и f32. Одного `[]u8` достаточно, чтобы класс воспроизвёлся.
module from_oracle.const_array_elem_width

const T []u8 = [5, 2, 5, 1]

fn main() Io -> () => print("${T[0]} ${T[1]} ${T[2]} ${T[3]}")
