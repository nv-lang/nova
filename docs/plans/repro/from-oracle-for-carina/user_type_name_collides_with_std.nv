// EXPECT_STDOUT id=7
// Класс: имя C-структуры строится как `Nova_<TypeName>_s` БЕЗ квалификатора
// модуля, поэтому два разных типа с одним именем дают ОДНУ структуру, и та,
// что пришла из std, побеждает — поля пользовательского типа исчезают
// (реестр 221.1 №756; у оракула блокер тега).
//
// В оракуле минимальная проба падала на СИ: `no member named 'id' in
// 'struct Nova_MutexGuard_s'`, хотя std здесь явно ничего не импортирует и
// пользовательский тип объявлен рядом. То же убило сборку целого CU
// conformance.
//
// Почему это не угловой случай: `MutexGuard`, `Permit`, `ReadGuard`,
// `WriteGuard`, `TcpStream` — обычные имена в прикладном коде, и первый же
// пользователь, назвавший свой тип так же, получит ошибку СИ-компилятора на
// СВОЙ код — диагностику, которую он не сможет прочесть.
//
// Что проверять в Карине: собирается ли программа и печатает ли `id=7`.
// Если у novac имя C-структуры тоже строится без квалификатора модуля —
// класс повторён, и он проявится ровно так же, при первом совпадении имён.
module from_oracle.user_type_name_collides_with_std

type MutexGuard { ro id int }

fn main() Io -> () => print("id=${MutexGuard { id: 7 }.id}")
