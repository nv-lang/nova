module nova_repro.detach_box_while_loop_read_after

import std.runtime.sync.{Semaphore}

fn probe() Detach {
    mut inflight = Semaphore.new(4)
    mut running = true
    while running {
        detach { ro _ = inflight.try_acquire() }
        running = false
    }
    ro avail = inflight.available_permits()   // <- breaks C-codegen
    println("avail=${avail}")
}

fn main() Detach {
    probe()
}
