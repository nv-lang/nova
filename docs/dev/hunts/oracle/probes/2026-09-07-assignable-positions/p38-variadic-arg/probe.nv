// Position: element passed to a VARIADIC parameter declared `...xs []u8`.
// The same value at a plain `u8` parameter is refused
// (spec_tests/conformance/neg/n_fnarg.nv).
module probe

fn total(...xs []u8) -> int {
    mut s = 0
    for x in xs { s = s + (x as int) }
    s
}

fn main() Io -> () {
    ro n int = 300
    print("variadic=${total(n, 1)}")
}
