// THE PROBE. Two overloads whose parameter MODES vary in opposite directions on
// two positions: neither is more specific everywhere, and their specificity
// totals are equal (2+0+0 against 0+1+1).
//
// D84's mode-axis amendment (Plan 184 / D326-R13/R14,
// spec/decisions/10-overloading.md) says of exactly this shape: the dispatch
// REJECTS the call as ambiguous, listing the candidates -- "there is no silent
// choice".
//
// MEASURED 2026-08-31: the oracle compiles this and prints 2.
module m

fn f(consume a int, b int, c int) -> int => a

fn f(a int, mut b int, mut c int) -> int => 2

fn main() Io -> () {
    mut y = 10
    mut z = 20
    print("${f(41 + 1, y, z)}")
}
