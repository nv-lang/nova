// CONTROL: D486 s4 constructor as the WHOLE for-header pattern.
// Expected per D486: E_REFUTABLE_BINDING (the oracle's acceptance of
// `for Some(x) in` is a known registry divergence, not this hunt's).
type Sh enum
    | A(int)
    | B

fn total(xs []Sh) -> int {
    mut n = 0
    for A(v) in xs {
        n += v
    }
    n
}

fn main() {
    println(1)
}
