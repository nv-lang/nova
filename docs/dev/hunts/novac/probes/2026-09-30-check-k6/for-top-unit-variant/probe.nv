// D486 s4: for-header rules = binding rules; constructor is E_REFUTABLE_BINDING.
// A payload-less variant head is the WHOLE header pattern here.
type Sh enum
    | A(int)
    | B

fn count(xs []Sh) -> int {
    mut n = 0
    for B in xs {
        n += 1
    }
    n
}

fn main() {
    println(1)
}
