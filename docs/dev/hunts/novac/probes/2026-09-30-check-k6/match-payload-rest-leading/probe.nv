// D486 s2: constructor = qual-head ['(' pattern (',' pattern)* ')'] -- no
// `..` inside a payload list at all; D59's `Cons(..)` (the rest ALONE) is the
// only partial payload form. Here `..` LEADS and `z` follows it: `z` can only
// mean the LAST payload (30) -- or the form is refused.
type Two enum
    | Pr(int, int)
    | No

fn last(t Two) -> int {
    match t {
        Pr(.., z) => z
        No => 0
    }
}

fn main() {
    println(last(Pr(20, 30)))
}
