// D486 s4 row "disjunction", if/while column: forbidden. Top-level
// `if A | B = s` is refused; here the disjunction is nested in `Some(...)`.
type Sh enum
    | A(int)
    | B
    | C

fn f(o Option[Sh]) -> int {
    if Some(B | C) = o {
        return 1
    }
    0
}

fn main() {
    println(1)
}
