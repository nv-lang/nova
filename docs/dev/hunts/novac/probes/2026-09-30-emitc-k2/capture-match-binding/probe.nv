// The captured binding is a MATCH-ARM binding and a FOR binding: their C
// names must be the ones the context copy reads (`_cx->v = v`).
type Sh enum A(int) | B

fn main() {
    ro o = Sh.A(5)
    match o {
        A(v) => {
            for i in 0..2 {
                with ResourceTrace = effect ResourceTrace {
                    on_resource_enter(label str) -> () {
                        println(label, " v=", v, " i=", i)
                    }
                    on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
                        println(label)
                    }
                } {
                    ResourceTrace.on_resource_enter("x")
                }
            }
        }
        B => println("b")
    }
}
