// Registry 1421 kin: a handler literal written INSIDE another literal's op
// body reads `seen`, which that outer literal already captures (its own op
// body reads it too). The inner literal's context must be filled from the
// outer op function's context, not from a C local named `seen`.
fn main() {
    mut seen = 0
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            seen += 1
            with Random = effect Random {
                u64() -> u64 {
                    seen += 100
                    7
                }
            } {
                println(label, " ", Random.u64())
            }
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
    println(seen)
}
