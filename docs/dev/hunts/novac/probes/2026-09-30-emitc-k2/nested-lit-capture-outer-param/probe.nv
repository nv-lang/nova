// Control: an inner literal reads the OUTER op's own parameter `label` -- a
// C parameter of the outer op function, so the bare name is right there.
fn main() {
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            with Random = effect Random {
                u64() -> u64 {
                    println("inner sees ", label)
                    7
                }
            } {
                println(Random.u64())
            }
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
}
