// A MODULE VALUE read from a handler op body, with no local of that name:
// not a capture; the op function reads the module cell.
fn announce() -> int {
    println("init")
    3
}

ro BASE = announce() + 37

fn main() {
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            println(label, " ", BASE)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
}
