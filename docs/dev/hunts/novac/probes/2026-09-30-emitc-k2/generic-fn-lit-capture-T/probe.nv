// A handler literal inside a GENERIC function, instantiated at two types.
// The literal gets ONE C number per source node (emit_handler.nv
// @collect_handler_lits walks declarations, not instances) and its context
// field is typed from the file channel's `type_id` of the capture.
// (`x + y` in the op body: the bound the checker knows for T is numeric.)
fn show[T](x T, y T, tag str) -> () {
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            println(label, " ", x + y)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter(tag)
    }
}

fn main() {
    show(5, 6, "int")
    show(1.5, 2.25, "float")
}
