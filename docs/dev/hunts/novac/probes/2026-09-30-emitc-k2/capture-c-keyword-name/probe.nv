// A captured binding named like a C keyword. The context field and its
// fill are spelled with the capture's SOURCE name (emit_handler.nv:135,215):
// is that the local's C name?
fn main() {
    ro long = 5
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            println(label, " ", long)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
}
