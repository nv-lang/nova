// In ONE op body the name `base` is first a CAPTURE, then a LOCAL of the op
// body: the first read goes through the context, the second reads the local.
fn main() {
    ro base = 40
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            println("cap ", base)
            ro base = 1
            println("loc ", base)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
}
