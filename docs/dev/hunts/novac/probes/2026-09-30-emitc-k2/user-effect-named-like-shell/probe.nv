// A file declares an effect named like a shell effect (`Random`). The
// schema table and the vtable/slot names are keyed by the bare effect name
// (sem/effects.nv NameTable.put, mangle.nv effect_vtable_c).
type Random effect {
    fn u64() -> u64
}

fn main() {
    with Random = effect Random {
        u64() -> u64 => 7
    } {
        println(Random.u64())
    }
}
