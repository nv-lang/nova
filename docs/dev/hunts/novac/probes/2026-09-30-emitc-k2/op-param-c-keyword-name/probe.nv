// An op PARAMETER named like a C keyword: the op function's C parameter is
// spelled with the source name (emit_handler.nv:116-117).
fn main() {
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(auto str) -> () {
            println("enter ", auto)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
}
