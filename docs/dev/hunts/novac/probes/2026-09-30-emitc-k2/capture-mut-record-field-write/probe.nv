// A captured `mut` RECORD whose FIELD is written in the op body: the write
// must land in main's record (by address), seen after the `with`.
type Counter { n int, tag str }

fn main() {
    mut c = Counter { n: 3, tag: "t" }
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            c.n += 10
            println(label, " ", c.n)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
    println(c.n)
}
