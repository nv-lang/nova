// A captured binding read inside an interpolation slot of an op body: is
// the slot's Name recorded as a capture (through the context), or printed
// bare?
fn main() {
    ro base = 40
    mut seen = 1
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            seen += 1
            println("${label} base=${base} seen=${seen}")
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
    println("after ${seen}")
}
