// The constant's initializer `step + 10` is typed at EACH READ, in the
// read site's scope (check/exprs.nv @const_type_of: `type_of(cd.init[0],
// @ctx, @scope, @chan)`). A local `step` of type str at the read site: the
// initializer's `step` must still be the constant (oracle: prints s, 11).
const step = 1
const next = step + 10

fn main() {
    ro step = "s"
    println(step)
    println(next)
}
