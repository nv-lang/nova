// A captured `mut` vector used as a method RECEIVER in an op body
// (`log.push(..)`): every read must go through the context, and the push
// must be seen after the `with`.
fn main() {
    mut log = []str.of("start")
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            log.push(label)
            println(log.len())
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
        ResourceTrace.on_resource_enter("b")
    }
    println(log.len())

}
