// A handler literal inside a GENERIC function capturing `x T`: the context
// field's C type is taken from the capture row's `type_id` (emit_handler.nv
// :135), one row per source literal -- which instance's T is it?
fn wrap[T](x T, tag str) -> T {
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            ro copy = x
            println(label, " ", tag)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("in")
    }
    x
}

fn main() {
    println(wrap(5, "int"))
    println(wrap(true, "bool"))
}
