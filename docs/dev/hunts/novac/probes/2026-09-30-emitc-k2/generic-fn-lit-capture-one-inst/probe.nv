// A handler literal CAPTURING `x T` inside a generic function, ONE instance.
fn show[T](x T, y T, tag str) -> () {
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            println(label, " ", x + y)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter(tag)
    }
}

fn main() {
    show(5, 6, "int")
}
