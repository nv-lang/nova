=== PROGRAM
     1	// Hunt 2026-10-02 cast x K1, probe const-narrow-shift-inlined.
     2	// A `const` whose initializer casts and shifts a narrow integer: its type is
     3	// u8, so its value is a u8. The oracle stores it at its type (128); Carina
     4	// substitutes the initializer TEXT at every use, and the use sees C's
     5	// int-promoted shift (3200) -- even with no cast at the use site.
     6	const S = (200 as u8) << 4
     7	const T u8 = 200
     8	
     9	fn main() {
    10	    println("S, norm 128")
    11	    println(S)
    12	    println("S as u16, norm 128")
    13	    println(S as u16)
    14	    println("S as u8, norm 128")
    15	    println(S as u8)
    16	    println("S == 128, norm true")
    17	    println(S == 128)
    18	    println("(T << 4) as u8, norm 128")
    19	    println((T << 4) as u8)
    20	    println("ctl: ro r = (200 as u8) << 4; r, norm 128")
    21	    ro r = (200 as u8) << 4
    22	    println(r)
    23	}
