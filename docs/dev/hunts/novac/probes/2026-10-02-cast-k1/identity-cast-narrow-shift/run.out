=== PROGRAM
     1	// Hunt 2026-10-02 cast x K1, probe identity-cast-narrow-shift.
     2	// A cast INTO THE OPERAND'S OWN TYPE (`e as u8` with `e u8`) must still yield a
     3	// value of that type. D54 (amendment 2026-09-04 p.1): `as` takes the low M bits
     4	// of the source -- "`as` IS that mask". Each `norm` line names the value D54
     5	// gives; the `ctl` lines are the same value reached through a binding.
     6	fn main() {
     7	    ro a = 200 as u8
     8	    ro s = 100 as i8
     9	    ro h = 40000 as u16
    10	    ro q = 20000 as i16
    11	    println("(a << 4) as u8, norm 128")
    12	    println((a << 4) as u8)
    13	    println("(a << 4) as u8 == 128, norm true")
    14	    println((a << 4) as u8 == 128)
    15	    println("((a << 4) as u8) as u16, norm 128")
    16	    println(((a << 4) as u8) as u16)
    17	    println("(s << 1) as i8, norm -56")
    18	    println((s << 1) as i8)
    19	    println("(h << 1) as u16, norm 14464")
    20	    println((h << 1) as u16)
    21	    println("(q << 2) as i16, norm 14464")
    22	    println((q << 2) as i16)
    23	    println("ctl: ro t = a << 4; t as u8, norm 128")
    24	    ro t = a << 4
    25	    println(t as u8)
    26	}
