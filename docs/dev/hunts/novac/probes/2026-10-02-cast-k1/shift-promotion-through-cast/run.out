=== PROGRAM
     1	// Hunt 2026-10-02 cast x K1, probe shift-promotion-through-cast.
     2	// A shift on a NARROW integer (u8, i8, u16) is typed by both compilers as the
     3	// operand's type -- a binding `ro t = a << 4` stores 128 -- but the same
     4	// expression cast to a WIDER type carries C's int promotion through the cast.
     5	// D54: a u8 source has at most 8 bits to give, so `x as u16` of a u8 is <= 255;
     6	// conversions.md (D405): "Nova does not pick the wider type for you";
     7	// plan 234 (owner's decision 2026-07-27) names this exact C promotion for `~`
     8	// as "silently wrong in an expression context".
     9	fn main() {
    10	    ro a = 200 as u8
    11	    ro s = 100 as i8
    12	    ro h = 60000 as u16
    13	    println("ctl: ro t = a << 4; t as u16, norm 128")
    14	    ro t = a << 4
    15	    println(t as u16)
    16	    println("(a << 4) as u16, norm 128")
    17	    println((a << 4) as u16)
    18	    println("(a << 4) as u64, norm 128")
    19	    println((a << 4) as u64)
    20	    println("(a << 4) as f64, norm 128")
    21	    println((a << 4) as f64)
    22	    println("(s << 1) as i16, norm -56")
    23	    println((s << 1) as i16)
    24	    println("(h << 2) as u32, norm 43392")
    25	    println((h << 2) as u32)
    26	    println("a << 4 printed bare, norm 128")
    27	    println(a << 4)
    28	    println("(a << 4) == (128 as u8), norm true")
    29	    println((a << 4) == (128 as u8))
    30	}
