// The SAME overload pair asked through the `@` form, from a `mut` method body.
module basics.p_mode_overload_at

type Counter { mut n int }

fn Counter @tag() -> int => 1

fn Counter mut @tag() -> int => 2

fn Counter mut @via() -> int => @tag()

fn main() {
    mut c = Counter { n: 0 }
    println("tag = ${c.via()}")
}
