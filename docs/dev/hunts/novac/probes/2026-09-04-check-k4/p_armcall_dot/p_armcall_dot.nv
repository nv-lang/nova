// NARROWED: a method call in a MATCH ARM body, plain scrutinee, dotted form.
module basics.p_armcall_dot

type Counter { mut n int }

fn Counter @tag() -> int => @n + 7

fn main() {
    mut c = Counter { n: 1 }
    ro k = 1
    ro r = match k {
        1 => c.tag()
        _ => 0
    }
    println("arm = ${r}")
}
