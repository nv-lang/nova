// A `mut` PARAMETER filled by a `mut` binding written as a NAME.
module basics.p_argpos_name

type Counter { mut n int }

fn bump_it(mut c Counter) -> () {
    c.n = c.n + 1
}

fn main() {
    mut c = Counter { n: 0 }
    bump_it(c)
    println("n = ${c.n}")
}
