// A `mut` method through a PARENTHESISED receiver written as a name.
module basics.p_paren_recv_name

type Counter { mut n int }

fn Counter mut @bump() -> () {
    @n = @n + 1
}

fn main() {
    mut c = Counter { n: 0 }
    (c).bump()
    println("n = ${c.n}")
}
