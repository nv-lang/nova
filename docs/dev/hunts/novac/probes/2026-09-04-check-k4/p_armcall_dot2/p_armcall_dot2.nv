// CONFOUND REMOVED: the dotted call sits in a match that IS a function's
// expression body -- the same position the `@` twin's match occupies.
module basics.p_armcall_dot2

type Counter { mut n int }

fn Counter @tag() -> int => @n + 7

fn use_c(c Counter, k int) -> int => match k {
    1 => c.tag()
    _ => 0
}

fn main() {
    mut c = Counter { n: 1 }
    println("arm = ${use_c(c, 1)}")
}
