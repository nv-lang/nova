// Narrowing the chain ICE: a method RETURNING a record, no chain at all.
module basics.p_recordret_dot

type Inner { v int }
type Outer { k int }

fn Outer @one() -> Inner => { v: @k + 1 }

fn main() {
    ro o = Outer { k: 4 }
    println("v = ${o.one().v}")
}
