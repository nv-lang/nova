// The SAME `mut` method through a PARENTHESISED bare `@` receiver.
module basics.p_paren_recv_at

type Counter { mut n int }

fn Counter mut @bump() -> () {
    @n = @n + 1
}

fn Counter mut @via() -> () {
    (@).bump()
}

fn main() {
    mut c = Counter { n: 0 }
    c.via()
    println("n = ${c.n}")
}
