// CONFOUND REMOVED, other half: the `@` call sits in a match used as a
// BINDING INITIALIZER -- the position the dotted twin's match occupied.
module basics.p_armcall_at2

type Counter { mut n int }

fn Counter @tag() -> int => @n + 7

fn Counter @via(k int) -> int {
    ro r = match k {
        1 => @tag()
        _ => 0
    }
    r
}

fn main() {
    mut c = Counter { n: 1 }
    println("arm = ${c.via(1)}")
}
