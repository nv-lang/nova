// The SAME field receiver written as `@l` inside a `mut` method.
module basics.p_field_recv_at

type Leaf { mut m int }
type Tree { mut l Leaf }

fn Leaf mut @bump() -> () {
    @m = @m + 1
}

fn Tree mut @via() -> () {
    @l.bump()
}

fn main() {
    mut t = Tree { l: Leaf { m: 0 } }
    t.via()
    println("m = ${t.l.m}")
}
