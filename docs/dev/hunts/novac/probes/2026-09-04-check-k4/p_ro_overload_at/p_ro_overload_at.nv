// SPDX-License-Identifier: MIT OR Apache-2.0
// INVERSE PROBE, the other half: the same overload pair asked through `@`
// from a `ro` method body -- the receiver's mode is `ro` on both paths, so
// no disagreement is expected here.
module basics.p_ro_overload_at

type Counter { mut n int }

fn Counter @tag() -> int => 1

fn Counter mut @tag() -> int => 2

fn Counter @via() -> int => @tag()

fn main() {
    ro c = Counter { n: 0 }
    println("tag = ${c.via()}")
}
