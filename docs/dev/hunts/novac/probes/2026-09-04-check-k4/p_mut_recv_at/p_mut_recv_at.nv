// The SAME `mut` method reached through the `@` form from inside another
// `mut` method: the receiver is implicit and the binding is `mut`.
module basics.p_mut_recv_at

type Counter { mut n int }

fn Counter mut @bump() -> () {
    @n = @n + 1
}

fn Counter mut @twice() -> () {
    @bump()
    @bump()
}

fn main() {
    mut c = Counter { n: 0 }
    c.twice()
    println("n = ${c.n}")
}
