// A `mut` method whose receiver is a FIELD, written dotted from outside.
module basics.p_field_recv_dot

type Leaf { mut m int }
type Tree { mut l Leaf }

fn Leaf mut @bump() -> () {
    @m = @m + 1
}

fn main() {
    mut t = Tree { l: Leaf { m: 0 } }
    t.l.bump()
    println("m = ${t.l.m}")
}
