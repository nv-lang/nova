// The SAME `consume` method reached through `@` from a BORROWING method.
// The oracle refuses this by name (E_BORROWING_METHOD_CONSUMES_SELF).
module basics.p_consume_at

type Counter { n int }

fn Counter consume @eat() -> int => @n + 3

fn Counter @via() -> int => @eat()

fn main() {
    ro c = Counter { n: 10 }
    println("eaten = ${c.via()}")
}
