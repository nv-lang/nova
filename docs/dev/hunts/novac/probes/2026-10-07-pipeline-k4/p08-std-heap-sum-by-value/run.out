=== PROGRAM
--- ./main.nv
     1	module p08_std_heap_sum_by_value.main
     2	
     3	// NOVAC_PROGRAM
     4	// std's payload-free Align, CharError and RangeError are heap sums in the
     5	// shell; this program holds none in an application -- by value only.
     6	
     7	import std.runtime.fmt_buf.{Align}
     8	
     9	fn align_name(a Align) -> str => match a {
    10	    Left => "left"
    11	    Right => "right"
    12	    Center => "center"
    13	}
    14	
    15	fn main() {
    16	    ro a = Align.Center
    17	    println(align_name(a))
    18	    ro c = CharError.Invalid
    19	    match c {
    20	        AboveMax => println("above")
    21	        BelowMin => println("below")
    22	        Invalid => println("invalid")
    23	    }
    24	    ro r = RangeError.BelowMin
    25	    match r {
    26	        AboveMax => println("above")
    27	        BelowMin => println("below")
    28	    }
    29	}
