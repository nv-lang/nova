=== PROGRAM
--- ./bag/bag.nv
     1	module p02_std_sum_fenced_elsewhere.bag
     2	
     3	import std.fs.{PathStyle}
     4	
     5	/// Both styles, in a vector -- the fence.
     6	export fn styles() -> []PathStyle {
     7	    mut xs = []PathStyle.new()
     8	    xs.push(PathStyle.Posix)
     9	    xs.push(PathStyle.Windows)
    10	    xs
    11	}
--- ./main.nv
     1	module p02_std_sum_fenced_elsewhere.main
     2	
     3	// NOVAC_PROGRAM
     4	// The entry uses std's PathStyle by value only; module `bag` fences it.
     5	
     6	import std.fs.{PathStyle}
     7	import ./bag.{styles}
     8	
     9	fn main() {
    10	    ro s = PathStyle.Windows
    11	    match s {
    12	        Posix => println("posix")
    13	        Windows => println("windows")
    14	    }
    15	    println(styles().len())
    16	}
