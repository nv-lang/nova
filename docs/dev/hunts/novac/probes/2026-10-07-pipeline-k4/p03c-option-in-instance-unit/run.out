=== PROGRAM
--- ./main.nv
     1	module p03c_option_in_instance_unit.main
     2	
     3	// `Option[Color]` stands only inside the body of `pick[Color]`, an instance.
     4	// Unit mode -- no program root.
     5	
     6	/// A colour: no variant carries a payload.
     7	type Color enum
     8	    | Red
     9	    | Green
    10	    | Blue
    11	
    12	fn color_name(c Color) -> str => match c {
    13	    Red => "red"
    14	    Green => "green"
    15	    Blue => "blue"
    16	}
    17	
    18	/// `a` when `first`, else `b` -- through an option only the instance holds.
    19	fn pick[T](a T, b T, first bool) -> T {
    20	    ro o = if first { Some(a) } else { None }
    21	    match o {
    22	        Some(x) => x
    23	        None => b
    24	    }
    25	}
    26	
    27	fn main() {
    28	    println(color_name(pick[Color](Color.Green, Color.Blue, true)))
    29	    println(color_name(pick[Color](Color.Green, Color.Blue, false)))
    30	}
