=== PROGRAM
--- ./main.nv
     1	module p06_tuple_fence.main
     2	
     3	// NOVAC_PROGRAM
     4	// `Color` stands only as a tuple component in module `tup`.
     5	
     6	import ./pal.{Color, color_name, next_color}
     7	import ./tup.{tagged}
     8	
     9	fn main() {
    10	    println(color_name(next_color(Color.Green)))
    11	    ro (c, k) = tagged(3)
    12	    println("${color_name(c)} ${k}")
    13	}
--- ./pal/pal.nv
     1	module p06_tuple_fence.pal
     2	
     3	// The owner of a payload-free sum. It uses `Color` by value only: alone, this
     4	// unit would lay it out as NovaValue_Color.
     5	
     6	/// A colour: no variant carries a payload.
     7	#impl(Equal)
     8	export type Color enum
     9	    | Red
    10	    | Green
    11	    | Blue
    12	
    13	/// The colour's name -- a match in the owner.
    14	export fn color_name(c Color) -> str => match c {
    15	    Red => "red"
    16	    Green => "green"
    17	    Blue => "blue"
    18	}
    19	
    20	/// The next colour round the wheel -- `==` in the owner.
    21	export fn next_color(c Color) -> Color {
    22	    if c == Color.Red { return Color.Green }
    23	    if c == Color.Green { return Color.Blue }
    24	    Color.Red
    25	}
--- ./tup/tup.nv
     1	module p06_tuple_fence.tup
     2	
     3	import ../pal.{Color}
     4	
     5	/// A colour with its code.
     6	export fn tagged(k int) -> (Color, int) => (Color.Blue, k)
