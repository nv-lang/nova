// A captured `mut` record used only as the RECEIVER of a mutating method
// inside a handler literal's op body -- no other read of the name.
type Ctr { n int }

fn Ctr mut @bump() -> () {
    @n = @n + 1
}

fn main() {
    mut c = Ctr { n: 0 }
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            c.bump()
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
        ResourceTrace.on_resource_enter("b")
    }
    println(c.n)
}
