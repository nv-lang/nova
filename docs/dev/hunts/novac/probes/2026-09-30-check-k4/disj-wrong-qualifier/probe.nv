// A disjunction alternative QUALIFIED by another sum that declares the same
// variant name. The single-head door compares the qualifier with the matched
// sum; the disjunction door reads the head only.
type Sh enum
    | A
    | B

type Other enum
    | A
    | B

fn pick(s Sh) -> int {
    match s {
        Other.A | Other.B => 1
    }
}

fn main() {
    println(pick(Sh.B))
}
