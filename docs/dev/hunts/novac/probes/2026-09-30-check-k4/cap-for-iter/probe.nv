// A captured slice iterated by `for` and a captured `mut` total inside an op body.
fn main() {
    mut total = 0
    ro xs = []int.of(1, 2, 3)
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            for x in xs {
                total += x
            }
            for i in 0..xs.len() {
                total += i
            }
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
    println(total)
}
