// A handler literal with a `mut` capture as the TAIL of a function that
// returns it: the literal outlives the frame its capture points into. The
// held form (`ro q = effect ...`) is refused for exactly this; the tail form
// is another spelling of the same escape.
fn make() -> Effect[Random] {
    mut seen = 0
    effect Random {
        u64() -> u64 {
            seen += 1
            7
        }
    }
}

fn main() {
    ro h = make()
    with Random = h {
        println(Random.u64())
    }
}
