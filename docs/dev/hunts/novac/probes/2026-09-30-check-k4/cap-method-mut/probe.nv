// A mutating method on a captured `mut` slice inside an op body.
fn main() {
    mut xs = []int.new()
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            xs.push(label.len())
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("ab")
        ResourceTrace.on_resource_enter("abc")
    }
    println(xs.len())
}
