// `if Some(true) = o`: a bool literal NESTED in a condition's pattern. D486 s4
// (amendment 2026-09-30 p.1) refuses a literal at any depth of a condition;
// the pattern-shape door reads `true` as a binder name.
fn main() {
    ro o = Some(false)
    if Some(true) = o {
        println("matched")
    } else {
        println("no")
    }
}
