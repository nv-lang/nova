// Inside an op body, a `with` over a HELD literal (no captures of its own)
// whose BODY reads and writes the outer literal's capture.
fn main() {
    mut seen = 0
    ro quiet = effect Random {
        u64() -> u64 => 7
    }
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            with Random = quiet {
                seen += 1
                println(label, " ", seen, " ", Random.u64())
            }
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
        ResourceTrace.on_resource_enter("b")
    }
    println(seen)
}
