// A capture as a match scrutinee and in an arm guard inside an op body.
fn main() {
    mut seen = 0
    ro base = 1
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            match seen {
                0 => println(label, " zero")
                n if n > base => println(label, " many")
                _ => println(label, " one")
            }
            seen += 1
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
        ResourceTrace.on_resource_enter("b")
        ResourceTrace.on_resource_enter("c")
    }
    println(seen)
}
