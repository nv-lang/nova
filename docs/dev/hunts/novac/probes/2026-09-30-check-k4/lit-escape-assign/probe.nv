// A handler literal with a `mut` capture ASSIGNED to an existing `mut`
// handler binding -- the held form, spelled as an assignment.
fn main() {
    mut seen = 0
    mut q = effect Random {
        u64() -> u64 => 1
    }
    q = effect Random {
        u64() -> u64 {
            seen += 1
            7
        }
    }
    with Random = q {
        println(Random.u64())
    }
    println(seen)
}
