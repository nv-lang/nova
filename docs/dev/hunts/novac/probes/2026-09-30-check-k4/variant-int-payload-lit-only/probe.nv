// A literal nested in a variant's payload and NO catch-all for that variant:
// A(5) is not covered. The coverage rule counts the head A as covered.
type Sh enum
    | A(int)
    | B

fn pick(s Sh) -> int {
    match s {
        A(3) => 1
        B => 0
    }
}

fn main() Io -> () {
    println("${pick(A(5))}")
}
