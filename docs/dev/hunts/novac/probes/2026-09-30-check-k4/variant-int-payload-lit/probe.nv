// A literal nested in a variant's payload: the arm matches only A(3), a
// catch-all for A follows. The coverage rule counts heads; the arm test is
// built from the head alone.
type Sh enum
    | A(int)
    | B

fn pick(s Sh) -> int {
    match s {
        A(3) => 1
        A(_) => 2
        B => 0
    }
}

fn main() Io -> () {
    println("${pick(A(5))}")
}
