// A handler literal whose op body reads a PARAMETER of the building function
// and writes its `mut` parameter-bound local.
fn trace(base int) -> int {
    mut seen = base
    with ResourceTrace = effect ResourceTrace {
        on_resource_enter(label str) -> () {
            seen += base
            println(label, " ", seen)
        }
        on_resource_exit(label str, outcome ScopeOutcome, duration_ms int, overrun bool) -> () {
            println(label)
        }
    } {
        ResourceTrace.on_resource_enter("a")
    }
    seen
}

fn main() {
    println(trace(5))
}
