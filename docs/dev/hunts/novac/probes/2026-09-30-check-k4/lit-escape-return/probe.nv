// A handler literal with a `mut` capture under `return`: the same escape as
// the held form, spelled as a return statement.
fn make() -> Effect[Random] {
    mut seen = 0
    return effect Random {
        u64() -> u64 {
            seen += 1
            7
        }
    }
}

fn main() {
    with Random = make() {
        println(Random.u64())
    }
}
