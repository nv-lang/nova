// `true` nested in a variant's payload: the payload binder door reads it as
// a name, the coverage rule counts the head A as covered.
type Sh enum
    | A(bool)
    | B

fn pick(s Sh) -> int {
    match s {
        A(true) => 1
        B => 0
    }
}

fn main() Io -> () {
    println("${pick(A(false))}")
}
