
fn dump(title str, ps []str, ts []str) Io -> () {
    ro u = unit_of(ps, ts)
    println("---- ", title)
    println("[[UNIT TEXT BEGIN]]")
    println(u.text)
    println("[[UNIT TEXT END]] runs=", u.files.len())
    for k in 0..u.files.len() {
        println("  run ", k, " path=", u.files[k].path, " at=", u.files[k].at, " from=", u.files[k].from)
    }
}

fn two(a str, b str) -> []str {
    mut v = []str.new()
    v.push(a)
    v.push(b)
    v
}

fn main() Io -> () {
    ro ps = two("a.nv", "b.nv")
    ro sp = two("b.nv", "a.nv")

    // SUBJECT 1: the ordinary shape of the wave -- two peers of one module,
    // each with its own module line. What does the unit look like?
    ro t1 = two("module m\nfn one() -> int {\n    ro v = two()\n    v\n}\n",
                "module m\nfn two() -> int => 2\n")
    dump("S1 two ordinary peers", ps, t1)

    // SUBJECT 2: the FIRST file has no module line (a fragment). Every other
    // file's module line is taken from byte `module_line_end` onward, so it
    // is never copied -- the unit ends up with NO module declaration at all.
    ro t2 = two("fn one() -> int => 1\n",
                "module m\nfn two() -> int => 2\n")
    dump("S2 first file has no module line", ps, t2)

    // CONTROL for S2: the SAME two files in the other order. If the module
    // line survives here, the loss above is caused by the order alone.
    ro t2r = two("module m\nfn two() -> int => 2\n",
                 "fn one() -> int => 1\n")
    dump("S2-control same two files, swapped", sp, t2r)

    // SUBJECT 3: two peers declaring DIFFERENT modules. The second
    // declaration is dropped without a word.
    ro t3 = two("module m\nfn one() -> int => 1\n",
                "module other.name\nfn two() -> int => 2\n")
    dump("S3 peers declaring different modules", ps, t3)

    // CONTROL for S3: the second file ALONE -- its module line is there, so
    // the loss above is the unit's doing and not the file's.
    mut solo_p = []str.new()
    solo_p.push("b.nv")
    mut solo_t = []str.new()
    solo_t.push("module other.name\nfn two() -> int => 2\n")
    dump("S3-control second file alone", solo_p, solo_t)
}
