=== PROGRAM
     1	fn get(n int) -> Result[int, int] => if n > 0 { Ok(n) } else { Err(-n) }
     2	
     3	fn pass[E](r Result[int, E]) -> Result[int, E] {
     4	    ro v = r?
     5	    Ok(v + 1)
     6	}
     7	
     8	fn main() {
     9	    match pass(get(3)) {
    10	        Ok(v) => println("ok ${v}")
    11	        Err(e) => println("err ${e}")
    12	    }
    13	    match pass(get(-3)) {
    14	        Ok(v) => println("ok ${v}")
    15	        Err(e) => println("err ${e}")
    16	    }
    17	}
