=== PROGRAM
     1	fn get(n int) -> Result[int, int] => if n > 0 { Ok(n) } else { Err(-n) }
     2	
     3	fn work(n int) -> Result[int, int] {
     4	    supervised {
     5	        spawn {
     6	            ro v = get(n)?
     7	            println("in spawn ${v}")
     8	        }
     9	    }
    10	    Ok(n)
    11	}
    12	
    13	fn main() {
    14	    match work(3) {
    15	        Ok(v) => println("ok ${v}")
    16	        Err(e) => println("err ${e}")
    17	    }
    18	    match work(-3) {
    19	        Ok(v) => println("ok ${v}")
    20	        Err(e) => println("err ${e}")
    21	    }
    22	}
=== ORACLE: nova check prog.nv
oracle check rc=0
