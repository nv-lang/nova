--- Carina's C, the body of main
static nova_unit nova_fn_main_impl(void) {
    nova_print_int(novac_fn_both__nova_bool__to_nova_int(true));
    nova_print_newline();
    nova_print_end();
    nova_print_int(novac_fn_both__nova_bool__to_nova_int(false));
    nova_print_newline();
    nova_print_end();
    nova_print_int(novac_fn_mixed__nova_bool__to_nova_int(true));
    nova_print_newline();
    nova_print_end();
    nova_print_int(novac_fn_mixed__nova_bool__to_nova_int(false));
    nova_print_newline();
    nova_print_end();
    return NOVA_UNIT;
}
