module probe.p

import std.time.duration

type Pt value {
    ro x int
}

fn mk(x int) -> Pt {
    Pt { x: x }
}

// a BLOCK-bodied handler whose tail is a value record; the value form reads it
fn val_form() -> Pt {
    supervised(timeout: 30.to_seconds(), on_timeout: |e| {
        ro late = if e.deadline_ns > 0 { 1 } else { 2 }
        mk(0 - late)
    }) {
        mk(7)
    }
}

// statement position: the body's str value AND the handler's str result are
// both DISCARDED; the ABI cast must still name nova_str (the r2 row's shape)
fn stmt_form() -> () {
    supervised(timeout: 30.to_seconds(), on_timeout: |_e| "late") {
        spawn { 1.to_millis().sleep() }
        "done"
    }
}

fn main() Io -> () {
    println(val_form().x)
    stmt_form()
}
