module probe.p

import std.time.duration
import std.os.{args, real_os}

// a `return` value crossing a LIVE with-restore
fn with_ret() -> int {
    with Os = real_os() {
        return args().len()
    }
}

// a `return` value crossing a bare supervised join (statement form)
fn sup_ret(n int) -> int {
    supervised {
        spawn { 1.to_millis().sleep() }
        if n > 3 {
            return n
        } else {
            0
        }
    }
    n + 1
}

// break/continue leaving a loop whose body opened a bare supervised scope
fn loop_break() -> int {
    mut total = 0
    mut i = 0
    while i < 4 {
        supervised {
            spawn { 1.to_millis().sleep() }
            if i == 2 {
                break
            } else {
                total += i
            }
        }
        i += 1
    }
    total
}

fn main() Io -> () {
    println(with_ret())
    println(sup_ret(9))
    println(loop_break())
}
