module probe.p

// cmd: bash docs/dev/hunts/novac/probes/2026-11-14-emit_c-k3/split-exit-scopejoin/cmd.sh <root>
//
// K3 probe (emit_c x K3, 2026-11-14): a FUNCTION EXIT from inside a supervised
// VALUE body, spelled `X ?? return v` (D86) -- check accepts it (the split
// refusal names only RetStmt and LoopCtl), the lowering routes it through
// @ret_via -> @leave_all_scopes -> Stmt.ScopeJoin(u), and the ScopeJoin
// printer spells the BARE form's protocol names (_novac_qdl<u>,
// _novac_qprev<u>) -- identifiers the VALUE form never declares (it declares
// _novac_sedl<u>, _novac_sqprev<u>): use of undeclared identifier, CC-FAIL.
// The oracle builds the same file and prints 7 (measured 2026-11-14).

import std.time.duration

fn maybe_int() -> Option[int] => Some(1)

fn f() -> int {
    supervised(timeout: 30.to_seconds(), on_timeout: |_e| -1) {
        ro o = maybe_int()
        o ?? return 0
        7
    }
}

fn main() Io -> () {
    println(f())
}
