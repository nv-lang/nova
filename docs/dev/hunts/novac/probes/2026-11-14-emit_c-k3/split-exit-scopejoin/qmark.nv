module probe.p

// cmd: bash docs/dev/hunts/novac/probes/2026-11-14-emit_c-k3/split-exit-scopejoin/cmd.sh <root>
//
// The SAME property, second syntax: `x?` (D85) in a non-tail statement of the
// body of a supervised VALUE in an Option-returning fn -- the exit crosses the
// split boundary exactly as `?? return` does, is not refused by name either,
// and emits the same undeclared _novac_qdl<u>/_novac_qprev<u>. The oracle
// builds the same file and prints 7 (measured 2026-11-14).

import std.time.duration

fn maybe_int() -> Option[int] => Some(1)

fn g() -> Option[int] {
    supervised(timeout: 30.to_seconds(), on_timeout: |_e| None) {
        ro o = maybe_int()
        o?
        Some(7)
    }
}

fn main() Io -> () {
    match g() {
        Some(v) => println(v)
        None => println("none")
    }
}
