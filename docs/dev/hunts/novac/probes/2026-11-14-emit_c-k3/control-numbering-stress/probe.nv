module probe.p

import std.time.duration

fn stress() -> int {
    ro a = supervised(timeout: 30.to_seconds(), on_timeout: |_e| -1) {
        supervised { spawn { 1.to_millis().sleep() } }
        1
    }
    supervised { spawn { 1.to_millis().sleep() } }
    ro b = supervised(timeout: 30.to_seconds(), on_timeout: |_e| -2) {
        2
    }
    supervised(timeout: 10.to_seconds()) { spawn { 1.to_millis().sleep() } }
    a + b
}

fn loopy() -> int {
    mut total = 0
    mut i = 0
    while i < 2 {
        ro v = supervised(timeout: 30.to_seconds(), on_timeout: |_e| -3) { i }
        total += v
        i += 1
    }
    total
}

fn main() Io -> () {
    println(stress())
    println(loopy())
}
