module p
// Четвёртый синтаксис того же свойства (греп по `=` рядом с именем его не
// находит): запись в ПОЛЕ через `ro`-привязку. Оракул зовёт это
// E_READONLY_FIELD и прямо говорит, что привязка главнее пометки поля.
type Pt value { n int }
fn main() {
    ro b = Pt { n: 1 }
    b.n = 2
    println(b.n)
}
