=== PROGRAM
     1	module prog
     2	
     3	// A `match` (and, as the control of the same property, an `if`) as an
     4	// argument of a call that is ITSELF an argument of another call, the outer
     5	// call standing as an initializer. Legal Nova; the oracle prints 3 and 3.
     6	// Pure arms and constant scrutinees: no effect to order. Further carriers of
     7	// the same ICE, one per program (see the report): `println(three(1, match k
     8	// {..}, 1) * 2)`, `ro r = three(1, match k {..}, 1) * 2`,
     9	// `println(id(match k {..}) + 1)`.
    10	fn three(a int, b int, c int) -> int => a + b + c
    11	
    12	fn id(x int) -> int => x
    13	
    14	fn main() {
    15	    ro k = 2
    16	    ro r1 = id(three(1, match k {
    17	        2 => 1
    18	        _ => 0
    19	    }, 1))
    20	    println(r1)
    21	    ro r2 = id(three(1, if k > 0 { 1 } else { 0 }, 1))
    22	    println(r2)
    23	}
