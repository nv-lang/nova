=== PROGRAM
     1	module prog
     2	
     3	// A `match` value as a NAMED argument (D102: `f(by: 2)` is how a defaulted
     4	// parameter is reached). The refusal's own text lists "an argument" among
     5	// the compiled positions. Legal Nova; the oracle prints 42 and 43.
     6	fn step(a int, by int = 1) -> int => a + by
     7	
     8	fn main() {
     9	    ro k = 3
    10	    println(step(2, by: match k {
    11	        3 => 40
    12	        _ => 0
    13	    }))
    14	    ro r = step(3, by: if k > 0 { 40 } else { 0 })
    15	    println(r)
    16	}
