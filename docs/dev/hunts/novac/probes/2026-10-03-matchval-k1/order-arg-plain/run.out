=== PROGRAM
     1	module prog
     2	
     3	// D484 control: call arguments are evaluated left to right, observably --
     4	// no `match`, no `if`: three plain calls as the three arguments.
     5	fn say(n int) -> int {
     6	    println(n)
     7	    n
     8	}
     9	
    10	fn three(a int, b int, c int) -> int => a * 100 + b * 10 + c
    11	
    12	type Box { n int }
    13	
    14	fn Box @add3(a int, b int, c int) -> int => @n + a + b + c
    15	
    16	fn main() {
    17	    println("plain call, norm 1 2 3 then 123")
    18	    println(three(say(1), say(2), say(3)))
    19	    println("method call, norm 4 5 6 then 15")
    20	    ro b = Box { n: 0 }
    21	    println(b.add3(say(4), say(5), say(6)))
    22	    println("two-arg, norm 7 8 then 78")
    23	    println(three(0, say(7), say(8)))
    24	}
