=== PROGRAM
     1	module prog
     2	
     3	// D489: a literal takes the type of its position when its value fits; a
     4	// declared local type is such a position (`ro x T = e`), and the `match`
     5	// value's arms take the type their neighbour value has. Each print is
     6	// labelled with the norm.
     7	fn found(k int) -> Option[int] {
     8	    if k > 0 { Some(k) } else { None }
     9	}
    10	
    11	fn take8(x u8) -> int => x as int
    12	
    13	fn main() {
    14	    ro k = 3
    15	    ro a u8 = 200 as u8
    16	    println("a u8 = 200, (a + 55) as int, norm 255")
    17	    println((a + 55) as int)
    18	    ro b i16 = -300 as i16
    19	    println("b i16 = -300, norm -300")
    20	    println(b as int)
    21	    ro o Option[int] = found(k)
    22	    println("o Option[int] = found(3), norm 3")
    23	    println(o ?? 0)
    24	    ro f f64 = 3 as f64
    25	    println("f f64 = 3, f / 2.0, norm 1.5")
    26	    println(f / 2.0)
    27	    ro w u8 = a
    28	    println("w u8 = a, norm 200")
    29	    println(w as int)
    30	    println("take8(match: a or 7), norm 200")
    31	    println(take8(match k {
    32	        3 => a
    33	        _ => 7 as u8
    34	    }))
    35	    println("take8(match Some(v) => a, None => 255), norm 255")
    36	    println(take8(match found(0) {
    37	        Some(v) => a
    38	        None => 255 as u8
    39	    }))
    40	    ro e = match k {
    41	        3 => a
    42	        _ => 0 as u8
    43	    }
    44	    println("e = match a or 0, (e + 55) as int, norm 255")
    45	    println((e + 55) as int)
    46	    ro g u8 = match k {
    47	        3 => a
    48	        _ => w
    49	    }
    50	    println("g u8 = match a or w, norm 200")
    51	    println(g as int)
    52	}
