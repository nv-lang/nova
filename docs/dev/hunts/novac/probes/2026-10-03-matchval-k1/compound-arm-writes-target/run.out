=== PROGRAM
     1	module prog
     2	
     3	// `x += match ..` whose taken arm WRITES `x` before yielding its value. Which
     4	// `x` the compound reads (before or after the arm ran) is a measurement here,
     5	// not a norm (no D-block found that fixes the order of a compound store's
     6	// read against its right side); the two compilers are compared.
     7	fn main() {
     8	    ro k = 3
     9	    mut x = 1
    10	    x += match k {
    11	        3 => {
    12	            x = 100
    13	            1
    14	        }
    15	        _ => 0
    16	    }
    17	    println(x)
    18	    mut ys = [1, 2]
    19	    ys[0] += match k {
    20	        3 => {
    21	            ys[0] = 50
    22	            1
    23	        }
    24	        _ => 0
    25	    }
    26	    println(ys[0])
    27	}
