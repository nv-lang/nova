=== PROGRAM
     1	module prog
     2	
     3	// Effects around a `match` value in the positions D484 does NOT name (its
     4	// section 5: "a constructor and a record literal are not decided by this
     5	// block"): an array element, a constructor field, the right of `+=` with an
     6	// effectful index, a nested `match` as scrutinee. Measured against the
     7	// oracle; the count of each `say` line is what matters first -- every
     8	// expression is evaluated exactly once whatever the order.
     9	fn say(n int) -> int {
    10	    println(n)
    11	    n
    12	}
    13	
    14	type Trio { a int, b int, c int }
    15	
    16	fn main() {
    17	    println("array element: each of 1 2 3 once")
    18	    ro xs = [say(1), match say(2) {
    19	        2 => 2
    20	        _ => 0
    21	    }, say(3)]
    22	    println(xs[0] * 100 + xs[1] * 10 + xs[2])
    23	    println("ctor field: each of 4 5 6 once")
    24	    ro t = Trio { a: say(4), b: match say(5) {
    25	        5 => 5
    26	        _ => 0
    27	    }, c: say(6) }
    28	    println(t.a * 100 + t.b * 10 + t.c)
    29	    println("+= with effectful index: each of 0 and 7 once, ys[0] 8")
    30	    mut ys = [1, 2, 3]
    31	    ys[say(0)] += match say(7) {
    32	        7 => 7
    33	        _ => 0
    34	    }
    35	    println(ys[0])
    36	    println("nested scrutinee: 9 once, then 1")
    37	    ro r = match match say(9) {
    38	        9 => 1
    39	        _ => 2
    40	    } {
    41	        1 => 1
    42	        _ => 0
    43	    }
    44	    println(r)
    45	}
