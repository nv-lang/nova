=== PROGRAM
     1	module prog
     2	
     3	// "A value form laid down twice" without a call around it: the form stands
     4	// as the SCRUTINEE of a `match` or as an ELEMENT of an array literal. One
     5	// `say` per form, so each number must print exactly once. The `match`
     6	// scrutinee is the sweep-9 form (its fixture's scrutinee calls nothing, so
     7	// the second evaluation is invisible there); `if` and `??` are the same
     8	// property in other syntaxes.
     9	fn say(n int) -> int {
    10	    println(n)
    11	    n
    12	}
    13	
    14	fn sayo(n int) -> Option[int] {
    15	    println(n)
    16	    Some(n)
    17	}
    18	
    19	fn main() {
    20	    println("match scrutinee is a match: 1 once, then 10")
    21	    ro r1 = match match say(1) {
    22	        1 => 1
    23	        _ => 2
    24	    } {
    25	        1 => 10
    26	        _ => 0
    27	    }
    28	    println(r1)
    29	    println("match scrutinee is an if: 2 once, then 20")
    30	    ro r2 = match if say(2) > 0 { 1 } else { 2 } {
    31	        1 => 20
    32	        _ => 0
    33	    }
    34	    println(r2)
    35	    println("match scrutinee is a coalesce: 3 once, then 30")
    36	    ro r3 = match sayo(3) ?? 0 {
    37	        3 => 30
    38	        _ => 0
    39	    }
    40	    println(r3)
    41	    println("statement match on a match: 4 once, then 40")
    42	    match match say(4) {
    43	        4 => 1
    44	        _ => 2
    45	    } {
    46	        1 => println(40)
    47	        _ => println(0)
    48	    }
    49	    println("array element is a match, alone: 5 once, then 5")
    50	    ro xs = [match say(5) {
    51	        5 => 5
    52	        _ => 0
    53	    }]
    54	    println(xs[0])
    55	    println("array element is an if, alone: 6 once, then 6")
    56	    ro ys = [if say(6) > 0 { 6 } else { 0 }]
    57	    println(ys[0])
    58	}
