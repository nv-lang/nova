=== PROGRAM
     1	module prog
     2	
     3	// D484: call arguments are evaluated left to right, observably.
     4	// The middle argument is a `match` whose scrutinee and arm have effects.
     5	fn say(n int) -> int {
     6	    println(n)
     7	    n
     8	}
     9	
    10	fn three(a int, b int, c int) -> int => a * 100 + b * 10 + c
    11	
    12	fn main() {
    13	    println("case 1, norm 1 2 3 then 123")
    14	    println(three(say(1), match say(2) {
    15	        2 => 2
    16	        _ => 0
    17	    }, say(3)))
    18	    println("case 2, norm 4 5 6 then 456")
    19	    println(three(say(4), match 1 {
    20	        1 => say(5)
    21	        _ => 0
    22	    }, say(6)))
    23	    println("case 3, norm 7 8 9 then 789 (if for control)")
    24	    println(three(say(7), if say(8) > 0 { 8 } else { 0 }, say(9)))
    25	}
