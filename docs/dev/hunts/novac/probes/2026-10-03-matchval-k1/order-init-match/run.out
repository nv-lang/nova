=== PROGRAM
     1	module prog
     2	
     3	// D484: arguments left to right, observably -- the call stands as a binding
     4	// initializer (the `@lower_place` door), a statement (`@lower_eval`), and a
     5	// method argument; the `match` argument calls something in its scrutinee or arm.
     6	fn say(n int) -> int {
     7	    println(n)
     8	    n
     9	}
    10	
    11	fn three(a int, b int, c int) -> int => a * 100 + b * 10 + c
    12	
    13	fn sink(a int, b int, c int) -> () {
    14	    println(a * 100 + b * 10 + c)
    15	}
    16	
    17	type Box { n int }
    18	
    19	fn Box @add3(a int, b int, c int) -> int => @n + a * 100 + b * 10 + c
    20	
    21	fn main() {
    22	    println("init, scrutinee calls: norm 1 2 3 then 123")
    23	    ro r = three(say(1), match say(2) {
    24	        2 => 2
    25	        _ => 0
    26	    }, say(3))
    27	    println(r)
    28	    println("init, arm calls: norm 4 5 6 then 456")
    29	    ro r2 = three(say(4), match r {
    30	        123 => say(5)
    31	        _ => 0
    32	    }, say(6))
    33	    println(r2)
    34	    println("statement: norm 7 8 9 then 789")
    35	    sink(say(7), match say(8) {
    36	        8 => 8
    37	        _ => 0
    38	    }, say(9))
    39	    println("method arg in init: norm 1 2 3 then 123")
    40	    ro b = Box { n: 0 }
    41	    ro r3 = b.add3(say(1), match say(2) {
    42	        2 => 2
    43	        _ => 0
    44	    }, say(3))
    45	    println(r3)
    46	    println("if control in init: norm 4 5 6 then 456")
    47	    ro r4 = three(say(4), if say(5) > 0 { 5 } else { 0 }, say(6))
    48	    println(r4)
    49	}
