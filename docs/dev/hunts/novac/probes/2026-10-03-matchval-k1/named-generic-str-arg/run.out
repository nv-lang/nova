=== PROGRAM
     1	module prog
     2	
     3	// A `match` value as the argument of a call whose
     4	// parameter is GENERIC (the type comes from the match), with `str` and
     5	// record arms, and as a method argument whose receiver is itself a `match`
     6	// value bound first. Pure arms; each print labelled with the norm.
     7	type Tally { n int }
     8	
     9	fn Tally @plus(k int) -> int => @n + k
    10	
    11	fn first[T](a T, b T) -> ro T => a
    12	
    13	fn found(k int) -> Option[int] {
    14	    if k > 0 { Some(k) } else { None }
    15	}
    16	
    17	fn main() {
    18	    ro k = 3
    19	    println("generic T from match arms (str), norm three")
    20	    println(first(match k {
    21	        3 => "three"
    22	        _ => "other"
    23	    }, "x"))
    24	    println("generic T from match arms (record), norm 7")
    25	    ro t = first(match found(k) {
    26	        Some(v) => Tally { n: v + 4 }
    27	        None => Tally { n: 0 }
    28	    }, Tally { n: 9 })
    29	    println(t.n)
    30	    println("method arg with binding arm, receiver from a match, norm 37")
    31	    ro acc = match k {
    32	        3 => Tally { n: 7 }
    33	        _ => Tally { n: 0 }
    34	    }
    35	    println(acc.plus(match found(k) {
    36	        Some(v) => v * 10
    37	        None => 0
    38	    }))
    39	    println("str arm into println directly, norm three")
    40	    println(match k {
    41	        3 => "three"
    42	        _ => "other"
    43	    })
    44	}
