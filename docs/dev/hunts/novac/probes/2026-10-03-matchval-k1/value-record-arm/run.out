=== PROGRAM
     1	module prog
     2	
     3	// A VALUE RECORD (`type Pt value {..}`, D32: a value record is passed and
     4	// bound by copy) as the value of a `match` arm, in each position a `match`
     5	// value takes: an initializer, an argument, an array element, a constructor
     6	// field, the right of `=`. After the copy the source is written to, and the
     7	// copy must keep the OLD number. A reference record (`Rc`) is the control:
     8	// it aliases, so the new number shows through.
     9	type Pt value { n int }
    10	
    11	type Rc { n int }
    12	
    13	type Holder { p Pt }
    14	
    15	fn found(k int) -> Option[int] {
    16	    if k > 0 { Some(k) } else { None }
    17	}
    18	
    19	fn keep(p Pt) -> Pt => p
    20	
    21	fn main() {
    22	    ro k = 3
    23	    mut live = Pt { n: 1 }
    24	    mut other = Pt { n: 2 }
    25	    ro s = match k {
    26	        3 => live
    27	        _ => other
    28	    }
    29	    ro xs = [match found(k) {
    30	        Some(v) => live
    31	        None => other
    32	    }]
    33	    ro h = Holder { p: match k {
    34	        3 => live
    35	        _ => other
    36	    } }
    37	    ro kp = keep(match k {
    38	        3 => live
    39	        _ => other
    40	    })
    41	    mut t = Pt { n: 0 }
    42	    t = match k {
    43	        3 => live
    44	        _ => other
    45	    }
    46	    live.n = 11
    47	    println("init copy, norm 1")
    48	    println(s.n)
    49	    println("element copy, norm 1")
    50	    println(xs[0].n)
    51	    println("field copy, norm 1")
    52	    println(h.p.n)
    53	    println("argument copy, norm 1")
    54	    println(kp.n)
    55	    println("assign copy, norm 1")
    56	    println(t.n)
    57	    mut m = match k {
    58	        3 => other
    59	        _ => live
    60	    }
    61	    m.n = 99
    62	    println("source after writing the mut copy, norm 2")
    63	    println(other.n)
    64	    ro r = Rc { n: 5 }
    65	    ro ra = match k {
    66	        3 => r
    67	        _ => Rc { n: 6 }
    68	    }
    69	    println("reference record aliases (control), norm 5")
    70	    println(ra.n)
    71	}
