=== PROGRAM
     1	module prog
     2	
     3	// A typed binding whose initializer is a `match` with LITERAL arms (task 5 of
     4	// mono-k2: the declared type is held to the initializer's). D489: every arm
     5	// is a position of the written type; a literal that does not fit is
     6	// E_LIT_OUT_OF_RANGE ("no implicit narrowing, truncation or rounding that
     7	// changes the WRITTEN number"). Here 300 and -1 stand in a `u8` arm and 40000
     8	// in an `i16` arm. The norm: no program. Printed value if one is built: the
     9	// truncated number (44, 255, -25536).
    10	fn main() {
    11	    ro k = 3
    12	    ro c u8 = match k {
    13	        3 => 300
    14	        _ => 0
    15	    }
    16	    println(c as int)
    17	    ro e u8 = match k {
    18	        3 => -1
    19	        _ => 0
    20	    }
    21	    println(e as int)
    22	    ro d i16 = match k {
    23	        3 => 40000
    24	        _ => 0
    25	    }
    26	    println(d as int)
    27	}
