=== PROGRAM
     1	module prog
     2	
     3	// D491: "a position with a written type -- a declaration, a call argument, a
     4	// return, a RECORD FIELD, a collection element: the value's type equals the
     5	// position's; otherwise an error, the hint is the form with `as`". Here an
     6	// `int` VALUE (a local, not a literal) is given to a `u8` field and to an
     7	// `f64` field: plainly, through an `if` value and through a `match` value (the
     8	// sweep-9 position). The norm: no program -- the oracle refuses every line.
     9	// Each print is labelled with what a silent conversion would show.
    10	type Pv { b u8, f f64 }
    11	
    12	fn main() {
    13	    ro k = 3
    14	    ro n = 300
    15	    ro q1 = Pv { b: n, f: 2.0 }
    16	    println("plain int 300 into u8 field (no program by norm)")
    17	    println(q1.b as int)
    18	    ro q2 = Pv { b: if k > 0 { n } else { n }, f: 2.0 }
    19	    println("if-value int 300 into u8 field (no program by norm)")
    20	    println(q2.b as int)
    21	    ro q3 = Pv { b: match k {
    22	        3 => n
    23	        _ => n
    24	    }, f: 2.0 }
    25	    println("match-value int 300 into u8 field (no program by norm)")
    26	    println(q3.b as int)
    27	    ro q4 = Pv { b: 1 as u8, f: match k {
    28	        3 => k
    29	        _ => k
    30	    } }
    31	    println("match-value int 3 into f64 field (no program by norm)")
    32	    println(q4.f)
    33	}
