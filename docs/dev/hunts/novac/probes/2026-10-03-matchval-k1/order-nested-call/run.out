=== PROGRAM
     1	module prog
     2	
     3	// D484: arguments left to right, observably -- for a call that is itself an
     4	// ARGUMENT of another call (`println(f(..))`, `ro r = g(f(..))`). Carina's F65
     5	// hoist orders a call standing as a statement or an initializer; here the
     6	// ordered call is one level down. Lines 1-3: no `match` at all.
     7	fn say(n int) -> int {
     8	    println(n)
     9	    n
    10	}
    11	
    12	fn three(a int, b int, c int) -> int => a * 100 + b * 10 + c
    13	
    14	fn id(x int) -> int => x
    15	
    16	fn main() {
    17	    println("control, init: norm 1 2 3 then 123")
    18	    ro r0 = three(say(1), say(2), say(3))
    19	    println(r0)
    20	    println("under println: norm 1 2 3 then 123")
    21	    println(three(say(1), say(2), say(3)))
    22	    println("under id in init: norm 4 5 6 then 456")
    23	    ro r1 = id(three(say(4), say(5), say(6)))
    24	    println(r1)
    25	    println("match arg under println: norm 7 8 9 then 789")
    26	    println(three(say(7), match say(8) {
    27	        8 => 8
    28	        _ => 0
    29	    }, say(9)))
    30	}
