=== PROGRAM
     1	module prog
     2	
     3	// The in-range twin of decl-match-arm-literal-range: literal arms of a
     4	// `match` under a declared local type, every literal fitting. D489: each arm
     5	// takes the written type. The norm: 250, then 255 (c + 5 computed in u8),
     6	// then -1, then 32767.
     7	fn found(k int) -> Option[int] {
     8	    if k > 0 { Some(k) } else { None }
     9	}
    10	
    11	fn main() {
    12	    ro k = 3
    13	    ro c u8 = match k {
    14	        3 => 250
    15	        _ => 0
    16	    }
    17	    println(c as int)
    18	    println((c + 5) as int)
    19	    ro d i16 = match found(k) {
    20	        Some(v) => -1
    21	        None => 7
    22	    }
    23	    println(d as int)
    24	    ro e i16 = match found(0) {
    25	        Some(v) => 1
    26	        None => 32767
    27	    }
    28	    println(e as int)
    29	}
