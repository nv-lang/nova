=== PROGRAM
     1	module prog
     2	
     3	// The same property ("a value form laid down twice") in other syntaxes than
     4	// `match`: an `if` value, a `??`, a `?` -- each as the middle of three
     5	// arguments that all call something, the call standing as an initializer.
     6	// D484: each argument is evaluated once, left to right.
     7	fn say(n int) -> int {
     8	    println(n)
     9	    n
    10	}
    11	
    12	fn sayo(n int) -> Option[int] {
    13	    println(n)
    14	    Some(n)
    15	}
    16	
    17	fn three(a int, b int, c int) -> int => a * 100 + b * 10 + c
    18	
    19	fn tryit() -> Option[int] {
    20	    ro r = three(say(7), sayo(8)?, say(9))
    21	    Some(r)
    22	}
    23	
    24	fn main() {
    25	    println("if value: norm 1 2 3 then 123")
    26	    ro r1 = three(say(1), if say(2) > 0 { 2 } else { 0 }, say(3))
    27	    println(r1)
    28	    println("coalesce: norm 4 5 6 then 456")
    29	    ro r2 = three(say(4), sayo(5) ?? 0, say(6))
    30	    println(r2)
    31	    println("try: norm 7 8 9 then 789")
    32	    println(tryit() ?? 0)
    33	}
