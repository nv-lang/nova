=== PROGRAM
     1	module prog
     2	
     3	// A `match` on the right of `=` / `+=` / `-=` / `*=` whose LEFT is a record
     4	// field or an array element, the arms binding (`Some(v) => v`) and ending in
     5	// blocks. Each line is labelled with the value the norm requires.
     6	type Purse { n int, m int }
     7	
     8	fn found(k int) -> Option[int] {
     9	    if k > 0 { Some(k) } else { None }
    10	}
    11	
    12	fn main() {
    13	    ro k = 3
    14	    mut a = Purse { n: 10, m: 1 }
    15	    a.n += match found(k) {
    16	        Some(v) => v * 100
    17	        None => -1
    18	    }
    19	    println("a.n += some, norm 310")
    20	    println(a.n)
    21	    a.m -= match found(0) {
    22	        Some(v) => v
    23	        None => {
    24	            ro z = 5
    25	            z + 1
    26	        }
    27	    }
    28	    println("a.m -= none-block, norm -5")
    29	    println(a.m)
    30	    mut xs = [1, 2, 3]
    31	    xs[1] += match k {
    32	        3 => 40
    33	        _ => 0
    34	    }
    35	    println("xs[1] += 40, norm 42")
    36	    println(xs[1])
    37	    xs[2] *= match found(k) {
    38	        Some(v) => v
    39	        None => 0
    40	    }
    41	    println("xs[2] *= 3, norm 9")
    42	    println(xs[2])
    43	    xs[0] = match found(k) {
    44	        Some(v) => v + 1000
    45	        None => 0
    46	    }
    47	    println("xs[0] = 1003, norm 1003")
    48	    println(xs[0])
    49	    a.n = match match k {
    50	        3 => found(7)
    51	        _ => found(0)
    52	    } {
    53	        Some(v) => v
    54	        None => 0
    55	    }
    56	    println("a.n = nested scrutinee Some(7), norm 7")
    57	    println(a.n)
    58	    mut i = 0
    59	    xs[i] += match found(i) {
    60	        Some(v) => v
    61	        None => 500
    62	    }
    63	    println("xs[0] += none, norm 1503")
    64	    println(xs[0])
    65	}
