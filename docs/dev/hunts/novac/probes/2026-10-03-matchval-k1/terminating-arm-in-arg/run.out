=== PROGRAM
     1	module prog
     2	
     3	// A `match` value whose arm LEAVES the function (`return`) or the loop
     4	// (`break`/`continue`), standing as an argument, an element and the right of
     5	// `+=`. A leaving arm produces no value: the call / store must not run on
     6	// that path. Each print is labelled with the norm.
     7	fn found(k int) -> Option[int] {
     8	    if k > 0 { Some(k) } else { None }
     9	}
    10	
    11	fn twice(n int) -> int {
    12	    println("twice called")
    13	    n * 2
    14	}
    15	
    16	fn pick(k int) -> int {
    17	    ro r = twice(match found(k) {
    18	        Some(v) => v
    19	        None => return -7
    20	    })
    21	    r + 1
    22	}
    23	
    24	fn main() {
    25	    println("pick(5): twice called, then 11")
    26	    println(pick(5))
    27	    println("pick(0): -7, no call")
    28	    println(pick(0))
    29	    println("loop sum over 3 0 4 with continue on None: 7")
    30	    mut sum = 0
    31	    for k in [3, 0, 4] {
    32	        sum += match found(k) {
    33	            Some(v) => v
    34	            None => continue
    35	        }
    36	    }
    37	    println(sum)
    38	    println("loop stops at 0 with break: 3")
    39	    mut acc = 0
    40	    for k in [3, 0, 4] {
    41	        ro t = twice(match found(k) {
    42	            Some(v) => v
    43	            None => break
    44	        })
    45	        acc = acc + t / 2
    46	    }
    47	    println(acc)
    48	}
