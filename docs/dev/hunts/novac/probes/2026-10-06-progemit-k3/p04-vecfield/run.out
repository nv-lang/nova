--- ./main.nv
     1	module p04_vecfield.main
     2	
     3	// NOVAC_PROGRAM
     4	// Vec over another module's record, held as a FIELD of the entry's own record:
     5	// does the field's typedef (the Vec instance of geo.Pt) match the one the
     6	// entry's own expressions build, one copy in the program?
     7	
     8	import ./geo.{Pt, mk}
     9	
    10	export type Group {
    11	    pts []Pt
    12	}
    13	
    14	fn main() {
    15	    mut xs = []Pt.new()
    16	    xs.push(mk(1, 2))
    17	    xs.push(mk(3, 4))
    18	    ro g = Group { pts: xs }
    19	    println(g.pts.len())
    20	    println(g.pts[0].x)
    21	    println(g.pts[1].y)
    22	}
