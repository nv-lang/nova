// PROBE H4: a match arm has no `=>` between pattern and result.
// D19 (spec/decisions/03-syntax.md:103) and spec/syntax.md:831 both make
// `pattern => result` THE form of an arm.
// site  : novac/src/parse/expr.nv:353 -- @push_if(ak, TokenKind.FatArrow)
// novac : check rc=0, ZERO diagnostics; `novac emit` produces a WORKING match
//         (novac_fn_..._f: `if (_novac_scr_t1 == 0LL) _novac_match_t1 = 1LL;`).
// oracle: rc=1, "error: expected `=>`, got int literal" at 11:7
module match_no_fatarrow

fn f(n int) -> int => match n {
    0 1
    _ 2
}

fn main() {
    println(f(0))
}
