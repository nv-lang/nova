=== PROGRAM
     1	module p
     2	
     3	type Tx consume {
     4	    id int
     5	}
     6	
     7	fn Tx consume @commit() -> () {
     8	    println("commit ${@id}")
     9	}
    10	
    11	fn ok(consume t Tx) -> bool {
    12	    t.commit()
    13	    true
    14	}
    15	
    16	fn eat(consume t Tx) -> int {
    17	    t.commit()
    18	    0
    19	}
    20	
    21	fn mk(n int) -> Option[int] => if n > 0 { Some(n) } else { None }
    22	
    23	fn mkt(n int) -> Option[Tx] => if n > 0 { Some(Tx { id: n }) } else { None }
    24	
    25	fn run(n int) -> () {
    26	    match mkt(n) {
    27	        Some(consume x) => x.commit()
    28	        None => println("none")
    29	    }
    30	}
    31	
    32	fn main() {
    33	    run(1)
    34	    run(0)
    35	}
