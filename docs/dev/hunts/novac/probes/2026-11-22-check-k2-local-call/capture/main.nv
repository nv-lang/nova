module hunt_capture
fn invoke(f fn(int) -> int, x int) -> int => f(x)
fn exercise(f fn(int) -> int, g fn(int) -> int) -> int {
    ro before = invoke(|x| invoke(|y| f(y), x), 2)
    ro f = g
    before + invoke(|x| invoke(|y| f(y), x), 3)
}
fn main() -> () {
    println(exercise(|x| x + 10, |x| x * 100))
}
