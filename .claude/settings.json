{
  "permissions": {
    "allow": [
      "Bash(git -C * log *)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * show *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * rev-list *)",
      "Bash(git -C * ls-remote *)",
      "Bash(git -C * ls-files *)",
      "Bash(git -C * merge-base *)",
      "Bash(git -C * worktree list)",
      "Bash(git -C * branch *)",
      "Bash(git -C * describe *)",
      "Bash(git -C * cat-file *)",
      "Bash(git -C * check-ignore *)",
      "Bash(nova-cli/target/release/nova.exe check *)",
      "Bash(./nova-cli/target/release/nova.exe check *)",
      "Bash(nova-cli/target/release/nova.exe lint *)",
      "Bash(./nova-cli/target/release/nova.exe lint *)",
      "Bash(sed 's/\\\\$$//')"
    ],
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean -fd:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-git.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-shell-nonascii.py\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-memory.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/guard-stop.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/claude-hooks/inject-after-compact.py\""
          }
        ]
      }
    ]
  }
}
