// `unsafe fn` keyword — body implicitly in unsafe context (pointer ops
// without unsafe{} wrap). Callers must `unsafe { ... }` wrap the call.

module typed_pointers.unsafe_fn_keyword

unsafe fn risky_compute(x i64, y i64) -> i64 {
    // Body implicitly unsafe — pointer ops would not require additional
    // unsafe { } wrap here.
    x * y + 100
}

unsafe fn opaque_init() -> i64 {
    42
}

test "unsafe fn — declarable + callable" {
    ro r = unsafe {
        risky_compute(7, 6)
    }
    assert(r == 142)
}

test "unsafe fn — callable from inside unsafe block" {
    ro v = unsafe {
        opaque_init()
    }
    assert(v == 42)
}
