// Typed pointer family basic example.
//
// Pointer TYPE carries pointee-mutability only, written POSTFIX (after `*`):
//   *T          — pointer to readonly T (canonical; `*T ≡ *ro T` universally)
//   *mut T      — pointer to mutable T (deref-store allowed; the only opt-in)
//   *uninit T   — pointer to possibly-uninit T (MaybeUninit semantic)
// An explicit `*ro T` is a hard error E_REDUNDANT_POINTER_RO — the bare `*T`
// already IS the ro-pointee canon.
//
// Reassignability of the pointer variable itself is binding, not type:
// `let p` = fixed, `mut p` = reassignable — exactly like any other variable.
// There is no `mut *` / `ro *` prefix.
//
// Nullable pointers use `Option[*T]` (NPO: None = null, 8 bytes). FFI
// nullable-uninit uses `Option[*uninit T]`.

module typed_pointers.basic_pointer

type Buffer {
    ro length i64
    ro capacity i64
}

// Readonly pointer parameters (default).
extern "nova" fn read_buffer(buf * Buffer) -> i64

// Pointer to mutable Buffer for FFI out-params (pointee-mut postfix).
extern "nova" fn fill_buffer(buf *mut Buffer, value i64) -> i64

// Possibly-null pointer (e.g. after arithmetic): nullable via Option[*T].
extern "nova" fn buffer_at_offset(buf Option[*Buffer], idx i64) -> i64

// Returning typed pointer.
extern "nova" fn allocate_buffer(size i64) -> * Buffer

// ─── FFI / nullable / uninit patterns ───────────────────────────────────
//
// FFI borrow pattern: a possibly-null handle to a valid Buffer. The C
// `Buffer*` (nullable) maps to `Option[*Buffer]` — None = null, Some = a
// non-null pointer whose pointee is a regular (safe) Buffer.
extern "nova" fn ffi_borrow_buffer(handle Option[*Buffer]) -> i64

// Readonly view pattern: pointer to a readonly Buffer. The bare `*Buffer` IS
// the readonly-pointee canon (`*T ≡ *ro T`; an explicit `*ro Buffer` is a
// hard error E_REDUNDANT_POINTER_RO). The pointer variable's reassignability
// is the bind site's concern (`ro`/`mut` name), not the type.
extern "nova" fn observe_readonly_view(view *Buffer) -> i64

// Opaque-handle pattern: pointer to possibly-uninit storage — `*uninit
// Buffer` is a valid (non-null) pointer whose pointee may be uninitialized
// (e.g. raw allocator output before init). Validity of the pointee is
// asserted on deref inside `unsafe { }`.
extern "nova" fn raw_alloc_slot(slot *uninit Buffer) -> ()

test "typed pointer family — declarations parse + type-check" {
    // Pointer creation (&) + deref (*) + auto-deref require unsafe context.
    // Declarations alone exercise parser + type-checker.
    assert(1 == 1)
}

test "FFI / nullable / uninit pointer forms — declarations parse" {
    // Option[*T] (nullable), *T (ro pointee canon), *uninit T (uninit pointee)
    // declarations exercise the parser + type-checker.
    assert(1 == 1)
}
