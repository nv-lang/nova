// SPDX-License-Identifier: MIT OR Apache-2.0
// examples/flagship/http_proxy_chain/main.nv — local HTTP-to-SOCKS5 bridge.
//
// Motivation (plan 249 §0): some SOCKS5 proxies require a username/password
// (RFC 1929) that Windows' system HTTP-proxy setting cannot carry. This
// bridge listens as a plain HTTP proxy on 127.0.0.1 and re-packages traffic
// into an authenticated SOCKS5 tunnel to the real proxy:
//
//   browser --HTTP--> 127.0.0.1:PORT --SOCKS5+auth--> upstream proxy --> internet
//
// Deliberately built straight over `std.net` (raw `TcpListener`/`TcpStream`),
// NOT `nova-polaris`: polaris' server parser only understands ordinary
// request URLs, not CONNECT's authority-form target (`host:port`, no
// scheme/path, RFC 7230 §5.3.3) — see plan 249 §1 for the full trade-off.
//
// Scope (plan 249 §2): CONNECT tunneling (HTTPS proxying, Ф.2) is the
// primary path. Plain HTTP-over-proxy (Ф.3, this commit) is the secondary
// path: a client sends an ordinary method with an absolute-URI request
// target (`GET http://host:port/path HTTP/1.1`, RFC 7230 §5.3.2) instead of
// CONNECT. The bridge extracts host/port, tunnels to it via `Upstream.dial`
// exactly like CONNECT does, but ALSO rewrites the request line to
// origin-form (`GET /path HTTP/1.1` — RFC 7230 §5.3.1 is what an origin
// server is guaranteed to accept, and not every real-world server tolerates
// receiving absolute-form) and drops `Proxy-*` headers (`Proxy-Connection`,
// `Proxy-Authorization`, ...) before forwarding — those are addressed to
// THIS bridge, not the origin. Only the `http://` scheme is understood here;
// a request line that is neither CONNECT nor a `http://` absolute-URI is an
// honest `400 Bad Request`, not a silent miscode. Deliberately NOT in scope
// (plan 249 §2): keep-alive connection pooling, HTTP/2, response caching,
// body rewriting.
//
// File layout (plan 249 §9 — one module, equal-standing files, all
// declaring `module flagship.http_proxy_chain`):
//   config.nv           — Config, load_config, LISTEN_PORT/upstream selection
//   http.nv             — request-head reading + parsing
//   relay.nv            — pipe_bidirectional/pump (the tunnel stage)
//   upstream.nv         — the Upstream EFFECT, upstream_for (scheme dispatch)
//   upstream_socks5.nv  — the SOCKS5 handler for that effect
//   main.nv (this file) — accept loop, per-connection dispatch, responses
//
// Configuration (`Os` effect) — canon per plan 249 §8, see config.nv/README:
//   argv[1] / LISTEN_PORT   optional, local listen port (default 8899).
//   SOCKS5_PROXY/_USER/_PASS  explicit upstream override ("host:port" + RFC
//                             1929 creds), takes priority over ALL_PROXY.
//   ALL_PROXY / all_proxy   optional, `all_proxy`-compatible URL
//                           (socks5://[user:pass@]host:port), used when no
//                           explicit SOCKS5_PROXY is set.
//
// Usage:
//   SOCKS5_PROXY=proxy.example.com:1080 SOCKS5_USER=me SOCKS5_PASS=secret \
//     nova build examples/flagship/http_proxy_chain/main.nv -o bridge && ./bridge 8899
//   # Point a browser's HTTPS proxy setting at 127.0.0.1:8899.
//
// See the module README for the full write-up, including the manual
// end-to-end smoke test (NOT run in CI — needs a real external SOCKS5
// proxy).

module flagship.http_proxy_chain

import std.net.{TcpListener, TcpStream, SocketAddr, real_net}
import std.os.{real_os}
import std.time.duration

// Time bounds on the two blocking steps BEFORE the pipe starts (reading the
// client's request headers, and the SOCKS5 handshake to the upstream
// proxy). Canonical `supervised(timeout:)` + `with Fail[TimeoutError]`
// (registry №457, D408) — the guarded operation is a DIRECT body statement
// of its own `supervised(timeout:)` block (no `spawn` at all), the shape
// window 249 (Ф.0-б) and #165's own regression fixture
// (`std/src/net/supervised_cancel_accept_test.nv`) both confirm reliably
// interrupts on time. A prior revision used a manual `CancelToken` +
// watchdog `spawn` here, built on the (2026-08-08) finding that
// `supervised(timeout:)` doesn't reach a `.read()` nested inside a SIBLING
// spawn body — that finding does not apply to this DIRECT-body shape (no
// spawn wraps `read_headers`/`socks5_connect` themselves) and window
// p457-timeout's own targeted re-testing (~1080 runs across 7 fixture
// shapes, this direct-body form included) never reproduced a hang; see
// `docs/plans/221.1-bug-sweep.md` №457 for the full matrix. The manual
// watchdog is retired here.
const HEADER_READ_TIMEOUT_MS = 15000
const UPSTREAM_CONNECT_TIMEOUT_MS int = 15000

// The pipe stage itself (`pipe_bidirectional`) is intentionally left
// UNBOUNDED (plan 249 §6 risk register: "known V1 limitation, no read
// timeouts on the established tunnel" — accepted for an example; a
// production bridge would want idle timeouts here too).

fn main() Net Os Time Upstream -> () {
    with Os = real_os(), Net = real_net() {
        ro cfg = load_config()
        consume listener = TcpListener.bind(SocketAddr.loopback(cfg.listen_port))!!
        println("http_proxy_chain: listening on 127.0.0.1:${listener.local_port()}, upstream ${cfg.upstream_desc}")
        // One handler for the whole process's lifetime (plan 249 §9): the
        // upstream proxy is selected once at startup (`load_config`), not
        // per-connection — every spawned per-connection fiber below sees
        // this SAME handler as its ambient `Upstream`, same as `Net`/`Os`
        // above. `cfg.upstream` is PLAIN DATA (`UpstreamSource`) — the
        // actual `Effect[Upstream]` handler value is built by
        // `@to_handler()` and consumed IMMEDIATELY here, never stored
        // anywhere first (see `upstream.nv` for the codegen defect this
        // works around).
        with Upstream = cfg.upstream.to_handler() {
            supervised {
                loop {
                    match listener.accept() {
                        // Form REQUIRED by plan 249 §3.2 (build-verified): the
                        // binding comes from the match arm and moves straight
                        // into `spawn consume` — an OUTER `consume conn = …`
                        // plus a bare `spawn` gives `E_LINEAR_CAPTURE_IN_FIBER`.
                        Ok(consume conn) => spawn consume conn { handle_client(conn) }
                        // Plan 249 Ф.2 policy: log and keep serving. One failed
                        // accept (transient EMFILE, a client that vanished during
                        // the handshake) must not take the whole bridge down —
                        // the loop is the process's only reason to exist.
                        Err(_)           => println("http_proxy_chain: accept failed, continuing")
                    }
                }
            }
        }
    }
}

// ─── Per-connection handling ───────────────────────────────────────────────

// Effects are inferred here, not declared: `Net` reaches this body through
// `client.write`, and D28 ("вывод эффектов: private выводится, public
// обязательно явно") infers it for a private function. An exported one would
// have to spell `Net` out.
fn respond(mut client TcpStream, status_line str) -> () {
    // nova:allow W_RESULT_DISCARDED -- every caller is already on a terminal path (400/431/502, or the 200 immediately before the pipe): if writing the status line fails, the peer is gone and there is nothing left to report it to. Propagating would only replace one dead connection with a second error nobody reads.
    ro _ = client.write("${status_line}\r\n\r\n")
}

fn handle_client(consume client TcpStream) Net Time Upstream -> () {
    match read_headers_guarded(client, MAX_HEADER_BYTES) {
        Ok(headers) => {
            match parse_request(headers.head) {
                Connect { host, port } => {
                    handle_connect(client, host, port, headers.leftover)
                }
                Plain { host, port, rewritten_head } => {
                    handle_plain(client, host, port, rewritten_head, headers.leftover)
                }
                Invalid => {
                    // Neither a CONNECT authority-form target nor a
                    // recognized `http://` absolute-URI — an honest 400,
                    // not a silent miscode.
                    respond(client, "HTTP/1.1 400 Bad Request")
                    client.close()
                }
            }
        }
        Err(TooLarge) => {
            respond(client, "HTTP/1.1 431 Request Header Fields Too Large")
            client.close()
        }
        Err(_) => {
            // Peer closed / errored / watchdog-cancelled before sending a
            // complete request — nothing useful to answer with, just close.
            client.close()
        }
    }
}

// Timeout-guarded upstream dial — mirrors `read_headers_guarded`'s shape
// (registry №457): `Upstream.dial` runs as a DIRECT body statement of its
// own `supervised(timeout:)`, no `spawn`, no shared `CancelToken`. Still
// returns the live `upstream` `TcpStream` OUT to the caller (as
// `supervised`'s own tail value) rather than piping from inside this
// scope — `pipe_bidirectional` opens its OWN fresh scope with its OWN
// token, and `handle_connect`/`handle_plain` call it from THEIR top-level
// body, entered fresh and uncancelled, same as before this simplification.
fn connect_guarded(host str, port int) Net Time Upstream -> Result[TcpStream, ()] {
    with Fail[TimeoutError] = |_e| { Err(()) } {
        supervised(timeout: UPSTREAM_CONNECT_TIMEOUT_MS.to_millis()) {
            match Upstream.dial(host, port) {
                Ok(consume upstream) => Ok(upstream)
                Err(_)                => Err(())
            }
        }
    }
}

// Connects to the upstream proxy, then either tunnels (`pipe_bidirectional`)
// or answers `502 Bad Gateway`. Upstream connect happens BEFORE the `200`
// response is sent — a failed upstream never leaves the client thinking a
// tunnel it does not have was established (plan 249 §3.2).
fn handle_connect(consume client TcpStream, host str, port int, leftover []u8) Net Time Upstream -> () {
    match connect_guarded(host, port) {
        Ok(consume upstream) => {
            respond(client, "HTTP/1.1 200 Connection Established")
            if leftover.len() > 0 {
                // Best-effort: a write failure here just means the
                // upstream connection is already broken — the immediately
                // following `pipe_bidirectional` will observe that on its
                // own next read/write and tear down cleanly either way.
                // nova:allow W_RESULT_DISCARDED -- intentional: the very next statement (pipe_bidirectional) re-detects and handles a dead upstream; propagating here would only duplicate that teardown path
                ro _ = upstream.write(leftover)
            }
            pipe_bidirectional(client, upstream)
        }
        Err(_) => {
            respond(client, "HTTP/1.1 502 Bad Gateway")
            client.close()
        }
    }
}

// Plain-HTTP-over-proxy path (Ф.3): connects upstream the same way
// `handle_connect` does (same `connect_guarded` watchdog), but instead of
// answering the CLIENT with a "200 Connection Established" and piping raw
// bytes right away, it first forwards the already-rewritten (origin-form,
// `Proxy-*`-stripped) request head to UPSTREAM — no response of the
// bridge's own is sent to the client; the origin server's response arrives
// through `pipe_bidirectional` like any other tunneled byte.
fn handle_plain(consume client TcpStream, host str, port int, rewritten_head str, leftover []u8) Net Time Upstream -> () {
    match connect_guarded(host, port) {
        Ok(consume upstream) => {
            // Best-effort, mirroring handle_connect's leftover write: a
            // write failure here just means upstream is already broken —
            // the immediately following pipe_bidirectional re-detects and
            // tears down cleanly on its own first read/write either way.
            // nova:allow W_RESULT_DISCARDED -- intentional: pipe_bidirectional re-detects a dead upstream on its own next read/write; propagating here would only duplicate that teardown path
            ro _ = upstream.write("${rewritten_head}\r\n\r\n")
            if leftover.len() > 0 {
                // nova:allow W_RESULT_DISCARDED -- intentional: same reasoning as the write_str above
                ro _ = upstream.write(leftover)
            }
            pipe_bidirectional(client, upstream)
        }
        Err(_) => {
            respond(client, "HTTP/1.1 502 Bad Gateway")
            client.close()
        }
    }
}
