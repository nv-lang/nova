# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Template for the manual end-to-end smoke test (plan 249 §5 — deliberately
# OUTSIDE CI: it needs a real, reachable SOCKS5 proxy that no runner can
# provide). Copy to `.env` in this directory and fill in real values:
#
#     cp .env.example .env      # `.env` is git-ignored, never commit it
#
# Then run the bridge (from the repository root):
#
#     set -a && . examples/flagship/http_proxy_chain/.env && set +a
#     nova build examples/flagship/http_proxy_chain/main.nv --strict-effects -o bridge
#     ./bridge "${LISTEN_PORT:-8899}"
#
# And drive it through curl, exercising BOTH paths:
#
#     curl -x http://127.0.0.1:8899 https://api.ipify.org   # CONNECT tunnel
#     curl -x http://127.0.0.1:8899 http://api.ipify.org    # plain HTTP rewrite
#
# A useful control BEFORE blaming the bridge — talk to the proxy directly:
#
#     curl --socks5-hostname "$SOCKS5_PROXY" \
#          --proxy-user "$SOCKS5_USER:$SOCKS5_PASS" https://api.ipify.org
#
# If the control fails, the proxy or the credentials are the problem, not
# this example.

# Upstream SOCKS5 proxy, "host:port". Required — the bridge panics without it.
SOCKS5_PROXY=proxy.example.com:1080

# RFC 1929 username/password. Optional: leave both empty for an open proxy.
SOCKS5_USER=
SOCKS5_PASS=

# Local port the bridge listens on (passed as argv[1]; default 8899).
LISTEN_PORT=8899
