// SPDX-License-Identifier: MIT OR Apache-2.0
// examples/flagship/http_proxy_chain/upstream_socks5.nv — the SOCKS5
// handler for the `Upstream` effect (upstream.nv), over the separately-
// published `socks` package. This is the file a second protocol handler
// (e.g. `upstream_socks4.nv`'s `socks4_upstream`) would sit beside — see
// `upstream.nv`'s `Upstream` effect doc comment for why a protocol switch
// is a handler switch (plan 249 §9).

module flagship.http_proxy_chain

import socks.{socks5_connect}

// Closure-captured state (D68 way 1): `host`/`port`/`user`/`pass` are this
// factory's own parameters, captured by the `dial` operation's closure —
// the same shape `std.net`'s `real_net()`/`mock_net()` and this file's
// sibling `config.nv` helpers already use.
export fn socks5_upstream(host str, port int, user Option[str], pass Option[str]) -> Effect[Upstream] => effect Upstream {
    // Thin adapter: `socks5_connect`'s own `SocksError` becomes this
    // module's `UpstreamError` so the `Upstream` effect's callers never see
    // a protocol-specific error type — a second protocol's `dial` maps its
    // own error type the same way.
    dial(target_host str, target_port int) -> Result[TcpStream, UpstreamError] {
        match socks5_connect(host, port, user, pass, target_host, target_port) {
            Ok(consume stream) => Ok(stream)
            Err(e)              => Err(ConnectFailed { reason: e.to_str() })
        }
    }
}
