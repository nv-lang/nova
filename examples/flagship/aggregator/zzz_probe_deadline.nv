// TEMP PROBE — not part of the aggregator package, deleted before commit.
// Does supervised(deadline:) actually interrupt Time.sleep called from a
// helper fn (not inline in spawn body), with code AFTER the sleep?
module aggregator.zzz_probe_deadline

import std.time.duration

fn do_sleep_then_send(tx ChanWriter[int], ms int) {
    Time.sleep(ms)
    // code AFTER the sleep — does control reach here after a truncated sleep?
    ro _ = tx.try_send(1)
}

// Round 2: does `supervised(cancel: tok, deadline: ...)` flip `tok`'s own
// is_cancelled() when it's the DEADLINE that fires (no manual tok.cancel()
// anywhere)? If yes, `is_cancelled()` polled right after the interrupted
// sleep is a viable cooperative-checkpoint workaround for the fall-through
// bug above (race2()'s own idiom, std/concurrency/cancellation.nv).
fn do_sleep_then_send_checked(tok CancelToken, tx ChanWriter[int], ms int) {
    Time.sleep(ms)
    if !tok.is_cancelled() {
        ro _ = tx.try_send(1)
    } else {
        ro _ = tx.try_send(2)   // distinguishable: "reached checkpoint, saw cancelled"
    }
}

test "probe: tok.is_cancelled() after deadline-only firing (no manual cancel)" {
    ro tok = CancelToken.new()
    ro { tx, rx } = Channel.new(1)
    ro r = with Fail[TimeoutError] = |_e| { 0 } {
        supervised(cancel: tok, timeout: Duration.from_millis(100)) {
            spawn { do_sleep_then_send_checked(tok, tx, 500) }
        }
        99
    }
    tx.close()
    ro got = rx.try_recv()
    println("probe2 r=" + str.from(r) + " tok_cancelled_after=" + str.from(tok.is_cancelled()) +
        " got_is_some=" + str.from(got.is_some()) +
        " got_val=" + str.from(match got { Some(v) => v, None => -1 }))
    assert(r == 0)
}

test "probe: sleep(500) under 100ms deadline, code-after-sleep in a helper fn" {
    ro { tx, rx } = Channel.new(1)
    ro t0 = Time.now_unix_ms()
    mut caught = false
    ro r = with Fail[TimeoutError] = |_e| {
        caught = true
        0
    } {
        supervised(timeout: Duration.from_millis(100)) {
            spawn { do_sleep_then_send(tx, 500) }
        }
        99
    }
    ro elapsed = Time.now_unix_ms() - t0
    tx.close()
    ro got = rx.try_recv()
    // [M-flagship-assert-dynamic-msg-dropped]: `assert(cond, msg)` only bakes
    // in the message when `msg` is a STRING LITERAL at the call site
    // (compiler-codegen/src/codegen/emit_c.rs ~30690: a non-literal 2nd arg
    // silently falls back to the no-message format, NULL) — a runtime-built
    // `str` (as `msg` was here) type-checks fine (the prelude 2-arg overload
    // doesn't require a literal) but produces NO output on failure, which
    // makes "assert with a computed debug message" a dead end for probing.
    // Documented, not fixed this session (task instruction: route around
    // compiler bugs, report). WORKAROUND: `println` the diagnostic BEFORE
    // the assert — println output IS captured by the test runner's RUN-FAIL
    // summary line (verified elsewhere in this package, e.g. aggregate_test's
    // "DEBUG len=..." line).
    // "assert" substring below is load-bearing: the test-runner's RUN-FAIL
    // summary line only surfaces stdout lines containing fail/assert/panic
    // (compiler-codegen/src/test_runner.rs ~2796) — a plain "DEBUG ..." line
    // with none of those substrings is silently dropped from the summary
    // even though it printed fine (verified: `nova test-build` on this same
    // file shows only the assert-failure line, no DEBUG line, even though
    // stdout was flushed — confirmed by cross-checking the filter logic).
    println("assert-probe-info caught=" + str.from(caught) + " r=" + str.from(r) +
        " elapsed=" + str.from(elapsed) + " got_is_some=" + str.from(got.is_some()))
    assert(caught)
    assert(elapsed < 2000)
    assert(got.is_none())
}
