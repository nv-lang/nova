// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: JSON snapshot bridge.
//
// Pure `Report -> str` serialization feeding the waterfall UI (mockup:
// `docs/research/assets/15-showcase-mockup.html`, VERBATIM — not touched by
// this package). Real-time SSE is gated on `[M-178-server-streaming]` (plan
// 187 §3 Ф.1, not landed) — until then `server.nv`'s `snapshot_mux` serves
// this JSON as a single fetchable "last completed run" snapshot (plan 187
// §7 item 7's "снапшот-JSON fallback endpoint").
//
// Dynamic `JsonValue` (std.encoding.json), NOT typed `#impl(Serialize)` —
// the http CU trips a known serdejson codegen defect on typed bodies
// (`[M-178-server-typed-body]`, std/http/server/server.nv header) — this is
// this session's instance of the documented workaround ("dynamic json / by
// hand, not typed `.json[T]`").

module backend.api

import ../app.{Report, TaskResult, TaskStatus}
import std.encoding.json.{JsonValue}
import std.collections.hashmap.{HashMap}

fn status_json(status TaskStatus) -> JsonValue {
    mut m = HashMap[str, JsonValue].new()
    match status {
        Done(_)   => { m.insert("state", JsonValue.Str("done")) }
        Failed(e) => {
            m.insert("state", JsonValue.Str("failed"))
            m.insert("error", JsonValue.Str(e))
        }
        Cancelled => { m.insert("state", JsonValue.Str("cancelled")) }
    }
    JsonValue.Object(m)
}

fn task_json(r TaskResult) -> JsonValue {
    mut m = HashMap[str, JsonValue].new()
    m.insert("id", JsonValue.Str(r.id))
    m.insert("status", status_json(r.status))
    m.insert("elapsed_ms", JsonValue.Num(r.elapsed_ms as f64))
    JsonValue.Object(m)
}

/// Serialize a settled `Report` to the waterfall snapshot JSON shape:
///
/// ```json
/// {
///   "fanout": 4, "done": 2, "failed": 1, "cancelled": 1,
///   "wall_ms": 118, "sequential_ms": 555,
///   "results": [
///     {"id": "fast-a", "status": {"state": "done"}, "elapsed_ms": 15},
///     {"id": "bad-upstream", "status": {"state": "failed", "error": "..."}, "elapsed_ms": 10},
///     {"id": "slow-late", "status": {"state": "cancelled"}, "elapsed_ms": 120}
///   ]
/// }
/// ```
#stable(since = "0.1")
export fn report_to_json(report Report) -> str {
    mut results []JsonValue = []
    for r in report.results {
        results.push(task_json(r))
    }
    mut m = HashMap[str, JsonValue].new()
    m.insert("fanout", JsonValue.Num(report.results.len() as f64))
    m.insert("done", JsonValue.Num(report.done as f64))
    m.insert("failed", JsonValue.Num(report.failed as f64))
    m.insert("cancelled", JsonValue.Num(report.cancelled as f64))
    m.insert("wall_ms", JsonValue.Num(report.wall_ms as f64))
    m.insert("sequential_ms", JsonValue.Num(report.sequential_ms as f64))
    m.insert("results", JsonValue.Array(results))
    JsonValue.Object(m).to_str()
}
