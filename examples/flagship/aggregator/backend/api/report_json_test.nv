// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: JSON snapshot bridge tests.
//
// Pure functions (`build_snapshot`/`snapshot_to_json` — `Report -> DTO ->
// str`, no effects) — tested directly, no handler substitution needed here
// (see server_test.nv for the HTTP-layer tests).

module backend.api

import ../app.{Report, TaskResult, TaskStatus, SourceData, Source}
import std.encoding.json.{Json}

// [M-flagship-anon-record-literal-enum-payload]: a BARE record literal
// (`{ id, payload: ... }`) as an enum-variant payload argument
// (`TaskStatus.Done({ ... })`) confuses codegen's expected-type propagation
// here — "anonymous record literal: expected struct 'TaskStatus' not in
// record_schemas" (it looks for a `TaskStatus` schema instead of the
// variant's own payload type, `SourceData`). The OUTER literal stays bare
// (return-position — the checker rejects a redundant type prefix there,
// "the return type `-> TaskResult` already declares it"); only the INNER
// one (an enum-variant call ARGUMENT, not a return value) needs the
// explicit `SourceData` prefix to sidestep the gap.
fn done_result(id str, ms int) -> TaskResult =>
    { id, status: TaskStatus.Done(SourceData { id, payload: []u8.new() }), elapsed_ms: ms }

fn failed_result(id str, err str, ms int) -> TaskResult =>
    { id, status: TaskStatus.Failed(err), elapsed_ms: ms }

fn cancelled_result(id str, ms int) -> TaskResult =>
    { id, status: TaskStatus.Cancelled, elapsed_ms: ms }

fn handlers_demo() -> HandlersDto => { net: "mock(seed=42)", time: "real" }

// A `Source` list matching the ids used by `done_result`/`failed_result`/
// `cancelled_result` above, so `build_snapshot`'s id-lookup (`source_by_id`)
// finds `kind`/`probes` for each.
fn srcs_for(ids []str) -> []Source {
    mut out []Source = []
    for id in ids {
        out.push(Source.new(id, "unit-" + id, 3, 0, false))
    }
    out
}

// ── POS: full shape round-trips through the JSON parser ────────────────────

test "build_snapshot -> snapshot_to_json: round-trips through the JSON parser" {
    ro report = Report.from([
        done_result("fast-a", 15),
        failed_result("bad", "upstream failure: bad", 10),
        cancelled_result("slow", 120),
    ], 118)
    ro dto = build_snapshot(report, srcs_for(["fast-a", "bad", "slow"]), "weather", "demo", 7, 120, handlers_demo())
    ro v = Json.parse(snapshot_to_json(dto))!!
    ro obj = v.object()!!
    assert(obj.get("fanout")!!.num() == Some(3.0))
    assert(obj.get("done")!!.num() == Some(1.0))
    assert(obj.get("failed")!!.num() == Some(1.0))
    assert(obj.get("cancelled")!!.num() == Some(1.0))
    assert(obj.get("wall_ms")!!.num() == Some(118.0))
    assert(obj.get("budget_ms")!!.num() == Some(120.0))
    assert(obj.get("legend")!!.str() == Some("weather"))
    assert(obj.get("mode")!!.str() == Some("demo"))
    assert(obj.get("seed")!!.num() == Some(7.0))
    assert(obj.get("fibers_spawned")!!.num() == Some(6.0))    // 2 fibers × 3 lanes
    assert(obj.get("fibers_closed")!!.num() == Some(6.0))

    ro results = obj.get("results")!!.array()!!
    assert(results.len() == 3)
}

// [M-flagship-nested-hashmap-jsonvalue-mono]: parsing THREE levels deep
// (top object -> "results" array -> element object -> nested "status"
// object, i.e. `results[0].object()!!.get("status")!!.object()!!`) CC-FAILs:
// "unknown type name 'NovaOpt_Nova_JsonValue_p_p'" / a doubled
// `Nova_HashMap____nova_str__Nova_JsonValue_p_p` — a generics-monomorphization
// naming collision for the recursive `Option[HashMap[str, JsonValue]]`
// instantiation once it is unwrapped/re-derived a second time in the same
// function. std/encoding/json_test.nv's own coverage never nests this deep
// (object-in-array-in-object). Reproduced in isolation. Workaround below:
// assert on the serialized STRING directly (order-independent per-field
// substrings — `format_object` does not guarantee HashMap/serde key order)
// instead of re-parsing the nested "status" object.

// ── POS: a failed lane carries its error text in status.error ──────────────

test "snapshot_to_json: failed lane carries its error text" {
    ro report = Report.from([failed_result("bad", "upstream failure: bad", 10)], 10)
    ro dto = build_snapshot(report, srcs_for(["bad"]), "health", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"state\":\"failed\""))
    assert(s.contains("\"error\":\"upstream failure: bad\""))
}

// ── POS: a done lane's status carries a null (not a string) error ──────────
//    (D344 Option[T]::None -> JSON `null`, key still present — serde
//    auto-derive doesn't support field-skip yet, `[M-180-serde-field-
//    attributes]`; the UI/README's `status.error?` optionality is "null or a
//    string", not "key present or absent").

test "snapshot_to_json: done lane's status carries a null error, not a string" {
    ro report = Report.from([done_result("fast-a", 15)], 15)
    ro dto = build_snapshot(report, srcs_for(["fast-a"]), "health", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"state\":\"done\""))
    assert(s.contains("\"error\":null"))
}

// ── POS: kind/probes come from the matching Source, by id ──────────────────

test "snapshot_to_json: result kind/probes are pulled from the matching Source" {
    ro report = Report.from([done_result("only-one", 15)], 15)
    ro srcs = [Source.new("only-one", "7 days", 7, 0, false)]
    ro dto = build_snapshot(report, srcs, "weather", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"kind\":\"7 days\""))
    assert(s.contains("\"probes\":7"))
}

// ── EDGE: empty report -> empty results array, zero tallies, no panic ──────

test "snapshot_to_json: empty report -> empty results array, zero tallies" {
    ro report = Report.from([]TaskResult.new(), 0)
    ro dto = build_snapshot(report, []Source.new(), "weather", "demo", 0, 100, handlers_demo())
    ro v = Json.parse(snapshot_to_json(dto))!!
    ro obj = v.object()!!
    assert(obj.get("fanout")!!.num() == Some(0.0))
    assert(obj.get("done")!!.num() == Some(0.0))
    assert(obj.get("results")!!.array()!!.len() == 0)
    assert(obj.get("fibers_spawned")!!.num() == Some(0.0))
}

// ── POS: pretty form (D419 json_encode_pretty) is still valid JSON ─────────

test "snapshot_to_json_pretty: still parses to the same tallies" {
    ro report = Report.from([done_result("fast-a", 15)], 15)
    ro dto = build_snapshot(report, srcs_for(["fast-a"]), "weather", "demo", 0, 100, handlers_demo())
    ro pretty = snapshot_to_json_pretty(dto)
    assert(pretty.contains("\n"))    // pretty-printed, not compact
    ro v = Json.parse(pretty)!!
    assert(v.object()!!.get("done")!!.num() == Some(1.0))
}
