// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: HTTP bridge for the waterfall UI.
//
// SSE (`text/event-stream`) is plan 187 §3 Ф.1, gated on
// `[M-178-server-streaming]` (not landed) — until then this is the "snapshot-
// JSON fallback endpoint" from plan 187 §7 item 7: `GET /api/snapshot`
// answers with the JSON for ONE already-settled `aggregate()` run
// (report_json.nv), not a live per-request re-fan-out. The mux is built from
// a `Report` that is already in hand, so the HTTP layer itself stays pure
// (`http.server`'s `Handler` is `fn(ServerRequest) -> ServerResponse`,
// no effect row — CORE handlers cannot themselves call `Net`/`Time`/`Emit`);
// `snapshot_for` does the effectful work (one `aggregate` call) BEFORE
// building the mux. A later phase re-points this at
// `http.servernet`'s live accept-loop (which DOES run over `Net`) for
// per-request freshness / real SSE — out of scope here (Ф.1/Ф.4).
//
// Mock-testable without a socket, same idiom as nova-http's
// `server/mux_test.nv`: `serve_once(mux, raw_request_bytes)`.
//
// `http` is an external package (Plan 203: extracted from std/http into
// nova-http, sibling repo) — declared in `examples/nova.toml`'s
// `[dependencies]`, same pattern as `tls`/`examples/tls`.

module aggregator.server

import ./aggregate.{aggregate}
import ./domain.{Source, Report}
import ./emit.{Emit}
import ./report_json.{report_to_json}
import ./scenarios.{weather_demo_sources, WEATHER_BUDGET_MS, health_demo_sources, HEALTH_BUDGET_MS}
import http.server.{ServeMux, ServerResponse, handler_fn}
// Explicit import for the C runtime to link `Duration` support (same
// requirement as aggregate.nv — see that file's header comment).
import std.time.duration

/// Build a `ServeMux` serving a PRECOMPUTED `report` as JSON at
/// `GET /api/snapshot`. Pure (the JSON body is baked into the handler
/// closure at build time) — `snapshot_for` below is the effectful entry
/// point that actually runs the fan-out.
#stable(since = "0.1")
export fn snapshot_mux(report Report) -> ServeMux {
    ro body = report_to_json(report).bytes()
    mut mux = ServeMux.new()
    mux.get("/api/snapshot", handler_fn(|_req| ServerResponse.bytes(200, "application/json", body)))
    mux
}

/// Run one full fan-out (`aggregate`) and package the settled `Report` as a
/// servable snapshot mux. `Emit` is a real effect here too (emit.nv) — the
/// caller installs a handler (or `null_emit()`) the same way it installs
/// `Net`/`Time`.
#stable(since = "0.1")
export fn snapshot_for(sources []Source, budget Duration) Net Time Emit -> ServeMux {
    ro report = aggregate(sources, budget)
    snapshot_mux(report)
}

/// Weather-legend snapshot (research 15 §5a demo table, scenarios.nv).
#stable(since = "0.1")
export fn weather_snapshot_mux() Net Time Emit -> ServeMux {
    snapshot_for(weather_demo_sources(), Duration.from_millis(WEATHER_BUDGET_MS))
}

/// Health-check-legend snapshot (research 15 §5b demo table, scenarios.nv).
#stable(since = "0.1")
export fn health_snapshot_mux() Net Time Emit -> ServeMux {
    snapshot_for(health_demo_sources(), Duration.from_millis(HEALTH_BUDGET_MS))
}
