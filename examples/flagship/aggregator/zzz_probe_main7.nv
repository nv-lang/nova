module aggregator.zzz_probe_main7

import ./domain.{Source}
import std.time.duration

fn fetch_one_like(source Source, idx int) Time -> int {
    println("    [fetch_one_like] idx=" + str.from(idx) + " id=" + source.id +
        " latency_ms=" + str.from(source.latency_ms))
    if source.latency_ms > 0 {
        Time.sleep(source.latency_ms)
    }
    42
}

// Mirrors fetch_status: plain fn, no `with`/`throw`, called from `spawn`.
fn fetch_status_like(source Source, idx int) Time -> int {
    ro v = fetch_one_like(source, idx)
    v
}

// Mirrors fetch_guarded EXACTLY: one `with Fail[TimeoutError]` directly
// wrapping `supervised(deadline:) { spawn { ...channel handoff... } }`.
fn fetch_guarded_like(source Source, deadline Monotonic, idx int) Time -> int {
    ro sid = source.id
    ro { tx, rx } = Channel.new(1)
    with Fail[TimeoutError] = |_e| {
        println("    [" + sid + "] TIMEOUT (cancelled)")
    } {
        ro src = source
        supervised(deadline: deadline) {
            spawn {
                ro v = fetch_status_like(src, idx)
                ro _ bool = tx.try_send(v)
            }
        }
    }
    tx.close()
    match rx.try_recv() {
        Some(v) => v
        None    => -2
    }
}

fn main() Time {
    println("D: parallel-for + fetch_guarded_like, 4 lanes, mirrors aggregate.nv exactly")
    ro srcs []Source = [
        Source.new("fast-a",    "", 1, 15,  false),
        Source.new("fast-b",    "", 1, 30,  false),
        Source.new("slow-late", "", 1, 500, false),
        Source.new("quick",     "", 1, 10,  false),
    ]
    ro t0 Monotonic = Monotonic.now()
    ro deadline = t0.plus(Duration.from_millis(120))
    ro results = parallel for idx int in 0..srcs.len() {
        ro t_lane0 Monotonic = Monotonic.now()
        ro v = fetch_guarded_like(srcs[idx], deadline, idx)
        ro t_lane1 Monotonic = Monotonic.now()
        println("    [" + srcs[idx].id + "] result=" + str.from(v) + " elapsed=" +
            str.from(t_lane1.elapsed_since(t_lane0).as_millis() as int) + "ms")
        v
    }
    ro _ = results
    ro t1 Monotonic = Monotonic.now()
    println("  overall elapsed=" + str.from(t1.elapsed_since(t0).as_millis() as int) + "ms (expect ~120, deadline should cut slow-late short)")
}
