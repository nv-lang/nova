// SPDX-License-Identifier: MIT OR Apache-2.0
// Flagship concurrent aggregator: JSON snapshot bridge.
//
// Typed `#impl(Serialize)` snapshot DTOs feeding the waterfall UI.
// The DTOs are a deliberate snapshot shape — not a re-export of domain
// types — because the wire contract adds context fields (source kind/probes,
// run legend/mode/seed/budget, leak-accounting, handler info) and needs
// a fixed tag shape for `TaskStatus` rather than the auto-derived enum form.

module api

import ../domain.{Report, TaskResult, TaskStatus, Source}
import std.encoding.serde.{Serialize, json_encode, json_encode_pretty}

// ── DTOs (wire contract) ────────────────────────────────────────────────────

#impl(Serialize)
export type StatusDto value {
    ro state str              // "done" | "failed" | "cancelled"
    ro error Option[str]      // present only for "failed"
}

#impl(Serialize)
export type ResultDto value {
    ro id         str
    ro kind       str          // ← Source.detail ("7 days" / "3 checks")
    ro probes     int          // ← Source.sub_count (waterfall notch count)
    ro status     StatusDto
    ro elapsed_ms int
}

#impl(Serialize)
export type HandlersDto value {
    ro net  str     // e.g. "mock(seed=42)" | "real"
    ro time str     // e.g. "fixed" | "real"
}

#impl(Serialize)
export type SnapshotDto value {
    ro fanout         int
    ro done           int
    ro failed         int
    ro cancelled      int
    ro wall_ms        int
    ro sequential_ms  int
    ro budget_ms      int
    ro legend         str      // "weather" | "health"
    ro mode           str      // "demo" | "chaos" | "live"
    ro seed           int      // ignored (0) for legend=live
    ro handlers       HandlersDto
    ro fibers_spawned int
    ro fibers_closed  int
    ro results        []ResultDto
}

// ── Report + run context -> SnapshotDto ─────────────────────────────────────

fn status_dto(status TaskStatus) -> StatusDto {
    match status {
        Done(_)   => StatusDto { state: "done", error: None }
        Failed(e) => StatusDto { state: "failed", error: Some(e) }
        Cancelled => StatusDto { state: "cancelled", error: None }
    }
}

// `report.results` is in completion order, not the original `sources`
// order — look up the matching `Source` by id to recover `kind`/`probes`
// for the wire. Linear scan (fan-out is small) — not worth a HashMap.
fn source_by_id(sources []Source, id str) -> Source {
    mut found = sources[0]
    for s in sources {
        if s.id == id { found = s }
    }
    found
}

fn result_dto(r TaskResult, sources []Source) -> ResultDto {
    ro src = source_by_id(sources, r.id)
    { id: r.id, kind: src.detail, probes: src.sub_count, status: status_dto(r.status), elapsed_ms: r.elapsed_ms }
}

// Fiber introspection (`slot_count`/`slots_active`) is not available on
// all platforms — count structurally instead. Every lane spawns exactly two
// fibers, both structurally guaranteed closed before `aggregate()` returns:
// `fibers_spawned == fibers_closed == 2 * report.results.len()`.
fn fiber_count_of(report Report) -> int => 2 * report.results.len()

/// Build the wire snapshot from a settled `Report` + the run's context
/// (sources, legend/mode/seed, handlers). Pure — no effects.
#stable(since = "0.2")
export fn build_snapshot(report Report, sources []Source, legend str, mode str, seed int,
        budget_ms int, handlers HandlersDto) -> SnapshotDto {
    mut results []ResultDto = []
    for r in report.results {
        results.push(result_dto(r, sources))
    }
    ro fibers = fiber_count_of(report)
    {
        fanout: report.results.len(),
        done: report.done,
        failed: report.failed,
        cancelled: report.cancelled,
        wall_ms: report.wall_ms,
        sequential_ms: report.sequential_ms,
        budget_ms,
        legend,
        mode,
        seed,
        handlers,
        fibers_spawned: fibers,
        fibers_closed: fibers,
        results
    }
}

/// Compact JSON wire form of any of this app's DTOs.
///
/// Every DTO here is a flat `#impl(Serialize)` record of primitives — no
/// cycles or unrepresentable values, so encode-failure is structurally
/// impossible. `?? panic(...)` is the canonical form for invariant
/// violations. One helper, one name — the single JSON spelling app-wide.
#stable(since = "0.2")
export fn dto_json[T Serialize](v T) -> str =>
    json_encode(v) ?? panic("dto_json: flat Serialize DTO — encode must not fail")

/// Pretty (2-space indent) JSON wire form — `json_encode_pretty` is the
/// direct entry point (no `@display` for `#impl(Serialize)` DTOs). Same
/// `?? panic(...)` rationale as `dto_json` above.
#stable(since = "0.2")
export fn dto_json_pretty[T Serialize](v T) -> str =>
    json_encode_pretty(v) ?? panic("dto_json_pretty: flat Serialize DTO — encode must not fail")
