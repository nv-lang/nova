// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: JSON snapshot bridge tests.
//
// Pure functions (`build_snapshot`/`snapshot_to_json` — `Report -> DTO ->
// str`, no effects) — tested directly. Assertions are substring checks on
// the serialized string (NOT `std.encoding.json.Json.parse` round-trips),
// same idiom the "failed lane"/"kind-probes" tests below already used for
// the 3-levels-deep-nesting gap (`[M-flagship-nested-hashmap-jsonvalue-
// mono]`, see that note below) — kept even after the fix described next,
// since it sidesteps THAT unrelated gap too.
//
// [M-187-errorkind-parsejsonerror-variant-collision]: **compiler codegen
// bug, NOT worked around by weakening tests — worked around by a real
// module-boundary fix (`src/domain/domain.nv`, split out of `src/app` this
// same session).** Discovered wiring `src/main.nv`'s `resolve_port()`
// (`AGGREGATOR_PORT`, `std.os`) into this package: `nova test
// flagship/aggregator` CC-FAILed building `src/api/report_json.c` — `error:
// too many arguments to function call, expected 0, have 2 | Nova_ErrorKind*
// _nv_tmp_686 = nova_make_ErrorKind_UnexpectedEof((nova_self->line),
// (nova_self->col))`. Bisected (isolated minimal-probe test, `std.os` NOT
// involved at all — a red herring from the original hypothesis): TWO
// unrelated sum types each declare a variant literally named `UnexpectedEof`
// — `std.io.error.ErrorKind` (pulled in transitively by `std.net`, via
// `std/net/tcp.nv`'s `import std.io.{IoError}` — `IoError`/`ErrorKind` are
// declared in the SAME source file, inseparable) is a UNIT variant (0
// fields); `std.encoding.json.ParseJsonError` (pulled in transitively by
// `std.encoding.serde`'s JSON backend — needed for `json_encode`/
// `json_encode_pretty`, this package's whole typed-serde deliverable 2) is a
// 2-field record variant. Once BOTH types are present in ONE compile unit —
// this file's own target used to pull `std.net` transitively via `import
// ../app.{Report, TaskResult, ...}` (`src/app` = ONE D78 folder-module,
// `aggregate.nv`/`live.nv` peers import `std.net` for the REAL fan-out) —
// codegen emits the wrong (0-arg) constructor for the 2-arg call, REGARDLESS
// of whether `ParseJsonError.UnexpectedEof` is ever actually constructed
// (confirmed: removing every `Json.parse` call from this file, even reducing
// it to a single trivial `json_encode`-only test, did NOT clear the
// CC-FAIL — mere co-presence of both type declarations in the CU is
// sufficient. `[M-flagship-...]`-family root cause not investigated further,
// compiler-side, out of this package's remit). FIX: `src/domain/domain.nv`
// (Source/SourceData/AggError/TaskStatus/TaskResult/Report — pure data, zero
// effects) is now its OWN D78 folder-module, separate from `src/app`
// (`aggregate.nv`/`live.nv`, which need `std.net` for the real fan-out).
// This file (and `report_json.nv`) now import `../domain` directly — pure
// data only, no `std.net`, no `ErrorKind` in this CU at all — while
// `src/app/*.nv` imports `../domain` right back for its own use of these
// types (no behavior change anywhere, pure module-boundary move).

module api

import ../domain.{Report, TaskResult, TaskStatus, SourceData, Source}

// [M-flagship-anon-record-literal-enum-payload]: a BARE record literal
// (`{ id, payload: ... }`) as an enum-variant payload argument
// (`TaskStatus.Done({ ... })`) confuses codegen's expected-type propagation
// here — "anonymous record literal: expected struct 'TaskStatus' not in
// record_schemas" (it looks for a `TaskStatus` schema instead of the
// variant's own payload type, `SourceData`). The OUTER literal stays bare
// (return-position — the checker rejects a redundant type prefix there,
// "the return type `-> TaskResult` already declares it"); only the INNER
// one (an enum-variant call ARGUMENT, not a return value) needs the
// explicit `SourceData` prefix to sidestep the gap.
fn done_result(id str, ms int) -> TaskResult =>
    { id, status: TaskStatus.Done(SourceData { id, payload: []u8.new() }), elapsed_ms: ms }

fn failed_result(id str, err str, ms int) -> TaskResult =>
    { id, status: TaskStatus.Failed(err), elapsed_ms: ms }

fn cancelled_result(id str, ms int) -> TaskResult =>
    { id, status: TaskStatus.Cancelled, elapsed_ms: ms }

fn handlers_demo() -> HandlersDto => { net: "mock(seed=42)", time: "real" }

// A `Source` list matching the ids used by `done_result`/`failed_result`/
// `cancelled_result` above, so `build_snapshot`'s id-lookup (`source_by_id`)
// finds `kind`/`probes` for each.
fn srcs_for(ids []str) -> []Source {
    mut out []Source = []
    for id in ids {
        out.push(Source.new(id, "unit-${id}", 3, 0, false))
    }
    out
}

// ── POS: full shape shows up in the serialized JSON ─────────────────────────

test "build_snapshot -> snapshot_to_json: every top-level field round-trips" {
    ro report = [
        done_result("fast-a", 15),
        failed_result("bad", "upstream failure: bad", 10),
        cancelled_result("slow", 120),
    ].to_report(118)
    ro dto = build_snapshot(report, srcs_for(["fast-a", "bad", "slow"]), "weather", "demo", 7, 120, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"fanout\":3"))
    assert(s.contains("\"done\":1"))
    assert(s.contains("\"failed\":1"))
    assert(s.contains("\"cancelled\":1"))
    assert(s.contains("\"wall_ms\":118"))
    assert(s.contains("\"budget_ms\":120"))
    assert(s.contains("\"legend\":\"weather\""))
    assert(s.contains("\"mode\":\"demo\""))
    assert(s.contains("\"seed\":7"))
    assert(s.contains("\"fibers_spawned\":6"))    // 2 fibers × 3 lanes
    assert(s.contains("\"fibers_closed\":6"))
    assert(s.contains("\"results\":["))
}

// [M-flagship-nested-hashmap-jsonvalue-mono]: parsing THREE levels deep
// (top object -> "results" array -> element object -> nested "status"
// object) CC-FAILs: "unknown type name 'NovaOpt_Nova_JsonValue_p_p'" / a
// doubled `Nova_HashMap____nova_str__Nova_JsonValue_p_p` — a generics-
// monomorphization naming collision for the recursive `Option[HashMap[str,
// JsonValue]]` instantiation once it is unwrapped/re-derived a second time
// in the same function. std/encoding/json_test.nv's own coverage never
// nests this deep (object-in-array-in-object). Reproduced in isolation.
// Workaround below (and throughout this file): assert on the serialized
// STRING directly (order-independent per-field substrings — `format_object`
// does not guarantee HashMap/serde key order) instead of re-parsing.

// ── POS: a failed lane carries its error text in status.error ──────────────

test "snapshot_to_json: failed lane carries its error text" {
    ro report = [failed_result("bad", "upstream failure: bad", 10)].to_report(10)
    ro dto = build_snapshot(report, srcs_for(["bad"]), "health", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"state\":\"failed\""))
    assert(s.contains("\"error\":\"upstream failure: bad\""))
}

// ── POS: a done lane's status carries a null (not a string) error ──────────
//    (D344 Option[T]::None -> JSON `null`, key still present — serde
//    auto-derive doesn't support field-skip yet, `[M-180-serde-field-
//    attributes]`; the UI/README's `status.error?` optionality is "null or a
//    string", not "key present or absent").

test "snapshot_to_json: done lane's status carries a null error, not a string" {
    ro report = [done_result("fast-a", 15)].to_report(15)
    ro dto = build_snapshot(report, srcs_for(["fast-a"]), "health", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"state\":\"done\""))
    assert(s.contains("\"error\":null"))
}

// ── POS: kind/probes come from the matching Source, by id ──────────────────

test "snapshot_to_json: result kind/probes are pulled from the matching Source" {
    ro report = [done_result("only-one", 15)].to_report(15)
    ro srcs = [Source.new("only-one", "7 days", 7, 0, false)]
    ro dto = build_snapshot(report, srcs, "weather", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"kind\":\"7 days\""))
    assert(s.contains("\"probes\":7"))
}

// ── EDGE: empty report -> empty results array, zero tallies, no panic ──────

test "snapshot_to_json: empty report -> empty results array, zero tallies" {
    ro report = []TaskResult.new().to_report(0)
    ro dto = build_snapshot(report, []Source.new(), "weather", "demo", 0, 100, handlers_demo())
    ro s = snapshot_to_json(dto)
    assert(s.contains("\"fanout\":0"))
    assert(s.contains("\"done\":0"))
    assert(s.contains("\"results\":[]"))
    assert(s.contains("\"fibers_spawned\":0"))
}

// ── POS: pretty form (D419 json_encode_pretty) still carries the same tallies

test "snapshot_to_json_pretty: still carries the same tallies, whitespace aside" {
    ro report = [done_result("fast-a", 15)].to_report(15)
    ro dto = build_snapshot(report, srcs_for(["fast-a"]), "weather", "demo", 0, 100, handlers_demo())
    ro pretty = snapshot_to_json_pretty(dto)
    assert(pretty.contains("\n"))    // pretty-printed, not compact
    // Whitespace-normalized substring check (pretty inserts "key": value
    // with a space after the colon + indentation — compact doesn't) so this
    // doesn't hardcode the pretty-printer's exact spacing.
    ro squashed = pretty.replace(" ", "").replace("\n", "")
    assert(squashed.contains("\"done\":1"))
}
