// SPDX-License-Identifier: MIT OR Apache-2.0
// Flagship concurrent aggregator: HTTP server entry point.
//
// This is the demo server that serves the waterfall UI:
//   - `GET /` — embedded frontend
//   - `GET /api/snapshot` — fixed demo run (weather, seed=42)
//   - `GET /api/run?legend=&mode=&seed=` — fresh run, JSON snapshot
//   - `GET /api/events?legend=&mode=&seed=` — SSE replay of the same run
//
// Every endpoint is a `Router` route — no manual parsing/routing/wire
// formatting. HTTP handling (routing, request parsing, response serialization,
// SSE wire format) comes from the `http` package.
//
// `EXPECT_TIMEOUT_MS 5000` because `fn main` is a long-running server
// (accept loop) — `nova test` would hang without this marker.

module main

import ./domain.{Source, Report}
import ./app.{Emit, null_emit}
import ./app.{aggregate, weather_demo_sources, WEATHER_BUDGET_MS, health_demo_sources, HEALTH_BUDGET_MS, chaos_variant}
import ./app.{aggregate_live_health, aggregate_live_weather, health_live_sources, weather_live_sources}
import ./api.{build_snapshot, HandlersDto, snapshot_to_json}
import std.net.{SocketAddr, TcpListener, real_net, mock_net}
import std.os.{env, real_os}
import polaris.{Router, ServerRequest, ServerResponse, StreamBody, sse_event}
import polaris.serve.{handle_connection_router}
import std.time.duration
import std.runtime.sync.{AtomicInt}
import std.encoding.serde.{Serialize, json_encode}

// Loopback port: env override (`AGGREGATOR_PORT`) or this default.
//
// `int`, not `u16` (owner decision 2026-07-30): a `u16` boundary here is
// illusory type-safety — `AGGREGATOR_PORT=70000` → `to_int()` → 70000 →
// `as u16` truncates SILENTLY to 4464, the server comes up on the WRONG port
// with no diagnostic. `int` + `requires` (`SocketAddr.loopback`/`.any`/etc.,
// `std/net/addr.nv`) fails loudly, at the right place; for a literal port
// the contract is proved statically (D24 TrivialBackend), zero runtime cost.
const DEFAULT_PORT int = 8187

// [M-187-high-concurrency-connection-wedge] mitigation: max concurrent
// connections. Over budget: closed immediately (admission control).
const MAX_INFLIGHT_CONNS int = 16

// Live legends use a wall-clock (not simulated) budget — generous enough for
// a handful of real round-trips, still bounded (the real-cancel race,
// deliverable 1, applies here too — a hung real connection is genuinely cut
// off, not left to block the response forever).
const LIVE_BUDGET_MS = 4000

fn frontend_html() -> []u8 => embed("../frontend/index.html")

// No `as u16` cast — an out-of-range value (e.g. 70000) stays a plain `int`
// all the way to `SocketAddr.loopback`'s `requires` contract below, which
// panics loudly instead of the old silent truncate-and-bind-wrong-port.
fn resolve_port() Os -> int =>
    env("AGGREGATOR_PORT").flat_map(|s| s.to_int().ok()) ?? DEFAULT_PORT

// Bind address: env override (`AGGREGATOR_BIND`, e.g. "0.0.0.0" for Docker —
// `-p host:container` can't reach a loopback-bound listener) or the local
// dev default `127.0.0.1` (unchanged — see `docker/README.md`'s Dockerfile
// for the container-side override, `ENV AGGREGATOR_BIND=0.0.0.0`). A
// malformed value falls back to loopback too (honest default over a crash).
fn resolve_addr(port int) Os -> SocketAddr =>
    env("AGGREGATOR_BIND").flat_map(|host| "${host}:${port}".to_socket_addr().ok()) ?? SocketAddr.loopback(port)

// ── fn main: accept-loop (the only part that needs manual handling —
//    `http.servernet` has no reusable accept-loop function) ───────────

// [M-187-nested-spawn-scope-var-cc-fail] workaround: exactly ONE `spawn`
// holds the entire accept loop. Per-connection handling uses `detach { }`.
// [M-187-high-concurrency-connection-wedge] mitigation: admission control
// via `AtomicInt` permit counter — over budget: close immediately.
fn main() Time Detach {
    // Flat `with Os = ..., Net = ...` is equivalent to nested `with`
    // blocks, but clearer in the first example a reader sees.
    with Os = real_os(), Net = real_net() {
        ro port = resolve_port()
        ro addr = resolve_addr(port)
        // Listener lives entirely inside this fiber (same discipline as
        // `echo_server.nv` — mut-capture from a spawn would be illegal).
        consume lst = TcpListener.bind(addr) ?? panic("Failed to bind: ${port}")
        println("Nova flagship aggregator listening on http://${addr.ip()}:${lst.local_port()}")
        // Bounded-accept permit counter (see the marker note
        // above `fn main`) — `AtomicInt` is `#share` (D415), so
        // capturing it (by reference) into the per-connection
        // `detach { }` below to `fetch_sub` on completion is a
        // legal cross-fiber capture without a `consume`/channel
        // dance, same exemption `sync_test.nv`'s own fixtures
        // rely on.
        mut inflight = AtomicInt.new(0)
        mut running = true
        while running {
            match lst.accept() {
                Ok(consume stream) => {
                    if inflight.load() >= MAX_INFLIGHT_CONNS {
                        // Over budget: close immediately (admission
                        // control shed), no read/response attempted.
                        // nova:allow W_RESULT_DISCARDED
                        ro _ = stream.close()
                    } else {
                        ro _ = inflight.fetch_add(1)
                        detach consume stream {
                            ro _ = handle_connection_router(stream, routes())
                            ro _ = inflight.fetch_sub(1)
                        }
                    }
                }
                Err(_) => { running = false }
            }
        }
        lst.close()
    }
}

// ── Router: every endpoint is a route, no manual parsing/routing/wire ──────
// Routes here are static and known conflict-free by construction — `!!`
// unwraps `Router.@get`'s `Result` the way known-good registrations do.

fn routes() Time -> Router {
    mut r = Router.new()
    r.get("/", fn(_req ServerRequest) -> ServerResponse => ServerResponse.bytes(200, "text/html; charset=utf-8", frontend_html()))!!
    r.get("/api/snapshot", fn(_req ServerRequest) -> ServerResponse => snapshot_body("weather", "demo", 42))!!
    r.get("/api/run", fn(req ServerRequest) -> ServerResponse => snapshot_body(legend_of(req), mode_of(req), seed_of(req)))!!
    r.get("/api/events", fn(req ServerRequest) -> ServerResponse => events_body(legend_of(req), mode_of(req), seed_of(req)))!!
    r
}

fn legend_of(req ServerRequest) -> str => req.query_param("legend") ?? "weather"

fn mode_of(req ServerRequest) -> str => req.query_param("mode") ?? "demo"

fn seed_of(req ServerRequest) -> int {
    match req.query_param("seed") {
        Some(s) => s.to_int() ?? 42
        None    => 42
    }
}

// ── Run dispatch (legend x mode -> Report + context) ────────────────────────

/// One resolved run: the settled `Report`, the `sources` list that produced
/// it, the budget actually used (ms), and a description of the installed
/// handlers (UI effect-badge).
type RunResult value {
    ro report    Report
    ro sources   []Source
    ro budget_ms int
    ro handlers  HandlersDto
}

/// Same `aggregate()`/`aggregate_live_*` call — only the legend, mode, seed,
/// and the installed `Net` handler differ. The effect-system pitch made
/// concrete: ONE dispatcher, the `with Net = ...` per branch is the only
/// thing that changes.
fn run_net(legend str, mode str, seed int) Emit Time -> RunResult {
    if legend == "weather" {
        if mode == "live" {
            ro sources = weather_live_sources()
            ro report = with Net = real_net() { aggregate_live_weather(LIVE_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: LIVE_BUDGET_MS, handlers: { net: "real", time: "real" } }
        } else if mode == "chaos" {
            ro sources = chaos_variant(weather_demo_sources(), seed as u64)
            ro report = with Net = mock_net() { aggregate(sources, WEATHER_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: WEATHER_BUDGET_MS,
                handlers: { net: "mock(seed=${seed})", time: "real" } }
        } else {
            ro sources = weather_demo_sources()
            ro report = with Net = mock_net() { aggregate(sources, WEATHER_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: WEATHER_BUDGET_MS,
                handlers: { net: "mock(seed=42)", time: "real" } }
        }
    } else {
        // health (default legend for any unrecognized value — honest fallback,
        // not a 400: the UI never sends anything else, and a stray query
        // param typo shouldn't 500 the demo).
        if mode == "live" {
            ro sources = health_live_sources()
            ro report = with Net = real_net() { aggregate_live_health(LIVE_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: LIVE_BUDGET_MS, handlers: { net: "real", time: "real" } }
        } else if mode == "chaos" {
            ro sources = chaos_variant(health_demo_sources(), seed as u64)
            ro report = with Net = mock_net() { aggregate(sources, HEALTH_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: HEALTH_BUDGET_MS,
                handlers: { net: "mock(seed=${seed})", time: "real" } }
        } else {
            ro sources = health_demo_sources()
            ro report = with Net = mock_net() { aggregate(sources, HEALTH_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: HEALTH_BUDGET_MS,
                handlers: { net: "mock(seed=42)", time: "real" } }
        }
    }
}

// ── GET / (fallback) and /api/run: plain JSON snapshot ─────────────────────

/// `Emit` is discharged here (`with Emit = null_emit()`). `Time` is left
/// to the ambient runtime default.
fn snapshot_body(legend str, mode str, seed int) Time -> ServerResponse {
    ro rr = with Emit = null_emit() { run_net(legend, mode, seed) }
    ro seed_out = if mode == "live" { 0 } else { seed }
    ro dto = build_snapshot(rr.report, rr.sources, legend, mode, seed_out, rr.budget_ms, rr.handlers)
    ServerResponse.bytes(200, "application/json", snapshot_to_json(dto).bytes())
}

// ── JSON rendering: typed `std.encoding.serde.json_encode` ─────────────────
// All DTOs use `#impl(Serialize)` + `json_encode` — no hand-rolled JSON.

// ── GET /api/events: SSE replay of the run's Emit timeline ─────────────────

// One recorded `Emit` op, timestamped relative to the run's own start.
// Sent over a `Channel` (lane ops fire from worker fibers — a bare `mut`
// capture would be a data race) and drained only after `run_net` returns.
// Deliberately a heap record (not `value`): `Channel[T].try_send` needs a
// word-safe payload — a multi-field value-record is not word-safe, a heap
// record is always a pointer and fits in one word.
// `kind` is `#serde(skip)` — the SSE event name carries it.
// `error` is renamed (Rust-field `err`, wire `"error"`) and skipped when empty.
#impl(Serialize)
type EmitRecord {
    #serde(skip)
    ro kind       str    // "lane_started" | "lane_done" | "lane_failed" | "lane_cancelled"
    ro id         str
    ro elapsed_ms int
    #serde(rename = "error")
    #serde(skip_serializing_if = "is_empty")
    ro err        str    // "" unless kind == "lane_failed"
    ro t_ms       int
}

/// `EmitRecord` is a flat `Serialize` DTO of primitives — encode-failure
/// is structurally impossible.
fn emit_record_json(r EmitRecord) -> str =>
    json_encode(r) ?? panic("emit_record_json: EmitRecord is a flat Serialize DTO — encode must not fail")

/// `Emit` is discharged here (`with Emit = <recorder>`). `Time` is left
/// to the ambient runtime default.
fn events_body(legend str, mode str, seed int) Time -> ServerResponse {
    ro t0 Monotonic = Monotonic.now()
    ro (tx, rx) = Channel[EmitRecord].new(256)
    ro rr = with Emit = effect Emit {
        lane_started(id str, idx int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_started", id, elapsed_ms: 0, err: "", t_ms })
        }
        lane_done(id str, elapsed_ms int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_done", id, elapsed_ms, err: "", t_ms })
        }
        lane_failed(id str, err str, elapsed_ms int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_failed", id, elapsed_ms, err, t_ms })
        }
        lane_cancelled(id str, elapsed_ms int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_cancelled", id, elapsed_ms, err: "", t_ms })
        }
        swarm_done(_fanout int, _done int, _failed int, _cancelled int, _wall_ms int, _sequential_ms int) -> () {}
    } {
        run_net(legend, mode, seed)
    }
    tx.close()
    mut records []EmitRecord = []
    mut draining = true
    while draining {
        match rx.try_recv() {
            Some(r) => { records.push(r) }
            None    => { draining = false }
        }
    }
    ro total_ms = Monotonic.now().elapsed_since(t0).millis() as int
    ro seed_out = if mode == "live" { 0 } else { seed }
    ro dto = build_snapshot(rr.report, rr.sources, legend, mode, seed_out, rr.budget_ms, rr.handlers)

    mut chunks [][]u8 = []
    chunks.push(sse_event("replay_info", "{\"total_ms\":${total_ms},\"time_scale\":1}"))
    for r in records {
        chunks.push(sse_event(r.kind, emit_record_json(r)))
    }
    chunks.push(sse_event("run_summary", snapshot_to_json(dto)))
    ServerResponse.sse(StreamBody.from_chunks(chunks))
}
