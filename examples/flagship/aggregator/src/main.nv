// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: entry point (Ф.MVP-2 переделка).
//
// EXPECT_TIMEOUT_MS 5000 — `fn main()` below is a REAL long-running server
// (accept loop, never returns on its own): `nova test`'s default run-to-
// completion sweep (no test blocks, so it drives `fn main()` directly, same
// as any other entry-point-only `.nv` file) would hang forever waiting for
// exit, then hit a scheduler teardown crash on forced kill
// (`nova_sched_park: invalid scope/slot`) — this marker moves this file into
// the `TestType::Timeout` category, EXCLUDED from the default `{Positive}`
// selection (`nova test flagship/aggregator --strict-effects`, no `--timeout`/
// `--full`), same convention as nova-http's own live-socket smoke tests
// (`servernet/rt/handle_connection_smoke.nv`). Real end-to-end verification
// of this file happens via `nova build` + manual run + curl (see the
// package's own README "как это тестируется" / plan 187 gate step), not
// `nova test`'s run-to-completion sweep — this file has no `test { }` blocks
// of its own (the `build_snapshot`-driven field-population logic this
// file's handlers depend on is exercised by `src/api/report_json_test.nv`;
// this file's own hand-rendered JSON text layer,
// `[M-187-http-serde-setcookie-serialize-collision]` below, is covered by
// the smoke test — curl-diffing the wire bytes — not a `test{}` block).
//
// Owner requirement (hard, this rewrite's whole reason to exist): the PREVIOUS
// draft of this file (never committed — a from-scratch rewrite, not an edit)
// hand-rolled HTTP (`read_request_line`/`route`/`serialize_response`) while
// the `http` package sat right there unused. Manual parsing/routing/response-
// serialization/SSE-byte-framing is BANNED — the flagship's whole pitch is
// "a server in Nova = the `http` package + ~20 lines", not reinvented
// plumbing.
//
// This file now does ONLY wiring:
//   - a manual accept LOOP (legitimately hand-rolled — `http.servernet` has no
//     reusable accept-loop function yet, only single-shot `handle_connection`,
//     see that module's own header) that spawns
//     `http.servernet.handle_connection_router(stream, routes())` per connection;
//   - EVERY endpoint is a `Router` route (`http.server`, Plan 222 — replaces
//     the retired `ServeMux`) — routing, request
//     parsing, response serialization, and (for `/api/events`) the SSE wire
//     format all come from the `http` package.
//
// The one design fact that makes this possible: `http.server`'s `Handler` is
// a PURE closure type (`fn(ServerRequest) -> ServerResponse`, no effect row —
// `server.nv`'s own header explains why: CORE stays mock-testable without a
// runtime effect-handler stack). That looks like it would forbid a handler
// from ever calling `aggregate()` (`Net Time Emit`) — but a handler's BODY can
// open its own `with Net = mock_net()/real_net() { ... }` (+ `with Emit =
// ...`) and fully DISCHARGE those effects before returning its
// `ServerResponse`; the closure's OWN exposed type stays effect-free, same as
// any other fully-discharged effectful call (`aggregate_test.nv`'s `test { }`
// blocks do exactly this). Verified directly by this rewrite compiling/
// running (`nova test` gate) — the real handlers (`snapshot_body`/
// `events_body` below, wired as plain closures auto-lifted to Handler (D55)) ARE the proof.
// This is what lets `/api/run`/`/api/events` do PER-REQUEST fresh
// `aggregate()` calls (fresh `mode`/`seed`/live-vs-mock) from inside an
// otherwise-pure `Router` route, with no second dispatch mechanism needed
// alongside `Router`.
//
// `/api/events` is a SSE REPLAY, not a live per-request push: the whole run
// settles first (so the JSON `run_summary` + every lane's real `t_ms` are
// already known), then the FULL event list is handed to `http.server`'s
// `StreamBody.from_chunks` + `ServerResponse.sse` (`[M-178-server-streaming]`,
// landed) — `handle_connection` drives the true incremental chunked write
// over the socket, this file just builds the (already-complete) chunk list.
// A genuinely live push (chunks arriving AS lanes settle, mid-request) is a
// separate, already-scoped-out marker (`[M-187-sse-live-stream]`, plan 187
// §9.3 п.3, owner decision) — unrelated to today's http-package-only
// requirement, so no new marker here for it.
//
// Endpoints: `GET /` (embedded `frontend/index.html`), `GET /api/snapshot`
// (fallback: fixed weather/demo/seed=42 run), `GET /api/run?legend=&mode=
// &seed=` (fresh run, JSON snapshot — §9.5 wire contract, `report_json.nv`),
// `GET /api/events?legend=&mode=&seed=` (SSE replay of the same run's `Emit`
// timeline, real `t_ms` offsets).

module main

import ./domain.{Source, Report}
import ./app.{Emit, null_emit}
import ./app.{aggregate, weather_demo_sources, WEATHER_BUDGET_MS, health_demo_sources, HEALTH_BUDGET_MS, chaos_variant}
import ./app.{aggregate_live_health, aggregate_live_weather, health_live_sources, weather_live_sources}
import ./api.{build_snapshot, HandlersDto, snapshot_to_json}
import std.net.{SocketAddr, TcpListener, real_net, mock_net}
import std.os.{env, real_os}
import http.server.{Router, ServerRequest, ServerResponse, StreamBody, sse_event}
import http.serve.{handle_connection_router}
import std.time.duration
import std.runtime.sync.{AtomicInt}

// Loopback port: env override (`AGGREGATOR_PORT`) or this default.
const DEFAULT_PORT u16 = 8187

// [M-187-high-concurrency-connection-wedge] mitigation (bounded-accept,
// owner decision, 2026-07-16): max number of connections handled
// CONCURRENTLY at once (over budget: closed immediately, no queue — see
// the accept loop below). Architectural NOTE this constant's value pins
// down empirically: the wedge is NOT primarily about raw connection
// *count* (the OLD code already served connections one-at-a-time,
// sequentially, and still wedged around ~80 per
// `docs/plans/backlog-followups.md`) — it is about how many `aggregate()`
// calls' OWN internal fan-out (`parallel for` + `fetch_guarded`'s nested
// `supervised(deadline:)`, several fibers each) are alive in the scheduler
// AT THE SAME TIME. Measured directly on this machine (repeated
// `xargs -P80`/`-P200` bursts against this binary, `NOVA_WATCHDOG_DUMP_SECS`
// dumps on the wedged runs showing multiple workers'
// `STUCK_ALIVE_NOT_PARKED` fibers under `[supervised] ... pending_remote=1`
// — the same stale-slot symptom as the pre-existing marker below `main`):
// HISTORY: while the scheduler wedge was open, this constant was the
// mitigation — `= 2` was the empirical cliff (3+ reproduced a permanent
// wedge; see `docs/history/simplifications-closed.md`,
// `[M-187-high-concurrency-connection-wedge]`). The wedge's root cause
// (non-work-conserving nested `supervised` pump parking ready fibers of a
// SIBLING scope) is FIXED in the runtime (work-conserving pump,
// `nova_rt/runtime.c`, merge `14decdfb1`), gate-proven at width 16 with
// `xargs -P80`/`-P200` bursts (no permanent-000, full recovery). `16`
// (matching the runtime's worker-pool size) is now the real backpressure
// bound, not a wedge workaround: admission control stays because honestly
// rejecting excess load is the right behavior for a bounded demo server —
// re-run the burst gate if you change this.
const MAX_INFLIGHT_CONNS int = 16

// Live legends use a wall-clock (not simulated) budget — generous enough for
// a handful of real round-trips, still bounded (the real-cancel race,
// deliverable 1, applies here too — a hung real connection is genuinely cut
// off, not left to block the response forever).
const LIVE_BUDGET_MS = 4000

fn frontend_html() -> []u8 => embed("../frontend/index.html")

fn resolve_port() Os -> u16 =>
    env("AGGREGATOR_PORT").flat_map(|s| s.to_int().ok()).map(|n| n as u16) ?? DEFAULT_PORT

// Bind address: env override (`AGGREGATOR_BIND`, e.g. "0.0.0.0" for Docker —
// `-p host:container` can't reach a loopback-bound listener) or the local
// dev default `127.0.0.1` (unchanged — see `docker/README.md`'s Dockerfile
// for the container-side override, `ENV AGGREGATOR_BIND=0.0.0.0`). A
// malformed value falls back to loopback too (honest default over a crash).
fn resolve_addr(port u16) Os -> SocketAddr =>
    env("AGGREGATOR_BIND").flat_map(|host| SocketAddr.from_str("${host}:${port}").ok()) ?? SocketAddr.loopback(port)

// ── fn main: accept-loop (the only legitimately hand-rolled part — see the
//    file-header note: http.servernet has no reusable accept-loop function
//    yet) ────────────────────────────────────────────────────────────────

// [M-187-nested-spawn-scope-var-cc-fail]: **compiler codegen bug, NOT worked
// around in-place — the SHAPE below routes around it entirely (accept loop
// runs INSIDE one dedicated `spawn`, connections served SEQUENTIALLY, no
// nested spawn at all).** Two shapes tried before this one, both broken:
//   (1) `supervised { spawn { <accept-loop>; while running { ... Ok(stream)
//       => spawn { handle_connection(...) } ... } } }` — an acceptor fiber
//       that itself `spawn`s a per-connection worker fiber on every accepted
//       connection (`spawn` LEXICALLY NESTED inside another `spawn`, both
//       under one `supervised`). CC-FAILs: generated C (`main.c`) has the
//       OUTER spawn's own fiber function reference `&_nova_scope_q_6` (the
//       `supervised` scope variable, needed so the inner spawn can register
//       as a child of the SAME scope) — never threaded into the outer
//       spawn's own context struct — `error: use of undeclared identifier
//       '_nova_scope_q_6'`, 3 call sites.
//   (2) accept loop moved OUT of any `spawn`, directly into `supervised`'s
//       OWN body (reasoning: `.bind`/`.accept()` are ordinary suspending
//       `Net` ops, no fiber should be needed) + one spawn per connection
//       (sibling spawns, not nested — compiles and LINKS fine). Runtime
//       crash the INSTANT the binary actually runs, before even printing
//       the "listening on" line: `nova: nova_sched_park: invalid scope/slot`
//       — a blocking suspend (the first `.accept()`) directly on the fiber
//       that OWNS a `supervised` scope (not a properly spawned child of it)
//       corrupts the scheduler's slot bookkeeping. No existing example in
//       this codebase runs a blocking accept loop directly in `supervised`'s
//       own body either — every precedent (`echo_server.nv`,
//       `servernet/rt/handle_connection_smoke.nv`) wraps it in exactly ONE
//       `spawn`.
// Root cause of both not investigated further (compiler/runtime-side,
// `emit_c.rs`'s spawn-context-capture pass + `fibers.h`'s scope/slot
// bookkeeping — out of this package's remit). WORKAROUND (this shape):
// exactly ONE `spawn` (matching every proven precedent) holds bind + the
// WHOLE accept loop — the ONE known-good shape given the two failure modes
// above. Per-connection handling itself no longer needs a SECOND `spawn`
// nested under this one (see `[M-187-high-concurrency-connection-wedge]`
// mitigation note below — `detach { }` is used instead, a different
// codegen path with no `supervised`-scope-var to thread through, so this
// CC-fail plainly does not apply to it).
//
// [M-187-high-concurrency-connection-wedge] mitigation (bounded-accept,
// app-level, owner decision 2026-07-16): the OPEN architectural scheduler
// issue (`docs/plans/backlog-followups.md`, `examples/flagship/aggregator/
// README.md` "Известные ограничения") is that this binary's M:N runtime
// wedges PERMANENTLY (never recovers, not merely slow) once too many
// connections are in flight at once (~80 simultaneous reproduces it every
// time; ~40 shows transient backpressure that still recovers; ~20 is
// clean). The real fix is a scheduler-level park/join rework — tried in a
// separate research track, shelved there because it introduced memory
// corruption; the CURRENT runtime (busy-poll baseline, unchanged by this
// commit) is memory-safe, just has this concurrency ceiling. Mitigation
// (this file only, no runtime/compiler change): admission control BEFORE
// a connection is ever handed to a handler fiber at all — an
// `AtomicInt` permit counter (`MAX_INFLIGHT_CONNS`, see its own doc-comment
// above) is checked right after `accept()` returns; within budget, the
// connection is handled CONCURRENTLY via `detach { }` (D50 fire-and-forget
// — under this binary's armed M:N runtime that is a REAL worker-pool
// dispatch, `spec/decisions/06-concurrency.md` line ~426, not the
// synchronous `SyncDetach` test-only handler); over budget, the connection
// is closed immediately (honest reject — no unbounded queue, no attempt to
// read/respond, so none of the banned "hand-rolled HTTP" applies to the
// reject path either). This directly replaces the OLD per-connection
// `supervised { spawn { ... } }` shape (was: strictly SEQUENTIAL — see the
// retained `[M-187-sequential-2nd-request-hang]` note inside the loop below
// for why that shape existed) with bounded CONCURRENT handling — a real
// behavior change, empirically gated (this commit's own `loadtest.ps1` +
// concurrent-curl run, see the package README for the recorded before/
// after) precisely because trading "always safe, sometimes wedges dead at
// high connection counts" for "bounded-concurrent, verified to survive the
// same load" is the whole point of this mitigation.
fn main() Time Detach {
    with Os = real_os() {
        ro port = resolve_port()
        with Net = real_net() {
            ro addr = resolve_addr(port)
            supervised {
                spawn {
                    // Plan 173.3 (D415 §2): listener lives ENTIRELY inside
                    // this fiber (same discipline as echo_server.nv) — a
                    // mut-capture of an outer listener from spawn's body
                    // would be E_CONCURRENT_MUT_CAPTURE.
                    consume lst = match TcpListener.bind(addr) {
                        Ok(consume l)  => l
                        Err(_) => panic("Failed to bind: ${port}")
                    }
                    println("Nova flagship aggregator listening on http://${addr.ip()}:${lst.local_port()}")
                    // Bounded-accept permit counter (see the marker note
                    // above `fn main`) — `AtomicInt` is `#share` (D415), so
                    // capturing it (by reference) into the per-connection
                    // `detach { }` below to `fetch_sub` on completion is a
                    // legal cross-fiber capture without a `consume`/channel
                    // dance, same exemption `sync_test.nv`'s own fixtures
                    // rely on.
                    mut inflight = AtomicInt.new(0)
                    mut running = true
                    while running {
                        match lst.accept() {
                            Ok(consume stream) => {
                                if inflight.load() >= MAX_INFLIGHT_CONNS {
                                    // Over budget: honest reject, no queue —
                                    // close immediately, no read/response
                                    // attempted (not "manual HTTP", nothing
                                    // is parsed/routed/serialized on this
                                    // path at all).
                                    // best-effort close при сбросе сверх-лимитного
                                    // соединения (admission control shed): ошибку
                                    // закрытия некуда репортить и незачем.
                                    // nova:allow W_RESULT_DISCARDED -- намеренный дроп: best-effort close при shed
                                    ro _ = stream.close()
                                } else {
                                    ro _ = inflight.fetch_add(1)
                                    // [M-187-sequential-2nd-request-hang]'s
                                    // OLD per-connection `supervised {
                                    // spawn { ... } }` (strictly sequential
                                    // — accept loop blocked on this
                                    // connection's own join before the next
                                    // `accept()`) is replaced by `detach { }`
                                    // here: bounded CONCURRENT handling, see
                                    // `[M-187-high-concurrency-connection-
                                    // wedge]` mitigation note above `fn
                                    // main`. The permit is released inside
                                    // the detached body itself (fiber that
                                    // finishes the connection is the one
                                    // that frees its own slot).
                                    //
                                    // [M-detach-consume-escape-unchecked]
                                    // (closed): `stream` is a `consume`-typed
                                    // `TcpStream` bound by the `Ok(consume
                                    // stream)` match-arm ABOVE — an
                                    // enclosing scope relative to this
                                    // `detach`. A bare `detach { …stream… }`
                                    // captured it BY REFERENCE from that
                                    // enclosing scope: `detach` is a
                                    // fire-and-forget orphan fiber (D50) that
                                    // may run AFTER the match-arm's own scope
                                    // has already exited → use-after-consume/
                                    // use-after-free — a real gap the
                                    // compiler did not catch (`spawn consume`
                                    // already caught the symmetric case,
                                    // D415 §4; `detach` did not, until the
                                    // D415 §4 extension that added this
                                    // diagnostic —
                                    // `E_LINEAR_CAPTURE_IN_FIBER`,
                                    // `types/mod.rs`
                                    // `check_capture_boundary`/
                                    // `ScopeBinding.linear_pattern`). Fix:
                                    // explicit `detach consume stream { … }`
                                    // — ownership of `stream` moves INTO the
                                    // orphan fiber; the fiber is now the sole
                                    // owner for the rest of its own body, so
                                    // it outliving the match-arm's scope is
                                    // no longer a use-after-free.
                                    detach consume stream {
                                        // `routes()` is cheap (a handful of
                                        // `Router` entries) — rebuilt per
                                        // connection, same shape as
                                        // nova-http's own
                                        // servernet/rt/handle_connection_smoke.nv.
                                        ro _ = handle_connection_router(stream, routes())
                                        ro _ = inflight.fetch_sub(1)
                                    }
                                }
                            }
                            Err(_) => { running = false }
                        }
                    }
                    lst.close()
                }
            }
        }
    }
}

// [M-187-supervised-nested-fiber-slot-race]: **UPDATE 2026-07-16 — this
// specific bug (the sequential-request hang described below) is CLOSED ✅
// (README "Стабильность сервера": 83.4.5.12, a runtime-side fix, unrelated
// to this file's own shape). The per-connection `supervised { spawn {
// ... } }` wrapper this note originally justified is GONE (bounded-accept
// mitigation above `fn main` replaced it with `detach { }`) — the
// narrative below is kept as history (why sequential-per-connection was
// ever the shape, and why the wrapper existed) but no longer describes
// live code in this file.** Historical text follows, unedited.**
//
// runtime bug (fiber
// scheduler, `nova_rt/fibers.h`-family — NOT a `compiler-codegen` codegen
// bug, NOT worked around in-place, NOT fully eliminated — MITIGATED only,
// disclosed honestly.** With THIS file serving many SEQUENTIAL HTTP
// requests over the LIFETIME of one process (each request's handler running
// `aggregate()`'s own `parallel for` + `fetch_guarded`'s nested
// `supervised(deadline:)`), the server intermittently hangs on some later
// request — `NOVA_RUNTIME_DUMP` (`SIGABRT`-adjacent watchdog dump,
// `nova_sched_park`-family) shows `[supervised] ... pending_remote=1` with
// `count=0`: a child scope's slot never gets marked done. Reproduced with
// `nova build` + repeated `curl`: usually the 2nd request hangs, sometimes
// the 3rd–7th, occasionally ten-plus requests run clean — the exact
// frequency shifted (worse) under heavier concurrent CPU load on this dev
// machine (other unrelated `nova` builds running in parallel worktrees) in
// this session's own testing, so contention is plausibly a contributing
// factor to the TIMING — but the runtime's OWN 5s watchdog fired every
// time this was hit, actively diagnosing a permanently-stuck slot (not
// merely "still running, just slow": `curl` was given up to 10s, well past
// the watchdog's own 5s, and never got a response) — genuinely
// PROBABILISTIC, matching the shape of this codebase's own documented M:N
// stale-slot race class (`docs/cases/mn-race-stale-slot-2026-05.md`) rather
// than a deterministic logic bug. `aggregate_test.nv`'s OWN 17-test suite
// calls `aggregate()` repeatedly within ONE test-binary process and never
// hits this — the difference this file introduces is DEPTH: a `spawn` many
// layers deep (`main`'s own `supervised{spawn{...}}` accept-loop +
// PER-CONNECTION `supervised{spawn{...}}` + `aggregate`'s OWN internal
// `parallel for`'s implicit scope + `fetch_guarded`'s
// `supervised(deadline:)`) — a nesting depth no existing test in this
// codebase exercises. Tried and kept: wrapping each connection in its OWN
// self-contained `supervised{spawn{...}}` (this file's current shape, see
// `[M-187-nested-spawn-scope-var-cc-fail]` above) — REDUCES the observed
// hang frequency relative to a bare `handle_connection(...)` call with NO
// wrapper at all (that shape hung reproducibly on request #2, both tries),
// but does NOT eliminate it. Root cause not investigated further (runtime
// C-side, `nova_rt/fibers.h`'s scope/slot bookkeeping under repeated nested
// `supervised` — well outside a `.nv`-only package's remit; a real fix
// likely needs the fiber scheduler's own maintainer). Practical impact,
// disclosed in the package README: this demo server may need an occasional
// restart under sustained interactive use until this is fixed upstream —
// NOT a fake/degraded demo (every SUCCESSFUL response is fully real,
// concurrent `aggregate()` output, nothing faked to route around this), a
// genuine reliability caveat.

// ── Router: every endpoint is a route, no manual parsing/routing/wire ──────
// (Plan 222: migrated off the retired `ServeMux` — segment-trie `Router`,
// nova-http `server_router.nv`. Routes here are static and known conflict-
// free by construction (four distinct literal paths, no shared `{param}`/
// `{*catch-all}` slots) — `!!` unwraps `Router.@get`'s `Result` the same way
// `router_test.nv`'s own fixtures do for statically-known-good registrations.)

fn routes() Time -> Router {
    mut r = Router.new()
    r.get("/", fn(_req ServerRequest) -> ServerResponse => ServerResponse.bytes(200, "text/html; charset=utf-8", frontend_html()))!!
    r.get("/api/snapshot", fn(_req ServerRequest) -> ServerResponse => snapshot_body("weather", "demo", 42))!!
    r.get("/api/run", fn(req ServerRequest) -> ServerResponse => snapshot_body(legend_of(req), mode_of(req), seed_of(req)))!!
    r.get("/api/events", fn(req ServerRequest) -> ServerResponse => events_body(legend_of(req), mode_of(req), seed_of(req)))!!
    r
}

fn legend_of(req ServerRequest) -> str => req.query_param("legend") ?? "weather"
fn mode_of(req ServerRequest) -> str => req.query_param("mode") ?? "demo"

fn seed_of(req ServerRequest) -> int {
    match req.query_param("seed") {
        Some(s) => match s.to_int() { Ok(n) => n, Err(_) => 42 }
        None    => 42
    }
}

// ── Run dispatch (legend x mode -> Report + context) ────────────────────────

/// One resolved run: the settled `Report`, the `sources` list that produced
/// it (for `report_json.nv`'s id-keyed `kind`/`probes` lookup), the budget
/// actually used (ms), and a description of the installed handlers (UI
/// effect-badge, plan 187 §9.4 деливерабл 11 — wave 2, field carried now).
type RunResult value {
    ro report    Report
    ro sources   []Source
    ro budget_ms int
    ro handlers  HandlersDto
}

/// Same `aggregate()`/`aggregate_live_*` call, only `legend`/`mode`/`seed`
/// (and, for `mode=live`, which real fetcher) differ — the effect-system
/// pitch made concrete: ONE dispatcher, the `with Net = ...` (or which
/// `aggregate_*` fn) installed per branch is the only thing that changes.
/// `Emit`/`Time` stay UNDISCHARGED here (declared in the row) — `Time` has
/// no `with Time = ...` anywhere in this package (no real-clock handler
/// factory exists in `std.time`, matching every other production call site
/// in this package, e.g. `aggregate.nv`'s own `deadline_elapsed_ms`/
/// `fetch_one` — `Time` just propagates up to the ambient runtime default,
/// same as `Net`/`Emit` propagate up to whatever `main()` eventually
/// installs). The two callers below (`snapshot_body`/`events_body`) install
/// different `Emit` handlers (`null_emit()` vs a real recorder) and, between
/// them, fully discharge `Time` too — see those functions' own notes.
fn run_net(legend str, mode str, seed int) Emit Time -> RunResult {
    if legend == "weather" {
        if mode == "live" {
            ro sources = weather_live_sources()
            ro report = with Net = real_net() { aggregate_live_weather(LIVE_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: LIVE_BUDGET_MS, handlers: { net: "real", time: "real" } }
        } else if mode == "chaos" {
            ro sources = chaos_variant(weather_demo_sources(), seed as u64)
            ro report = with Net = mock_net() { aggregate(sources, WEATHER_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: WEATHER_BUDGET_MS,
                handlers: { net: "mock(seed=${seed})", time: "real" } }
        } else {
            ro sources = weather_demo_sources()
            ro report = with Net = mock_net() { aggregate(sources, WEATHER_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: WEATHER_BUDGET_MS,
                handlers: { net: "mock(seed=42)", time: "real" } }
        }
    } else {
        // health (default legend for any unrecognized value — honest fallback,
        // not a 400: the UI never sends anything else, and a stray query
        // param typo shouldn't 500 the demo).
        if mode == "live" {
            ro sources = health_live_sources()
            ro report = with Net = real_net() { aggregate_live_health(LIVE_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: LIVE_BUDGET_MS, handlers: { net: "real", time: "real" } }
        } else if mode == "chaos" {
            ro sources = chaos_variant(health_demo_sources(), seed as u64)
            ro report = with Net = mock_net() { aggregate(sources, HEALTH_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: HEALTH_BUDGET_MS,
                handlers: { net: "mock(seed=${seed})", time: "real" } }
        } else {
            ro sources = health_demo_sources()
            ro report = with Net = mock_net() { aggregate(sources, HEALTH_BUDGET_MS.to_millis()) }
            RunResult { report, sources, budget_ms: HEALTH_BUDGET_MS,
                handlers: { net: "mock(seed=42)", time: "real" } }
        }
    }
}

// ── GET / (fallback) and /api/run: plain JSON snapshot ─────────────────────

/// `Emit` is discharged here (`with Emit = null_emit()`); `Time` stays
/// declared (ambient default, see `run_net`'s own note) — probing whether
/// `Handler` (`fn(ServerRequest) -> ServerResponse`) tolerates a
/// default-only remaining row.
fn snapshot_body(legend str, mode str, seed int) Time -> ServerResponse {
    ro rr = with Emit = null_emit() { run_net(legend, mode, seed) }
    ro seed_out = if mode == "live" { 0 } else { seed }
    ro dto = build_snapshot(rr.report, rr.sources, legend, mode, seed_out, rr.budget_ms, rr.handlers)
    ServerResponse.bytes(200, "application/json", snapshot_to_json(dto).bytes())
}

// ── JSON rendering: typed `std.encoding.serde.json_encode` ─────────────────
//
// [M-187-http-serde-setcookie-serialize-collision]: RESOLVED — root cause was
// NOT a per-call dispatch mis-resolution in `emit_c.rs` (the family this
// marker's name suggested, cf. 196.7/98e3663cc). `nova build` (`cmd_build`,
// nova-cli/src/main.rs) never called `auto_derive::inject_synthesized_
// methods_filtered` for `#impl(Serialize)` — unlike `nova test`'s
// `test_runner.rs` pipeline, which already did. The checker validates
// `v.serialize(s)` against a derived signature computed ON-DEMAND
// (`AutoDeriveQueryBridge`) without ever adding a real `FnDecl` to
// `module.items` on the build path — so codegen's method registration
// (`method_overloads`/`mono_method_decls`) had NOTHING under
// `(RecordType, "serialize")`, and the call fell through every receiver-
// typed dispatch window straight into the single-key, name-only
// `method_receivers` last-wins fallback, which picked whatever OTHER
// concrete `@serialize` was registered last in the compile unit — `http`'s
// unrelated `SetCookie @serialize() -> str` (RFC 6265bis Set-Cookie
// serialization), pulled in transitively by any `http.*` import. Fixed by
// adding the same injection call to `cmd_build` (mirrors `test_runner.rs`);
// no `emit_c.rs` change needed — the existing type-directed dispatch already
// resolves correctly once the derived method is a real, registered `FnDecl`.
// This file now routes `SnapshotDto` through `snapshot_to_json` (already
// typed, `report_json.nv`) instead of the hand-written string renderers this
// workaround used. `EmitRecord`'s SSE payload (`emit_record_json` below)
// stays hand-written — a deliberate wire-shape choice, not a workaround; see
// that function's own note.

fn json_escape(s str) -> str => s.replace("\\", "\\\\").replace("\"", "\\\"")

// ── GET /api/events: SSE replay of the run's Emit timeline ─────────────────

// One recorded `Emit` op, timestamped relative to the run's OWN start (`t0`,
// captured before `run_net` is called) — real `Emit`-fired wall-clock
// offsets, not synthesized. Sent over a `Channel` (D415: `lane_*` ops fire
// from worker fibers, a bare `mut` capture would be a data race) and drained
// only AFTER `run_net` returns (every lane already joined by then — race-free,
// same reasoning as `aggregate_test.nv`'s own Emit tests).
//
// Deliberately a HEAP record (`type X { … }`, no `value` — D290/02-types.md
// §2694-2708), NOT a value-record: `Channel[T].try_send` requires a
// word-safe (pointer-sized) payload (`[M-channel-generic-elem-type]`,
// already documented in nova-http's `server/streaming_test.nv`) — the
// runtime channel slot is a single `nova_int`-sized word, and a multi-`str`-
// field value-record is NOT word-safe (`E_CHANNEL_UNSOUND_ELEM_TYPE`, hit
// directly by this file before this fix). A heap record is ALWAYS a bare
// `Nova_<X>*` pointer (same representation class as the sum-type `TaskStatus`
// this package already threads through `Channel[TaskStatus]` in
// `aggregate.nv`'s `fetch_guarded`), so it fits the one supported multi-field
// shape without changing the field-access call sites below at all.
type EmitRecord {
    ro kind       str    // "lane_started" | "lane_done" | "lane_failed" | "lane_cancelled"
    ro id         str
    ro elapsed_ms int
    ro err        str    // "" unless kind == "lane_failed"
    ro t_ms       int
}

// Wire payload for one replayed event (SSE `data:` line). Hand-rendered —
// NOT `#impl(Serialize)` + `json_encode`, unlike `SnapshotDto` above
// (`[M-187-http-serde-setcookie-serialize-collision]` — RESOLVED, that WAS
// the compiler bug this file used to work around). Kept hand-written here on
// PURPOSE, not as a bug workaround: the wire shape conditionally OMITS
// `"error"` unless `kind == "lane_failed"` (plain record-derive would always
// emit it, e.g. `"error":""`, changing the SSE contract the frontend
// consumes) — follow-up (not this fix's scope): migrate to typed serde via
// an `Option[str]` err field / a custom `#impl(Serialize)` body once one of
// those shapes is confirmed frontend-compatible.
fn emit_record_json(r EmitRecord) -> str {
    ro err_field = if r.kind == "lane_failed" {
        ",\"error\":\"${json_escape(r.err)}\""
    } else {
        ""
    }
    "{\"id\":\"${json_escape(r.id)}\",\"elapsed_ms\":${r.elapsed_ms}${err_field},\"t_ms\":${r.t_ms}}"
}

/// `Emit` is discharged here (`with Emit = <recorder>`); `Time` stays
/// declared, same as `snapshot_body`.
fn events_body(legend str, mode str, seed int) Time -> ServerResponse {
    ro t0 Monotonic = Monotonic.now()
    ro { tx, rx } = Channel.new(256)
    ro rr = with Emit = effect Emit {
        lane_started(id str, idx int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_started", id, elapsed_ms: 0, err: "", t_ms })
        }
        lane_done(id str, elapsed_ms int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_done", id, elapsed_ms, err: "", t_ms })
        }
        lane_failed(id str, err str, elapsed_ms int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_failed", id, elapsed_ms, err, t_ms })
        }
        lane_cancelled(id str, elapsed_ms int) -> () {
            ro t_ms = Monotonic.now().elapsed_since(t0).millis() as int
            ro _ = tx.try_send(EmitRecord { kind: "lane_cancelled", id, elapsed_ms, err: "", t_ms })
        }
        swarm_done(_fanout int, _done int, _failed int, _cancelled int, _wall_ms int, _sequential_ms int) -> () {}
    } {
        run_net(legend, mode, seed)
    }
    tx.close()
    mut records []EmitRecord = []
    mut draining = true
    while draining {
        match rx.try_recv() {
            Some(r) => { records.push(r) }
            None    => { draining = false }
        }
    }
    ro total_ms = Monotonic.now().elapsed_since(t0).millis() as int
    ro seed_out = if mode == "live" { 0 } else { seed }
    ro dto = build_snapshot(rr.report, rr.sources, legend, mode, seed_out, rr.budget_ms, rr.handlers)

    mut chunks [][]u8 = []
    chunks.push(sse_event("replay_info", "{\"total_ms\":${total_ms},\"time_scale\":1}"))
    for r in records {
        chunks.push(sse_event(r.kind, emit_record_json(r)))
    }
    chunks.push(sse_event("run_summary", snapshot_to_json(dto)))
    ServerResponse.sse(StreamBody.from_chunks(chunks))
}
