// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: domain types.
//
// Pure data, no effects. Shared by the backend (aggregate.nv), the synthetic
// scenarios (scenarios.nv), and the JSON snapshot (report_json.nv).
//
// [M-187-errorkind-parsejsonerror-variant-collision]: split into its OWN
// folder-module (`src.domain`, separate from `src.app`) specifically so
// `src/api/report_json.nv` (needs these types + `std.encoding.serde`'s
// `json_encode`, which transitively pulls `std.encoding.json.ParseJsonError`)
// does NOT also pull in `src/app/aggregate.nv`/`live.nv`'s `std.net` import
// (which transitively pulls `std.io.error.ErrorKind`, same file as
// `IoError`) into the SAME compile unit — see `report_json_test.nv`'s own
// file-header note for the full collision writeup (two unrelated sum types
// each declaring a variant literally named `UnexpectedEof`, one 0-arg, one
// 2-arg — a same-CU cross-type codegen bug, not fixed in-place, compiler-side,
// out of this package's remit). `src/app/*.nv` (which DOES need `std.net`)
// imports these types back via `../domain.{...}` — no behavior change, pure
// module-boundary move.

module domain

// ── Source ───────────────────────────────────────────────────────────────

/// One fan-out source (a city for the weather legend, a domain for the
/// health-check legend, ...). `latency_ms`/`should_fail` are the Demo/Chaos
/// simulation knobs (see aggregate.nv `fetch_one` — plan 187 §7 item 6, this
/// is the "seeded-latency wrapper" applied at the call-site, not inside a
/// custom `Net` handler; owner sign-off on the final API shape is pending).
export type Source value {
    ro id          str      // display name (city / domain / model)
    ro detail      str      // secondary info shown in the UI ("7 days" / "3 checks")
    ro sub_count   int      // sub-request count (waterfall notch count)
    ro latency_ms  int      // simulated total latency before settling
    ro should_fail bool     // simulated upstream failure (503/timeout-shaped)
}

#stable(since = "0.1")
export fn Source.new(id str, detail str, sub_count int, latency_ms int, should_fail bool) -> Source =>
    { id, detail, sub_count, latency_ms, should_fail }

// ── Fetch result ─────────────────────────────────────────────────────────

/// Bytes fetched for one source (payload content is not domain-meaningful —
/// the demo cares about timing/outcome, not the byte content).
export type SourceData value {
    ro id      str
    ro payload []u8
}

/// Aggregate-domain error surface (`Fail[AggError]` — plan 187 §6.4 signature).
export type AggError enum
    | Upstream(str)     // simulated/real upstream failure — carries the source id
    | Transport(str)    // Net-effect error surfaced as text (NetError.to_str())

#stable(since = "0.1")
export fn AggError @to_str() -> str {
    match @ {
        Upstream(id)  => "upstream failure: ${id}"
        Transport(msg) => "transport error: ${msg}"
    }
}

// ── Per-task outcome ─────────────────────────────────────────────────────

/// Mirrors the waterfall UI states (mockup: done / fail / cancel).
///
/// **`Cancelled` is a REAL runtime cancel** (plan 187 Ф.MVP-2 деливерабл 1,
/// 2026-07-14 — see aggregate.nv's file header for the full story).
/// `aggregate.nv`'s `fetch_guarded` races each lane's fetch against a real
/// `supervised(deadline:)` (D408) scope sharing one absolute deadline; a
/// lane still in flight when the deadline hits is genuinely interrupted (its
/// `Time.sleep`/`Net` op is cut short, the underlying fetch is abandoned, no
/// Done/Failed payload is ever produced for it) — `wall_ms` for a fan-out
/// with a straggler is bounded by the shared `budget`, not by the slowest
/// source. (Earlier, 2026-07-12 resumption-6: this was a self-checked SOFT
/// deadline — let the fetch run to completion, then relabel after the fact
/// — dropped once the `[M-178-server-graceful-deadline]` fibers.h fix
/// (`Time.sleep` now re-checks `cancel_requested` on every park return) made
/// the real cancel race-free.)
export type TaskStatus enum
    | Done(SourceData)
    | Failed(str)
    | Cancelled

/// One settled lane in the waterfall.
export type TaskResult value {
    ro id         str
    ro status     TaskStatus
    ro elapsed_ms int
}

#stable(since = "0.1")
export fn TaskResult @is_done() -> bool =>
    match @status { Done(_) => true, Failed(_) => false, Cancelled => false }
#stable(since = "0.1")
export fn TaskResult @is_failed() -> bool =>
    match @status { Done(_) => false, Failed(_) => true, Cancelled => false }
#stable(since = "0.1")
export fn TaskResult @is_cancelled() -> bool =>
    match @status { Done(_) => false, Failed(_) => false, Cancelled => true }

// ── Report ───────────────────────────────────────────────────────────────

/// The killer-narrative output: `aggregate(sources, budget) Net Time -> Report`.
export type Report value {
    ro results      []TaskResult
    ro wall_ms       int
    ro sequential_ms int
    ro done          int
    ro failed        int
    ro cancelled     int
}

/// Build a `Report` from settled task results + measured wall time. The
/// sequential estimate is the sum of every lane's own elapsed time (what a
/// one-source-at-a-time loop would have cost) — the "×N faster" HUD figure.
/// Канон nv-coding-style §1а (2026-07-18): метод на источнике вместо
/// статик-конверсии `Report.from` (W_STATIC_CONVERSION).
///
/// [M-slice-ext-receiver-for-in-elem-type] gate carrier: `for r in @` iterates
/// the BARE slice-extension receiver directly (fixed 2026-07-18 —
/// compiler-codegen/src/types/mod.rs `f1_check_fn`, scope["@"] now carries the
/// receiver's real structured type instead of a flattened "[]T" spelling the
/// for-in element-type inference didn't recognize).
#stable(since = "0.1")
export fn []TaskResult @to_report(wall_ms int) -> Report {
    mut done = 0
    mut failed = 0
    mut cancelled = 0
    mut sequential_ms = 0
    for r in @ {
        sequential_ms += r.elapsed_ms
        match r.status {
            Done(_)    => { done += 1 }
            Failed(_)  => { failed += 1 }
            Cancelled  => { cancelled += 1 }
        }
    }
    { results: @, wall_ms, sequential_ms, done, failed, cancelled }
}
