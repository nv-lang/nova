// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 187 — flagship concurrent aggregator: LIVE legend tests (offline).
//
// Per plan 187 §9.4 деливерабл 5: "сетевые тесты в test-блоки не вносить —
// гейт должен быть зелёным офлайн; live-пути покрыть мок-тестами хендлер-
// подменой." These tests substitute `with Net = mock_net()` (D361 mock-
// first — `lookup`/`connect`/`read`/`close` all stubbed, no socket) for
// `aggregate_live_health`'s SHAPE (fan-out size, deadline/cancel wiring) —
// they do NOT reach `github.com`/etc for real; a manual `nova build` +
// run against real `real_net()` (see PROGRESS-run-A.md for the transcript)
// is how the ACTUAL live network path was verified this session.
// `aggregate_live_weather` was BLOCKED (`[M-187-weather-live-tls-diamond-
// blocked]`) until 2026-07-17 — its test used to pin the honest-fail
// contract. The diamond is RESOLVED (live.nv header; tls v0.1.2 lock bump):
// the weather path now runs the REAL TLS pipeline, so under mock_net lanes
// fail at the TLS layer (mock TCP can't handshake), NOT with the old
// blocker hint — the test below pins exactly that: settled lanes, no
// resurrected blocker marker.

module app

import ../domain.{Source}
import std.net.{mock_net}

// ── live health: mock_net exercises the SAME fan-out/cancel shape ──────────

test "aggregate_live_health: mock_net — fans out across all live hosts, settles" {
    with Net = mock_net() {
        with Emit = null_emit() {
            ro report = aggregate_live_health(5.to_seconds())
            assert(report.results.len() == health_live_hosts().len())
            // mock_net's connect always succeeds — every lane should settle Done
            // well within a 5s budget.
            assert(report.done == health_live_hosts().len())
            assert(report.failed == 0)
            assert(report.cancelled == 0)
        }
    }
}

test "aggregate_live_health: mock_net — a tiny budget cancels every lane" {
    with Net = mock_net() {
        with Emit = null_emit() {
            // 0ns budget: every lane's deadline has already elapsed at spawn.
            ro report = aggregate_live_health(0.to_millis())
            assert(report.results.len() == health_live_hosts().len())
            assert(report.done + report.failed + report.cancelled == health_live_hosts().len())
        }
    }
}

// ── live weather: diamond resolved — real TLS path, offline-safe shape ─────

test "aggregate_live_weather: mock_net — lanes settle; blocker hint is gone (diamond resolved)" {
    with Net = mock_net() {
        with Emit = null_emit() {
            ro report = aggregate_live_weather(5.to_seconds())
            assert(report.results.len() == weather_live_cities().len())
            // Every lane settles one way or another (fan-out contract holds)…
            assert(report.done + report.failed + report.cancelled == weather_live_cities().len())
            // …and NO lane resurrects the retired blocker marker: the weather
            // path runs the real TLS pipeline now (mock TCP fails the
            // handshake honestly, message is a TLS/transport error).
            for r in report.results {
                match r.status {
                    Failed(m) => assert(!m.contains("M-187-weather-live-tls-diamond-blocked"))
                    _         => {}
                }
            }
        }
    }
}

// ── live source tables (kind/probes for report_json.nv's id-lookup) ───────

test "health_live_sources: one Source per health_live_hosts entry, matching ids" {
    ro srcs = health_live_sources()
    assert(srcs.len() == health_live_hosts().len())
    assert(srcs[0].id == health_live_hosts()[0])
}

test "weather_live_sources: one Source per weather_live_cities entry, matching ids" {
    ro srcs = weather_live_sources()
    assert(srcs.len() == weather_live_cities().len())
    assert(srcs[0].id == weather_live_cities()[0].0)
}
