// Plan 187 — flagship concurrent aggregator: the backend.
//
// Killer-narrative signature (research 15 §6.4 / plan 187 §0):
//
//     fn aggregate(sources []Source, budget Duration) Net Time -> Report
//
// (`Emit` is ALSO in the real effect row below — the owner's plan 187 §7
// item 1 decision, locked for this session: progress events are a real
// effect, not a channel; see emit.nv. It is left out of the "headline"
// signature quoted above because that one line is reused verbatim across
// docs/research 15 and the mockup's on-screen `<code>` line — Emit is an
// implementation/observability detail of THIS package, not the one-sentence
// pitch. `null_emit()` is the ambient default, so this is not a breaking
// addition to the narrative — every existing call site still reads as
// "Net Time -> Report" unless it opts into watching progress.)
//
// Fan-out by N sources with a SHARED budget, concurrent (`parallel for`),
// 0 leaks.
//
// **Real runtime-cancel (plan 187 Ф.MVP-2 деливерабл 1, 2026-07-14):**
// `fetch_guarded` now races each lane's `fetch_one` against a REAL
// `supervised(deadline:)` (D408) scope — a shared ABSOLUTE `Monotonic`
// deadline (`aggregate`'s own `t0 + budget`, computed once, D408 "deadline:
// canon" — an absolute point, not a per-lane relative interval, so lane
// start-up jitter doesn't skew the shared budget). A late lane's `fetch_one`
// (in particular an in-flight `Time.sleep`) is genuinely INTERRUPTED at the
// deadline — the `[M-178-server-graceful-deadline]` fibers.h fix (re-check
// `cancel_requested` after every park return, `std/concurrency/
// supervised_deadline_test.nv` test 8, landed before this session) is
// exactly the unblock this needed. Verified (`--strict-effects` gate below,
// `wall_ms < budget + slack` test in aggregate_test.nv): a lane whose
// simulated latency is 10× the shared budget still settles `Cancelled`
// within the budget's own window, not after running to completion — the
// EARLIER (2026-07-12, resumption-6) self-checked "let it finish, relabel
// after the fact" simplification is gone; `wall_ms` for a fan-out with a
// straggler is now genuinely bounded by `budget`, not by the slowest source.
// The per-lane race is structured as `with Fail[TimeoutError] = |_| {...}
// { supervised(deadline: shared_deadline) { spawn { ...; tx.try_send(...) }
// } }` — the spawned child hands its outcome back over a `Channel[
// TaskStatus]` (D415 sanctioned handoff, same idiom `parallel for` itself
// uses internally); a caught `TimeoutError` (or an empty channel — belt and
// suspenders) relabels the lane `Cancelled`. `fetch_guarded` itself still
// never THROWS out to its own `parallel for` iteration slot — the
// `Fail[TimeoutError]` catch is fully local to this fn — so the swarm-level
// "child error cancels siblings, array not returned" `parallel for`
// semantics (spec/decisions/06-concurrency.md §"parallel for") is never
// triggered by a late lane; every lane always contributes a `TaskResult`.
// See also `domain.nv`'s `TaskStatus.Cancelled` doc comment (updated
// alongside this change).
//
// `fetch_one` performs a REAL `Net` byte-surface round-trip (connect / read /
// close) — the SAME code runs under `mock_net()` (Demo/Chaos, this package)
// or `real_net()` (Live, deferred — plan 187 §3 Ф.3a/b). The simulated
// latency/failure for Demo/Chaos is injected at the call site via `Time.sleep`
// + an early `Result::Err` return (NOT `throw`/`Fail[AggError]` — see
// `[M-flagship-spawn-throw-segfault]` below for why — and NOT inside a
// custom `Net` handler either) — this is this session's answer to plan 187
// §7 item 6 ("seeded-latency wrapper — form of the API"); the owner may
// prefer a dedicated `seeded_net(seed, profile)` handler instead (heavier:
// a full ~20-op `Net` handler literal) — flagged, not decided.

module app

import ../domain.{Source, SourceData, AggError, TaskStatus, TaskResult, Report}
import std.net.{SocketAddr, TcpStream}

// Explicit import required for the C runtime to link `Monotonic`/`Duration`
// support (prelude-visible type alone is not enough — the `.c` companion is
// only pulled in once the module is actually imported by the CU; observed as
// `undefined symbol: nova_fn_Monotonic_now` at link time otherwise).
import std.time.duration

// Loopback port range used for the synthetic fan-out (Demo/Chaos): each
// source connects to `BASE_PORT + index`, so the (mocked) `Net` handler's
// per-call identity comes from the address, not from hidden state.
const BASE_PORT = 20000

// [M-flagship-spawn-throw-segfault]: **ЗАКРЫТ (RE-VERIFY — свежий бинарь не
// воспроизводит; заморожен фикстурой regressions/spawn_throw_multifield_payload/).
// Текст ниже историчен — объясняет, ПОЧЕМУ здесь Result-форма; менять её
// обратно на throw не требуется (Result читабельнее для mixed-исходов).** `fetch_one` originally used `Fail[AggError]` + `throw` (the
// natural shape, matches every other `Fail`-effect fn in std/) and was
// discharged via `with Fail[AggError] = |e| {...} { fetch_one(...) }` inside
// `spawn { ... }` (a PLAIN function call from inside spawn — not nested
// `with`-blocks, so it does NOT hit the EARLIER-tried, separately-broken
// shape: `with Fail[AggError] {...} { with Fail[TimeoutError] {...} {
// supervised(deadline:) { spawn { throw AggError... } } } }`, which
// MISROUTES every throw inside `spawn` — regardless of its static `Fail[E]`
// type — to the **`Fail[TimeoutError]` handler** instead; verified with a
// throwaway `MyErr` type wholly unrelated to AggError/TimeoutError, same
// nesting shape: the `Fail[MyErr]` handler never fires, `Fail[TimeoutError]`'s
// does, TWICE, even though the deadline never elapses). That EARLIER shape
// is not used anywhere in this file any more — noted here only so the next
// person doesn't reintroduce it as an "obvious" fix for what follows.
//
// The plain-function-call shape above (no nested nested `with`-blocks)
// crashed differently: SIGSEGV, no output at all (not even a
// `println` on the very first line of the surrounding `with Net = ... {`
// block — this is not a logic bug, it corrupts memory early enough that
// nothing downstream is trustworthy). Bisected in isolation to "a `throw`
// of a MULTI-FIELD payload enum (`AggError`/`Source`/`SourceData`-shaped —
// several `str`/`[]u8` fields in play across the throw) unwinding out of a
// function called FROM `spawn`": a single-`str`-payload throwaway enum
// (`MyErr.Bad(str)`) unwinding the SAME way (plain fn, called from `spawn`,
// `with Fail[MyErr] = ...` around the call) does NOT crash — only the
// richer real types do. Root cause not identified further (GC-root
// bookkeeping across the longjmp-based unwind is the leading suspect, but
// this is a guess, not a diagnosis) — out of this session's remit to fix.
//
// WORKAROUND (verified against an isolated probe with the real `Source`/
// `SourceData`/`AggError`/`TaskStatus` types, both a direct call AND a
// `spawn`-wrapped call): no `throw`, no `Fail[AggError]` at all. `fetch_one`
// returns `Result[SourceData, AggError]` directly; `fetch_guarded` branches
// on it with a plain `match`. Zero effect-handler unwinding on the
// simulated-failure path.
/// Fetch a single source. Demo/Chaos: `(source.latency_ms).to_millis().sleep()` first
/// (the simulated network wait), then either a simulated-upstream `Err`
/// (see the marker above for why this is `Result`, not `throw`/`Fail`) or
/// the real `Net` round-trip against whatever handler is ambient
/// (`mock_net()` today).
// [M-flagship-spawn-capture-value-struct-ptr-mismatch]: **ЗАКРЫТ (RE-VERIFY
// 2026-07-20 — свежий бинарь компилирует и бежит; заморожен фикстурой
// regressions/spawn_capture_value_struct/). Скалярная сигнатура ниже —
// исторический обход; вернуть `fetch_one(source Source, idx)` можно
// отдельной byte-churn-волной, не обязательно.** Текст ниже историчен: Discovered
// 2026-07-14 while wiring deliverable 1 (real `supervised(deadline:)`
// cancel, see file-header note): capturing a multi-field `value` struct
// param (`Source`, 2 `str` + 3 scalar fields) into a `spawn { ... }` ctx
// nested inside `supervised(deadline:) { spawn { ... } }` (two closure
// levels: `fetch_guarded`'s own body, then the deadline-race spawn) CC-FAILs
// TWICE in the SAME generated function: (1) `_nova_spawn_0_ctx->source =
// source;` — "assigning to 'NovaValue_Source' from incompatible type
// 'NovaValue_Source *'; dereference with *" (the ctx struct field is typed
// as a VALUE, the captured param is apparently already a POINTER under
// Nova's by-pointer-for-larger-structs ABI — an assignment-site type
// mismatch); (2) inside the spawned fn body itself, "use of undeclared
// identifier 'source'" — the capture-macro substitution that correctly
// wraps OTHER captured locals (`_c->idx` used directly; `timed_out` in the
// sibling `Fail[TimeoutError]` handler literal gets a proper `#define
// timed_out (*_c->timed_out)`) is simply MISSING for this struct-typed
// capture, so the read site still emits the bare (out-of-scope) parameter
// name. A scalar param (`idx int`, `str`-typed locals) captured the SAME way
// does NOT trip this — narrowed to struct-typed (`value`, multi-field)
// params specifically. Root cause not investigated further (capture-emission
// pass's handling of the by-pointer-ABI case for nested spawn contexts is
// the leading suspect, but this is a guess) — out of this session's remit.
// WORKAROUND: `fetch_one` takes the `Source` fields it actually needs as
// separate SCALAR/`str` params instead of the whole struct — `fetch_guarded`
// destructures `source` into locals BEFORE the spawn (already needed `sid`
// for `Emit.lane_started` anyway) and captures only those into the spawn ctx.
fn fetch_one(id str, latency_ms int, should_fail bool, idx int) Net Time -> Result[SourceData, AggError] {
    if latency_ms > 0 {
        (latency_ms).to_millis().sleep()
    }
    if should_fail {
        return Err(AggError.Upstream(id))
    }
    ro addr = SocketAddr.loopback((BASE_PORT + idx) as u16)
    consume stream = match TcpStream.connect(addr) {
        Ok(consume s)  => s
        Err(e) => return Err(AggError.Transport(e.to_str()))
    }
    consume st = stream
    ro bytes = match st.read_to_vec(64) {
        Ok(b) => b
        Err(e) => {
            st.close()
            return Err(AggError.Transport(e.to_str()))
        }
    }
    st.close()
    Ok(SourceData { id, payload: bytes })
}

// Chain broken into separate bindings ([M-174.1-vec-method-chain-elem-erasure]-
// shaped gap: a 3-deep method chain used directly can confuse return-type
// inference in emit_c — split, not a semantics choice).
fn deadline_elapsed_ms(t0 Monotonic) Time -> int {
    ro now Monotonic = Monotonic.now()
    ro elapsed = now.elapsed_since(t0)
    elapsed.millis() as int
}

/// One source, raced against the SHARED absolute deadline via a REAL
/// `supervised(deadline:)` scope (see file-header note): `fetch_one` runs in
/// a spawned child that hands its outcome back over `tx`; a lane still
/// in-flight at `shared_deadline` is genuinely cancelled (its `Time.sleep`/
/// `Net` op is interrupted, the child unwinds, `tx` never sends) — relabeled
/// `TaskStatus.Cancelled` via the caught `TimeoutError`. Exactly one `Emit`
/// terminal event fires per source, matching whatever status ends up in the
/// returned `TaskResult` — Report and Emit are the same truth, by
/// construction (no separate race to keep in sync).
fn fetch_guarded(source Source, shared_deadline Monotonic, idx int) Net Time Emit -> TaskResult {
    // [M-flagship-monotonic-now-bare-binding-ice]: ЗАКРЫТ (попутно M-176
    // Path→Member фиксом 67717dcb1/747a79c65; заморожен фикстурой
    // regressions/monotonic_now_bare_binding/; const-ресивер-shape той же
    // семьи ЖИВ — [M-p67-path-call-const-receiver-method-ice], backlog).
    // Аннотации `Monotonic` по файлу оставлены (безвредны). Историческое:
    // un-annotated `ro t0 = Monotonic.now()` ICE'ило emit_c.rs ("[P67-LEGACY]
    // Path call return type unknown for method=now — checker must annotate") — the
    // checker apparently needs an expected-type hint (a declared LHS type,
    // or the call used directly as an argument, as in
    // std/concurrency/supervised_deadline_test.nv's
    // `Monotonic.now() + 100.to_millis()`) to resolve the return
    // type of this specific overloaded static-path call. Reproduced in
    // isolation (bare 5-line probe, no other code). Workaround: explicit
    // `Monotonic` annotation on every such binding, throughout this file.
    ro t0 Monotonic = Monotonic.now()
    ro sid = source.id
    Emit.lane_started(sid, idx)
    // [M-flagship-spawn-capture-value-struct-ptr-mismatch] (see fetch_one's
    // header): destructure `source` into scalar/`str` locals BEFORE the
    // spawn below — capturing the `Source` struct itself into the nested
    // spawn ctx CC-FAILs.
    ro slatency = source.latency_ms
    ro sfail = source.should_fail
    ro { tx, rx } = Channel.new(1)
    mut timed_out = false
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(deadline: shared_deadline) {
            spawn {
                ro outcome = fetch_one(sid, slatency, sfail, idx)
                ro st = match outcome {
                    Ok(data) => TaskStatus.Done(data)
                    Err(e)   => TaskStatus.Failed(e.to_str())
                }
                ro _ = tx.try_send(st)
            }
        }
    }
    ro elapsed_ms = deadline_elapsed_ms(t0)
    ro status = if timed_out {
        TaskStatus.Cancelled
    } else {
        rx.try_recv() ?? TaskStatus.Cancelled   // belt-and-suspenders: no send, no TimeoutError either
    }
    match status {
        Done(_)   => Emit.lane_done(sid, elapsed_ms)
        Failed(m) => Emit.lane_failed(sid, m, elapsed_ms)
        Cancelled => Emit.lane_cancelled(sid, elapsed_ms)
    }
    TaskResult { id: source.id, status, elapsed_ms }
}

/// The killer-narrative entry point: fan-out `sources` with a shared
/// `budget`, 0 leaks. See the file-header note — the budget is enforced as a
/// REAL `supervised(deadline:)` cancellation, shared as one absolute
/// `Monotonic` point across every lane (D408 "deadline: canon" — absolute,
/// not per-lane-relative, so lane start-up jitter can't skew the shared
/// budget).
#stable(since = "0.1")
export fn aggregate(sources []Source, budget Duration) Net Time Emit -> Report {
    ro t0 Monotonic = Monotonic.now()
    ro shared_deadline Monotonic = t0 + budget
    // Plan 87: the loop-variable type must be annotated when the checker
    // can't infer the collected `[]T` element type from the trailing probe
    // alone (`TaskResult` return of `fetch_guarded` — codegen asked for an
    // explicit `int` annotation on the index here).
    ro results = parallel for idx int in 0..sources.len() {
        fetch_guarded(sources[idx], shared_deadline, idx)
    }
    ro wall_ms = deadline_elapsed_ms(t0)
    ro report = results.to_report(wall_ms)
    Emit.swarm_done(report.results.len(), report.done, report.failed, report.cancelled,
        report.wall_ms, report.sequential_ms)
    report
}
