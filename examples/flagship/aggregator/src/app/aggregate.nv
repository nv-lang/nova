// SPDX-License-Identifier: MIT OR Apache-2.0
// Flagship concurrent aggregator: the backend.
//
// Killer-narrative signature:
//
//     fn aggregate(sources []Source, budget Duration) Net Time Emit -> Report
//
// Fan-out by N sources with a SHARED budget, concurrent (`parallel for`),
// real deadline cancellation, 0 leaks. The same `fetch_one` code runs under
// `mock_net()` (Demo/Chaos) or `real_net()` (Live). Simulated latency and
// failures for Demo/Chaos are injected at the call site via `Time.sleep`
// + early `Result::Err` return (not `throw` — see the workaround note
// below).

module app

import ../domain.{Source, SourceData, AggError, TaskStatus, TaskResult, Report}
import std.net.{SocketAddr, TcpStream}

// Explicit import required for the C runtime to link `Monotonic`/`Duration`
// support (prelude-visible type alone is not enough — the `.c` companion is
// only pulled in once the module is actually imported by the CU; observed as
// `undefined symbol: nova_fn_Monotonic_now` at link time otherwise).
import std.time.duration

// Loopback port range used for the synthetic fan-out (Demo/Chaos): each
// source connects to `BASE_PORT + index`, so the (mocked) `Net` handler's
// per-call identity comes from the address, not from hidden state.
const BASE_PORT = 20000

// [M-flagship-spawn-throw-segfault] workaround: `fetch_one` returns
// `Result[SourceData, AggError]` instead of using `Fail[AggError]` + `throw`,
// because throwing a multi-field enum from inside `spawn` caused a segfault.
/// Fetch a single source. Demo/Chaos: sleeps first (simulated latency),
/// then either a simulated-upstream `Err` or the real `Net` round-trip.
// [M-flagship-spawn-capture-value-struct-ptr-mismatch] workaround:
// `fetch_one` takes scalar/`str` params instead of the whole `Source`
// struct — capturing a multi-field value struct into a nested spawn context
// CC-fails. `fetch_guarded` destructures `source` into locals before the
// spawn and captures only those.
fn fetch_one(id str, latency_ms int, should_fail bool, idx int) Net Time -> Result[SourceData, AggError] {
    if latency_ms > 0 {
        (latency_ms).to_millis().sleep()
    }
    if should_fail {
        return Err(AggError.Upstream(id))
    }
    ro addr = SocketAddr.loopback(BASE_PORT + idx)
    // No explicit `close()`: `TcpStream consume @cleanup` (D432 affine) closes
    // the stream on every scope exit, including the `?` early-return paths.
    consume stream = TcpStream.connect(addr).map_err(|e| AggError.Transport(e.to_str()))?
    ro bytes = stream.read_bytes(64).map_err(|e| AggError.Transport(e.to_str()))?
    Ok(SourceData { id, payload: bytes })
}

// Chain broken into separate bindings (a deep method chain can confuse
// return-type inference — split, not a semantics choice).
fn deadline_elapsed_ms(t0 Monotonic) Time -> int {
    ro now Monotonic = Monotonic.now()
    ro elapsed = now.elapsed_since(t0)
    elapsed.millis() as int
}

/// One source, raced against the shared absolute deadline via a
/// `supervised(deadline:)` scope: `fetch_one` runs in a spawned child that
/// hands its outcome back over a channel; a lane still in-flight at the
/// deadline is genuinely cancelled and relabeled `TaskStatus.Cancelled.
fn fetch_guarded(source Source, shared_deadline Monotonic, idx int) Net Time Emit -> TaskResult {
    ro t0 = Monotonic.now()
    ro sid = source.id
    Emit.lane_started(sid, idx)
    // [M-flagship-spawn-capture-value-struct-ptr-mismatch] workaround:
    // destructure `source` into scalar/`str` locals before the spawn.
    ro slatency = source.latency_ms
    ro sfail = source.should_fail
    ro { tx, rx } = Channel.new(1)
    // Plan 238 (D441 §3, модель памяти между файберами): `with Fail[T]`
    // handler исполняется В ФАЙБЕРЕ падающей операции, не вызывающего
    // scope'а — mut-флаг там был бы гонкой (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    // AtomicBool — синхронизированная альтернатива (D415 белый список).
    mut timed_out = AtomicBool.new(false)
    with Fail[TimeoutError] = |_e| { timed_out.store(true) } {
        supervised(deadline: shared_deadline) {
            spawn {
                ro outcome = fetch_one(sid, slatency, sfail, idx)
                ro st = match outcome {
                    Ok(data) => TaskStatus.Done(data)
                    Err(e)   => TaskStatus.Failed(e.to_str())
                }
                ro _ = tx.try_send(st)
            }
        }
    }
    ro elapsed_ms = deadline_elapsed_ms(t0)
    ro status = if timed_out.load() {
        TaskStatus.Cancelled
    } else {
        rx.try_recv() ?? TaskStatus.Cancelled   // belt-and-suspenders: no send, no TimeoutError either
    }
    match status {
        Done(_)   => Emit.lane_done(sid, elapsed_ms)
        Failed(m) => Emit.lane_failed(sid, m, elapsed_ms)
        Cancelled => Emit.lane_cancelled(sid, elapsed_ms)
    }
    TaskResult { id: source.id, status, elapsed_ms }
}

/// The killer-narrative entry point: fan-out `sources` with a shared
/// `budget`, 0 leaks. The budget is enforced as a real
/// `supervised(deadline:)` cancellation — one absolute `Monotonic` point
/// shared across every lane.
#stable(since = "0.1")
export fn aggregate(sources []Source, budget Duration) Net Time Emit -> Report {
    ro t0 = Monotonic.now()
    ro shared_deadline Monotonic = t0 + budget
    // The loop variable type must be annotated when the checker can't infer
    // the element type from the trailing probe alone.
    ro results = parallel for idx int in 0..sources.len() {
        fetch_guarded(sources[idx], shared_deadline, idx)
    }
    ro wall_ms = deadline_elapsed_ms(t0)
    ro report = results.to_report(wall_ms)
    Emit.swarm_done(report.results.len(), report.done, report.failed, report.cancelled,
        report.wall_ms, report.sequential_ms)
    report
}
