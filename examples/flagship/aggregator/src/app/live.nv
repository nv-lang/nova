// SPDX-License-Identifier: MIT OR Apache-2.0
// Flagship concurrent aggregator: LIVE legends.
//
// `aggregate()`/`fetch_guarded()`/`fetch_one()` (aggregate.nv) are the
// Demo/Chaos synthetic path. Live sources hit real external hosts — this
// file re-runs the same race-a-lane-against-a-shared-deadline shape against
// honest live fetchers.
//
// - health legend, live: plain TCP connect timing against well-known domains.
// - weather legend, live: real `https://api.open-meteo.com` GET per city
//   (no API key), using `TcpStream.connect` + `TlsStream.connect`.
//

// `seed` is caller-ignored for live — the network is the randomness.

module app

import ../domain.{Source, SourceData, AggError, TaskStatus, TaskResult, Report}
import std.net.{SocketAddr, TcpStream, resolve}
import std.time.duration
import tls.{ClientConfig, TlsStream}

// ── Live target tables ──────────────────────────────────────────────────────

/// Real, resolvable domains for the health legend's live mode.
#stable(since = "0.2")
export fn health_live_hosts() -> []str {
    ["github.com", "cloudflare.com", "wikipedia.org", "npmjs.org", "pypi.org"]
}

/// Real cities (lat/lon) for the weather legend's live mode — open-meteo
/// forecast query, no API key.
#stable(since = "0.2")
export fn weather_live_cities() -> [](str, f64, f64) {
    [
        ("Moscow",   55.75,  37.62),
        ("London",   51.51,  -0.13),
        ("Tokyo",    35.68, 139.69),
        ("New-York", 40.71, -74.01),
    ]
}

// ── Live fetchers ────────────────────────────────────────────────────────────

/// One real TCP connect (port 443 — every host in `health_live_hosts` serves
/// HTTPS) — the "SLA timing" for the health legend. Connect success/latency
/// IS the measurement; no bytes are read (matches `fetch_one`'s framing:
/// payload content is not domain-meaningful, only timing/outcome are).
fn live_fetch_tcp(host str) Net Time -> Result[SourceData, AggError] {
    match resolve(host, 443 as u16) {
        Ok(addrs) => {
            if addrs.len() == 0 {
                Err(AggError.Transport("resolve: no address for ${host}"))
            } else {
                match TcpStream.connect(addrs[0]) {
                    Ok(consume st) => { st.close(); Ok(SourceData { id: host, payload: []u8.new() }) }
                    Err(e) => Err(AggError.Transport(e.to_str()))
                }
            }
        }
        Err(e) => Err(AggError.Transport(e.to_str()))
    }
}

/// A real `https://api.open-meteo.com/v1/forecast` GET for `(lat, lon)`:
/// resolve → TCP connect → TLS handshake → GET → read → close.
/// [M-187-tls-cross-pkg-consume-cleanup]: this lane no longer works around
/// anything, and the note that said it did was stale (corrected 2026-08-27,
/// audit A-V8). The marker's defect was that the consume-cleanup symbol for
/// `TcpStream` is emitted only when the consume site sits in the root
/// package's own code, so `TlsStream.connect` — which consumes its
/// `TcpStream` inside nova-tls — failed to link from downstream. The link
/// gap is closed: the aggregator builds under `--strict-effects` with this
/// call in place, and `examples/tls/echo_client.nv` builds the same call
/// too. The code below runs the handshake and, on success, the full GET and
/// read — it does not stop after `ClientConfig` as the old note claimed.
///
/// What is NOT verified: whether the handshake SUCCEEDS against the real
/// host. This lane needs the public internet, so the package sweep skips it
/// and no run here proves it. The marker stays until someone runs it live.
fn live_fetch_weather(id str, lat f64, lon f64) Net Time -> Result[SourceData, AggError] {
    ro host = "api.open-meteo.com"
    match resolve(host, 443 as u16) {
        Ok(addrs) => {
            if addrs.len() == 0 {
                Err(AggError.Transport("resolve: no address for ${host}"))
            } else {
                // Full live HTTPS: TCP connect -> TLS handshake -> GET -> read.
                ro cfg = ClientConfig.new(host)
                match TcpStream.connect(addrs[0]) {
                    Err(e) => Err(AggError.Transport(e.to_str()))
                    Ok(consume tcp) => match TlsStream.connect(tcp, cfg) {
                        Err(e) => Err(AggError.Transport("tls handshake: ${e}"))
                        Ok(consume tls) => {
                            ro req = "GET /v1/forecast?latitude=${lat}&longitude=${lon}&daily=temperature_2m_max&forecast_days=1 HTTP/1.1\r\nHost: ${host}\r\nConnection: close\r\n\r\n"
                            match tls.write_all(req.bytes()) {
                                Err(e) => { tls.close(); Err(AggError.Transport("tls write: ${e}")) }
                                Ok(_) => match tls.read_bytes(8192) {
                                    Err(e) => { tls.close(); Err(AggError.Transport("tls read: ${e}")) }
                                    Ok(bytes) => { tls.close(); Ok(SourceData { id, payload: bytes }) }
                                }
                            }
                        }
                    }
                }
            }
        }
        Err(e) => Err(AggError.Transport(e.to_str()))
    }
}

// ── Race-a-lane (same shape as aggregate.nv's fetch_guarded) ────────────────

/// Same race-against-a-shared-deadline shape as `aggregate.nv`'s
/// `fetch_guarded`, applied to `live_fetch_tcp`.
fn live_lane_tcp(host str, shared_deadline Monotonic, idx int) Net Time Emit -> TaskResult {
    ro t0 Monotonic = Monotonic.now()
    Emit.lane_started(host, idx)
    ro { tx, rx } = Channel[TaskStatus].new(1)
    // Plan 238 (D441 §3): `with Fail[T]` handler исполняется В ФАЙБЕРЕ
    // падающей операции — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut timed_out = AtomicBool.new(false)
    with Fail[TimeoutError] = |_e| { timed_out.store(true) } {
        supervised(deadline: shared_deadline) {
            spawn {
                ro outcome = live_fetch_tcp(host)
                ro st = match outcome {
                    Ok(data) => TaskStatus.Done(data)
                    Err(e)   => TaskStatus.Failed(e.to_str())
                }
                ro _ = tx.try_send(st)
            }
        }
    }
    ro elapsed_ms = deadline_elapsed_ms(t0)
    ro status = if timed_out.load() {
        TaskStatus.Cancelled
    } else {
        rx.try_recv() ?? TaskStatus.Cancelled
    }
    match status {
        Done(_)   => Emit.lane_done(host, elapsed_ms)
        Failed(m) => Emit.lane_failed(host, m, elapsed_ms)
        Cancelled => Emit.lane_cancelled(host, elapsed_ms)
    }
    TaskResult { id: host, status, elapsed_ms }
}

/// Same shape as `live_lane_tcp`, racing `live_fetch_weather` instead.
fn live_lane_weather(id str, lat f64, lon f64, shared_deadline Monotonic, idx int) Net Time Emit -> TaskResult {
    ro t0 Monotonic = Monotonic.now()
    Emit.lane_started(id, idx)
    ro { tx, rx } = Channel[TaskStatus].new(1)
    // Plan 238 (D441 §3): `with Fail[T]` handler исполняется В ФАЙБЕРЕ
    // падающей операции — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut timed_out = AtomicBool.new(false)
    with Fail[TimeoutError] = |_e| { timed_out.store(true) } {
        supervised(deadline: shared_deadline) {
            spawn {
                ro outcome = live_fetch_weather(id, lat, lon)
                ro st = match outcome {
                    Ok(data) => TaskStatus.Done(data)
                    Err(e)   => TaskStatus.Failed(e.to_str())
                }
                ro _ = tx.try_send(st)
            }
        }
    }
    ro elapsed_ms = deadline_elapsed_ms(t0)
    ro status = if timed_out.load() {
        TaskStatus.Cancelled
    } else {
        rx.try_recv() ?? TaskStatus.Cancelled
    }
    match status {
        Done(_)   => Emit.lane_done(id, elapsed_ms)
        Failed(m) => Emit.lane_failed(id, m, elapsed_ms)
        Cancelled => Emit.lane_cancelled(id, elapsed_ms)
    }
    TaskResult { id, status, elapsed_ms }
}

// ── Entry points (mirror aggregate()'s shape) ───────────────────────────────

/// Live health legend: real TCP-connect timing against `health_live_hosts()`,
/// raced against the SAME real `supervised(deadline:)` cancel as Demo/Chaos.
#stable(since = "0.2")
export fn aggregate_live_health(budget Duration) Net Time Emit -> Report {
    ro hosts = health_live_hosts()
    ro t0 Monotonic = Monotonic.now()
    ro shared_deadline Monotonic = t0 + budget
    ro results = parallel for idx int in 0..hosts.len() {
        live_lane_tcp(hosts[idx], shared_deadline, idx)
    }
    ro wall_ms = deadline_elapsed_ms(t0)
    ro report = results.to_report(wall_ms)
    Emit.swarm_done(report.results.len(), report.done, report.failed, report.cancelled,
        report.wall_ms, report.sequential_ms)
    report
}

/// Live weather legend: real open-meteo GETs against `weather_live_cities()`.
#stable(since = "0.2")
export fn aggregate_live_weather(budget Duration) Net Time Emit -> Report {
    ro cities = weather_live_cities()
    ro t0 Monotonic = Monotonic.now()
    ro shared_deadline Monotonic = t0 + budget
    ro results = parallel for idx int in 0..cities.len() {
        ro city = cities[idx]
        live_lane_weather(city.0, city.1, city.2, shared_deadline, idx)
    }
    ro wall_ms = deadline_elapsed_ms(t0)
    ro report = results.to_report(wall_ms)
    Emit.swarm_done(report.results.len(), report.done, report.failed, report.cancelled,
        report.wall_ms, report.sequential_ms)
    report
}

/// Fake `Source` list matching `aggregate_live_health`'s real host list —
/// so `report_json.nv`'s `build_snapshot` (id-keyed `kind`/`probes` lookup)
/// has something to match against for the live legend too (kind = "live",
/// probes = 1 — there is no synthetic sub-request count for a real fetch).
#stable(since = "0.2")
export fn health_live_sources() -> []Source {
    mut out []Source = []
    for h in health_live_hosts() {
        out.push(Source.new(h, "live", 1, 0, false))
    }
    out
}

/// Same idea as `health_live_sources`, for the weather legend.
#stable(since = "0.2")
export fn weather_live_sources() -> []Source {
    mut out []Source = []
    for c in weather_live_cities() {
        out.push(Source.new(c.0, "live", 1, 0, false))
    }
    out
}

