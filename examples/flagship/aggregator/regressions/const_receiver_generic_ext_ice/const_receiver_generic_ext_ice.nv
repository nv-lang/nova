// Регресс-фикстура: `const BUDGET_MS int = 120` + `BUDGET_MS.to_millis()`
// ранее ICE'ил emit_c.rs. Корень: парсер по регистру первой буквы решает
// Path-vs-Member, и SCREAMING_SNAKE_CASE-константа жадно сворачивалась
// в Path. Чекер аннотировал return-тип только для Member-формы, а Path-
// форма с const-ресивером падала мимо всех веток в ICE. Фикс: const-
// ресивер теперь получает тот же member-annotate путь, что и переменная.
module regressions.const_receiver_generic_ext_ice

import std.time.duration

const M187_BUDGET_MS int = 120

fn m187_const_receiver_to_millis() -> int {
    ro d = M187_BUDGET_MS.to_millis()
    d.millis() as int
}

test "M-187 const-ресивер + generic-extension method (.to_millis()) не ICE-ит" {
    ro ms = m187_const_receiver_to_millis()
    assert(ms == 120)
}
