// Регресс-фикстура: `spawn` лексически вложен внутрь другого `spawn`,
// оба под одним `supervised`. Ранее CC-FAILил — generated C ссылался на
// scope-queue local внешнего supervised, который вне области видимости
// внутри fiber-функции внешнего spawn. Fix: `emit_spawn` теперь всегда
// пробрасывает активный scope queue через неявное ctx-поле.
module regressions.nested_spawn_scope_var

test "M-187 spawn nested lexically inside another spawn (one supervised) compiles and runs" {
    mut outer_ran = AtomicInt.new(0)
    mut inner_ran = AtomicInt.new(0)
    supervised {
        spawn {
            outer_ran.store(1)
            // Nested spawn — same scope, no intervening `supervised`.
            spawn {
                inner_ran.store(1)
            }
        }
    }
    assert(outer_ran.load() == 1)
    assert(inner_ran.load() == 1)
}

// NB (граница покрытия): суммарное число детей скоупа здесь ≤ 16.
// Вложенный spawn регистрируется в родительский скоуп во время его drain-
// фазы — рост child_error[]/child_ctx[] в этот момент бьёт tripwire
// рантайма. >16 вложенно-порождённых детей на скоуп — открытая граница.

test "M-187 nested spawn: several inner spawns per outer spawn, all join" {
    mut total = AtomicInt.new(0)
    supervised {
        mut i = 1
        while i <= 3 {
            ro cur = i
            spawn {
                mut j = 1
                while j <= 2 {
                    ro cur2 = j
                    spawn {
                        total.fetch_add(cur * 100 + cur2)
                    }
                    j += 1
                }
            }
            i += 1
        }
    }
    // sum over i=1..3, j=1..2 of (i*100 + j): per i = 200*i + 3;
    // total = 200*(1+2+3) + 3*3 = 1200 + 9 = 1209
    assert(total.load() == 1209)
}
