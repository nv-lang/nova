// Регресс-фикстура: `ro t0 = Monotonic.now()` (без явной аннотации) ранее
// ICE'ил emit_c.rs. Закрыто попутно. Регресс-фикстура замораживает как
// голую привязку, так и полную форму, включая бинарный `t0 + budget`.
module regressions.monotonic_now_bare_binding

import std.time.duration

fn m187_monotonic_bare() Time -> int {
    ro t0 = Monotonic.now()
    ro t1 = Monotonic.now()
    ro elapsed = t1.elapsed_since(t0)
    elapsed.millis() as int
}

fn m187_monotonic_bare_plus_duration(budget Duration) Time -> int {
    ro t0 = Monotonic.now()
    ro deadline = t0 + budget
    ro elapsed = deadline.elapsed_since(t0)
    elapsed.millis() as int
}

test "M-187 голая привязка Monotonic.now() (без аннотации) не ICE-ит" {
    ro ms = m187_monotonic_bare()
    assert(ms >= 0)
}

test "M-187 голая привязка + t0 + Duration (без аннотации) не ICE-ит" {
    ro ms = m187_monotonic_bare_plus_duration(1000.to_millis())
    assert(ms >= 0)
}
