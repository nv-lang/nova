// [M-flagship-monotonic-now-bare-binding-ice] — RE-VERIFY (Плана 187): свежий
// бинарь НЕ воспроизводит. `ro t0 = Monotonic.now()` (без явной аннотации
// `Monotonic`) раньше ICE'ил emit_c.rs ("[P67-LEGACY] Path call return type
// unknown for method=now — checker must annotate"). Закрыто ПОПУТНО
// commit'ами 67717dcb1/747a79c65 (M-176 variant-chain Path→Member fix,
// landed на main непосредственно перед этой багфикс-волной) — тот же
// механизм закрыл и этот, изначально отдельный, репро. Регресс-фикстура —
// заморозить закрытие: как голая привязка, так и полная форма из
// `fetch_guarded`/`aggregate` (flagship-187), включая бинарный `t0 + budget`.
// Единица: folder-module `spec_tests.conformance`.
module regressions.monotonic_now_bare_binding

import std.time.duration

fn m187_monotonic_bare() -> int {
    ro t0 = Monotonic.now()
    ro t1 = Monotonic.now()
    ro elapsed = t1.elapsed_since(t0)
    elapsed.as_millis() as int
}

fn m187_monotonic_bare_plus_duration(budget Duration) -> int {
    ro t0 = Monotonic.now()
    ro deadline = t0 + budget
    ro elapsed = deadline.elapsed_since(t0)
    elapsed.as_millis() as int
}

test "M-187 голая привязка Monotonic.now() (без аннотации) не ICE-ит" {
    ro ms = m187_monotonic_bare()
    assert(ms >= 0)
}

test "M-187 голая привязка + t0 + Duration (без аннотации) не ICE-ит" {
    ro ms = m187_monotonic_bare_plus_duration(Duration.from_millis(1000))
    assert(ms >= 0)
}
