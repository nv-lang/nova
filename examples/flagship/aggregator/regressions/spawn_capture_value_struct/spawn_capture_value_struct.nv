// SPDX-License-Identifier: MIT OR Apache-2.0
// Регресс-фикстура: мульти-полевой value-структ параметр, захваченный в
// spawn-ctx под `supervised(deadline:)`. Ранее CC-FAILил из-за несовместимости
// value-поля ctx и by-pointer-ABI параметра, а также отсутствия capture-macro
// подстановки для структ-типизированного захвата.
module regressions.spawn_capture_value_struct

import std.time.duration

type PSource { id str, host str, latency_ms int, port int, flag bool }

fn guarded(source PSource) Time -> int {
    ro { tx, rx } = Channel[int].new(1)
    // Plan 238 (D441 §3): `with Fail[T]` handler исполняется В ФАЙБЕРЕ
    // падающей операции — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER).
    mut timed_out = AtomicBool.new(false)
    with Fail[TimeoutError] = |_e| { timed_out.store(true) } {
        supervised(timeout: 200.to_millis()) {
            spawn {
                (source.latency_ms).to_millis().sleep()
                ro _ = tx.try_send(source.id.byte_len() + source.port)
            }
        }
    }
    if timed_out.load() {
        -1
    } else {
        rx.try_recv() ?? -2
    }
}

test "M-flagship multi-field value-struct param captured into spawn ctx compiles and runs" {
    ro src = PSource { id: "a", host: "h1", latency_ms: 10, port: 80, flag: true }
    assert(guarded(src) == 81)
}
