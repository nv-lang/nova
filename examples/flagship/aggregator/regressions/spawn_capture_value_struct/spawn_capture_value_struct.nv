// [M-flagship-spawn-capture-value-struct-ptr-mismatch] — RE-VERIFY
// (2026-07-20, оркестратор): свежий бинарь НЕ воспроизводит. Раньше захват
// мульти-полевого `value`-структ ПАРАМЕТРА (`Source`: 2 str + 3 скаляра) в
// spawn-ctx под `supervised(deadline:)` (две closure-глубины) CC-FAILил
// ДВАЖДЫ в одной сгенерированной функции: (1) `_nova_spawn_0_ctx->source =
// source;` — "assigning to 'NovaValue_Source' from incompatible type
// 'NovaValue_Source *'" (value-поле ctx vs by-pointer-ABI параметр);
// (2) "use of undeclared identifier 'source'" в теле spawned-fn
// (capture-macro подстановка отсутствовала для структ-типизированного
// захвата). Обход в aggregate.nv (деструктуризация в скаляры до spawn) БЫЛ
// единственной причиной сигнатуры `fetch_one(id, latency_ms, should_fail,
// idx)` вместо `fetch_one(source Source, idx)`. Эта фикстура — заморозить
// закрытие: та же форма (мульти-полевой параметр, поля читаются ВНУТРИ
// spawn под supervised), скаляр через канал (str не word-safe у Channel —
// E_CHANNEL_UNSOUND_ELEM_TYPE, отдельная известная граница).
module regressions.spawn_capture_value_struct

import std.time.duration

type PSource { id str, host str, latency_ms int, port int, flag bool }

fn guarded(source PSource) Time -> int {
    ro { tx, rx } = Channel.new(1)
    mut timed_out = false
    with Fail[TimeoutError] = |_e| { timed_out = true } {
        supervised(timeout: 200.to_millis()) {
            spawn {
                (source.latency_ms).to_millis().sleep()
                ro _ = tx.try_send(source.id.byte_len() + source.port)
            }
        }
    }
    if timed_out {
        -1
    } else {
        match rx.try_recv() {
            Some(n) => n
            None    => -2
        }
    }
}

test "M-flagship multi-field value-struct param captured into spawn ctx compiles and runs" {
    ro src = PSource { id: "a", host: "h1", latency_ms: 10, port: 80, flag: true }
    assert(guarded(src) == 81)
}
