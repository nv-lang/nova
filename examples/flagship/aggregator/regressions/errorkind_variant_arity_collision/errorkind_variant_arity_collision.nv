// [M-187-errorkind-parsejsonerror-variant-collision] — два sum-типа с
// ОДНОИМЁННЫМ вариантом РАЗНОЙ арности (реально: std.io.ErrorKind.
// UnexpectedEof — unit, 0 полей; std.encoding.json.ParseJsonError.
// UnexpectedEof — record, 2 поля {line, col}) в одном CU → codegen путал
// приёмник для БАРЕ (без `Type.`-квалификации) record-литерала варианта:
// `err = Some(UnexpectedEof { @line, @col })` (запись деп глубоко внутри
// Option-присваивания, НЕ прямой `return`/tail-позиции фн) эмитила
// 0-арный конструктор чужого sum'а вместо 2-арного своего —
// "too many arguments to function call, expected 0, have 2".
//
// Корень: bare record-literal вариант-конструктор шёл через СТАРЫЙ
// "context-first" пробник (Plan 62.A.bis), который сверялся ТОЛЬКО с
// `current_fn_return_ty` НАПРЯМУЮ (`-> Sum` буквально) — фн, возвращающая
// `Result[_, Sum]`/присваивающая в `Option[Sum]`-переменную, этот пробник
// не проходила, и он молча падал на `find_variant_compat`'s
// first-registered-wins (БЕЗ учёта арности вообще). Фикс: тот же путь
// теперь идёт через `debt_find_variant_ctx` (D381 arity-aware дизамбиг,
// уже существовавший для CALL-формы `Variant(args)`) — арность
// record-литерала (`fields.len()`) сама разруливает коллизию.
//
// Минимальный репро БЕЗ std.io/std.encoding.json (два своих sum'а с
// одноимённым вариантом разной арности).
// Единица: folder-module `spec_tests.conformance`.
module regressions.errorkind_variant_arity_collision

type M187KindA enum
    | Collide
    | Other(str)

type M187KindB enum
    | Collide { line int, col int }
    | Other(str)

// Возвращает Option[M187KindB] — НЕ M187KindB напрямую (старый
// context-first пробник это не видел; return-позиция функции — Result
// поверх Option, ещё на уровень глубже).
fn m187_find(line int, col int) -> Result[Option[M187KindB], str] {
    mut err Option[M187KindB] = None
    if line > 0 {
        err = Some(Collide { line, col })
    }
    Ok(err)
}

test "M-187 bare record-literal variant ctor дизамбигуируется по арности, не first-wins" {
    match m187_find(3, 7) {
        Ok(Some(M187KindB.Collide { line, col })) => {
            assert(line == 3)
            assert(col == 7)
        }
        _ => assert(false)
    }
}
