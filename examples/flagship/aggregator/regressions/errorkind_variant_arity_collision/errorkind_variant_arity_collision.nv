// Регресс-фикстура: два sum-типа с одноимённым вариантом разной арности
// в одном CU. Codegen путал приёмник для bare record-литерала варианта.
// Корень: старый "context-first" пробник сверялся только с
// `current_fn_return_ty`. Фикс: тот же путь идёт через arity-aware
// дизамбиг — арность record-литерала разруливает коллизию.
// Минимальный репро без std.io/std.encoding.json.
module regressions.errorkind_variant_arity_collision

type M187KindA enum
    | Collide
    | Other(str)

type M187KindB enum
    | Collide { line int, col int }
    | Other(str)

// Возвращает Option[M187KindB] — НЕ M187KindB напрямую (старый
// context-first пробник это не видел; return-позиция функции — Result
// поверх Option, ещё на уровень глубже).
fn m187_find(line int, col int) -> Result[Option[M187KindB], str] {
    mut err Option[M187KindB] = None
    if line > 0 {
        err = Some(Collide { line, col })
    }
    Ok(err)
}

test "M-187 bare record-literal variant ctor дизамбигуируется по арности, не first-wins" {
    match m187_find(3, 7) {
        Ok(Some(M187KindB.Collide { line, col })) => {
            assert(line == 3)
            assert(col == 7)
        }
        _ => assert(false)
    }
}
