module aggregator.zzz_probe_main6

import std.time.duration

fn main() Time {
    ro t0 Monotonic = Monotonic.now()
    println("A: single Time.sleep(500), no spawn")
    Time.sleep(500)
    ro t1 Monotonic = Monotonic.now()
    println("  elapsed=" + str.from(t1.elapsed_since(t0).as_millis() as int) + "ms")

    println("B: Time.sleep(500) inside a lone spawn")
    ro t2 Monotonic = Monotonic.now()
    supervised {
        spawn {
            Time.sleep(500)
        }
    }
    ro t3 Monotonic = Monotonic.now()
    println("  elapsed=" + str.from(t3.elapsed_since(t2).as_millis() as int) + "ms")

    println("C: 4 concurrent spawns, each Time.sleep(different ms)")
    ro t4 Monotonic = Monotonic.now()
    supervised {
        spawn { Time.sleep(15) }
        spawn { Time.sleep(30) }
        spawn { Time.sleep(500) }
        spawn { Time.sleep(10) }
    }
    ro t5 Monotonic = Monotonic.now()
    println("  elapsed=" + str.from(t5.elapsed_since(t4).as_millis() as int) + "ms (expect ~500)")
}
