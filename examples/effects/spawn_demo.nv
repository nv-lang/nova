// spawn_demo.nv — spawn внутри structured-scope (supervised/parallel for).
//
// `spawn body` — fire-and-forget, возвращает unit. Результаты concurrent-
// вычислений — через `#share`-примитивы (`Atomic*`/`Mutex`) / каналы или
// `parallel for` (homogeneous results); голый mut-захват —
// E_CONCURRENT_MUT_CAPTURE (гонка). `let r = spawn { expr }` — compile-error
// (spawn не возвращает значение).

module effects.spawn_demo

fn main() {
    // Простое spawn внутри supervised: fiber вычисляет, результат через
    // #share-примитив.
    mut r1 = AtomicInt.new(0)
    supervised {
        spawn {
            r1.store(100 + 1)
        }
    }
    println("spawn result = ", r1.load())       // 101

    // spawn с захватом переменной.
    ro x = 42
    mut r2 = AtomicInt.new(0)
    supervised {
        spawn {
            r2.store(x * 2)
        }
    }
    println("captured x*2 = ", r2.load())       // 84

    // Несколько spawn'ов в одном supervised — выполняются concurrent
    // (fiber scheduler делает round-robin), supervised ждёт всех.
    mut a = AtomicInt.new(0)
    mut b = AtomicInt.new(0)
    supervised {
        spawn { a.store(10) }
        spawn { b.store(20) }
    }
    println("a + b = ", a.load() + b.load())           // 30

    // Гомогенный fan-out: `parallel for` исполняет тело конкурентно для
    // каждого элемента. Здесь собираем результат через mut-аккумулятор
    // внутри supervised-scope.
    //
    // Форма `ro results = parallel for ... { expr }` (массив результатов)
    // корректно типизируется в `test {}`-блоках; в обычной `fn` value-typing
    // `parallel for` даёт `()` — поэтому пример использует statement-форму
    // + AtomicInt-аккумулятор (mut-захват из spawn = гонка).
    mut sum_sq = AtomicInt.new(0)
    supervised {
        parallel for i in 0..5 {
            sum_sq.fetch_add(i * i)
        }
    }
    println("sum of squares 0..5 = ", sum_sq.load())   // 30
}
