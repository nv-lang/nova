// SPDX-License-Identifier: MIT OR Apache-2.0
// mini_aggregator.nv — суть флагманского демо (examples/flagship/aggregator)
// в ~30 строках кода: одновременный опрос N источников с общим бюджетом
// времени и честной отменой опоздавших. Без сети, без HTTP, без UI —
// только ядро паттерна: `parallel for` + `supervised(deadline:)`.
//
// Build & run:
//   nova-cli/target/release/nova build examples/mini_aggregator.nv -o mini_agg && ./mini_agg
//
// Печатает (структурно детерминированно; wall ≈ бюджет, не сумма задержек):
//   done=4 cancelled=2 wall=~150-170ms — два медленных источника отменены
//   на 120-мс бюджете, а не дожиты до конца (сумма задержек была бы 1300 мс).

module nova_examples.mini_aggregator

import std.time.duration

const BUDGET_MS int = 120   // общий бюджет на весь забег, мс

// Один источник: ждёт свою задержку (симуляция сети) и рапортует в канал.
// Дедлайн — одна абсолютная точка (t0 + бюджет) на всех: джиттер старта
// ланов не размывает общий бюджет. Опоздавший spawn честно обрывается
// (его Time.sleep прерывается), канал остаётся пуст, исход — "cancelled".
fn probe(latency_ms int, deadline Monotonic) Time -> str {
    ro { tx, rx } = Channel.new(1)
    // Plan 238 (D441 §3): `with Fail[T]` handler исполняется В ФАЙБЕРЕ
    // падающей операции — AtomicBool вместо mut-флага
    // (E_HANDLER_MUT_CAPTURE_IN_FIBER, D415 белый список).
    mut timed_out = AtomicBool.new(false)
    with Fail[TimeoutError] = |_e| { timed_out.store(true) } {
        supervised(deadline: deadline) {
            spawn {
                (latency_ms).to_millis().sleep()
                ro _ = tx.try_send(true)
            }
        }
    }
    if timed_out.load() {
        "cancelled"
    } else {
        match rx.try_recv() {
            Some(_) => "done"
            None    => "cancelled"
        }
    }
}

// Fan-out: все источники стартуют ОДНОВРЕМЕННО, результат собирается в []str.
fn fan_out(latencies []int, deadline Monotonic) Time -> []str {
    ro outcomes = parallel for i int in 0..latencies.len() {
        probe(latencies[i], deadline)
    }
    outcomes
}

fn main() Time {
    ro latencies []int = [20, 40, 60, 80, 300, 800]   // мс; последние два не успеют
    ro t0 Monotonic = Monotonic.now()
    ro deadline Monotonic = t0 + BUDGET_MS.to_millis()   // одна абсолютная точка на всех
    ro outcomes = fan_out(latencies, deadline)
    mut done = 0
    mut cancelled = 0
    for i int in 0..outcomes.len() {
        if outcomes[i] == "done" { done += 1 } else { cancelled += 1 }
    }
    ro now Monotonic = Monotonic.now()
    ro wall = now.elapsed_since(t0)
    println("done=${done} cancelled=${cancelled} wall=${wall.millis()}ms")
}
