// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 193 Ф.3: TLS echo client example — see echo_server.nv / README.md
// for the nova-tls dependency setup this pair demonstrates.
//
// Connects to echo_server.nv over TCP, performs a TLS client handshake,
// sends a message, reads the echo back. Mirrors examples/net/echo_client.nv
// 1:1 — same TcpStream.connect/spawn/supervised shape — with a
// `TlsStream.connect` step inserted right after the TCP connect.
//
// Trust: the server's self-signed `localhost` cert IS its own root here
// (`VerificationMode.CustomRoots`) — the realistic pattern for a pinned
// internal/dev cert. `InsecureSkipVerify` also exists (config.nv) but is
// explicitly documented "ТОЛЬКО тесты" (tests only) — not shown here on
// purpose; a real client should always verify against *something*.
//
// Usage (start echo_server.nv first):
//   nova build examples/tls/echo_server.nv -o echo_server && ./echo_server &
//   nova build examples/tls/echo_client.nv -o echo_client && ./echo_client
//
// See also: examples/tls/echo_server.nv, examples/net/echo_client.nv

module tls.echo_client

import std.net.{SocketAddr, TcpStream, real_net}
import tls.{TlsStream, ClientConfig, VerificationMode, TlsVersion}

const PORT u16 = 7778
const MESSAGE str = "hello from nova, over tls"

fn server_ca() -> []u8 => embed("certs/localhost_cert.pem")

fn main() {
    with Net = real_net() {
        ro addr = SocketAddr.loopback(PORT)
        ro cfg = ClientConfig.new("localhost")
            .verification(VerificationMode.CustomRoots(server_ca()))

        supervised {
            spawn {
                match TcpStream.connect(addr) {
                    Err(_) => {
                        println("Connect failed — is echo_server running on port ${PORT}?")
                    }
                    Ok(consume tcp) => {
                        println("TCP connected to ${PORT}, starting TLS handshake")
                        match TlsStream.connect(tcp, cfg) {
                            Err(e) => println("TLS handshake failed: ${e.to_str()}")
                            Ok(consume session) => {
                                // NB: don't name this binding `tls` — it would
                                // shadow the imported package alias (`tls.*`)
                                // and turn `stream.write_all(...)` below into
                                // an (invalid) module-qualified call instead of
                                // a method call (E7401).
                                consume stream = session
                                ro version = stream.protocol_version() ?? TlsVersion.Tls13
                                println("TLS established (${version.to_str()})")
                                match stream.write_all(MESSAGE.bytes()) {
                                    Err(e) => { println("Write failed: ${e.to_str()}"); stream.close() }
                                    Ok(_) => {
                                        match stream.read_to_vec(256) {
                                            Err(e) => { println("Read failed: ${e.to_str()}"); stream.close() }
                                            Ok(echo_bytes) => {
                                                // [M-174.1-vec-method-chain-elem-erasure]: explicit []u8 local.
                                                ro eb []u8 = echo_bytes
                                                ro echo = unsafe { eb.to_str_unchecked() }
                                                println("Echo: ${echo}")
                                                stream.close()
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    println("Done.")
}
