module basics.ctor_nested_effect_once

type Inner {
    m int
}

type Pt {
    a int
    b int
}

fn tick(n int) Io -> int {
    println("t", n)
    n
}

fn take(q Inner) -> int {
    q.m
}

fn tally(p Pt) -> int {
    p.a + p.b
}

fn main() Io {
    println(tally(Pt { a: 1, b: take(Inner { m: tick(2) }) }))
}
