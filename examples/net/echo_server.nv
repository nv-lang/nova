// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 83.12: Echo server example.
// Plan 183 Ф.3: migrated onto std.net2 (byte-surface `Net`, D407).
//
// Listens on 127.0.0.1:7777 (configurable). Accepts one connection, reads
// data, echoes it back. Demonstrates the TcpListener + TcpStream async API.
//
// Usage:
//   nova build examples/net/echo_server.nv -o echo_server && ./echo_server
//   # In another terminal:
//   echo "hello nova" | nc 127.0.0.1 7777
//
// See also: examples/net/echo_client.nv

module net.echo_server

import std.net.{SocketAddr, TcpListener, real_net}

const PORT u16 = 7777

fn main() {
    with Net = real_net() {
        ro addr = SocketAddr.loopback(PORT)

        supervised {
            spawn {
                // Plan 173.3 (D415 §2): listener живёт ЦЕЛИКОМ в серверном
                // fiber'е (bind/accept/close) — mut-захват внешнего listener'а
                // телом spawn был бы E_CONCURRENT_MUT_CAPTURE.
                mut lst = match TcpListener.bind(addr) {
                    Ok(consume l)  => l
                    Err(_) => panic("Failed to bind: ${PORT}")
                }
                println("Listening on 127.0.0.1:${lst.local_port()}")
                // Accept one connection and echo data back.
                match lst.accept() {
                    Ok(consume stream) => {
                        consume s = stream
                        println("Client connected from port ${s.peer_port()}")
                        match s.read_to_vec(4096) {
                            Ok(_data) => {
                                match s.write_str("echo_ok\n") {
                                    Ok(_)  => println("Echo sent")
                                    Err(_) => println("Write failed")
                                }
                            }
                            Err(_) => println("Read failed")
                        }
                        s.close()
                    }
                    Err(_) => println("Accept failed")
                }
                lst.close()
                println("Done")
            }
        }
    }
}
