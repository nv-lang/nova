// SPDX-License-Identifier: MIT OR Apache-2.0
// Plan 83.12: Echo client example.
// Plan 183 Ф.3: migrated onto std.net2 (byte-surface `Net`, D407).
//
// Connects to an echo server, sends a message, reads the echo back.
// Demonstrates TcpStream.connect + write + read.
//
// Usage (start echo_server.nv first):
//   nova build examples/net/echo_server.nv -o echo_server && ./echo_server &
//   nova build examples/net/echo_client.nv -o echo_client && ./echo_client
//
// See also: examples/net/echo_server.nv

module net.echo_client

import std.net.{SocketAddr, TcpStream, real_net}

const PORT u16 = 7777
const MESSAGE = "hello from nova"

fn main() {
    with Net = real_net() {
        ro addr = SocketAddr.loopback(PORT)
        supervised {
            spawn {
                match TcpStream.connect(addr) {
                    Err(_) => {
                        println("Connect failed — is echo_server running on port ${PORT}?")
                    }
                    Ok(consume conn) => {
                        consume stream = conn
                        println("Connected to ${PORT}")

                        match stream.write_str(MESSAGE) {
                            Err(_) => { println("Write failed"); stream.close() }
                            Ok(_) => {
                                match stream.read_to_vec(256) {
                                    Err(_) => { println("Read failed"); stream.close() }
                                    Ok(echo_bytes) => {
                                        // [M-174.1-vec-method-chain-elem-erasure]: explicit []u8 local.
                                        ro eb []u8 = echo_bytes
                                        ro echo = unsafe { eb.to_str_unchecked() }
                                        println("Echo: ${echo}")
                                        stream.close()
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    println("Done.")
}
