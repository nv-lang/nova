{
    "files.associations": {
        "*.nv": "nova"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "[nova]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.rulers": [80, 100],
        // Семантическая подсветка от nova-lsp сейчас БЕДНЕЕ грамматики: замер
        // 2026-08-23 по LSP на callables.nv:346 показал, что имена параметров,
        // их типы и тип возврата приходят одним token type `variable` (легенда
        // объявляет type/parameter/typeParameter, но классификатор их не
        // ставит). Поэтому через ~2с после открытия файл терял различие
        // «параметр против типа». Снять, когда классификатор в
        // nova-lsp/src/semantic_tokens.rs начнёт отдавать parameter/type.
        "editor.semanticHighlighting.enabled": false
    },
    "terminal.integrated.env.windows": {
        "NOVA_GC_LIB_DIR": "D:/Sources/nv-lang/nova/compiler-codegen/vcpkg_installed/x64-windows-static/lib",
        "NOVA_GC_INCLUDE_DIR": "D:/Sources/nv-lang/nova/compiler-codegen/vcpkg_installed/x64-windows-static/include"
    }
}
