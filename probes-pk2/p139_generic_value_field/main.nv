// pk2-probe №139: пользовательский generic value-тип как ПОЛЕ структуры —
// репро из реестра (8 строк, интегратор 2026-07-27).
module p139_generic_value_field

type Nzp139Wrap[T] value { priv data T }

fn Nzp139Wrap[T].make(v T) -> Nzp139Wrap[T] => { data: v }

type Nzp139Bundle value { w Nzp139Wrap[int], n int }

fn main() {
    ro nzp139_b = Nzp139Bundle { w: Nzp139Wrap[int].make(5), n: 1 }
    println("ok, n=${nzp139_b.n}")
}
