// pk2-probe №126 (соседняя РАБОЧАЯ форма): тот же generic-метод, но вызван
// через ИНСТАНС (`x.show[T]()`), не через статик-Path (`Type.show[T](x)`).
module p126b_instance_generic_ok

type Nzp126bUtils value {
    marker int
}

fn Nzp126bUtils @show[T](x T) {
    println("show = ${x}")
}

fn main() {
    ro nzp126b_u = Nzp126bUtils { marker: 0 }
    nzp126b_u.show[int](42)
}
