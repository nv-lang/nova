// pk2-probe №36 (соседняя РАБОЧАЯ форма отдельно, без соседства с ломающейся,
// чтобы не спутать причины CC-FAIL — компиляция всей папки).
module p36b_working_only

export type Nzp36bWrap value {
    body []u8
}

export fn Nzp36bWrap.new(b []u8) -> Nzp36bWrap => { body: b }

export fn Nzp36bWrap mut @body(data []u8) -> @ {
    @body = data
}

fn nzp36b_working_split() -> Nzp36bWrap {
    mut nzp36b_resp0 = Nzp36bWrap.new([9 as u8])
    mut nzp36b_out = nzp36b_resp0
    nzp36b_out.body([1 as u8, 2 as u8, 3 as u8])
    nzp36b_out
}

fn main() {
    ro nzp36b_a = nzp36b_working_split()
    println("working split ok, body.len=${nzp36b_a.body.len()}")
}
