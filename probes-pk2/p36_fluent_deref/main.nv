// pk2-probe №36: init mut-локали из fluent-сеттера на value-типе
// (`mut out = resp.body(gz)`) — предположительно CC-FAIL assigning T from T*.
// Самодостаточный минимальный репро (без зависимости от nova-polaris —
// пакет не собирается как отдельный folder-CU: посторонние ошибки
// NovaOpt_* заливают вывод), форма скопирована 1:1 из
// nova-polaris/src/server.nv ServerResponse (value + mut @body(...) -> @).
module p36_fluent_deref

export type Nzp36Wrap value {
    body []u8
}

export fn Nzp36Wrap.new(b []u8) -> Nzp36Wrap => { body: b }

export fn Nzp36Wrap mut @body(data []u8) -> @ {
    @body = data
}

// Рабочая соседняя форма: mut-локаль сначала копией, потом statement-вызов
// сеттера (workaround, применённый в compress.nv).
fn nzp36_working_split() -> Nzp36Wrap {
    mut nzp36_resp0 = Nzp36Wrap.new([9 as u8])
    mut nzp36_out = nzp36_resp0
    nzp36_out.body([1 as u8, 2 as u8, 3 as u8])
    nzp36_out
}

// Ломающаяся форма из реестра: init mut-локали НАПРЯМУЮ из fluent-сеттера.
fn nzp36_failing_fluent_init() -> Nzp36Wrap {
    mut nzp36_resp0 = Nzp36Wrap.new([9 as u8])
    mut nzp36_out = nzp36_resp0.body([1 as u8, 2 as u8, 3 as u8])
    nzp36_out
}

fn main() {
    ro nzp36_a = nzp36_working_split()
    println("working split ok, body.len=${nzp36_a.body.len()}")
    ro nzp36_b = nzp36_failing_fluent_init()
    println("failing fluent ok, body.len=${nzp36_b.body.len()}")
}
