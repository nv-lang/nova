// pk2-probe №39 (соседняя форма): ТОЛЬКО ОДИН эффект-инстанс generic
// value-типа в CU (без второго Handler[Log] рядом) — проверка, срабатывает
// ли мономорфизация вообще без коллизии двух инстансов.
module p39b_single_effect_generic

type Nzp39bDb effect {
    query(sql str) -> str
}

type Nzp39bHandler[E] value {
    tag str
}

fn Nzp39bHandler[E].new(tag str) -> Nzp39bHandler[E] => { tag }

fn nzp39b_use_db(h Nzp39bHandler[Nzp39bDb]) -> str => h.tag

fn main() {
    ro nzp39b_hd = Nzp39bHandler[Nzp39bDb].new("db")
    println(nzp39b_use_db(nzp39b_hd))
}
